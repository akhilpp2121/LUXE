<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Management - Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0f0f13;
      --surface: #17171f;
      --card: #1e1e28;
      --border: #2a2a38;
      --accent: #6c63ff;
      --accent2: #a78bfa;
      --danger: #f87171;
      --success: #34d399;
      --warning: #fbbf24;
      --info: #60a5fa;
      --text: #e8e8f0;
      --muted: #7c7c96;
      --subtle: #3a3a50;
      --font: 'DM Sans', sans-serif;
      --mono: 'DM Mono', monospace;
    }

    body {
      min-height: 100vh;
      display: flex;
      background: var(--bg);
      color: var(--text);
      font-family: var(--font);
    }

    a { color: inherit; text-decoration: none; }

    .sidebar {
      width: 240px;
      flex-shrink: 0;
      background: #13131a;
      border-right: 1px solid #1e1e2e;
      display: flex;
      flex-direction: column;
      height: 100vh;
      position: sticky;
      top: 0;
      overflow-y: auto;
    }

    .sidebar-brand {
      padding: 22px 20px 18px;
      border-bottom: 1px solid #1e1e2e;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-icon {
      width: 34px;
      height: 34px;
      border-radius: 9px;
      background: linear-gradient(135deg, #6c63ff 0%, #a78bfa 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: 700;
      color: #fff;
      letter-spacing: -0.5px;
    }

    .brand-name { font-size: 14px; font-weight: 600; letter-spacing: -0.2px; }
    .brand-sub {
      font-size: 10px;
      color: #3a3a55;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-top: 1px;
    }

    .nav-section { padding: 18px 0 4px; }
    .nav-section-label {
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 1.4px;
      text-transform: uppercase;
      color: #35354f;
      padding: 0 20px 6px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 20px;
      font-size: 13px;
      color: #55556f;
      border-left: 2px solid transparent;
      transition: all 0.15s ease;
    }

    .nav-item svg {
      width: 15px;
      height: 15px;
      flex-shrink: 0;
      opacity: 0.55;
    }

    .nav-item:hover {
      color: #b0b0d0;
      background: rgba(108, 99, 255, 0.05);
    }

    .nav-item.active {
      color: var(--accent2);
      background: rgba(108, 99, 255, 0.08);
      border-left-color: var(--accent);
      font-weight: 500;
    }

    .nav-item.active svg { opacity: 1; color: var(--accent); }
    .nav-divider { height: 1px; background: #1e1e2e; margin: 8px 0; }

    .nav-badge {
      margin-left: auto;
      font-size: 10px;
      font-weight: 600;
      padding: 2px 7px;
      border-radius: 20px;
      background: rgba(248, 113, 113, 0.1);
      color: var(--danger);
    }

    .sidebar-footer {
      margin-top: auto;
      padding: 14px 16px;
      border-top: 1px solid #1e1e2e;
    }

    .logout-btn {
      display: flex;
      align-items: center;
      gap: 9px;
      width: 100%;
      padding: 9px 13px;
      background: transparent;
      border: 1px solid rgba(248, 113, 113, 0.12);
      border-radius: 8px;
      color: #55556f;
      font-size: 13px;
      font-family: var(--font);
      cursor: pointer;
      transition: all 0.18s ease;
    }

    .logout-btn svg { width: 14px; height: 14px; }
    .logout-btn:hover {
      background: rgba(248, 113, 113, 0.07);
      border-color: rgba(248, 113, 113, 0.35);
      color: var(--danger);
    }

    .main {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
    }

    .topbar {
      height: 60px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .topbar-title { font-size: 15px; font-weight: 500; }
    .avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 13px;
      font-weight: 600;
    }

    .content { padding: 32px; flex: 1; min-width: 0; }

    .page-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 28px;
    }

    .page-header h1 {
      font-size: 22px;
      font-weight: 600;
      letter-spacing: -0.4px;
    }

    .page-header p {
      color: var(--muted);
      font-size: 13px;
      margin-top: 2px;
    }

    .btn-secondary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: 1px solid var(--border);
      background: var(--card);
      color: var(--muted);
      border-radius: 7px;
      padding: 8px 14px;
      font-size: 13px;
      font-weight: 500;
      white-space: nowrap;
      transition: all 0.15s ease;
    }

    .btn-secondary:hover { color: var(--text); border-color: var(--subtle); }

    .stats-row {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }

    .stat-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px 20px;
      min-width: 0;
    }

    .stat-label {
      font-size: 12px;
      color: var(--muted);
      font-weight: 500;
      letter-spacing: 0.3px;
    }

    .stat-value {
      font-size: 24px;
      font-weight: 600;
      letter-spacing: -0.5px;
      margin-top: 6px;
      overflow-wrap: anywhere;
    }

    .stat-value.accent { color: var(--accent2); }
    .stat-value.success { color: var(--success); }
    .stat-value.warning { color: var(--warning); }

    .filters {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px 20px;
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }

    .search-wrap {
      flex: 1;
      min-width: 240px;
      position: relative;
    }

    .search-wrap input {
      width: 100%;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 7px;
      padding: 8px 12px 8px 36px;
      color: var(--text);
      font-size: 13px;
      font-family: var(--font);
      outline: none;
      transition: border-color 0.15s;
    }

    .search-wrap input:focus { border-color: var(--accent); }
    .search-wrap input::placeholder { color: var(--muted); }

    .search-icon {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--muted);
      font-size: 13px;
    }

    .filter-tabs {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }

    .search-form {
      display: flex;
      flex: 1;
      min-width: 320px;
      gap: 8px;
      align-items: center;
    }

    .filter-tab {
      border: 1px solid var(--border);
      background: var(--bg);
      color: var(--muted);
      border-radius: 7px;
      padding: 7px 11px;
      font-size: 12px;
      font-weight: 600;
      transition: all 0.15s ease;
      white-space: nowrap;
    }

    .filter-tab:hover { color: var(--text); border-color: var(--subtle); }
    .filter-tab.active {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
    }

    .btn-filter,
    .btn-clear {
      border-radius: 7px;
      padding: 8px 13px;
      font-size: 12px;
      font-weight: 600;
      font-family: var(--font);
      white-space: nowrap;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .btn-filter {
      border: 1px solid var(--accent);
      background: var(--accent);
      color: #fff;
    }

    .btn-filter:hover {
      background: #5d55e8;
      border-color: #5d55e8;
    }

    .btn-clear {
      display: inline-flex;
      align-items: center;
      border: 1px solid var(--border);
      background: var(--bg);
      color: var(--muted);
    }

    .btn-clear:hover {
      color: var(--text);
      border-color: var(--subtle);
    }

    .table-wrap {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
    }

    .table-scroll { overflow-x: auto; }

    table {
      width: 100%;
      min-width: 980px;
      border-collapse: collapse;
      font-size: 13px;
    }

    thead th {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      color: var(--muted);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.8px;
      padding: 13px 18px;
      text-align: left;
      text-transform: uppercase;
      white-space: nowrap;
    }

    tbody tr {
      border-bottom: 1px solid var(--border);
      transition: background 0.12s ease;
    }

    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: rgba(255, 255, 255, 0.025); }

    td {
      padding: 14px 18px;
      vertical-align: middle;
      color: var(--text);
    }

    .mono {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--accent2);
      white-space: nowrap;
    }

    .customer-cell {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 220px;
    }

    .customer-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 12px;
      font-weight: 700;
      border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .avatar-a { background: rgba(108, 99, 255, 0.14); color: var(--accent2); }
    .avatar-b { background: rgba(52, 211, 153, 0.12); color: var(--success); }
    .avatar-c { background: rgba(96, 165, 250, 0.13); color: var(--info); }
    .avatar-d { background: rgba(248, 113, 113, 0.12); color: var(--danger); }
    .avatar-e { background: rgba(251, 191, 36, 0.12); color: var(--warning); }
    .avatar-f { background: rgba(167, 139, 250, 0.14); color: var(--accent2); }

    .customer-name { font-weight: 500; line-height: 1.25; }
    .customer-sub {
      color: var(--muted);
      font-size: 11px;
      margin-top: 2px;
      max-width: 260px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .muted { color: var(--muted); }
    .date-cell { color: var(--muted); font-family: var(--mono); font-size: 12px; white-space: nowrap; }
    .amount { font-size: 14px; font-weight: 600; white-space: nowrap; }
    .payment { color: var(--muted); font-size: 12px; font-weight: 600; text-transform: uppercase; }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border-radius: 20px;
      padding: 4px 10px;
      font-size: 11px;
      font-weight: 600;
      white-space: nowrap;
    }

    .badge-dot { width: 6px; height: 6px; border-radius: 50%; }
    .badge.processing { background: rgba(251, 191, 36, 0.1); color: var(--warning); }
    .badge.processing .badge-dot { background: var(--warning); }
    .badge.shipped { background: rgba(96, 165, 250, 0.11); color: var(--info); }
    .badge.shipped .badge-dot { background: var(--info); }
    .badge.out { background: rgba(167, 139, 250, 0.12); color: var(--accent2); }
    .badge.out .badge-dot { background: var(--accent2); }
    .badge.delivered { background: rgba(52, 211, 153, 0.12); color: var(--success); }
    .badge.delivered .badge-dot { background: var(--success); }
    .badge.cancelled { background: rgba(248, 113, 113, 0.12); color: var(--danger); }
    .badge.cancelled .badge-dot { background: var(--danger); }

    .action-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(108, 99, 255, 0.28);
      background: rgba(108, 99, 255, 0.08);
      color: var(--accent2);
      border-radius: 7px;
      padding: 6px 10px;
      font-size: 12px;
      font-weight: 600;
      white-space: nowrap;
      transition: all 0.15s ease;
    }

    .action-link:hover { background: rgba(108, 99, 255, 0.16); border-color: rgba(167, 139, 250, 0.5); }

    .empty-state {
      padding: 60px 20px;
      text-align: center;
      color: var(--muted);
    }

    .empty-icon {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1px solid var(--border);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 12px;
      color: var(--subtle);
    }

    .pagination {
      border-top: 1px solid var(--border);
      padding: 16px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .page-info { color: var(--muted); font-size: 13px; }
    .page-buttons { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }

    .page-btn {
      min-width: 34px;
      height: 34px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 7px;
      color: var(--muted);
      font-size: 13px;
      font-weight: 500;
      padding: 0 10px;
      transition: all 0.15s ease;
    }

    .page-btn:hover { color: var(--text); border-color: var(--subtle); }
    .page-btn.active { background: var(--accent); border-color: var(--accent); color: #fff; }
    .page-btn.disabled { opacity: 0.35; pointer-events: none; }
    .page-ellipsis { color: var(--muted); padding: 0 4px; }

    @media (max-width: 980px) {
      body { display: block; }
      .sidebar {
        width: 100%;
        height: auto;
        position: relative;
        border-right: 0;
        border-bottom: 1px solid #1e1e2e;
      }
      .nav-section, .nav-divider, .sidebar-footer { display: none; }
      .main { width: 100%; }
      .content { padding: 22px; }
      .stats-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .page-header { flex-direction: column; }
    }

    @media (max-width: 640px) {
      .topbar { padding: 0 20px; }
      .content { padding: 18px; }
      .stats-row { grid-template-columns: 1fr; }
      .filters { padding: 14px; }
      .search-form { min-width: 100%; flex-wrap: wrap; }
      .search-wrap { min-width: 100%; }
      .pagination { align-items: flex-start; flex-direction: column; }
    }
  </style>
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-icon">AP</div>
      <div>
        <div class="brand-name">AdminPanel</div>
        <div class="brand-sub">Control Center</div>
      </div>
    </div>

    <div class="nav-section">
      <div class="nav-section-label">Overview</div>
      <a href="/admin/dashboard" class="nav-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7" rx="1"></rect>
          <rect x="14" y="3" width="7" height="7" rx="1"></rect>
          <rect x="3" y="14" width="7" height="7" rx="1"></rect>
          <rect x="14" y="14" width="7" height="7" rx="1"></rect>
        </svg>
        Analytics
      </a>
    </div>

    <div class="nav-divider"></div>

    <div class="nav-section">
      <div class="nav-section-label">Management</div>
      <a href="/admin/users" class="nav-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="8" r="4"></circle>
          <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"></path>
        </svg>
        Users
      </a>
      <a href="/admin/order-management" class="nav-item active">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 12h6M9 16h6M9 8h2"></path>
          <rect x="3" y="3" width="18" height="18" rx="2"></rect>
        </svg>
        Orders
        <span class="nav-badge"><%= totalOrders %></span>
      </a>
      <a href="/admin/products" class="nav-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 7H4a1 1 0 00-1 1v10a1 1 0 001 1h16a1 1 0 001-1V8a1 1 0 00-1-1z"></path>
          <path d="M16 3H8l-1 4h10l-1-4z"></path>
        </svg>
        Products
      </a>
      <a href="/admin/category" class="nav-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
        Categories
      </a>
    </div>

    <div class="nav-divider"></div>

    <div class="nav-section">
      <div class="nav-section-label">Marketing</div>
      <a href="/admin/offers" class="nav-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2l2 7h7l-5.5 4 2 7L12 16l-5.5 4 2-7L3 9h7z"></path>
        </svg>
        Offers
      </a>
      <a href="/admin/coupons" class="nav-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 14l-4-4 4-4M15 10l4 4-4 4"></path>
        </svg>
        Coupons
      </a>
    </div>

    <div class="sidebar-footer">
      <form action="/admin/logout" method="POST">
        <button type="submit" class="logout-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"></path>
          </svg>
          Log out
        </button>
      </form>
    </div>
  </aside>

  <main class="main">
    <header class="topbar">
      <span class="topbar-title">Order Management</span>
      <div class="avatar">A</div>
    </header>

    <section class="content">
      <div class="page-header">
        <div>
          <h1>Orders</h1>
          <p>Track purchases, payment methods, delivery progress, and order value.</p>
        </div>
        <a href="/admin/order-management?status=<%= statusFilter %>&search=<%= encodeURIComponent(search || '') %>&page=<%= currentPage %>" class="btn-secondary">
          Refresh
        </a>
      </div>

      <div class="stats-row">
        <div class="stat-card">
          <div class="stat-label">Total Orders</div>
          <div class="stat-value accent"><%= totalOrders.toLocaleString('en-IN') %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Processing</div>
          <div class="stat-value warning"><%= processingCount.toLocaleString('en-IN') %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Delivered</div>
          <div class="stat-value success"><%= deliveredCount.toLocaleString('en-IN') %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Revenue</div>
          <div class="stat-value">&#8377;<%= revenue.toLocaleString('en-IN') %></div>
        </div>
      </div>

      <div class="filters">
        <form method="GET" action="/admin/order-management" class="search-form">
          <input type="hidden" name="status" value="<%= statusFilter %>" />
          <input type="hidden" name="page" value="1" />
          <div class="search-wrap">
            <span class="search-icon">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M20 20l-4-4"></path>
              </svg>
            </span>
            <input
              name="search"
              type="text"
              value="<%= search || '' %>"
              placeholder="Search by order code, customer, city, phone, or payment method"
            />
          </div>
          <button type="submit" class="btn-filter">Search</button>
          <% if (search) { %>
            <a href="/admin/order-management?status=<%= statusFilter %>&page=1" class="btn-clear">Clear</a>
          <% } %>
        </form>
        <div class="filter-tabs">
          <a href="/admin/order-management?status=all&search=<%= encodeURIComponent(search || '') %>&page=1" class="filter-tab <%= statusFilter === 'all' ? 'active' : '' %>">All</a>
          <a href="/admin/order-management?status=processing&search=<%= encodeURIComponent(search || '') %>&page=1" class="filter-tab <%= statusFilter === 'processing' ? 'active' : '' %>">Processing</a>
          <a href="/admin/order-management?status=shipped&search=<%= encodeURIComponent(search || '') %>&page=1" class="filter-tab <%= statusFilter === 'shipped' ? 'active' : '' %>">Shipped</a>
          <a href="/admin/order-management?status=delivered&search=<%= encodeURIComponent(search || '') %>&page=1" class="filter-tab <%= statusFilter === 'delivered' ? 'active' : '' %>">Delivered</a>
          <a href="/admin/order-management?status=cancelled&search=<%= encodeURIComponent(search || '') %>&page=1" class="filter-tab <%= statusFilter === 'cancelled' ? 'active' : '' %>">Cancelled</a>
                   
          

        </div>
      </div>

      <div class="table-wrap">
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Order</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Amount</th>
                <th>Payment</th>
                <th>Status</th>
                <th>Items</th>
                <th>Action</th>F
              </tr>
            </thead>
            <tbody>
              <% if (!orders || orders.length === 0) { %>
                <tr>
                  <td colspan="8">
                    <div class="empty-state">
                      <div class="empty-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M21 8v13H3V8"></path>
                          <path d="M1 3h22v5H1z"></path>
                          <path d="M10 12h4"></path>
                        </svg>
                      </div>
                      <p>No orders found for this filter.</p>
                    </div>
                  </td>
                </tr>
              <% } else { %>
                <% orders.forEach(order => { %>
                  <%
                    const address = order.shippingAddress || {};
                    const fullName = address.username || "Unknown Customer";
                    const nameParts = fullName.trim().split(/\s+/).filter(Boolean);
                    const initials = nameParts.length > 1
                      ? (nameParts[0][0] + nameParts[nameParts.length - 1][0]).toUpperCase()
                      : fullName.substring(0, 2).toUpperCase();
                    const orderCode = order.orderCode || String(order._id).slice(-8).toUpperCase();
                    const avatarClasses = ["avatar-a", "avatar-b", "avatar-c", "avatar-d", "avatar-e", "avatar-f"];
                    const avatarIndex = orderCode ? orderCode.charCodeAt(orderCode.length - 1) % avatarClasses.length : 0;
                    const avatarClass = avatarClasses[avatarIndex];
                    let statusClass = "processing";
                    let statusLabel = "Processing";

                    if (order.orderStatus === "cancelled" || order.deliveryStatus === "cancelled") {
                      statusClass = "cancelled";
                      statusLabel = "Cancelled";
                    } else if (order.deliveryStatus === "delivered") {
                      statusClass = "delivered";
                      statusLabel = "Delivered";
                    } else if (order.deliveryStatus === "shipped") {
                      statusClass = "shipped";
                      statusLabel = "Shipped";
                    } else if (order.deliveryStatus === "out_for_delivery") {
                      statusClass = "out";
                      statusLabel = "Out for Delivery";
                    }
                   
                    
                    const location = [address.city, address.state].filter(Boolean).join(", ");
                    const itemCount = order.orderItems ? order.orderItems.reduce((sum, item) => sum + (item.quantity || 0), 0) : 0;
                  %>
                  <tr>
                    <td class="mono"><%= orderCode %></td>
                    <td>
                      <div class="customer-cell">
                        <div class="customer-avatar <%= avatarClass %>"><%= initials %></div>
                        <div>
                          <div class="customer-name"><%= fullName %></div>
                          <div class="customer-sub"><%= location || address.phone_number || "Address unavailable" %></div>
                        </div>
                      </div>
                    </td>
                    <td class="date-cell">
                      <%= new Date(order.orderDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                    </td>
                    <td class="amount">&#8377;<%= Number(order.totalAmount || 0).toLocaleString('en-IN') %></td>
                    <td class="payment"><%= order.orderMethod || "-" %></td>
                    <td>
                      <span class="badge <%= statusClass %>">
                        <span class="badge-dot"></span>
                        <%= statusLabel %>
                      </span>
                    </td>
                    <td class="muted"><%= itemCount %> item<%= itemCount === 1 ? '' : 's' %></td>
                    <td>
                      <a href="/admin/orders/<%= order._id %>" class="action-link">View</a>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="pagination">
          <span class="page-info">
            Showing
            <%= filteredTotal === 0 ? 0 : Math.min((currentPage - 1) * limit + 1, filteredTotal) %>
            to
            <%= Math.min(currentPage * limit, filteredTotal) %>
            of <%= filteredTotal.toLocaleString('en-IN') %> orders
          </span>

          <% if (totalPages > 1) { %>
            <div class="page-buttons">
              <a href="/admin/order-management?status=<%= statusFilter %>&search=<%= encodeURIComponent(search || '') %>&page=<%= currentPage - 1 %>" class="page-btn <%= currentPage <= 1 ? 'disabled' : '' %>">Prev</a>

              <% for (let i = 1; i <= totalPages; i++) { %>
                <% if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) { %>
                  <a href="/admin/order-management?status=<%= statusFilter %>&search=<%= encodeURIComponent(search || '') %>&page=<%= i %>" class="page-btn <%= i === currentPage ? 'active' : '' %>"><%= i %></a>
                <% } else if (i === currentPage - 2 || i === currentPage + 2) { %>
                  <span class="page-ellipsis">...</span>
                <% } %>
              <% } %>

              <a href="/admin/order-management?status=<%= statusFilter %>&search=<%= encodeURIComponent(search || '') %>&page=<%= currentPage + 1 %>" class="page-btn <%= currentPage >= totalPages ? 'disabled' : '' %>">Next</a>
            </div>
          <% } %>
        </div>
      </div>
    </section>
  </main>
</body>
</html>
