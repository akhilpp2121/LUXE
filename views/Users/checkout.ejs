    .guarantee {
      text-align: center; font-size: 11px;
      letter-spacing: .1em; text-transform: uppercase; color: var(--text-3);
      display: flex; align-items: center; justify-content: center; gap: 6px;
    }
    .divider-dots {
      text-align: center; color: var(--text-4);
      letter-spacing: .6em; font-size: 12px; margin-top: 20px;
    }

    /* ── ADDRESS ERROR ── */
    #addr-select-error {
      font-size: 11px; color: var(--danger);
      letter-spacing: .06em; margin-bottom: 12px; display: none;
    }

    /* ── FOOTER ── */
    footer {
      border-top: 1px solid var(--border-1);
      margin-top: 70px; padding: 28px 28px;
      max-width: 1180px; margin-left: auto; margin-right: auto;
      display: flex; justify-content: space-between; align-items: center;
      flex-wrap: wrap; gap: 14px;
    }
    .footer-logo {
      font-family: 'Playfair Display', serif;
      font-size: 17px; font-weight: 500;
      color: var(--text-3); letter-spacing: .28em; text-transform: uppercase;
    }
    .footer-links { display: flex; gap: 24px; flex-wrap: wrap; }
    .footer-links a {
      font-size: 11px; letter-spacing: .1em; text-transform: uppercase;
      color: var(--text-4); text-decoration: none; transition: color .2s;
    }
    .footer-links a:hover { color: var(--accent); }
    .footer-copy { font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--text-4); }

    /* ── UTILITY ── */
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; }
  </style>
</head>

<body>

<!-- LOADING OVERLAY -->
<div id="loadingOverlay">
  <div class="spinner"></div>
  <p class="loading-text">Processing &nbsp;·&nbsp; Please wait</p>
</div>

<div class="page">

  <!-- HEADER -->
  <header>
    <a href="/" class="logo">Luxe</a>
    <div class="secure-badge">
      <div class="secure-dot"></div>
      Secure Checkout
    </div>
  </header>

  <!-- BREADCRUMB -->
  <div class="breadcrumb">
    <span class="bc-step active">Shipping</span>
    <div class="bc-line done"></div>
    <span class="bc-step">Payment</span>
    <div class="bc-line"></div>
    <span class="bc-step">Confirm</span>
  </div>

  <div class="main-grid">

    <!-- ═══════════════════ LEFT COLUMN ═══════════════════ -->
    <div>

      <!-- SHIPPING ADDRESS -->
      <div class="sec-title">Shipping Address</div>
      <p class="sec-sub">Select a saved address or add a new one</p>

      <div class="address-grid" id="addressCardGrid">
        <% address.forEach((ad) => {
          const isSelected = defaultAddress && String(ad._id) === String(defaultAddress._id);
        %>
          <div
            class="addr-card <%= isSelected ? 'selected' : '' %>"
            data-id="<%= ad._id %>"
            onclick="selectAddress(this)"
          >
            <div class="addr-check">✓</div>

            <% if (ad.isDefault) { %>
              <div class="addr-default-badge">Default</div>
            <% } %>

            <div class="addr-name"><%= ad.fullName %></div>
            <div class="addr-line">
              <%= ad.houseNumber %>, <%= ad.streetName %><br>
              <%= ad.city %>, <%= ad.state %> <%= ad.pincode %><br>
              <%= ad.country %>
            </div>
            <div class="addr-phone"><%= ad.phoneNumber %></div>

            <div class="addr-actions">
              <button class="addr-action-btn" type="button"
                      onclick="openEditAddress(event, '<%= ad._id %>')">
                Edit
              </button>
              <% if (!ad.isDefault) { %>
                <button class="addr-action-btn default-btn" type="button"
                        onclick="setAsDefault(event, '<%= ad._id %>')">
                  Set Default
                </button>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>

      <p id="addr-select-error">Please select a shipping address to continue.</p>

      <button class="add-addr-btn" onclick="openNewAddressForm()" id="addAddrToggle">
        <span style="font-size:18px;line-height:1">+</span>
        Add New Address
      </button>

      <!-- ADDRESS FORM (Add / Edit) -->
      <div class="form-panel" id="newAddrForm">
        <div class="form-panel-title" id="addrFormTitle">Add New Address</div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="f_name">Full Name</label>
            <input class="form-input" type="text" id="f_name" placeholder="e.g. Alexander Thorne">
          </div>
          <div class="form-group">
            <label class="form-label" for="f_mobile">Mobile Number</label>
            <input class="form-input" type="tel" id="f_mobile" placeholder="+91 00000 00000">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="f_house">House / Flat No.</label>
            <input class="form-input" type="text" id="f_house" placeholder="e.g. 721, Apt B">
          </div>
          <div class="form-group">
            <label class="form-label" for="f_street">Street / Road</label>
            <input class="form-input" type="text" id="f_street" placeholder="e.g. Fifth Avenue">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="f_pincode">Pincode / ZIP</label>
            <input class="form-input" type="text" id="f_pincode" placeholder="6-digit pincode" maxlength="6">
          </div>
          <div class="form-group">
            <label class="form-label" for="f_city">City / District</label>
            <input class="form-input" type="text" id="f_city" placeholder="Auto-filled from pincode">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="f_state">State</label>
            <input class="form-input" type="text" id="f_state" placeholder="Auto-filled from pincode">
          </div>
          <div class="form-group">
            <label class="form-label" for="f_country">Country</label>
            <input class="form-input" type="text" id="f_country" placeholder="India">
          </div>
        </div>
        <div class="form-row full">
          <div class="form-group">
            <label class="form-label" for="f_landmark">
              Landmark <span style="color:var(--text-4)">(optional)</span>
            </label>
            <input class="form-input" type="text" id="f_landmark" placeholder="Near ...">
          </div>
        </div>
        <div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin-top:8px">
          <button class="save-addr-btn" id="saveAddressBtn" onclick="saveAddressFromCheckout()">
            Save &amp; Use This Address
          </button>
          <button onclick="closeAddressForm()"
            style="background:transparent;border:none;color:var(--text-3);font-family:'DM Sans',sans-serif;
                   font-size:11px;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;">
            Cancel
          </button>
        </div>
      </div><!-- /newAddrForm -->

      <!-- PAYMENT METHOD -->
      <div class="payment-section">
        <div class="sec-title" style="margin-top:8px">Payment Method</div>
        <p class="sec-sub">Choose how you'd like to pay</p>

        <div class="pay-option selected" id="pay_cod" onclick="selectPayment('cod')">
          <div class="pay-radio"><div class="pay-dot"></div></div>
          <div class="pay-icon">🏠</div>
          <div>
            <div class="pay-label">Cash on Delivery</div>
            <div class="pay-sub">Pay when your order arrives</div>
          </div>
          <div class="pay-badge">Available</div>
        </div>

        <div class="pay-option disabled">
          <div class="pay-radio"></div>
          <div class="pay-icon">💳</div>
          <div>
            <div class="pay-label">Credit / Debit Card</div>
            <div class="pay-sub">Encrypted &amp; secure</div>
          </div>
        </div>

        <div class="pay-option disabled">
          <div class="pay-radio"></div>
          <div class="pay-icon">📱</div>
          <div>
            <div class="pay-label">UPI / Net Banking</div>
            <div class="pay-sub">Instant transfer</div>
          </div>
        </div>

        <div class="pay-option disabled">
          <div class="pay-radio"></div>
          <div class="pay-icon">💰</div>
          <div>
            <div class="pay-label">Luxe Wallet</div>
            <div class="pay-sub">Coming soon</div>
          </div>
        </div>
      </div><!-- /payment-section -->

    </div><!-- /left column -->


    <!-- ═══════════════════ RIGHT COLUMN — ORDER SUMMARY ═══════════════════ -->
    <div>
      <div class="summary-card">
        <div class="summary-title">Order Summary</div>

        <!-- PRODUCT LIST -->
        <div class="product-list">
          <% cart.forEach((p) => {
            const variant     = p.variantId;
            const product     = variant?.productId;
            const inStock     = (variant?.stock ?? 0) > 0;
            const isInvalid   = !product?.isActive || !variant?.isActive || !inStock;
            const hasDiscount = variant?.discount && variant.discount < variant?.price;
            const itemPrice   = hasDiscount ? variant.discount : (variant?.price || 0);
            const origPrice   = variant?.price || 0;
            const qty         = p.quantity || 1;
            const lineTotal   = itemPrice * qty;
            const origTotal   = origPrice * qty;
            const savedAmt    = hasDiscount ? (origTotal - lineTotal) : 0;
            const imgSrc      = variant?.images?.[0] ? '/uploads/' + variant.images[0] : null;
          %>
            <div class="prod-item <%= isInvalid ? 'invalid' : '' %>" id="cart-item-<%= p._id %>">

              <!-- Image -->
              <% if (imgSrc) { %>
                <img class="prod-img" src="<%= imgSrc %>" alt="<%= product?.name || 'Product' %>"
                     onerror="this.style.display='none'">
              <% } else { %>
                <div class="prod-img-placeholder">◻</div>
              <% } %>

              <!-- Info -->
              <div class="prod-info">
                <div class="prod-name"><%= product?.name || 'Unknown Product' %></div>
                <div class="prod-meta">
                  <% if (variant?.color) { %><span>Color: <%= variant.color %></span><% } %>
                  <% if (variant?.size)  { %><span>Size: <%= variant.size %></span><% } %>
                </div>
                <div class="prod-qty">Qty: <%= qty %></div>

                <% if (!isInvalid) { %>
                  <div class="prod-breakdown">
                    <div class="bd-row">
                      <span>Item Total</span>
                      <% if (hasDiscount) { %>
                        <span class="strike">₹<%= origTotal.toLocaleString('en-IN') %></span>
                      <% } else { %>
                        <span>₹<%= lineTotal.toLocaleString('en-IN') %></span>
                      <% } %>
                    </div>
                    <% if (hasDiscount) { %>
                      <div class="bd-row green">
                        <span>Discount</span>
                        <span>— ₹<%= savedAmt.toLocaleString('en-IN') %></span>
                      </div>
                    <% } %>
                    <div class="bd-row final">
                      <span>Item Final</span>
                      <span>₹<%= lineTotal.toLocaleString('en-IN') %></span>
                    </div>
                  </div>
                <% } %>

                <% if (!inStock) { %>
                  <span class="invalid-badge">Out of stock</span>
                <% } else if (!product?.isActive || !variant?.isActive) { %>
                  <span class="invalid-badge">Unavailable</span>
                <% } %>
              </div><!-- /prod-info -->

              <!-- Price column -->
              <div class="prod-prices">
                <% if (isInvalid) { %>
                  <div class="prod-price-strike">₹<%= lineTotal.toLocaleString('en-IN') %></div>
                <% } else { %>
                  <div class="prod-price-final">₹<%= lineTotal.toLocaleString('en-IN') %></div>
                  <% if (hasDiscount) { %>
                    <div class="prod-price-original">₹<%= origTotal.toLocaleString('en-IN') %></div>
                  <% } %>
                <% } %>
              </div>

            </div><!-- /prod-item -->
          <% }) %>
        </div><!-- /product-list -->

        <!-- COUPON -->
        <div class="coupon-wrap">
          <div class="coupon-label">Promo Code</div>
          <div class="coupon-row">
            <input class="coupon-input" type="text" id="couponInput"
                   placeholder="Enter promo code" autocomplete="off">
            <button class="coupon-btn" onclick="applyCoupon()">Apply</button>
          </div>
          <p class="coupon-msg" id="couponMsg"></p>
        </div>

        <!-- SAVINGS BANNER -->
        <% if (totalSavings > 0) { %>
          <div class="savings-bar">
            <span class="icon">✓</span>
            <p>You're saving <strong>₹<%= totalSavings.toLocaleString('en-IN') %></strong> on this order</p>
          </div>
        <% } %>

        <!-- PRICE BREAKDOWN -->
        <div class="price-section">
          <div class="price-row">
            <span class="pr-label">Total Price</span>
            <span class="pr-val" id="displaySubtotal">₹<%= totalPrice.toLocaleString('en-IN') %></span>
          </div>
          <div class="price-row discount">
            <span class="pr-label">Discount</span>
            <span class="pr-val" id="discountVal">— ₹<%= totalSavings.toLocaleString('en-IN') %></span>
          </div>
          <div class="price-row free">
            <span class="pr-label">Shipping Fee</span>
            <span class="pr-val" id="displayShipping">
              <% if (subtotal >= 999) { %>
                Free
              <% } else { %>
                <span style="color:var(--text-1)">₹99</span>
              <% } %>
            </span>
          </div>
          <div class="price-row total">
            <span class="pr-label">Final Price</span>
            <span class="pr-val" id="displayTotal">₹<%= grandTotal.toLocaleString('en-IN') %></span>
          </div>
        </div><!-- /price-section -->

        <!-- PLACE ORDER -->
        <button class="place-btn" id="placeOrderBtn" onclick="placeOrder()">
          <span style="font-size:15px">🔒</span>
          Place Order
        </button>

        <div class="guarantee">
          <span style="font-size:13px;color:var(--success)">✓</span>
          Free returns within 30 days
        </div>

        <div class="divider-dots">· · ·</div>

      </div><!-- /summary-card -->
    </div><!-- /right column -->

  </div><!-- /main-grid -->
</div><!-- /page -->

<!-- FOOTER -->
<footer>
  <div class="footer-logo">Luxe</div>
  <div class="footer-links">
    <a href="#">Privacy Policy</a>
    <a href="#">Terms of Service</a>
    <a href="#">Support</a>
    <a href="#">Shipping Info</a>
  </div>
  <p class="footer-copy">© <%= new Date().getFullYear() %> LUXE. All rights reserved.</p>
</footer>


<script>
  /* ── STATE ── */

  // ✅ FIX: Use defaultAddress from controller (covers isDefault=true OR first address fallback)
  let selectedAddressId = '<%= defaultAddress ? String(defaultAddress._id) : "" %>';
  let selectedPayment   = 'cod';
  let appliedDiscount   = 0;
  let editingAddressId  = '';
  let editingAddressDefault = false;
  const checkoutAddresses = <%- JSON.stringify(address).replace(/</g, '\\u003c') %>;

  const baseSavings  = <%= totalSavings %>;
  const baseTotal    = <%= grandTotal %>;

  /* ── LOADER ── */
  const overlay    = document.getElementById('loadingOverlay');
  const showLoader = () => overlay.classList.add('active');
  const hideLoader = () => overlay.classList.remove('active');

  /* ── ADDRESS SELECTION ── */
  function selectAddress(card) {
    document.querySelectorAll('.addr-card').forEach(c => c.classList.remove('selected'));
    card.classList.add('selected');
    selectedAddressId = card.dataset.id;
    document.getElementById('addr-select-error').style.display = 'none';
    closeAddressForm();
  }

  function clearAddressForm() {
    ['f_name','f_mobile','f_house','f_street','f_pincode','f_city','f_state','f_country','f_landmark'].forEach(id => {
      const el = document.getElementById(id);
      el.value = '';
      el.classList.remove('error');
    });
    document.getElementById('f_country').value = 'India';
  }

  function openNewAddressForm() {
    editingAddressId = '';
    editingAddressDefault = false;
    clearAddressForm();
    document.getElementById('addrFormTitle').textContent = 'Add New Address';
    document.getElementById('saveAddressBtn').textContent = 'Save & Use This Address';
    document.querySelectorAll('.addr-card').forEach(c => c.classList.remove('selected'));
    selectedAddressId = '';
    document.getElementById('newAddrForm').classList.add('open');
    document.getElementById('f_name').focus();
  }

  function closeAddressForm() {
    document.getElementById('newAddrForm').classList.remove('open');
    editingAddressId = '';
    editingAddressDefault = false;
  }

  function openEditAddress(event, id) {
    event.stopPropagation();
    const addr = checkoutAddresses.find(a => String(a._id) === String(id));
    if (!addr) return toast('error', 'Address not found.');

    editingAddressId      = String(id);
    editingAddressDefault = Boolean(addr.isDefault);

    document.getElementById('addrFormTitle').textContent    = 'Edit Address';
    document.getElementById('saveAddressBtn').textContent   = 'Update & Use This Address';
    document.getElementById('f_name').value    = addr.fullName    || '';
    document.getElementById('f_mobile').value  = addr.phoneNumber || '';
    document.getElementById('f_house').value   = addr.houseNumber || '';
    document.getElementById('f_street').value  = addr.streetName  || '';
    document.getElementById('f_pincode').value = addr.pincode     || '';
    document.getElementById('f_city').value    = addr.city        || '';
    document.getElementById('f_state').value   = addr.state       || '';
    document.getElementById('f_country').value = addr.country     || 'India';
    document.getElementById('f_landmark').value= addr.landmark    || '';

    document.querySelectorAll('.addr-card').forEach(c =>
      c.classList.toggle('selected', c.dataset.id === editingAddressId)
    );
    selectedAddressId = editingAddressId;
    document.getElementById('addr-select-error').style.display = 'none';
    document.getElementById('newAddrForm').classList.add('open');
    document.getElementById('newAddrForm').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  /* ── SET AS DEFAULT ── */
 async function setAsDefault(event, id) {
  event.stopPropagation();
  showLoader();
  try {
    const res  = await fetch(`/address/default/${id}`, { method: 'PATCH' }); // ✅ correct URL
    const data = await res.json();
    hideLoader();
    if (!res.ok || !data.success) return toast('error', data.message || 'Failed to set default.');
    Swal.fire({
      icon: 'success', title: 'Default address updated',
      timer: 1200, showConfirmButton: false,
      background: '#0b1e3a', color: '#e8f1ff', iconColor: '#4da6ff',
    });
    setTimeout(() => window.location.reload(), 1200);
  } catch(e) {
    hideLoader();
    toast('error', 'Something went wrong. Please try again.');
  }
}
  /* ── FORM VALIDATION ── */

  // Strip non-digits, handle +91 / 91 prefix
  function getPhoneDigits(value) {
    let digits = String(value || '').replace(/\D/g, '');
    if (digits.length === 12 && digits.startsWith('91')) digits = digits.slice(2);
    if (digits.length === 11 && digits.startsWith('0'))  digits = digits.slice(1);
    return digits;
  }

  // Per-field validators — each returns a string error or '' if valid
  const fieldValidators = {
    f_name(val) {
      if (!val)              return 'Full name is required.';
      if (val.length < 2)   return 'Name must be at least 2 characters.';
      if (val.length > 60)  return 'Name must be 60 characters or less.';
      if (!/^[A-Za-z]/.test(val))               return 'Name must start with a letter.';
      if (!/^[A-Za-z][A-Za-z .'-]*$/.test(val)) return 'Name can only contain letters, spaces, dots, hyphens or apostrophes.';
      return '';
    },
    f_mobile(val) {
      if (!val) return 'Mobile number is required.';
      const digits = getPhoneDigits(val);
      if (digits.length !== 10)          return 'Enter a valid 10-digit mobile number.';
      if (!/^[6-9]/.test(digits))        return 'Mobile number must start with 6, 7, 8 or 9.';
      if (/^(\d)\1{9}$/.test(digits))    return 'Enter a valid mobile number (not all same digits).';
      return '';
    },
    f_house(val) {
      if (!val)             return 'House / flat number is required.';
      if (val.length > 80)  return 'House number must be 80 characters or less.';
      if (!/[A-Za-z0-9]/.test(val)) return 'Enter a valid house or flat number.';
      return '';
    },
    f_street(val) {
      if (!val)              return 'Street / road is required.';
      if (val.length < 3)    return 'Street must be at least 3 characters.';
      if (val.length > 120)  return 'Street must be 120 characters or less.';
      if (!/[A-Za-z]/.test(val)) return 'Street must contain at least one letter.';
      return '';
    },
    f_pincode(val) {
      if (!val)                          return 'Pincode is required.';
      if (!/^\d{6}$/.test(val))          return 'Pincode must be exactly 6 digits.';
      if (!/^[1-9]/.test(val))           return 'Enter a valid pincode (cannot start with 0).';
      return '';
    },
    f_city(val) {
      if (!val)             return 'City is required.';
      if (val.length < 2)   return 'City must be at least 2 characters.';
      if (val.length > 50)  return 'City must be 50 characters or less.';
      if (!/^[A-Za-z]/.test(val))               return 'City must start with a letter.';
      if (!/^[A-Za-z][A-Za-z .'-]*$/.test(val)) return 'City contains invalid characters.';
      return '';
    },
    f_state(val) {
      if (!val)             return 'State is required.';
      if (val.length < 2)   return 'State must be at least 2 characters.';
      if (val.length > 50)  return 'State must be 50 characters or less.';
      if (!/^[A-Za-z]/.test(val))               return 'State must start with a letter.';
      if (!/^[A-Za-z][A-Za-z .'-]*$/.test(val)) return 'State contains invalid characters.';
      return '';
    },
    f_country(val) {
      if (!val)             return 'Country is required.';
      if (val.length < 2)   return 'Country must be at least 2 characters.';
      if (val.length > 56)  return 'Country must be 56 characters or less.';
      if (!/^[A-Za-z]/.test(val))               return 'Country must start with a letter.';
      if (!/^[A-Za-z][A-Za-z .'-]*$/.test(val)) return 'Country contains invalid characters.';
      return '';
    },
    f_landmark(val) {
      // optional — only validate if filled
      if (val && val.length > 120) return 'Landmark must be 120 characters or less.';
      return '';
    },
  };

  // Show or clear inline error under a field
  function setFieldError(id, message) {
    const el    = document.getElementById(id);
    const errId = id + '_err';
    let   errEl = document.getElementById(errId);

    if (!errEl) {
      errEl    = document.createElement('span');
      errEl.id = errId;
      errEl.style.cssText = 'font-size:10px;color:var(--danger);letter-spacing:.06em;margin-top:3px;display:block;';
      el.parentNode.appendChild(errEl);
    }

    if (message) {
      el.classList.add('error');
      errEl.textContent = message;
      errEl.style.display = 'block';
    } else {
      el.classList.remove('error');
      errEl.textContent   = '';
      errEl.style.display = 'none';
    }
  }

  // Clear all field errors
  function clearAllErrors() {
    Object.keys(fieldValidators).forEach(id => setFieldError(id, ''));
  }

  // Validate every field; show ALL errors at once; return false if any fail
  function validateForm() {
    let firstErrorId = null;
    let hasError     = false;

    for (const [id, validator] of Object.entries(fieldValidators)) {
      const el  = document.getElementById(id);
      const val = el.value.trim().replace(/\s+/g, ' ');
      el.value  = val; // normalise whitespace in-place
      const msg = validator(val);
      setFieldError(id, msg);
      if (msg && !firstErrorId) firstErrorId = id;
      if (msg) hasError = true;
    }

    if (firstErrorId) document.getElementById(firstErrorId).focus();
    return !hasError;
  }

  // Live validation — clear error as soon as field becomes valid
  Object.keys(fieldValidators).forEach(id => {
    const el = document.getElementById(id);
    if (!el) return;
    el.addEventListener('input', () => {
      const val = el.value.trim().replace(/\s+/g, ' ');
      const msg = fieldValidators[id](val);
      setFieldError(id, msg);
    });
    el.addEventListener('blur', () => {
      el.value = el.value.trim().replace(/\s+/g, ' ');
      const msg = fieldValidators[id](el.value);
      setFieldError(id, msg);
    });
  });

  /* ── TOAST ── */
  function toast(icon, title) {
    Swal.fire({
      toast: true, icon, title, position: 'top-right',
      showConfirmButton: false, timer: 3200,
      background: '#0b1e3a', color: '#e8f1ff',
      iconColor: icon === 'success' ? '#4da6ff' : '#f87171',
    });
  }

  /* ── SHARED: read form fields into an object ── */
  function getNewAddressPayload() {
    return {
      fullName:    document.getElementById('f_name').value.trim(),
      phoneNumber: document.getElementById('f_mobile').value.trim(),
      houseNumber: document.getElementById('f_house').value.trim(),
      streetName:  document.getElementById('f_street').value.trim(),
      pincode:     document.getElementById('f_pincode').value.trim(),
      city:        document.getElementById('f_city').value.trim(),
      state:       document.getElementById('f_state').value.trim(),
      landmark:    document.getElementById('f_landmark').value.trim(),
      country:     document.getElementById('f_country').value.trim(),
      isDefault:   false,   // new addresses are never default by default
    };
  }

  function getEditAddressPayload() {
    return {
      fullName:    document.getElementById('f_name').value.trim(),
      phoneNumber: document.getElementById('f_mobile').value.trim(),
      houseNumber: document.getElementById('f_house').value.trim(),
      streetName:  document.getElementById('f_street').value.trim(),
      pincode:     document.getElementById('f_pincode').value.trim(),
      city:        document.getElementById('f_city').value.trim(),
      state:       document.getElementById('f_state').value.trim(),
      landmark:    document.getElementById('f_landmark').value.trim(),
      country:     document.getElementById('f_country').value.trim(),
      isDefault:   editingAddressDefault,   // preserve existing default flag on edit
    };
  }

  /* ── SHARED: validate all fields before any save ── */
  async function validateBeforeSave() {
    // validateForm() returns boolean and shows ALL inline errors at once
    if (!validateForm()) return false;
    return true;
  }

  /* ── ADD ADDRESS  →  POST /address/add ── */
  async function addAddress() {
    if (!(await validateBeforeSave())) return;

    showLoader();
    try {
      const res    = await fetch('/address/add', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify(getNewAddressPayload()),
      });
      const result = await res.json();
      hideLoader();
      if (!res.ok || result.success === false)
        return toast('error', result.message || 'Failed to add address.');

      Swal.fire({
        icon: 'success', title: 'Address saved',
        timer: 1200, showConfirmButton: false,
        background: '#0b1e3a', color: '#e8f1ff', iconColor: '#4da6ff',
      });
      setTimeout(() => window.location.reload(), 1200);
    } catch {
      hideLoader();
      toast('error', 'Something went wrong. Please try again.');
    }
  }

  /* ── EDIT ADDRESS  →  PUT /address/edit/:id ── */
  async function updateAddress() {
    if (!editingAddressId) return toast('error', 'No address selected for editing.');
    if (!(await validateBeforeSave())) return;

    showLoader();
    try {
      const res    = await fetch(`/address/edit/${editingAddressId}`, {
        method:  'PUT',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify(getEditAddressPayload()),
      });
      const result = await res.json();
      hideLoader();
      if (!res.ok || result.success === false)
        return toast('error', result.message || 'Failed to update address.');

      Swal.fire({
        icon: 'success', title: 'Address updated',
        timer: 1200, showConfirmButton: false,
        background: '#0b1e3a', color: '#e8f1ff', iconColor: '#4da6ff',
      });
      setTimeout(() => window.location.reload(), 1200);
    } catch {
      hideLoader();
      toast('error', 'Something went wrong. Please try again.');
    }
  }

  /* ── ROUTER: button calls this; it decides which function to run ── */
  function saveAddressFromCheckout() {
    if (editingAddressId) {
      updateAddress();   // PUT
    } else {
      addAddress();      // POST
    }
  }

  /* ── PAYMENT ── */
  function selectPayment(method) {
    document.querySelectorAll('.pay-option:not(.disabled)').forEach(p => p.classList.remove('selected'));
    document.getElementById('pay_' + method)?.classList.add('selected');
    selectedPayment = method;
  }

  
  /* ── PLACE ORDER ── */
  async function placeOrder() {
    if (!selectedAddressId) {
      document.getElementById('addr-select-error').style.display = 'block';
      document.getElementById('addressCardGrid').scrollIntoView({ behavior: 'smooth', block: 'start' });
      return toast('error', 'Please select a shipping address.');
    }
    showLoader();
    try {
      const res  = await fetch('/checkout/place-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },

        body: JSON.stringify({
  addressId:     selectedAddressId,
  paymentMethod: selectedPayment,
}),
        
      });
      const data = await res.json();
      hideLoader();
      if (!data.success) return toast('error', data.message);
      Swal.fire({
        icon: 'success', title: 'Order Confirmed!',
        text: 'Redirecting to order summary…',
        timer: 1400, showConfirmButton: false,
        background: '#0b1e3a', color: '#e8f1ff', iconColor: '#4da6ff',
      });
      setTimeout(() => { window.location.href = data.redirect; }, 1400);
    } catch {
      hideLoader();
      toast('error', 'Something went wrong. Please try again.');
    }
  }
</script>

</body>
</html>
