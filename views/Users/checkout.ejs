    .prod-price-original { font-size: 11px; color: var(--text-4); text-decoration: line-through; margin-top: 2px; }
    .prod-price-strike { font-size: 13px; font-weight: 400; color: var(--text-4); text-decoration: line-through; }

    /* ── COUPON ── */
    .coupon-wrap { margin-bottom: 20px; }
    .coupon-label { font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--text-3); margin-bottom: 10px; }
    .coupon-row { display: flex; }
    .coupon-input {
      flex: 1; background: var(--blue-750);
      border: 1px solid var(--border-1); border-right: none;
      padding: 10px 14px; color: var(--text-1);
      font-family: 'DM Sans', sans-serif;
      font-size: 12px; letter-spacing: .08em; text-transform: uppercase;
      outline: none; transition: border-color .2s; border-radius: 5px 0 0 5px;
    }
    .coupon-input::placeholder { color: var(--text-4); }
    .coupon-input:focus { border-color: var(--border-2); }
    .coupon-btn {
      background: transparent; border: 1px solid var(--border-2);
      color: var(--accent); font-family: 'DM Sans', sans-serif;
      font-size: 11px; letter-spacing: .16em; text-transform: uppercase;
      padding: 10px 18px; cursor: pointer;
      transition: all .25s; white-space: nowrap; border-radius: 0 5px 5px 0;
    }
    .coupon-btn:hover { background: var(--accent); color: #020b18; }
    .coupon-msg { font-size: 11px; margin-top: 6px; letter-spacing: .06em; min-height: 16px; }

    /* ── PRICE BREAKDOWN ── */
    .savings-bar {
      background: rgba(52,211,153,.07);
      border: 1px solid rgba(52,211,153,.18);
      border-radius: 6px; padding: 10px 14px;
      display: flex; align-items: center; gap: 8px;
      margin-bottom: 20px;
    }
    .savings-bar .icon { font-size: 14px; color: var(--success); }
    .savings-bar p { font-size: 12px; color: var(--success); }
    .savings-bar strong { font-weight: 600; }

    .price-section {
      background: var(--blue-750);
      border: 1px solid var(--border-1);
      border-radius: 8px; padding: 18px 18px 4px;
      margin-bottom: 22px;
    }
    .price-row {
      display: flex; justify-content: space-between; align-items: center;
      padding-bottom: 12px;
    }
    .pr-label { font-size: 12px; color: var(--text-2); letter-spacing: .04em; }
    .pr-val { font-size: 13px; color: var(--text-1); font-weight: 500; }
    .price-row.free .pr-val { color: var(--success); font-size: 12px; font-weight: 500; }
    .price-row.discount .pr-label,
    .price-row.discount .pr-val { color: var(--success); }
