                <span class="material-symbols-outlined ic-search">search</span>
                <input name="search" type="text" placeholder="Search products..." value="<%= searchQuery || '' %>" />
                <button type="submit" aria-label="Search">
                    <span class="material-symbols-outlined" style="font-size:16px; color:#fff;">arrow_forward</span>
                </button>
            </form>

            <div class="flex items-center gap-4">

                <a href="/wishlist">
                    <button class="p-2 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full transition-colors">
                        <span class="material-symbols-outlined">favorite</span>
                    </button>
                </a>

                <a href="/cart"
                    class="relative p-2 text-slate-400 hover:text-white hover:bg-slate-800 rounded-lg transition-all">
                    <span class="material-symbols-outlined msym">shopping_cart</span>
                    <% if (locals.cart> 0) { %>
                        <span
                            class="absolute -top-1 -right-1 w-5 h-5 bg-primary text-white text-xs font-bold rounded-full flex items-center justify-center">
