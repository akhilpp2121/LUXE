<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>User Management — Admin</title>
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap"
    rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg: #0f0f13;
      --surface: #17171f;
      --card: #1e1e28;
      --border: #2a2a38;
      --accent: #6c63ff;
      --accent2: #a78bfa;
      --danger: #f87171;
      --success: #34d399;
      --warning: #fbbf24;
      --text: #e8e8f0;
      --muted: #7c7c96;
      --subtle: #3a3a50;
      --font: 'DM Sans', sans-serif;
      --mono: 'DM Mono', monospace;
    }

    body {
      font-family: var(--font);
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    /* ── Main ── */
    .main {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    .topbar {
      height: 60px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .topbar-title {
      font-size: 15px;
      font-weight: 500;
      color: var(--text);
    }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 600;
      color: #fff;
    }

    /* ── Page content ── */
    .content {
      padding: 32px;
      flex: 1;
    }

    .page-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 28px;
    }

    .page-header h1 {
      font-size: 22px;
      font-weight: 600;
      letter-spacing: -0.4px;
    }

    .page-header p {
      font-size: 13px;
      color: var(--muted);
      margin-top: 2px;
    }

    /* ── Stats row ── */
    .stats-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 28px;
    }

    .stat-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px 20px;
    }

    .stat-label {
      font-size: 12px;
      color: var(--muted);
      font-weight: 500;
      letter-spacing: 0.3px;
    }

    .stat-value {
      font-size: 24px;
      font-weight: 600;
      margin-top: 6px;
      letter-spacing: -0.5px;
    }

    .stat-value.accent {
      color: var(--accent2);
    }

    .stat-value.success {
      color: var(--success);
    }

    .stat-value.danger {
      color: var(--danger);
    }

    /* ── Error banner ── */
    .error-banner {
      background: rgba(248, 113, 113, 0.1);
      border: 1px solid rgba(248, 113, 113, 0.3);
      border-radius: 8px;
      padding: 12px 16px;
      color: var(--danger);
      font-size: 13px;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* ── Filters ── */
    .filters {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px 20px;
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }

    .search-wrap {
      flex: 1;
      min-width: 200px;
      position: relative;
    }

    .search-wrap input {
      width: 100%;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 7px;
      padding: 8px 12px 8px 36px;
      font-size: 13px;
      color: var(--text);
      font-family: var(--font);
      outline: none;
      transition: border-color 0.15s;
    }

    .search-wrap input:focus {
      border-color: var(--accent);
    }

    .search-wrap input::placeholder {
      color: var(--muted);
    }

    .search-icon {
      position: absolute;
      left: 11px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--muted);
      font-size: 14px;
      pointer-events: none;
    }

    .filter-select {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 7px;
      padding: 8px 12px;
      font-size: 13px;
      color: var(--text);
      font-family: var(--font);
      outline: none;
      cursor: pointer;
      transition: border-color 0.15s;
    }

    .filter-select:focus {
      border-color: var(--accent);
    }

    .btn-filter {
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 7px;
      padding: 8px 18px;
      font-size: 13px;
      font-family: var(--font);
      font-weight: 500;
      cursor: pointer;
      transition: opacity 0.15s;
    }

    .btn-filter:hover {
      opacity: 0.85;
    }

    .btn-reset {
      background: transparent;
      color: var(--muted);
      border: 1px solid var(--border);
      border-radius: 7px;
      padding: 8px 14px;
      font-size: 13px;
      font-family: var(--font);
      cursor: pointer;
      transition: color 0.15s, border-color 0.15s;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
    }

    .btn-reset:hover {
      color: var(--text);
      border-color: var(--subtle);
    }

    /* ── Table ── */
    .table-wrap {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    thead th {
      background: var(--surface);
      padding: 13px 20px;
      text-align: left;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      color: var(--muted);
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }

    tbody tr {
      border-bottom: 1px solid var(--border);
      transition: background 0.1s;
    }

    tbody tr:last-child {
      border-bottom: none;
    }

    tbody tr:hover {
      background: rgba(255, 255, 255, 0.02);
    }

    td {
      padding: 14px 20px;
      vertical-align: middle;
      color: var(--text);
    }

    .user-cell {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .user-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      flex-shrink: 0;
      background: var(--subtle);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 600;
      color: var(--accent2);
      overflow: hidden;
      border: 1px solid var(--border);
    }

    .user-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%;
      display: block;
    }

    .user-avatar .initials {
      line-height: 1;
    }

    .user-name {
      font-weight: 500;
      font-size: 13px;
    }

    .user-id {
      font-size: 11px;
      color: var(--muted);
      font-family: var(--mono);
    }

    .email-cell {
      color: var(--muted);
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 11px;
      font-weight: 600;
      padding: 3px 9px;
      border-radius: 20px;
      letter-spacing: 0.2px;
    }

    .badge-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
    }

    .badge.active {
      background: rgba(52, 211, 153, 0.12);
      color: var(--success);
    }

    .badge.active .badge-dot {
      background: var(--success);
    }

    .badge.blocked {
      background: rgba(248, 113, 113, 0.12);
      color: var(--danger);
    }

    .badge.blocked .badge-dot {
      background: var(--danger);
    }

    .date-cell {
      color: var(--muted);
      font-size: 12px;
      font-family: var(--mono);
    }

    .action-form {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .action-select {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 5px 9px;
      font-size: 12px;
      color: var(--text);
      font-family: var(--font);
      outline: none;
      cursor: pointer;
    }

    .btn-action {
      background: var(--subtle);
      color: var(--text);
      border: none;
      border-radius: 6px;
      padding: 5px 12px;
      font-size: 12px;
      font-family: var(--font);
      font-weight: 500;
      cursor: pointer;
      transition: background 0.15s;
    }

    .btn-action:hover {
      background: var(--accent);
      color: #fff;
    }

    .empty-state {
      padding: 60px 20px;
      text-align: center;
      color: var(--muted);
    }

    .empty-state .icon {
      font-size: 36px;
      margin-bottom: 12px;
      opacity: 0.4;
    }

    .empty-state p {
      font-size: 14px;
    }

    .pagination {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 20px;
      flex-wrap: wrap;
      gap: 12px;
    }

    .page-info {
      font-size: 13px;
      color: var(--muted);
    }

    .page-buttons {
      display: flex;
      gap: 6px;
      align-items: center;
    }

    .page-btn {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 6px 12px;
      font-size: 13px;
      color: var(--muted);
      cursor: pointer;
      font-family: var(--font);
      transition: all 0.15s;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
    }

    .page-btn:hover {
      color: var(--text);
      border-color: var(--subtle);
    }

    .page-btn.active {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
    }

    .page-btn.disabled {
      opacity: 0.35;
      pointer-events: none;
    }

    .toast {
      position: fixed;
      bottom: 28px;
      right: 28px;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 20px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 500;
      font-family: var(--font);
      z-index: 9999;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
      animation: slideUp 0.25s ease;
    }

    .toast.success {
      background: #1a2e26;
      border: 1px solid rgba(52, 211, 153, 0.3);
      color: #34d399;
    }

    .toast.warning {
      background: #2a2010;
      border: 1px solid rgba(251, 191, 36, 0.35);
      color: #fbbf24;
    }

    .toast.error {
      background: #2e1a1a;
      border: 1px solid rgba(248, 113, 113, 0.3);
      color: #f87171;
    }

    .toast-icon {
      font-size: 15px;
      font-weight: 700;
      width: 20px;
      height: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      flex-shrink: 0;
      background: rgba(255, 255, 255, 0.06);
    }
  </style>
</head>

<body>

  <!-- ── SIDEBAR ── -->
  <aside class="fixed left-0 top-0 h-full w-[280px] flex flex-col p-6 bg-[#0c1424] z-50">
    <div class="mb-8 px-4">
      <h1 class="text-2xl font-bold text-white">AdminPro</h1>
      <p class="text-[11px] font-medium text-[#a3aac4]">Enterprise Suite</p>
    </div>

    <nav class="flex-1 space-y-1">
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/dashboard">
        <span class="material-symbols-outlined text-lg">dashboard</span>Dashboard
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/order-management">
        <span class="material-symbols-outlined text-lg">shopping_cart</span>Orders
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/products">
        <span class="material-symbols-outlined text-lg">inventory_2</span>Products
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-white border-l-4 border-[#90abff] bg-[#1f2b49] font-bold text-sm"
        href="/admin/users">
        <span class="material-symbols-outlined text-lg">group</span>Users
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/analystic">
        <span class="material-symbols-outlined text-lg">monitoring</span>Analytics
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="#">
        <span class="material-symbols-outlined text-lg">confirmation_number</span>Coupons
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/category">
        <span class="material-symbols-outlined text-lg">category</span>Categories
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/offer">
        <span class="material-symbols-outlined text-lg">local_offer</span>Offers
      </a>
    </nav>

    <div class="mt-auto px-4 py-6 border-t border-[#1f2b49]">
      <form action="/admin/logout" method="POST" class="m-0">
        <button type="submit" class="flex items-center gap-3 w-full px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm">
          <span class="material-symbols-outlined text-lg">logout</span>Log out
        </button>
      </form>
    </div>
  </aside>

  <!-- ── MAIN ── -->
  <div class="main ml-[280px]">
    <header class="topbar">
      <span class="topbar-title">User Management</span>
      <div class="topbar-right">
        <div class="avatar">A</div>
      </div>
    </header>

    <div class="content">

      <div class="page-header">
        <div>
          <h1>Users</h1>
          <p>Manage and monitor all registered accounts</p>
        </div>
      </div>

      <div class="stats-row">
        <div class="stat-card">
          <div class="stat-label">Total Users</div>
          <div class="stat-value accent">
            <%= totalUser %>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Current Page</div>
          <div class="stat-value">
            <%= currentPage %> / <%= totalPage %>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Filter</div>
          <div class="stat-value" style="font-size:16px;margin-top:8px;text-transform:capitalize;">
            <%= status==='true' ? 'Active' : status==='false' ? 'Blocked' : 'All' %>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Sorted</div>
          <div class="stat-value" style="font-size:16px;margin-top:8px;text-transform:capitalize;">
            <%= sort==='oldest' ? 'Oldest First' : 'Newest First' %>
          </div>
        </div>
      </div>

      <% if (error) { %>
        <div class="error-banner">⚠ <%= error %>
        </div>
        <% } %>

          <form method="GET" action="/admin/users">
            <div class="filters">
              <div class="search-wrap">
                <span class="search-icon">⌕</span>
                <input type="text" name="search" placeholder="Search by name or email…" value="<%= search %>" />
              </div>
              <select name="status" class="filter-select">
                <option value="" <%=(!status || status==='undefined') ?'selected':'' %>>All Status</option>
                <option value="true" <%=status==='true' ?'selected':'' %>>Active</option>
                <option value="false" <%=status==='false' ?'selected':'' %>>Blocked</option>
              </select>
              <select name="sort" class="filter-select">
                <option value="latest" <%=sort==='latest' ?'selected':'' %>>Newest First</option>
                <option value="oldest" <%=sort==='oldest' ?'selected':'' %>>Oldest First</option>
              </select>
              <button type="submit" class="btn-filter">Apply</button>
              <a href="/admin/users" class="btn-reset">clear</a>
            </div>
          </form>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>#</th>
                  <th>User</th>
                  <th>Email</th>
                  <th>Phone</th>
                  <th>Status</th>
                  <th>Joined</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (data && data.length > 0) { %>
                  <% data.forEach((user, i) => { %>
                    <tr>
                      <td style="color:var(--muted);font-family:var(--mono);font-size:12px;">
                        <%= ((currentPage - 1) * 5) + i + 1 %>
                      </td>
                      <td>
                        <div class="user-cell">
                          <div class="user-avatar">
                            <% if (user.avatar && user.avatar.trim() !== '') { %>
                              <img src="<%= user.avatar %>" alt="<%= user.fullName %>"
                                onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                              <span class="initials" style="display:none;">
                                <%= user.fullName ? user.fullName.charAt(0).toUpperCase() : '?' %>
                              </span>
                            <% } else { %>
                              <span class="initials">
                                <%= user.fullName ? user.fullName.charAt(0).toUpperCase() : '?' %>
                              </span>
                            <% } %>
                          </div>
                          <div>
                            <div class="user-name">
                              <%= user.fullName || '—' %>
                            </div>
                            <div class="user-id">
                              <%= user._id %>
                            </div>
                          </div>
                        </div>
                      </td>
                      <td class="email-cell">
                        <%= user.email %>
                      </td>
                      <td style="color:var(--muted);font-size:13px;">
                        <%= user.phoneNumber || '—' %>
                      </td>
                      <td>
                        <span class="badge <%= user.isActive ? 'active' : 'blocked' %>">
                          <span class="badge-dot"></span>
                          <%= user.isActive ? 'Active' : 'Blocked' %>
                        </span>
                      </td>
                      <td class="date-cell">
                        <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) : '—' %>
                      </td>
                      <td>
                        <form action="/admin/users/edit" method="POST" class="action-form">
                          <input type="hidden" name="id" value="<%= user._id %>" />
                          <select name="isActive" class="action-select"
                            data-current="<%= user.isActive ? 'true' : 'false' %>" onchange="openModal(this)">
                            <option value="true" <%=user.isActive ? 'selected' : '' %>>Active</option>
                            <option value="false" <%=!user.isActive ? 'selected' : '' %>>Block</option>
                          </select>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="7">
                      <div class="empty-state">
                        <div class="icon">◎</div>
                        <p>No users found matching your filters.</p>
                      </div>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <% if (totalPage > 1) { %>
            <div class="pagination">
              <span class="page-info">
                Showing page <%= currentPage %> of <%= totalPage %> &nbsp;·&nbsp; <%= totalUser %> total users
              </span>
              <div class="page-buttons">
                <a href="/admin/users?page=<%= currentPage-1 %>&search=<%= encodeURIComponent(search || '') %>&status=<%= encodeURIComponent(status || '') %>&sort=<%= encodeURIComponent(sort || '') %>"
                  class="page-btn <%= currentPage <= 1 ? 'disabled' : '' %>">← Prev</a>

                <% for (let p = 1; p <= totalPage; p++) { %>
                  <% if (p === 1 || p === totalPage || (p >= currentPage - 1 && p <= currentPage + 1)) { %>
                    <a href="/admin/users?page=<%= p %>&search=<%= encodeURIComponent(search || '') %>&status=<%= encodeURIComponent(status || '') %>&sort=<%= encodeURIComponent(sort || '') %>"
                      class="page-btn <%= p === currentPage ? 'active' : '' %>">
                      <%= p %>
                    </a>
                  <% } else if (p === currentPage - 2 || p === currentPage + 2) { %>
                    <span class="page-btn" style="pointer-events:none;">…</span>
                  <% } %>
                <% } %>

                <a href="/admin/users?page=<%= currentPage+1 %>&search=<%= encodeURIComponent(search || '') %>&status=<%= encodeURIComponent(status || '') %>&sort=<%= encodeURIComponent(sort || '') %>"
                  class="page-btn <%= currentPage >= totalPage ? 'disabled' : '' %>">Next →</a>
              </div>
            </div>
          <% } %>

          <% if (toast) { %>
            <div id="toast" class="toast <%= toast.type %>">
              <span class="toast-icon">
                <% if (toast.type === 'success') { %>✓
                <% } else if (toast.type === 'warning') { %>⊘
                <% } else { %>✕
                <% } %>
              </span>
              <span>
                <%= toast.msg %>
              </span>
            </div>
          <% } %>

    </div>
  </div>

  <!-- Confirmation Modal -->
  <div id="modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.55);
  z-index:1000;align-items:center;justify-content:center;">
    <div style="background:#1e1e28;border:1px solid #2a2a38;border-radius:10px;
    padding:20px 22px;width:250px;font-family:'DM Sans',sans-serif;text-align:center;">
      <p id="modal-msg" style="font-size:13px;color:#e8e8f0;margin:0 0 14px;line-height:1.5;"></p>
      <div style="display:flex;gap:8px;">
        <button onclick="closeModal()" style="flex:1;padding:7px;background:transparent;
        border:1px solid #2a2a38;border-radius:7px;color:#7c7c96;font-size:12px;
        font-family:'DM Sans',sans-serif;cursor:pointer;">Cancel</button>
        <button id="modal-btn" style="flex:1;padding:7px;border-radius:7px;font-size:12px;
        font-weight:600;font-family:'DM Sans',sans-serif;cursor:pointer;border:1px solid;"></button>
      </div>
    </div>
  </div>

  <script>
    let _sel = null;

    function openModal(el) {
      _sel = el;
      const isBlock = el.value === 'false';
      document.getElementById('modal-msg').textContent =
        isBlock ? 'Block this user?' : 'Activate this user?';
      const btn = document.getElementById('modal-btn');
      btn.textContent = isBlock ? 'Block' : 'Activate';
      btn.style.background = isBlock ? 'rgba(248,113,113,0.15)' : 'rgba(52,211,153,0.12)';
      btn.style.borderColor = isBlock ? 'rgba(248,113,113,0.4)' : 'rgba(52,211,153,0.4)';
      btn.style.color = isBlock ? '#f87171' : '#34d399';
      btn.onclick = () => el.closest('form').submit();
      document.getElementById('modal').style.display = 'flex';
    }

    function closeModal() {
      document.getElementById('modal').style.display = 'none';
      if (_sel) _sel.value = _sel.dataset.current; // revert dropdown
    }

    document.getElementById('modal').addEventListener('click', function (e) {
      if (e.target === this) closeModal();
    });

    // Toast auto-dismiss
    document.addEventListener('DOMContentLoaded', function () {
      const toast = document.getElementById('toast');
      if (toast) {
        const timer = setTimeout(() => {
          toast.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(12px)';
          setTimeout(() => toast.remove(), 400);
        }, 5000);
        toast.addEventListener('click', () => { clearTimeout(timer); toast.remove(); });
      }
    });

    window.addEventListener('pageshow', function (e) {
      if (e.persisted) window.location.reload();
    });
  </script>

</body>

</html>
