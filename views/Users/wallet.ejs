<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>LUXE | Wallet</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Inter:wght@300;400;500&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; }

    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
      font-family: 'Inter', sans-serif;
      background-color: #0b1326;
      color: #dae2fd;
      overflow: hidden; /* nothing on body scrolls */
    }

    /* ── Page wrapper: navbar on top, layout below ── */
    .page-shell {
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
    }

    /* navbar partial sits here — give it a fixed known height */
    .page-shell > nav,
    .page-shell > header {
      flex-shrink: 0;  /* never shrink the navbar */
    }

    .headline-font { font-family: 'Plus Jakarta Sans', sans-serif; }

    /* ── Layout shell (sidebar + main) ── */
    .layout {
      display: flex;
      flex: 1;           /* takes all remaining height below navbar */
      overflow: hidden;  /* children manage their own scroll */
      min-height: 0;     /* critical — allows flex children to shrink below content size */
    }

    /* ── Sidebar ── */
    .sidebar {
      width: 224px;
      flex-shrink: 0;
      background: #131b2e;
      border-right: 1px solid rgba(255,255,255,0.05);
      display: flex;
      flex-direction: column;
      overflow: hidden; /* sidebar itself does NOT scroll */
    }

    .sidebar-brand {
      flex-shrink: 0;
      padding: 24px 24px 18px;
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    /* nav links area — only this scrolls if links overflow */
    .sidebar nav { flex: 1; padding: 12px 0; overflow-y: auto; min-height: 0; }

    .sidebar nav a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 24px;
      font-size: 13px;
      color: #c4c5d7;
      text-decoration: none;
      transition: transform 0.18s ease, background 0.18s ease, color 0.18s ease;
    }
    .sidebar nav a:hover:not(.active-nav) {
      transform: translateX(4px);
      color: #fff;
      background: rgba(34,42,61,0.5);
    }
    .sidebar nav a.active-nav {
      color: #fff;
      font-weight: 600;
      background: #222a3d;
      border-right: 3px solid #1d4ed8;
    }
    .sidebar nav a i { font-size: 16px; flex-shrink: 0; }

    .sidebar-footer {
      border-top: 1px solid rgba(255,255,255,0.05);
      padding: 8px 0 16px;
    }
    .sidebar-footer a {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 24px;
      font-size: 12px;
      color: #8e90a0;
      text-decoration: none;
      transition: color 0.15s;
    }
    .sidebar-footer a:hover { color: #fff; }

    /* ── Main scrollable area ── */
    .main-scroll {
      flex: 1;
      min-height: 0;     /* critical — lets it shrink below content size inside flex */
      overflow-y: auto;
      background: #0b1326;
      padding: 36px 40px 60px;
    }

    /* custom scrollbar on main */
    .main-scroll::-webkit-scrollbar { width: 5px; }
    .main-scroll::-webkit-scrollbar-track { background: #0b1326; }
    .main-scroll::-webkit-scrollbar-thumb { background: #2d3449; border-radius: 4px; }
    .main-scroll::-webkit-scrollbar-thumb:hover { background: #434655; }

    /* ── Cards ── */
    .card { background: #131b2e; border-radius: 12px; border: 1px solid rgba(255,255,255,0.06); }

    /* ── Live dot ── */
    @keyframes livepulse { 0%,100%{opacity:1} 50%{opacity:.35} }
    .live-dot { animation: livepulse 2s infinite; }

    /* ── Gauge ── */
    .gauge-circle { transition: stroke-dashoffset 1.5s cubic-bezier(.4,0,.2,1); }

    /* ── Table ── */
    tbody tr { transition: background 0.12s; }
    tbody tr:hover { background: rgba(255,255,255,0.02); }

    /* ── CTA ── */
    .cta-glow { transition: opacity 0.3s; opacity: 0.45; }
    .cta-wrap:hover .cta-glow { opacity: 1; }
    .cta-btn { transition: transform 0.2s ease; }
    .cta-wrap:hover .cta-btn { transform: scale(1.04); }

    /* ── Buttons ── */
    .btn-primary {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      flex: 1; background: #1d4ed8; color: #fff; border: none;
      border-radius: 10px; padding: 14px; font-size: 13px; font-weight: 700;
      cursor: pointer; transition: filter 0.2s;
    }
    .btn-primary:hover { filter: brightness(1.15); }
    .btn-secondary {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      flex: 1; background: #222a3d; color: #fff;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 10px; padding: 14px; font-size: 13px; font-weight: 700;
      cursor: pointer; transition: background 0.2s;
    }
    .btn-secondary:hover { background: #2d3449; }

    .icon-btn {
      display: flex; align-items: center; gap: 6px;
      background: #222a3d; border: 1px solid rgba(255,255,255,0.08);
      border-radius: 8px; padding: 7px 14px;
      font-size: 11px; color: #8e90a0; cursor: pointer;
      transition: color 0.15s, background 0.15s;
    }
    .icon-btn:hover { color: #fff; background: #2d3449; }

    /* ── Badge ── */
    .badge-ok {
      display: inline-block;
      padding: 3px 10px;
      background: rgba(52,211,153,0.1);
      color: #34d399;
      font-size: 10px; font-weight: 700;
      border-radius: 20px;
      border: 1px solid rgba(52,211,153,0.22);
    }
  </style>
</head>
<body>

<div class="page-shell">

<div class="layout">

  <!-- ─────────── Sidebar ─────────── -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <h2 class="headline-font" style="font-size:16px;font-weight:800;color:#fff;margin:0">User Account</h2>
      <p style="font-size:10px;color:#8e90a0;font-weight:500;letter-spacing:.1em;text-transform:uppercase;margin:3px 0 0">Premium Member</p>
    </div>

    <nav>
      <a href="/profile"><i class="ti ti-user"></i> Profile</a>
      <a href="/order/my-orders"><i class="ti ti-package"></i> My Orders</a>
      <a href="/address"><i class="ti ti-map-pin"></i> Manage Address</a>
      <a href="/changePassword"><i class="ti ti-lock"></i> Change Password</a>
      <a href="/wishlist"><i class="ti ti-heart"></i> Wishlist</a>
      <a href="/referal"><i class="ti ti-share"></i> Referral Link</a>
      <a href="/wallet" class="active-nav"><i class="ti ti-wallet"></i> Wallet</a>
     
    </nav>

    <div class="sidebar-footer">
      <a href="/logout"><i class="ti ti-logout" style="font-size:15px"></i> Sign Out</a>
    </div>
  </aside>

  <!-- ─────────── Main ─────────── -->
  <div class="main-scroll">

    <!-- Page Header -->
    <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:36px">
      <div>
        <p style="font-size:10px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:#b7c4ff;margin:0 0 6px">Personal Treasury</p>
        <h1 class="headline-font" style="font-size:32px;font-weight:800;color:#fff;margin:0;letter-spacing:-.02em">Wallet Overview</h1>
      </div>
      <div style="text-align:right">
        <p style="font-size:11px;color:#8e90a0;margin:0 0 5px">Last synced: Today, <%= time %></p>
        <div style="display:flex;align-items:center;gap:6px;justify-content:flex-end">
          <span class="live-dot" style="width:7px;height:7px;background:#34d399;border-radius:50%;display:inline-block"></span>
          <span style="color:#34d399;font-size:11px;font-weight:700">LIVE</span>
        </div>
      </div>
    </div>

    <!-- Top Grid -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:28px">

      <!-- Balance Card -->
      <div class="card" style="padding:28px;position:relative;overflow:hidden">
        <div style="position:absolute;top:-40px;right:-40px;width:200px;height:200px;background:rgba(29,78,216,0.06);border-radius:50%;filter:blur(40px);pointer-events:none"></div>
        <p style="font-size:9px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:#8e90a0;margin:0 0 16px">Total Available Balance</p>
        <div style="display:flex;align-items:baseline;gap:8px;margin-bottom:8px">
          <span class="headline-font" style="font-size:42px;font-weight:800;color:#fff;line-height:1">
            <i class="fa-brands fa-rockrms" style="font-size:28px;margin-right:4px;opacity:.8"></i><%= balance %>
          </span>
          
        </div>
        <div style="display:flex;align-items:center;gap:5px;color:#34d399;font-size:11px;font-weight:500;margin-bottom:28px">
          <i class="ti ti-trending-up" style="font-size:13px"></i>
          
        </div>
        <div style="display:flex;gap:10px">
        
        </div>
      </div>

      <!-- Spending Gauge -->
     
    </div>

    <!-- Transaction History -->
    <section style="margin-bottom:28px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px">
        <h3 class="headline-font" style="font-size:20px;font-weight:700;color:#fff;margin:0">Transaction History</h3>
        <div style="display:flex;gap:10px">
          <button class="icon-btn"><i class="ti ti-filter" style="font-size:13px"></i> Filter</button>
          <button class="icon-btn"><i class="ti ti-download" style="font-size:13px"></i> Export</button>
        </div>
      </div>

      <div class="card" style="overflow:hidden">
        <table style="width:100%;text-align:left;border-collapse:collapse">
          <thead>
            <tr style="background:rgba(255,255,255,0.03)">
              <th style="padding:12px 22px;font-size:9px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:#8e90a0">Reason</th>
              <th style="padding:12px 22px;font-size:9px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:#8e90a0">Date</th>
              <th style="padding:12px 22px;font-size:9px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:#8e90a0">Status</th>
              <th style="padding:12px 22px;font-size:9px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:#8e90a0;text-align:right">Amount</th>
            </tr>
          </thead>
          <tbody>
            <% if (transaction && transaction.length > 0) { %>
              <% transaction.forEach(function(t) { %>
                <tr style="border-top:1px solid rgba(255,255,255,0.04)">
                  <td style="padding:14px 22px;font-size:13px;color:#dae2fd;font-weight:500"><%= t.reason %></td>
                  <td style="padding:14px 22px;font-size:12px;color:#8e90a0"><%= t.createdAt.toDateString() %></td>
                  <td style="padding:14px 22px">
                    <span class="badge-ok">Completed</span>
                  </td>
                  <td style="padding:14px 22px;text-align:right;font-size:13px;font-weight:700;color:<%= t.type === 'credit' ? '#34d399' : '#f87171' %>">
                    <%= t.type === 'credit' ? '+' : '-' %>
                    <i class="fa-brands fa-rockrms" style="font-size:11px;opacity:.7;margin-right:2px"></i><%= t.amount %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="4" style="padding:48px 22px;text-align:center;color:#8e90a0;font-size:13px">
                  <i class="ti ti-inbox" style="font-size:26px;display:block;margin-bottom:8px;opacity:.35"></i>
                  No transactions yet
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div style="margin-top:16px;text-align:center">
        <button style="background:none;border:none;color:#b7c4ff;font-size:13px;font-weight:500;cursor:pointer;display:inline-flex;align-items:center;gap:5px;transition:color .15s" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#b7c4ff'">
          View All Transactions <i class="ti ti-chevron-right" style="font-size:13px"></i>
        </button>
      </div>
    </section>

    <!-- Upgrade CTA -->
   

  </div><!-- /main-scroll -->
</div><!-- /layout -->

<script>
  window.addEventListener('load', () => {
    const circle = document.querySelector('.gauge-circle');
    if (circle) {
      circle.style.strokeDashoffset = '389.6';
      requestAnimationFrame(() => {
        setTimeout(() => { circle.style.strokeDashoffset = '116.9'; }, 100);
      });
    }
  });
</script>

</div><!-- /page-shell -->
</body>
</html>
