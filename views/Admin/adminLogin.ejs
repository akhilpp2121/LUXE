<body class="bg-surface text-on-surface font-body selection:bg-primary selection:text-on-primary min-h-screen flex flex-col">
<header class="bg-[#060e20] flex justify-between items-center w-full px-8 py-6 max-w-full">
<div class="font-['Manrope'] font-black text-white tracking-widest uppercase text-xl">
            Luxe Admin
        </div>
<div class="flex gap-4">
<button class="text-[#a3aac4] hover:bg-[#1f2b49] transition-colors duration-300 p-2 rounded-lg active:scale-95 opacity-80">
<span class="material-symbols-outlined" data-icon="help_outline">help_outline</span>
</button>
<button class="text-[#a3aac4] hover:bg-[#1f2b49] transition-colors duration-300 p-2 rounded-lg active:scale-95 opacity-80">
<span class="material-symbols-outlined" data-icon="language">language</span>
</button>
</div>
</header>
<main class="flex-grow flex items-center justify-center relative px-6 py-12">
<div class="absolute inset-0 overflow-hidden pointer-events-none">
<div class="absolute -top-[20%] -left-[10%] w-[60%] h-[60%] bg-primary-dim opacity-[0.03] rounded-full blur-[120px]"></div>
<div class="absolute -bottom-[20%] -right-[10%] w-[60%] h-[60%] bg-tertiary-dim opacity-[0.03] rounded-full blur-[120px]"></div>
</div>
<div class="w-full max-w-md relative">
<div class="glass-panel border border-outline-variant/15 rounded-xl p-10 shadow-2xl">
<div class="mb-10">
<h1 class="font-headline text-3xl font-extrabold tracking-tight text-white mb-2">Executive Access</h1>
<p class="text-on-surface-variant font-label text-sm uppercase tracking-widest">Luxe Executive Console</p>
</div>
<form class="space-y-8" action="/admin/login" method="post" autocomplete="off">
<div>
<label class="block text-on-surface-variant text-[0.75rem] font-medium uppercase tracking-wider mb-2" for="email">Administrator Email</label>
<div class="relative">
<input class="w-full bg-surface-container-lowest border-b-2 border-outline-variant focus:border-primary text-white px-0 py-3 outline-none transition-all placeholder:text-outline-variant/50" id="email" placeholder="Enter Your Email" type="email" name="email" />
</div>
</div>
<div>
<div class="flex justify-between items-center mb-2">
<label class="block text-on-surface-variant text-[0.75rem] font-medium uppercase tracking-wider" for="password">Password</label>
</div>
<div class="relative">
<input class="w-full bg-surface-container-lowest border-b-2 border-outline-variant focus:border-primary text-white px-0 py-3 outline-none transition-all placeholder:text-outline-variant/50" id="password" placeholder="••••••••••••" type="password" name="password"/>
</div>
</div>
<div class="flex items-center justify-between">
<label class="flex items-center group cursor-pointer">
<input class="hidden peer" type="checkbox"/>
<div class="w-5 h-5 border border-outline-variant rounded bg-surface-container-low peer-checked:bg-primary peer-checked:border-primary flex items-center justify-center transition-all">
<span class="material-symbols-outlined text-[14px] text-on-primary-container opacity-0 peer-checked:opacity-100" data-icon="check">check</span>
</div>
<span class="ml-3 text-[0.8rem] text-on-surface-variant font-medium tracking-wide">Stay signed in</span>
</label>
</div>
<button class="w-full py-4 rounded-xl bg-gradient-to-br from-primary-dim to-primary text-on-primary font-headline font-bold text-base tracking-wide shadow-lg shadow-primary/20 hover:brightness-110 active:scale-[0.98] transition-all">
                        Login 
                    </button>
</form>
<div class="mt-12 flex items-center justify-center space-x-6 grayscale opacity-40">
<img alt="security-badge" class="h-6" data-alt="minimalist white vector security shield icon with clean lines and sharp corners" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAGAkRPjeflqy448BEj_uefmg43C9CYAYUCUZ4rNRmWFipLYAdLFJVI2sX4MIWKrIXXwuLI7lCJXq-iY4pjZcLeMg0NCBAPwy9MJRYiINLcDSjzgS8OQvKcvimKFfMMcho-tovv1_LCtEH1TlcyQrI95aHDxVMFuXUsXgOXNuaCwIsMn2p-i3YUmkRyh7eCKBFOqI5fEZhloW5H5k6R0E8kJjjimVkoyPYO2jX-tT70a0S1Sf-qo0MY_dvCdPz7GgHj7H1Xm_rW4nEq"/>
