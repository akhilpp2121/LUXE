</script>
<style>
  .glass-panel {
    background: rgba(25, 37, 64, 0.7);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }

  /* Input focus line animation */
  .input-line {
    position: relative;
  }
  .input-line::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 0; height: 2px;
    background: #90abff;
    transition: width 0.35s cubic-bezier(.4,0,.2,1);
  }
  .input-line:focus-within::after {
    width: 100%;
  }
  .input-line input {
    border-bottom: 2px solid #40485d;
  }
  .input-line:focus-within input {
    border-bottom-color: transparent;
  }

  /* Eye button */
  .eye-btn {
    position: absolute;
    right: 0; top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: #6d758c;
    display: flex;
    align-items: center;
    padding: 4px;
    border-radius: 6px;
    transition: color 0.2s, background 0.2s;
    outline: none;
  }
  .eye-btn:hover {
    color: #90abff;
    background: rgba(144,171,255,0.08);
  }
  .eye-btn .material-symbols-outlined {
    font-size: 20px;
    user-select: none;
  }

  /* Card entrance */
  @keyframes cardUp {
    from { opacity: 0; transform: translateY(28px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  .card-enter { animation: cardUp 0.55s cubic-bezier(.34,1.2,.64,1) both; }

  /* Glow pulse on logo */
  @keyframes glowPulse {
    0%, 100% { text-shadow: 0 0 12px rgba(144,171,255,0.15); }
    50%       { text-shadow: 0 0 28px rgba(144,171,255,0.35); }
  }
  .brand-glow { animation: glowPulse 3.5s ease-in-out infinite; }

  /* Divider line */
  .divider-line {
    background: linear-gradient(90deg, transparent, #40485d55, transparent);
    height: 1px;
    border: none;
  }

  /* Flash message */
  .flash-error {
    background: rgba(159,5,25,0.18);
    border: 1px solid rgba(255,113,108,0.25);
    border-radius: 10px;
    padding: 10px 16px;
    color: #ffa8a3;
    font-size: 0.82rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }
</style>
</head>
<body class="bg-surface text-on-surface font-body selection:bg-primary selection:text-on-primary min-h-screen flex flex-col">

<!-- ── HEADER ── -->
<header class="bg-[#060e20] flex justify-between items-center w-full px-8 py-6">
  <div class="font-headline font-black text-white tracking-widest uppercase text-xl brand-glow">
    Luxe <span style="color:#90abff">Admin</span>
  </div>
  <div class="flex gap-2">
    <button class="text-on-surface-variant hover:bg-surface-bright hover:text-white transition-all duration-200 p-2 rounded-lg active:scale-95">
      <span class="material-symbols-outlined" style="font-size:20px">help_outline</span>
    </button>
    <button class="text-on-surface-variant hover:bg-surface-bright hover:text-white transition-all duration-200 p-2 rounded-lg active:scale-95">
      <span class="material-symbols-outlined" style="font-size:20px">language</span>
    </button>
  </div>
</header>

<!-- ── MAIN ── -->
<main class="flex-grow flex items-center justify-center relative px-6 py-12">

  <!-- Background blobs -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-[20%] -left-[10%] w-[60%] h-[60%] bg-primary-dim opacity-[0.04] rounded-full blur-[140px]"></div>
    <div class="absolute -bottom-[20%] -right-[10%] w-[60%] h-[60%] bg-tertiary-dim opacity-[0.03] rounded-full blur-[140px]"></div>
    <!-- subtle grid -->
    <div style="
      position:absolute; inset:0;
      background-image: linear-gradient(rgba(144,171,255,0.025) 1px, transparent 1px),
                        linear-gradient(90deg, rgba(144,171,255,0.025) 1px, transparent 1px);
      background-size: 48px 48px;
    "></div>
  </div>

  <div class="w-full max-w-md relative card-enter">

    <!-- Top label -->
    <div class="flex items-center gap-3 mb-6 px-1">
      <div style="width:28px;height:1px;background:rgba(144,171,255,0.3)"></div>
      <span style="font-size:0.6rem;letter-spacing:0.22em;color:#6d758c;text-transform:uppercase;font-family:'Inter',sans-serif;font-weight:600">Restricted Access</span>
    </div>

    <div class="glass-panel border border-white/[0.06] rounded-xl shadow-2xl overflow-hidden">

      <!-- Card top accent line -->
      <div style="height:2px;background:linear-gradient(90deg,transparent 5%,rgba(144,171,255,0.5) 50%,transparent 95%)"></div>

      <div class="p-10">

        <!-- Heading -->
        <div class="mb-10">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px">
            <div style="
              width:38px;height:38px;border-radius:10px;
              background:rgba(144,171,255,0.1);
              border:1px solid rgba(144,171,255,0.2);
              display:flex;align-items:center;justify-content:center;
              flex-shrink:0;
            ">
              <span class="material-symbols-outlined" style="font-size:18px;color:#90abff;font-variation-settings:'FILL' 1">shield_person</span>
            </div>
            <div>
              <h1 class="font-headline text-2xl font-extrabold tracking-tight text-white leading-tight">Executive Access</h1>
              <p style="font-size:0.62rem;letter-spacing:0.2em;color:#6d758c;text-transform:uppercase;font-family:'Inter';font-weight:600;margin-top:2px">Luxe Executive Console</p>
            </div>
          </div>
        </div>

        <!-- Form -->
        <form class="space-y-7" action="/admin/login" method="post" autocomplete="off">

          <!-- Email -->
          <div>
            <label class="block text-on-surface-variant text-[0.7rem] font-semibold uppercase tracking-wider mb-3" for="email">
              Administrator Email
            </label>
            <div class="input-line relative">
              <input
                class="w-full bg-transparent text-white px-0 py-3 pr-8 outline-none transition-all placeholder:text-outline-variant/40 text-sm"
                id="email" name="email" type="email"
                placeholder="admin@luxeatelier.com"
                autocomplete="off"
              />
              <span class="material-symbols-outlined absolute right-0 top-1/2 -translate-y-1/2 text-outline pointer-events-none" style="font-size:18px">alternate_email</span>
            </div>
          </div>

          <!-- Password -->
          <div>
            <label class="block text-on-surface-variant text-[0.7rem] font-semibold uppercase tracking-wider mb-3" for="password">
              Password
            </label>
            <div class="input-line relative">
              <input
                class="w-full bg-transparent text-white px-0 py-3 pr-10 outline-none transition-all placeholder:text-outline-variant/40 text-sm"
                id="password" name="password" type="password"
                placeholder="••••••••••••"
                autocomplete="new-password"
              />
             
              <button type="button" class="eye-btn" id="eyeBtn" onclick="togglePassword()" title="Show/Hide password">
                <span class="material-symbols-outlined" id="eyeIcon">visibility</span>
              </button>
            </div>
          </div>

          <!-- Stay signed in -->
          <div class="flex items-center justify-between pt-1">
            <label class="flex items-center group cursor-pointer gap-3">
              <div class="relative">
                <input class="hidden peer" type="checkbox" id="remember"/>
                <div class="w-[18px] h-[18px] border border-outline-variant rounded bg-surface-container-low peer-checked:bg-primary peer-checked:border-primary flex items-center justify-center transition-all">
                  <span class="material-symbols-outlined text-[12px] text-on-primary-container opacity-0 peer-checked:opacity-100 transition-opacity" style="font-variation-settings:'FILL' 1">check</span>
                </div>
              </div>
              <span class="text-[0.78rem] text-on-surface-variant font-medium tracking-wide select-none">Stay signed in</span>
            </label>
          </div>

          <!-- Submit -->
          <button
            type="submit"
            class="w-full py-[14px] rounded-xl font-headline font-bold text-sm tracking-widest uppercase transition-all active:scale-[0.98] relative overflow-hidden"
            style="
              background: linear-gradient(135deg, #316bf3 0%, #90abff 100%);
              color: #000e2e;
              box-shadow: 0 4px 32px rgba(49,107,243,0.35), 0 1px 0 rgba(255,255,255,0.12) inset;
              letter-spacing: 0.14em;
            "
            onmouseover="this.style.boxShadow='0 6px 40px rgba(49,107,243,0.5), 0 1px 0 rgba(255,255,255,0.15) inset'"
            onmouseout="this.style.boxShadow='0 4px 32px rgba(49,107,243,0.35), 0 1px 0 rgba(255,255,255,0.12) inset'"
          >
            <span style="position:relative;z-index:1">Sign In</span>
            <div style="
              position:absolute;inset:0;
              background:linear-gradient(135deg,rgba(255,255,255,0.12),transparent);
              pointer-events:none;
            "></div>
          </button>

        </form>

        <!-- Divider + badges -->
        <hr class="divider-line my-8"/>
        <div class="flex items-center justify-center gap-6" style="opacity:0.35;filter:grayscale(1)">
          <img alt="security-badge" class="h-5" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAGAkRPjeflqy448BEj_uefmg43C9CYAYUCUZ4rNRmWFipLYAdLFJVI2sX4MIWKrIXXwuLI7lCJXq-iY4pjZcLeMg0NCBAPwy9MJRYiINLcDSjzgS8OQvKcvimKFfMMcho-tovv1_LCtEH1TlcyQrI95aHDxVMFuXUsXgOXNuaCwIsMn2p-i3YUmkRyh7eCKBFOqI5fEZhloW5H5k6R0E8kJjjimVkoyPYO2jX-tT70a0S1Sf-qo0MY_dvCdPz7GgHj7H1Xm_rW4nEq"/>
          <div style="width:1px;height:16px;background:#40485d"></div>
          <img alt="compliance-badge" class="h-5" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBFFlRu6JHO0FwHT9hHqWFPB7FsnObgjPmkaxsEKd4eFudzwKtHhYBMZbojRMFlzJTRuavoxqYHVXwrT-Lntf8fzAGGI1EOac0Z7Kgjrl3wUv60SIr49UB6YOzOzCATN2w0WOl5zPUAlJ5swDPv8UW4xzFxgj8hTIqweD7f29vNd-1syRgVZ0vDGAMz0ScUD-a5Vac1YKN-ACmQaM-vWoXXRi9zlzboyuAPiL4ANxJG9jtpg5tKlMQqRYmWzU6qsnbOrrNrl4R1ss2H"/>
        </div>

      </div>
    </div>

    <!-- Bottom note -->
    <p style="text-align:center;margin-top:24px;font-size:0.6rem;letter-spacing:0.2em;color:#40485d;text-transform:uppercase;font-family:'Inter'">
      Restricted Enterprise Environment
    </p>

  </div>
</main>

<!-- ── FOOTER ── -->
<footer class="bg-[#060e20] border-t border-outline-variant/10 flex flex-col md:flex-row justify-between items-center w-full px-12 py-8 gap-4">
  <div style="font-size:0.72rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:#6d758c;font-family:'Inter'">
    © 2024 Luxe Executive Systems. All rights reserved.
  </div>
  <div class="flex gap-8">
    <a style="font-size:0.72rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:#6d758c;text-decoration:none;transition:color 0.2s;font-family:'Inter'" href="#" onmouseover="this.style.color='#dee5ff'" onmouseout="this.style.color='#6d758c'">Security Policy</a>
    <a style="font-size:0.72rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:#6d758c;text-decoration:none;transition:color 0.2s;font-family:'Inter'" href="#" onmouseover="this.style.color='#dee5ff'" onmouseout="this.style.color='#6d758c'">Terms of Service</a>
    <a style="font-size:0.72rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:#6d758c;text-decoration:none;transition:color 0.2s;font-family:'Inter'" href="#" onmouseover="this.style.color='#dee5ff'" onmouseout="this.style.color='#6d758c'">System Status</a>
  </div>
</footer>

<script>
  // ── Eye toggle — logic unchanged ──
  function togglePassword() {
    const input = document.getElementById('password');
    const icon  = document.getElementById('eyeIcon');
    if (input.type === 'password') {
      input.type = 'text';
      icon.textContent = 'visibility_off';
    } else {
      input.type = 'password';
      icon.textContent = 'visibility';
    }
  }

  // ── Back/forward cache fix — logic unchanged ──
  window.addEventListener('pageshow', function(event) {
    if (event.persisted) {
      window.location.href = '/admin/login';
    }
  });
</script>
</body>
</html>