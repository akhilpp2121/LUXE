<%
  /* ── SERVER-SIDE CALCULATIONS (runs first, before any HTML output) ── */

  let subtotal     = 0;
  let totalSavings = 0;

  cart.forEach(p => {
    const v       = p.variantId;
    const inStk   = (v?.stock ?? 0) > 0;
    const isInv   = !v?.productId?.isActive || !v?.isActive || !inStk;
    if (!isInv) {
      const hasDiscount = v?.discount && v.discount < v?.price;
      const ep  = hasDiscount ? v.discount : (v?.price || 0);
      const op  = v?.price || 0;
      const qty = p.quantity || 1;
      const lineTotal = ep * qty;
      const origTotal = op * qty;
      subtotal     += lineTotal;
      totalSavings += hasDiscount ? (origTotal - lineTotal) : 0;
    }
  });

  const shipping   = subtotal >= 999 ? 0 : 99;
  const totalPrice = subtotal + totalSavings;
  const grandTotal = subtotal + shipping;
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Checkout — LUXE</title>
