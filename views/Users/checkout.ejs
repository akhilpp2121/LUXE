    .coupon-cards-list::-webkit-scrollbar { width: 2px; }
    .coupon-cards-list::-webkit-scrollbar-thumb { background: var(--accent-dim); border-radius: 2px; }

    .coupon-card {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      padding: 12px 14px;
      border: 1px dashed var(--border-2);
      border-radius: 6px;
