<script>
  /* ─────────────────────────────────────────
     TOAST
  ───────────────────────────────────────── */
  let _toastTimer;

  function showToast(msg, icon = 'check_circle', cls = 'text-green-400') {
    document.getElementById('toast-msg').textContent = msg;
    const ic = document.getElementById('toast-icon');
    ic.textContent = icon;
    ic.className   = 'material-symbols-outlined msym ' + cls;
    document.getElementById('toast').classList.add('show');
    clearTimeout(_toastTimer);
    _toastTimer = setTimeout(
      () => document.getElementById('toast').classList.remove('show'),
      2800
    );
  }

  
  function lockCart(message) {
    document.querySelectorAll('.qty-btn, .remove-btn').forEach(btn => {
      btn.disabled = true;
      btn.style.pointerEvents = 'none';
      btn.style.opacity = '0.4';
    });
    showToast(message, 'block', 'text-red-400');
  }

  function rollbackQty(cartId, variantId, qty, maxStock) {
    const qtyEl = document.getElementById('qty-' + cartId);
    const row   = document.getElementById('cart-item-' + cartId);
    if (!qtyEl || !row) return;

    const [minusBtn, plusBtn] = row.querySelectorAll('.qty-btn');
    qtyEl.textContent = qty;
    minusBtn.disabled = qty <= 1;
    plusBtn.disabled  = qty >= maxStock || qty >= 10;
    minusBtn.setAttribute('onclick', `changeQty('${cartId}','${variantId}',-1,${qty},${maxStock})`);
    plusBtn.setAttribute( 'onclick', `changeQty('${cartId}','${variantId}', 1,${qty},${maxStock})`);
  }

  async function changeQty(cartId, variantId, delta, currentQty, maxStock) {

    if (maxStock <= 0) {
      return showToast('This item is no longer available', 'block', 'text-red-400');
    }

    const newQty = currentQty + delta;
    if (newQty < 1) return;

    if (newQty > maxStock) {
      return showToast(`Only ${maxStock} item(s) available in stock`, 'inventory_2', 'text-amber-400');
    }
    if (newQty > 10) {
      return showToast('Maximum 10 items allowed per order', 'block', 'text-amber-400');
    }

    const row    = document.getElementById('cart-item-' + cartId);
    const qtyEl  = document.getElementById('qty-' + cartId);
    if (!row || !qtyEl) return;

    const [minusBtn, plusBtn] = row.querySelectorAll('.qty-btn');
    qtyEl.textContent = newQty;
    minusBtn.disabled = newQty <= 1;
    plusBtn.disabled  = newQty >= maxStock || newQty >= 10;
    minusBtn.setAttribute('onclick', `changeQty('${cartId}','${variantId}',-1,${newQty},${maxStock})`);
    plusBtn.setAttribute( 'onclick', `changeQty('${cartId}','${variantId}', 1,${newQty},${maxStock})`);

    try {
      const res  = await fetch('/cart/update-quantity', {
        method : 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body   : JSON.stringify({ cartId, variantId, quantity: newQty })
      });
      const data = await res.json();

      if (!data.success) {
        rollbackQty(cartId, variantId, currentQty, maxStock);

        if (res.status === 401) return lockCart(data.message);
        return showToast(data.message || 'Could not update', 'error', 'text-red-400');
      }

      if (data.unitPrice) {
        const lineEl = document.getElementById('line-total-' + cartId);
        if (lineEl) lineEl.textContent = (data.unitPrice * newQty).toLocaleString('en-IN');
      }

      updateSummary();
      showToast('Cart updated', 'check_circle', 'text-green-400');

    } catch {
      rollbackQty(cartId, variantId, currentQty, maxStock);
      showToast('Something went wrong', 'error', 'text-red-400');
    }
  }

  
  async function removeItem(cartId, variantId) {
  try {
    const res  = await fetch('/cart/remove-cart', {
      method : 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body   : JSON.stringify({ variantId })
    });
    const data = await res.json();

    if (!data.success) {
      if (res.status === 401) return lockCart(data.message);
      return showToast(data.message || 'Failed to remove', 'error', 'text-red-400');
    }

    document.getElementById('cart-item-' + cartId)?.remove();
    showToast('Item removed', 'check_circle', 'text-green-400');
    updateSummary();

    if (document.querySelectorAll('[id^="cart-item-"]').length === 0) {
      location.reload();
    }

  } catch {
    showToast('Something went wrong', 'error', 'text-red-400');
  }
}
  
  function updateSummary() {
    let subtotal = 0;
    document.querySelectorAll('[id^="line-total-"]').forEach(el => {
      subtotal += parseInt(el.textContent.replace(/,/g, '')) || 0;
    });
    const shipping = subtotal >= 999 ? 0 : 99;
    document.getElementById('summary-subtotal').textContent =
      '₹' + subtotal.toLocaleString('en-IN');
    document.getElementById('summary-total').textContent =
      '₹' + (subtotal + shipping).toLocaleString('en-IN');
  }
</script>

</body>
</html>
