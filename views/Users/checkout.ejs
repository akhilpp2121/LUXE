<style>
  /* ── FORCE DARK COLOR-SCHEME ──
     Without this, browsers fall back to a light base for native form
     chrome (autofill overlay, date/number spinners, etc.) even when
     every visible property is styled dark — the box-shadow inset trick
     below only fully works once this is set. */
  html, body { color-scheme: dark; }

  body { font-family: 'Manrope', sans-serif; }
  .msym { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }

  #toast {
    position: fixed; bottom: 2rem; left: 50%;
    transform: translateX(-50%) translateY(120px);
    z-index: 9999;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    pointer-events: none;
  }
  #toast.show { transform: translateX(-50%) translateY(0); }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .fu { animation: fadeUp 0.5s ease forwards; opacity: 0; }
  .d1 { animation-delay: 0.05s; }
  .d2 { animation-delay: 0.12s; }
  .d3 { animation-delay: 0.20s; }
  .d4 { animation-delay: 0.28s; }

  /* ── LOADING OVERLAY ── */
  #loadingOverlay {
    display: none; position: fixed; inset: 0;
    background: rgba(16,22,34,.88); backdrop-filter: blur(8px);
    z-index: 9999; justify-content: center; align-items: center;
    flex-direction: column; gap: 18px;
  }
  #loadingOverlay.active { display: flex; }
  .spinner {
    width: 40px; height: 40px;
    border: 2px solid #1e293b; border-top-color: #1152d4;
    border-radius: 50%; animation: spin .7s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ── ADDRESS CARDS ── */
  .addr-card {
    background: #0d1322; border: 1px solid #1e293b; border-radius: 12px;
    padding: 20px 20px 20px 24px; cursor: pointer; position: relative;
    transition: border-color .2s, background .2s, transform .15s;
  }
  .addr-card:hover { border-color: #1e3a6e; background: #0f1829; transform: translateY(-1px); }
  .addr-card.selected { border-color: #1152d4; background: rgba(17,82,212,.08); box-shadow: 0 0 0 1px rgba(17,82,212,.25); }
  .addr-check {
    position: absolute; top: 16px; right: 16px; width: 20px; height: 20px;
    border: 1.5px solid #334155; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 10px; color: transparent; transition: all .2s;
  }
  .addr-card.selected .addr-check { background: #1152d4; border-color: #1152d4; color: #fff; font-weight: 700; }

  /* ══════════════════════════════
     ADDRESS FORM — inputs + autofill fix
  ══════════════════════════════ */
  .form-panel { display: none; }
  .form-panel.open { display: block; animation: fadeUp .25s ease; }

  .form-input,
  input.form-input[type="text"],
  input.form-input[type="tel"] {
    background-color: #0b1120 !important;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 11px 14px;
    color: #f1f5f9 !important;
    font-family: 'Manrope', sans-serif;
    font-size: 13px;
    outline: none;
    transition: border-color .2s, background-color .2s;
    width: 100%;
    caret-color: #f1f5f9;
    color-scheme: dark;
  }
  .form-input:focus { border-color: #1152d4 !important; background-color: #0d1322 !important; }
  .form-input::placeholder { color: #475569; }
  .form-input.error { border-color: #ef4444 !important; }

  /* Kills the white/yellow autofill background on Chrome/Edge (webkit) */
  .form-input:-webkit-autofill,
  .form-input:-webkit-autofill:hover,
  .form-input:-webkit-autofill:focus,
  .form-input:-webkit-autofill:active {
    -webkit-text-fill-color: #f1f5f9 !important;
    -webkit-box-shadow: 0 0 0 1000px #0b1120 inset !important;
    box-shadow: 0 0 0 1000px #0b1120 inset !important;
    caret-color: #f1f5f9 !important;
    border: 1px solid #1e293b !important;
    transition: background-color 9999s ease-in-out 0s, color 9999s ease-in-out 0s;
  }
  .form-input:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0 1000px #0d1322 inset !important;
    box-shadow: 0 0 0 1000px #0d1322 inset !important;
    border-color: #1152d4 !important;
  }
  /* Firefox */
  .form-input:autofill {
    background-color: #0b1120 !important;
    color: #f1f5f9 !important;
  }

  /* ── PAYMENT ── */
  .pay-option {
    background: #0d1322; border: 1px solid #1e293b; border-radius: 12px;
    padding: 18px 20px; cursor: pointer; transition: border-color .2s, background .2s;
  }
  .pay-option:hover:not(.disabled) { border-color: #1e3a6e; }
  .pay-option.selected { border-color: #1152d4; background: rgba(17,82,212,.08); }
  .pay-option.disabled { opacity: .35; cursor: not-allowed; }
  .pay-radio {
    width: 18px; height: 18px; border: 1.5px solid #334155; border-radius: 50%;
    flex-shrink: 0; display: flex; align-items: center; justify-content: center; transition: border-color .2s;
  }
  .pay-option.selected .pay-radio { border-color: #1152d4; }
  .pay-dot { width: 8px; height: 8px; border-radius: 50%; background: #1152d4; display: none; }
  .pay-option.selected .pay-dot { display: block; }

  /* ── PAYPAL BUTTON FRAME ──
     PayPal's SDK renders its own iframe internally with a white/light
     background baked in (button + "Powered by PayPal" footer) — this
     can't be recolored with CSS. Instead of letting that white patch sit
     bare on the dark page, we frame it in a card that matches the other
     payment options (same border, radius, and background rhythm), so the
     white content reads as an intentional inset panel rather than a
     visual glitch. */
  .paypal-card {
    background: #ffffff;
    border: 1px solid #1e293b;
    border-radius: 12px;
    padding: 14px;
  }

  /* ── ORDER SUMMARY ── */
  .summary-card { background: #0d1322; border: 1px solid #1e293b; border-radius: 16px; padding: 1.5rem; position: sticky; top: 96px; }

  .scroll-thin::-webkit-scrollbar { width: 4px; }
  .scroll-thin::-webkit-scrollbar-track { background: transparent; }
  .scroll-thin::-webkit-scrollbar-thumb { background: #1152d4; border-radius: 2px; }

  .prod-item.invalid { opacity: .5; }
  .invalid-badge {
    display: inline-flex; align-items: center; gap: 4px;
    background: rgba(239,68,68,.12); color: #f87171;
    font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 20px;
    text-transform: uppercase; letter-spacing: .05em;
  }

  /* ══════════════════════════════
     COUPON — inputs + autofill fix
  ══════════════════════════════ */
  .coupon-wrap { border: 1px solid #1e293b; border-radius: 12px; overflow: hidden; margin-bottom: 20px; }
  .coupon-header { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: #0b1120; border-bottom: 1px solid #1e293b; cursor: pointer; user-select: none; }
  .coupon-chevron { transition: transform .25s; }
  .coupon-chevron.open { transform: rotate(180deg); }
  .coupon-body { padding: 14px 16px; background: #0d1322; }
  .coupon-card {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 12px 14px; border: 1px dashed #334155; border-radius: 8px; background: #0b1120;
    transition: border-color .2s, background .2s; position: relative;
  }
  .coupon-card:hover { border-color: #1152d4; background: #0f1829; }
  .coupon-card.applied { border-color: #34d399; background: rgba(52,211,153,.06); border-style: solid; }
  .coupon-card.applied .coupon-card-code { color: #34d399; }
  .coupon-card-btn {
    background: transparent; border: 1px solid #334155; color: #60a5fa;
    font-family: 'Manrope', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    padding: 6px 14px; border-radius: 6px; cursor: pointer; white-space: nowrap; flex-shrink: 0; transition: all .2s;
  }
  .coupon-card-btn:hover { background: #1152d4; color: #fff; border-color: #1152d4; }
  .coupon-card-btn.remove-btn { border-color: rgba(239,68,68,.4); color: #f87171; }
  .coupon-card-btn.remove-btn:hover { background: #ef4444; color: #fff; border-color: #ef4444; }

  .coupon-input,
  input.coupon-input[type="text"] {
    flex: 1;
    background-color: #0d1322 !important;
    border: 1px solid #1e293b;
    border-right: none;
    padding: 10px 14px;
    color: #cbd5e1 !important;
    font-family: 'Manrope', sans-serif;
    font-size: 12px; letter-spacing: .05em; text-transform: uppercase; outline: none;
    border-radius: 8px 0 0 8px;
    caret-color: #1152d4;
    color-scheme: dark;
  }
  .coupon-input::placeholder { color: #475569; text-transform: none; }
  .coupon-input:focus { border-color: #1152d4 !important; background-color: #0d1322 !important; }

  .coupon-input:-webkit-autofill,
  .coupon-input:-webkit-autofill:hover,
  .coupon-input:-webkit-autofill:focus,
  .coupon-input:-webkit-autofill:active {
    -webkit-text-fill-color: #cbd5e1 !important;
    -webkit-box-shadow: 0 0 0 1000px #0d1322 inset !important;
    box-shadow: 0 0 0 1000px #0d1322 inset !important;
    caret-color: #1152d4 !important;
    transition: background-color 9999s ease-in-out 0s, color 9999s ease-in-out 0s;
  }
