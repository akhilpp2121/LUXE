    .coupon-btn:hover { background: var(--accent); color: #020b18; border-color: var(--accent); }

    /* Status message */
    .coupon-msg {
      font-size: 11px; margin-top: 8px;
      letter-spacing: .06em; min-height: 16px;
      display: flex; align-items: center; gap: 6px;
