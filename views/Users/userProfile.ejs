<script>
let currentInput = null;
let currentType = null;

// OPEN MODAL
document.querySelectorAll(".field-btn").forEach((btn) => {
  btn.addEventListener("click", function () {
    console.log("BUTTON CLICKED");

    currentInput = this.parentElement.querySelector("input");

    currentType = currentInput.dataset.type;

    // fallback fix
    if (!currentType) {
      currentType = currentInput.type === "email" ? "email" : "name";
    }

    document.getElementById("editInput").value = currentInput.value;
    document.getElementById("editModal").classList.add("show");
  });
});



// CLOSE MODAL
function closeModal() {
  document.getElementById("editModal").classList.remove("show");
}

function saveEdit() {
  console.log("SAVE CLICKED");

  if (!currentInput) return;

  let newValue = document.getElementById("editInput").value.trim();
  let errorMsg = document.getElementById("errorMsg");

  errorMsg.innerText = "";

  // validation
  if (currentType === "name") {
    if (newValue.length < 3) {
      errorMsg.innerText = "Name must be at least 3 characters.";
      return;
    }
  }

  if (currentType === "email") {
    let pattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    if (!pattern.test(newValue)) {
      errorMsg.innerText = "Enter a valid email address.";
      return;
    }
  }

  // set values
  document.getElementById("typeField").value = currentType;
  document.getElementById("valueField").value = newValue;

  console.log("Submitting:", currentType, newValue);

  // submit form
  document.getElementById("updateForm").submit();
}


</script>



