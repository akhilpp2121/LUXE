</div>
</div>
<div class="mt-8 text-center">
<p class="text-on-surface-variant/40 text-[0.65rem] uppercase tracking-[0.2em]">Restricted Enterprise Environment</p>
</div>
</div>
</main>
<footer class="bg-[#060e20] border-t border-[#40485d]/10 flex flex-col md:flex-row justify-between items-center w-full px-12 py-8 gap-4">
<div class="font-['Inter'] text-[0.75rem] font-medium uppercase tracking-wider text-[#a3aac4]">
            © 2024 Luxe Executive Systems. All rights reserved.
        </div>
<div class="flex gap-8">
<a class="font-['Inter'] text-[0.75rem] font-medium uppercase tracking-wider text-[#a3aac4] hover:text-white transition-colors active:opacity-70" href="#">Security Policy</a>
<a class="font-['Inter'] text-[0.75rem] font-medium uppercase tracking-wider text-[#a3aac4] hover:text-white transition-colors active:opacity-70" href="#">Terms of Service</a>
<a class="font-['Inter'] text-[0.75rem] font-medium uppercase tracking-wider text-[#a3aac4] hover:text-white transition-colors active:opacity-70" href="#">System Status</a>
