<script>
  /**
   * submitFilter()
   * Sync search value from the header input into the hidden #ff_search field
   * inside #filterForm, then submit — so search is never lost when a
   * sidebar filter changes.
   */
  function submitFilter() {
    const si = document.getElementById('searchInput');
    if (si) document.getElementById('ff_search').value = si.value.trim();
    document.getElementById('filterForm').submit();
  }
 

  function setPrice(min, max) {
  document.getElementById('minPriceInput').value = min;
  document.getElementById('maxPriceInput').value = max;
  submitFilter();
}
  /* Submit search form on Enter key */
  document.addEventListener('DOMContentLoaded', function () {
    const si = document.getElementById('searchInput');
    if (si) {
      si.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          document.getElementById('searchForm').submit();
        }
      });
    }
  });
</script>

