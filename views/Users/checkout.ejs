<script src="https://www.paypal.com/sdk/js?client-id=AUVHxcEAGa6HevQSXIEiiZsdjAsegfmTNURoAmrnB8bwpdC7o8UHeuImbPwCGu7Gq-33yqvrfJq4dM8l&currency=USD"></script>

<script>
  /* ── STATE ── */
  let selectedAddressId     = '<%= defaultAddress ? String(defaultAddress._id) : "" %>';
  let selectedPayment       = 'cod';
  let appliedDiscount       = 0;
  let appliedCouponCode     = '';
  let editingAddressId      = '';
  let editingAddressDefault = false;
  let paypalButtonsRendered = false;

  const checkoutAddresses = <%- JSON.stringify(address).replace(/</g, '\\u003c') %>;
  const baseGrandTotal    = <%= grandTotal %>;
  const orderTotal        = <%= orderTotal %>;
  const walletBalance     = <%= walletBalance %>;

  /* ── LOADER ── */
  const overlay    = document.getElementById('loadingOverlay');
  const showLoader = () => overlay.classList.add('active');
  const hideLoader = () => overlay.classList.remove('active');

  /* ── TOAST ── */
  function toast(icon, title) {
    Swal.fire({
      toast: true, icon, title,
      position: 'top-right', showConfirmButton: false, timer: 3200,
      background: '#0b1e3a', color: '#e8f1ff',
      iconColor: icon === 'success' ? '#4da6ff' : '#f87171'
    });
  }

  /* ══════════════════════════════
     PAYMENT SELECTION
  ══════════════════════════════ */
  function selectPayment(method) {
    document.querySelectorAll('.pay-option:not(.disabled)')
            .forEach(p => p.classList.remove('selected'));
    document.getElementById('pay_' + method)?.classList.add('selected');
    selectedPayment = method;

    const paypalContainer = document.getElementById('paypal-button-container');
    const placeBtn        = document.getElementById('placeOrderBtn');

    if (method === 'paypal') {
      paypalContainer.style.display = 'block';
      placeBtn.style.display        = 'none';   // PayPal has its own button
      if (!paypalButtonsRendered) renderPaypalButtons();
    } else {
      paypalContainer.style.display = 'none';
      placeBtn.style.display        = 'flex';
    }
  }

  /* ══════════════════════════════
     PAYPAL INTEGRATION
  ══════════════════════════════ */
  function renderPaypalButtons() {
    paypal.Buttons({

      // 1️⃣  Create the PayPal order via your backend
      createOrder: async function () {
        if (!selectedAddressId) {
          document.getElementById('addr-select-error').style.display = 'block';
          document.getElementById('addressCardGrid')
                  .scrollIntoView({ behavior: 'smooth', block: 'start' });
          toast('error', 'Please select a shipping address.');
          // Returning undefined prevents the PayPal popup from opening
          return Promise.reject(new Error('No address selected'));
        }

        try {
          const res  = await fetch('/checkout/paypal/create-order', { method: 'POST' });
          const data = await res.json();
          if (!data.id) throw new Error(data.message || 'Could not create PayPal order');
          return data.id;   // PayPal order ID
        } catch (err) {
          toast('error', err.message || 'PayPal order creation failed.');
          return Promise.reject(err);
        }
      },

      // 2️⃣  Capture payment & place the order in your DB
      onApprove: async function (data) {
        showLoader();
        try {
          // Step A — capture payment with PayPal
          const captureRes  = await fetch('/checkout/paypal/capture-order', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ orderID: data.orderID }),
          });
          const captureData = await captureRes.json();

          if (!captureData.success || captureData.status !== 'COMPLETED') {
            hideLoader();
            return toast('error', 'PayPal payment was not completed. Please try again.');
          }

          // Step B — place order in your system
          const orderRes  = await fetch('/checkout/place-order', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              addressId:      selectedAddressId,
              paymentMethod:  'paypal',
              couponCode:     appliedCouponCode || null,
              discount:       appliedDiscount   || 0,
              paypalOrderId:  data.orderID,     // pass through for your records
            }),
          });
          const orderData = await orderRes.json();

          hideLoader();

          if (!orderData.success) return toast('error', orderData.message);

          Swal.fire({
            icon: 'success', title: 'Payment Successful!',
            text: 'Your PayPal payment has been captured. Redirecting…',
            timer: 1800, showConfirmButton: false,
            background: '#0b1e3a', color: '#e8f1ff', iconColor: '#4da6ff',
          });
          setTimeout(() => { window.location.href = orderData.redirect; }, 1800);

        } catch (err) {
          hideLoader();
          toast('error', 'Something went wrong during payment. Please try again.');
        }
      },

      //   User cancelled
      onCancel: function () {
        window.location.href='/checkout/cancel'
      },

      // 4️⃣  PayPal error
      onError: function (err) {
        console.error('PayPal error:', err);
        toast('error', 'A PayPal error occurred. Please try again.');
      },

      // Style to match your dark theme
      style: {
        layout: 'vertical',
        color:  'blue',
        shape:  'rect',
        label:  'pay',
        height: 45,
      },

    }).render('#paypal-button-container');

    paypalButtonsRendered = true;
  }

  /* ══════════════════════════════
     COUPON LOGIC  (unchanged)
  ══════════════════════════════ */
  function toggleCouponPanel() {
    const body    = document.getElementById('couponBody');
    const chevron = document.getElementById('couponChevron');
    const isOpen  = body.style.display !== 'none';
    body.style.display = isOpen ? 'none' : 'block';
    chevron.classList.toggle('open', !isOpen);
  }

  async function applyCoupon(code) {
    const inputEl    = document.getElementById('couponInput');
    const couponCode = (code || inputEl.value || '').trim().toUpperCase();
    if (!couponCode) { showCouponMsg('Please enter a coupon code.', 'error'); inputEl.focus(); return; }
    if (appliedCouponCode && appliedCouponCode === couponCode) { removeCoupon(); return; }
    showCouponMsg('Checking…', '');
    try {
      const res  = await fetch('/checkout/apply-coupon', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code: couponCode, orderTotal }),
      });
      const data = await res.json();
      if (data.success) {
        appliedDiscount   = data.discount;
        appliedCouponCode = data.couponCode;
        inputEl.value     = data.couponCode;
        resetAllCouponCards();
        const card   = document.getElementById('couponCard_' + data.couponCode);
        const btn    = document.getElementById('couponBtn_' + data.couponCode);
        const saveEl = document.getElementById('couponSave_' + data.couponCode);
        if (card) { card.classList.add('applied'); saveEl.textContent = '✓ Saves ₹' + data.discount.toLocaleString('en-IN'); saveEl.style.display = 'block'; }
        if (btn)  { btn.textContent = 'Remove'; btn.classList.add('remove-btn'); btn.onclick = () => removeCoupon(); }
        updateGrandTotal(data.discount, data.couponCode);
        showCouponMsg('✓ ' + data.message, 'success');
      } else {
        showCouponMsg(data.message, 'error');
      }
    } catch { showCouponMsg('Something went wrong. Please try again.', 'error'); }
  }

  function removeCoupon() {
    resetAllCouponCards();
    appliedDiscount = 0; appliedCouponCode = '';
    document.getElementById('couponInput').value = '';
    updateGrandTotal(0, null);
    showCouponMsg('Coupon removed.', '');
  }

  function resetAllCouponCards() {
    document.querySelectorAll('.coupon-card').forEach(card => {
      card.classList.remove('applied');
      const code   = card.id.replace('couponCard_', '');
      const btn    = document.getElementById('couponBtn_' + code);
      const saveEl = document.getElementById('couponSave_' + code);
      if (btn)    { btn.textContent = 'Apply'; btn.classList.remove('remove-btn'); btn.onclick = () => applyCoupon(code); }
      if (saveEl) { saveEl.style.display = 'none'; saveEl.textContent = ''; }
    });
  }

  function updateGrandTotal(discount, couponCode) {
    const newTotal    = baseGrandTotal - discount;
    const totalEl     = document.getElementById('displayTotal');
    const discountRow = document.getElementById('couponDiscountRow');
    const discountEl  = document.getElementById('couponDiscountDisplay');
    const labelEl     = document.getElementById('appliedCouponLabel');
    totalEl.textContent = '₹' + newTotal.toLocaleString('en-IN');
    if (discount > 0 && couponCode) {
      discountRow.classList.add('visible');
      discountEl.textContent = '— ₹' + discount.toLocaleString('en-IN');
      labelEl.textContent    = couponCode;
    } else {
      discountRow.classList.remove('visible');
    }
  }

  function showCouponMsg(text, type) {
    const el = document.getElementById('couponMsg');
    el.textContent = text;
    el.className   = 'coupon-msg' + (type ? ' ' + type : '');
  }

  /* ══════════════════════════════
     ADDRESS LOGIC  (unchanged)
  ══════════════════════════════ */
  function selectAddress(card) {
    document.querySelectorAll('.addr-card').forEach(c => c.classList.remove('selected'));
    card.classList.add('selected');
    selectedAddressId = card.dataset.id;
    document.getElementById('addr-select-error').style.display = 'none';
    closeAddressForm();
  }

  function clearAddressForm() {
    ['f_name','f_mobile','f_house','f_street','f_pincode','f_city','f_state','f_country','f_landmark'].forEach(id => {
      const el = document.getElementById(id); el.value = ''; el.classList.remove('error');
    });
    document.getElementById('f_country').value = 'India';
  }

  function openNewAddressForm() {
    editingAddressId = ''; editingAddressDefault = false;
    clearAddressForm();
    document.getElementById('addrFormTitle').textContent  = 'Add New Address';
    document.getElementById('saveAddressBtn').textContent = 'Save & Use This Address';
    document.querySelectorAll('.addr-card').forEach(c => c.classList.remove('selected'));
    selectedAddressId = '';
    document.getElementById('newAddrForm').classList.add('open');
    document.getElementById('f_name').focus();
  }

  function closeAddressForm() {
    document.getElementById('newAddrForm').classList.remove('open');
    editingAddressId = ''; editingAddressDefault = false;
  }

  function openEditAddress(event, id) {
    event.stopPropagation();
    const addr = checkoutAddresses.find(a => String(a._id) === String(id));
    if (!addr) return toast('error', 'Address not found.');
    editingAddressId      = String(id);
    editingAddressDefault = Boolean(addr.isDefault);
    document.getElementById('addrFormTitle').textContent    = 'Edit Address';
    document.getElementById('saveAddressBtn').textContent   = 'Update & Use This Address';
    document.getElementById('f_name').value    = addr.fullName    || '';
    document.getElementById('f_mobile').value  = addr.phoneNumber || '';
    document.getElementById('f_house').value   = addr.houseNumber || '';
    document.getElementById('f_street').value  = addr.streetName  || '';
    document.getElementById('f_pincode').value = addr.pincode     || '';
    document.getElementById('f_city').value    = addr.city        || '';
    document.getElementById('f_state').value   = addr.state       || '';
    document.getElementById('f_country').value = addr.country     || 'India';
    document.getElementById('f_landmark').value= addr.landmark    || '';
    document.querySelectorAll('.addr-card').forEach(c =>
      c.classList.toggle('selected', c.dataset.id === editingAddressId));
    selectedAddressId = editingAddressId;
    document.getElementById('addr-select-error').style.display = 'none';
    document.getElementById('newAddrForm').classList.add('open');
    document.getElementById('newAddrForm').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  async function setAsDefault(event, id) {
    event.stopPropagation(); showLoader();
    try {
      const res  = await fetch(`/address/default/${id}`, { method: 'PATCH' });
      const data = await res.json();
      hideLoader();
      if (!res.ok || !data.success) return toast('error', data.message || 'Failed to set default.');
      Swal.fire({ icon: 'success', title: 'Default address updated', timer: 1200, showConfirmButton: false, background: '#0b1e3a', color: '#e8f1ff', iconColor: '#4da6ff' });
      setTimeout(() => window.location.reload(), 1200);
    } catch(e) { hideLoader(); toast('error', 'Something went wrong. Please try again.'); }
  }

  /* ── FORM VALIDATION ── */
  function getPhoneDigits(value) {
    let digits = String(value || '').replace(/\D/g, '');
    if (digits.length === 12 && digits.startsWith('91')) digits = digits.slice(2);
    if (digits.length === 11 && digits.startsWith('0'))  digits = digits.slice(1);
    return digits;
  }

  const fieldValidators = {
    f_name(val)    { if (!val) return 'Full name is required.'; if (val.length < 2) return 'Min 2 characters.'; if (!/^[A-Za-z][A-Za-z .'-]*$/.test(val)) return 'Letters, spaces, dots, hyphens only.'; return ''; },
    f_mobile(val)  { if (!val) return 'Mobile number is required.'; const d = getPhoneDigits(val); if (d.length !== 10) return 'Enter a valid 10-digit number.'; if (!/^[6-9]/.test(d)) return 'Must start with 6–9.'; return ''; },
    f_house(val)   { if (!val) return 'House / flat number is required.'; return ''; },
    f_street(val)  { if (!val) return 'Street is required.'; if (val.length < 3) return 'Min 3 characters.'; return ''; },
    f_pincode(val) { if (!val) return 'Pincode is required.'; if (!/^\d{6}$/.test(val)) return 'Must be exactly 6 digits.'; if (!/^[1-9]/.test(val)) return 'Cannot start with 0.'; return ''; },
    f_city(val)    { if (!val) return 'City is required.'; if (val.length < 2) return 'Min 2 characters.'; return ''; },
    f_state(val)   { if (!val) return 'State is required.'; return ''; },
    f_country(val) { if (!val) return 'Country is required.'; return ''; },
    f_landmark()   { return ''; },
  };

  function setFieldError(id, message) {
    const el = document.getElementById(id);
    let errEl = document.getElementById(id + '_err');
    if (!errEl) {
      errEl = document.createElement('span');
      errEl.id = id + '_err';
      errEl.style.cssText = 'font-size:10px;color:var(--danger);letter-spacing:.06em;margin-top:3px;display:block;';
      el.parentNode.appendChild(errEl);
    }
    if (message) { el.classList.add('error'); errEl.textContent = message; errEl.style.display = 'block'; }
    else         { el.classList.remove('error'); errEl.textContent = ''; errEl.style.display = 'none'; }
  }

  function validateForm() {
    let firstErrorId = null, hasError = false;
    for (const [id, validator] of Object.entries(fieldValidators)) {
      const el  = document.getElementById(id);
      const val = el.value.trim().replace(/\s+/g, ' ');
      el.value  = val;
      const msg = validator(val);
      setFieldError(id, msg);
      if (msg && !firstErrorId) firstErrorId = id;
      if (msg) hasError = true;
    }
    if (firstErrorId) document.getElementById(firstErrorId).focus();
    return !hasError;
  }

  Object.keys(fieldValidators).forEach(id => {
    const el = document.getElementById(id);
    if (!el) return;
    el.addEventListener('input', () => { const val = el.value.trim(); setFieldError(id, fieldValidators[id](val)); });
    el.addEventListener('blur',  () => { el.value = el.value.trim();  setFieldError(id, fieldValidators[id](el.value)); });
  });

  function getNewAddressPayload() {
    return { fullName: document.getElementById('f_name').value.trim(), phoneNumber: document.getElementById('f_mobile').value.trim(), houseNumber: document.getElementById('f_house').value.trim(), streetName: document.getElementById('f_street').value.trim(), pincode: document.getElementById('f_pincode').value.trim(), city: document.getElementById('f_city').value.trim(), state: document.getElementById('f_state').value.trim(), landmark: document.getElementById('f_landmark').value.trim(), country: document.getElementById('f_country').value.trim(), isDefault: false };
  }
  function getEditAddressPayload() {
    return { fullName: document.getElementById('f_name').value.trim(), phoneNumber: document.getElementById('f_mobile').value.trim(), houseNumber: document.getElementById('f_house').value.trim(), streetName: document.getElementById('f_street').value.trim(), pincode: document.getElementById('f_pincode').value.trim(), city: document.getElementById('f_city').value.trim(), state: document.getElementById('f_state').value.trim(), landmark: document.getElementById('f_landmark').value.trim(), country: document.getElementById('f_country').value.trim(), isDefault: editingAddressDefault };
  }

  async function addAddress() {
    if (!validateForm()) return; showLoader();
    try {
      const res    = await fetch('/address/add', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(getNewAddressPayload()) });
      const result = await res.json();
      hideLoader();
      if (!res.ok || result.success === false) return toast('error', result.message || 'Failed to add address.');
      Swal.fire({ icon: 'success', title: 'Address saved', timer: 1200, showConfirmButton: false, background: '#0b1e3a', color: '#e8f1ff', iconColor: '#4da6ff' });
      setTimeout(() => window.location.reload(), 1200);
    } catch { hideLoader(); toast('error', 'Something went wrong. Please try again.'); }
  }

  async function updateAddress() {
    if (!editingAddressId) return toast('error', 'No address selected for editing.');
    if (!validateForm()) return; showLoader();
    try {
      const res    = await fetch(`/address/edit/${editingAddressId}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(getEditAddressPayload()) });
      const result = await res.json();
      hideLoader();
      if (!res.ok || result.success === false) return toast('error', result.message || 'Failed to update address.');
      Swal.fire({ icon: 'success', title: 'Address updated', timer: 1200, showConfirmButton: false, background: '#0b1e3a', color: '#e8f1ff', iconColor: '#4da6ff' });
      setTimeout(() => window.location.reload(), 1200);
    } catch { hideLoader(); toast('error', 'Something went wrong. Please try again.'); }
  }

  function saveAddressFromCheckout() {
    editingAddressId ? updateAddress() : addAddress();
  }

  /* ── COD / WALLET PLACE ORDER ── */
  async function placeOrder() {
    if (!selectedAddressId) {
      document.getElementById('addr-select-error').style.display = 'block';
      document.getElementById('addressCardGrid').scrollIntoView({ behavior: 'smooth', block: 'start' });
      return toast('error', 'Please select a shipping address.');
    }

    const currentTotal = baseGrandTotal - appliedDiscount;
    if (selectedPayment === 'wallet' && walletBalance < currentTotal) {
      return toast('error', `Insufficient wallet balance. You need ₹${(currentTotal - walletBalance).toLocaleString('en-IN')} more.`);
    }

    const loadingText = document.querySelector('.loading-text');
    loadingText.textContent = selectedPayment === 'wallet'
      ? 'Debiting wallet · Please wait'
      : 'Processing · Please wait';

    showLoader();
    try {
      const res  = await fetch('/checkout/place-order', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          addressId:     selectedAddressId,
          paymentMethod: selectedPayment,
          couponCode:    appliedCouponCode || null,
          discount:      appliedDiscount   || 0,
        }),
      });
      const data = await res.json();
      hideLoader();
      if (!data.success) return toast('error', data.message);
      Swal.fire({
        icon: 'success', title: 'Order Confirmed!',
        text: selectedPayment === 'wallet'
          ? `₹${currentTotal.toLocaleString('en-IN')} debited from your wallet.`
          : 'Redirecting to order summary…',
        timer: 1600, showConfirmButton: false,
        background: '#0b1e3a', color: '#e8f1ff', iconColor: '#4da6ff',
      });
      setTimeout(() => { window.location.href = data.redirect; }, 1600);
    } catch {
      hideLoader();
      toast('error', 'Something went wrong. Please try again.');
    }
  }
</script>




</body>
</html>
