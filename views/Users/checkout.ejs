      background: var(--danger); color: #020b18; border-color: var(--danger);
    }

    /* divider between list and input */
    .coupon-divider {
      height: 1px; background: var(--border-1);
      margin: 12px 0;
    }

    /* Manual input row */
    .coupon-row { display: flex; gap: 0; }
    .coupon-input {
      flex: 1; background: var(--blue-750);
      border: 1px solid var(--border-1); border-right: none;
      padding: 10px 14px; color: var(--text-1);
