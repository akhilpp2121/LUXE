<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Add New Product — LUXE</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css"/>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
  <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">

  <style>
    :root {
      --bg:                   #060e20;
      --surface-lowest:       #000000;
      --surface-low:          #091328;
      --surface:              #0f1930;
      --surface-high:         #141f38;
      --surface-highest:      #192540;
      --surface-bright:       #1f2b49;
      --outline-variant:      #40485d;
      --primary:              #90abff;
      --primary-dim:          #316bf3;
      --secondary:            #8b94ff;
      --tertiary-container:   #fe9cf4;
      --on-bg:                #dee5ff;
      --on-surface:           #dee5ff;
      --on-surface-variant:   #a3aac4;
      --error:                #d7383b;
      --error-container:      #9f0519;
      --on-error-container:   #ffa8a3;
      --radius: 14px;
      --radius-sm: 8px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--on-surface);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* ── CROP MODAL ── */
    #cropModal {
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background: rgba(0,0,0,0.85);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 9999;
    }
    #cropModal.open { display: flex; }

    .crop-container {
      background: var(--surface);
      border: 1px solid var(--outline-variant);
      padding: 24px;
      border-radius: 16px;
      max-width: 520px;
      width: 92%;
      box-shadow: 0 24px 60px rgba(0,0,0,.6);
    }

    .crop-container h3 {
      font-size: 14px; font-weight: 600;
      color: var(--on-bg);
      margin-bottom: 14px;
      display: flex; align-items: center; gap: 8px;
    }

    .crop-image-wrap {
      max-height: 380px;
      overflow: hidden;
      border-radius: 10px;
      background: #000;
    }

    #cropImage { display: block; max-width: 100%; }

    .crop-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 14px;
    }

    .crop-actions button {
      padding: 9px 20px;
      border-radius: 8px;
      font-family: 'DM Sans', sans-serif;
      font-size: 13px; font-weight: 600;
      cursor: pointer; border: none; transition: all .2s;
    }

    #cropCancel {
      background: var(--surface-high);
      border: 1px solid var(--outline-variant) !important;
      color: var(--on-surface-variant);
    }
    #cropCancel:hover { background: var(--surface-bright); color: var(--on-bg); }

    #cropApply {
      background: linear-gradient(135deg, var(--primary-dim), var(--secondary));
      color: #fff;
      box-shadow: 0 4px 16px rgba(49,107,243,.35);
    }
    #cropApply:hover { transform: translateY(-1px); }

    /* ── NAVBAR ── */
    nav {
      position: sticky; top: 0; z-index: 100;
      background: rgba(6,14,32,.92);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--outline-variant);
      padding: 0 28px;
      height: 60px;
      display: flex; align-items: center; justify-content: space-between;
    }

    .nav-brand { display: flex; align-items: center; gap: 12px; }

    .nav-logo {
      width: 36px; height: 36px;
      background: linear-gradient(135deg, var(--primary-dim), var(--secondary));
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-family: 'Cormorant Garamond', serif;
      font-size: 17px; font-weight: 600; color: #fff;
    }

    .nav-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 21px; font-weight: 600;
      color: var(--on-bg); letter-spacing: .4px;
    }

    .nav-title span {
      font-style: italic;
      background: linear-gradient(90deg, var(--primary), var(--tertiary-container));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }

    .nav-bell {
      width: 36px; height: 36px;
      border-radius: 10px; border: 1px solid var(--outline-variant);
      background: var(--surface-high);
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; position: relative;
      color: var(--on-surface-variant);
      transition: background .2s;
    }
    .nav-bell:hover { background: var(--surface-bright); color: var(--primary); }
    .nav-bell-dot {
      position: absolute; top: 7px; right: 7px;
      width: 7px; height: 7px;
      background: var(--tertiary-container);
      border-radius: 50%; border: 2px solid var(--bg);
    }

    /* ── LAYOUT ── */
    .layout { display: flex; min-height: calc(100vh - 60px); }

    /* ── SIDEBAR ── */
    aside {
      width: 220px;
      flex-shrink: 0;
      background: var(--surface-lowest);
      border-right: 1px solid var(--outline-variant);
      padding: 24px 0;
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 60px;
      height: calc(100vh - 60px);
      overflow-y: auto;
    }

    .sidebar-section { padding: 0 12px; margin-bottom: 20px; }

    .sidebar-label {
      font-size: 9.5px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 1.5px;
      color: var(--on-surface-variant);
      padding: 0 10px; margin-bottom: 6px;
    }

    .sidebar-link {
      display: flex; align-items: center; gap: 10px;
      padding: 9px 10px;
      border-radius: var(--radius-sm);
      color: var(--on-surface-variant);
      font-size: 13px; font-weight: 500;
      text-decoration: none;
      cursor: pointer;
      transition: all .18s;
      position: relative;
      border-left: 3px solid transparent;
    }

    .sidebar-link:hover { background: var(--surface-high); color: var(--on-bg); }

    .sidebar-link.active {
      background: var(--surface-bright);
      color: var(--primary);
      border-left: 3px solid var(--primary);
    }

    .sidebar-link .ms {
      font-family: 'Material Symbols Outlined';
      font-size: 18px;
      font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
      line-height: 1;
      flex-shrink: 0;
    }

    .sidebar-link.active .ms {
      font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    /* ── MAIN ── */
    main { flex: 1; padding: 36px 44px; overflow-y: auto; }

    .page-header { display: flex; align-items: center; gap: 16px; margin-bottom: 32px; }

    .page-icon {
      width: 50px; height: 50px;
      background: linear-gradient(135deg, var(--primary-dim), var(--secondary));
      border-radius: var(--radius);
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 22px;
      box-shadow: 0 8px 24px rgba(49,107,243,.3);
    }

    .page-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 30px; font-weight: 600; color: var(--on-bg);
    }

    .page-subtitle { font-size: 11.5px; color: var(--primary); font-weight: 500; margin-top: 2px; }

    .server-error-banner {
      background: rgba(159,5,25,.15);
      border: 1px solid var(--error-container);
      border-radius: var(--radius-sm);
      padding: 12px 16px;
      margin-bottom: 20px;
      color: var(--on-error-container);
      font-size: 13px;
      display: flex; align-items: center; gap: 10px;
    }

    /* ── CARDS ── */
    .card {
      background: var(--surface);
      border: 1px solid var(--outline-variant);
      border-radius: 16px;
      padding: 28px;
      margin-bottom: 20px;
    }

    .card-title {
      font-size: 13px; font-weight: 600; color: var(--on-bg);
      display: flex; align-items: center; gap: 10px;
      margin-bottom: 20px;
    }

    .card-title-icon {
      width: 26px; height: 26px;
      border-radius: 7px;
      background: var(--surface-high);
      display: flex; align-items: center; justify-content: center;
      color: var(--primary); font-size: 13px;
      border: 1px solid var(--outline-variant);
    }

    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; }

    .field { display: flex; flex-direction: column; gap: 6px; }

    label {
      font-size: 10.5px; font-weight: 700;
      color: var(--on-surface-variant);
      text-transform: uppercase; letter-spacing: .8px;
    }

    input, select, textarea {
      background: var(--surface-high);
      border: 1px solid var(--outline-variant);
      border-radius: 9px;
      padding: 11px 13px;
      color: var(--on-surface);
      font-family: 'DM Sans', sans-serif;
      font-size: 13px;
      transition: border-color .2s, box-shadow .2s;
      outline: none;
      width: 100%;
      -webkit-appearance: none;
    }

    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; }
    input::placeholder, textarea::placeholder { color: var(--on-surface-variant); opacity: .6; }

    input:focus, select:focus, textarea:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(144,171,255,.1);
      background: var(--surface-bright);
    }

    select { cursor: pointer; }
    select option { background: var(--surface-high); }
    textarea { resize: none; }

    .error-msg { font-size: 11px; color: var(--on-error-container); min-height: 14px; }

    /* ── VARIANT CARD ── */
    .variant-card {
      background: var(--surface-low);
      border: 1px solid var(--outline-variant);
      border-radius: 16px;
      padding: 24px 28px;
      margin-bottom: 16px;
      animation: slideIn .3s ease-out;
    }

    @keyframes slideIn {
      from { opacity: 0; transform: translateY(-10px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .variant-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 20px;
    }

    .variant-badge { display: flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 600; color: var(--on-bg); }

    .badge-num {
      width: 26px; height: 26px;
      border-radius: 7px;
      background: linear-gradient(135deg, var(--primary-dim), var(--secondary));
      color: #fff;
      display: flex; align-items: center; justify-content: center;
      font-size: 12px; font-weight: 700;
    }

    .btn-delete {
      display: flex; align-items: center; gap: 6px;
      padding: 6px 13px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--error-container);
      background: rgba(159,5,25,.12);
      color: var(--on-error-container);
      font-size: 12px; font-weight: 600;
      cursor: pointer; transition: all .2s;
    }
    .btn-delete:hover { background: rgba(159,5,25,.25); }
    .btn-delete.hidden { display: none; }

    /* ── IMAGE UPLOAD ── */
    .img-upload {
      border: 1.5px dashed var(--outline-variant);
      border-radius: 11px;
      height: 110px;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 6px;
      background: var(--surface-high);
      cursor: pointer;
      transition: all .2s;
      position: relative;
      overflow: hidden;
      user-select: none;
      /* ALL children non-interactive so clicks always land on the div */
    }

    .img-upload:hover { border-color: var(--primary); background: rgba(144,171,255,.06); }

    /* every child is non-interactive — click must hit the .img-upload div */
    .img-upload * { pointer-events: none; }

    .img-upload .ms-upload {
      color: var(--primary); font-size: 22px;
      font-family: 'Material Symbols Outlined';
    }
    .img-upload p {
      font-size: 10.5px; font-weight: 600; color: var(--on-surface-variant);
    }
    .img-upload .file-name {
      font-size: 9.5px; color: #658eff;
      max-width: 90%; overflow: hidden;
      text-overflow: ellipsis; white-space: nowrap;
    }

    /* hidden real file input */
    .img-upload input[type=file] { display: none; }

    .preview-image {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      object-fit: cover; border-radius: 11px;
      display: none;
    }

    .preview-edit-badge {
      position: absolute; bottom: 6px; right: 6px;
      background: rgba(0,0,0,.65);
      border-radius: 6px;
      padding: 3px 7px;
      font-size: 10px; font-weight: 600; color: #fff;
      display: none;
    }

    .img-upload.has-image .preview-image      { display: block; }
    .img-upload.has-image .preview-edit-badge { display: block; }
    .img-upload.has-image .ms-upload,
    .img-upload.has-image p                   { display: none; }

    /* ── BUTTONS ── */
    .btn-add-variant {
      width: 100%; padding: 13px;
      border-radius: var(--radius);
      border: 1.5px dashed var(--outline-variant);
      background: transparent;
      color: var(--on-surface-variant);
      font-family: 'DM Sans', sans-serif;
      font-size: 13px; font-weight: 600;
      cursor: pointer; transition: all .2s;
      display: flex; align-items: center; justify-content: center; gap: 8px;
      margin-bottom: 20px;
    }

    .btn-add-variant:hover { border-color: var(--primary); color: var(--primary); background: rgba(144,171,255,.05); }

    .actions { display: flex; justify-content: flex-end; gap: 12px; padding-top: 4px; margin-bottom: 40px; }

    .btn-cancel {
      padding: 11px 22px;
      border-radius: 9px;
      border: 1px solid var(--outline-variant);
      background: var(--surface-high);
      color: var(--on-surface-variant);
      font-family: 'DM Sans', sans-serif;
      font-size: 13px; font-weight: 600;
      cursor: pointer; text-decoration: none; transition: all .2s;
    }
    .btn-cancel:hover { background: var(--surface-bright); color: var(--on-bg); }

    .btn-submit {
      padding: 11px 26px;
      border-radius: 9px;
      border: none;
      background: linear-gradient(135deg, var(--primary-dim) 0%, var(--secondary) 100%);
      color: #fff;
      font-family: 'DM Sans', sans-serif;
      font-size: 13px; font-weight: 600;
      cursor: pointer;
      display: flex; align-items: center; gap: 8px;
      box-shadow: 0 4px 20px rgba(49,107,243,.35);
      transition: all .2s;
    }
    .btn-submit:hover { transform: translateY(-1px); box-shadow: 0 8px 28px rgba(49,107,243,.45); }

    /* ── LOADING OVERLAY ── */
    #loadingOverlay {
      display: none; position: fixed; inset: 0;
      background: rgba(6,14,32,.85);
      backdrop-filter: blur(8px);
      z-index: 9998;
      align-items: center; justify-content: center;
    }
    #loadingOverlay.active { display: flex; }
    .spinner-wrap { text-align: center; }
    .spinner {
      width: 50px; height: 50px;
      border: 3px solid rgba(144,171,255,.15);
      border-top-color: var(--primary);
      border-radius: 50%;
      animation: spin .7s linear infinite;
      margin: 0 auto 14px;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .spinner-wrap p { font-size: 14px; color: var(--on-bg); }
    .spinner-wrap small { font-size: 12px; color: var(--on-surface-variant); margin-top: 4px; display: block; }

    .swal2-popup {
      background: var(--surface) !important;
      color: var(--on-bg) !important;
      border: 1px solid var(--outline-variant) !important;
      border-radius: 18px !important;
    }
    .swal2-confirm { background: var(--primary-dim) !important; border-radius: 8px !important; }

    aside::-webkit-scrollbar { width: 4px; }
    aside::-webkit-scrollbar-track { background: transparent; }
    aside::-webkit-scrollbar-thumb { background: var(--outline-variant); border-radius: 4px; }
  </style>
</head>
<body>

<!-- ── CROP MODAL ── -->
<div id="cropModal">
  <div class="crop-container">
    <h3><i class="fas fa-crop-alt" style="color:var(--primary);"></i> Crop Image</h3>
    <div class="crop-image-wrap">
      <img id="cropImage" alt="crop source" />
    </div>
    <div class="crop-actions">
      <button type="button" id="cropCancel">
        <i class="fas fa-times" style="margin-right:5px;"></i>Cancel
      </button>
      <button type="button" id="cropApply">
        <i class="fas fa-check" style="margin-right:5px;"></i>Apply Crop
      </button>
    </div>
  </div>
</div>

<!-- Loading Overlay -->
<div id="loadingOverlay">
  <div class="spinner-wrap">
    <div class="spinner"></div>
    <p>Uploading product…</p>
    <small>Please wait while we process your request</small>
  </div>
</div>

<!-- ── NAVBAR ── -->
<nav>
  <div class="nav-brand">
    <div class="nav-logo">L</div>
    <span class="nav-title"> <span>LUXE</span></span>
  </div>
  <div class="nav-bell">
    <i class="far fa-bell"></i>
    <span class="nav-bell-dot"></span>
  </div>
</nav>

<!-- ── LAYOUT ── -->
<div class="layout">

  <!-- ── SIDEBAR ── -->
  <aside>
    <div class="sidebar-section">
      <p class="sidebar-label">Overview</p>
      <a class="sidebar-link" href="/admin/dashboard">
        <span class="ms">dashboard</span>
        Dashboard
      </a>
    </div>

    <div class="sidebar-section">
      <p class="sidebar-label">Catalogue</p>
      <a class="sidebar-link <%= activePage === 'products' ? 'active' : '' %>" href="/admin/products">
        <span class="ms">inventory_2</span>
        Products
      </a>
      <a class="sidebar-link <%= activePage === 'categories' ? 'active' : '' %>" href="/admin/categories">
        <span class="ms">category</span>
        Categories
      </a>
    </div>

    <div class="sidebar-section">
      <p class="sidebar-label">Commerce</p>
      <a class="sidebar-link <%= activePage === 'orders' ? 'active' : '' %>" href="/admin/orders">
        <span class="ms">shopping_cart</span>
        Orders
      </a>
      <a class="sidebar-link <%= activePage === 'users' ? 'active' : '' %>" href="/admin/users">
        <span class="ms">group</span>
        Customers
      </a>
      <a class="sidebar-link <%= activePage === 'coupons' ? 'active' : '' %>" href="/admin/coupons">
        <span class="ms">confirmation_number</span>
        Coupons
      </a>
      <a class="sidebar-link <%= activePage === 'offers' ? 'active' : '' %>" href="/admin/offers">
        <span class="ms">local_offer</span>
        Offers
      </a>
      <a class="sidebar-link <%= activePage === 'banners' ? 'active' : '' %>" href="/admin/coupons">
        <span class="ms">ad_units</span>
        coupons
      </a>
      <a class="sidebar-link <%= activePage === 'analytics' ? 'active' : '' %>" href="/admin/analytics">
        <span class="ms">monitoring</span>
        Analytics
      </a>
    </div>

    <div class="sidebar-section" style="margin-top: auto;">
  <p class="sidebar-label">Account</p>

  <form action="/admin/logout" method="POST" style="margin:0;">
    <button type="submit" class="sidebar-link" style="width:100%; text-align:left; background:none; border:none;">
      <span class="ms">logout</span>
      Logout
    </button>
  </form>

</div>
  </aside>

  <!-- ── MAIN ── -->
  <main>
    <div style="max-width: 860px; margin: 0 auto;">

      <div class="page-header">
        <div class="page-icon"><i class="fas fa-plus"></i></div>
        <div>
          <h1 class="page-title">Add New Product</h1>
          <p class="page-subtitle">Fill in the details below to list a new product</p>
        </div>
      </div>

      <% if (error && error.length > 0) { %>
        <div class="server-error-banner">
          <i class="fas fa-exclamation-circle"></i>
          <%= error %>
        </div>
      <% } %>

      <form id="productForm" enctype="multipart/form-data">

        <!-- ── Basic Info ── -->
        <div class="card">
          <div class="card-title">
            <div class="card-title-icon"><i class="fas fa-info"></i></div>
            Basic Information
          </div>

          <div class="grid-2" style="margin-bottom: 18px;">
            <div class="field">
              <label for="p-name">Product Name *</label>
              <input id="p-name" type="text" name="productName" placeholder="e.g. Silk Kurta Set"/>
              <span id="name-error" class="error-msg"></span>
            </div>
            <div class="field">
              <label for="category">Category *</label>
              <select id="category" name="category">
                <option value="">Select Category</option>
                <% if (typeof category !== 'undefined' && category && category.length > 0) { %>
                  <% category.forEach(function(cat) { %>
                    <option value="<%= cat._id %>"><%= cat.categoryName %></option>
                  <% }); %>
                <% } else { %>
                  <option value="" disabled>No categories available</option>
                <% } %>
              </select>
              <span id="category-error" class="error-msg"></span>
            </div>
          </div>

          <div class="field">
            <label for="description">Description</label>
            <textarea id="description" name="description" rows="4" placeholder="Describe the product — fabric, style, occasion…"></textarea>
            <span id="description-error" class="error-msg"></span>
          </div>
        </div>

        <!-- ── Variants Container ── -->
        <div id="variantsContainer">

          <!-- Variant 1 -->
          <div class="variant-card variant-group">
            <div class="variant-header">
              <div class="variant-badge">
                <div class="badge-num">1</div>
                <span class="variant-title">Variant 1</span>
              </div>
              <button type="button" class="btn-delete delete-variant-btn hidden" onclick="deleteVariant(this)">
                <i class="fas fa-trash-alt"></i> Remove
              </button>
            </div>

            <!-- <div class="field" style="margin-bottom: 18px;">
              <label>SKU *</label>
              <input type="text" name="variants[0].sku" placeholder="e.g. RFTR-001-RED-M"/>
              <span class="error-msg sku-error"></span>
