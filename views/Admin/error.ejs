<%
  /*
    This view trusts whatever your errorHandler.js already decided.
    It does NOT re-derive dev/prod logic, status maps, or message safety —
    that's all handled server-side in sendErrorDev / sendErrorProd, which is
    exactly where that decision belongs (the view shouldn't have to know
    about NODE_ENV or AppError internals).

    Locals passed in from errorHandler.js:
      error.statusCode  number   always present (defaults to 500 upstream)
      error.title       string   always present (set in sendErrorDev/sendErrorProd)
      error.message     string   always present
      error.stack       string   ONLY present in sendErrorDev — never sent in prod
  */

  const statusCode = error.statusCode || 500;
  const title = error.title || "Error Occurred";
  const message = error.message || "Something went wrong. Please try again.";
  const showStack = !!error.stack;

  // Auth-type errors should route people to login, not a dashboard they were denied.
  const primaryAction = (statusCode === 401 || statusCode === 403)
    ? { href: '/admin/login', label: 'Go to Login', icon: 'login' }
    : { href: '/admin/dashboard', label: 'Back to Dashboard', icon: 'dashboard' };
%>
<!DOCTYPE html>
<html class="dark" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <meta name="robots" content="noindex, nofollow" />
  <title>LUXE Admin - <%= statusCode %> <%= title %></title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap"
    rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    rel="stylesheet" />
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "secondary-container": "#313aa1", "on-primary-fixed-variant": "#00266e", "tertiary-dim": "#ef8fe5", "surface-container-highest": "#192540", "on-surface-variant": "#a3aac4", "on-tertiary-fixed-variant": "#711f6f", "outline": "#6d758c", "error-container": "#9f0519", "surface-bright": "#1f2b49", "secondary-fixed": "#cbceff", "primary-dim": "#316bf3", "background": "#060e20", "surface-variant": "#192540", "surface-container-lowest": "#000000", "primary-fixed": "#7b9cff", "surface-container-high": "#141f38", "surface-container": "#0f1930", "on-secondary-fixed-variant": "#3c45ab", "on-secondary-fixed": "#1c248e", "inverse-surface": "#faf8ff", "tertiary": "#ffb4f4", "surface-tint": "#90abff", "secondary-dim": "#8b94ff", "secondary": "#8b94ff", "on-primary-container": "#001e5a", "surface": "#060e20", "primary-fixed-dim": "#658eff", "on-tertiary": "#722070", "on-secondary-container": "#caccff", "on-primary-fixed": "#000000", "error-dim": "#d7383b", "error": "#ff716c", "tertiary-fixed-dim": "#ef8fe5", "on-surface": "#dee5ff", "surface-container-low": "#091328", "on-error-container": "#ffa8a3", "surface-dim": "#060e20", "on-secondary": "#000478", "on-error": "#490006", "outline-variant": "#40485d", "on-primary": "#002873", "primary": "#90abff", "on-tertiary-container": "#661466", "secondary-fixed-dim": "#bbbfff", "primary-container": "#7b9cff", "tertiary-fixed": "#fe9cf4", "on-background": "#dee5ff", "tertiary-container": "#fe9cf4", "on-tertiary-fixed": "#480049", "inverse-primary": "#0053dc", "inverse-on-surface": "#4d556b"
          },
          fontFamily: { "headline": ["Manrope"], "body": ["Inter"], "label": ["Inter"] },
          borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
        },
      },
    }
  </script>
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
    .glass-effect {
      background: rgba(25, 37, 64, 0.7);
      backdrop-filter: blur(20px);
    }
    .luxe-gradient {
      background: linear-gradient(135deg, #316bf3 0%, #90abff 100%);
    }
    .glow-effect-error {
      box-shadow: 0 0 50px -10px rgba(255, 113, 108, 0.25);
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #091328;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #1f2b49;
      border-radius: 10px;
    }
  </style>
  <link rel="stylesheet" href="/css/navigation-consistency.css" />
</head>

<body class="bg-background text-on-background font-body antialiased min-h-screen flex flex-col justify-between">

  <!-- Header -->
  <header class="w-full bg-[#091328] border-b border-outline-variant/10 px-8 py-4">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-primary text-2xl">diamond</span>
        <a href="/admin/dashboard" class="font-['Manrope'] font-extrabold text-lg tracking-tighter text-white uppercase">
          LUXE Admin
        </a>
      </div>
      <div class="text-xs uppercase tracking-widest text-on-surface-variant font-bold">
        Control Panel Alert
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-grow flex items-center justify-center px-6 py-12 relative overflow-hidden">
    <!-- Background blobs -->
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-error/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-2xl w-full text-center space-y-8 relative z-10">
      <!-- Error Icon & Badge -->
      <div class="flex flex-col items-center justify-center space-y-4">
        <div class="w-20 h-20 rounded-full bg-error/10 text-error flex items-center justify-center glow-effect-error animate-pulse">
          <span class="material-symbols-outlined text-4xl" style="font-variation-settings: 'FILL' 1">report</span>
        </div>
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-error/10 text-error text-xs font-bold tracking-widest uppercase border border-error/20">
          HTTP <%= statusCode %>
        </div>
      </div>

      <!-- Message Details -->
      <div class="space-y-4">
        <h1 class="text-4xl md:text-5xl font-['Manrope'] font-black tracking-tight text-white leading-tight">
          <%= title %>
        </h1>
        <p class="text-on-surface-variant text-base md:text-lg leading-relaxed max-w-lg mx-auto">
          <%= message %>
        </p>
      </div>

      <!-- Developer Stack Trace: only present at all when sendErrorDev supplied it -->
      <% if (showStack) { %>
        <div class="text-left bg-[#091328] p-6 rounded-2xl border border-outline-variant/10 max-h-72 overflow-y-auto font-mono text-[11px] text-error/90 whitespace-pre-wrap shadow-inner custom-scrollbar relative">
          <div class="sticky top-0 right-0 flex justify-end">
            <span class="px-2 py-0.5 rounded bg-error/10 text-error font-bold uppercase text-[9px]">Developer Stack Trace (dev only)</span>
          </div>
          <%= error.stack %>
        </div>
      <% } %>

      <!-- Navigation Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto pt-4">
        <a href="<%= primaryAction.href %>" class="w-full sm:w-auto luxe-gradient text-white px-8 py-4 rounded-xl font-bold transition-all duration-300 transform active:scale-95 flex items-center justify-center gap-2 shadow-lg shadow-primary-dim/30">
          <span class="material-symbols-outlined text-lg"><%= primaryAction.icon %></span>
          <%= primaryAction.label %>
        </a>
        <button onclick="window.history.length > 1 ? window.history.back() : window.location.href = '/admin/dashboard'" class="w-full sm:w-auto bg-surface-container border border-outline-variant/20 hover:bg-surface-bright text-on-surface hover:text-white px-8 py-4 rounded-xl font-bold transition-all duration-300 transform active:scale-95 flex items-center justify-center gap-2">
          <span class="material-symbols-outlined text-lg">arrow_back</span>
          Go Back
        </button>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-[#091328] border-t border-outline-variant/10 py-6 text-center">
    <div class="max-w-7xl mx-auto px-6 text-xs text-on-surface-variant">
      <p>© 2026 LUXE Control Panel. Internal Use Only.</p>
    </div>
  </footer>

</body>

</html>
