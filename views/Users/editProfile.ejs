<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>LUXE | Edit Profile</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Syne:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@300,0..1&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg: #080c14; --sur: #0e1523; --sur2: #141c2e; --sur3: #1a2338; --sur4: #212c42;
    --bord: rgba(255,255,255,0.07); --bord2: rgba(255,255,255,0.13);
    --pri: #3a6ff7; --gold: #c9a96e; --gold2: #e0c08a;
    --txt: #e8edf8; --txt2: #8892a4; --txt3: #5a6478;
    --green: #22c55e; --red: #ef4444; --amber: #f59e0b;
    --nav-h: 68px; --side-w: 260px; --r: 12px; --rl: 18px;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--txt); min-height: 100vh; overflow-x: hidden; }
  ::-webkit-scrollbar { width: 4px; } ::-webkit-scrollbar-track { background: var(--bg); } ::-webkit-scrollbar-thumb { background: var(--sur4); border-radius: 99px; }

  /* ── NAV ── */
  nav.topnav { position: fixed; top: 0; left: 0; right: 0; height: var(--nav-h); background: rgba(8,12,20,0.9); backdrop-filter: blur(20px); border-bottom: 1px solid var(--bord); display: flex; align-items: center; justify-content: space-between; padding: 0 36px; z-index: 100; }
  .brand { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 1rem; letter-spacing: .22em; text-transform: uppercase; }
  .brand span { color: var(--gold); }
  .nav-links { display: flex; gap: 32px; list-style: none; }
  .nav-links a { font-family: 'Syne', sans-serif; font-size: .6rem; letter-spacing: .18em; text-transform: uppercase; color: var(--txt2); text-decoration: none; transition: color .2s; }
  .nav-links a:hover { color: var(--txt); }
  .nav-acts { display: flex; align-items: center; gap: 16px; }
  .nav-btn { background: none; border: none; cursor: pointer; color: var(--txt2); display: flex; align-items: center; transition: color .2s; }
  .nav-btn:hover { color: var(--txt); } .nav-btn.on { color: var(--pri); }
  .nav-btn .ms { font-size: 22px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }

  /* ── SIDEBAR ── */
  aside.sidebar { position: fixed; top: var(--nav-h); left: 0; width: var(--side-w); height: calc(100vh - var(--nav-h)); background: var(--sur); border-right: 1px solid var(--bord); display: flex; flex-direction: column; padding: 28px 0 20px; z-index: 50; overflow-y: auto; }
  .sidebar-header { padding: 0 24px 24px; border-bottom: 1px solid var(--bord); margin-bottom: 12px; }
  .sidebar-header h3 { font-family: 'Syne', sans-serif; font-weight: 700; font-size: .9rem; margin-bottom: 6px; }
  .sidebar-tier { display: inline-flex; align-items: center; gap: 5px; background: rgba(201,169,110,.1); border: 1px solid rgba(201,169,110,.25); border-radius: 99px; padding: 3px 10px; }
  .sidebar-tier span { font-family: 'Syne', sans-serif; font-size: .5rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--gold); }
  .tier-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--gold); flex-shrink: 0; }
  .sidebar-nav { display: flex; flex-direction: column; gap: 2px; padding: 0 10px; }
  .sidebar-link { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 8px; text-decoration: none; color: var(--txt2); font-size: .625rem; font-family: 'Syne', sans-serif; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; transition: all .2s; }
  .sidebar-link .material-symbols-outlined { font-size: 17px; flex-shrink: 0; font-variation-settings: 'FILL' 0, 'wght' 300; }
  .sidebar-link:hover { background: var(--sur3); color: var(--txt); }
  .sidebar-link.active { background: rgba(58,111,247,.12); color: var(--pri); }
  .sidebar-footer { margin-top: auto; padding: 18px 24px 0; border-top: 1px solid var(--bord); }
  .sidebar-footer a { display: flex; align-items: center; gap: 9px; text-decoration: none; color: var(--txt3); font-size: .625rem; font-family: 'Syne', sans-serif; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; transition: color .2s; }
  .sidebar-footer a:hover { color: var(--txt2); }
  .sidebar-footer .material-symbols-outlined { font-size: 17px; font-variation-settings: 'FILL' 0, 'wght' 300; }

  /* ── MAIN ── */
  main { margin-left: var(--side-w); padding: calc(var(--nav-h) + 44px) 48px 80px; min-height: 100vh; }
  .page-header { margin-bottom: 36px; display: flex; align-items: center; justify-content: space-between; }
  .page-header-left h1 { font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: 3rem; letter-spacing: -.01em; line-height: 1.05; margin-bottom: 6px; }
  .page-header-left h1 em { font-style: italic; color: var(--gold2); }
  .page-header-left p { color: var(--txt3); font-size: .82rem; font-weight: 300; }
  .back-link { display: flex; align-items: center; gap: 6px; text-decoration: none; color: var(--txt2); font-family: 'Syne', sans-serif; font-size: .6rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; transition: color .2s; }
  .back-link:hover { color: var(--txt); }
  .back-link .ms { font-size: 16px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }

  /* ── FLASH MESSAGES ── */
  .flash { display: flex; align-items: center; gap: 10px; padding: 12px 18px; border-radius: 10px; font-family: 'Syne', sans-serif; font-size: .65rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 24px; border: 1px solid; }
  .flash.success { background: rgba(34,197,94,.08); border-color: rgba(34,197,94,.2); color: #4ade80; }
  .flash.error { background: rgba(239,68,68,.08); border-color: rgba(239,68,68,.2); color: #f87171; }
  .flash .ms { font-size: 16px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 1, 'wght' 300; }

  /* ── FORM LAYOUT ── */
  .edit-layout { display: grid; grid-template-columns: 280px 1fr; gap: 24px; align-items: start; }

  /* ── AVATAR CARD ── */
  .avatar-card { background: var(--sur); border: 1px solid var(--bord); border-radius: var(--rl); padding: 28px; display: flex; flex-direction: column; align-items: center; gap: 16px; animation: fu .5s ease both; }
  .avatar-card-title { font-family: 'Syne', sans-serif; font-weight: 700; font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--txt3); align-self: flex-start; }
  .av-preview { position: relative; width: 100px; height: 100px; }
  .av-preview img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; border: 3px solid transparent; background: linear-gradient(var(--sur),var(--sur)) padding-box, linear-gradient(135deg,var(--gold),var(--pri)) border-box; }
  .av-overlay { position: absolute; inset: 0; border-radius: 50%; background: rgba(0,0,0,.55); display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity .2s; cursor: pointer; }
  .av-preview:hover .av-overlay { opacity: 1; }
  .av-overlay .ms { font-size: 22px; color: #fff; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }
  .av-hint { font-size: .72rem; color: var(--txt3); text-align: center; font-weight: 300; line-height: 1.5; }
  .av-actions { display: flex; gap: 8px; width: 100%; }
  .av-btn { flex: 1; display: flex; align-items: center; justify-content: center; gap: 5px; padding: 9px; border-radius: 8px; font-family: 'Syne', sans-serif; font-size: .58rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; cursor: pointer; transition: all .2s; border: 1px solid; }
  .av-btn.upload { background: rgba(58,111,247,.1); color: var(--pri); border-color: rgba(58,111,247,.25); }
  .av-btn.upload:hover { background: rgba(58,111,247,.2); }
  .av-btn.remove { background: rgba(239,68,68,.08); color: var(--red); border-color: rgba(239,68,68,.2); }
  .av-btn.remove:hover { background: rgba(239,68,68,.15); }
  .av-btn .ms { font-size: 14px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }
  #avatarInput { display: none; }
  .av-err { color: var(--red); font-size: .7rem; text-align: center; min-height: 16px; }

  /* ── FORM CARD ── */
  .form-card { background: var(--sur); border: 1px solid var(--bord); border-radius: var(--rl); padding: 32px; animation: fu .5s .06s ease both; }
  .form-section { margin-bottom: 30px; }
  .form-section:last-child { margin-bottom: 0; }
  .section-title { font-family: 'Syne', sans-serif; font-weight: 700; font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--txt3); margin-bottom: 18px; display: flex; align-items: center; gap: 8px; padding-bottom: 10px; border-bottom: 1px solid var(--bord); }
  .section-title .ms { font-size: 15px; color: var(--pri); font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }
  .fields-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field.full { grid-column: 1 / -1; }
  .field label { font-family: 'Syne', sans-serif; font-size: .52rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--txt3); }
  .field-wrap { position: relative; }
  .field-wrap .fi { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); font-size: 16px; color: var(--txt3); font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; pointer-events: none; }
  .field input, .field select, .field textarea {
    background: var(--sur2); border: 1px solid var(--bord); border-radius: 8px;
    padding: 11px 14px 11px 40px; color: var(--txt); font-family: 'DM Sans', sans-serif;
    font-size: .875rem; font-weight: 400; width: 100%; outline: none; transition: all .2s;
    -webkit-appearance: none;
  }
  .field textarea { padding: 11px 14px; resize: vertical; min-height: 80px; line-height: 1.5; }
  .field input:hover, .field select:hover, .field textarea:hover { border-color: var(--bord2); }
  .field input:focus, .field select:focus, .field textarea:focus { border-color: rgba(58,111,247,.45); background: var(--sur3); }
  .field input.err, .field select.err { border-color: rgba(239,68,68,.4) !important; background: rgba(239,68,68,.04) !important; }
  .field .errt { color: var(--red); font-size: .68rem; min-height: 14px; display: flex; align-items: center; gap: 4px; }
  .field .errt .ms { font-size: 13px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 1, 'wght' 300; }
  .field select option { background: var(--sur2); color: var(--txt); }

  /* EMAIL FIELD SPECIAL */
  .email-row { display: flex; align-items: flex-start; gap: 10px; }
  .email-row .field { flex: 1; }
  .email-change-btn {
    display: flex; align-items: center; gap: 5px; padding: 11px 14px;
    background: rgba(58,111,247,.1); color: var(--pri); border: 1px solid rgba(58,111,247,.25);
    border-radius: 8px; font-family: 'Syne', sans-serif; font-size: .58rem; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase; cursor: pointer; white-space: nowrap;
    transition: all .2s; margin-top: 22px; flex-shrink: 0;
  }
  .email-change-btn:hover { background: rgba(58,111,247,.2); }
  .email-change-btn .ms { font-size: 14px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }
  .email-note { font-size: .7rem; color: var(--txt3); margin-top: 4px; display: flex; align-items: center; gap: 4px; }
  .email-note .ms { font-size: 13px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }

  /* FORM ACTIONS */
  .form-actions { display: flex; align-items: center; gap: 12px; margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--bord); }
  .btn-save {
    display: flex; align-items: center; gap: 8px; background: var(--pri); color: #fff;
    border: none; border-radius: 8px; padding: 13px 28px; font-family: 'Syne', sans-serif;
    font-size: .68rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
    cursor: pointer; transition: all .2s;
  }
  .btn-save:hover { background: #5b84ff; box-shadow: 0 0 24px rgba(58,111,247,.35); }
  .btn-save .ms { font-size: 16px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }
  .btn-cancel { display: flex; align-items: center; gap: 8px; background: none; border: 1px solid var(--bord2); color: var(--txt2); border-radius: 8px; padding: 13px 24px; font-family: 'Syne', sans-serif; font-size: .68rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; transition: all .2s; text-decoration: none; }
  .btn-cancel:hover { background: var(--sur3); color: var(--txt); }

  @keyframes fu { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 1100px) { .edit-layout { grid-template-columns: 1fr; } }
  @media (max-width: 900px) { :root { --side-w: 0px; } aside.sidebar { display: none; } main { padding: calc(var(--nav-h) + 28px) 20px 60px; } .nav-links { display: none; } .page-header { flex-direction: column; align-items: flex-start; gap: 12px; } }
  @media (max-width: 600px) { .fields-grid { grid-template-columns: 1fr; } }
</style>
</head>
<body>

<!-- ── NAV ── -->
<nav class="topnav">
  <div class="brand">LUXE <span>ATELIER</span></div>
  <ul class="nav-links">
    <li><a href="#">Showroom</a></li>
    <li><a href="#">Collections</a></li>
    <li><a href="#">Atelier</a></li>
    <li><a href="#">Journal</a></li>
  </ul>
  <div class="nav-acts">
    <button class="nav-btn"><span class="ms material-symbols-outlined">shopping_bag</span></button>
    <button class="nav-btn on"><span class="ms material-symbols-outlined">person</span></button>
  </div>
</nav>

<!-- ── SIDEBAR ── -->
<aside class="sidebar">
  <div class="sidebar-header">
    <h3>User Account</h3>
    <div class="sidebar-tier"><div class="tier-dot"></div><span>Gold Member</span></div>
  </div>
  <nav class="sidebar-nav">
    <a href="/profile" class="sidebar-link active">
      <span class="material-symbols-outlined">person</span><span>Profile</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">package_2</span><span>My Orders</span>
    </a>
    <a href="/address" class="sidebar-link">
      <span class="material-symbols-outlined">distance</span><span>Manage Address</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">lock_reset</span><span>Change Password</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">favorite</span><span>Wishlist</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">share_reviews</span><span>Referral Link</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">account_balance_wallet</span><span>Wallet</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">confirmation_number</span><span>Coupons</span>
    </a>
  </nav>
  <div class="sidebar-footer">
    <a href="#"><span class="material-symbols-outlined">logout</span><span>Sign Out</span></a>
  </div>
</aside>

<!-- ── MAIN ── -->
<main>
  <div class="page-header">
    <div class="page-header-left">
      <h1>Edit <em>Profile</em></h1>
      <p>Update your personal information and photo.</p>
    </div>
    <a href="/profile" class="back-link"><span class="ms material-symbols-outlined">arrow_back</span>Back to Profile</a>
  </div>

  <!-- Flash Messages -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="flash success"><span class="ms material-symbols-outlined">check_circle</span><%= success %></div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="flash error"><span class="ms material-symbols-outlined">error</span><%= error %></div>
  <% } %>

  <div class="edit-layout">

    <!-- Avatar Card -->
    <div class="avatar-card">
      <div class="avatar-card-title">Profile Photo</div>
      <div class="av-preview">
        <img id="avatarPreview" src="<%= user.avatar || '/images/default-avatar.png' %>" alt="Avatar"/>
        <div class="av-overlay" onclick="document.getElementById('avatarInput').click()">
          <span class="ms material-symbols-outlined">photo_camera</span>
        </div>
      </div>
      <div class="av-hint">JPG, PNG or WEBP<br/>Max size 5MB</div>
      <div class="av-actions">
        <button type="button" class="av-btn upload" onclick="document.getElementById('avatarInput').click()">
          <span class="ms material-symbols-outlined">upload</span>Upload
        </button>
        <button type="button" class="av-btn remove" id="removeAvatarBtn">
          <span class="ms material-symbols-outlined">delete</span>Remove
        </button>
      </div>
      <p class="av-err" id="avatarErr"></p>
      <input type="file" id="avatarInput" accept="image/jpeg,image/png,image/webp"/>
    </div>

    <!-- Main Form -->
    <div class="form-card">
      <form id="editForm" method="POST" action="/profile/update" enctype="multipart/form-data" novalidate>
        <input type="hidden" id="removeAvatarField" name="removeAvatar" value="0"/>
        <input type="hidden" id="avatarDataField" name="avatarData" value=""/>

        <!-- Personal Info -->
        <div class="form-section">
          <div class="section-title"><span class="ms material-symbols-outlined">badge</span>Personal Information</div>
          <div class="fields-grid">
            <div class="field">
              <label for="fullName">Full Name *</label>
              <div class="field-wrap">
                <span class="fi material-symbols-outlined">person</span>
                <input type="text" id="fullName" name="fullName" value="<%= user.fullName %>" placeholder="Your full name" autocomplete="name"/>
              </div>
              <span class="errt" id="fullName-err"></span>
            </div>
            <div class="field">
              <label for="phone">Phone Number</label>
              <div class="field-wrap">
                <span class="fi material-symbols-outlined">call</span>
                <input type="tel" id="phone" name="phoneNumber" value="<%= user.phoneNumber || '' %>" placeholder="+44 7700 000000"/>
              </div>
              <span class="errt" id="phone-err"></span>
            </div>
            
            
          </div>
        </div>

        <!-- Email -->
        <div class="form-section">
          <div class="section-title"><span class="ms material-symbols-outlined">mail</span>Email Address</div>
          <div class="email-row">
            <div class="field">
              <label>Current Email</label>
              <div class="field-wrap">
                <span class="fi material-symbols-outlined">mail</span>
                <input type="email" value="<%= user.email %>" readonly style="opacity:.6;cursor:not-allowed;padding-left:40px;"/>
              </div>
              
            </div>
            <a href="/profile/email-edit" class="email-change-btn">
              <span class="ms material-symbols-outlined">edit</span>Change Email
            </a>
          </div>
        </div>

        <!-- Form Actions -->
        <div class="form-actions">
          <button type="submit" class="btn-save"><span class="ms material-symbols-outlined">save</span>Save Changes</button>
          <a href="/profile" class="btn-cancel">Cancel</a>
        </div>
      </form>
    </div>

  </div>
</main>

<script>
// ── AVATAR PREVIEW ──
const avatarInput = document.getElementById('avatarInput');
const avatarPreview = document.getElementById('avatarPreview');
const avatarErr = document.getElementById('avatarErr');
const avatarDataField = document.getElementById('avatarDataField');
const removeAvatarField = document.getElementById('removeAvatarField');
const DEFAULT_AVATAR = '/images/default-avatar.png';
let originalAvatar = avatarPreview.src;

avatarInput.addEventListener('change', function() {
  const file = this.files[0];
  avatarErr.textContent = '';
  if (!file) return;
  if (!['image/jpeg','image/png','image/webp'].includes(file.type)) {
    avatarErr.textContent = 'Only JPG, PNG, or WEBP allowed.';
    this.value = ''; return;
  }
  if (file.size > 5 * 1024 * 1024) {
    avatarErr.textContent = 'Image must be under 5MB.';
    this.value = ''; return;
  }
  const reader = new FileReader();
  reader.onload = e => {
    avatarPreview.src = e.target.result;
    avatarDataField.value = e.target.result;
    removeAvatarField.value = '0';
  };
  reader.readAsDataURL(file);
  this.value = '';
});

document.getElementById('removeAvatarBtn').addEventListener('click', function() {
  avatarPreview.src = DEFAULT_AVATAR;
  avatarDataField.value = '';
  removeAvatarField.value = '1';
  avatarInput.value = '';
  avatarErr.textContent = '';
});

// ── CLIENT-SIDE VALIDATION ──
const validators = {
  fullName(v) {
    if (!v.trim()) return 'Full name is required';
    if (v.trim().length < 3) return 'Must be at least 3 characters';
    if (!/^[a-zA-Z\s'\-\.]+$/.test(v.trim())) return 'Only letters, spaces, hyphens, apostrophes';
    return '';
  },
  phone(v) {
    if (!v) return '';
    const c = v.replace(/[\s\-\(\)]/g, '');
    if (!/^\+?[0-9]{7,15}$/.test(c)) return 'Enter a valid phone number';
    return '';
  },
  dob(v) {
    if (!v) return '';
    const d = new Date(v);
    const now = new Date();
    const age = (now - d) / (365.25 * 24 * 3600 * 1000);
    if (age < 13) return 'You must be at least 13 years old';
    if (age > 120) return 'Please enter a valid date';
    return '';
  }
};

function validateField(id) {
  const el = document.getElementById(id);
  const errEl = document.getElementById(id + '-err');
  if (!el || !errEl || !validators[id]) return true;
  const msg = validators[id](el.value);
  errEl.innerHTML = msg ? `<span class="ms material-symbols-outlined">error</span>${msg}` : '';
  el.classList.toggle('err', !!msg);
  return !msg;
}

['fullName','phone','dob'].forEach(id => {
  const el = document.getElementById(id);
  if (el) {
    el.addEventListener('blur', () => validateField(id));
    el.addEventListener('input', () => {
      if (el.classList.contains('err')) validateField(id);
    });
  }
});

document.getElementById('editForm').addEventListener('submit', function(e) {
  const fields = ['fullName','phone','dob'];
  let ok = true;
  fields.forEach(id => { if (!validateField(id)) ok = false; });
  if (!ok) { e.preventDefault(); window.scrollTo({top:0,behavior:'smooth'}); }
});
</script>
</body>
</html>
