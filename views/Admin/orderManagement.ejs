<!DOCTYPE html>
<html class="dark" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>LUXE Admin - Order Management</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap"
    rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    rel="stylesheet" />
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "secondary-container": "#313aa1", "on-primary-fixed-variant": "#00266e", "tertiary-dim": "#ef8fe5", "surface-container-highest": "#192540", "on-surface-variant": "#a3aac4", "on-tertiary-fixed-variant": "#711f6f", "outline": "#6d758c", "error-container": "#9f0519", "surface-bright": "#1f2b49", "secondary-fixed": "#cbceff", "primary-dim": "#316bf3", "background": "#060e20", "surface-variant": "#192540", "surface-container-lowest": "#000000", "primary-fixed": "#7b9cff", "surface-container-high": "#141f38", "surface-container": "#0f1930", "on-secondary-fixed-variant": "#3c45ab", "on-secondary-fixed": "#1c248e", "inverse-surface": "#faf8ff", "tertiary": "#ffb4f4", "surface-tint": "#90abff", "secondary-dim": "#8b94ff", "secondary": "#8b94ff", "on-primary-container": "#001e5a", "surface": "#060e20", "primary-fixed-dim": "#658eff", "on-tertiary": "#722070", "on-secondary-container": "#caccff", "on-primary-fixed": "#000000", "error-dim": "#d7383b", "error": "#ff716c", "tertiary-fixed-dim": "#ef8fe5", "on-surface": "#dee5ff", "surface-container-low": "#091328", "on-error-container": "#ffa8a3", "surface-dim": "#060e20", "on-secondary": "#000478", "on-error": "#490006", "outline-variant": "#40485d", "on-primary": "#002873", "primary": "#90abff", "on-tertiary-container": "#661466", "secondary-fixed-dim": "#bbbfff", "primary-container": "#7b9cff", "tertiary-fixed": "#fe9cf4", "on-background": "#dee5ff", "tertiary-container": "#fe9cf4", "on-tertiary-fixed": "#480049", "inverse-primary": "#0053dc", "inverse-on-surface": "#4d556b"
          },
          fontFamily: { "headline": ["Manrope"], "body": ["Inter"], "label": ["Inter"] },
          borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
        },
      },
    }
  </script>
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }

    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    ::-webkit-scrollbar {
      width: 6px;
    }

    ::-webkit-scrollbar-track {
      background: #060e20;
    }

    ::-webkit-scrollbar-thumb {
      background: #1f2b49;
      border-radius: 10px;
    }

    .luxe-gradient {
      background: linear-gradient(135deg, #316bf3 0%, #90abff 100%);
    }

    .mono {
      font-family: 'JetBrains Mono', monospace;
    }

    /* ── Status badges ── */
    .badge {
      display: inline-flex; align-items: center; gap: 6px; border-radius: 20px;
      padding: 4px 10px; font-size: 11px; font-weight: 700; white-space: nowrap;
    }
    .badge-dot { width: 6px; height: 6px; border-radius: 50%; }
    .badge.processing { background: rgba(255, 180, 100, 0.12); color: #ffb464; }
    .badge.processing .badge-dot { background: #ffb464; }
    .badge.shipped { background: rgba(96, 165, 250, 0.12); color: #60a5fa; }
    .badge.shipped .badge-dot { background: #60a5fa; }
    .badge.out { background: rgba(144, 171, 255, 0.12); color: #90abff; }
    .badge.out .badge-dot { background: #90abff; }
    .badge.delivered { background: rgba(52, 211, 153, 0.12); color: #34d399; }
    .badge.delivered .badge-dot { background: #34d399; }
    .badge.cancelled { background: rgba(255, 113, 108, 0.12); color: #ff716c; }
    .badge.cancelled .badge-dot { background: #ff716c; }

    /* ── Customer avatars ── */
    .customer-avatar {
      width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center;
      justify-content: center; flex-shrink: 0; font-size: 12px; font-weight: 800;
      border: 1px solid rgba(255,255,255,0.06);
    }
    .avatar-a { background: rgba(144, 171, 255, 0.14); color: #90abff; }
    .avatar-b { background: rgba(52, 211, 153, 0.12); color: #34d399; }
    .avatar-c { background: rgba(96, 165, 250, 0.13); color: #60a5fa; }
    .avatar-d { background: rgba(255, 113, 108, 0.12); color: #ff716c; }
    .avatar-e { background: rgba(255, 180, 100, 0.12); color: #ffb464; }
    .avatar-f { background: rgba(255, 180, 244, 0.14); color: #ffb4f4; }

    /* ── Filter tabs ── */
    .filter-tab {
      border: 1px solid #40485d; background: #091328; color: #a3aac4; border-radius: 8px;
      padding: 7px 13px; font-size: 12px; font-weight: 700; transition: all 0.15s; white-space: nowrap;
    }
    .filter-tab:hover { color: #fff; border-color: #6d758c; }
    .filter-tab.active {
      background: linear-gradient(135deg, #316bf3 0%, #90abff 100%);
      border-color: transparent; color: #fff;
    }

    /* ── Pagination (shared page-btn look) ── */
    .page-btn {
      display: inline-flex; align-items: center; justify-content: center; min-width: 32px; height: 32px;
      padding: 0 8px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;
      border: 1px solid rgba(64, 72, 93, 0.4); background: #0f1930; color: #a3aac4;
      transition: all 0.15s; user-select: none; text-decoration: none;
    }
    .page-btn:hover:not(.disabled) { background: #1f2b49; color: #fff; }
    .page-btn.active {
      background: linear-gradient(135deg, #316bf3 0%, #90abff 100%); color: #fff; border-color: transparent;
    }
    .page-btn.disabled { opacity: 0.35; pointer-events: none; }
    .page-ellipsis { color: #6d758c; padding: 0 4px; font-size: 13px; }

    /* ── Search bar (unified pill: icon + input + clear, all in one control) ── */
    .search-row {
      display: flex;
      align-items: stretch;
      gap: 10px;
      flex: 1;
      min-width: 280px;
    }
    .search-bar {
      display: flex;
      align-items: center;
      flex: 1;
      min-width: 0;
      height: 42px;
      background-color: #091328;
      border: 1px solid #40485d;
      border-radius: 0.75rem;
      padding: 0 10px 0 12px;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .search-bar:focus-within {
      border-color: #90abff;
      box-shadow: 0 0 0 3px rgba(144, 171, 255, 0.12);
    }
    .search-icon {
      color: #6d758c;
      font-size: 18px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
    }
    .search-bar:focus-within .search-icon {
      color: #90abff;
    }
    .search-input {
      flex: 1;
      min-width: 0;
      width: 100%;
      background-color: transparent !important;
      border: none !important;
      color: #dee5ff !important;
      font-size: 13px;
      padding: 0 8px;
      outline: none !important;
      box-shadow: none !important;
    }
    .search-input::placeholder { color: #6d758c; }
    .search-clear-x {
      display: none;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      color: #a3aac4;
      background: transparent;
      border: none;
      cursor: pointer;
      padding: 0;
      flex-shrink: 0;
    }
    .search-clear-x.visible { display: flex; }
    .search-clear-x:hover { color: #fff; background: #1f2b49; }
    .search-submit-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      height: 42px;
      padding: 0 18px;
      border-radius: 0.75rem;
      font-size: 12px;
      font-weight: 700;
      color: #fff;
      white-space: nowrap;
      flex-shrink: 0;
      border: none;
      cursor: pointer;
      transition: opacity 0.15s;
    }
    .search-submit-btn:hover { opacity: 0.9; }
    .filter-tabs-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
  </style>
  <link rel="stylesheet" href="/css/navigation-consistency.css" />
</head>

<body class="bg-background text-on-background font-body antialiased min-h-screen">

  <!-- Sidebar -->
  <aside class="h-screen w-64 fixed left-0 top-0 bg-[#091328] dark:bg-slate-950 flex flex-col py-8 px-4 z-50">

    <div class="mb-10 px-4">
      <h1 class="font-['Manrope'] font-extrabold text-xl tracking-tighter text-white">LUXE Admin</h1>
      <p class="text-on-surface-variant text-[10px] uppercase tracking-widest mt-1">Premium Command</p>
    </div>

    <nav class="flex-1 space-y-1">
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/dashboard">
        <span class="material-symbols-outlined text-lg">dashboard</span>Dashboard
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-white border-l-4 border-[#90abff] bg-[#1f2b49] font-bold text-sm"
        href="/admin/order-management">
        <span class="material-symbols-outlined text-lg">shopping_cart</span>Orders
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/products">
        <span class="material-symbols-outlined text-lg">inventory_2</span>Products
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/users">
        <span class="material-symbols-outlined text-lg">group</span>Users
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/analystic">
        <span class="material-symbols-outlined text-lg">monitoring</span>Analytics
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/coupons">
        <span class="material-symbols-outlined text-lg">confirmation_number</span>Coupons
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/category">
        <span class="material-symbols-outlined text-lg">category</span>Categories
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/offer">
        <span class="material-symbols-outlined text-lg">local_offer</span>Offers
      </a>
     
    </nav>

    <div class="mt-auto px-4 pt-6 border-t border-[#1f2a44]">
      <form action="/admin/logout" method="POST">
        <button type="submit"
          class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-['Inter'] font-bold text-sm tracking-tight">
          <span class="material-symbols-outlined text-lg">logout</span>
          Logout
        </button>
      </form>
    </div>

  </aside>

  <!-- Main Content -->
  <main class="ml-64 min-h-screen relative">

    <!-- Top Nav -->
    <header
      class="fixed top-0 right-0 w-[calc(100%-16rem)] h-16 bg-[#060e20]/70 backdrop-blur-xl shadow-2xl shadow-blue-900/10 flex items-center justify-between px-8 z-40">
      <div class="flex items-center gap-6">
        <h2 class="font-['Manrope'] font-semibold text-lg text-[#90abff]">Order Management</h2>
      </div>

      <div class="flex items-center gap-4">
        <button class="p-2 text-on-surface-variant hover:text-white transition-colors">
          <span class="material-symbols-outlined">notifications</span>
        </button>
        <button class="p-2 text-on-surface-variant hover:text-white transition-colors">
          <span class="material-symbols-outlined">settings</span>
        </button>
        <div class="h-8 w-px bg-outline-variant/20 mx-2"></div>
        <div class="w-9 h-9 rounded-full luxe-gradient flex items-center justify-center text-white text-xs font-bold">
          A
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <div class="pt-24 px-8 pb-12">

      <section class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <h2 class="font-['Manrope'] font-extrabold text-2xl text-white">Orders</h2>
          <p class="text-on-surface-variant text-sm mt-1">Track purchases, payment methods, delivery progress, and
            order value.</p>
        </div>
        <a href="/admin/order-management?status=<%= statusFilter %>&search=<%= encodeURIComponent(search || '') %>&page=<%= currentPage %>"
          class="flex items-center gap-2 px-4 py-2 bg-surface-container-high border border-outline-variant/20 rounded-xl text-xs font-bold text-on-surface-variant hover:text-white transition-colors">
          <span class="material-symbols-outlined text-[16px]">refresh</span>Refresh
        </a>
      </section>

      <!-- Filters -->
      <div class="bg-surface-container-high rounded-2xl shadow-2xl p-5 mb-6">

        <form method="GET" action="/admin/order-management" class="search-row" id="orderSearchForm">
          <input type="hidden" name="status" value="<%= statusFilter %>" />

          <div class="search-bar">
            <span class="material-symbols-outlined search-icon">search</span>
            <input
              id="orderSearchInput"
              name="search"
              type="text"
              autocomplete="off"
              value="<%= search || '' %>"
              placeholder="Search by order code, customer, city, phone, or payment method"
              class="search-input" />
            <button type="button" id="orderSearchClearX"
              class="search-clear-x <%= search ? 'visible' : '' %>" aria-label="Clear search">
              <span class="material-symbols-outlined" style="font-size:16px;">close</span>
            </button>
          </div>

          <button type="submit" class="search-submit-btn luxe-gradient">
            <span class="material-symbols-outlined" style="font-size:16px;">search</span>Search
          </button>

          <% if (search) { %>
            <a href="/admin/order-management?status=<%= statusFilter %>&page=1"
              class="page-btn" style="height:42px; padding:0 16px;">Clear</a>
          <% } %>
        </form>

        <div class="filter-tabs-row mt-4 pt-4 border-t border-outline-variant/10">
          <a href="/admin/order-management?status=all&search=<%= encodeURIComponent(search || '') %>&page=1"
            class="filter-tab <%= statusFilter === 'all' ? 'active' : '' %>">All</a>
          <a href="/admin/order-management?status=processing&search=<%= encodeURIComponent(search || '') %>&page=1"
            class="filter-tab <%= statusFilter === 'processing' ? 'active' : '' %>">Processing</a>
          <a href="/admin/order-management?status=shipped&search=<%= encodeURIComponent(search || '') %>&page=1"
            class="filter-tab <%= statusFilter === 'shipped' ? 'active' : '' %>">Shipped</a>
          <a href="/admin/order-management?status=delivered&search=<%= encodeURIComponent(search || '') %>&page=1"
            class="filter-tab <%= statusFilter === 'delivered' ? 'active' : '' %>">Delivered</a>
          <a href="/admin/order-management?status=cancelled&search=<%= encodeURIComponent(search || '') %>&page=1"
            class="filter-tab <%= statusFilter === 'cancelled' ? 'active' : '' %>">Cancelled</a>
        </div>
      </div>

      <!-- Orders Table -->
      <section class="bg-surface-container-high rounded-2xl shadow-2xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full border-collapse" style="min-width:980px;">
            <thead>
              <tr class="bg-surface-container-low/50">
                <th class="px-6 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">Order</th>
                <th class="px-6 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">Customer</th>
                <th class="px-6 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">Date</th>
                <th class="px-6 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">Amount</th>
                <th class="px-6 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">Payment</th>
                <th class="px-6 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">Status</th>
                <th class="px-6 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">Items</th>
                <th class="px-6 py-5 text-right text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant/10 text-sm">
              <% if (!orders || orders.length === 0) { %>
                <tr>
                  <td colspan="8">
                    <div class="p-16 text-center">
                      <span class="material-symbols-outlined text-5xl text-outline-variant mb-3 block">inventory_2</span>
                      <p class="text-sm text-on-surface-variant">No orders found for this filter.</p>
                    </div>
                  </td>
                </tr>
              <% } else { %>
                <% orders.forEach(order => {
                  const address = order.shippingAddress || {};
                  const fullName = address.username || "Unknown Customer";
                  const nameParts = fullName.trim().split(/\s+/).filter(Boolean);
                  const initials = nameParts.length > 1
                    ? (nameParts[0][0] + nameParts[nameParts.length - 1][0]).toUpperCase()
                    : fullName.substring(0, 2).toUpperCase();
                  const orderCode = order.orderCode || String(order._id).slice(-8).toUpperCase();
                  const avatarClasses = ["avatar-a", "avatar-b", "avatar-c", "avatar-d", "avatar-e", "avatar-f"];
                  const avatarIndex = orderCode ? orderCode.charCodeAt(orderCode.length - 1) % avatarClasses.length : 0;
                  const avatarClass = avatarClasses[avatarIndex];
                  let statusClass = "processing";
                  let statusLabel = "Processing";

                  if (order.orderStatus === "cancelled" || order.deliveryStatus === "cancelled") {
                    statusClass = "cancelled";
                    statusLabel = "Cancelled";
                  } else if (order.deliveryStatus === "delivered") {
                    statusClass = "delivered";
                    statusLabel = "Delivered";
                  } else if (order.deliveryStatus === "shipped") {
                    statusClass = "shipped";
                    statusLabel = "Shipped";
                  } else if (order.deliveryStatus === "out_for_delivery") {
                    statusClass = "out";
                    statusLabel = "Out for Delivery";
                  }

                  const location = [address.city, address.state].filter(Boolean).join(", ");
                  const itemCount = order.orderItems ? order.orderItems.reduce((sum, item) => sum + (item.quantity || 0), 0) : 0;
                %>
                <tr class="hover:bg-surface-bright/50 transition-colors">
                  <td class="px-6 py-4 mono text-primary font-semibold whitespace-nowrap"><%= orderCode %></td>
                  <td class="px-6 py-4">
                    <div class="flex items-center gap-3 min-w-[220px]">
                      <div class="customer-avatar <%= avatarClass %>"><%= initials %></div>
                      <div>
                        <div class="font-semibold text-on-surface leading-tight"><%= fullName %></div>
                        <div class="text-on-surface-variant text-[11px] mt-0.5 max-w-[260px] truncate">
                          <%= location || address.phone_number || "Address unavailable" %>
                        </div>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-4 mono text-on-surface-variant text-xs whitespace-nowrap">
                    <%= new Date(order.orderDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                  </td>
                  <td class="px-6 py-4 font-bold text-white whitespace-nowrap">₹<%= Number(order.totalAmount || 0).toLocaleString('en-IN') %></td>
                  <td class="px-6 py-4 text-on-surface-variant text-xs font-bold uppercase"><%= order.orderMethod || "-" %></td>
                  <td class="px-6 py-4">
                    <span class="badge <%= statusClass %>">
                      <span class="badge-dot"></span>
                      <%= statusLabel %>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-on-surface-variant"><%= itemCount %> item<%= itemCount === 1 ? '' : 's' %></td>
                  <td class="px-6 py-4 text-right">
                    <a href="/admin/orders/<%= order._id %>"
                      class="inline-flex items-center justify-center border border-primary/30 bg-primary/10 text-primary rounded-lg px-3 py-1.5 text-xs font-bold hover:bg-primary/20 transition-colors">View</a>
                  </td>
                </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <div class="flex items-center justify-between px-6 py-5 bg-surface-container-low/30 flex-wrap gap-3">
          <span class="text-xs text-on-surface-variant">
            Showing <%= filteredTotal === 0 ? 0 : Math.min((currentPage - 1) * limit + 1, filteredTotal) %>
            to <%= Math.min(currentPage * limit, filteredTotal) %>
            of <%= filteredTotal.toLocaleString('en-IN') %> orders
          </span>

          <% if (totalPages > 1) { %>
            <div class="flex items-center gap-1 flex-wrap">
              <a href="/admin/order-management?status=<%= statusFilter %>&search=<%= encodeURIComponent(search || '') %>&page=<%= currentPage - 1 %>"
                class="page-btn <%= currentPage <= 1 ? 'disabled' : '' %>">Prev</a>

              <% for (let i = 1; i <= totalPages; i++) { %>
                <% if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) { %>
                  <a href="/admin/order-management?status=<%= statusFilter %>&search=<%= encodeURIComponent(search || '') %>&page=<%= i %>"
                    class="page-btn <%= i === currentPage ? 'active' : '' %>"><%= i %></a>
                <% } else if (i === currentPage - 2 || i === currentPage + 2) { %>
                  <span class="page-ellipsis">...</span>
                <% } %>
              <% } %>

              <a href="/admin/order-management?status=<%= statusFilter %>&search=<%= encodeURIComponent(search || '') %>&page=<%= currentPage + 1 %>"
                class="page-btn <%= currentPage >= totalPages ? 'disabled' : '' %>">Next</a>
            </div>
          <% } %>
        </div>
      </section>

    </div>

  </main>

  <script>
    // Search box behavior:
    //  - the "x" clears the text field only (no submit), so the person can retype without losing focus
    //  - it re-submits (resetting to page 1, keeping the status filter) only via the Search button or Enter
    (function () {
      const clearBtn = document.getElementById('orderSearchClearX');
      const input = document.getElementById('orderSearchInput');
      const form = document.getElementById('orderSearchForm');

      function toggleClearVisibility() {
        if (!clearBtn) return;
        clearBtn.classList.toggle('visible', input.value.trim().length > 0);
      }

      if (clearBtn && input && form) {
        clearBtn.addEventListener('click', function () {
          input.value = '';
          toggleClearVisibility();
          input.focus();
          form.submit();
        });
        input.addEventListener('input', toggleClearVisibility);
      }
    })();
  </script>

</body>

</html>