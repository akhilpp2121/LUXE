<!DOCTYPE html>
<html class="dark" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>LUXE Sales Analytics</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap"
    rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    rel="stylesheet" />
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "secondary-container": "#313aa1", "on-primary-fixed-variant": "#00266e", "tertiary-dim": "#ef8fe5", "surface-container-highest": "#192540", "on-surface-variant": "#a3aac4", "on-tertiary-fixed-variant": "#711f6f", "outline": "#6d758c", "error-container": "#9f0519", "surface-bright": "#1f2b49", "secondary-fixed": "#cbceff", "primary-dim": "#316bf3", "background": "#060e20", "surface-variant": "#192540", "surface-container-lowest": "#000000", "primary-fixed": "#7b9cff", "surface-container-high": "#141f38", "surface-container": "#0f1930", "on-secondary-fixed-variant": "#3c45ab", "on-secondary-fixed": "#1c248e", "inverse-surface": "#faf8ff", "tertiary": "#ffb4f4", "surface-tint": "#90abff", "secondary-dim": "#8b94ff", "secondary": "#8b94ff", "on-primary-container": "#001e5a", "surface": "#060e20", "primary-fixed-dim": "#658eff", "on-tertiary": "#722070", "on-secondary-container": "#caccff", "on-primary-fixed": "#000000", "error-dim": "#d7383b", "error": "#ff716c", "tertiary-fixed-dim": "#ef8fe5", "on-surface": "#dee5ff", "surface-container-low": "#091328", "on-error-container": "#ffa8a3", "surface-dim": "#060e20", "on-secondary": "#000478", "on-error": "#490006", "outline-variant": "#40485d", "on-primary": "#002873", "primary": "#90abff", "on-tertiary-container": "#661466", "secondary-fixed-dim": "#bbbfff", "primary-container": "#7b9cff", "tertiary-fixed": "#fe9cf4", "on-background": "#dee5ff", "tertiary-container": "#fe9cf4", "on-tertiary-fixed": "#480049", "inverse-primary": "#0053dc", "inverse-on-surface": "#4d556b"
          },
          fontFamily: { "headline": ["Manrope"], "body": ["Inter"], "label": ["Inter"] },
          borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
        },
      },
    }
  </script>
  <style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    ::-webkit-scrollbar {
      width: 6px;
    }

    ::-webkit-scrollbar-track {
      background: #060e20;
    }

    ::-webkit-scrollbar-thumb {
      background: #1f2b49;
      border-radius: 10px;
    }

    .glass-effect {
      background: rgba(25, 37, 64, 0.7);
      backdrop-filter: blur(20px);
    }

    .luxe-gradient {
      background: linear-gradient(135deg, #316bf3 0%, #90abff 100%);
    }

    .search-btn {
      transition: all 0.15s ease;
    }

    .search-btn:active {
      transform: scale(0.93);
    }
  </style>
  <link rel="stylesheet" href="/css/navigation-consistency.css" />
</head>

<body class="bg-background text-on-background font-body antialiased min-h-screen">

  <%
    const pageSummary = summary || {};
    const pageOrders = Array.isArray(orders) ? orders : [];
    const activePeriod = period || "This Week";
    const activeFilter = filter || "weekly";
    const customFrom = from || "";
    const customTo = to || "";
    const filters = [
      { key: "daily", label: "Daily" },
      { key: "weekly", label: "Weekly" },
      { key: "monthly", label: "Monthly" },
      { key: "yearly", label: "Yearly" }
    ];
    const exportParams = new URLSearchParams({ filter: activeFilter });
    if (activeFilter === "custom") {
      if (customFrom) exportParams.set("from", customFrom);
      if (customTo) exportParams.set("to", customTo);
    }
    const exportQuery = exportParams.toString();

    const formatCurrency = (value) => {
      const amount = Number(value || 0);
      return amount.toLocaleString("en-IN", {
        style: "currency",
        currency: "INR",
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    };

    const statusClasses = {
      Delivered: "bg-emerald-500/10 text-emerald-400",
      Processing: "bg-primary/10 text-primary",
      Cancelled: "bg-error/10 text-error"
    };
  %>

  <!-- Sidebar -->
  <aside class="h-screen w-64 fixed left-0 top-0 bg-[#091328] dark:bg-slate-950 flex flex-col py-8 px-4 z-50">

    <div class="mb-10 px-4">
      <h1 class="font-['Manrope'] font-extrabold text-xl tracking-tighter text-white">LUXE Admin</h1>
      <p class="text-on-surface-variant text-[10px] uppercase tracking-widest mt-1">Premium Command</p>
    </div>

    <nav class="flex-1 space-y-1">
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/dashboard">
        <span class="material-symbols-outlined text-lg">dashboard</span>Dashboard
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/order-management">
        <span class="material-symbols-outlined text-lg">shopping_cart</span>Orders
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/products">
        <span class="material-symbols-outlined text-lg">inventory_2</span>Products
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/users">
        <span class="material-symbols-outlined text-lg">group</span>Users
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-white border-l-4 border-[#90abff] bg-[#1f2b49] font-bold text-sm"
        href="/admin/analystic">
        <span class="material-symbols-outlined text-lg">monitoring</span>Analytics
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/coupons">
        <span class="material-symbols-outlined text-lg">confirmation_number</span>Coupons
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/category">
        <span class="material-symbols-outlined text-lg">category</span>Categories
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/offer">
        <span class="material-symbols-outlined text-lg">local_offer</span>Offers
      </a>
     
    </nav>

    <div class="mt-auto px-4 pt-6 border-t border-[#1f2a44]">
      <form action="/admin/logout" method="POST">
        <button type="submit"
          class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-['Inter'] font-bold text-sm tracking-tight">
          <span class="material-symbols-outlined text-lg">logout</span>
          Logout
        </button>
      </form>
    </div>

  </aside>

  <!-- Main Content -->
  <main class="ml-64 min-h-screen relative">

    <!-- Top Nav -->
    <header
      class="fixed top-0 right-0 w-[calc(100%-16rem)] h-16 bg-[#060e20]/70 backdrop-blur-xl shadow-2xl shadow-blue-900/10 flex items-center justify-between px-8 z-40">
      <div class="flex items-center gap-6">
        <h2 class="font-['Manrope'] font-semibold text-lg text-[#90abff]">Analytics</h2>
        <div
          class="bg-surface-container-high rounded-lg px-4 py-2 flex items-center gap-2 border border-outline-variant/5">
          <span class="material-symbols-outlined text-on-surface-variant text-sm">calendar_today</span>
          <span class="text-xs font-bold text-on-surface"><%= activePeriod %></span>
        </div>
      </div>

      <div class="flex items-center gap-4">
        <button class="p-2 text-on-surface-variant hover:text-white transition-colors">
          <span class="material-symbols-outlined">notifications</span>
        </button>
        <button class="p-2 text-on-surface-variant hover:text-white transition-colors">
          <span class="material-symbols-outlined">settings</span>
        </button>
        <div class="h-8 w-px bg-outline-variant/20 mx-2"></div>
        <div class="w-9 h-9 rounded-full luxe-gradient flex items-center justify-center text-white text-xs font-bold">
          A
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <div class="pt-24 px-8 pb-12">

      <!-- Quick Range + Custom Date -->
      <section class="bg-surface-container-high rounded-2xl p-5 shadow-2xl mb-8">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
          <div class="flex flex-col gap-2.5">
            <label class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">Quick
              Range</label>
            <div class="flex flex-wrap gap-2">
              <% filters.forEach((item) => { %>
                <a href="/admin/analystic?filter=<%= item.key %>"
                  class="px-4 py-2 rounded-lg text-xs font-bold transition-colors <%= activeFilter === item.key ? 'luxe-gradient text-white' : 'bg-surface-container-low text-on-surface-variant hover:text-white hover:bg-surface-bright' %>">
                  <%= item.label %>
                </a>
                <% }) %>
                  <span
                    class="px-4 py-2 rounded-lg text-xs font-bold <%= activeFilter === 'custom' ? 'luxe-gradient text-white' : 'bg-surface-container-low text-on-surface-variant' %>">Custom</span>
            </div>
          </div>

          <form action="/admin/analystic" method="GET" class="grid gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end">
            <input type="hidden" name="filter" value="custom">
            <div>
              <label for="date-from"
                class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">From</label>
              <input id="date-from" name="from" type="date" value="<%= customFrom %>"
                class="mt-1.5 w-full bg-surface-container-low border border-outline-variant/10 rounded-lg px-3 py-2 text-xs text-on-surface outline-none focus:border-primary/50 transition-colors [color-scheme:dark]">
            </div>
            <div>
              <label for="date-to"
                class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">To</label>
              <input id="date-to" name="to" type="date" value="<%= customTo %>"
                class="mt-1.5 w-full bg-surface-container-low border border-outline-variant/10 rounded-lg px-3 py-2 text-xs text-on-surface outline-none focus:border-primary/50 transition-colors [color-scheme:dark]">
            </div>
            <button type="submit"
              class="luxe-gradient text-on-primary font-bold text-xs px-6 py-2.5 rounded-lg hover:brightness-110 active:scale-95 transition-all">Apply</button>
          </form>
        </div>
      </section>

      <!-- Summary Cards -->
      <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4 mb-8">
        <div class="bg-surface-container-high rounded-2xl p-5 shadow-xl">
          <p class="text-[10px] uppercase tracking-widest font-bold text-on-surface-variant">Total Orders</p>
          <p class="text-2xl font-extrabold text-on-surface mt-1.5">
            <%= Number(pageSummary.totalOrders || 0).toLocaleString("en-IN") %>
          </p>
        </div>
        <div class="bg-surface-container-high rounded-2xl p-5 shadow-xl">
          <p class="text-[10px] uppercase tracking-widest font-bold text-on-surface-variant">Order Amount</p>
          <p class="text-2xl font-extrabold text-primary mt-1.5">
            <%= formatCurrency(pageSummary.orderAmount) %>
          </p>
        </div>
        <div class="bg-surface-container-high rounded-2xl p-5 shadow-xl">
          <p class="text-[10px] uppercase tracking-widest font-bold text-on-surface-variant">Total Discount</p>
          <p class="text-2xl font-extrabold text-error mt-1.5">
            <%= formatCurrency(pageSummary.totalDiscount) %>
          </p>
        </div>
        <div class="bg-surface-container-high rounded-2xl p-5 shadow-xl">
          <p class="text-[10px] uppercase tracking-widest font-bold text-on-surface-variant">Net Revenue</p>
          <p class="text-2xl font-extrabold text-emerald-400 mt-1.5">
            <%= formatCurrency(pageSummary.netRevenue) %>
          </p>
        </div>
      </section>

      <!-- Orders Table -->
      <section class="bg-surface-container-high rounded-2xl overflow-hidden shadow-2xl">
        <div
          class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between px-6 py-5 bg-surface-container-low/50">
          <div>
            <h2 class="font-['Manrope'] font-bold text-base text-white">Orders</h2>
            <p class="mt-0.5 text-xs text-on-surface-variant">Showing complete sales report for <%= activePeriod %>
            </p>
          </div>
          <div class="flex flex-wrap gap-2">
            <a href="/admin/analystic/pdf?<%= exportQuery %>"
              class="search-btn flex items-center justify-center gap-1.5 h-[38px] px-4 bg-surface-container-low border border-outline-variant/10 hover:border-primary/40 text-on-surface-variant hover:text-primary font-bold text-xs rounded-sm transition-colors">
              <span class="material-symbols-outlined text-sm">picture_as_pdf</span>
              Download PDF
            </a>
            <a href="/admin/analystic/excel?<%= exportQuery %>"
              class="search-btn flex items-center justify-center gap-1.5 h-[38px] px-4 bg-surface-container-low border border-outline-variant/10 hover:border-primary/40 text-on-surface-variant hover:text-primary font-bold text-xs rounded-sm transition-colors">
              <span class="material-symbols-outlined text-sm">table_view</span>
              Export Excel
            </a>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr class="bg-surface-container-low/50">
                <th
                  class="px-6 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant whitespace-nowrap">
                  Order ID</th>
                <th
                  class="px-6 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant whitespace-nowrap">
                  Date</th>
                <th
                  class="px-6 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant whitespace-nowrap">
                  Customer</th>
                <th
                  class="px-6 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant whitespace-nowrap">
                  Order Amount</th>
                <th
                  class="px-6 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant whitespace-nowrap">
                  Coupon Code</th>
                <th
                  class="px-6 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant whitespace-nowrap">
                  Discount</th>
                <th
                  class="px-6 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant whitespace-nowrap">
                  Net Amount</th>
                <th
                  class="px-6 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant whitespace-nowrap">
                  Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant/10">
              <% if (pageOrders.length) { %>
                <% pageOrders.forEach((order) => { %>
                  <tr class="group hover:bg-surface-bright/50 transition-colors">
                    <td class="px-6 py-4 text-sm font-bold text-primary whitespace-nowrap">#<%= order.id %></td>
                    <td class="px-6 py-4 text-xs text-on-surface-variant whitespace-nowrap"><%= order.date %></td>
                    <td class="px-6 py-4 text-sm font-bold text-white whitespace-nowrap"><%= order.customer %></td>
                    <td class="px-6 py-4 text-xs text-on-surface whitespace-nowrap">
                      <%= formatCurrency(order.orderAmount) %>
                    </td>
                    <td class="px-6 py-4 text-xs whitespace-nowrap">
                      <% if (order.coupon) { %>
                        <span
                          class="text-[10px] font-bold text-primary uppercase tracking-widest px-2.5 py-1 bg-primary/10 rounded">
                          <%= order.coupon %>
                        </span>
                        <% } else { %>
                          <span class="text-on-surface-variant/50">—</span>
                          <% } %>
                    </td>
                    <td class="px-6 py-4 text-xs font-bold text-error whitespace-nowrap">
                      <%= formatCurrency(order.totalDiscount) %>
                    </td>
                    <td class="px-6 py-4 text-sm font-bold text-white whitespace-nowrap">
                      <%= formatCurrency(order.netAmount) %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span
                        class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded <%= statusClasses[order.status] || 'bg-surface-container-low text-on-surface-variant' %>">
                        <span class="w-1.5 h-1.5 rounded-full bg-current inline-block"></span>
                        <%= order.status %>
                      </span>
                    </td>
                  </tr>
                  <% }) %>
                    <% } else { %>
                      <tr>
                        <td colspan="8" class="px-8 py-16 text-center">
                          <div class="flex flex-col items-center gap-3">
                            <span class="material-symbols-outlined text-4xl text-on-surface-variant">receipt_long</span>
                            <p class="text-sm font-bold text-on-surface-variant">No orders found for this period</p>
                          </div>
                        </td>
                      </tr>
                      <% } %>
            </tbody>
          </table>
        </div>
      </section>

    </div>

  </main>

</body>

</html>
