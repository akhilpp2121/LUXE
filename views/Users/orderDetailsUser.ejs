            <h2 class="font-headline font-bold text-white text-lg uppercase tracking-tight">Return Request</h2>
            <p class="text-on-surface-variant text-[11px] mt-0.5" id="returnModalSubtitle"></p>
          </div>
        </div>
        <button onclick="closeReturnModal()" class="text-on-surface-variant hover:text-white p-1">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>

      <p class="text-on-surface-variant text-sm mb-5">Items must be unused and in original packaging. Refund processed within 7–10 business days.</p>

      <input type="hidden" id="returnOrderId"/>
      <input type="hidden" id="returnVariantId"/>

      <!-- Item summary chip -->
      <div id="returnItemChip" style="display:none;" class="mb-5 flex items-center gap-3 p-3 rounded bg-primary/5 border border-primary/20">
        <span class="material-symbols-outlined text-primary text-base">inventory_2</span>
        <div>
          <p class="text-white text-sm font-semibold" id="returnItemName"></p>
          <p class="text-on-surface-variant text-[11px]" id="returnItemMeta"></p>
        </div>
      </div>

      <div class="space-y-5">

        <!-- Quantity -->
        <div id="returnQtyRow">
          <label class="block text-[10px] uppercase tracking-widest font-bold text-on-surface-variant mb-2">Quantity to Return *</label>
          <div class="qty-spinner">
            <button type="button" id="qtyMinus" onclick="adjustQty(-1)">−</button>
            <input type="number" id="returnQty" value="1" min="1" max="1" readonly/>
            <button type="button" id="qtyPlus" onclick="adjustQty(1)">+</button>
          </div>
          <p class="text-[11px] text-on-surface-variant mt-2">
            Max returnable: <span id="returnQtyMax" class="text-white font-semibold">1</span>
          </p>
        </div>

        <!-- Reason -->
        <div>
          <label class="block text-[10px] uppercase tracking-widest font-bold text-on-surface-variant mb-2">Reason *</label>
          <select id="returnReason" class="da-input">
            <option value="">Select a reason</option>
            <option value="defective">Defective or damaged</option>
            <option value="wrong_item">Received wrong item</option>
            <option value="not_as_described">Not as described</option>
            <option value="quality_issues">Quality issues</option>
            <option value="size_fit">Size / fit issues</option>
            <option value="changed_mind">Changed my mind</option>
            <option value="other">Other</option>
          </select>
        </div>

        <!-- Details -->
        <div>
          <label class="block text-[10px] uppercase tracking-widest font-bold text-on-surface-variant mb-2">Details *</label>
          <textarea id="returnRemark" rows="3" class="da-input resize-none" placeholder="Describe the issue in detail…"></textarea>
        </div>

        <!-- Resolution -->
        <div>
          <label class="block text-[10px] uppercase tracking-widest font-bold text-on-surface-variant mb-2">Preferred Resolution *</label>
          <select id="returnResolution" class="da-input">
            <option value="">Select resolution</option>
            <option value="refund">Refund</option>
          </select>
