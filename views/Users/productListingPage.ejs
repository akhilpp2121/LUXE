<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet"/>
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            primary: "#1152d4",
            "background-light": "#f6f6f8",
            "background-dark":  "#101622",
          },
          fontFamily: { display: ["Manrope", "sans-serif"] },
          borderRadius: { DEFAULT: "0.25rem", lg: "0.5rem", xl: "0.75rem", full: "9999px" },
        },
      },
    };
  </script>
  <style>
    body { font-family: 'Manrope', sans-serif; }
    .material-symbols-outlined { font-variation-settings: 'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24; }
    aside { max-height: calc(100vh - 88px); overflow-y: auto; position: sticky; top: 88px; }
    aside::-webkit-scrollbar { width: 4px; }
    aside::-webkit-scrollbar-thumb { background: #334155; border-radius: 99px; }
  </style>
</head>
<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 font-display">
<div class="relative flex min-h-screen w-full flex-col overflow-x-hidden">

  <!-- ═══════════ HEADER ═══════════ -->
  <header class="sticky top-0 z-50 w-full border-b border-slate-200 dark:border-slate-800
                 bg-background-light/80 dark:bg-background-dark/80 backdrop-blur-md px-6 lg:px-20 py-4">
    <div class="max-w-[1440px] mx-auto flex items-center justify-between gap-8">

      <div class="flex items-center gap-8 flex-1">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 text-primary shrink-0">
          <span class="material-symbols-outlined text-4xl font-bold">diamond</span>
          <h2 class="text-2xl font-extrabold tracking-tighter text-slate-900 dark:text-white uppercase">LUXE</h2>
        </a>

        <!-- Search bar with clear button -->
        <form method="GET" action="" id="searchForm" class="hidden md:flex flex-1 max-w-md">
          <%# carry all active filters through a search change %>
          <% if (sortValue)     { %><input type="hidden" name="sort"     value="<%= sortValue %>"/><% } %>
          <% if (categoryValue) { %><input type="hidden" name="category" value="<%= categoryValue %>"/><% } %>
          <% if (minPrice)      { %><input type="hidden" name="minPrice" value="<%= minPrice %>"/><% } %>
          <% if (maxPrice)      { %><input type="hidden" name="maxPrice" value="<%= maxPrice %>"/><% } %>

          <div class="relative w-full">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
            <input
              id="searchInput"
              name="search"
              type="text"
              value="<%= searchValue %>"
              placeholder="Search by name or description…"
              autocomplete="off"
              class="w-full bg-slate-100 dark:bg-slate-800 border-none rounded-lg py-2.5
                     pl-10 pr-10 text-sm outline-none focus:ring-2 focus:ring-primary transition-all"
            />
            <% if (searchValue) { %>
              <%
                const clearSearchQS = [
                  sortValue     ? 'sort='     + sortValue     : '',
                  categoryValue ? 'category=' + categoryValue : '',
                 
                  minPrice      ? 'minPrice=' + minPrice      : '',
                  maxPrice      ? 'maxPrice=' + maxPrice      : '',
                ].filter(Boolean).join('&');
              %>
              <a href="?<%= clearSearchQS %>"
                 title="Clear search"
                 class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-red-500 transition-colors">
                <span class="material-symbols-outlined text-lg">close</span>
              </a>
            <% } %>
          </div>
        </form>
      </div>

      <!-- Nav -->
      <nav class="hidden xl:flex items-center gap-8">
        <a class="text-sm font-semibold hover:text-primary transition-colors" href="#">Collections</a>
        <a class="text-sm font-semibold hover:text-primary transition-colors" href="#">New Arrivals</a>
        <a class="text-sm font-semibold hover:text-primary transition-colors" href="#">About</a>
      </nav>

      <!-- Actions -->
      <div class="flex items-center gap-3">
        <button class="hidden sm:flex items-center gap-2 px-4 py-2 bg-slate-100 dark:bg-slate-800
                       rounded-lg text-sm font-bold hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
          <span class="material-symbols-outlined text-base">person</span>Account
        </button>
        <button class="p-2 bg-slate-100 dark:bg-slate-800 rounded-lg hover:text-primary transition-colors">
          <span class="material-symbols-outlined">favorite</span>
        </button>
        <button class="p-2 bg-slate-100 dark:bg-slate-800 rounded-lg hover:text-primary transition-colors relative">
          <span class="material-symbols-outlined">shopping_bag</span>
          <span class="absolute -top-1 -right-1 flex h-4 w-4 items-center justify-center
                       rounded-full bg-primary text-[10px] text-white font-bold">0</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ═══════════ MAIN ═══════════ -->
  <main class="flex-1 w-full max-w-[1440px] mx-auto px-6 lg:px-20 py-10 flex gap-10">

    <!-- ══ SIDEBAR FILTER FORM ══ -->
    <form method="GET" action="" id="filterForm">
      <!-- hidden: carry search + sort through sidebar filter changes -->
      <input type="hidden" name="search" id="ff_search" value="<%= searchValue %>"/>
      <input type="hidden" name="sort"   id="ff_sort"   value="<%= sortValue %>"/>

    <aside class="hidden lg:flex flex-col w-60 shrink-0 gap-7 pb-10">

      <!-- Active filter chips -->
     <% const hasFilter = searchValue || categoryValue || minPrice || maxPrice; %>
<% if (hasFilter) { %>
  <div>
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-bold uppercase tracking-widest text-slate-500">Active Filters</span>
      <a href="?" class="text-xs text-red-500 font-bold hover:underline">Clear all</a>
    </div>
    <div class="flex flex-wrap gap-2">

      <!-- Search chip -->
      <% if (searchValue) { %>
        <%
          const rmSearch = [
            sortValue     ? 'sort='     + sortValue     : '',
            categoryValue ? 'category=' + categoryValue : '',
            minPrice      ? 'minPrice=' + minPrice      : '',
            maxPrice      ? 'maxPrice=' + maxPrice      : '',
          ].filter(Boolean).join('&');
        %>
        <a href="?<%= rmSearch %>"
           class="flex items-center gap-1 px-2 py-1 bg-primary/10 text-primary text-xs font-bold rounded-full">
           "<%= searchValue %>"
          <span class="material-symbols-outlined text-sm leading-none">close</span>
        </a>
      <% } %>

      <!-- Category chip — show name not ID -->
      <% if (categoryValue) { %>
        <%
          const activeCat = categories.find(c => c._id.toString() === categoryValue);
          const rmCat = [
            searchValue ? 'search=' + encodeURIComponent(searchValue) : '',
            sortValue   ? 'sort='   + sortValue                       : '',
            minPrice    ? 'minPrice=' + minPrice                      : '',
            maxPrice    ? 'maxPrice=' + maxPrice                      : '',
          ].filter(Boolean).join('&');
        %>
        <a href="?<%= rmCat %>"
           class="flex items-center gap-1 px-2 py-1 bg-primary/10 text-primary text-xs font-bold rounded-full capitalize">
          <%= activeCat ? activeCat.name : 'Category' %>
          <span class="material-symbols-outlined text-sm leading-none">close</span>
        </a>
      <% } %>

      <!-- Price chip -->
      <% if (minPrice || maxPrice) { %>
        <%
          const rmPrice = [
            searchValue   ? 'search='   + encodeURIComponent(searchValue) : '',
            sortValue     ? 'sort='     + sortValue                       : '',
            categoryValue ? 'category=' + categoryValue                   : '',
          ].filter(Boolean).join('&');
        %>
        <a href="?<%= rmPrice %>"
           class="flex items-center gap-1 px-2 py-1 bg-primary/10 text-primary text-xs font-bold rounded-full">
          ₹<%= minPrice || '0' %> – ₹<%= maxPrice || '∞' %>
          <span class="material-symbols-outlined text-sm leading-none">close</span>
        </a>
      <% } %>
      <!-- Size chip -->

    </div>
  </div>
<% } %>
      <!-- Category -->
     <!-- Category -->
<div>
  <h3 class="text-base font-bold mb-3 flex items-center gap-2">
    <span class="material-symbols-outlined text-primary text-lg">category</span>Category
  </h3>
  <div class="flex flex-col gap-0.5">

    <label class="flex items-center justify-between px-3 py-2 rounded-lg cursor-pointer transition-colors
                  <%= !categoryValue ? 'bg-primary/10 text-primary font-bold' : 'hover:bg-slate-100 dark:hover:bg-slate-800' %>">
      <span class="text-sm">All</span>
      <input type="radio" name="category" value="" class="sr-only"
             <%= !categoryValue ? 'checked' : '' %> onchange="submitFilter()"/>
    </label>

    <% categories.forEach(function(cat) { %>
      <label class="flex items-center justify-between px-3 py-2 rounded-lg cursor-pointer transition-colors
                 
      <%= categoryValue === cat._id.toString() ? 'bg-primary/10 text-primary font-bold' : 'hover:bg-slate-100 dark:hover:bg-slate-800' %>">
      <span class="text-sm capitalize">
  <%= cat.categoryName || cat.name %>
</span>
        <input type="radio" name="category" value="<%= cat._id %>" class="sr-only"
               <%= categoryValue === cat._id.toString() ? 'checked' : '' %>
               onchange="submitFilter()"/>
      </label>
    <% }) %>

  </div>
</div>

      <!-- Price Range -->
 <!-- Price Range -->
<div class="border-t border-slate-200 dark:border-slate-800 pt-6">
  <h3 class="text-base font-bold mb-3">Price Range</h3>
  <div class="flex flex-col gap-0.5">

    <label class="flex items-center justify-between px-3 py-2 rounded-lg cursor-pointer transition-colors
                  <%= !minPrice && !maxPrice ? 'bg-primary/10 text-primary font-bold' : 'hover:bg-slate-100 dark:hover:bg-slate-800' %>">
      <span class="text-sm">All Prices</span>
      <input type="radio" name="priceRange" value="" class="sr-only"
             <%= !minPrice && !maxPrice ? 'checked' : '' %> onchange="setPrice('','')"/>
    </label>

    <label class="flex items-center justify-between px-3 py-2 rounded-lg cursor-pointer transition-colors
                  <%= minPrice==='0' && maxPrice==='500' ? 'bg-primary/10 text-primary font-bold' : 'hover:bg-slate-100 dark:hover:bg-slate-800' %>">
      <span class="text-sm">Under ₹500</span>
      <input type="radio" name="priceRange" value="0-500" class="sr-only"
             <%= minPrice==='0' && maxPrice==='500' ? 'checked' : '' %> onchange="setPrice('0','500')"/>
    </label>

    <label class="flex items-center justify-between px-3 py-2 rounded-lg cursor-pointer transition-colors
                  <%= minPrice==='500' && maxPrice==='1000' ? 'bg-primary/10 text-primary font-bold' : 'hover:bg-slate-100 dark:hover:bg-slate-800' %>">
      <span class="text-sm">₹500 – ₹1,000</span>
      <input type="radio" name="priceRange" value="500-1000" class="sr-only"
             <%= minPrice==='500' && maxPrice==='1000' ? 'checked' : '' %> onchange="setPrice('500','1000')"/>
    </label>

    <label class="flex items-center justify-between px-3 py-2 rounded-lg cursor-pointer transition-colors
                  <%= minPrice==='1000' && maxPrice==='2000' ? 'bg-primary/10 text-primary font-bold' : 'hover:bg-slate-100 dark:hover:bg-slate-800' %>">
      <span class="text-sm">₹1,000 – ₹2,000</span>
      <input type="radio" name="priceRange" value="1000-2000" class="sr-only"
             <%= minPrice==='1000' && maxPrice==='2000' ? 'checked' : '' %> onchange="setPrice('1000','2000')"/>
    </label>

    <label class="flex items-center justify-between px-3 py-2 rounded-lg cursor-pointer transition-colors
                  <%= minPrice==='2000' && maxPrice==='5000' ? 'bg-primary/10 text-primary font-bold' : 'hover:bg-slate-100 dark:hover:bg-slate-800' %>">
      <span class="text-sm">₹2,000 – ₹5,000</span>
      <input type="radio" name="priceRange" value="2000-5000" class="sr-only"
             <%= minPrice==='2000' && maxPrice==='5000' ? 'checked' : '' %> onchange="setPrice('2000','5000')"/>
    </label>

    <label class="flex items-center justify-between px-3 py-2 rounded-lg cursor-pointer transition-colors
                  <%= minPrice==='5000' && !maxPrice ? 'bg-primary/10 text-primary font-bold' : 'hover:bg-slate-100 dark:hover:bg-slate-800' %>">
      <span class="text-sm">Above ₹5,000</span>
      <input type="radio" name="priceRange" value="5000-" class="sr-only"
             <%= minPrice==='5000' && !maxPrice ? 'checked' : '' %> onchange="setPrice('5000','')"/>
    </label>

  </div>
  <!-- hidden inputs that filterForm actually submits -->
  <input type="hidden" name="minPrice" id="minPriceInput" value="<%= minPrice %>"/>
  <input type="hidden" name="maxPrice" id="maxPriceInput" value="<%= maxPrice %>"/>
</div>

      <!-- Brand (toggle `if (false)` → `if (true)` if you have a brand field) -->
      <% if (false) { %>
      <div class="border-t border-slate-200 dark:border-slate-800 pt-6">
        <h3 class="text-base font-bold mb-3 flex items-center gap-2">
          <span class="material-symbols-outlined text-primary text-lg">verified</span>Brand
        </h3>
        <div class="flex flex-col gap-2">
          <% ['Luxe Originals','Heritage Wear','Modern Gent','Urban Stitch'].forEach(function(b){ %>
            <label class="flex items-center gap-3 cursor-pointer group">
              <input type="radio" name="brand" value="<%= b %>" class="w-4 h-4 text-primary focus:ring-primary"
                  
              <span class="text-sm font-medium text-slate-700 dark:text-slate-300
                           group-hover:text-primary transition-colors"><%= b %></span>
            </label>
          <% }) %>
          <label class="flex items-center gap-3 cursor-pointer group">
            <input type="radio" name="brand" value="" class="w-4 h-4 text-primary focus:ring-primary"
                   <%= !brandValue ? 'checked':'' %> onchange="submitFilter()"/>
            <span class="text-sm text-slate-500 group-hover:text-primary transition-colors">All brands</span>
          </label>
        </div>
      </div>
      <% } %>

    </aside>
    </form><!-- /filterForm -->

    <!-- ══ PRODUCT AREA ══ -->
    <div class="flex-1 min-w-0">

      <!-- Toolbar -->
      <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
        <div>
          <h1 class="text-2xl font-extrabold">
            <% if (searchValue) { %>Results for "<%= searchValue %>"
            <% } else { %>New Arrivals<% } %>
          </h1>
          <p class="text-slate-500 text-sm mt-0.5">
            <% if (totalProducts === 0) { %>
              No products found
            <% } else { %>
              Showing
              <%= (currentPage - 1) * productsPerPage + 1 %>–<%= Math.min(currentPage * productsPerPage, totalProducts) %>
              of <%= totalProducts %> products
            <% } %>
          </p>
        </div>

        <!-- Sort (carries all current filters) -->
        <form method="GET" action="" id="sortForm" class="flex items-center gap-2">
          <input type="hidden" name="search"   value="<%= searchValue %>"/>
          <input type="hidden" name="category" value="<%= categoryValue %>"/>
         
          <input type="hidden" name="minPrice" value="<%= minPrice %>"/>
          <input type="hidden" name="maxPrice" value="<%= maxPrice %>"/>
          <label class="text-sm text-slate-500 font-medium hidden sm:block">Sort</label>
          <select name="sort" onchange="document.getElementById('sortForm').submit()"
                  class="bg-slate-100 dark:bg-slate-800 border-none rounded-lg text-sm font-bold
                         py-2.5 px-4 focus:ring-2 focus:ring-primary outline-none cursor-pointer">
           
              <option value="">Sort By</option>
  <option value="lowToHigh" <%= sortValue === "lowToHigh" ? "selected" : "" %>>Price: Low to High</option>
  <option value="highToLow" <%= sortValue === "highToLow" ? "selected" : "" %>>Price: High to Low</option>
  <option value="az" <%= sortValue === "az" ? "selected" : "" %>>A - Z</option>
  <option value="za" <%= sortValue === "za" ? "selected" : "" %>>Z - A</option>

          </select>
        </form>
      </div>

      <!-- Error banner -->
      <% if (error) { %>
        <div class="mb-6 px-4 py-3 rounded-lg bg-red-50 dark:bg-red-900/20 border border-red-200
                    dark:border-red-800 text-red-600 dark:text-red-400 text-sm font-medium flex gap-2 items-center">
          <span class="material-symbols-outlined text-base">error</span><%= error %>
        </div>
      <% } %>

      <!-- ── Product Grid ── -->
      <% if (product && product.length > 0) { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-x-6 gap-y-10">
          <% product.forEach(function(p) { %>
            <div class="group flex flex-col gap-3">

              <!-- Image block -->
              <div class="relative aspect-[3/4] overflow-hidden rounded-xl bg-slate-100 dark:bg-slate-800">
                <% if (p.images && p.images.length > 0) { %>
                  <a href="/product-details/<%= p.productId._id %>?size=<%= p.size %>&color=<%= p.color %>">

                  <img src="/uploads/<%= p.images[0] %>"
                       alt="<%= p.productId ? p.productId.name : 'Product' %>"
                       class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                       onerror="this.src='https://placehold.co/400x533/1e293b/64748b?text=No+Image'"/>
                  </a>
                <% } else { %>
                  <div class="h-full w-full flex flex-col items-center justify-center text-slate-400 gap-2">
                    <span class="material-symbols-outlined text-5xl">image_not_supported</span>
                    <span class="text-xs">No image</span>
                  </div>
                <% } %>

                <!-- Wishlist button -->
                <button type="button"
                        class="absolute top-3 right-3 p-2 rounded-full bg-white/80 dark:bg-slate-900/80
                               backdrop-blur-sm text-slate-700 dark:text-white hover:text-red-500 transition-colors shadow">
                  <span class="material-symbols-outlined text-xl">favorite</span>
                </button>

                <!-- Slide-up cart button -->
                <div class="absolute inset-x-0 bottom-0 p-3 translate-y-full
                            group-hover:translate-y-0 transition-transform duration-300">
                 <a href="/cart"
   class="w-full bg-primary text-white py-3 rounded-lg font-bold text-sm
          flex items-center justify-center gap-2 shadow-xl shadow-primary/20
          hover:brightness-110 transition-all">
  <span class="material-symbols-outlined text-lg">shopping_cart</span>
  Add to Cart
</a>
                </div>
              </div>

              <!-- Product info -->
              <div>
                <h3 class="text-base font-bold leading-snug">
                  <%= p.productId ? p.productId.name : 'Unknown Product' %>
                </h3>
                <p class="text-slate-500 text-xs mt-0.5 capitalize flex items-center gap-2 flex-wrap">
                  <% if (p.size)  { %><span class="flex items-center gap-0.5"><span class="material-symbols-outlined text-xs">straighten</span><%= p.size %></span><% } %>
                  <% if (p.color) { %><span class="flex items-center gap-0.5"><span class="material-symbols-outlined text-xs">palette</span><%= p.color %></span><% } %>
                </p>
                <div class="mt-2 flex items-center gap-2 flex-wrap">
                  <%
                    const ep = (p.discount && p.discount < p.price) ? p.discount : p.price;
                    const fmt = (n) => Number(n).toLocaleString('en-IN');
                  %>
                  <span class="text-lg font-extrabold text-primary">₹<%= fmt(ep) %></span>
                  <% if (p.discount && p.discount < p.price) { %>
                    <span class="text-sm line-through text-slate-400">₹<%= fmt(p.price) %></span>
                    <span class="text-[10px] font-bold text-green-600 bg-green-50
                                 dark:bg-green-900/20 px-2 py-0.5 rounded-full">
                      <%= Math.round((p.price - p.discount) / p.price * 100) %>% OFF
                    </span>
                  <% } %>
                </div>
              </div>

            </div>
          <% }) %>
        </div>

      <% } else { %>
        <!-- Empty state -->
        <div class="flex flex-col items-center justify-center py-28 text-center">
          <span class="material-symbols-outlined text-7xl text-slate-300 dark:text-slate-700 mb-4">search_off</span>
          <h3 class="text-xl font-bold text-slate-600 dark:text-slate-400">No products found</h3>
          <p class="text-slate-400 mt-2 text-sm max-w-xs">
            Try a different search term, change the sort order, or clear your filters.
          </p>
          <a href="?"
             class="mt-6 px-6 py-2.5 bg-primary text-white text-sm font-bold rounded-lg
                    hover:brightness-110 transition-all inline-flex items-center gap-2">
            <span class="material-symbols-outlined text-base">filter_alt_off</span>Clear all filters
          </a>
        </div>
      <% } %>

      <!-- ══ PAGINATION ══ -->
      <% if (totalPages > 1) { %>
        <%
          const paginationBase = [
            searchValue   ? 'search='   + encodeURIComponent(searchValue) : '',
            sortValue     ? 'sort='     + sortValue                       : '',
            categoryValue ? 'category=' + categoryValue                   : '',
           
            minPrice      ? 'minPrice=' + minPrice                        : '',
            maxPrice      ? 'maxPrice=' + maxPrice                        : '',
          ].filter(Boolean).join('&');

          const pageLink = (n) => '?' + (paginationBase ? paginationBase + '&' : '') + 'page=' + n;
        %>

        <nav class="mt-14 flex justify-center items-center gap-2" aria-label="Pagination">

          <!-- Prev -->
          <% if (currentPage > 1) { %>
            <a href="<%= pageLink(currentPage - 1) %>"
               class="p-2.5 border border-slate-200 dark:border-slate-700 rounded-lg
                      hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
              <span class="material-symbols-outlined text-lg">chevron_left</span>
            </a>
          <% } else { %>
            <span class="p-2.5 border border-slate-100 dark:border-slate-800 rounded-lg opacity-30 cursor-not-allowed">
              <span class="material-symbols-outlined text-lg">chevron_left</span>
            </span>
          <% } %>

          <!-- Page number buttons -->
          <% paginationPages.forEach(function(pg) { %>
            <% if (pg === '…') { %>
              <span class="w-9 h-9 flex items-center justify-center text-slate-400 text-sm select-none">…</span>
            <% } else if (pg === currentPage) { %>
              <span class="w-9 h-9 flex items-center justify-center rounded-lg bg-primary text-white text-sm font-bold shadow shadow-primary/30">
                <%= pg %>
              </span>
            <% } else { %>
              <a href="<%= pageLink(pg) %>"
                 class="w-9 h-9 flex items-center justify-center rounded-lg text-sm font-bold
                        hover:bg-slate-100 dark:hover:bg-slate-800 border border-transparent
                        hover:border-slate-200 dark:hover:border-slate-700 transition-colors">
                <%= pg %>
              </a>
            <% } %>
          <% }) %>

          <!-- Next -->
          <% if (currentPage < totalPages) { %>
            <a href="<%= pageLink(currentPage + 1) %>"
               class="p-2.5 border border-slate-200 dark:border-slate-700 rounded-lg
                      hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
              <span class="material-symbols-outlined text-lg">chevron_right</span>
            </a>
          <% } else { %>
            <span class="p-2.5 border border-slate-100 dark:border-slate-800 rounded-lg opacity-30 cursor-not-allowed">
              <span class="material-symbols-outlined text-lg">chevron_right</span>
            </span>
          <% } %>

        </nav>

        <p class="text-center text-xs text-slate-400 mt-3 font-medium">
          Page <%= currentPage %> of <%= totalPages %>
        </p>
      <% } %>

    </div><!-- /product area -->
