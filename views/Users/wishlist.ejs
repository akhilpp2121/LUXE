<!DOCTYPE html>
<html class="dark" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>Wishlist | LUXE ATELIER</title>
  <script src="/js/blockedUserGuard.js"></script>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Syne:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap"
    rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            gold: "#c9a96e",
            "gold-light": "#e0c08a",
            "gold-dim": "#8a7550",
            navy: "#080c14",
            "navy-mid": "#0e1523",
            "navy-high": "#141c2e",
            "navy-bright": "#1a2338",
            "navy-border": "#1e2838",
            cream: "#e8edf8",
            "cream-dim": "#8892a4",
            "cream-mute": "#5a6478",
            ink: "#080c14",
          },
          fontFamily: {
            display: ["Cormorant Garamond", "Georgia", "serif"],
            body: ["DM Sans", "sans-serif"],
          },
        },
      },
    };
  </script>
  <style>
    :root {
      --bg: #080c14; --sur: #0e1523; --sur2: #141c2e; --sur3: #1a2338; --sur4: #212c42;
      --bord: rgba(255,255,255,0.07); --bord2: rgba(255,255,255,0.13);
      --pri: #3a6ff7; --gold: #c9a96e; --gold2: #e0c08a;
      --txt: #e8edf8; --txt2: #8892a4; --txt3: #5a6478;
      --nav-h: 68px; --side-w: 260px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: 'DM Sans', sans-serif;
    }

    .msym {
      font-family: 'Material Symbols Outlined';
      font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
    }

    body::after {
      content: '';
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background-image:
        radial-gradient(1px 1px at 18% 22%, rgba(201, 169, 110, 0.18) 0%, transparent 100%),
        radial-gradient(1px 1px at 72% 11%, rgba(201, 169, 110, 0.12) 0%, transparent 100%),
        radial-gradient(1px 1px at 44% 65%, rgba(201, 169, 110, 0.10) 0%, transparent 100%),
        radial-gradient(1px 1px at 91% 48%, rgba(201, 169, 110, 0.14) 0%, transparent 100%),
        radial-gradient(1px 1px at 6% 80%, rgba(201, 169, 110, 0.10) 0%, transparent 100%);
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
      opacity: 0.4;
    }

    .gold-line {
      height: 1px;
      background: linear-gradient(90deg, transparent, #c9a96e44, #c9a96e, #c9a96e44, transparent);
    }

    .product-card {
      transition: opacity 0.35s ease, transform 0.35s ease;
    }

    .product-card:hover .remove-trigger {
      opacity: 1;
    }

    .product-card:hover .card-img img {
      transform: scale(1.07);
    }

    .card-img img {
      transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .remove-trigger {
      opacity: 0;
      transition: opacity 0.25s ease;
    }

    .btn-gold {
      background: linear-gradient(120deg, #c9a96e 0%, #e0c08a 50%, #c9a96e 100%);
      background-size: 200% 100%;
      color: #04080f;
      font-family: 'DM Sans', sans-serif;
      font-size: 11px;
      letter-spacing: 0.2em;
      font-weight: 500;
      text-transform: uppercase;
      transition: background-position 0.4s ease, transform 0.15s ease;
      cursor: pointer;
    }

    .btn-gold:hover {
      background-position: 100% 0;
    }

    .btn-gold:active {
      transform: scale(0.98);
    }

    .btn-gold:disabled {
      opacity: 0.3;
      cursor: not-allowed;
    }

    @keyframes shine {
      0% {
        left: -60%;
      }

      100% {
        left: 160%;
      }
    }

    .shine-sweep {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .shine-sweep::after {
      content: '';
      position: absolute;
      top: 0;
      left: -60%;
      width: 50%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.28), transparent);
      transform: skewX(-20deg);
      animation: shine 2.8s infinite;
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(22px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .fu {
      animation: fadeUp 0.55s ease forwards;
      opacity: 0;
    }

    .d1 {
      animation-delay: 0.05s;
    }

    .d2 {
      animation-delay: 0.15s;
    }

    @keyframes pop {
      from {
        transform: scale(0);
        opacity: 0;
      }

      to {
        transform: scale(1);
        opacity: 1;
      }
    }

    ::-webkit-scrollbar {
      width: 4px;
    }

    ::-webkit-scrollbar-track {
      background: #080c14;
    }

    ::-webkit-scrollbar-thumb {
      background: #c9a96e33;
      border-radius: 4px;
    }

    /* ══ Variant modal ══ */
    #variant-modal {
      backdrop-filter: blur(14px);
    }

    @keyframes modalIn {
      from { opacity: 0; transform: scale(0.95) translateY(8px); }
      to   { opacity: 1; transform: scale(1) translateY(0); }
    }
    .animate-modal-in { animation: modalIn 0.2s cubic-bezier(0.16, 1, 0.3, 1); }

    .vm-chip {
      min-width: 44px;
      padding: 0 14px;
      height: 40px;
      border-radius: 4px;
      border: 1.5px solid #1e2838;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.05em;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.15s ease;
      background: #0e1523;
      color: #e8edf8;
      text-transform: uppercase;
    }
    .vm-chip:hover { border-color: #c9a96e; }
    .vm-chip.selected { border-color: #c9a96e; background: #c9a96e; color: #04080f; }
    .vm-chip.out-of-stock { opacity: 0.3; cursor: not-allowed; text-decoration: line-through; }
    .vm-chip.out-of-stock:hover { border-color: #1e2838; }

    .vm-color-swatch {
      width: 36px; height: 36px;
      border-radius: 50%;
      border: 2px solid transparent;
      cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: all 0.15s ease;
    }
    .vm-color-swatch.selected { border-color: #c9a96e; }
    .vm-color-swatch .swatch-inner { width: 28px; height: 28px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.15); }

    /* ══ NAV (matches profile / my-orders) ══ */
    nav.topnav {
      position: fixed; top: 0; left: 0; right: 0; height: var(--nav-h);
      background: rgba(8,12,20,0.9); backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--bord);
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 36px; z-index: 100;
    }
    .brand { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 1rem; letter-spacing: .22em; text-transform: uppercase; color: var(--txt); }
    .brand span { color: var(--gold); }
    .nav-links { display: flex; gap: 32px; list-style: none; }
    .nav-links a { font-family: 'Syne', sans-serif; font-size: .6rem; letter-spacing: .18em; text-transform: uppercase; color: var(--txt2); text-decoration: none; transition: color .2s; }
    .nav-links a:hover { color: var(--txt); }
    .nav-acts { display: flex; align-items: center; gap: 16px; }
    .nav-btn { background: none; border: none; cursor: pointer; color: var(--txt2); display: flex; align-items: center; text-decoration: none; position: relative; transition: color .2s; }
    .nav-btn:hover { color: var(--txt); } .nav-btn.on { color: var(--pri); }
    .nav-btn .ms { font-size: 22px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }
    .nav-badge { position: absolute; top: -6px; right: -8px; width: 17px; height: 17px; border-radius: 50%; background: var(--pri); color: #fff; font-size: .55rem; font-weight: 700; display: flex; align-items: center; justify-content: center; font-family: 'Syne', sans-serif; }

    /* ══ SIDEBAR (matches profile / my-orders) ══ */
    aside.sidebar {
      position: fixed; top: var(--nav-h); left: 0;
      width: var(--side-w); height: calc(100vh - var(--nav-h));
      background: var(--sur); border-right: 1px solid var(--bord);
      display: flex; flex-direction: column; padding: 28px 0 20px; z-index: 50; overflow-y: auto;
    }
    .sidebar-header { padding: 0 24px 24px; border-bottom: 1px solid var(--bord); margin-bottom: 12px; }
    .sidebar-header h3 { font-family: 'Syne', sans-serif; font-weight: 700; font-size: .9rem; margin-bottom: 6px; color: var(--txt); }
    .sidebar-tier { display: inline-flex; align-items: center; gap: 5px; background: rgba(201,169,110,.1); border: 1px solid rgba(201,169,110,.25); border-radius: 99px; padding: 3px 10px; }
    .sidebar-tier span { font-family: 'Syne', sans-serif; font-size: .5rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--gold); }
    .tier-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--gold); flex-shrink: 0; }
    .sidebar-nav { display: flex; flex-direction: column; gap: 2px; padding: 0 10px; }
    .sidebar-link {
      display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 8px;
      text-decoration: none; color: var(--txt2); font-size: .625rem; font-family: 'Syne', sans-serif;
      font-weight: 600; letter-spacing: .1em; text-transform: uppercase; transition: all .2s;
    }
    .sidebar-link .material-symbols-outlined { font-size: 17px; flex-shrink: 0; font-variation-settings: 'FILL' 0, 'wght' 300; }
    .sidebar-link:hover { background: var(--sur3); color: var(--txt); }
    .sidebar-link.active { background: rgba(58,111,247,.12); color: var(--pri); }
    .sidebar-footer { margin-top: auto; padding: 18px 24px 0; border-top: 1px solid var(--bord); }
    .sidebar-footer a { display: flex; align-items: center; gap: 9px; text-decoration: none; color: var(--txt3); font-size: .625rem; font-family: 'Syne', sans-serif; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; transition: color .2s; }
    .sidebar-footer a:hover { color: var(--txt2); }
    .sidebar-footer .material-symbols-outlined { font-size: 17px; font-variation-settings: 'FILL' 0, 'wght' 300; }

    /* ══ MAIN offset for fixed nav + sidebar ══ */
    .acct-main { margin-left: var(--side-w); padding-top: var(--nav-h); position: relative; z-index: 10; }

    @media (max-width: 900px) {
      :root { --side-w: 0px; }
      aside.sidebar { display: none; }
      .nav-links { display: none; }
    }
  </style>
  <link rel="stylesheet" href="/css/navigation-consistency.css" />
</head>

<body class="bg-navy text-cream min-h-screen relative">

  <!-- ══ NAV ══ -->
  <nav class="topnav">
    <div class="brand">LUXE <span>ATELIER</span></div>
    <ul class="nav-links">
      <li><a href="/">Showroom</a></li>
      <li><a href="/product-listing">Collections</a></li>
    </ul>
    <div class="nav-acts">
      <a href="/product-listing" class="nav-btn">
        <span class="ms material-symbols-outlined msym">search</span>
      </a>
      <a href="/cart" class="nav-btn">
        <span class="ms material-symbols-outlined msym" style="font-variation-settings:'FILL' 1,'wght' 300">shopping_bag</span>
        <% if (cart > 0) { %>
          <span id="cart-badge" class="nav-badge"><%= cart %></span>
          <% } else { %>
            <span id="cart-badge" class="nav-badge" style="display:none;">0</span>
            <% } %>
      </a>
      <a href="/profile" class="nav-btn"><span class="ms material-symbols-outlined msym">person</span></a>
    </div>
  </nav>

  <!-- ══ SIDEBAR ══ -->
  <aside class="sidebar">
    <div class="sidebar-header">
      <h3>User Account</h3>
      <div class="sidebar-tier">
        <div class="tier-dot"></div>
      </div>
    </div>
    <nav class="sidebar-nav">
      <a href="/profile" class="sidebar-link">
        <span class="material-symbols-outlined">person</span>
        <span>Profile</span>
      </a>
      <a href="/order/my-orders" class="sidebar-link">
        <span class="material-symbols-outlined">package_2</span>
        <span>My Orders</span>
      </a>
      <a href="/address" class="sidebar-link">
        <span class="material-symbols-outlined">distance</span>
        <span>Manage Address</span>
      </a>
      <a href="/changePassword" class="sidebar-link">
        <span class="material-symbols-outlined">lock_reset</span>
        <span>Change Password</span>
      </a>
      <a href="/wishlist" class="sidebar-link active">
        <span class="material-symbols-outlined">favorite</span>
        <span>Wishlist</span>
      </a>
      <a href="/referal" class="sidebar-link">
        <span class="material-symbols-outlined">share_reviews</span>
        <span>Referral Link</span>
      </a>
      <a href="/wallet" class="sidebar-link">
        <span class="material-symbols-outlined">account_balance_wallet</span>
        <span>Wallet</span>
      </a>
    </nav>
    <div class="sidebar-footer">
      <a href="/logout">
        <span class="material-symbols-outlined">logout</span>
        <span>Sign Out</span>
      </a>
    </div>
  </aside>

  <!-- ══ MAIN ══ -->
  <div class="acct-main">
  <main class="relative z-10 max-w-7xl mx-auto px-6 lg:px-20 pb-32 pt-16">

    <!-- Hero -->
    <header class="mb-20 fu d1">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div>
          <p class="text-gold text-[9px] uppercase tracking-[0.35em] font-body mb-3">Your Collection</p>
          <h1 class="font-display text-6xl md:text-8xl text-cream font-light italic leading-none">Wishlist</h1>
          <div class="flex items-center gap-4 mt-5">
            <div class="gold-line w-12"></div>
            <span class="text-cream-mute text-[9px] uppercase tracking-[0.28em] font-body" id="item-counter">

            </span>
          </div>
        </div>


      </div>
    </header>




    <!-- ── EMPTY STATE ── -->
    <% if (wishlist.length===0) { %>
      <div class="flex flex-col items-center justify-center py-32 text-center fu d2">
        <div class="w-20 h-20 rounded-full border border-navy-border flex items-center justify-center mb-8">
          <span class="msym text-[36px] text-gold-dim">favorite_border</span>
        </div>
        <p class="font-display text-4xl text-cream font-light italic mb-3">Nothing saved yet</p>
        <p class="text-cream-mute text-sm font-body mb-10 max-w-xs leading-relaxed">Explore our curated collections and
          save the pieces that speak to you.</p>
        <a href="/product-listing"
          class="text-gold border-b border-gold-dim pb-1 text-[9px] uppercase tracking-[0.28em] font-body hover:text-gold-light transition-colors">
          Explore Collections
        </a>
      </div>

      <% } else { %>

        <!-- ── PRODUCT GRID ── -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-5 gap-y-10" id="wishlist-grid">

          <% wishlist.forEach(function(o, index) { const variant=o.variantId; const product=variant?.productId; if
            (!variant || !product) return; const inStock=(variant?.stock ?? 0)> 0 &&
            variant?.isActive &&
            product?.isActive &&
            product?.categoryId?.isActive;

            const variantId = variant._id?._id || variant._id;
            const productId = product._id?._id || product._id;

            const rawImg = variant?.images?.[0];
            const image = rawImg ? '/uploads/' + rawImg : '/images/placeholder.jpg';

            const itemPrice = (variant?.discount && variant.discount < variant?.price) ? variant.discount :
              (variant?.price || 0); const name=product.name; const size=variant.size; const color=variant.color; const
              price=itemPrice; %>

              <div class="product-card group relative fu" style="animation-delay:<%= 0.08 + index * 0.07 %>s;"
                data-id="<%= o._id %>">

                <!-- Remove button -->
                <button
                  class="remove-trigger absolute top-3 right-3 z-10 w-8 h-8 flex items-center justify-center bg-ink/70 border border-navy-border hover:border-gold hover:text-gold text-cream-mute rounded-full transition-all duration-200"
                  onclick="removeFromWishlist('<%= o._id %>', this)" title="Remove from wishlist">
                  <span class="msym text-[13px]">close</span>
                </button>

                <!-- Image -->
                <div class="card-img aspect-[2/3] overflow-hidden bg-navy-mid mb-3 relative border border-navy-border">
                  <img src="<%= image %>" alt="<%= name %>" class="w-full h-full object-cover"
                    onerror="this.src='/images/placeholder.jpg'" />

                  <!-- Gold corner brackets -->
                  <span
                    class="absolute top-0 left-0 w-4 h-4 border-t border-l border-gold opacity-50 pointer-events-none"></span>
                  <span
                    class="absolute top-0 right-0 w-4 h-4 border-t border-r border-gold opacity-50 pointer-events-none"></span>
                  <span
                    class="absolute bottom-0 left-0 w-4 h-4 border-b border-l border-gold opacity-50 pointer-events-none"></span>
                  <span
                    class="absolute bottom-0 right-0 w-4 h-4 border-b border-r border-gold opacity-50 pointer-events-none"></span>

                  <% if (!inStock) { %>
                    <div class="absolute inset-0 bg-navy/70 flex items-center justify-center">
                      <span
                        class="text-cream-mute text-[9px] uppercase tracking-[0.22em] border border-cream-mute/30 px-3 py-1 font-body">Unavailable</span>
                    </div>
                    <% } %>
                </div>

                <!-- Info -->
                <div>
                  <div class="flex justify-between items-start mb-1">
                    <h3
                      class="font-display text-[14px] text-cream tracking-[0.15em] font-light leading-tight truncate mb-1">
                      <%= name %>
                    </h3>
                    <% if (price) { %>
                      <span class="font-display text-[13px] text-gold tracking-[0.12em] font-light">₹<%=
                          price.toLocaleString('en-IN') %></span>
                      <% } %>
                  </div>
                  <p class="text-cream-mute text-[9px] uppercase tracking-[0.22em] font-body mb-0.5">
                    <%= color %>
                  </p>
                  <p class="text-cream-mute text-[9px] uppercase tracking-[0.18em] font-body mb-5">Size &nbsp;<%= size
                      %>
                  </p>
                  <% if (inStock) { %>
                    <button
                      type="button"
                      onclick="openVariantModal('<%= productId %>', { image: '<%= image %>', name: '<%= name %>', wishlistId: '<%= o._id %>', cardEl: this.closest('.product-card') })"
                      class="btn-gold relative w-full py-3 overflow-hidden border-0"
                    >
                      <span class="shine-sweep"></span>
                      move to cart
                    </button>
                    <% } else { %>
                      <div
                        class="w-full py-3 text-center text-[9px] uppercase tracking-[0.2em] text-cream-mute border border-navy-border cursor-not-allowed font-body">
                        Currently Unavailable
                      </div>
                      <% } %>


                </div>
              </div>

              <% }); %>
        </div>
        <% } %>

          <% if (query?.success || query?.error) { %>
            <div id="flash-toast" class="fixed top-6 right-6 z-50 px-5 py-3 border text-[10px] uppercase tracking-[0.2em] font-body transition-all duration-500 opacity-100
    <%= query.success ? 'border-gold/30 bg-navy-mid text-gold' : 'border-red-500/30 bg-navy-mid text-red-400' %>">
              <%= query.success || query.error %>
            </div>

            <script>
              setTimeout(() => {
                const toast = document.getElementById('flash-toast');
                if (toast) {
                  toast.style.opacity = '0';
                  toast.style.transform = 'translateY(-10px)';
                  setTimeout(() => toast.remove(), 500);
                }
              }, 2000);  
            </script>
            <% } %>




  </main>

  <!-- ✅ Pagination -->
  <% if (totalPage> 1) { %>
    <div class="px-8 py-6 flex items-center justify-between max-w-7xl mx-auto">

      <!-- Previous -->
      <% if (currentPage> 1) { %>
        <a href="/wishlist?page=<%= currentPage - 1 %>">
          <button
            class="px-4 py-2 text-xs font-bold text-cream-mute hover:text-gold transition-colors flex items-center gap-2">
            <span class="msym text-sm">chevron_left</span>Previous
          </button>
        </a>
        <% } else { %>
          <button disabled
            class="px-4 py-2 text-xs font-bold text-cream-mute/30 flex items-center gap-2 cursor-not-allowed">
            <span class="msym text-sm">chevron_left</span>Previous
          </button>
          <% } %>

            <!-- Page Numbers -->
            <div class="flex items-center gap-2">
              <% for (let i=1; i <=totalPage; i++) { %>
                <a href="/wishlist?page=<%= i %>">
                  <button
                    class="w-8 h-8 rounded-lg text-xs font-bold <%= currentPage == i ? 'btn-gold' : 'text-cream-mute hover:text-gold border border-navy-border' %>">
                    <%= i %>
                  </button>
                </a>
                <% } %>
            </div>

            <!-- Next -->
            <% if (currentPage < totalPage) { %>
              <a href="/wishlist?page=<%= currentPage + 1 %>">
                <button
                  class="px-4 py-2 text-xs font-bold text-cream-mute hover:text-gold transition-colors flex items-center gap-2">
                  Next<span class="msym text-sm">chevron_right</span>
                </button>
              </a>
              <% } else { %>
                <button disabled
                  class="px-4 py-2 text-xs font-bold text-cream-mute/30 flex items-center gap-2 cursor-not-allowed">
                  Next<span class="msym text-sm">chevron_right</span>
                </button>
                <% } %>

    </div>
    <% } %>
  </div>

  <!-- ══ VARIANT SELECT MODAL ══ -->
  <div id="variant-modal" class="fixed inset-0 bg-ink/85 hidden items-center justify-center z-[999] p-4">
    <div class="bg-navy-mid border border-navy-border w-full max-w-sm relative animate-modal-in">

      <!-- Corner accents -->
      <span class="absolute top-0 left-0 w-5 h-5 border-t border-l border-gold pointer-events-none"></span>
      <span class="absolute top-0 right-0 w-5 h-5 border-t border-r border-gold pointer-events-none"></span>
      <span class="absolute bottom-0 left-0 w-5 h-5 border-b border-l border-gold pointer-events-none"></span>
      <span class="absolute bottom-0 right-0 w-5 h-5 border-b border-r border-gold pointer-events-none"></span>

      <button onclick="closeVariantModal()" class="absolute top-4 right-4 z-10 text-cream-mute hover:text-gold transition-colors">
        <span class="msym text-[18px]">close</span>
      </button>

      <!-- Product preview -->
      <div class="flex gap-4 p-6 border-b border-navy-border">
        <div class="w-20 h-24 overflow-hidden bg-navy-high shrink-0 border border-navy-border">
          <img id="vm-image" src="" alt="" class="w-full h-full object-cover" />
        </div>
        <div class="min-w-0 flex flex-col justify-center">
          <h3 id="vm-name" class="font-display text-lg text-cream font-light italic leading-snug truncate"></h3>
          <div class="flex items-center gap-2 mt-1.5">
            <span id="vm-price" class="font-display text-gold text-lg font-light"></span>
            <span id="vm-original-price" class="text-xs line-through text-cream-mute"></span>
          </div>
        </div>
      </div>

      <div class="p-6">

        <!-- Loading skeleton -->
        <div id="vm-loading" class="flex flex-col gap-3">
          <div class="h-3 w-16 bg-navy-high rounded animate-pulse"></div>
          <div class="flex gap-2">
            <div class="h-10 w-14 bg-navy-high rounded animate-pulse"></div>
            <div class="h-10 w-14 bg-navy-high rounded animate-pulse"></div>
            <div class="h-10 w-14 bg-navy-high rounded animate-pulse"></div>
          </div>
        </div>

        <!-- Content -->
        <div id="vm-content" class="hidden">

          <!-- Color -->
          <div id="vm-color-block" class="mb-5 hidden">
            <div class="flex items-center justify-between mb-2.5">
              <label class="text-gold text-[9px] uppercase tracking-[0.28em] font-body">Color</label>
              <span id="vm-selected-color" class="text-[9px] uppercase tracking-[0.2em] text-cream-mute font-body"></span>
            </div>
            <div id="vm-color-options" class="flex flex-wrap gap-2"></div>
          </div>

          <!-- Size -->
          <div class="mb-2">
            <label class="text-gold text-[9px] uppercase tracking-[0.28em] font-body mb-2.5 block">Size</label>
            <div id="vm-size-options" class="flex flex-wrap gap-2"></div>
            <p id="vm-error" class="text-xs text-red-400 font-body mt-2 hidden items-center gap-1">
              <span class="msym" style="font-size:14px">error</span>
              Please select a size to continue
            </p>
          </div>

          <p id="vm-stock-note" class="text-xs font-body mt-3 hidden text-amber-400"></p>
        </div>

        <!-- Empty state -->
        <div id="vm-empty" class="hidden text-center py-6">
          <span class="msym text-[36px] text-gold-dim mb-2 block">inventory_2</span>
          <p class="text-cream-mute text-sm font-body">Currently out of stock</p>
        </div>

        <!-- CTA -->
        <button id="vm-confirm-btn" onclick="confirmVariantAddToCart()" disabled
          class="btn-gold relative w-full py-4 overflow-hidden border-0 mt-5 disabled:opacity-30 disabled:cursor-not-allowed">
          <span class="shine-sweep"></span>
          <span id="vm-confirm-text">Select a Size</span>
        </button>

      </div>
    </div>
  </div>

<script>

  // ── Remove from wishlist ───────────────────────────
  async function removeFromWishlist(wishlistItemId, btn) {
    try {
      const res = await fetch('/wishlist/remove', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: wishlistItemId })
      });
      const result = await res.json();

      if (!result.success) {
        return Swal.fire({
          toast: true, icon: 'error', title: result.message,
          position: 'top-right', showConfirmButton: false, timer: 3000
        });
      }

      Swal.fire({
        toast: true, icon: 'success', title: result.message,
        position: 'top-right', showConfirmButton: false, timer: 3000
      });

      const card = btn.closest('.product-card');
      card.style.opacity = '0';
      card.style.transform = 'translateY(20px)';
      setTimeout(() => { card.remove(); updateCounter(); }, 350);

    } catch (e) {
      console.error('removeFromWishlist error:', e);
    }
  }

  // ── Counter & empty state ─────────────────────────────
  function updateCounter() {
    const count = document.querySelectorAll('.product-card').length;
    const counter = document.getElementById('item-counter');
    if (counter) counter.textContent = count.toString().padStart(2, '0') + ' pieces saved';

    if (count === 0) {
      document.getElementById('wishlist-grid')?.remove();
      const main = document.querySelector('main');
      if (main && !document.getElementById('empty-state')) {
        const empty = document.createElement('div');
        empty.id = 'empty-state';
        empty.className = 'flex flex-col items-center justify-center py-32 text-center';
        empty.innerHTML = `
        <div class="w-20 h-20 rounded-full border border-navy-border flex items-center justify-center mb-8">
          <span class="msym text-[36px] text-gold-dim">favorite_border</span>
        </div>
        <p class="font-display text-4xl text-cream font-light italic mb-3">Nothing saved yet</p>
        <p class="text-cream-mute text-sm font-body mb-10 max-w-xs leading-relaxed">
          Explore our curated collections and save the pieces that speak to you.
        </p>
        <a href="/product-listing" class="text-gold border-b border-gold-dim pb-1 text-[9px] uppercase tracking-[0.28em] font-body hover:text-gold-light transition-colors">
          Explore Collections
        </a>`;
        main.appendChild(empty);
      }
    }
  }

  // ── Cart badge ────────────────────────────────────────
  function updateCartBadge() {
    const badge = document.getElementById('cart-badge');
    if (!badge) return;
    const current = parseInt(badge.textContent) || 0;
    badge.textContent = current + 1;
    badge.style.display = 'flex';
  }

  /* ── Variant selection modal ── */
  let vmState = { variants: [], selectedColor: null, selectedVariant: null, productId: null, wishlistId: null, cardEl: null };

  async function openVariantModal(productId, meta = {}) {
    vmState = { variants: [], selectedColor: null, selectedVariant: null, productId, wishlistId: meta.wishlistId || null, cardEl: meta.cardEl || null };

    document.getElementById('vm-image').src = meta.image || '';
    document.getElementById('vm-name').textContent = meta.name || '';
    document.getElementById('vm-loading').classList.remove('hidden');
    document.getElementById('vm-content').classList.add('hidden');
    document.getElementById('vm-empty').classList.add('hidden');
    document.getElementById('vm-error').classList.add('hidden');
    document.getElementById('vm-stock-note').classList.add('hidden');
    document.getElementById('vm-confirm-btn').disabled = true;
    document.getElementById('vm-confirm-text').textContent = 'Select a Size';

    const modal = document.getElementById('variant-modal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');

    try {
      const res = await fetch(`/product/${productId}/variants`);
      const data = await res.json();
      document.getElementById('vm-loading').classList.add('hidden');

      if (!data.success || !data.variants.length) {
        document.getElementById('vm-empty').classList.remove('hidden');
        return;
      }

      vmState.variants = data.variants;
      document.getElementById('vm-content').classList.remove('hidden');
      renderColors();
    } catch (e) {
      console.error('openVariantModal error:', e);
      document.getElementById('vm-loading').classList.add('hidden');
      document.getElementById('vm-empty').classList.remove('hidden');
    }
  }

  function renderColors() {
    const colors = [...new Set(vmState.variants.map(v => v.color))];
    const block = document.getElementById('vm-color-block');
    const wrap = document.getElementById('vm-color-options');
    wrap.innerHTML = '';

    if (colors.length <= 1) {
      block.classList.add('hidden');
      vmState.selectedColor = colors[0] || null;
      renderSizes();
      return;
    }

    block.classList.remove('hidden');
    vmState.selectedColor = colors[0];
    document.getElementById('vm-selected-color').textContent = vmState.selectedColor;

    colors.forEach(color => {
      const swatch = document.createElement('button');
      swatch.type = 'button';
      swatch.className = 'vm-color-swatch' + (color === vmState.selectedColor ? ' selected' : '');
      swatch.title = color;
      swatch.innerHTML = `<span class="swatch-inner" style="background:${cssColor(color)}"></span>`;
      swatch.onclick = () => {
        vmState.selectedColor = color;
        document.getElementById('vm-selected-color').textContent = color;
        [...wrap.children].forEach(c => c.classList.remove('selected'));
        swatch.classList.add('selected');
        renderSizes();
      };
      wrap.appendChild(swatch);
    });

    renderSizes();
  }

  function cssColor(name) {
    const s = new Option().style;
    s.color = name.toLowerCase();
    return s.color ? name.toLowerCase() : '#cbd5e1';
  }

  function renderSizes() {
    const wrap = document.getElementById('vm-size-options');
    wrap.innerHTML = '';
    vmState.selectedVariant = null;
    updateConfirmState();

    const sizeVariants = vmState.variants.filter(v => v.color === vmState.selectedColor);

    sizeVariants.forEach(v => {
      const chip = document.createElement('button');
      chip.type = 'button';
      const isOOS = v.stock <= 0;
      chip.className = 'vm-chip' + (isOOS ? ' out-of-stock' : '');
      chip.textContent = v.size;
      chip.disabled = isOOS;
      chip.onclick = () => {
        [...wrap.children].forEach(c => c.classList.remove('selected'));
        chip.classList.add('selected');
        vmState.selectedVariant = v;
        updatePriceDisplay(v);
        document.getElementById('vm-error').classList.add('hidden');

        const note = document.getElementById('vm-stock-note');
        if (v.stock <= 5) {
          note.textContent = `Only ${v.stock} left in stock`;
          note.classList.remove('hidden');
        } else {
          note.classList.add('hidden');
        }
        updateConfirmState();
      };
      wrap.appendChild(chip);
    });

    const firstAvailable = sizeVariants.find(v => v.stock > 0) || sizeVariants[0];
    if (firstAvailable) updatePriceDisplay(firstAvailable);
  }

  function updatePriceDisplay(v) {
    const price = (v.discount && v.discount < v.price) ? v.discount : v.price;
    document.getElementById('vm-price').textContent = '₹' + price.toLocaleString('en-IN');
    const origEl = document.getElementById('vm-original-price');
    if (v.discount && v.discount < v.price) {
      origEl.textContent = '₹' + v.price.toLocaleString('en-IN');
    } else {
      origEl.textContent = '';
    }
  }

  function updateConfirmState() {
    const btn = document.getElementById('vm-confirm-btn');
    const text = document.getElementById('vm-confirm-text');
    if (vmState.selectedVariant) {
      btn.disabled = false;
      text.textContent = 'Move to Bag';
    } else {
      btn.disabled = true;
      text.textContent = 'Select a Size';
    }
  }

  function closeVariantModal() {
    const modal = document.getElementById('variant-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  async function confirmVariantAddToCart() {
    if (!vmState.selectedVariant) {
      const err = document.getElementById('vm-error');
      err.classList.remove('hidden');
      err.classList.add('flex');
      return;
    }

    const btn = document.getElementById('vm-confirm-btn');
    const text = document.getElementById('vm-confirm-text');
    btn.disabled = true;
    text.textContent = 'Moving…';

    try {
      const res = await fetch('/cart/add-cart', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ variantId: vmState.selectedVariant._id, qty: 1 })
      });
      const result = await res.json();

      if (!result.success) {
        btn.disabled = false;
        text.textContent = 'Move to Bag';
        return Swal.fire({ toast: true, icon: 'error', title: result.message, position: 'top-right', showConfirmButton: false, timer: 3000 });
      }

      // Remove from wishlist since this modal is always opened from a wishlist card
      if (vmState.wishlistId) {
        await fetch('/wishlist/remove', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: vmState.wishlistId })
        });
        if (vmState.cardEl) {
          vmState.cardEl.style.opacity = '0';
          vmState.cardEl.style.transform = 'translateY(20px)';
          setTimeout(() => {
            vmState.cardEl.remove();
            updateCounter();
          }, 350);
        }
      }

      updateCartBadge();

      Swal.fire({ toast: true, icon: 'success', title: result.message, position: 'top-right', showConfirmButton: false, timer: 3000 });
      closeVariantModal();

    } catch (e) {
      console.error('confirmVariantAddToCart error:', e);
      btn.disabled = false;
      text.textContent = 'Move to Bag';
      Swal.fire({ toast: true, icon: 'error', title: 'Something went wrong', position: 'top-right', showConfirmButton: false, timer: 3000 });
    }
  }

  document.getElementById('variant-modal')?.addEventListener('click', e => {
    if (e.target.id === 'variant-modal') closeVariantModal();
  });

</script>

</body>

</html>
