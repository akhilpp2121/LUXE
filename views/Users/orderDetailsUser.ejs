<script>
  const SHIPPING_THRESHOLD = 999;
  const SHIPPING_FEE       = 99;
  const COUPON             = <%= ord.couponApplied || 0 %>;

  /* ── Grand total live recalc ── */
  function recalcTotal() {
    let sub = 0;
    document.querySelectorAll('#itemList .item-row').forEach(function(row) {
      if (row.dataset.cancelled !== 'true') sub += parseFloat(row.dataset.price || 0);
    });
    const shipping   = sub >= SHIPPING_THRESHOLD ? 0 : SHIPPING_FEE;
    const total      = +(sub + shipping - COUPON).toFixed(2);
    const subEl      = document.getElementById('displaySubtotal');
    const totalEl    = document.getElementById('displayTotal');
    const shippingEl = document.getElementById('displayShipping');
    if (subEl) subEl.textContent = '₹' + sub.toFixed(2);
    if (shippingEl) {
      shippingEl.className   = shipping === 0 ? 'text-primary font-bold' : 'text-white font-medium';
      shippingEl.textContent = shipping === 0 ? 'FREE' : '₹' + shipping.toFixed(2);
    }
    if (totalEl) {
      totalEl.textContent = '₹' + total.toFixed(2);
      totalEl.classList.remove('total-flash');
      void totalEl.offsetWidth;
      totalEl.classList.add('total-flash');
    }
  }

  /* ── Mark single item cancelled in the DOM ── */
  function markItemCancelled(variantId, statusLabel) {
    const row = document.getElementById('item-row-' + variantId);
    if (!row) return;
    row.dataset.cancelled = 'true';
    row.classList.add('cancelling', 'is-cancelled');
    setTimeout(function() { row.style.opacity = '0.38'; }, 400);
    const priceEl = row.querySelector('.font-headline.font-black');
    if (priceEl) {
      priceEl.classList.add('line-through', 'text-on-surface-variant');
      priceEl.classList.remove('text-white');
    }
    const btnWrap = document.getElementById('cancel-btn-wrap-' + variantId);
    if (btnWrap) {
      btnWrap.innerHTML =
        '<span class="inline-flex items-center gap-1 px-2 py-1 bg-error/10 border border-error/20 text-error text-[9px] uppercase tracking-widest rounded font-bold">' +
        '<span class="material-symbols-outlined text-xs">block</span>' + (statusLabel || 'Cancelled') + '</span>';
    }
    const nameEl = row.querySelector('h3');
    if (nameEl && !nameEl.querySelector('.cancelled-tag')) {
      const tag = document.createElement('span');
      tag.className = 'cancelled-tag ml-2 inline-flex items-center gap-1 px-2 py-0.5 bg-error/10 border border-error/20 text-error text-[9px] uppercase tracking-widest rounded font-bold';
      tag.innerHTML = '<span class="material-symbols-outlined text-xs">block</span>' + (statusLabel || 'Cancelled');
      nameEl.appendChild(tag);
    }
    recalcTotal();
  }

  /* ── Mark all items cancelled in the DOM ── */
  function markAllCancelled() {
    document.querySelectorAll('#itemList .item-row').forEach(function(row) {
      const vid = row.id.replace('item-row-', '');
      if (row.dataset.cancelled !== 'true') markItemCancelled(vid, 'Cancelled');
    });
  }

  /* ── Mark single item returned in the DOM ── */
  function markItemReturned(variantId) {
    const btnWrap = document.getElementById('cancel-btn-wrap-' + variantId);
    if (btnWrap) {
      const returnBtn = btnWrap.querySelector('button[data-return-btn]');
      if (returnBtn) returnBtn.remove();
      const badge = document.createElement('span');
      badge.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-primary/5 border border-primary/20 text-primary text-[9px] uppercase tracking-widest font-bold';
      badge.innerHTML = '<span class="material-symbols-outlined text-xs">undo</span>Return Pending';
      btnWrap.appendChild(badge);
    }
    const nameEl = document.querySelector('#item-row-' + variantId + ' h3');
    if (nameEl && !nameEl.querySelector('.returned-tag')) {
      const tag = document.createElement('span');
      tag.className = 'returned-tag ml-2 inline-flex items-center gap-1 px-2 py-0.5 bg-primary/10 border border-primary/20 text-primary text-[9px] uppercase tracking-widest rounded font-bold';
      tag.innerHTML = '<span class="material-symbols-outlined text-xs">undo</span>Return Pending';
      nameEl.appendChild(tag);
    }
  }

  /* ── Cancel modal ── */
  function openCancelModal(id, orderId) {
    document.getElementById('variantId').value = id;
    document.getElementById('orderId').value   = orderId;
    document.getElementById('cancelModal').classList.add('active');
    document.body.style.overflow = 'hidden';
  }
  function closeCancelModal() {
    document.getElementById('cancelModal').classList.remove('active');
    document.getElementById('reason').value = '';
    document.getElementById('remark').value = '';
    document.body.style.overflow = '';
  }

  /* ── Cancel All modal ── */
  function openCancelALLModal(id, orderId) {
    document.getElementById('variantIdAll').value = id;
    document.getElementById('orderIdAll').value   = orderId;
    document.getElementById('cancelAllModal').classList.add('active');
    document.body.style.overflow = 'hidden';
  }
  function closeCancelALLModal() {
    document.getElementById('cancelAllModal').classList.remove('active');
    document.getElementById('reasonAll').value = '';
    document.getElementById('remarkAll').value = '';
    document.body.style.overflow = '';
  }

  /* ── Return modal ── */
  function openReturnModal(orderId, variantId, productName, maxQty) {
    document.getElementById('returnOrderId').value    = orderId;
    document.getElementById('returnVariantId').value  = variantId;
    document.getElementById('returnReason').value     = '';
    document.getElementById('returnRemark').value     = '';
    document.getElementById('returnResolution').value = '';

    document.getElementById('returnItemChip').style.display    = 'flex';
    document.getElementById('returnModalSubtitle').textContent = productName;
    document.getElementById('returnItemName').textContent      = productName;
    document.getElementById('returnItemMeta').textContent      = 'Max returnable: ' + maxQty;
    document.getElementById('returnQtyMax').textContent        = maxQty;

    const qtyInput = document.getElementById('returnQty');
    qtyInput.value = 1;
    qtyInput.max   = maxQty;

    document.getElementById('qtyMinus').disabled = true;
    document.getElementById('qtyPlus').disabled  = maxQty <= 1;

    document.getElementById('returnModal').classList.add('active');
    document.body.style.overflow = 'hidden';
  }
  function closeReturnModal() {
    document.getElementById('returnModal').classList.remove('active');
    document.getElementById('returnItemChip').style.display = 'none';
    document.body.style.overflow = '';
  }

  /* ── Qty spinner ── */
  function adjustQty(delta) {
    const input   = document.getElementById('returnQty');
    const max     = parseInt(input.max, 10);
    let   current = parseInt(input.value, 10);
    current = Math.min(max, Math.max(1, current + delta));
    input.value = current;
    document.getElementById('qtyMinus').disabled = current <= 1;
    document.getElementById('qtyPlus').disabled  = current >= max;
  }

  /* ── Backdrop click to close ── */
  ['cancelModal', 'cancelAllModal', 'returnModal'].forEach(function(id) {
    document.getElementById(id).addEventListener('click', function(e) {
      if (e.target === this) {
        this.classList.remove('active');
        document.body.style.overflow = '';
      }
    });
  });

  /* ── Toast helper ── */
  function toast(icon, title) {
    Swal.fire({ toast: true, icon, title, position: 'top-right', showConfirmButton: false, timer: 3000, background: '#131b2e', color: '#dae2fd' });
  }

  /* ── POST helper ── */
  async function postJSON(url, body) {
    const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    return res.json();
  }

  function setLoading(btn, loading) {
    btn.disabled = loading;
    btn.style.opacity = loading ? '0.5' : '';
  }

  /* ── Cancel single item ── */
  document.getElementById('cancelbtn').addEventListener('click', async function() {
    const reason  = document.getElementById('reason').value;
    const remark  = document.getElementById('remark').value;
    const id      = document.getElementById('variantId').value;
    const orderId = document.getElementById('orderId').value;
    if (!reason)       return toast('error', 'Select a reason');
    if (!remark.trim()) return toast('error', 'Write a remark');
    setLoading(this, true);
    try {
      const result = await postJSON('/order/cancel-order', { id, reason, remark, orderId });
      if (!result.success) { setLoading(this, false); return toast('error', result.message || 'Something went wrong'); }
      markItemCancelled(id, result.pendingApproval ? 'Pending' : 'Cancelled');
      closeCancelModal();
      Swal.fire({ icon: 'success', title: result.message || 'Item cancelled', timer: 1500, showConfirmButton: false, background: '#131b2e', color: '#dae2fd' });
      setTimeout(function() { window.location.reload(); }, 1800);
    } catch(e) { setLoading(this, false); toast('error', 'Something went wrong'); }
  });

  /* ── Cancel all items ── */
  document.getElementById('cancelALLbtn').addEventListener('click', async function() {
    const reason  = document.getElementById('reasonAll').value;
    const remark  = document.getElementById('remarkAll').value;
    const id      = document.getElementById('variantIdAll').value;
    const orderId = document.getElementById('orderIdAll').value;
    if (!reason)       return toast('error', 'Select a reason');
    if (!remark.trim()) return toast('error', 'Write a remark');
    setLoading(this, true);
    try {
      const result = await postJSON('/order/cancel-order', { id, reason, remark, orderId });
      if (!result.success) { setLoading(this, false); return toast('error', result.message || 'Something went wrong'); }
      markAllCancelled();
      closeCancelALLModal();
      Swal.fire({ icon: 'success', title: result.message || 'Order cancelled', timer: 1500, showConfirmButton: false, background: '#131b2e', color: '#dae2fd' });
      setTimeout(function() { window.location.reload(); }, 1800);
    } catch(e) { setLoading(this, false); toast('error', 'Something went wrong'); }
  });

  /* ── Return submit ── */
  document.getElementById('returnSubmitBtn').addEventListener('click', async function() {
    const variantId  = document.getElementById('returnVariantId').value;
    const orderId    = document.getElementById('returnOrderId').value;
    const reason     = document.getElementById('returnReason').value;
    const remark     = document.getElementById('returnRemark').value;
    const resolution = document.getElementById('returnResolution').value;
    const quantity   = parseInt(document.getElementById('returnQty').value, 10);

    if (!reason)                    return toast('error', 'Select a reason');
    if (!remark.trim())             return toast('error', 'Provide details');
    if (!resolution)                return toast('error', 'Select preferred resolution');
    if (!quantity || quantity < 1)  return toast('error', 'Invalid quantity');

    setLoading(this, true);
    try {
      const result = await postJSON('/order/return-request', { orderId, reason, remark, resolution, variant: variantId, quantity });
      if (!result.success) { setLoading(this, false); return toast('error', result.message || 'Something went wrong'); }
      closeReturnModal();
      markItemReturned(variantId);
      Swal.fire({ icon: 'success', title: result.message || 'Return request submitted', timer: 1500, showConfirmButton: false, background: '#131b2e', color: '#dae2fd' });
      setTimeout(function() { window.location.reload(); }, 1800);
    } catch(e) { setLoading(this, false); toast('error', 'Something went wrong'); }
  });

  /* ── Init ── */
  window.addEventListener('load', function() {
    recalcTotal();
    document.body.style.opacity = '0';
    var opacity = 0;
    var t = setInterval(function() {
      if (opacity >= 1) return clearInterval(t);
      document.body.style.opacity = opacity;
      opacity += 0.06;
    }, 16);
  });
</script>









