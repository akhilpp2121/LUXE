            Apply
        </button>
    </div>
</div><div class="space-y-4 pt-8 border-t border-outline-variant/30">
<div class="flex justify-between font-label-md text-label-md text-on-surface-variant">
<span class="uppercase tracking-widest">Subtotal</span>
<span class="">$4,650.00</span>
</div>
<div class="flex justify-between font-label-md text-label-md text-on-surface-variant">
<span class="uppercase tracking-widest">Estimated Taxes</span>
<span class="">$372.00</span>
</div>
<div class="flex justify-between font-label-md text-label-md text-secondary">
<span class="uppercase tracking-widest">Concierge Shipping</span>
<span class="">FREE</span>
</div>
<div class="flex justify-between pt-6 mt-6 border-t border-secondary/20">
<span class="font-headline-md text-headline-md text-on-surface uppercase tracking-widest">Total</span>
<span class="font-headline-md text-headline-md text-secondary">$5,022.00</span>
</div>
</div>
<!-- Place Order CTA -->
<button class="w-full mt-10 py-5 bg-secondary text-on-secondary font-label-md text-label-md uppercase tracking-[0.2em] hover:bg-secondary-fixed transition-colors duration-300 ease-in-out">
                        Place Order
                    </button>
<p class="mt-6 text-center text-on-surface-variant font-label-sm text-label-sm opacity-60 uppercase tracking-widest">
                        Complimentary Returns within 30 days
                    </p>
</div>
</div>
</div>
</main>
<!-- Footer Shell -->
<footer class="bg-surface-container-lowest text-tertiary font-body-md text-body-md full-width mt-section-gap py-base border-t border-outline-variant/20 flat no shadows">
<div class="flex flex-col md:flex-row justify-between items-center px-margin-desktop max-w-7xl mx-auto py-12 gap-8">
<div class="font-headline-md text-headline-md text-primary uppercase tracking-[0.2em]">LUXE</div>
<div class="flex flex-wrap justify-center gap-8">
<a class="font-label-sm text-label-sm uppercase tracking-widest text-tertiary-fixed-dim hover:text-secondary transition-colors duration-300" href="#">Terms of Service</a>
<a class="font-label-sm text-label-sm uppercase tracking-widest text-tertiary-fixed-dim hover:text-secondary transition-colors duration-300" href="#">Privacy Policy</a>
<a class="font-label-sm text-label-sm uppercase tracking-widest text-tertiary-fixed-dim hover:text-secondary transition-colors duration-300" href="#">Support</a>
<a class="font-label-sm text-label-sm uppercase tracking-widest text-tertiary-fixed-dim hover:text-secondary transition-colors duration-300" href="#">Shipping Info</a>
</div>
<p class="font-label-sm text-label-sm uppercase tracking-widest text-tertiary-fixed-dim opacity-50">© 2024 LUXE. ALL RIGHTS RESERVED.</p>
</div>
</footer>
<script>
        // Micro-interaction for Place Order button
        document.querySelector('button.bg-secondary').addEventListener('mousedown', function() {
            this.style.transform = 'scale(0.98)';
        });
        document.querySelector('button.bg-secondary').addEventListener('mouseup', function() {
            this.style.transform = 'scale(1)';
        });

        // Toggle address selection (visual only)
        const addresses = document.querySelectorAll('.grid.gap-4 > div');
        addresses.forEach(addr => {
            addr.addEventListener('click', function() {
                addresses.forEach(a => {
                    a.classList.remove('border-secondary', 'bg-surface-container-high');
                    a.classList.add('border-outline-variant/30', 'bg-surface-container-low');
                    const badge = a.querySelector('.bg-secondary');
                    if(badge) badge.classList.add('hidden');
                });
                this.classList.remove('border-outline-variant/30', 'bg-surface-container-low');
                this.classList.add('border-secondary', 'bg-surface-container-high');
            });
        });
    </script>


</body></html>