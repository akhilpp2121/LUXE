<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>LUXE ATELIER — Change Email</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Syne:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@300,0..1&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg: #080c14; --sur: #0e1523; --sur2: #141c2e; --sur3: #1a2338; --sur4: #212c42;
    --bord: rgba(255,255,255,0.07); --bord2: rgba(255,255,255,0.13); --bord3: rgba(255,255,255,0.2);
    --pri: #3a6ff7; --pri2: #6a93ff;
    --gold: #c9a96e; --gold2: #e0c08a;
    --txt: #e8edf8; --txt2: #8892a4; --txt3: #5a6478;
    --green: #22c55e; --red: #ef4444;
    --nav-h: 68px; --side-w: 260px; --r: 12px; --rl: 18px;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--txt); min-height: 100vh; overflow-x: hidden; }
  ::-webkit-scrollbar { width: 4px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--sur4); border-radius: 99px; }

  /* ── NAV ── */
  nav.topnav {
    position: fixed; top: 0; left: 0; right: 0; height: var(--nav-h);
    background: rgba(8,12,20,0.9); backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--bord);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 36px; z-index: 100;
  }
  .brand { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 1rem; letter-spacing: .22em; text-transform: uppercase; }
  .brand span { color: var(--gold); }
  .nav-links { display: flex; gap: 32px; list-style: none; }
  .nav-links a { font-family: 'Syne', sans-serif; font-size: .6rem; letter-spacing: .18em; text-transform: uppercase; color: var(--txt2); text-decoration: none; transition: color .2s; }
  .nav-links a:hover { color: var(--txt); }
  .nav-acts { display: flex; align-items: center; gap: 16px; }
  .nav-btn { background: none; border: none; cursor: pointer; color: var(--txt2); display: flex; align-items: center; transition: color .2s; }
  .nav-btn:hover { color: var(--txt); }
  .nav-btn.on { color: var(--pri); }
  .nav-btn .ms { font-size: 22px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }

  /* ── SIDEBAR ── */
  aside.sidebar {
    position: fixed; top: var(--nav-h); left: 0;
    width: var(--side-w); height: calc(100vh - var(--nav-h));
    background: var(--sur); border-right: 1px solid var(--bord);
    display: flex; flex-direction: column; padding: 28px 0 20px;
    z-index: 50; overflow-y: auto;
  }
  .sidebar-header { padding: 0 24px 24px; border-bottom: 1px solid var(--bord); margin-bottom: 12px; }
  .sidebar-header h3 { font-family: 'Syne', sans-serif; font-weight: 700; font-size: .9rem; margin-bottom: 6px; }
  .sidebar-tier { display: inline-flex; align-items: center; gap: 5px; background: rgba(201,169,110,.1); border: 1px solid rgba(201,169,110,.25); border-radius: 99px; padding: 3px 10px; }
  .sidebar-tier span { font-family: 'Syne', sans-serif; font-size: .5rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--gold); }
  .tier-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--gold); flex-shrink: 0; }
  .sidebar-nav { display: flex; flex-direction: column; gap: 2px; padding: 0 10px; }
  .sidebar-link {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 14px; border-radius: 8px; text-decoration: none;
    color: var(--txt2); font-size: .625rem; font-family: 'Syne', sans-serif;
    font-weight: 600; letter-spacing: .1em; text-transform: uppercase; transition: all .2s;
  }
  .sidebar-link .material-symbols-outlined { font-size: 17px; flex-shrink: 0; font-variation-settings: 'FILL' 0, 'wght' 300; }
  .sidebar-link:hover { background: var(--sur3); color: var(--txt); }
  .sidebar-link.active { background: rgba(58,111,247,.12); color: var(--pri); }
  .sidebar-link.active .material-symbols-outlined { font-variation-settings: 'FILL' 1, 'wght' 300; }
  .sidebar-footer { margin-top: auto; padding: 18px 24px 0; border-top: 1px solid var(--bord); }
  .sidebar-footer a { display: flex; align-items: center; gap: 9px; text-decoration: none; color: var(--txt3); font-size: .625rem; font-family: 'Syne', sans-serif; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; transition: color .2s; }
  .sidebar-footer a:hover { color: var(--txt2); }
  .sidebar-footer .material-symbols-outlined { font-size: 17px; font-variation-settings: 'FILL' 0, 'wght' 300; }

  /* ── MAIN ── */
  main {
    margin-left: var(--side-w);
    padding: calc(var(--nav-h) + 44px) 48px 80px;
    min-height: 100vh; position: relative;
  }
  main::before {
    content: ''; position: fixed; top: 10%; right: -10%;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(201,169,110,0.04) 0%, transparent 70%);
    pointer-events: none; z-index: 0;
  }
  main::after {
    content: ''; position: fixed; bottom: 5%; left: 30%;
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(58,111,247,0.04) 0%, transparent 70%);
    pointer-events: none; z-index: 0;
  }

  /* ── PAGE HEADER ── */
  .page-header {
    margin-bottom: 36px; display: flex; align-items: center;
    justify-content: space-between; position: relative; z-index: 1;
  }
  .page-header-left .eyebrow {
    display: flex; align-items: center; gap: 8px;
    font-family: 'Syne', sans-serif; font-size: .55rem; font-weight: 700;
    letter-spacing: .2em; text-transform: uppercase; color: var(--gold); margin-bottom: 10px;
  }
  .page-header-left .eyebrow::before { content: ''; display: block; width: 18px; height: 1px; background: var(--gold); }
  .page-header-left h1 { font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: 3rem; letter-spacing: -.01em; line-height: 1.05; margin-bottom: 6px; }
  .page-header-left h1 em { font-style: italic; color: var(--gold2); }
  .page-header-left p { color: var(--txt3); font-size: .82rem; font-weight: 300; }
  .back-link {
    display: flex; align-items: center; gap: 6px; text-decoration: none;
    color: var(--txt2); font-family: 'Syne', sans-serif; font-size: .6rem;
    font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
    padding: 9px 16px; border: 1px solid var(--bord2); border-radius: 8px;
    transition: all .2s; background: var(--sur);
  }
  .back-link:hover { background: var(--sur3); color: var(--txt); border-color: var(--bord3); }
  .back-link .ms { font-size: 15px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }

  /* ── CONTENT GRID ── */
  .content-grid {
    display: grid; grid-template-columns: 1fr 340px;
    gap: 24px; max-width: 920px; position: relative; z-index: 1;
  }

  /* ── FORM CARD ── */
  .form-card {
    background: var(--sur); border: 1px solid var(--bord);
    border-radius: var(--rl); overflow: hidden;
    animation: fu .5s ease both;
  }
  @keyframes fu { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }

  .card-header {
    padding: 28px 32px 0;
    display: flex; align-items: center; gap: 8px; margin-bottom: 22px;
    font-family: 'Syne', sans-serif; font-size: .65rem; font-weight: 700;
    letter-spacing: .14em; text-transform: uppercase; color: var(--txt3);
  }
  .card-header .material-symbols-outlined { font-size: 15px; color: var(--pri2); font-variation-settings: 'FILL' 0, 'wght' 300; }
  .card-header::after { content: ''; flex: 1; height: 1px; background: var(--bord); }

  /* Current email display */
  .cur-email-box {
    margin: 0 32px 26px;
    background: var(--sur2); border: 1px solid var(--bord); border-radius: 10px;
    padding: 14px 16px; display: flex; align-items: center; gap: 12px;
    position: relative; overflow: hidden;
  }
  .cur-email-box::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
    background: linear-gradient(180deg, var(--gold) 0%, var(--gold2) 100%);
  }
  .cur-email-box .material-symbols-outlined { font-size: 19px; color: var(--gold); font-variation-settings: 'FILL' 0, 'wght' 300; flex-shrink: 0; }
  .cur-email-label { font-family: 'Syne', sans-serif; font-size: .5rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; color: var(--txt3); margin-bottom: 3px; }
  .cur-email-val { font-size: .88rem; color: var(--txt); font-family: 'DM Mono', monospace; font-weight: 300; }

  /* Fields */
  .form-body { padding: 0 32px 28px; }
  .field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 18px; }
  .field:last-child { margin-bottom: 0; }
  .field label { font-family: 'Syne', sans-serif; font-size: .52rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--txt3); }
  .field-wrap { position: relative; }
  .field-wrap .fi {
    position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
    font-size: 16px; color: var(--txt3); font-family: 'Material Symbols Outlined';
    font-variation-settings: 'FILL' 0, 'wght' 300; pointer-events: none; transition: color .2s;
  }
  .field-wrap .fi-right {
    position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
    font-size: 16px; font-family: 'Material Symbols Outlined';
    font-variation-settings: 'FILL' 1, 'wght' 300; pointer-events: none;
    opacity: 0; transition: opacity .2s;
  }
  .field-wrap .fi-right.show { opacity: 1; }
  .field-wrap .fi-right.ok { color: var(--green); }
  .field-wrap .fi-right.err { color: var(--red); }

  .field input {
    background: var(--sur2); border: 1px solid var(--bord); border-radius: 8px;
    padding: 12px 38px 12px 40px; color: var(--txt); font-family: 'DM Sans', sans-serif;
    font-size: .875rem; font-weight: 400; width: 100%; outline: none; transition: all .2s;
  }
  .field input::placeholder { color: var(--txt3); }
  .field input:hover:not(:disabled) { border-color: var(--bord2); }
  .field input:focus { border-color: rgba(58,111,247,.45); background: var(--sur3); box-shadow: 0 0 0 3px rgba(58,111,247,.07); }
  .field-wrap:focus-within .fi { color: var(--pri2); }
  .field input.has-err { border-color: rgba(239,68,68,.4) !important; background: rgba(239,68,68,.04) !important; box-shadow: 0 0 0 3px rgba(239,68,68,.06) !important; }
  .field input.has-ok { border-color: rgba(34,197,94,.4) !important; background: rgba(34,197,94,.03) !important; box-shadow: 0 0 0 3px rgba(34,197,94,.06) !important; }
  .field-wrap:focus-within .fi.fi-err { color: var(--red) !important; }
  .field-wrap .fi.fi-ok { color: var(--green) !important; }

  .field-msg {
    display: flex; align-items: center; gap: 5px;
    font-size: .7rem; min-height: 16px;
    animation: msgIn .16s ease both;
  }
  @keyframes msgIn { from { opacity: 0; transform: translateY(-3px); } to { opacity: 1; transform: translateY(0); } }
  .field-msg.err { color: var(--red); }
  .field-msg.ok { color: var(--green); }
  .field-msg .material-symbols-outlined { font-size: 13px; font-variation-settings: 'FILL' 1, 'wght' 300; flex-shrink: 0; }

  /* Divider */
  .form-divider { height: 1px; background: var(--bord); margin: 0 32px; }

  /* Actions */
  .form-actions { padding: 22px 32px 28px; display: flex; gap: 12px; }
  .btn-submit {
    flex: 1; display: flex; align-items: center; justify-content: center; gap: 8px;
    background: var(--pri); color: #fff; border: none; border-radius: 8px;
    padding: 13px 28px; font-family: 'Syne', sans-serif; font-size: .68rem;
    font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
    cursor: pointer; transition: all .22s; position: relative; overflow: hidden;
  }
  .btn-submit:hover:not(:disabled) { background: var(--pri2); box-shadow: 0 0 24px rgba(58,111,247,.35); transform: translateY(-1px); }
  .btn-submit:active:not(:disabled) { transform: translateY(0); }
  .btn-submit:disabled { opacity: .4; cursor: not-allowed; box-shadow: none; transform: none; }
  .btn-submit .material-symbols-outlined { font-size: 16px; font-variation-settings: 'FILL' 0, 'wght' 300; }
  .btn-cancel {
    display: flex; align-items: center; gap: 7px; background: none;
    border: 1px solid var(--bord2); color: var(--txt2); border-radius: 8px;
    padding: 13px 22px; font-family: 'Syne', sans-serif; font-size: .68rem;
    font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    cursor: pointer; text-decoration: none; transition: all .2s;
  }
  .btn-cancel:hover { background: var(--sur3); color: var(--txt); border-color: var(--bord3); }

  /* Spinner */
  .spinner { width: 15px; height: 15px; border: 2px solid rgba(255,255,255,.25); border-top-color: #fff; border-radius: 50%; animation: spin .7s linear infinite; flex-shrink: 0; }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ── INFO PANEL ── */
  .info-panel { display: flex; flex-direction: column; gap: 16px; animation: fu .5s .1s ease both; }
  .info-card {
    background: var(--sur); border: 1px solid var(--bord); border-radius: var(--rl);
    padding: 22px; position: relative; overflow: hidden;
  }
  .info-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(201,169,110,.35) 50%, transparent);
  }
  .info-icon {
    width: 38px; height: 38px; border-radius: 9px; display: flex; align-items: center;
    justify-content: center; margin-bottom: 12px;
  }
  .info-icon.blue { background: rgba(58,111,247,.1); border: 1px solid rgba(58,111,247,.2); }
  .info-icon.blue .material-symbols-outlined { color: var(--pri2); }
  .info-icon.green { background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.2); }
  .info-icon.green .material-symbols-outlined { color: var(--green); }
  .info-icon .material-symbols-outlined { font-size: 18px; font-variation-settings: 'FILL' 0, 'wght' 300; }
  .info-title { font-family: 'Syne', sans-serif; font-weight: 700; font-size: .75rem; color: var(--txt); margin-bottom: 14px; }
  .steps { display: flex; flex-direction: column; gap: 12px; }
  .step { display: flex; align-items: flex-start; gap: 10px; }
  .step-n {
    width: 20px; height: 20px; border-radius: 50%; border: 1px solid rgba(58,111,247,.3);
    background: rgba(58,111,247,.1); display: flex; align-items: center; justify-content: center;
    font-family: 'Syne', sans-serif; font-size: .55rem; font-weight: 700; color: var(--pri2);
    flex-shrink: 0; margin-top: 1px;
  }
  .step p { font-size: .73rem; color: var(--txt3); line-height: 1.6; font-weight: 300; }
  .step p strong { color: var(--txt2); font-weight: 500; }

  .sec-tip { display: flex; align-items: flex-start; gap: 9px; padding: 9px 0; border-bottom: 1px solid var(--bord); }
  .sec-tip:last-child { border-bottom: none; padding-bottom: 0; }
  .sec-tip .material-symbols-outlined { font-size: 14px; color: var(--green); font-variation-settings: 'FILL' 1, 'wght' 300; flex-shrink: 0; margin-top: 1px; }
  .sec-tip p { font-size: .72rem; color: var(--txt3); line-height: 1.55; font-weight: 300; }

  /* ── RESPONSIVE ── */
  @media (max-width: 1000px) { .content-grid { grid-template-columns: 1fr; } .info-panel { display: none; } }
  @media (max-width: 860px) {
    :root { --side-w: 0px; }
    aside.sidebar { display: none; }
    main { padding: calc(var(--nav-h) + 28px) 20px 60px; }
    .nav-links { display: none; }
    .page-header { flex-direction: column; align-items: flex-start; gap: 14px; }
    .page-header-left h1 { font-size: 2.4rem; }
  }
</style>
</head>
<body>

<!-- NAV -->
<nav class="topnav">
  <div class="brand">LUXE <span>ATELIER</span></div>
  <ul class="nav-links">
    <li><a href="#">Showroom</a></li>
    <li><a href="#">Collections</a></li>
    <li><a href="#">Atelier</a></li>
    <li><a href="#">Journal</a></li>
  </ul>
  <div class="nav-acts">
    <button class="nav-btn"><span class="ms material-symbols-outlined">shopping_bag</span></button>
    <button class="nav-btn on"><span class="ms material-symbols-outlined">person</span></button>
  </div>
</nav>

<!-- SIDEBAR -->
<aside class="sidebar">
  <div class="sidebar-header">
    <h3>User Account</h3>
    <div class="sidebar-tier"><div class="tier-dot"></div><span>Gold Member</span></div>
  </div>
  <nav class="sidebar-nav">
    <a href="/profile" class="sidebar-link active">
      <span class="material-symbols-outlined">manage_accounts</span><span>Profile Settings</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">package_2</span><span>My Orders</span>
    </a>
    <a href="/address" class="sidebar-link">
      <span class="material-symbols-outlined">distance</span><span>Manage Address</span>
    </a>
    <a href="/changePassword" class="sidebar-link">
      <span class="material-symbols-outlined">lock_reset</span><span>Change Password</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">favorite</span><span>Wishlist</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">share_reviews</span><span>Referral Link</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">account_balance_wallet</span><span>Wallet</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">confirmation_number</span><span>Coupons</span>
    </a>
  </nav>
  <div class="sidebar-footer">
    <a href="/logout">
  <span class="material-symbols-outlined">logout</span>
  <span>Sign Out</span>
</a>

  </div>
</aside>

<!-- MAIN -->
<main>
  <div class="page-header">
    <div class="page-header-left">
      <div class="eyebrow">Account Security</div>
      <h1>Change <em>Email</em></h1>
      <p>Update the email address associated with your account</p>
    </div>
    <a href="/profile/edit" class="back-link">
      <span class="ms material-symbols-outlined">arrow_back</span>Back to Edit
    </a>
  </div>

  <div class="content-grid">

    <!-- FORM CARD -->
    <div class="form-card">
      <div class="card-header">
        <span class="material-symbols-outlined">mail</span>
        Email Address
      </div>

      <div class="cur-email-box">
        <span class="material-symbols-outlined">verified_user</span>
        <div>
          <div class="cur-email-label">Current Email</div>
        <div class="cur-email-val"><%= user.email %></div>

        </div>
      </div>

      <form id="emailForm" method="POST" action="/profile/change-email" novalidate>
        <div class="form-body">

          <!-- New Email -->
          <div class="field">
            <label for="newEmail">New Email Address</label>
            <div class="field-wrap">
              <span class="fi material-symbols-outlined" id="newEmail-icon">alternate_email</span>
              <input
                type="email" id="newEmail" name="newEmail"
                placeholder="your@newemail.com"
                autocomplete="email" maxlength="254"
              />
              <span class="fi-right material-symbols-outlined" id="newEmail-status"></span>
            </div>
            <div id="newEmail-msg"></div>
          </div>

          <!-- Confirm Email -->
          <div class="field" style="margin-bottom:0">
            <label for="confirmEmail">Confirm New Email</label>
            <div class="field-wrap">
              <span class="fi material-symbols-outlined" id="confirmEmail-icon">mark_email_read</span>
              <input
                type="email" id="confirmEmail" name="confirmEmail"
                placeholder="Repeat your new email"
                maxlength="254"
              />
              <span class="fi-right material-symbols-outlined" id="confirmEmail-status"></span>
            </div>
            <div id="confirmEmail-msg"></div>
          </div>

        </div>

        <div class="form-divider"></div>

        <div class="form-actions">
          <button type="submit" class="btn-submit" id="sendOtpBtn" disabled>
            <span class="material-symbols-outlined">send</span>
            Send Verification Code
          </button>
          <a href="/profile/edit" class="btn-cancel">Cancel</a>
        </div>
      </form>
    </div>

    <!-- RIGHT INFO PANEL -->
    <div class="info-panel">
      <div class="info-card">
        <div class="info-icon blue"><span class="material-symbols-outlined">info</span></div>
        <div class="info-title">How it works</div>
        <div class="steps">
          <div class="step">
            <div class="step-n">1</div>
            <p>Enter your <strong>new email address</strong> and confirm it below.</p>
          </div>
          <div class="step">
            <div class="step-n">2</div>
            <p>We send a <strong>4-digit OTP</strong> to your new email for verification.</p>
          </div>
          <div class="step">
            <div class="step-n">3</div>
            <p>Enter the code and your <strong>email is updated</strong> instantly.</p>
          </div>
        </div>
      </div>

      <div class="info-card">
        <div class="info-icon green"><span class="material-symbols-outlined">shield</span></div>
        <div class="info-title">Security Tips</div>
        <div class="sec-tip"><span class="material-symbols-outlined">check_circle</span><p>Use an email only you have access to</p></div>
        <div class="sec-tip"><span class="material-symbols-outlined">check_circle</span><p>Avoid shared or work emails for personal accounts</p></div>
        <div class="sec-tip"><span class="material-symbols-outlined">check_circle</span><p>The OTP expires in 1 minute — have access ready</p></div>
        <div class="sec-tip"><span class="material-symbols-outlined">check_circle</span><p>Check your spam folder if you don't receive the code</p></div>
      </div>
    </div>

  </div>
</main>

<script>
(function () {
  'use strict';

  const CURRENT_EMAIL = 'alexandra.chen@gmail.com';
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  const form      = document.getElementById('emailForm');
  const newInput  = document.getElementById('newEmail');
  const confInput = document.getElementById('confirmEmail');
  const submitBtn = document.getElementById('sendOtpBtn');
  const touched   = { newEmail: false, confirmEmail: false };

  function validateEmailValue(val) {
    val = val.trim();
    if (!val)                return { ok: false, msg: 'Email address is required' };
    if (!EMAIL_RE.test(val)) return { ok: false, msg: 'Enter a valid email address' };
    if (val.length > 254)    return { ok: false, msg: 'Email address is too long' };
    if (val.split('@')[0].length > 64) return { ok: false, msg: 'Local part is too long' };
    return { ok: true, msg: '' };
  }

  function validateNew(val) {
    const base = validateEmailValue(val);
    if (!base.ok) return base;
    if (val.trim().toLowerCase() === CURRENT_EMAIL.toLowerCase())
      return { ok: false, msg: 'New email must differ from your current email' };
    return { ok: true, msg: 'Looks good!' };
  }

  function validateConfirm(val) {
    const base = validateEmailValue(val);
    if (!base.ok) return base;
    if (val.trim().toLowerCase() !== newInput.value.trim().toLowerCase())
      return { ok: false, msg: 'Email addresses do not match' };
    return { ok: true, msg: 'Emails match' };
  }

  function renderField(id, result, isTouched) {
    const inp      = document.getElementById(id);
    const msgEl    = document.getElementById(id + '-msg');
    const statusEl = document.getElementById(id + '-status');
    const iconEl   = document.getElementById(id + '-icon');

    inp.classList.remove('has-err', 'has-ok');
    statusEl.className = 'fi-right material-symbols-outlined';
    iconEl.classList.remove('fi-err', 'fi-ok');
    msgEl.innerHTML = '';

    if (!isTouched) return;

    if (!result.ok) {
      inp.classList.add('has-err');
      iconEl.classList.add('fi-err');
      statusEl.textContent = 'error';
      statusEl.className = 'fi-right material-symbols-outlined show err';
      msgEl.innerHTML = `<div class="field-msg err"><span class="material-symbols-outlined">error</span>${result.msg}</div>`;
    } else {
      inp.classList.add('has-ok');
      iconEl.classList.add('fi-ok');
      statusEl.textContent = 'check_circle';
      statusEl.className = 'fi-right material-symbols-outlined show ok';
      if (result.msg) {
        msgEl.innerHTML = `<div class="field-msg ok"><span class="material-symbols-outlined">check_circle</span>${result.msg}</div>`;
      }
    }
  }

  function syncButton() {
    submitBtn.disabled = !(validateNew(newInput.value).ok && validateConfirm(confInput.value).ok);
  }

  newInput.addEventListener('blur', function () {
    touched.newEmail = true;
    renderField('newEmail', validateNew(this.value), true);
    if (touched.confirmEmail) renderField('confirmEmail', validateConfirm(confInput.value), true);
    syncButton();
  });

  newInput.addEventListener('input', function () {
    if (touched.newEmail) renderField('newEmail', validateNew(this.value), true);
    if (touched.confirmEmail) renderField('confirmEmail', validateConfirm(confInput.value), true);
    syncButton();
  });

  confInput.addEventListener('blur', function () {
    touched.confirmEmail = true;
    renderField('confirmEmail', validateConfirm(this.value), true);
    syncButton();
  });

  confInput.addEventListener('input', function () {
    if (touched.confirmEmail) renderField('confirmEmail', validateConfirm(this.value), true);
    syncButton();
  });

  [newInput, confInput].forEach(inp => {
    inp.addEventListener('paste', function (e) {
      e.preventDefault();
      const pasted = (e.clipboardData || window.clipboardData).getData('text').trim();
      const s = this.selectionStart, en = this.selectionEnd;
      this.value = this.value.slice(0, s) + pasted + this.value.slice(en);
      this.dispatchEvent(new Event('input'));
    });
  });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    touched.newEmail = touched.confirmEmail = true;
    const nr = validateNew(newInput.value);
    const cr = validateConfirm(confInput.value);
    renderField('newEmail', nr, true);
    renderField('confirmEmail', cr, true);
    syncButton();
    if (!nr.ok) { newInput.focus(); return; }
    if (!cr.ok) { confInput.focus(); return; }
    sessionStorage.setItem('pendingEmail', newInput.value.trim());
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<div class="spinner"></div>Sending Code...';
    this.submit();
  });
})();
</script>
</body>
</html>