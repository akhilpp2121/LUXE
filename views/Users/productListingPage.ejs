<!-- ═══════════ SCRIPTS ═══════════ -->
<script>
  /* ── Search clear ── */
  function toggleClear(btnId, val) {
    const btn = document.getElementById(btnId);
    if (!btn) return;
    val ? btn.classList.remove('hidden-clear') : btn.classList.add('hidden-clear');
  }
  function clearSearch(inputId, btnId) {
    const inp = document.getElementById(inputId);
    if (inp) { inp.value = ''; inp.focus(); }
    toggleClear(btnId, '');
  }

  /* ── Add to Cart ── */
  async function addToCart(variantId) {
    try {
      const res  = await fetch('/cart/add-cart', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ variantId, qty: 1 })
      });
      const data = await res.json();
      if (data.success) {
        Swal.fire({ toast:true, icon:'success', title: data.message || 'Added to cart!', position:'top-right', showConfirmButton:false, timer:2000 });
      } else {
        Swal.fire({ toast:true, icon:'error', title: data.message || 'Failed to add', position:'top-right', showConfirmButton:false, timer:2000 });
      }
    } catch {
      Swal.fire({ toast:true, icon:'error', title:'Something went wrong', position:'top-right', showConfirmButton:false, timer:2000 });
    }
  }

  /* ── Toggle Wishlist ── */
  async function toggleWishlist(variantId, btn) {
    const isWishlisted = btn.classList.contains('wishlisted');
    const action       = isWishlisted ? 'REMOVE' : 'ADD';

    try {
      const res    = await fetch('/wishlist/update', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ variantId, action })
      });
      const result = await res.json();

      if (!result.success) {
        return Swal.fire({ toast:true, icon:'error', title:result.message, position:'top-right', showConfirmButton:false, timer:2000 });
      }

      // Toggle class and icon fill
      if (action === 'ADD') {
        btn.classList.add('wishlisted');
        btn.title = 'Remove from wishlist';
      } else {
        btn.classList.remove('wishlisted');
        btn.title = 'Add to wishlist';
      }

      Swal.fire({ toast:true, icon:'success', title:result.message, position:'top-right', showConfirmButton:false, timer:2000 });

    } catch (e) {
      console.error(e);
      Swal.fire({ toast:true, icon:'error', title:'Something went wrong', position:'top-right', showConfirmButton:false, timer:2000 });
    }
  }
</script>

</body>
