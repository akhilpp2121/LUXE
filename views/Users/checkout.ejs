  .coupon-msg.success { color: #34d399; }
  .coupon-msg.error { color: #f87171; }
  .coupon-discount-row { display: none; }
  .coupon-discount-row.visible { display: flex; }

  /* ── PRICE BREAKDOWN ── */
  .price-section { background: #0b1120; border: 1px solid #1e293b; border-radius: 12px; padding: 18px 18px 4px; margin-bottom: 22px; }
  .price-row { display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; }
  .price-row.total { padding-top: 14px; padding-bottom: 2px; border-top: 1px solid #1e293b; margin-top: 4px; }

  .place-btn:disabled { opacity: .45; cursor: not-allowed; }

  /* ── REMOVED ITEMS BANNER ── */
  .removed-banner { background: rgba(251,191,36,.08); border: 1px solid rgba(251,191,36,.2); border-radius: 12px; padding: 16px 20px; }

  input[type=number]::-webkit-inner-spin-button,
  input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; }

  /* ---- Animated Logo (Puzzle Assembly) ---- */
.logo-link {
    opacity: 0;
    animation: logoEntrance 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes logoEntrance {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
}

/* Puzzle container */
.diamond-puzzle {
    position: relative;
    display: inline-block;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
}

.diamond-puzzle .piece {
    position: absolute;
    inset: 0;
    font-size: 28px;
    line-height: 28px;
    color: #1152d4;
    font-variation-settings: 'FILL' 1, 'wght' 500, 'GRAD' 0, 'opsz' 24;
    filter: drop-shadow(0 0 6px rgba(17, 82, 212, 0.4));
}

/* Each piece = one quadrant of the glyph */
.piece-1 { clip-path: polygon(0 0, 50% 0, 50% 50%, 0 50%); }
.piece-2 { clip-path: polygon(50% 0, 100% 0, 100% 50%, 50% 50%); }
.piece-3 { clip-path: polygon(0 50%, 50% 50%, 50% 100%, 0 100%); }
.piece-4 { clip-path: polygon(50% 50%, 100% 50%, 100% 100%, 50% 100%); }

/* Ambient puzzle-assemble loop */
.piece-1 { animation: puzzle1 5s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
.piece-2 { animation: puzzle2 5s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
.piece-3 { animation: puzzle3 5s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
.piece-4 { animation: puzzle4 5s cubic-bezier(0.65, 0, 0.35, 1) infinite; }

@keyframes puzzle1 {
    0%, 100% { transform: translate(-9px, -9px) rotate(-25deg); opacity: 0.4; }
    35%, 65% { transform: translate(0, 0) rotate(0deg); opacity: 1; }
}
@keyframes puzzle2 {
    0%, 100% { transform: translate(9px, -9px) rotate(25deg); opacity: 0.4; }
    35%, 65% { transform: translate(0, 0) rotate(0deg); opacity: 1; }
}
@keyframes puzzle3 {
    0%, 100% { transform: translate(-9px, 9px) rotate(25deg); opacity: 0.4; }
    35%, 65% { transform: translate(0, 0) rotate(0deg); opacity: 1; }
}
@keyframes puzzle4 {
    0%, 100% { transform: translate(9px, 9px) rotate(-25deg); opacity: 0.4; }
    35%, 65% { transform: translate(0, 0) rotate(0deg); opacity: 1; }
}

/* Burst-apart then snap-together on hover */
.logo-link:hover .piece {
    animation: none !important;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.3s ease;
}
.logo-link:hover .piece-1 { transform: translate(-7px, -7px) rotate(-15deg); }
.logo-link:hover .piece-2 { transform: translate(7px, -7px) rotate(15deg); }
.logo-link:hover .piece-3 { transform: translate(-7px, 7px) rotate(15deg); }
.logo-link:hover .piece-4 { transform: translate(7px, 7px) rotate(-15deg); }

.logo-link:hover .diamond-puzzle:hover .piece,
.logo-link:active .piece {
    transform: translate(0, 0) rotate(0deg) !important;
    transition-delay: 0.25s !important;
}

/* Text shimmer */
.logo-text {
    background: linear-gradient(
        100deg,
        #ffffff 30%,
        #1152d4 45%,
        #6ea0ff 50%,
        #1152d4 55%,
        #ffffff 70%
    );
    background-size: 250% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmerSweep 4s ease-in-out infinite;
}

@keyframes shimmerSweep {
    0%   { background-position: 160% 0; }
    50%  { background-position: -60% 0; }
    100% { background-position: -60% 0; }
}

.logo-link:hover .logo-text {
    animation-duration: 1.2s;
}
</style>
