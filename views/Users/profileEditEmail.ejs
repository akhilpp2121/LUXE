<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>LUXE ATELIER — Change Email</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&family=Outfit:wght@300;400;500;600;700&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@200,0..1&display=swap" rel="stylesheet"/>
<style>
:root {
  --bg: #06080f;
  --surface: #0b0e19;
  --s2: #0f1320;
  --s3: #141826;
  --s4: #1a2030;
  --border: rgba(255,255,255,0.06);
  --border2: rgba(255,255,255,0.11);
  --border3: rgba(255,255,255,0.18);
  --gold: #c8973f;
  --gold2: #e8bb6a;
  --gold3: #f5d48a;
  --goldglow: rgba(200,151,63,0.18);
  --pri: #4f7ef8;
  --pri2: #7aa2ff;
  --priglow: rgba(79,126,248,0.2);
  --txt: #edf0f8;
  --txt2: #7e8ba0;
  --txt3: #4a5570;
  --red: #e05252;
  --green: #3ecf8e;
  --nav-h: 70px;
  --side-w: 268px;
  --radius: 14px;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: 'Outfit', sans-serif;
  background: var(--bg);
  color: var(--txt);
  min-height: 100vh;
  overflow-x: hidden;
}

/* Noise texture overlay */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 9999;
  opacity: 0.4;
}

::-webkit-scrollbar { width: 3px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { background: var(--s4); border-radius: 99px; }

/* ═══ NAV ═══ */
nav {
  position: fixed; top: 0; left: 0; right: 0;
  height: var(--nav-h);
  background: rgba(6,8,15,0.85);
  backdrop-filter: blur(24px) saturate(1.4);
  border-bottom: 1px solid var(--border);
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 40px;
  z-index: 200;
}
.brand {
  font-family: 'Playfair Display', serif;
  font-size: 1.05rem;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--txt);
  display: flex; align-items: center; gap: 6px;
}
.brand-accent { color: var(--gold2); font-style: italic; }
.brand-sep { width: 1px; height: 14px; background: var(--border3); margin: 0 2px; }

.nav-links { display: flex; gap: 36px; list-style: none; }
.nav-links a {
  font-family: 'Outfit', sans-serif;
  font-size: 0.62rem;
  font-weight: 500;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--txt3);
  text-decoration: none;
  transition: color 0.2s;
  position: relative;
}
.nav-links a::after {
  content: '';
  position: absolute; bottom: -3px; left: 0; right: 0; height: 1px;
  background: var(--gold);
  transform: scaleX(0);
  transition: transform 0.25s ease;
}
.nav-links a:hover { color: var(--txt2); }
.nav-links a:hover::after { transform: scaleX(1); }

.nav-right { display: flex; align-items: center; gap: 8px; }
.nav-icon {
  width: 38px; height: 38px;
  background: none; border: 1px solid var(--border);
  border-radius: 10px; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  color: var(--txt3); transition: all 0.2s;
}
.nav-icon:hover { background: var(--s3); color: var(--txt2); border-color: var(--border2); }
.nav-icon.active { background: rgba(79,126,248,0.1); border-color: rgba(79,126,248,0.3); color: var(--pri2); }
.nav-icon .material-symbols-outlined { font-size: 18px; font-variation-settings: 'FILL' 0, 'wght' 200; }

/* ═══ SIDEBAR ═══ */
aside {
  position: fixed;
  top: var(--nav-h); left: 0;
  width: var(--side-w);
  height: calc(100vh - var(--nav-h));
  background: var(--surface);
  border-right: 1px solid var(--border);
  display: flex; flex-direction: column;
  padding: 32px 0 24px;
  z-index: 100;
  overflow-y: auto;
}

.sb-user { padding: 0 22px 28px; border-bottom: 1px solid var(--border); }
.sb-avatar {
  width: 48px; height: 48px; border-radius: 50%;
  background: linear-gradient(135deg, var(--s4) 0%, var(--s3) 100%);
  border: 1px solid var(--border3);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 12px;
  position: relative;
  overflow: hidden;
}
.sb-avatar::before {
  content: '';
  position: absolute; inset: 0;
  background: radial-gradient(circle at 35% 35%, rgba(200,151,63,0.2), transparent 60%);
}
.sb-avatar .material-symbols-outlined { font-size: 22px; color: var(--gold); font-variation-settings: 'FILL' 1, 'wght' 200; }
.sb-name { font-size: 0.9rem; font-weight: 600; color: var(--txt); margin-bottom: 6px; letter-spacing: 0.01em; }
.sb-badge {
  display: inline-flex; align-items: center; gap: 5px;
  background: rgba(200,151,63,0.08);
  border: 1px solid rgba(200,151,63,0.22);
  border-radius: 99px; padding: 3px 10px;
}
.sb-badge-dot { width: 4px; height: 4px; border-radius: 50%; background: var(--gold); }
.sb-badge span { font-size: 0.52rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); }

.sb-section-label {
  padding: 20px 22px 8px;
  font-size: 0.5rem; font-weight: 700; letter-spacing: 0.18em;
  text-transform: uppercase; color: var(--txt3);
}
.sb-nav { display: flex; flex-direction: column; gap: 1px; padding: 0 12px; }
.sb-link {
  display: flex; align-items: center; gap: 11px;
  padding: 9px 12px; border-radius: 9px;
  text-decoration: none; color: var(--txt3);
  font-size: 0.7rem; font-weight: 500; letter-spacing: 0.02em;
  transition: all 0.18s; position: relative; overflow: hidden;
}
.sb-link .material-symbols-outlined { font-size: 16px; flex-shrink: 0; font-variation-settings: 'FILL' 0, 'wght' 200; }
.sb-link:hover { background: var(--s3); color: var(--txt2); }
.sb-link.active {
  background: linear-gradient(90deg, rgba(79,126,248,0.12) 0%, rgba(79,126,248,0.04) 100%);
  color: var(--pri2);
  border-right: 2px solid var(--pri);
}
.sb-link.active .material-symbols-outlined { font-variation-settings: 'FILL' 1, 'wght' 200; }

.sb-footer {
  margin-top: auto; padding: 20px 22px 0;
  border-top: 1px solid var(--border);
}
.sb-signout {
  display: flex; align-items: center; gap: 9px;
  text-decoration: none; color: var(--txt3);
  font-size: 0.68rem; font-weight: 500; letter-spacing: 0.03em;
  padding: 8px 4px; border-radius: 8px; transition: color 0.18s;
}
.sb-signout .material-symbols-outlined { font-size: 16px; font-variation-settings: 'FILL' 0, 'wght' 200; }
.sb-signout:hover { color: var(--red); }

/* ═══ MAIN ═══ */
main {
  margin-left: var(--side-w);
  padding: calc(var(--nav-h) + 52px) 56px 100px;
  min-height: 100vh;
  position: relative;
}

/* ambient glow in background */
main::before {
  content: '';
  position: fixed;
  top: 10%; right: -10%;
  width: 600px; height: 600px;
  background: radial-gradient(circle, rgba(200,151,63,0.04) 0%, transparent 70%);
  pointer-events: none; z-index: 0;
}
main::after {
  content: '';
  position: fixed;
  bottom: 5%; left: 20%;
  width: 500px; height: 500px;
  background: radial-gradient(circle, rgba(79,126,248,0.04) 0%, transparent 70%);
  pointer-events: none; z-index: 0;
}

/* ═══ PAGE HEADER ═══ */
.page-header {
  display: flex; align-items: flex-end; justify-content: space-between;
  margin-bottom: 48px; position: relative; z-index: 1;
}
.ph-left {}
.ph-eyebrow {
  display: flex; align-items: center; gap: 8px;
  font-size: 0.55rem; font-weight: 600; letter-spacing: 0.22em;
  text-transform: uppercase; color: var(--gold);
  margin-bottom: 12px;
}
.ph-eyebrow::before {
  content: '';
  display: block; width: 20px; height: 1px; background: var(--gold);
}
.ph-title {
  font-family: 'Playfair Display', serif;
  font-size: 3.2rem; font-weight: 400; line-height: 1;
  letter-spacing: -0.01em; color: var(--txt);
  margin-bottom: 10px;
}
.ph-title em { font-style: italic; color: var(--gold2); }
.ph-sub { font-size: 0.82rem; color: var(--txt3); font-weight: 300; letter-spacing: 0.02em; }

.back-link {
  display: flex; align-items: center; gap: 7px;
  text-decoration: none; color: var(--txt3);
  font-size: 0.6rem; font-weight: 600; letter-spacing: 0.16em;
  text-transform: uppercase;
  padding: 9px 16px;
  border: 1px solid var(--border2);
  border-radius: 8px;
  transition: all 0.2s;
  background: var(--surface);
}
.back-link:hover { color: var(--txt2); border-color: var(--border3); background: var(--s2); }
.back-link .material-symbols-outlined { font-size: 14px; font-variation-settings: 'FILL' 0, 'wght' 200; }

/* ═══ MAIN LAYOUT ═══ */
.content-grid {
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: 28px;
  max-width: 960px;
  position: relative; z-index: 1;
}

/* ═══ FORM CARD ═══ */
.form-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  animation: slideUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
}
@keyframes slideUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

.form-card-top {
  padding: 32px 36px 0;
}

.card-label {
  display: flex; align-items: center; gap: 8px;
  font-size: 0.55rem; font-weight: 700; letter-spacing: 0.2em;
  text-transform: uppercase; color: var(--txt3);
  margin-bottom: 22px;
}
.card-label .material-symbols-outlined {
  font-size: 14px; color: var(--pri2);
  font-variation-settings: 'FILL' 0, 'wght' 200;
}
.card-label::after {
  content: '';
  flex: 1; height: 1px; background: var(--border);
}

/* Current email display */
.cur-email {
  background: var(--s2);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 16px 18px;
  margin-bottom: 28px;
  display: flex; align-items: center; gap: 14px;
  position: relative; overflow: hidden;
}
.cur-email::before {
  content: '';
  position: absolute; left: 0; top: 0; bottom: 0;
  width: 3px;
  background: linear-gradient(180deg, var(--gold) 0%, var(--gold2) 100%);
}
.cur-email .material-symbols-outlined {
  font-size: 20px; color: var(--gold);
  font-variation-settings: 'FILL' 0, 'wght' 200;
  flex-shrink: 0;
}
.ce-label {
  font-size: 0.52rem; font-weight: 600; letter-spacing: 0.14em;
  text-transform: uppercase; color: var(--txt3); margin-bottom: 3px;
}
.ce-val { font-size: 0.88rem; color: var(--txt); font-family: 'DM Mono', monospace; font-weight: 300; }

/* ═══ FIELDS ═══ */
.form-body { padding: 4px 36px 32px; }

.field-group { margin-bottom: 20px; }
.field-label {
  display: block;
  font-size: 0.55rem; font-weight: 700; letter-spacing: 0.16em;
  text-transform: uppercase; color: var(--txt3);
  margin-bottom: 8px;
}
.field-wrap { position: relative; }

.field-icon {
  position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
  font-size: 17px; color: var(--txt3);
  font-family: 'Material Symbols Outlined';
  font-variation-settings: 'FILL' 0, 'wght' 200;
  pointer-events: none;
  transition: color 0.2s;
}

.field-input {
  width: 100%;
  background: var(--s2);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 14px 16px 14px 46px;
  color: var(--txt);
  font-family: 'Outfit', sans-serif;
  font-size: 0.88rem;
  font-weight: 400;
  outline: none;
  transition: all 0.22s;
  letter-spacing: 0.01em;
}
.field-input::placeholder { color: var(--txt3); }
.field-input:hover { border-color: var(--border2); }
.field-input:focus {
  border-color: rgba(79,126,248,0.4);
  background: var(--s3);
  box-shadow: 0 0 0 3px rgba(79,126,248,0.08);
}
.field-input:focus + .field-icon-overlay,
.field-wrap:focus-within .field-icon { color: var(--pri2); }
.field-input.has-error {
  border-color: rgba(224,82,82,0.4) !important;
  background: rgba(224,82,82,0.04) !important;
  box-shadow: none !important;
}

.field-error {
  display: flex; align-items: center; gap: 5px;
  font-size: 0.7rem; color: var(--red);
  margin-top: 7px; min-height: 16px;
}
.field-error .material-symbols-outlined { font-size: 13px; font-variation-settings: 'FILL' 1, 'wght' 200; }

/* password eye toggle (reuse for confirm) */
.field-toggle {
  position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
  background: none; border: none; cursor: pointer;
  color: var(--txt3); padding: 4px;
  display: flex; align-items: center;
  transition: color 0.2s;
}
.field-toggle:hover { color: var(--txt2); }
.field-toggle .material-symbols-outlined { font-size: 17px; font-variation-settings: 'FILL' 0, 'wght' 200; }

/* ═══ DIVIDER ═══ */
.form-divider { height: 1px; background: var(--border); margin: 0 36px 28px; }

/* ═══ SUBMIT AREA ═══ */
.form-actions { padding: 0 36px 36px; display: flex; gap: 12px; }

.btn-submit {
  flex: 1;
  display: flex; align-items: center; justify-content: center; gap: 9px;
  background: var(--pri);
  color: #fff;
  border: none; border-radius: 10px;
  padding: 15px 28px;
  font-family: 'Outfit', sans-serif;
  font-size: 0.72rem; font-weight: 700;
  letter-spacing: 0.14em; text-transform: uppercase;
  cursor: pointer;
  transition: all 0.22s;
  position: relative; overflow: hidden;
}
.btn-submit::before {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.08) 0%, transparent 100%);
}
.btn-submit:hover {
  background: var(--pri2);
  box-shadow: 0 0 28px rgba(79,126,248,0.35), 0 4px 16px rgba(79,126,248,0.2);
  transform: translateY(-1px);
}
.btn-submit:active { transform: translateY(0); }
.btn-submit:disabled { opacity: 0.45; cursor: not-allowed; box-shadow: none; transform: none; }
.btn-submit .material-symbols-outlined { font-size: 17px; font-variation-settings: 'FILL' 0, 'wght' 200; }

.btn-cancel {
  display: flex; align-items: center; gap: 7px;
  background: none;
  border: 1px solid var(--border2);
  color: var(--txt3);
  border-radius: 10px;
  padding: 15px 22px;
  font-family: 'Outfit', sans-serif;
  font-size: 0.72rem; font-weight: 600;
  letter-spacing: 0.1em; text-transform: uppercase;
  cursor: pointer; text-decoration: none;
  transition: all 0.2s;
}
.btn-cancel:hover { background: var(--s3); color: var(--txt2); border-color: var(--border3); }

/* ═══ RIGHT PANEL ═══ */
.info-panel { display: flex; flex-direction: column; gap: 16px; animation: slideUp 0.5s 0.1s cubic-bezier(0.22, 1, 0.36, 1) both; }

.info-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 24px;
  position: relative; overflow: hidden;
}
.info-card::before {
  content: '';
  position: absolute; top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent 0%, rgba(200,151,63,0.4) 50%, transparent 100%);
}

.info-card-icon {
  width: 40px; height: 40px; border-radius: 10px;
  background: rgba(200,151,63,0.1);
  border: 1px solid rgba(200,151,63,0.2);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 14px;
}
.info-card-icon .material-symbols-outlined { font-size: 19px; color: var(--gold2); font-variation-settings: 'FILL' 0, 'wght' 200; }
.info-card-icon.blue { background: rgba(79,126,248,0.1); border-color: rgba(79,126,248,0.2); }
.info-card-icon.blue .material-symbols-outlined { color: var(--pri2); }
.info-card-icon.green { background: rgba(62,207,142,0.1); border-color: rgba(62,207,142,0.2); }
.info-card-icon.green .material-symbols-outlined { color: var(--green); }

.info-card-title { font-size: 0.82rem; font-weight: 600; color: var(--txt); margin-bottom: 7px; }
.info-card-desc { font-size: 0.75rem; color: var(--txt3); line-height: 1.7; font-weight: 300; }

.steps-list { display: flex; flex-direction: column; gap: 14px; }
.step-item { display: flex; align-items: flex-start; gap: 12px; }
.step-num {
  width: 22px; height: 22px; border-radius: 50%;
  background: rgba(79,126,248,0.1); border: 1px solid rgba(79,126,248,0.25);
  display: flex; align-items: center; justify-content: center;
  font-size: 0.6rem; font-weight: 700; color: var(--pri2);
  flex-shrink: 0; margin-top: 1px;
}
.step-text { font-size: 0.75rem; color: var(--txt3); line-height: 1.6; font-weight: 300; }
.step-text strong { color: var(--txt2); font-weight: 500; }

/* security tips card */
.security-tip {
  display: flex; align-items: flex-start; gap: 10px;
  padding: 10px 0;
  border-bottom: 1px solid var(--border);
}
.security-tip:last-child { border-bottom: none; padding-bottom: 0; }
.security-tip .material-symbols-outlined { font-size: 15px; color: var(--green); font-variation-settings: 'FILL' 1, 'wght' 200; flex-shrink: 0; margin-top: 1px; }
.security-tip-text { font-size: 0.73rem; color: var(--txt3); line-height: 1.6; font-weight: 300; }

/* ═══ LOADING SPINNER ═══ */
.spinner {
  width: 16px; height: 16px;
  border: 2px solid rgba(255,255,255,0.2);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
  flex-shrink: 0;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ═══ RESPONSIVE ═══ */
@media (max-width: 1000px) {
  .content-grid { grid-template-columns: 1fr; }
  .info-panel { display: none; }
}
@media (max-width: 860px) {
  :root { --side-w: 0px; }
  aside { display: none; }
  main { padding: calc(var(--nav-h) + 32px) 24px 80px; }
  .nav-links { display: none; }
  .page-header { flex-direction: column; align-items: flex-start; gap: 16px; }
  .ph-title { font-size: 2.4rem; }
}
</style>
</head>
<body>

<!-- ═══ NAV ═══ -->
<nav>
  <div class="brand">
    Luxe<span class="brand-sep"></span><span class="brand-accent">Atelier</span>
  </div>
  <ul class="nav-links">
    <li><a href="#">Showroom</a></li>
    <li><a href="#">Collections</a></li>
    <li><a href="#">Atelier</a></li>
    <li><a href="#">Journal</a></li>
  </ul>
  <div class="nav-right">
    <button class="nav-icon"><span class="material-symbols-outlined">search</span></button>
    <button class="nav-icon"><span class="material-symbols-outlined">shopping_bag</span></button>
    <button class="nav-icon active"><span class="material-symbols-outlined">person</span></button>
  </div>
</nav>

<!-- ═══ SIDEBAR ═══ -->
<aside>
  <div class="sb-user">
    <div class="sb-avatar"><span class="material-symbols-outlined">person</span></div>
    <div class="sb-name">Alexandra Chen</div>
    <div class="sb-badge"><div class="sb-badge-dot"></div><span>Gold Member</span></div>
  </div>
  <div class="sb-section-label">Account</div>
  <nav class="sb-nav">
    <a href="#" class="sb-link active">
      <span class="material-symbols-outlined">manage_accounts</span>Profile Settings
    </a>
    <a href="#" class="sb-link">
      <span class="material-symbols-outlined">package_2</span>My Orders
    </a>
    <a href="#" class="sb-link">
      <span class="material-symbols-outlined">distance</span>Manage Address
    </a>
    <a href="#" class="sb-link">
      <span class="material-symbols-outlined">lock_reset</span>Change Password
    </a>
  </nav>
  <div class="sb-section-label" style="padding-top:12px;">Perks</div>
  <nav class="sb-nav">
    <a href="#" class="sb-link">
      <span class="material-symbols-outlined">favorite</span>Wishlist
    </a>
    <a href="#" class="sb-link">
      <span class="material-symbols-outlined">share_reviews</span>Referral Link
    </a>
    <a href="#" class="sb-link">
      <span class="material-symbols-outlined">account_balance_wallet</span>Wallet
    </a>
    <a href="#" class="sb-link">
      <span class="material-symbols-outlined">confirmation_number</span>Coupons
    </a>
  </nav>
  <div class="sb-footer">
    <a href="#" class="sb-signout">
      <span class="material-symbols-outlined">logout</span>Sign Out
    </a>
  </div>
</aside>

<!-- ═══ MAIN ═══ -->
<main>
  <div class="page-header">
    <div class="ph-left">
      <div class="ph-eyebrow">Account Security</div>
      <h1 class="ph-title">Change <em>Email</em></h1>
      <p class="ph-sub">Update the email address associated with your account</p>
    </div>
    <a href="/profile/edit" class="back-link">
      <span class="material-symbols-outlined">arrow_back_ios</span>Back to Edit
    </a>
  </div>

  <div class="content-grid">

    <!-- FORM CARD -->
    <div class="form-card">
      <div class="form-card-top">
        <div class="card-label">
          <span class="material-symbols-outlined">mail</span>
          Email Address
        </div>

        <div class="cur-email">
          <span class="material-symbols-outlined">verified_user</span>
          <div>
            <div class="ce-label">Current Email</div>
            <div class="ce-val"><%= user.email %></div>
          </div>
        </div>
      </div>

      <form id="emailForm" novalidate>
        <div class="form-body">
          <div class="field-group">
            <label class="field-label" for="newEmail">New Email Address</label>
            <div class="field-wrap">
              <span class="field-icon material-symbols-outlined">alternate_email</span>
              <input
                class="field-input"
                type="email"
                id="newEmail"
                name="newEmail"
                placeholder="your@newemail.com"
                autocomplete="email"
              />
            </div>
            <div class="field-error" id="newEmail-err"></div>
          </div>

          <div class="field-group" style="margin-bottom:0">
            <label class="field-label" for="confirmEmail">Confirm New Email</label>
            <div class="field-wrap">
              <span class="field-icon material-symbols-outlined">mark_email_read</span>
              <input
                class="field-input"
                type="email"
                id="confirmEmail"
                name="confirmEmail"
                placeholder="Repeat your new email"
              />
            </div>
            <div class="field-error" id="confirmEmail-err"></div>
          </div>
        </div>

        <div class="form-divider"></div>

        <div class="form-actions">
         <button type="button" class="btn-submit" onclick="window.location.href='/otp'">
  <span class="material-symbols-outlined">send</span>
  Send Verification Code
</button>


          <a href="/profile/edit" class="btn-cancel">Cancel</a>
        </div>
      </form>
    </div>

    <!-- RIGHT PANEL -->
    <div class="info-panel">
      <!-- How it works -->
      <div class="info-card">
        <div class="info-card-icon blue">
          <span class="material-symbols-outlined">info</span>
        </div>
        <div class="info-card-title">How it works</div>
        <div class="steps-list">
          <div class="step-item">
            <div class="step-num">1</div>
            <div class="step-text">Enter your <strong>new email address</strong> and confirm it below.</div>
          </div>
          <div class="step-item">
            <div class="step-num">2</div>
            <div class="step-text">We send a <strong>4-digit OTP</strong> to your new email for verification.</div>
          </div>
          <div class="step-item">
            <div class="step-num">3</div>
            <div class="step-text">Enter the code and your <strong>email is updated</strong> instantly.</div>
          </div>
        </div>
      </div>

      <!-- Security tips -->
      <div class="info-card">
        <div class="info-card-icon green">
          <span class="material-symbols-outlined">shield</span>
        </div>
        <div class="info-card-title" style="margin-bottom:14px">Security Tips</div>
        <div>
          <div class="security-tip">
            <span class="material-symbols-outlined">check_circle</span>
            <div class="security-tip-text">Use an email only you have access to</div>
          </div>
          <div class="security-tip">
            <span class="material-symbols-outlined">check_circle</span>
            <div class="security-tip-text">Avoid shared or work emails for personal accounts</div>
          </div>
          <div class="security-tip">
            <span class="material-symbols-outlined">check_circle</span>
            <div class="security-tip-text">The OTP expires in 1 minutes — have access ready</div>
          </div>
          <div class="security-tip">
            <span class="material-symbols-outlined">check_circle</span>
            <div class="security-tip-text">Check your spam folder if you don't receive the code</div>
          </div>
        </div>
      </div>
    </div>

  </div>
</main>

<script>
function validateEmail(v) {
  if (!v.trim()) return 'Email address is required';
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim())) return 'Enter a valid email address';
  return '';
}

function setErr(fieldId, msg) {
  const errEl = document.getElementById(fieldId + '-err');
  const inp = document.getElementById(fieldId);
  if (msg) {
    errEl.innerHTML = `<span class="material-symbols-outlined">error</span>${msg}`;
    inp.classList.add('has-error');
  } else {
    errEl.innerHTML = '';
    inp.classList.remove('has-error');
  }
}

// Live clear errors on input
['newEmail', 'confirmEmail'].forEach(id => {
  document.getElementById(id).addEventListener('input', () => setErr(id, ''));
});

document.getElementById('emailForm').addEventListener('submit', async function(e) {
  e.preventDefault();

  const newVal = document.getElementById('newEmail').value.trim();
  const confVal = document.getElementById('confirmEmail').value.trim();
  let valid = true;

  const emailErr = validateEmail(newVal);
  setErr('newEmail', emailErr);
  if (emailErr) valid = false;

  if (!confVal) {
    setErr('confirmEmail', 'Please confirm your new email');
    valid = false;
  } else if (newVal !== confVal) {
    setErr('confirmEmail', 'Email addresses do not match');
    valid = false;
  } else {
    setErr('confirmEmail', '');
  }

  if (!valid) return;

  const btn = document.getElementById('sendOtpBtn');
  btn.disabled = true;
  btn.innerHTML = '<div class="spinner"></div>Sending Code...';

  try {
    const res = await fetch('/profile/send-otp', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ newEmail: newVal })
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.message || 'Failed to send OTP');
    window.location.href = '/profile/verify-otp';
  } catch (err) {
    // demo: navigate anyway
    window.location.href = '/profile/verify-otp';
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<span class="material-symbols-outlined">send</span>Send Verification Code';
  }
});
</script>
</body>
</html>