<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>LUXE | Wallet</title>
<script src="/js/blockedUserGuard.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Syne:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@300,0..1&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg: #080c14; --sur: #0e1523; --sur2: #141c2e; --sur3: #1a2338; --sur4: #212c42;
    --bord: rgba(255,255,255,0.07); --bord2: rgba(255,255,255,0.13);
    --pri: #3a6ff7; --gold: #c9a96e; --gold2: #e0c08a;
    --txt: #e8edf8; --txt2: #8892a4; --txt3: #5a6478;
    --green: #22c55e; --red: #ef4444;
    --nav-h: 68px; --side-w: 260px; --r: 12px; --rl: 18px;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--txt); min-height: 100vh; overflow-x: hidden; }
  ::-webkit-scrollbar { width: 4px; } ::-webkit-scrollbar-track { background: var(--bg); } ::-webkit-scrollbar-thumb { background: var(--sur4); border-radius: 99px; }

  /* ── NAV ── */
  nav.topnav {
    position: fixed; top: 0; left: 0; right: 0; height: var(--nav-h);
    background: rgba(8,12,20,0.9); backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--bord);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 36px; z-index: 100;
  }
  .brand { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 1rem; letter-spacing: .22em; text-transform: uppercase; }
  .brand span { color: var(--gold); }
  .nav-links { display: flex; gap: 32px; list-style: none; }
  .nav-links a { font-family: 'Syne', sans-serif; font-size: .6rem; letter-spacing: .18em; text-transform: uppercase; color: var(--txt2); text-decoration: none; transition: color .2s; }
  .nav-links a:hover { color: var(--txt); }
  .nav-acts { display: flex; align-items: center; gap: 16px; }
  .nav-btn { background: none; border: none; cursor: pointer; color: var(--txt2); display: flex; align-items: center; transition: color .2s; }
  .nav-btn:hover { color: var(--txt); } .nav-btn.on { color: var(--pri); }
  .nav-btn .ms { font-size: 22px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }

  /* ── SIDEBAR ── */
  aside.sidebar {
    position: fixed; top: var(--nav-h); left: 0;
    width: var(--side-w); height: calc(100vh - var(--nav-h));
    background: var(--sur); border-right: 1px solid var(--bord);
    display: flex; flex-direction: column; padding: 28px 0 20px; z-index: 50; overflow-y: auto;
  }
  .sidebar-header { padding: 0 24px 24px; border-bottom: 1px solid var(--bord); margin-bottom: 12px; }
  .sidebar-header h3 { font-family: 'Syne', sans-serif; font-weight: 700; font-size: .9rem; margin-bottom: 6px; }
  .sidebar-tier { display: inline-flex; align-items: center; gap: 5px; background: rgba(201,169,110,.1); border: 1px solid rgba(201,169,110,.25); border-radius: 99px; padding: 3px 10px; }
  .sidebar-tier span { font-family: 'Syne', sans-serif; font-size: .5rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--gold); }
  .tier-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--gold); flex-shrink: 0; }
  .sidebar-nav { display: flex; flex-direction: column; gap: 2px; padding: 0 10px; }
  .sidebar-link {
    display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 8px;
    text-decoration: none; color: var(--txt2); font-size: .625rem; font-family: 'Syne', sans-serif;
    font-weight: 600; letter-spacing: .1em; text-transform: uppercase; transition: all .2s;
  }
  .sidebar-link .material-symbols-outlined { font-size: 17px; flex-shrink: 0; font-variation-settings: 'FILL' 0, 'wght' 300; }
  .sidebar-link:hover { background: var(--sur3); color: var(--txt); }
  .sidebar-link.active { background: rgba(58,111,247,.12); color: var(--pri); }
  .sidebar-footer { margin-top: auto; padding: 18px 24px 0; border-top: 1px solid var(--bord); }
  .sidebar-footer a { display: flex; align-items: center; gap: 9px; text-decoration: none; color: var(--txt3); font-size: .625rem; font-family: 'Syne', sans-serif; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; transition: color .2s; }
  .sidebar-footer a:hover { color: var(--txt2); }
  .sidebar-footer .material-symbols-outlined { font-size: 17px; font-variation-settings: 'FILL' 0, 'wght' 300; }

  /* ── MAIN ── */
  main { margin-left: var(--side-w); padding: calc(var(--nav-h) + 44px) 48px 80px; min-height: 100vh; }
  .page-header { margin-bottom: 36px; display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; }
  .page-header h1 { font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: 3.2rem; letter-spacing: -.01em; line-height: 1.05; margin-bottom: 6px; }
  .page-header h1 em { font-style: italic; color: var(--gold2); }
  .page-header p { color: var(--txt3); font-size: .82rem; font-weight: 300; }

  .sync-info { text-align: right; }
  .sync-info p { font-size: .72rem; color: var(--txt3); margin-bottom: 6px; }
  .live-row { display: flex; align-items: center; gap: 6px; justify-content: flex-end; }
  @keyframes livepulse { 0%,100%{opacity:1} 50%{opacity:.35} }
  .live-dot { width: 7px; height: 7px; background: var(--green); border-radius: 50%; display: inline-block; animation: livepulse 2s infinite; }
  .live-label { color: var(--green); font-size: .68rem; font-weight: 700; font-family: 'Syne', sans-serif; letter-spacing: .08em; text-transform: uppercase; }

  /* ── Detail-style cards (same as profile.ejs) ── */
  .detail-card { background: var(--sur); border: 1px solid var(--bord); border-radius: var(--rl); padding: 28px; animation: fu .5s ease both; }
  .card-title { font-family: 'Syne', sans-serif; font-weight: 700; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; color: var(--txt2); margin-bottom: 20px; display: flex; align-items: center; gap: 8px; }
  .card-title .ms { font-size: 16px; color: var(--pri); font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }

  /* ── Balance card ── */
  .balance-card { position: relative; overflow: hidden; margin-bottom: 24px; }
  .balance-card::before { content: ''; position: absolute; top: -60px; right: -60px; width: 220px; height: 220px; background: radial-gradient(circle, rgba(58,111,247,.14), transparent 70%); pointer-events: none; }
  .balance-label { font-family: 'Syne', sans-serif; font-size: .52rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--txt3); margin-bottom: 14px; }
  .balance-amount { display: flex; align-items: baseline; gap: 10px; position: relative; z-index: 1; }
  .balance-amount .val { font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 3rem; color: var(--txt); line-height: 1; }
  .balance-amount .ms { font-size: 30px; color: var(--gold2); font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 1, 'wght' 300; }
  .balance-sub { display: flex; align-items: center; gap: 5px; color: var(--green); font-size: .72rem; font-weight: 500; margin-top: 12px; }
  .balance-sub .ms { font-size: 15px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }

  /* ── Transaction table ── */
  .table-card { padding: 0; overflow: hidden; }
  .table-card .card-title { padding: 24px 28px 0; margin-bottom: 18px; }
  table.tx-table { width: 100%; text-align: left; border-collapse: collapse; }
  table.tx-table thead tr { background: rgba(255,255,255,.03); }
  table.tx-table th { padding: 12px 28px; font-family: 'Syne', sans-serif; font-size: .52rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--txt3); }
  table.tx-table th.right { text-align: right; }
  table.tx-table td { padding: 15px 28px; font-size: .8rem; border-top: 1px solid var(--bord); }
  table.tx-table tbody tr { transition: background .15s; }
  table.tx-table tbody tr:hover { background: rgba(255,255,255,.02); }
  .tx-reason { color: var(--txt); font-weight: 500; }
  .tx-date { color: var(--txt3); font-size: .75rem; }
  .tx-amount { text-align: right; font-weight: 700; font-size: .82rem; display: flex; align-items: center; justify-content: flex-end; gap: 4px; }
  .tx-amount .ms { font-size: 13px; opacity: .8; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 1, 'wght' 300; }
  .tx-amount.credit { color: var(--green); }
  .tx-amount.debit { color: var(--red); }

  .badge-ok { display: inline-flex; align-items: center; gap: 4px; background: rgba(34,197,94,.08); border: 1px solid rgba(34,197,94,.2); border-radius: 99px; padding: 3px 10px; font-family: 'Syne', sans-serif; font-size: .5rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #4ade80; }

  .empty-state { padding: 60px 28px; text-align: center; color: var(--txt3); font-size: .82rem; }
  .empty-state .ms { font-size: 32px; display: block; margin-bottom: 10px; opacity: .35; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }

  @keyframes fu { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }

  @media (max-width: 900px) { :root { --side-w: 0px; } aside.sidebar { display: none; } main { padding: calc(var(--nav-h) + 28px) 20px 60px; } .nav-links { display: none; } }
  @media (max-width: 600px) { .page-header { flex-direction: column; align-items: flex-start; } .sync-info { text-align: left; } table.tx-table th:nth-child(2), table.tx-table td:nth-child(2) { display: none; } }
</style>
  <link rel="stylesheet" href="/css/navigation-consistency.css" />
</head>
<body>

<!-- ── NAV ── -->
<nav class="topnav">
  <div class="brand">LUXE <span>ATELIER</span></div>
  <ul class="nav-links">
    <li><a href="/">Showroom</a></li>
    <li><a href="/product-listing">Collections</a></li>
  </ul>
  <div class="nav-acts">
    <a href="/cart" class="nav-btn"><span class="ms material-symbols-outlined">shopping_bag</span></a>
    <a href="/profile" class="nav-btn"><span class="ms material-symbols-outlined">person</span></a>
  </div>
</nav>

<!-- ── SIDEBAR ── -->
<aside class="sidebar">
  <div class="sidebar-header">
    <h3>User Account</h3>
    <div class="sidebar-tier">
      <div class="tier-dot"></div>
    </div>
  </div>
  <nav class="sidebar-nav">
    <a href="/profile" class="sidebar-link">
      <span class="material-symbols-outlined">person</span>
      <span>Profile</span>
    </a>
    <a href="/order/my-orders" class="sidebar-link">
      <span class="material-symbols-outlined">package_2</span>
      <span>My Orders</span>
    </a>
    <a href="/address" class="sidebar-link">
      <span class="material-symbols-outlined">distance</span>
      <span>Manage Address</span>
    </a>
    <a href="/changePassword" class="sidebar-link">
      <span class="material-symbols-outlined">lock_reset</span>
      <span>Change Password</span>
    </a>
    <a href="/wishlist" class="sidebar-link">
      <span class="material-symbols-outlined">favorite</span>
      <span>Wishlist</span>
    </a>
    <a href="/referal" class="sidebar-link">
      <span class="material-symbols-outlined">share_reviews</span>
      <span>Referral Link</span>
    </a>
    <a href="/wallet" class="sidebar-link active">
      <span class="material-symbols-outlined">account_balance_wallet</span>
      <span>Wallet</span>
    </a>
  </nav>
  <div class="sidebar-footer">
    <a href="/logout">
      <span class="material-symbols-outlined">logout</span>
      <span>Sign Out</span>
    </a>
  </div>
</aside>

<!-- ── MAIN ── -->
<main>
  <div class="page-header">
    <div>
      <h1>Wallet <em>Overview</em></h1>
      <p>Your balance and transaction history at a glance.</p>
    </div>
    <div class="sync-info">
      <p>Last synced: Today, <%= time %></p>
      <div class="live-row">
        <span class="live-dot"></span>
        <span class="live-label">Live</span>
      </div>
    </div>
  </div>

  <!-- Balance Card -->
  <div class="detail-card balance-card">
    <div class="balance-label">Total Available Balance</div>
    <div class="balance-amount">
      <span class="ms material-symbols-outlined">account_balance_wallet</span>
      <span class="val">₹<%= balance %></span>
    </div>
    <div class="balance-sub">
      <span class="ms material-symbols-outlined">trending_up</span>
      Available for orders &amp; refunds
    </div>
  </div>

  <!-- Transaction History -->
  <div class="detail-card table-card">
    <div class="card-title"><span class="ms material-symbols-outlined">receipt_long</span>Transaction History</div>

    <table class="tx-table">
      <thead>
        <tr>
          <th>Reason</th>
          <th>Date</th>
          <th>Status</th>
          <th class="right">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% if (transaction && transaction.length > 0) { %>
          <% transaction.forEach(function(t) { %>
            <tr>
              <td class="tx-reason"><%= t.reason %></td>
              <td class="tx-date"><%= t.createdAt.toDateString() %></td>
              <td><span class="badge-ok">Completed</span></td>
              <td>
                <div class="tx-amount <%= t.type === 'credit' ? 'credit' : 'debit' %>">
                  <%= t.type === 'credit' ? '+' : '-' %>
                  <span class="ms material-symbols-outlined">account_balance_wallet</span><%= t.amount %>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="4">
              <div class="empty-state">
                <span class="ms material-symbols-outlined">inbox</span>
                No transactions yet
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

</main>

<script>
  function showToast(msg, type) {
    type = type || "success";
    const toast = document.createElement("div");
    toast.innerText = msg;
    toast.style.position = "fixed";
    toast.style.bottom = "20px";
    toast.style.right = "20px";
    toast.style.padding = "12px 16px";
    toast.style.borderRadius = "8px";
    toast.style.color = "#fff";
    toast.style.fontSize = "14px";
    toast.style.zIndex = "9999";
    toast.style.boxShadow = "0 8px 20px rgba(0,0,0,0.2)";
    toast.style.background = type === "success" ? "#22c55e" : "#ef4444";
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 3000);
  }

  document.addEventListener("DOMContentLoaded", () => {
    <% if (typeof flash !== 'undefined' && flash) { %>
      showToast("<%= flash.text %>", "<%= flash.type %>");
    <% } %>
  });
</script>

</body>
</html>
