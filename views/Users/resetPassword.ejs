<!DOCTYPE html>
<html class="dark" lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200;300;400;500;600;700;800&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#1152d4",
                        "background-dark": "#101622",
                        "accent-gold": "#d4af37",
                        "success": "#10b981",
                        "error": "#ef4444"
                    },
                    fontFamily: { "display": ["Manrope", "sans-serif"] }
                },
            },
        }
    </script>
    <style>
        body { font-family: 'Manrope', sans-serif; }
        .luxury-gradient { background: linear-gradient(135deg, #1a2235 0%, #101622 100%); }
        .input-error { border-color: #ef4444 !important; background-color: rgba(239, 68, 68, 0.05); }
        .requirement-item { display: flex; align-items: center; gap: 8px; font-size: 0.75rem; transition: all 0.3s ease; }
        .valid { color: #10b981; }
        .invalid { color: #64748b; }
        #successPopup { backdrop-filter: blur(8px); display: none; }
    </style>
</head>
<body class="bg-background-dark text-slate-100 font-display overflow-hidden">
    

<div id="successPopup" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80">
    <div class="bg-slate-900 border border-slate-800 p-8 rounded-2xl max-w-sm w-full text-center shadow-2xl transform transition-all scale-95 opacity-0" id="modalContent">
        <div class="size-16 bg-success/20 text-success rounded-full flex items-center justify-center mx-auto mb-6">
            <span class="material-symbols-outlined text-4xl">check_circle</span>
        </div>
        <h3 class="text-white text-2xl font-bold mb-2">Password Updated</h3>
        <p class="text-slate-400 mb-8 font-light">Your administrative credentials have been securely synchronized.</p>
        <a href="/login" class="block w-full bg-primary hover:bg-primary/90 text-white font-bold py-3 rounded-lg text-center transition-all">
  RETURN TO LOGIN
</a>


    </div>
</div>

<div class="flex min-h-screen">
    <div class="hidden lg:flex lg:w-1/2 relative overflow-hidden bg-slate-900">
        <div class="absolute inset-0 bg-cover bg-center opacity-60" style='background-image: url("https://images.unsplash.com/photo-1617137968427-85924c800a22?q=80&w=1974&auto=format&fit=crop");'></div>
        <div class="absolute inset-0 bg-gradient-to-t from-background-dark via-transparent to-transparent"></div>
        <div class="relative z-10 flex flex-col justify-end p-20 w-full">
            <div class="border-l-2 border-accent-gold pl-6">
                <h1 class="text-4xl font-extrabold tracking-tight text-white mb-2 uppercase italic">Luxe</h1>
                <p class="text-slate-400 text-sm tracking-widest uppercase">The Essence of Modern Luxury</p>
            </div>
        </div>
    </div>

    <div class="w-full lg:w-1/2 flex flex-col luxury-gradient min-h-screen overflow-y-auto">
        <header class="flex items-center justify-between px-8 lg:px-16 py-10">
            <div class="flex items-center gap-3">
                <div class="size-8 text-primary">
                    <svg fill="none" viewbox="0 0 48 48" xmlns="http://www.w3.org/2000/svg"><path d="M44 11.2727C44 14.0109 39.8386 16.3957 33.69 17.6364C39.8386 18.877 44 21.2618 44 24C44 26.7382 39.8386 29.123 33.69 30.3636C39.8386 31.6043 44 33.9891 44 36.7273C44 40.7439 35.0457 44 24 44C12.9543 44 4 40.7439 4 36.7273C4 33.9891 8.16144 31.6043 14.31 30.3636C8.16144 29.123 4 26.7382 4 24C4 21.2618 8.16144 18.877 14.31 17.6364C8.16144 16.3957 4 14.0109 4 11.2727C4 7.25611 12.9543 4 24 4C35.0457 4 44 7.25611 44 11.2727Z" fill="currentColor"></path></svg>
                </div>
                <div class="flex flex-col">
                    <span class="text-white text-xl font-bold tracking-tight">LUXE</span>
                    <span class="text-slate-500 text-[10px] uppercase tracking-[0.2em] font-bold">Admin Portal</span>
                </div>
            </div>
        </header>

        <main class="flex-1 flex flex-col justify-center px-8 lg:px-16 pb-20 max-w-xl mx-auto lg:mx-0 w-full">
            <div class="mb-8">
                <h2 class="text-white text-4xl font-black mb-3">Reset Password</h2>
                <p class="text-slate-400 text-lg font-light">Update your credentials to maintain account security.</p>
            </div>

            <form id="resetForm" class="space-y-5" novalidate method="post" action="/reset-password">
                <div class="flex flex-col gap-2">
                    <label class="text-slate-300 text-xs font-bold uppercase tracking-widest">New Password</label>
                    <div class="relative">
                        <input id="password" class="w-full bg-slate-800/40 border border-slate-700 focus:border-primary focus:ring-1 focus:ring-primary rounded-lg h-14 px-4 text-white transition-all outline-none" placeholder="••••••••" type="password" name="password"/>
                        <button type="button" class="toggle-password absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 hover:text-white transition-colors">
                            <span class="material-symbols-outlined">visibility</span>
                        </button>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-2 mt-2">
                        <div id="req-length" class="requirement-item invalid"><span class="material-symbols-outlined text-sm">circle</span> 8+ Characters</div>
                        <div id="req-upper" class="requirement-item invalid"><span class="material-symbols-outlined text-sm">circle</span> 1 Uppercase</div>
                        <div id="req-number" class="requirement-item invalid"><span class="material-symbols-outlined text-sm">circle</span> 1 Number</div>
                        <div id="req-symbol" class="requirement-item invalid"><span class="material-symbols-outlined text-sm">circle</span> 1 Symbol</div>
                    </div>
                </div>

                <div class="flex flex-col gap-2">
                    <label class="text-slate-300 text-xs font-bold uppercase tracking-widest">Confirm Password</label>
                    <div class="relative">
                        <input id="confirmPassword" class="w-full bg-slate-800/40 border border-slate-700 focus:border-primary focus:ring-1 focus:ring-primary rounded-lg h-14 px-4 text-white transition-all outline-none" placeholder="••••••••" type="password" name="confirmPassword"/>
                        <button type="button" class="toggle-password absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 hover:text-white transition-colors">
                            <span class="material-symbols-outlined">visibility</span>
                        </button>
                    </div>
                    <p id="matchError" class="text-error text-[10px] uppercase font-bold hidden flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">error</span> Passwords do not match
                    </p>
                </div>

                <div class="pt-4">
                    <button type="submit" class="w-full bg-primary hover:bg-primary/90 text-white font-bold py-4 rounded-lg shadow-xl shadow-primary/20 transition-all flex items-center justify-center gap-2 group uppercase tracking-widest">
                        <span>Update Password</span>
                        <span class="material-symbols-outlined text-xl group-hover:translate-x-1 transition-transform">arrow_forward</span>
                    </button>
                </div>
            </form>
        </main>
    </div>
</div>

<script>
    const passwordInput = document.getElementById('password');
    const confirmInput = document.getElementById('confirmPassword');
    const resetForm = document.getElementById('resetForm');
    const successPopup = document.getElementById('successPopup');
    const modalContent = document.getElementById('modalContent');

    // Toggle Eye Buttons
    document.querySelectorAll('.toggle-password').forEach(btn => {
        btn.addEventListener('click', function() {
            const input = this.parentElement.querySelector('input');
            const icon = this.querySelector('span');
            input.type = input.type === 'password' ? 'text' : 'password';
            icon.textContent = input.type === 'password' ? 'visibility' : 'visibility_off';
        });
    });

    // Validation Regex
    const validate = () => {
        const val = passwordInput.value;
        const requirements = {
            'req-length': val.length >= 8,
            'req-upper': /[A-Z]/.test(val),
            'req-number': /[0-9]/.test(val),
            'req-symbol': /[!@#$%^&*(),.?":{}|<>]/.test(val)
        };

        let allMet = true;
        for (const [id, meets] of Object.entries(requirements)) {
            const el = document.getElementById(id);
            const icon = el.querySelector('span');
            if (meets) {
                el.classList.replace('invalid', 'valid');
                icon.textContent = 'check_circle';
            } else {
                el.classList.replace('valid', 'invalid');
                icon.textContent = 'circle';
                allMet = false;
            }
        }
        return allMet;
    };

    passwordInput.addEventListener('input', validate);




   resetForm.addEventListener('submit', async (e) => {
    e.preventDefault();

    const isStrong = validate();
    const matches = passwordInput.value === confirmInput.value;

    if (!isStrong || !matches) return;

    try {
        const res = await fetch("/reset-password", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                password: passwordInput.value,
                confirmPassword: confirmInput.value
            })
        });

        const data = await res.json();

        if (data.success) {
          
            successPopup.style.display = 'flex';

            setTimeout(() => {
                modalContent.classList.remove('scale-95', 'opacity-0');
                modalContent.classList.add('scale-100', 'opacity-100');
            }, 10);

            
            setTimeout(() => {
                window.location.href = "/login";
            }, 3000);

        } else {
            alert(data.message);
        }

    } catch (err) {
        console.log(err);
        alert("Something went wrong");
    }
});

</script>
</body>
</html>