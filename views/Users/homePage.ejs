                                        class="material-symbols-outlined text-4xl text-slate-400 mb-3 block">search_off</span>
                                    <p class="text-slate-500 font-semibold">
                                        <% if (searchQuery) { %>
                                            No products found for "<%= searchQuery %>"
                                                <% } else { %>
                                                    No products available right now
                                                    <% } %>
                                    </p>
                                    <% if (searchQuery) { %>
                                        <a href="/homePage"
                                            class="text-primary text-sm font-bold hover:underline mt-2 inline-block">Clear
                                            search</a>
                                        <% } %>
