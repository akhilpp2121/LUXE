
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Order <%= order.orderCode %> — Admin</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg:        #0a0a0f;
    --surface:   #111118;
    --surface2:  #18181f;
    --border:    #2a2a35;
    --border2:   #1e1e28;
    --text:      #e8e8f0;
    --muted:     #6b6b80;
    --accent:    #6366f1;
    --accent2:   #818cf8;
    --mono:      'JetBrains Mono', monospace;
    --sans:      'DM Sans', sans-serif;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: var(--sans);
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
  }

  .msym { font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24; }

  .admin-layout { display: flex; min-height: 100vh; }

  .sidebar {
    width: 220px; flex-shrink: 0;
    background: var(--surface);
    border-right: 1px solid var(--border);
    padding: 28px 0;
    display: flex; flex-direction: column;
  }
  .sidebar-logo {
    font-family: var(--mono); font-weight: 700; font-size: 18px;
    color: var(--accent2); padding: 0 24px 28px;
    border-bottom: 1px solid var(--border); letter-spacing: 0.05em;
  }
  .sidebar-logo span { color: var(--muted); font-weight: 400; }
  .sidebar-nav { padding: 20px 12px; flex: 1; }
  .nav-item {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 14px; border-radius: 8px;
    color: var(--muted); font-size: 13px; font-weight: 500;
    text-decoration: none; transition: all 0.15s; margin-bottom: 2px;
  }
  .nav-item:hover { background: var(--surface2); color: var(--text); }
  .nav-item.active { background: rgba(99,102,241,0.12); color: var(--accent2); }
  .nav-item .msym { font-size: 18px; }

  .main { flex: 1; overflow-y: auto; }

  .topbar {
    position: sticky; top: 0; z-index: 40;
    background: var(--surface); border-bottom: 1px solid var(--border);
    padding: 16px 32px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .breadcrumb {
    display: flex; align-items: center; gap: 8px;
    font-size: 13px; color: var(--muted); font-family: var(--mono);
  }
  .breadcrumb a { color: var(--muted); text-decoration: none; transition: color 0.15s; }
  .breadcrumb a:hover { color: var(--accent2); }
  .breadcrumb .sep { color: var(--border); }
  .breadcrumb .current { color: var(--text); }

  .content { padding: 32px; max-width: 1100px; }

  .order-header {
    display: flex; align-items: flex-start;
    justify-content: space-between; gap: 20px; margin-bottom: 32px;
  }
  .order-code {
    font-family: var(--mono); font-size: 22px; font-weight: 700;
    color: var(--text); letter-spacing: 0.04em;
  }
  .order-code span { color: var(--accent2); }
  .order-meta { display: flex; align-items: center; gap: 16px; margin-top: 6px; }
  .meta-chip {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 11px; font-weight: 600;
    padding: 3px 10px; border-radius: 20px;
    text-transform: uppercase; letter-spacing: 0.06em;
    font-family: var(--mono); border: 1px solid transparent;
  }
  .chip-pending             { background: rgba(234,179,8,0.1);   color: #fbbf24; border-color: rgba(251,191,36,0.2); }
  .chip-shipped             { background: rgba(59,130,246,0.1);  color: #60a5fa; border-color: rgba(96,165,250,0.2); }
  .chip-out_for_delivery    { background: rgba(168,85,247,0.1);  color: #c084fc; border-color: rgba(192,132,252,0.2); }
  .chip-delivered           { background: rgba(34,197,94,0.1);   color: #4ade80; border-color: rgba(74,222,128,0.2); }
  .chip-cancelled           { background: rgba(239,68,68,0.1);   color: #f87171; border-color: rgba(248,113,113,0.2); }
  .chip-placed              { background: rgba(99,102,241,0.1);  color: #818cf8; border-color: rgba(129,140,248,0.2); }
  .chip-completed           { background: rgba(34,197,94,0.1);   color: #4ade80; border-color: rgba(74,222,128,0.2); }
  .chip-partially_delivered { background: rgba(59,130,246,0.1);  color: #60a5fa; border-color: rgba(96,165,250,0.2); }
  .chip-returned            { background: rgba(168,85,247,0.1);  color: #c084fc; border-color: rgba(192,132,252,0.2); }
  .chip-cod                 { background: rgba(99,102,241,0.08); color: var(--muted); border-color: var(--border); }

  .card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 14px; overflow: hidden; margin-bottom: 20px;
  }
  .card-header {
    padding: 16px 22px; border-bottom: 1px solid var(--border2);
    display: flex; align-items: center; justify-content: space-between;
  }
  .card-title {
    font-size: 11px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--muted); font-family: var(--mono);
    display: flex; align-items: center; gap: 8px;
  }
  .card-title .msym { font-size: 16px; color: var(--accent2); }
  .card-body { padding: 22px; }

  .stepper { display: flex; align-items: center; gap: 0; margin-bottom: 28px; position: relative; }
  .step { display: flex; flex-direction: column; align-items: center; flex: 1; position: relative; z-index: 1; }
  .step-connector {
    flex: 1; height: 2px; background: var(--border);
    position: relative; top: -14px; z-index: 0; transition: background 0.4s;
  }
  .step-connector.done { background: var(--accent); }
  .step-dot {
    width: 32px; height: 32px; border-radius: 50%;
    border: 2px solid var(--border); background: var(--surface2);
    display: flex; align-items: center; justify-content: center;
    transition: all 0.3s; margin-bottom: 8px;
  }
  .step-dot .msym { font-size: 15px; color: var(--muted); }
  .step.done .step-dot   { border-color: var(--accent); background: rgba(99,102,241,0.15); }
  .step.done .step-dot .msym { color: var(--accent2); }
  .step.active .step-dot { border-color: var(--accent2); background: rgba(99,102,241,0.25); box-shadow: 0 0 0 4px rgba(99,102,241,0.12); }
  .step.active .step-dot .msym { color: var(--accent2); font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
  .step-label { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); text-align: center; white-space: nowrap; font-family: var(--mono); }
  .step.active .step-label { color: var(--accent2); }
  .step.done .step-label  { color: var(--text); }

  .status-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; margin-bottom: 20px; }
  .status-option {
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    padding: 14px 8px; border-radius: 10px;
    border: 1px solid var(--border); background: var(--surface2);
    cursor: pointer; transition: all 0.2s; position: relative;
  }
  .status-option:hover { border-color: var(--accent); background: rgba(99,102,241,0.06); }
  .status-option.selected { border-color: var(--accent2); background: rgba(99,102,241,0.12); }
  .status-option.selected::after {
    content: ''; position: absolute; top: 6px; right: 6px;
    width: 8px; height: 8px; border-radius: 50%; background: var(--accent2);
  }
  .status-option .msym { font-size: 22px; color: var(--muted); transition: color 0.2s; }
  .status-option:hover .msym, .status-option.selected .msym { color: var(--accent2); }
  .status-option span.label {
    font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--muted); text-align: center; font-family: var(--mono); line-height: 1.3; transition: color 0.2s;
  }
  .status-option:hover span.label, .status-option.selected span.label { color: var(--text); }

  .status-option.danger { border-color: rgba(239,68,68,0.2); }
  .status-option.danger:hover { border-color: #ef4444; background: rgba(239,68,68,0.08); }
  .status-option.danger:hover .msym { color: #f87171; }
  .status-option.danger:hover span.label { color: #f87171; }
  .status-option.danger.selected { border-color: #ef4444; background: rgba(239,68,68,0.1); }
  .status-option.danger.selected .msym { color: #f87171; }
  .status-option.danger.selected span.label { color: #f87171; }
  .status-option.danger.selected::after { background: #ef4444; }

  .btn-update {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--accent); color: #fff;
    font-size: 13px; font-weight: 700;
    padding: 11px 24px; border-radius: 9px;
    border: none; cursor: pointer; transition: all 0.2s;
    font-family: var(--sans); letter-spacing: 0.01em;
  }
  .btn-update:hover { background: #4f46e5; transform: translateY(-1px); box-shadow: 0 6px 20px rgba(99,102,241,0.35); }
  .btn-update:active { transform: translateY(0); }
  .btn-update:disabled { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: none; }
  .btn-update .msym { font-size: 17px; }

  .items-table { width: 100%; border-collapse: collapse; }
  .items-table th {
    text-align: left; font-size: 10px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--muted); font-family: var(--mono);
    padding: 0 12px 12px; border-bottom: 1px solid var(--border2);
  }
  .items-table td {
    padding: 14px 12px; border-bottom: 1px solid var(--border2);
    font-size: 13px; color: var(--text); vertical-align: middle;
  }
  .items-table tr:last-child td { border-bottom: none; }
  .item-name    { font-weight: 600; font-size: 13px; margin-bottom: 2px; }
  .item-variant { font-size: 11px; color: var(--muted); font-family: var(--mono); }
  .item-price   { font-family: var(--mono); font-weight: 600; font-size: 13px; }
  .item-total   { font-family: var(--mono); font-weight: 700; font-size: 14px; color: var(--accent2); }

  .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .info-row {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: 9px 0; border-bottom: 1px solid var(--border2); font-size: 13px;
  }
  .info-row:last-child { border-bottom: none; }
  .info-row .label { color: var(--muted); font-size: 12px; }
  .info-row .value { font-weight: 600; font-family: var(--mono); font-size: 12px; }
  .info-row .value.highlight { color: var(--accent2); font-size: 16px; }

  .addr-line { font-size: 13px; color: var(--text); line-height: 1.8; }
  .addr-line strong { color: var(--text); font-weight: 600; display: block; margin-bottom: 4px; }

  #toast {
    position: fixed; bottom: 28px; right: 28px; z-index: 9999;
    transform: translateY(80px); opacity: 0;
    transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    pointer-events: none;
  }
  #toast.show { transform: translateY(0); opacity: 1; }
  .toast-inner {
    display: flex; align-items: center; gap: 12px;
    background: var(--surface); border: 1px solid var(--border);
    padding: 13px 18px; border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.5); min-width: 260px;
  }
  .toast-inner .msym { font-size: 20px; }
  .toast-msg { font-size: 13px; font-weight: 600; }

  @keyframes fadeUp { from { opacity:0; transform:translateY(16px); } to { opacity:1; transform:translateY(0); } }
  .fu { animation: fadeUp 0.4s ease forwards; opacity: 0; }
  .d1 { animation-delay: 0.05s; }
  .d2 { animation-delay: 0.12s; }
  .d3 { animation-delay: 0.19s; }
  .d4 { animation-delay: 0.26s; }

  @media (max-width: 900px) {
    .sidebar { display: none; }
    .status-grid { grid-template-columns: repeat(3, 1fr); }
    .info-grid { grid-template-columns: 1fr; }
    .content { padding: 20px; }
  }
</style>
</head>
<body>

<!-- ══ TOAST ══ -->
<div id="toast">
  <div class="toast-inner">
    <span id="toast-icon" class="material-symbols-outlined msym" style="color:#4ade80;">check_circle</span>
    <span id="toast-msg" class="toast-msg"></span>
  </div>
</div>

<div class="admin-layout">

  <!-- ══ SIDEBAR ══ -->
  <aside class="sidebar">
    <div class="sidebar-logo">LUXE <span>/ admin</span></div>
    <nav class="sidebar-nav">
      <a href="/admin/dashboard" class="nav-item">
        <span class="material-symbols-outlined msym">grid_view</span> Dashboard
      </a>
      <a href="/admin/products" class="nav-item">
        <span class="material-symbols-outlined msym">inventory_2</span> Products
      </a>
      <a href="/admin/users" class="nav-item">
        <span class="material-symbols-outlined msym">group</span> Users
      </a>
      <a href="/admin/order-management" class="nav-item active">
        <span class="material-symbols-outlined msym">receipt_long</span> Orders
      </a>
      <a href="/admin/coupons" class="nav-item">
        <span class="material-symbols-outlined msym">confirmation_number</span> Coupons
      </a>
      <a href="/admin/analystic" class="nav-item">
        <span class="material-symbols-outlined msym">bar_chart</span> Reports
      </a>
    </nav>
  </aside>

  <!-- ══ MAIN ══ -->
  <div class="main">

    <!-- Top bar -->
    <div class="topbar">
      <div class="breadcrumb">
        <a href="/admin/dashboard">home</a>
        <span class="sep">/</span>
        <a href="/admin/order-management">orders</a>
        <span class="sep">/</span>
        <span class="current"><%= order.orderCode %></span>
      </div>
      <a href="/admin/order-management"
         style="display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--muted);text-decoration:none;padding:7px 14px;border:1px solid var(--border);border-radius:7px;transition:all 0.15s;"
         onmouseover="this.style.borderColor='var(--accent)';this.style.color='var(--accent2)'"
         onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--muted)'">
        <span class="material-symbols-outlined msym" style="font-size:15px;">arrow_back</span>
        Back to Orders
      </a>
    </div>

    <div class="content">

      <%
        /* ── Shared variables — declared ONCE, used throughout the template ── */
        const dStatus = order.deliveryStatus || 'pending';
        const oStatus = order.orderStatus   || 'placed';
        const method  = order.orderMethod   || 'cod';

        /* Set of cancelled variant IDs */
        const cancelledVariantIds = new Set();
        (order.cancelledAt || []).forEach(function(cancel) {
          (cancel.cancelledProducts || []).forEach(function(pid) {
            cancelledVariantIds.add(pid.toString ? pid.toString() : String(pid));
          });
        });

        /* Latest return request */
        const latestReturn = (order.returnedAt && order.returnedAt.length > 0)
          ? order.returnedAt[order.returnedAt.length - 1]
          : null;
      %>

      <!-- ── Order Header ── -->
      <div class="order-header fu d1">
        <div>
          <div class="order-code"><span>#</span><%= order.orderCode %></div>
          <div class="order-meta">
            <span class="meta-chip chip-<%= dStatus %>">
              <span class="material-symbols-outlined msym" style="font-size:12px;">local_shipping</span>
              <%= dStatus.replace(/_/g,' ') %>
            </span>
            <span class="meta-chip chip-<%= oStatus %>">
              <span class="material-symbols-outlined msym" style="font-size:12px;">receipt</span>
              <%= oStatus %>
            </span>
            <span class="meta-chip chip-cod" style="text-transform:uppercase;"><%= method %></span>
          </div>
        </div>
        <div style="text-align:right;">
          <div style="font-family:var(--mono);font-size:11px;color:var(--muted);margin-bottom:4px;">Order Date</div>
          <div style="font-family:var(--mono);font-size:13px;font-weight:600;">
            <%= new Date(order.orderDate).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %>
          </div>
          <div style="font-family:var(--mono);font-size:11px;color:var(--muted);margin-top:8px;">Expected Delivery</div>
          <div style="font-family:var(--mono);font-size:13px;font-weight:600;color:#4ade80;">
            <%= new Date(order.expectedDeliveryDate).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %>
          </div>
        </div>
      </div>

      <!-- ── Delivery Status Card ── -->
      <div class="card fu d2">
        <div class="card-header">
          <div class="card-title">
            <span class="material-symbols-outlined msym">local_shipping</span>
            Delivery Status
          </div>
          <span style="font-size:11px;color:var(--muted);font-family:var(--mono);">
            Current: <span id="current-status-label" style="color:var(--accent2);font-weight:700;">
              <%= dStatus.replace(/_/g,' ').toUpperCase() %>
            </span>
          </span>
        </div>
        <div class="card-body">

          <!-- Progress Stepper (hidden when cancelled) -->
          <% if (dStatus !== 'cancelled') { %>
          <%
            const steps = [
              { key: 'pending',          icon: 'hourglass_empty', label: 'Pending'           },
              { key: 'shipped',          icon: 'deployed_code',   label: 'Shipped'           },
              { key: 'out_for_delivery', icon: 'two_wheeler',     label: 'Out for\nDelivery' },
              { key: 'delivered',        icon: 'done_all',        label: 'Delivered'         },
            ];
            const stepOrder  = ['pending','shipped','out_for_delivery','delivered'];
            const currentIdx = stepOrder.indexOf(dStatus);
          %>
          <div class="stepper">
            <% steps.forEach(function(step, i) {
              const isDone   = i < currentIdx;
              const isActive = i === currentIdx;
              const cls = isDone ? 'done' : (isActive ? 'active' : '');
            %>
              <div class="step <%= cls %>">
                <div class="step-dot">
                  <span class="material-symbols-outlined msym"><%= step.icon %></span>
                </div>
                <span class="step-label"><%= step.label %></span>
              </div>
              <% if (i < steps.length - 1) { %>
                <div class="step-connector <%= isDone ? 'done' : '' %>"></div>
              <% } %>
            <% }); %>
          </div>
          <% } %>

          <!-- Status Selector -->
          <%
            const statusOptions = [
              { key: 'pending',          icon: 'hourglass_empty', label: 'Pending',          danger: false },
              { key: 'shipped',          icon: 'deployed_code',   label: 'Shipped',          danger: false },
              { key: 'out_for_delivery', icon: 'two_wheeler',     label: 'Out for Delivery', danger: false },
              { key: 'delivered',        icon: 'done_all',        label: 'Delivered',        danger: false },
            ];
          %>
          <div class="status-grid" id="status-grid">
            <% statusOptions.forEach(function(opt) { %>
              <div class="status-option <%= opt.danger ? 'danger' : '' %> <%= dStatus === opt.key ? 'selected' : '' %>"
                   data-status="<%= opt.key %>"
                   onclick="selectStatus('<%= opt.key %>')">
                <span class="material-symbols-outlined msym"><%= opt.icon %></span>
                <span class="label"><%= opt.label %></span>
              </div>
            <% }); %>
          </div>

          <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
            <button class="btn-update" id="update-btn" onclick="updateStatus()">
              <span class="material-symbols-outlined msym">sync</span>
              Update Status
            </button>
            <span id="status-hint" style="font-size:12px;color:var(--muted);font-family:var(--mono);">
              Select a status above then click update
            </span>
          </div>

        </div>
      </div>

      <!-- ── Order Items ── -->
      <div class="card fu d3">
        <div class="card-header">
          <div class="card-title">
            <span class="material-symbols-outlined msym">shopping_bag</span>
            Order Items
          </div>
          <span style="font-size:11px;color:var(--muted);font-family:var(--mono);">
            <%= order.orderItems.length %> item<%= order.orderItems.length !== 1 ? 's' : '' %>
          </span>
        </div>
        <div style="padding:0 4px;">
          <table class="items-table">
            <thead>
              <tr>
                <th style="width:64px;"></th>
                <th>Product</th>
                <th>Price</th>
                <th>Qty</th>
                <th style="text-align:right;">Total</th>
                <th style="width:250px;text-align:center;">Status</th>
              </tr>
            </thead>
            <tbody>
              <% order.orderItems.forEach(function(item) {
                const itemVariantIdStr = item.variantId.toString ? item.variantId.toString() : String(item.variantId);
                const itemDeliveryStatus = item.deliveryStatus || order.deliveryStatus || 'pending';
                const isCancelled = cancelledVariantIds.has(itemVariantIdStr) || itemDeliveryStatus === 'cancelled';
                const itemReturns = (order.returnedAt || []).filter(function(r) {
                  return r.variant && (r.variant.toString() === itemVariantIdStr);
                });
                const itemReturn = itemReturns.length > 0 ? itemReturns[itemReturns.length - 1] : null;
                const isReturned = itemReturn && itemReturn.returnRequestStatus === 'Approved';
                const isReturnRejected = itemReturn && itemReturn.returnRequestStatus === 'Rejected';
                const isReturnPending = itemReturn && itemReturn.returnRequestStatus === 'Pending';
                const itemStatusOptions = [
                  { key: 'pending', label: 'Pending' },
                  { key: 'shipped', label: 'Shipped' },
                  { key: 'out_for_delivery', label: 'Out for Delivery' },
                  { key: 'delivered', label: 'Delivered' },
                 
                ];
                
                const rowStyle    = isCancelled
                  ? 'opacity:0.5;background:rgba(239,68,68,0.08);'
                  : isReturned
                    ? 'opacity:0.6;background:rgba(168,85,247,0.06);'
                    : '';
                const strikeStyle = (isCancelled || isReturned)
                  ? 'text-decoration:line-through;color:var(--muted);'
                  : '';
              %>
              <tr style="<%= rowStyle %>">
                <td>
                  <div style="width:48px;height:56px;border-radius:7px;background:var(--surface2);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;">
                    <span class="material-symbols-outlined msym" style="color:var(--muted);font-size:20px;">deployed_code</span>
                  </div>
                </td>
                <td>
                  <div class="item-name" style="<%= strikeStyle %>"><%= item.productName %></div>
                  <div class="item-variant"><%= item.variantName %></div>
                </td>
                <td>
                  <span class="item-price" style="<%= strikeStyle %>">
                    ₹<%= item.price.toLocaleString('en-IN') %>
                  </span>
                </td>
                <td>
                  <span style="font-family:var(--mono);font-size:13px;background:var(--surface2);padding:2px 10px;border-radius:5px;border:1px solid var(--border);">
                    × <%= item.quantity %>
                  </span>
                </td>
                <td style="text-align:right;">
                  <span class="item-total" style="<%= strikeStyle %>">
                    ₹<%= item.totalPrice.toLocaleString('en-IN') %>
                  </span>
                </td>
                <td style="text-align:center;">
                  <div style="display:flex;flex-direction:column;align-items:center;gap:8px;">
                    <% if (isCancelled) { %>
                      <span style="display:inline-block;padding:4px 8px;border-radius:4px;background:rgba(239,68,68,0.1);color:#f87171;font-size:11px;font-family:var(--mono);font-weight:600;">CANCELLED</span>
                    <% } else if (isReturned) { %>
                      <span style="display:inline-block;padding:4px 8px;border-radius:4px;background:rgba(168,85,247,0.1);color:#c084fc;font-size:11px;font-family:var(--mono);font-weight:600;">RETURNED</span>
                    <% } else if (isReturnRejected) { %>
                      <span style="display:inline-block;padding:4px 8px;border-radius:4px;background:rgba(239,68,68,0.08);color:#f87171;font-size:11px;font-family:var(--mono);font-weight:600;border:1px solid rgba(239,68,68,0.2);">RTN REJECTED</span>
                    <% } else if (isReturnPending) { %>
                      <span style="display:inline-block;padding:4px 8px;border-radius:4px;background:rgba(251,191,36,0.1);color:#fbbf24;font-size:11px;font-family:var(--mono);font-weight:600;">RTN PENDING</span>
                    <% } else { %>
                      <span style="display:inline-block;padding:4px 8px;border-radius:4px;background:rgba(34,197,94,0.1);color:#4ade80;font-size:11px;font-family:var(--mono);font-weight:600;"><%= itemDeliveryStatus.replace(/_/g, ' ').toUpperCase() %></span>
                    <% } %>

                    <% if (!isCancelled && !isReturned && !isReturnPending) { %>
                      <div style="display:flex;gap:6px;align-items:center;justify-content:center;">
                        <select id="item-status-<%= itemVariantIdStr %>"
                          style="background:var(--surface2);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:6px 8px;font-size:11px;font-family:var(--mono);max-width:138px;">
                          <% itemStatusOptions.forEach(function(opt) { %>
                            <option value="<%= opt.key %>" <%= itemDeliveryStatus === opt.key ? 'selected' : '' %>><%= opt.label %></option>
                          <% }); %>
                        </select>
                        <button onclick="updateItemStatus('<%= itemVariantIdStr %>')"
                          style="display:inline-flex;align-items:center;justify-content:center;background:rgba(99,102,241,0.14);color:var(--accent2);border:1px solid rgba(129,140,248,0.25);border-radius:6px;width:32px;height:32px;cursor:pointer;"
                          title="Update product status">
                          <span class="material-symbols-outlined msym" style="font-size:16px;">sync</span>
                        </button>
                      </div>
                    <% } %>
                  </div>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- ── Address + Payment Summary ── -->
      <div class="info-grid fu d4">

        <!-- Shipping Address -->
        <div class="card">
          <div class="card-header">
            <div class="card-title">
              <span class="material-symbols-outlined msym">location_on</span>
              Shipping Address
            </div>
          </div>
          <div class="card-body">
            <div class="addr-line">
              <strong><%= order.shippingAddress.username %></strong>
              <%= order.shippingAddress.street_address %><br/>
              <% if (order.shippingAddress.landmark) { %>
                Near <%= order.shippingAddress.landmark %>,<br/>
              <% } %>
              <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> — <%= order.shippingAddress.postal_code %><br/>
              <%= order.shippingAddress.country %>
            </div>
            <div style="display:flex;align-items:center;gap:8px;margin-top:14px;padding-top:14px;border-top:1px solid var(--border2);">
              <span class="material-symbols-outlined msym" style="font-size:15px;color:var(--muted);">call</span>
              <span style="font-family:var(--mono);font-size:12px;color:var(--text);">
                <%= order.shippingAddress.phone_number %>
              </span>
            </div>
          </div>
        </div>

        <!-- Payment Summary -->
        <div class="card">
          <div class="card-header">
            <div class="card-title">
              <span class="material-symbols-outlined msym">payments</span>
              Payment Summary
            </div>
          </div>
          <div class="card-body">
            <%
              const activeSubTotal = (order.orderItems || [])
                .filter(function(item) {
                  return !cancelledVariantIds.has(
                    item.variantId.toString ? item.variantId.toString() : String(item.variantId)
                  );
                })
                .reduce(function(sum, item) { return sum + (item.totalPrice || 0); }, 0);

              let proratedCoupon = 0;
              if (order.couponApplied > 0 && order.orderItems.length > 0) {
                const originalSubTotal = (order.orderItems || [])
                  .reduce(function(sum, item) { return sum + (item.totalPrice || 0); }, 0);
                const ratio = originalSubTotal > 0 ? activeSubTotal / originalSubTotal : 0;
                proratedCoupon = order.couponApplied * ratio;
              }

              /* ── GST: recalculated live on the active items subtotal ──
                 (kept in sync with the checkout page's 5% convention, and
                 recomputed here rather than trusting order.gstAmount so it
                 stays correct even after cancellations/returns adjust the
                 active subtotal above) */
              const GST_RATE_VIEW = 0.05;
              const gstAmountView = Math.round(activeSubTotal * GST_RATE_VIEW);

              const finalTotal = activeSubTotal + (order.shippingCharge || 0) - proratedCoupon + gstAmountView;
            %>
            <div class="info-row">
              <span class="label">Subtotal (Active Items)</span>
              <span class="value">₹<%= activeSubTotal.toLocaleString('en-IN', {minimumFractionDigits:2, maximumFractionDigits:2}) %></span>
            </div>
            <% if (order.shippingCharge > 0) { %>
            <div class="info-row">
              <span class="label">Shipping Charge</span>
              <span class="value">₹<%= order.shippingCharge.toLocaleString('en-IN') %></span>
            </div>
            <% } %>

            <% if (proratedCoupon > 0) { %>
            <div class="info-row">
              <span class="label">
                Coupon Discount
                <% if (order.couponCode) { %>
                  <span style="font-size:10px;color:var(--accent2);font-family:var(--mono);margin-left:4px;">
                    (<%= order.couponCode %>)
                  </span>
                <% } %>
              </span>
              <span class="value" style="color:#4ade80;">− ₹<%= proratedCoupon.toLocaleString('en-IN', {minimumFractionDigits:2, maximumFractionDigits:2}) %></span>
            </div>
            <% } %>

            <!-- ── GST row ── -->
            <div class="info-row">
              <span class="label">
                GST
                <span style="font-size:10px;color:var(--muted);font-family:var(--mono);margin-left:4px;">
                  (<%= (GST_RATE_VIEW * 100).toFixed(0) %>%)
                </span>
              </span>
              <span class="value">+ ₹<%= gstAmountView.toLocaleString('en-IN', {minimumFractionDigits:2, maximumFractionDigits:2}) %></span>
            </div>

            <div class="info-row" style="margin-top:8px;padding-top:8px;border-top:1px solid var(--border);">
              <span class="label" style="font-weight:700;color:var(--text);">Grand Total</span>
              <span class="value highlight">₹<%= finalTotal.toLocaleString('en-IN', {minimumFractionDigits:2, maximumFractionDigits:2}) %></span>
            </div>
            <div class="info-row">
              <span class="label">Payment Method</span>
              <span class="value" style="text-transform:uppercase;color:var(--accent2);"><%= order.orderMethod %></span>
            </div>
          </div>
        </div>

      </div>

      <!-- ── Return Requests ── -->


      <!-- ── Return Requests ── -->
<% if (order.returnedAt && order.returnedAt.length > 0) { %>
<div class="card fu d4">
  <div class="card-header">
    <div class="card-title">
      <span class="material-symbols-outlined msym">undo</span>
      Return Requests
    </div>
    <span style="font-size:11px;color:var(--muted);font-family:var(--mono);">
      <%= order.returnedAt.length %> request<%= order.returnedAt.length !== 1 ? 's' : '' %>
    </span>
  </div>
  <div class="card-body" style="padding:0;">
    <% order.returnedAt.forEach(function(ret) {
      const retStatus  = ret.returnRequestStatus || 'Pending';
      const isPending  = retStatus === 'Pending';
      const isApproved = retStatus === 'Approved';
      const isRejected = retStatus === 'Rejected';
      const statusColor = isApproved ? '#4ade80' : isRejected ? '#f87171' : '#fbbf24';
      const statusBg    = isApproved ? 'rgba(34,197,94,0.1)' : isRejected ? 'rgba(239,68,68,0.1)' : 'rgba(251,191,36,0.1)';
      const statusIcon  = isApproved ? 'check_circle' : isRejected ? 'cancel' : 'hourglass_top';
      const retVariantIdStr = ret.variant ? ret.variant.toString() : '';
      const retItem = (order.orderItems || []).find(function(oi) {
        return oi.variantId && (oi.variantId.toString() === retVariantIdStr);
      });
      const retItemName        = retItem ? retItem.productName  : 'Item';
      const retItemVariantName = retItem ? retItem.variantName  : '';
      const retItemQty         = ret.quantity || (retItem ? retItem.quantity : 1);
    %>
      <div style="padding:20px 22px;border-bottom:1px solid var(--border2);">

        <!-- Status + Date row -->
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
          <span style="display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:20px;background:<%= statusBg %>;color:<%= statusColor %>;font-size:11px;font-family:var(--mono);font-weight:700;text-transform:uppercase;letter-spacing:0.06em;">
            <span class="material-symbols-outlined msym" style="font-size:13px;"><%= statusIcon %></span>
            <%= retStatus %>
          </span>
          <span style="font-size:11px;color:var(--muted);font-family:var(--mono);">
            <%= new Date(ret.requestedAt).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %>
            &nbsp;·&nbsp;
            <%= new Date(ret.requestedAt).toLocaleTimeString('en-IN', { hour:'2-digit', minute:'2-digit' }) %>
          </span>
        </div>

        <!-- Item summary -->
        <div style="background:var(--surface2);border:1px solid var(--border2);border-radius:8px;padding:12px;margin-bottom:12px;display:flex;align-items:center;gap:12px;">
          <span class="material-symbols-outlined msym" style="color:var(--accent2);font-size:20px;">shopping_bag</span>
          <div>
            <div style="font-size:13px;color:var(--text);font-weight:600;"><%= retItemName %></div>
            <div style="font-size:11px;color:var(--muted);font-family:var(--mono);">
              <%= retItemVariantName %> · Qty: <%= retItemQty %>
            </div>
          </div>
        </div>

        <!-- Reason / Resolution / Customer remark grid -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;">
          <div style="background:var(--surface2);border:1px solid var(--border2);border-radius:8px;padding:12px;">
            <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--muted);font-family:var(--mono);margin-bottom:6px;">Reason</div>
            <div style="font-size:13px;color:var(--text);"><%= ret.reason %></div>
          </div>
          <div style="background:var(--surface2);border:1px solid var(--border2);border-radius:8px;padding:12px;">
            <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--muted);font-family:var(--mono);margin-bottom:6px;">Resolution Requested</div>
            <div style="font-size:13px;color:var(--text);text-transform:capitalize;"><%= ret.resolution || 'Refund' %></div>
          </div>
          <% if (ret.remark) { %>
          <div style="background:var(--surface2);border:1px solid var(--border2);border-radius:8px;padding:12px;grid-column:1 / -1;">
            <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--muted);font-family:var(--mono);margin-bottom:6px;">Customer Remarks</div>
            <div style="font-size:13px;color:var(--text);"><%= ret.remark %></div>
          </div>
          <% } %>
        </div>

        <!-- Pending: show textarea + buttons -->
        <% if (isPending) { %>
          <div style="margin-bottom:12px;">
            <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--muted);font-family:var(--mono);margin-bottom:6px;">
              Admin Remark (required)
            </div>
            <textarea
              id="adminRemark-<%= retVariantIdStr %>"
              placeholder="Provide a mandatory reason for approval or rejection…"
              rows="2"
              style="width:100%;background:var(--surface2);color:var(--text);border:1px solid var(--border);border-radius:8px;padding:10px 14px;font-size:13px;font-family:var(--sans);resize:vertical;outline:none;transition:border-color 0.2s;"
              onfocus="this.style.borderColor='var(--accent)'"
              onblur="this.style.borderColor='var(--border)'"></textarea>
          </div>
          <div style="display:flex;gap:10px;">
            <button
              onclick="handleReturn('<%= order._id %>', 'Approved', '<%= retVariantIdStr %>')"
              style="display:inline-flex;align-items:center;gap:7px;background:rgba(34,197,94,0.12);color:#4ade80;border:1px solid rgba(74,222,128,0.3);padding:9px 20px;border-radius:8px;font-size:12px;font-weight:700;font-family:var(--sans);cursor:pointer;transition:all 0.2s;"
              onmouseover="this.style.background='rgba(34,197,94,0.22)'"
              onmouseout="this.style.background='rgba(34,197,94,0.12)'">
              <span class="material-symbols-outlined msym" style="font-size:16px;">check_circle</span>
              Approve Return
            </button>
            <button
              onclick="handleReturn('<%= order._id %>', 'Rejected', '<%= retVariantIdStr %>')"
              style="display:inline-flex;align-items:center;gap:7px;background:rgba(239,68,68,0.1);color:#f87171;border:1px solid rgba(248,113,113,0.3);padding:9px 20px;border-radius:8px;font-size:12px;font-weight:700;font-family:var(--sans);cursor:pointer;transition:all 0.2s;"
              onmouseover="this.style.background='rgba(239,68,68,0.2)'"
              onmouseout="this.style.background='rgba(239,68,68,0.1)'">
              <span class="material-symbols-outlined msym" style="font-size:16px;">cancel</span>
              Reject Return
            </button>
          </div>

        <!-- Already processed: show info + admin remark if exists -->
        <% } else { %>
          <div style="font-size:12px;color:var(--muted);font-family:var(--mono);display:flex;align-items:center;gap:6px;">
            <span class="material-symbols-outlined msym" style="font-size:15px;">info</span>
            This return request has already been <%= retStatus.toLowerCase() %>.
          </div>
          <% if (ret.adminRemark) { %>
          <div style="margin-top:10px;background:var(--surface2);border:1px solid var(--border2);border-radius:8px;padding:12px;">
            <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--muted);font-family:var(--mono);margin-bottom:6px;">Admin Remark</div>
            <div style="font-size:13px;color:<%= isApproved ? '#4ade80' : '#f87171' %>;"><%= ret.adminRemark %></div>
          </div>
          <% } %>
        <% } %>

      </div>
    <% }); %>  <%# ← closes returnedAt.forEach %>
  </div>
</div>
<% } %>  <%# ← closes if returnedAt.length > 0 %>
     
<script>

  const couponDiscount = <%= order.couponApplied || 0 %>;
  let selectedStatus = '<%= order.deliveryStatus || "pending" %>';
  const orderId      = '<%= order._id %>';

  let _tt;
  function showToast(msg, icon, color) {
    icon  = icon  || 'check_circle';
    color = color || '#4ade80';
    const t = document.getElementById('toast');
    document.getElementById('toast-icon').textContent  = icon;
    document.getElementById('toast-icon').style.color  = color;
    document.getElementById('toast-msg').textContent   = msg;
    t.classList.add('show');
    clearTimeout(_tt);
    _tt = setTimeout(function() { t.classList.remove('show'); }, 3000);
  }

  function selectStatus(status) {
    selectedStatus = status;
    document.querySelectorAll('.status-option').forEach(function(el) {
      el.classList.toggle('selected', el.dataset.status === status);
    });
    const hint = document.getElementById('status-hint');
    hint.textContent = '"' + status.replace(/_/g, ' ').toUpperCase() + '" selected — click Update Status to save';
    hint.style.color = status === 'cancelled' ? '#f87171' : 'var(--accent2)';
  }

  async function updateStatus() {
    const btn = document.getElementById('update-btn');
    btn.disabled = true;
    btn.innerHTML = '<span class="material-symbols-outlined msym" style="animation:spin 0.8s linear infinite;display:inline-block;">sync</span> Updating…';
    try {
      const res  = await fetch('/admin/orders/' + orderId + '/status', {
        method : 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body   : JSON.stringify({ deliveryStatus: selectedStatus })
      });
      const data = await res.json();
      if (!data.success) { showToast(data.message || 'Update failed', 'error', '#f87171'); return; }

      updateChips(selectedStatus, data.orderStatus);
      showToast('Order status updated successfully', 'check_circle', '#4ade80');
      document.getElementById('status-hint').textContent = 'Status saved ✓';
      document.getElementById('status-hint').style.color = '#4ade80';

      if (selectedStatus !== 'cancelled') {
        updateStepper(selectedStatus);
      } else {
        const stepperEl = document.querySelector('.stepper');
        if (stepperEl) stepperEl.style.display = 'none';
      }
    } catch (err) {
      console.error(err);
      showToast('Something went wrong', 'error', '#f87171');
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<span class="material-symbols-outlined msym">sync</span> Update Status';
    }
  }

  async function handleReturn(orderId, action, variantId) {
  const adminRemark = document.getElementById('adminRemark-' + variantId)?.value?.trim() || '';
  if (!adminRemark) {
    showToast('A reason (admin remark) is required.', 'error', '#f87171');
    return;
  }
  try {
    const res = await fetch('/admin/orders/' + orderId + '/return', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action, variantId, adminRemark })
    });
    const data = await res.json();
    if (!data.success) { showToast(data.message || 'Update failed', 'error', '#f87171'); return; }
    showToast(data.message, 'check_circle', '#4ade80');
    setTimeout(function() { window.location.reload(); }, 1500);
  } catch (err) {
    console.error(err);
    showToast('Something went wrong', 'error', '#f87171');
  }
}

  async function updateItemStatus(variantId) {
    const select = document.getElementById('item-status-' + variantId);
    if (!select) return;

    const deliveryStatus = select.value;
    try {
      const res = await fetch('/admin/orders/' + orderId + '/items/' + variantId + '/status', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ deliveryStatus: deliveryStatus })
      });
      const data = await res.json();
      if (!data.success) {
        showToast(data.message || 'Product status update failed', 'error', '#f87171');
        return;
      }

      selectedStatus = data.deliveryStatus || selectedStatus;
      updateChips(selectedStatus, data.orderStatus);
      showToast(data.message || 'Product status updated', 'check_circle', '#4ade80');
      setTimeout(function() { window.location.reload(); }, 900);
    } catch (err) {
      console.error(err);
      showToast('Something went wrong', 'error', '#f87171');
    }
  }

  function updateChips(dStatus, oStatus) {
    document.getElementById('current-status-label').textContent = dStatus.replace(/_/g, ' ').toUpperCase();
    const chips = document.querySelectorAll('.meta-chip');
    if (chips[0]) {
      chips[0].className = 'meta-chip chip-' + dStatus;
      chips[0].querySelector('span').nextSibling.textContent = ' ' + dStatus.replace(/_/g, ' ');
    }
    if (chips[1] && oStatus) {
      chips[1].className = 'meta-chip chip-' + oStatus;
      chips[1].querySelector('span').nextSibling.textContent = ' ' + oStatus;
    }
  }

  function updateStepper(currentStatus) {
    const stepOrder  = ['pending','shipped','out_for_delivery','delivered'];
    const currentIdx = stepOrder.indexOf(currentStatus);
    document.querySelectorAll('.step').forEach(function(step, i) {
      step.classList.remove('done', 'active');
      if (i < currentIdx)        step.classList.add('done');
      else if (i === currentIdx) step.classList.add('active');
    });
    document.querySelectorAll('.step-connector').forEach(function(c, i) {
      c.classList.toggle('done', i < currentIdx);
    });
  }

  const _s = document.createElement('style');
  _s.textContent = '@keyframes spin { to { transform: rotate(360deg); } }';
  document.head.appendChild(_s);
</script>

</body>
</html>
