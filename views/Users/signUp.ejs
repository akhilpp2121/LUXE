<script>

  const backendMessage = "<%= message || '' %>";

  if (backendMessage) {
    showBanner('error', backendMessage);
  }
  // ── Eye Toggle: Password ──────────────────────────────────────────────────
  const pwInput  = document.getElementById('password');
  const eyeBtn   = document.getElementById('eyeBtn');
  const eyeIcon  = document.getElementById('eyeIcon');

  eyeBtn.addEventListener('click', () => {
    const show = pwInput.type === 'password';
    pwInput.type  = show ? 'text' : 'password';
    eyeIcon.textContent = show ? 'visibility_off' : 'visibility';
  });

  // ── Eye Toggle: Confirm Password ─────────────────────────────────────────
  const cpInput      = document.getElementById('confirmPassword');
  const eyeBtnConfirm = document.getElementById('eyeBtnConfirm');
  const eyeIconConfirm = document.getElementById('eyeIconConfirm');

  eyeBtnConfirm.addEventListener('click', () => {
    const show = cpInput.type === 'password';
    cpInput.type = show ? 'text' : 'password';
    eyeIconConfirm.textContent = show ? 'visibility_off' : 'visibility';
  });

  // ── Validation helpers ───────────────────────────────────────────────────────
  function setErr(id, msg) {
    const input  = document.getElementById(id);
    const errDiv = document.getElementById(id + '-err');
    input.classList.add('field-error');
    input.classList.remove('field-ok');
    errDiv.textContent = msg;
    errDiv.classList.add('show');
    return false;
  }

  function setOk(id) {
    const input  = document.getElementById(id);
    const errDiv = document.getElementById(id + '-err');
    input.classList.remove('field-error');
    input.classList.add('field-ok');
    errDiv.textContent = '';
    errDiv.classList.remove('show');
    return true;
  }

  function validateField(id) {
    const val = document.getElementById(id).value.trim();

    if (id === 'fullName') {
  const value = val.trim();

  if (!value) return setErr(id, 'Full name is required');

  if (value.length < 3)
    return setErr(id, 'Must be at least 3 characters');

  // Only letters and single spaces between words
  // No numbers or special characters
  if (!/^[A-Za-z]+(?:\s[A-Za-z]+)*$/.test(value))
    return setErr(id, 'Only letters allowed in full name');

  return setOk(id);
}

if (id === 'email') {
  const value = val.trim().toLowerCase();

  if (!value) return setErr(id, 'Email address is required');

  if (/\s/.test(value))
    return setErr(id, 'Email must not contain spaces');

  const emailRegex =
    /^[A-Za-z0-9](?:[A-Za-z0-9._%+-]*[A-Za-z0-9])?@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+$/;

  if (!emailRegex.test(value))
    return setErr(id, 'Enter a valid email address');

  return setOk(id);
}


if (id === 'phoneNumber') {
  const value = val.trim();

  if (!value) return setErr(id, 'Phone number is required');

  // remove accidental spaces inside number
  if (/\s/.test(value))
    return setErr(id, 'Phone number must not contain spaces');

  // exactly 10 digits
  if (!/^[6-9]\d{9}$/.test(value))
    return setErr(id, 'Enter a valid 10-digit mobile number');

  return setOk(id);
}


    if (id === 'password') {
      if (!val)           return setErr(id, 'Password is required');
      if (val.length < 6) return setErr(id, 'At least 6 characters required');
      if (!/[A-Z]/.test(val)) return setErr(id, 'Include at least one uppercase letter (A–Z)');
      if (!/[a-z]/.test(val)) return setErr(id, 'Include at least one lowercase letter (a–z)');
      if (!/[0-9]/.test(val)) return setErr(id, 'Include at least one number (0–9)');
      if (!/[@$!%*?&]/.test(val)) return setErr(id, 'Include a special character: @ $ ! % * ? &');
      // Re-check confirm password whenever password changes, if it has a value
      const cpVal = document.getElementById('confirmPassword').value;
      if (cpVal) {
        if (cpVal !== val) setErr('confirmPassword', 'Passwords do not match');
        else setOk('confirmPassword');
      }
      return setOk(id);
    }

    if (id === 'confirmPassword') {
      const pwVal = document.getElementById('password').value;
      if (!val) return setErr(id, 'Please confirm your password');
      if (val !== pwVal) return setErr(id, 'Passwords do not match');
      return setOk(id);
    }
  }

  // Live re-validate on input (only after first blur/submit)
  ['fullName', 'email', 'phoneNumber', 'password', 'confirmPassword'].forEach(id => {
    const el = document.getElementById(id);
    el.addEventListener('blur',  () => { if (el.value) validateField(id); });
    el.addEventListener('input', () => { if (el.classList.contains('field-error')) validateField(id); });
  });

  // ── Banner ──────────────────────────────────────────────────────────────────
  function showBanner(type, msg) {
    const banner = document.getElementById('responseBanner');
    const iconEl = document.getElementById('bannerIcon');
    const msgEl  = document.getElementById('bannerMsg');

    const successIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;
    const errorIcon   = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`;

    banner.className = `banner show ${type}`;
    iconEl.innerHTML = type === 'success' ? successIcon : errorIcon;
    msgEl.textContent = msg;
    banner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function showOverlay() {
  document.getElementById("overlay").classList.remove("hidden");
}

function hideOverlay() {
  document.getElementById("overlay").classList.add("hidden");
}


  function hideBanner() {
    document.getElementById('responseBanner').className = 'banner';
  
  }  document.getElementById('registerForm').addEventListener('submit', (e) => {
  e.preventDefault();

  const ids = ['fullName', 'email', 'phoneNumber', 'password', 'confirmPassword'];
  const results = ids.map(id => validateField(id));

  if (results.includes(false)) return;

  
  e.target.submit();
  showOverlay();
});


</script>
