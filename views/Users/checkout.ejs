      font-family: 'Playfair Display', serif;
      font-size: 17px; font-weight: 500; color: var(--text-1);
    }
    .price-row.total .pr-val {
      font-family: 'Playfair Display', serif;
      font-size: 22px; font-weight: 600; color: var(--accent);
    }

