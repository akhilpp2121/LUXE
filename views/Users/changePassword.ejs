<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>LUXE ATELIER — Change Password</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Syne:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@300,0..1&display=swap" rel="stylesheet"/>
<style>
/* ── EXACT SAME VARIABLES AS PROFILE PAGE ── */
:root {
  --bg: #080c14; --sur: #0e1523; --sur2: #141c2e; --sur3: #1a2338; --sur4: #212c42;
  --bord: rgba(255,255,255,0.07); --bord2: rgba(255,255,255,0.13);
  --pri: #3a6ff7; --gold: #c9a96e; --gold2: #e0c08a;
  --txt: #e8edf8; --txt2: #8892a4; --txt3: #5a6478;
  --green: #22c55e; --red: #ef4444; --yellow: #f59e0b;
  --nav-h: 68px; --side-w: 260px; --r: 12px; --rl: 18px;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--txt); min-height: 100vh; overflow-x: hidden; }
::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { background: var(--sur4); border-radius: 99px; }

/* ── NAV (exact copy from profile) ── */
nav.topnav {
  position: fixed; top: 0; left: 0; right: 0; height: var(--nav-h);
  background: rgba(8,12,20,0.9); backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--bord);
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 36px; z-index: 100;
}
.brand { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 1rem; letter-spacing: .22em; text-transform: uppercase; }
.brand span { color: var(--gold); }
.nav-links { display: flex; gap: 32px; list-style: none; }
.nav-links a { font-family: 'Syne', sans-serif; font-size: .6rem; letter-spacing: .18em; text-transform: uppercase; color: var(--txt2); text-decoration: none; transition: color .2s; }
.nav-links a:hover { color: var(--txt); }
.nav-acts { display: flex; align-items: center; gap: 16px; }
.nav-btn { background: none; border: none; cursor: pointer; color: var(--txt2); display: flex; align-items: center; transition: color .2s; }
.nav-btn:hover { color: var(--txt); }
.nav-btn.on { color: var(--pri); }
.nav-btn .ms { font-size: 22px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }

/* ── SIDEBAR (identical structure + styles to profile page) ── */
aside.sidebar {
  position: fixed; top: var(--nav-h); left: 0;
  width: var(--side-w); height: calc(100vh - var(--nav-h));
  background: var(--sur); border-right: 1px solid var(--bord);
  display: flex; flex-direction: column; padding: 28px 0 20px; z-index: 50; overflow-y: auto;
}
.sidebar-header { padding: 0 24px 24px; border-bottom: 1px solid var(--bord); margin-bottom: 12px; }
.sidebar-header h3 { font-family: 'Syne', sans-serif; font-weight: 700; font-size: .9rem; margin-bottom: 6px; }
.sidebar-tier {
  display: inline-flex; align-items: center; gap: 5px;
  background: rgba(201,169,110,.1); border: 1px solid rgba(201,169,110,.25);
  border-radius: 99px; padding: 3px 10px;
}
.sidebar-tier span { font-family: 'Syne', sans-serif; font-size: .5rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--gold); }
.tier-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--gold); flex-shrink: 0; }
.sidebar-nav { display: flex; flex-direction: column; gap: 2px; padding: 0 10px; }
.sidebar-link {
  display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 8px;
  text-decoration: none; color: var(--txt2); font-size: .625rem; font-family: 'Syne', sans-serif;
  font-weight: 600; letter-spacing: .1em; text-transform: uppercase; transition: all .2s;
}
.sidebar-link .material-symbols-outlined { font-size: 17px; flex-shrink: 0; font-variation-settings: 'FILL' 0, 'wght' 300; }
.sidebar-link:hover { background: var(--sur3); color: var(--txt); }
.sidebar-link.active { background: rgba(58,111,247,.12); color: var(--pri); }
.sidebar-link.active .material-symbols-outlined { font-variation-settings: 'FILL' 1, 'wght' 300; }
.sidebar-footer { margin-top: auto; padding: 18px 24px 0; border-top: 1px solid var(--bord); }
.sidebar-footer a {
  display: flex; align-items: center; gap: 9px; text-decoration: none; color: var(--txt3);
  font-size: .625rem; font-family: 'Syne', sans-serif; font-weight: 600;
  letter-spacing: .1em; text-transform: uppercase; transition: color .2s;
}
.sidebar-footer a:hover { color: var(--red); }
.sidebar-footer .material-symbols-outlined { font-size: 17px; font-variation-settings: 'FILL' 0, 'wght' 300; }

/* ── MAIN ── */
main {
  margin-left: var(--side-w);
  padding: calc(var(--nav-h) + 44px) 48px 80px;
  min-height: 100vh; position: relative;
}
main::before {
  content: ''; position: fixed; top: 8%; right: -8%; width: 580px; height: 580px;
  background: radial-gradient(circle, rgba(201,169,110,0.04) 0%, transparent 70%);
  pointer-events: none; z-index: 0;
}
main::after {
  content: ''; position: fixed; bottom: 5%; left: 22%; width: 460px; height: 460px;
  background: radial-gradient(circle, rgba(58,111,247,0.04) 0%, transparent 70%);
  pointer-events: none; z-index: 0;
}

/* ── PAGE HEADER ── */
.page-header {
  margin-bottom: 36px; position: relative; z-index: 1;
  display: flex; align-items: flex-end; justify-content: space-between;
}
.page-header h1 {
  font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: 3.2rem;
  letter-spacing: -.01em; line-height: 1.05; margin-bottom: 6px;
}
.page-header h1 em { font-style: italic; color: var(--gold2); }
.page-header p { color: var(--txt3); font-size: .82rem; font-weight: 300; }
.back-link {
  display: flex; align-items: center; gap: 7px; text-decoration: none; color: var(--txt3);
  font-size: .6rem; font-family: 'Syne', sans-serif; font-weight: 600; letter-spacing: .14em;
  text-transform: uppercase; padding: 9px 16px; border: 1px solid var(--bord2);
  border-radius: 8px; transition: all .2s; background: var(--sur); flex-shrink: 0; margin-left: 24px;
}
.back-link:hover { color: var(--txt2); background: var(--sur2); }
.back-link .material-symbols-outlined { font-size: 14px; font-variation-settings: 'FILL' 0, 'wght' 300; }

/* ── CONTENT GRID ── */
.content-grid {
  display: grid; grid-template-columns: 1fr 340px;
  gap: 24px; max-width: 960px; position: relative; z-index: 1;
}

/* ── FORM CARD ── */
.form-card {
  background: var(--sur); border: 1px solid var(--bord);
  border-radius: var(--rl); overflow: hidden; position: relative;
  animation: fu .5s ease both;
}
@keyframes fu { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }

.card-header { padding: 26px 28px 0; }
.card-title {
  font-family: 'Syne', sans-serif; font-weight: 700; font-size: .8rem;
  letter-spacing: .12em; text-transform: uppercase; color: var(--txt2);
  display: flex; align-items: center; gap: 8px; margin-bottom: 24px;
}
.card-title .ms { font-size: 16px; color: var(--pri); font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }
.card-title::after { content: ''; flex: 1; height: 1px; background: var(--bord); }

/* ── FIELDS ── */
.form-body { padding: 0 28px 28px; }
.field-group { margin-bottom: 20px; }
.field-label {
  display: block; font-family: 'Syne', sans-serif; font-size: .52rem; font-weight: 700;
  letter-spacing: .14em; text-transform: uppercase; color: var(--txt3); margin-bottom: 8px;
}
.field-wrap { position: relative; }
.field-icon {
  position: absolute; left: 13px; top: 50%; transform: translateY(-50%);
  font-size: 17px; color: var(--txt3); font-family: 'Material Symbols Outlined';
  font-variation-settings: 'FILL' 0, 'wght' 300; pointer-events: none; transition: color .2s; line-height: 1;
}
.field-input {
  width: 100%; background: var(--sur2); border: 1px solid var(--bord); border-radius: var(--r);
  padding: 13px 88px 13px 44px; color: var(--txt); font-family: 'DM Sans', sans-serif;
  font-size: .875rem; font-weight: 400; outline: none; transition: all .22s; letter-spacing: .06em;
}
.field-input::placeholder { color: var(--txt3); letter-spacing: .01em; }
.field-input:hover:not(:disabled) { border-color: var(--bord2); }
.field-input:focus { border-color: rgba(58,111,247,.45); background: var(--sur3); box-shadow: 0 0 0 3px rgba(58,111,247,.08); }
.field-wrap:focus-within .field-icon { color: var(--pri); }

/* Validation states */
.field-input.is-error {
  border-color: rgba(239,68,68,.45) !important;
  background: rgba(239,68,68,.04) !important;
  box-shadow: 0 0 0 3px rgba(239,68,68,.06) !important;
}
.field-input.is-success {
  border-color: rgba(34,197,94,.4) !important;
  background: rgba(34,197,94,.03) !important;
  box-shadow: 0 0 0 3px rgba(34,197,94,.06) !important;
}
.field-wrap:has(.field-input.is-error) .field-icon { color: var(--red) !important; }
.field-wrap:has(.field-input.is-success) .field-icon { color: var(--green) !important; }

/* Right-side controls */
.field-right {
  position: absolute; right: 0; top: 0; bottom: 0;
  display: flex; align-items: center; gap: 2px; padding-right: 10px;
}
.toggle-pw {
  display: flex; align-items: center; justify-content: center;
  width: 32px; height: 32px; background: none; border: none;
  cursor: pointer; color: var(--txt3); border-radius: 7px; transition: all .18s;
}
.toggle-pw:hover { color: var(--txt2); background: var(--sur4); }
.toggle-pw .material-symbols-outlined { font-size: 17px; font-variation-settings: 'FILL' 0, 'wght' 300; }
.field-status {
  font-size: 17px; font-family: 'Material Symbols Outlined';
  font-variation-settings: 'FILL' 1, 'wght' 300; line-height: 1;
  opacity: 0; transition: opacity .2s; width: 20px; text-align: center;
}
.field-status.show { opacity: 1; }
.field-status.error  { color: var(--red); }
.field-status.success { color: var(--green); }

/* Messages */
.field-msg {
  min-height: 18px; margin-top: 7px; font-size: .7rem;
  display: flex; align-items: center; gap: 5px;
}
.field-msg.error   { color: var(--red);   animation: msgIn .18s ease both; }
.field-msg.success { color: var(--green); animation: msgIn .18s ease both; }
@keyframes msgIn { from { opacity: 0; transform: translateY(-3px); } to { opacity: 1; transform: translateY(0); } }
.field-msg .material-symbols-outlined { font-size: 13px; font-variation-settings: 'FILL' 1, 'wght' 300; flex-shrink: 0; }

/* ── STRENGTH METER ── */
.strength-wrap { margin-top: 12px; }
.strength-bars { display: flex; gap: 5px; margin-bottom: 7px; }
.strength-bar { flex: 1; height: 3px; border-radius: 99px; background: var(--sur4); transition: background .35s ease; }
.strength-bar.weak   { background: var(--red); }
.strength-bar.fair   { background: var(--yellow); }
.strength-bar.strong { background: var(--green); }
.strength-label {
  font-family: 'Syne', sans-serif; font-size: .58rem; font-weight: 700;
  letter-spacing: .1em; text-transform: uppercase; color: var(--txt3); transition: color .3s;
}
.strength-label.weak   { color: var(--red); }
.strength-label.fair   { color: var(--yellow); }
.strength-label.strong { color: var(--green); }

/* Requirements */
.req-list { display: grid; grid-template-columns: 1fr 1fr; gap: 7px 16px; margin-top: 14px; }
.req-item {
  display: flex; align-items: center; gap: 6px;
  font-size: .7rem; color: var(--txt3); font-weight: 300; transition: color .25s;
}
.req-item .material-symbols-outlined {
  font-size: 13px; font-variation-settings: 'FILL' 0, 'wght' 300;
  color: var(--txt3); transition: color .25s, font-variation-settings .2s; flex-shrink: 0;
}
.req-item.met { color: var(--green); }
.req-item.met .material-symbols-outlined { color: var(--green); font-variation-settings: 'FILL' 1, 'wght' 300; }

/* ── DIVIDER & ACTIONS ── */
.form-divider { height: 1px; background: var(--bord); margin: 4px 28px 24px; }
.form-actions { padding: 0 28px 28px; display: flex; gap: 12px; }

.btn-submit {
  flex: 1; display: flex; align-items: center; justify-content: center; gap: 9px;
  background: var(--pri); color: #fff; border: none; border-radius: var(--r);
  padding: 13px 28px; font-family: 'Syne', sans-serif; font-size: .65rem;
  font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
  cursor: pointer; transition: all .22s; position: relative; overflow: hidden;
}
.btn-submit:hover:not(:disabled) {
  background: #5b84ff;
  box-shadow: 0 0 24px rgba(58,111,247,.35), 0 4px 14px rgba(58,111,247,.2);
  transform: translateY(-1px);
}
.btn-submit:active:not(:disabled) { transform: translateY(0); }
.btn-submit:disabled { opacity: 0.38; cursor: not-allowed; box-shadow: none; transform: none; }
.btn-submit .material-symbols-outlined { font-size: 16px; font-variation-settings: 'FILL' 0, 'wght' 300; }

.btn-cancel {
  display: flex; align-items: center; gap: 7px; background: none;
  border: 1px solid var(--bord2); color: var(--txt3); border-radius: var(--r);
  padding: 13px 20px; font-family: 'Syne', sans-serif; font-size: .65rem;
  font-weight: 600; letter-spacing: .1em; text-transform: uppercase;
  cursor: pointer; text-decoration: none; transition: all .2s;
}
.btn-cancel:hover { background: var(--sur3); color: var(--txt2); }

/* ── SUCCESS OVERLAY ── */
.success-overlay {
  display: none; position: absolute; inset: 0;
  background: var(--sur); border-radius: var(--rl);
  flex-direction: column; align-items: center; justify-content: center;
  gap: 16px; padding: 48px; text-align: center;
}
.success-overlay.show { display: flex; animation: fadeIn .4s ease both; }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
.success-icon-wrap {
  width: 72px; height: 72px; border-radius: 50%;
  background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.25);
  display: flex; align-items: center; justify-content: center;
  animation: popIn .5s .1s cubic-bezier(.22,1,.36,1) both;
}
@keyframes popIn { from { opacity: 0; transform: scale(0.7); } to { opacity: 1; transform: scale(1); } }
.success-icon-wrap .material-symbols-outlined { font-size: 36px; color: var(--green); font-variation-settings: 'FILL' 1, 'wght' 300; }
.success-title { font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: 1.8rem; }
.success-title em { font-style: italic; color: var(--gold2); }
.success-sub { font-size: .8rem; color: var(--txt3); font-weight: 300; line-height: 1.7; max-width: 280px; }
.btn-done {
  display: inline-flex; align-items: center; gap: 8px; margin-top: 8px;
  background: var(--pri); color: #fff; border: none; border-radius: var(--r);
  padding: 12px 28px; font-family: 'Syne', sans-serif; font-size: .65rem;
  font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
  cursor: pointer; text-decoration: none; transition: all .2s;
}
.btn-done:hover { background: #5b84ff; transform: translateY(-1px); }

/* ── INFO PANEL ── */
.info-panel { display: flex; flex-direction: column; gap: 20px; animation: fu .5s .1s ease both; }
.info-card {
  background: var(--sur); border: 1px solid var(--bord);
  border-radius: var(--rl); padding: 24px; position: relative; overflow: hidden;
}
.info-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent 0%, rgba(201,169,110,.35) 50%, transparent 100%);
}
.info-card-icon {
  width: 38px; height: 38px; border-radius: 8px; background: rgba(201,169,110,.1);
  border: 1px solid rgba(201,169,110,.2); display: flex; align-items: center;
  justify-content: center; margin-bottom: 12px;
}
.info-card-icon .material-symbols-outlined { font-size: 18px; color: var(--gold2); font-variation-settings: 'FILL' 0, 'wght' 300; }
.info-card-icon.blue  { background: rgba(58,111,247,.1); border-color: rgba(58,111,247,.2); }
.info-card-icon.blue .material-symbols-outlined  { color: #7aa2ff; }
.info-card-icon.green { background: rgba(34,197,94,.1); border-color: rgba(34,197,94,.2); }
.info-card-icon.green .material-symbols-outlined { color: var(--green); }
.info-card-title {
  font-family: 'Syne', sans-serif; font-weight: 700; font-size: .75rem;
  letter-spacing: .08em; text-transform: uppercase; color: var(--txt); margin-bottom: 14px;
}
.tip-item {
  display: flex; align-items: flex-start; gap: 10px; padding: 9px 0;
  border-bottom: 1px solid var(--bord);
}
.tip-item:last-child { border-bottom: none; padding-bottom: 0; }
.tip-item .material-symbols-outlined { font-size: 14px; color: var(--green); font-variation-settings: 'FILL' 1, 'wght' 300; flex-shrink: 0; margin-top: 1px; }
.tip-text { font-size: .75rem; color: var(--txt3); line-height: 1.6; font-weight: 300; }

/* Spinner */
.spinner {
  width: 15px; height: 15px; border: 2px solid rgba(255,255,255,.25);
  border-top-color: #fff; border-radius: 50%;
  animation: spin .7s linear infinite; flex-shrink: 0;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ── RESPONSIVE ── */
@media (max-width: 1000px) { .content-grid { grid-template-columns: 1fr; } .info-panel { display: none; } }
@media (max-width: 900px) {
  :root { --side-w: 0px; }
  aside.sidebar { display: none; }
  main { padding: calc(var(--nav-h) + 28px) 20px 60px; }
  .nav-links { display: none; }
  .page-header { flex-direction: column; align-items: flex-start; gap: 14px; }
  .back-link { margin-left: 0; }
  .req-list { grid-template-columns: 1fr; }
}
</style>
</head>
<body>

<!-- ── NAV ── -->
<nav class="topnav">
  <div class="brand">LUXE <span>ATELIER</span></div>
  <ul class="nav-links">
    <li><a href="#">Showroom</a></li>
    <li><a href="#">Collections</a></li>
    <li><a href="#">Atelier</a></li>
    <li><a href="#">Journal</a></li>
  </ul>
  <div class="nav-acts">
    <button class="nav-btn"><span class="ms material-symbols-outlined">shopping_bag</span></button>
    <button class="nav-btn on"><span class="ms material-symbols-outlined">person</span></button>
  </div>
</nav>

<!-- ── SIDEBAR (pixel-perfect match to profile page) ── -->
<aside class="sidebar">
  <div class="sidebar-header">
    <h3>User Account</h3>
    <div class="sidebar-tier">
      <div class="tier-dot"></div>
      <span>Gold Member</span>
    </div>
  </div>
  <nav class="sidebar-nav">
    <a href="/profile" class="sidebar-link">
      <span class="material-symbols-outlined">person</span>
      <span>Profile</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">package_2</span>
      <span>My Orders</span>
    </a>
    <a href="/address" class="sidebar-link">
      <span class="material-symbols-outlined">distance</span>
      <span>Manage Address</span>
    </a>
    <a href="/changePassword" class="sidebar-link active">
      <span class="material-symbols-outlined">lock_reset</span>
      <span>Change Password</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">favorite</span>
      <span>Wishlist</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">share_reviews</span>
      <span>Referral Link</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">account_balance_wallet</span>
      <span>Wallet</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">confirmation_number</span>
      <span>Coupons</span>
    </a>
  </nav>
  <div class="sidebar-footer">
    <a href="#">
      <span class="material-symbols-outlined">logout</span>
      <span>Sign Out</span>
    </a>
  </div>
</aside>

<!-- ── MAIN ── -->
<main>
  <div class="page-header">
    <div>
      <h1>Change <em>Password</em></h1>
      <p>Keep your account safe with a strong, unique password.</p>
    </div>
    <a href="/profile" class="back-link">
      <span class="material-symbols-outlined">arrow_back_ios</span>Back to Profile
    </a>
  </div>

  <div class="content-grid">

    <!-- FORM CARD -->
     

    <div class="form-card" id="formCard">

      <!-- Success overlay -->
      <div class="success-overlay" id="successOverlay">
        <div class="success-icon-wrap">
          <span class="material-symbols-outlined">check_circle</span>
        </div>
        <div class="success-title">Password <em>Updated</em></div>
        <div class="success-sub">Your password has been changed successfully. You'll use the new one on your next login.</div>
        <a href="/profile" class="btn-done">
          <span class="material-symbols-outlined" style="font-size:15px;font-variation-settings:'FILL' 0,'wght' 300;">arrow_back</span>
          Back to Profile
        </a>
      </div>

      <div class="card-header">
        <div class="card-title">
          <span class="ms material-symbols-outlined">lock</span>
          Password Update
        </div>
      </div>
<form action="/change-password" method="POST" id="changePasswordForm">
      <div class="form-body">

        <!-- Current Password -->
        <div class="field-group">
          <label class="field-label" for="currentPw">Current Password</label>
          <div class="field-wrap">
            <span class="field-icon material-symbols-outlined">lock</span>
            <input class="field-input" type="password" id="currentPw" name="currentPassword"
              placeholder="Enter your current password" autocomplete="current-password"/>
            <div class="field-right">
              <button type="button" class="toggle-pw" data-target="currentPw" aria-label="Toggle visibility">
                <span class="material-symbols-outlined">visibility</span>
              </button>
              <span class="field-status" id="currentPw-status"></span>
            </div>
          </div>
          <div class="field-msg" id="currentPw-msg"></div>
        </div>

        <!-- New Password -->
        <div class="field-group">
          <label class="field-label" for="newPw">New Password</label>
          <div class="field-wrap">
            <span class="field-icon material-symbols-outlined">lock_open</span>
            <input class="field-input" type="password" id="newPw" name="newPassword"
              placeholder="Create a strong password" autocomplete="new-password"/>
            <div class="field-right">
              <button type="button" class="toggle-pw" data-target="newPw" aria-label="Toggle visibility">
                <span class="material-symbols-outlined">visibility</span>
              </button>
              <span class="field-status" id="newPw-status"></span>
            </div>
          </div>
          <div class="field-msg" id="newPw-msg"></div>

          <!-- Strength meter -->
          <div class="strength-wrap" id="strengthWrap" style="display:none;">
            <div class="strength-bars">
              <div class="strength-bar" id="bar1"></div>
              <div class="strength-bar" id="bar2"></div>
              <div class="strength-bar" id="bar3"></div>
              <div class="strength-bar" id="bar4"></div>
            </div>
            <span class="strength-label" id="strengthLabel">—</span>
            <div class="req-list">
              <div class="req-item" id="req-len"><span class="material-symbols-outlined">radio_button_unchecked</span>At least 8 characters</div>
              <div class="req-item" id="req-upper"><span class="material-symbols-outlined">radio_button_unchecked</span>Uppercase letter</div>
              <div class="req-item" id="req-lower"><span class="material-symbols-outlined">radio_button_unchecked</span>Lowercase letter</div>
              <div class="req-item" id="req-num"><span class="material-symbols-outlined">radio_button_unchecked</span>Number</div>
              <div class="req-item" id="req-special"><span class="material-symbols-outlined">radio_button_unchecked</span>Special character</div>
              <div class="req-item" id="req-diff"><span class="material-symbols-outlined">radio_button_unchecked</span>Different from current</div>
            </div>
          </div>
        </div>

        <!-- Confirm Password -->
        <div class="field-group" style="margin-bottom:0;">
          <label class="field-label" for="confirmPw">Confirm New Password</label>
          <div class="field-wrap">
            <span class="field-icon material-symbols-outlined">lock_clock</span>
            <input class="field-input" type="password" id="confirmPw" name="confirmPassword"
              placeholder="Repeat your new password" autocomplete="new-password"/>
            <div class="field-right">
              <button type="button" class="toggle-pw" data-target="confirmPw" aria-label="Toggle visibility">
                <span class="material-symbols-outlined">visibility</span>
              </button>
              <span class="field-status" id="confirmPw-status"></span>
            </div>
          </div>
          <div class="field-msg" id="confirmPw-msg"></div>
        </div>

      </div>

      <div class="form-divider"></div>

     <div class="form-actions">
        <button type="submit" class="btn-submit" id="submitBtn" disabled>
          <span class="material-symbols-outlined">shield_lock</span>
          Update Password
        </button>
    </form>
      </div>
        <a href="/profile" class="btn-cancel">Cancel</a>
      </div>

    </div><!-- /form-card -->

    <!-- RIGHT INFO PANEL -->

   
    
  </div>
</main>

<script>
(function () {
  'use strict';

  const curEl     = document.getElementById('currentPw');
  const newEl     = document.getElementById('newPw');
  const conEl     = document.getElementById('confirmPw');
  const submitBtn = document.getElementById('submitBtn');
  const successOverlay = document.getElementById('successOverlay');

  const touched = { currentPw: false, newPw: false, confirmPw: false };

  /* ── Toggle visibility ── */
  document.querySelectorAll('.toggle-pw').forEach(btn => {
    btn.addEventListener('click', function () {
      const inp  = document.getElementById(this.dataset.target);
      const icon = this.querySelector('.material-symbols-outlined');
      inp.type         = inp.type === 'password' ? 'text' : 'password';
      icon.textContent = inp.type === 'password'  ? 'visibility' : 'visibility_off';
    });
  });

  /* ── Rules ── */
  const rules = {
    len:     v => v.length >= 8,
    upper:   v => /[A-Z]/.test(v),
    lower:   v => /[a-z]/.test(v),
    num:     v => /[0-9]/.test(v),
    special: v => /[^A-Za-z0-9]/.test(v),
    diff:    v => v !== curEl.value || v === '',
  };

  function score(v) {
    return [rules.len, rules.upper, rules.lower, rules.num, rules.special].filter(fn => fn(v)).length;
  }
  function level(s) { return s <= 1 ? 'weak' : s <= 3 ? 'fair' : 'strong'; }

  /* ── Strength UI ── */
  function updateStrength(v) {
    const wrap = document.getElementById('strengthWrap');
    if (!v) { wrap.style.display = 'none'; return; }
    wrap.style.display = 'block';

    const lvl  = level(score(v));
    const bars = [1,2,3,4].map(i => document.getElementById('bar' + i));
    const lbl  = document.getElementById('strengthLabel');
    bars.forEach(b => b.className = 'strength-bar');
    const fill = lvl === 'weak' ? 1 : lvl === 'fair' ? 2 : 4;
    for (let i = 0; i < fill; i++) bars[i].classList.add(lvl);
    lbl.className   = 'strength-label ' + lvl;
    lbl.textContent = { weak: 'Weak', fair: 'Fair', strong: 'Strong' }[lvl];

    const map = {
      'req-len': rules.len(v), 'req-upper': rules.upper(v), 'req-lower': rules.lower(v),
      'req-num': rules.num(v), 'req-special': rules.special(v), 'req-diff': rules.diff(v),
    };
    for (const [id, met] of Object.entries(map)) {
      const el   = document.getElementById(id);
      const icon = el.querySelector('.material-symbols-outlined');
      el.classList.toggle('met', met);
      icon.textContent = met ? 'check_circle' : 'radio_button_unchecked';
    }
  }

  /* ── Render field ── */
  function render(id, ok, msg) {
    const inp    = document.getElementById(id);
    const msgEl  = document.getElementById(id + '-msg');
    const statEl = document.getElementById(id + '-status');

    inp.classList.remove('is-error', 'is-success');
    statEl.className   = 'field-status';
    statEl.textContent = '';
    msgEl.className    = 'field-msg';
    msgEl.innerHTML    = '';

    if (!touched[id]) return;

    if (!ok) {
      inp.classList.add('is-error');
      statEl.className   = 'field-status error show';
      statEl.textContent = 'error';
      msgEl.className    = 'field-msg error';
      msgEl.innerHTML    = `<span class="material-symbols-outlined">error</span>${msg}`;
    } else {
      inp.classList.add('is-success');
      statEl.className   = 'field-status success show';
      statEl.textContent = 'check_circle';
      if (msg) {
        msgEl.className = 'field-msg success';
        msgEl.innerHTML = `<span class="material-symbols-outlined">check_circle</span>${msg}`;
      }
    }
  }

  /* ── Validators ── */
  function vCurrent() {
    const v = curEl.value;
    if (!v) return [false, 'Current password is required'];
    return [true, ''];
  }
  function vNew() {
    const v = newEl.value;
    if (!v)                return [false, 'New password is required'];
    if (!rules.len(v))     return [false, 'Password must be at least 8 characters'];
    if (!rules.upper(v))   return [false, 'Add at least one uppercase letter'];
    if (!rules.lower(v))   return [false, 'Add at least one lowercase letter'];
    if (!rules.num(v))     return [false, 'Add at least one number'];
    if (!rules.special(v)) return [false, 'Add at least one special character'];
    if (curEl.value && v === curEl.value) return [false, 'New password must differ from current'];
    return [true, 'Strong password!'];
  }
  function vConfirm() {
    const v = conEl.value;
    if (!v)                return [false, 'Please confirm your new password'];
    if (v !== newEl.value) return [false, 'Passwords do not match'];
    return [true, 'Passwords match'];
  }

  /* ── Sync button ── */
  function sync() {
    submitBtn.disabled = !(vCurrent()[0] && vNew()[0] && vConfirm()[0]);
  }

  /* ── Events ── */
  curEl.addEventListener('blur', () => {
    touched.currentPw = true;
    render('currentPw', ...vCurrent());
    if (touched.newPw) render('newPw', ...vNew());
    sync();
  });
  curEl.addEventListener('input', () => {
    if (touched.currentPw) render('currentPw', ...vCurrent());
    if (touched.newPw) { updateStrength(newEl.value); render('newPw', ...vNew()); }
    sync();
  });

  newEl.addEventListener('blur', () => {
    touched.newPw = true;
    render('newPw', ...vNew());
    if (touched.confirmPw) render('confirmPw', ...vConfirm());
    sync();
  });
  newEl.addEventListener('input', () => {
    updateStrength(newEl.value);
    if (touched.newPw) render('newPw', ...vNew());
    if (touched.confirmPw) render('confirmPw', ...vConfirm());
    sync();
  });

  conEl.addEventListener('blur', () => {
    touched.confirmPw = true;
    render('confirmPw', ...vConfirm());
    sync();
  });
  conEl.addEventListener('input', () => {
    if (touched.confirmPw) render('confirmPw', ...vConfirm());
    sync();
  });

  /* ── Submit ── */
  const form = document.getElementById("changePasswordForm");

submitBtn.addEventListener('click', function () {
  touched.currentPw = true;
  touched.newPw = true;
  touched.confirmPw = true;

  //  FRONTEND VALIDATION
  render('currentPw', ...vCurrent());
  render('newPw', ...vNew());
  render('confirmPw', ...vConfirm());
  sync();

  if (!vCurrent()[0]) { curEl.focus(); return; }
  if (!vNew()[0])     { newEl.focus(); return; }
  if (!vConfirm()[0]) { conEl.focus(); return; }

  //  ONLY if validation passes → submit
  form.submit();
});


})();
</script>
</body>
</html>