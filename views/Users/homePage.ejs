<!DOCTYPE html>
<html class="dark" lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
    tailwind.config = {
        darkMode: "class",
        theme: {
            extend: {
                colors: {
                    "primary": "#1152d4",
                    "background-light": "#f6f6f8",
                    "background-dark": "#101622",
                },
                fontFamily: {
                    "display": ["Manrope", "sans-serif"]
                },
                borderRadius: {
                    "DEFAULT": "0.25rem",
                    "lg": "0.5rem",
                    "xl": "0.75rem",
                    "full": "9999px"
                },
            },
        },
    }
</script>
<style>
    body { font-family: 'Manrope', sans-serif; }
    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
    .search-wrap input {
    width: 300px;
    background: transparent;
    border: 0.5px solid rgba(255,255,255,0.15);
    border-radius: 999px;
    padding: 10px 44px 10px 42px;
    font-size: 13px;
    color: #fff;
    outline: none;
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
  }
  .search-wrap input::placeholder { color: rgba(255,255,255,0.35); }
  .search-wrap input:focus {
    border-color: #1152d4;
    background: rgba(17,82,212,0.08);
    box-shadow: 0 0 0 3px rgba(17,82,212,0.15);
  }
   .search-wrap .ic-search {
    position: absolute; left: 14px;
    font-size: 16px; color: rgba(255,255,255,0.35);
    pointer-events: none; transition: color 0.2s;
  }
  .search-wrap:focus-within .ic-search { color: #1152d4; }
  .search-wrap button {
    position: absolute; right: 8px;
    background: #1152d4; border: none; border-radius: 999px;
    width: 28px; height: 28px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; transition: background 0.2s, transform 0.15s;
    padding: 0;
  }
  .search-wrap button:hover { background: #0e44b0; transform: scale(1.05); }
</style>
</head>
<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 antialiased">

<!-- Header -->
<header class="sticky top-0 z-50 w-full border-b border-slate-200 dark:border-slate-800 bg-background-light/80 dark:bg-background-dark/80 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        <div class="flex items-center gap-12">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-3xl">diamond</span>
               <a href="/homepage" class="text-2xl font-bold tracking-tighter text-slate-900 dark:text-white uppercase hover:text-gray-500 transition">
  Luxe
</a>
            </div>
            <nav class="hidden md:flex items-center gap-8">
                <a class="text-sm font-medium hover:text-primary transition-colors" href="/product-listing">Collections</a>
                <a class="text-sm font-medium hover:text-primary transition-colors" href="#">New Arrivals</a>
                <a class="text-sm font-medium hover:text-primary transition-colors" href="#">About</a>
            </nav>
        </div>

<form method="GET" action="/homepage" class="search-wrap relative flex items-center"
  onsubmit="const i=this.querySelector('[name=search]'); i.value=i.value.trim();">
  <span class="material-symbols-outlined ic-search">search</span>
  <input
    name="search"
    type="text"
    placeholder="Search products..."
    value="<%= searchQuery || '' %>"
  />
  <button type="submit" aria-label="Search">
    <span class="material-symbols-outlined" style="font-size:16px; color:#fff;">arrow_forward</span>
  </button>
</form>
        
            <div class="flex items-center gap-4">
                <button class="p-2 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full transition-colors">
                    <span class="material-symbols-outlined">favorite</span>
                </button>

               <a href="/cart" class="relative p-2 text-slate-400 hover:text-white hover:bg-slate-800 rounded-lg transition-all">
  <span class="material-symbols-outlined msym">shopping_cart</span>
  <% if (locals.cart > 0) { %>
    <span class="absolute -top-1 -right-1 w-5 h-5 bg-primary text-white text-xs font-bold rounded-full flex items-center justify-center">
      <%= locals.cart %>
    </span>
  <% } %>
</a>
              
                <div class="w-8 h-8 rounded-full bg-slate-200 dark:bg-slate-700 flex items-center justify-center">
                    <a href="/profile">
                        <span class="material-symbols-outlined text-slate-500">person</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>

<main>

    <!-- Hero Section -->
    <section class="relative w-full h-[85vh] overflow-hidden">
        <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAJtx5iykZ8DNnG4JOd-R63qiKb68-RxlTSQX0QOls5TgddIkRvoktGm2jTTYDQWbOI_iBKAWkLLxsIlHxE3VQ35E53IOoBpgkxyz-XmUqYOEuBPsLVhqgZ8cv_y4VIZLEDejPHScxDSwxl4CRDjRL_CbbOSSXEilDLCRrU2bUlKDT-ihr5VfUFI84Qg9hMUhD_VhhSWhe8bA4dLoHxkmt3EKtg9KFEdTcBL6metIaPBtOSIusleR1KG7jHBqWnWJ0WERSndazUH_MF');">
            <div class="absolute inset-0 bg-gradient-to-r from-background-dark/80 via-background-dark/40 to-transparent"></div>
        </div>
        <div class="relative h-full max-w-7xl mx-auto px-6 flex flex-col justify-center items-start">
            <div class="max-w-2xl">
                <span class="text-primary font-bold tracking-[0.2em] uppercase text-sm mb-4 block">Summer Editorial 2024</span>
                <h2 class="text-6xl md:text-8xl font-800 text-white leading-[1.1] mb-6 tracking-tight">Elevated Essentials</h2>
                <p class="text-xl text-slate-300 mb-10 max-w-lg leading-relaxed">Experience the pinnacle of modern luxury with our meticulously crafted seasonal collection.</p>
                <a href="/product-listing">
                    <button class="bg-primary hover:bg-primary/90 text-white px-10 py-5 rounded-lg font-bold text-lg transition-all transform hover:scale-105">
                        Shop Now
                    </button>
                </a>
            </div>
        </div>
    </section>

    <!-- Popular Products -->
    <section class="py-24 max-w-7xl mx-auto px-6">
        <div class="flex items-end justify-between mb-12">
            <div>
                <h3 class="text-3xl font-800 mb-2">Popular Right Now</h3>
                <p class="text-slate-500">Curated selections for the discerning gentleman.</p>
            </div>
            <a class="text-primary font-bold hover:underline flex items-center gap-1" href="/product-listing">
                View all <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <% product.forEach(p => { %>
            <div class="bg-white dark:bg-slate-900 rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800 shadow-sm group">

                <!-- Image -->
                <div class="h-48 md:h-56 overflow-hidden relative">
                    <a href="/product-details/<%= p.productId._id %>?size=<%= p.size %>&color=<%= p.color %>">
                        <img
                            src="/uploads/<%= p.images[0] %>"
                            alt="<%= p.productId.name %>"
                            loading="lazy"
                            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                    </a>
                </div>

                <!-- Info -->
                <div class="p-3">
                    <h3 class="font-semibold text-sm mb-1 truncate"><%= p.productId.name %></h3>
                    <p class="text-xs text-slate-500 mb-1 truncate"><%= p.size %> | <%= p.color %></p>

                    <div class="flex items-center gap-2 mb-1">
                        <% if (p.save > 0) { %>
                            <p class="text-sm font-bold">₹<%= p.discount %></p>
                            <p class="text-xs text-slate-400 line-through">₹<%= p.price %></p>
                        <% } else { %>
                            <p class="text-sm font-bold">₹<%= p.price %></p>
                        <% } %>
                    </div>

                    <% if (p.save > 0) { %>
                        <p class="text-green-600 text-xs mb-2">Save ₹<%= p.save %></p>
                    <% } %>

                    <button
                        onclick="addToCart('<%= p._id %>')"
                        class="w-full py-2 px-3 rounded-lg font-medium text-xs bg-black text-white hover:bg-gray-800 flex items-center justify-center gap-1">
                        <span class="material-symbols-outlined" style="font-size:14px">shopping_bag</span>
                        Add to Cart
                    </button>
                </div>

            </div>
            <% }) %>
        </div>
    </section>

</main>

<!-- Footer -->
<footer class="bg-slate-50 dark:bg-background-dark border-t border-slate-200 dark:border-slate-800 pt-20 pb-10">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
        <div>
            <div class="flex items-center gap-2 mb-8">
                <span class="material-symbols-outlined text-primary text-3xl">diamond</span>
                <h2 class="text-2xl font-800 tracking-tighter uppercase">Luxe</h2>
            </div>
            <p class="text-slate-500 leading-relaxed mb-6">Redefining modern luxury through sustainable practices and timeless design.</p>
            <div class="flex items-center gap-4">
                <a class="w-10 h-10 rounded-full border border-slate-200 dark:border-slate-800 flex items-center justify-center hover:bg-primary hover:border-primary hover:text-white transition-all" href="#">
                    <span class="material-symbols-outlined text-xl">brand_family</span>
                </a>
                <a class="w-10 h-10 rounded-full border border-slate-200 dark:border-slate-800 flex items-center justify-center hover:bg-primary hover:border-primary hover:text-white transition-all" href="#">
                    <span class="material-symbols-outlined text-xl">share</span>
                </a>
                <a class="w-10 h-10 rounded-full border border-slate-200 dark:border-slate-800 flex items-center justify-center hover:bg-primary hover:border-primary hover:text-white transition-all" href="#">
                    <span class="material-symbols-outlined text-xl">rss_feed</span>
                </a>
            </div>
        </div>
        <div>
            <h4 class="font-bold mb-8 uppercase text-sm tracking-widest">Shop</h4>
            <ul class="space-y-4 text-slate-500">
                <li><a class="hover:text-primary transition-colors" href="#">New Arrivals</a></li>
                <li><a class="hover:text-primary transition-colors" href="#">Best Sellers</a></li>
                <li><a class="hover:text-primary transition-colors" href="#">Menswear</a></li>
                <li><a class="hover:text-primary transition-colors" href="#">Accessories</a></li>
                <li><a class="hover:text-primary transition-colors" href="#">Gift Cards</a></li>
            </ul>
        </div>
        <div>
            <h4 class="font-bold mb-8 uppercase text-sm tracking-widest">Customer Care</h4>
            <ul class="space-y-4 text-slate-500">
                <li><a class="hover:text-primary transition-colors" href="#">Order Status</a></li>
                <li><a class="hover:text-primary transition-colors" href="#">Returns & Exchanges</a></li>
                <li><a class="hover:text-primary transition-colors" href="#">Shipping Information</a></li>
                <li><a class="hover:text-primary transition-colors" href="#">Size Guide</a></li>
                <li><a class="hover:text-primary transition-colors" href="#">Contact Us</a></li>
            </ul>
        </div>
        <div></div>
    </div>
    <div class="max-w-7xl mx-auto px-6 pt-10 border-t border-slate-200 dark:border-slate-800 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-slate-400">
        <p>© 2024 Luxe Apparel Co. All rights reserved.</p>
        <div class="flex items-center gap-8">
            <a class="hover:text-slate-200 transition-colors" href="#">Privacy Policy</a>
            <a class="hover:text-slate-200 transition-colors" href="#">Terms of Service</a>
            <a class="hover:text-slate-200 transition-colors" href="#">Accessibility</a>
        </div>
    </div>
</footer>

<!-- Toast -->
<div id="toast" style="position:fixed;bottom:2rem;left:50%;transform:translateX(-50%) translateY(120px);z-index:9999;transition:transform 0.4s cubic-bezier(0.34,1.56,0.64,1);pointer-events:none;">
    <div class="flex items-center gap-3 bg-slate-900 border border-slate-700 text-white px-5 py-3 rounded-2xl shadow-2xl">
        <span id="toast-icon" class="material-symbols-outlined text-green-400">check_circle</span>
        <span id="toast-msg" class="text-sm font-semibold"></span>
    </div>
</div>

<script>



    let _toastTimer;

    function showToast(msg, icon = 'check_circle', iconCls = 'text-green-400') {
        document.getElementById('toast-msg').textContent = msg;
        const ic = document.getElementById('toast-icon');
        ic.textContent = icon;
        ic.className = 'material-symbols-outlined ' + iconCls;
        document.getElementById('toast').style.transform = 'translateX(-50%) translateY(0)';
        clearTimeout(_toastTimer);
        _toastTimer = setTimeout(() => {
            document.getElementById('toast').style.transform = 'translateX(-50%) translateY(120px)';
        }, 2800);
    }

    async function addToCart(variantId) {
        try {
            const res = await fetch('/cart/add-cart', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ variantId, qty: 1 })
            });

            const data = await res.json();

            if (data.success) {
                showToast(data.message || 'Added to cart!', 'check_circle', 'text-green-400');
            } else {
                showToast(data.message || 'Failed to add', 'error', 'text-red-400');
            }

        } catch (err) {
            showToast('Something went wrong', 'error', 'text-red-400');
        }
    }
</script>

</body>
</html>