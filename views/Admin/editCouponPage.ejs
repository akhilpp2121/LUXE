<!DOCTYPE html>
<html class="dark" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>Edit Coupon | LUXE Admin</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap"
    rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    rel="stylesheet" />
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "secondary-container": "#313aa1", "on-primary-fixed-variant": "#00266e", "tertiary-dim": "#ef8fe5", "surface-container-highest": "#192540", "on-surface-variant": "#a3aac4", "on-tertiary-fixed-variant": "#711f6f", "outline": "#6d758c", "error-container": "#9f0519", "surface-bright": "#1f2b49", "secondary-fixed": "#cbceff", "primary-dim": "#316bf3", "background": "#060e20", "surface-variant": "#192540", "surface-container-lowest": "#000000", "primary-fixed": "#7b9cff", "surface-container-high": "#141f38", "surface-container": "#0f1930", "on-secondary-fixed-variant": "#3c45ab", "on-secondary-fixed": "#1c248e", "inverse-surface": "#faf8ff", "tertiary": "#ffb4f4", "surface-tint": "#90abff", "secondary-dim": "#8b94ff", "secondary": "#8b94ff", "on-primary-container": "#001e5a", "surface": "#060e20", "primary-fixed-dim": "#658eff", "on-tertiary": "#722070", "on-secondary-container": "#caccff", "on-primary-fixed": "#000000", "error-dim": "#d7383b", "error": "#ff716c", "tertiary-fixed-dim": "#ef8fe5", "on-surface": "#dee5ff", "surface-container-low": "#091328", "on-error-container": "#ffa8a3", "surface-dim": "#060e20", "on-secondary": "#000478", "on-error": "#490006", "outline-variant": "#40485d", "on-primary": "#002873", "primary": "#90abff", "on-tertiary-container": "#661466", "secondary-fixed-dim": "#bbbfff", "primary-container": "#7b9cff", "tertiary-fixed": "#fe9cf4", "on-background": "#dee5ff", "tertiary-container": "#fe9cf4", "on-tertiary-fixed": "#480049", "inverse-primary": "#0053dc", "inverse-on-surface": "#4d556b"
          },
          fontFamily: { "headline": ["Manrope"], "body": ["Inter"], "label": ["Inter"], "mono": ["JetBrains Mono"] },
          borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
        },
      },
    }
  </script>
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }

    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      vertical-align: middle;
    }

    ::-webkit-scrollbar {
      width: 6px;
    }

    ::-webkit-scrollbar-track {
      background: #060e20;
    }

    ::-webkit-scrollbar-thumb {
      background: #1f2b49;
      border-radius: 10px;
    }

    .glass-effect {
      background: rgba(25, 37, 64, 0.7);
      backdrop-filter: blur(20px);
    }

    .luxe-gradient {
      background: linear-gradient(135deg, #316bf3 0%, #90abff 100%);
    }

    input[type="date"]::-webkit-calendar-picker-indicator {
      filter: invert(1);
    }

    /* Validation styles */
    .input-error {
      border-color: #ff716c !important;
      box-shadow: 0 0 0 2px rgba(255, 113, 108, 0.2) !important;
    }

    .input-success {
      border-color: #4ade80 !important;
    }

    .field-error-msg {
      color: #ff716c;
      font-size: 0.7rem;
      margin-top: 4px;
      display: flex;
      align-items: center;
      gap: 4px;
    }
  </style>
  <link rel="stylesheet" href="/css/navigation-consistency.css" />
</head>

<body class="bg-background text-on-background font-body antialiased min-h-screen">

  <!-- Sidebar -->
  <aside class="h-screen w-64 fixed left-0 top-0 bg-[#091328] dark:bg-slate-950 flex flex-col py-8 px-4 z-50">

    <div class="mb-10 px-4">
      <h1 class="font-['Manrope'] font-extrabold text-xl tracking-tighter text-white">LUXE Admin</h1>
      <p class="text-on-surface-variant text-[10px] uppercase tracking-widest mt-1">Premium Command</p>
    </div>

    <nav class="flex-1 space-y-1">
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/dashboard">
        <span class="material-symbols-outlined text-lg">dashboard</span>Dashboard
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/order-management">
        <span class="material-symbols-outlined text-lg">shopping_cart</span>Orders
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/products">
        <span class="material-symbols-outlined text-lg">inventory_2</span>Products
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/users">
        <span class="material-symbols-outlined text-lg">group</span>Users
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/analystic">
        <span class="material-symbols-outlined text-lg">monitoring</span>Analytics
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-white border-l-4 border-[#90abff] bg-[#1f2b49] font-bold text-sm"
        href="/admin/coupons">
        <span class="material-symbols-outlined text-lg">confirmation_number</span>Coupons
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/category">
        <span class="material-symbols-outlined text-lg">category</span>Categories
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/offer">
        <span class="material-symbols-outlined text-lg">local_offer</span>Offers
      </a>
      
    </nav>

    <div class="mt-auto px-4 pt-6 border-t border-[#1f2a44] space-y-2">
      <a href="/admin/coupons-add">
        <button
          class="w-full luxe-gradient text-on-primary py-3 rounded-xl text-xs font-bold flex items-center justify-center gap-2 hover:brightness-110 active:scale-95 transition-all">
          <span class="material-symbols-outlined text-lg">add_circle</span>
          New Coupon
        </button>
      </a>
      <form action="/admin/logout" method="POST">
        <button type="submit"
          class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-['Inter'] font-bold text-sm tracking-tight">
          <span class="material-symbols-outlined text-lg">logout</span>
          Logout
        </button>
      </form>
    </div>

  </aside>

  <!-- Main Content -->
  <main class="ml-64 min-h-screen relative">

    <!-- Top Nav -->
    <header
      class="fixed top-0 right-0 w-[calc(100%-16rem)] h-16 bg-[#060e20]/70 backdrop-blur-xl shadow-2xl shadow-blue-900/10 flex items-center justify-between px-8 z-40">
      <div class="flex items-center gap-4">
        <a href="/admin/coupons"
          class="p-2 text-on-surface-variant hover:text-white hover:bg-surface-container-high rounded-lg transition-colors">
          <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <div>
          <h2 class="font-['Manrope'] font-semibold text-lg text-[#90abff]">
            Edit Coupon — <span class="font-mono text-white"><%= coupon.code %></span>
          </h2>
          <p class="text-on-surface-variant text-xs">Update coupon details</p>
        </div>
      </div>

      <div class="flex items-center gap-4">
        <button class="p-2 text-on-surface-variant hover:text-white transition-colors">
          <span class="material-symbols-outlined">notifications</span>
        </button>
        <div class="h-8 w-px bg-outline-variant/20 mx-2"></div>
        <div class="w-9 h-9 rounded-full luxe-gradient flex items-center justify-center text-white text-xs font-bold">
          A
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <div class="pt-24 px-8 pb-12 max-w-3xl">

      <!-- Page Header -->
      <div class="mb-8 flex items-start justify-between">
        <div>
          <h2 class="font-['Manrope'] font-extrabold text-2xl text-white">Edit Coupon</h2>
          <p class="text-on-surface-variant text-sm mt-1">
            Update the details for <span class="font-mono text-[#90abff] font-bold"><%= coupon.code %></span>
          </p>
        </div>
        <!-- Created date badge -->
        <div class="bg-surface-container-high border border-outline-variant/20 px-4 py-2 rounded-lg text-right">
          <p class="text-on-surface-variant text-xs">Created</p>
          <p class="text-on-surface text-sm font-bold"><%= new Date(coupon.createdAt).toDateString() %></p>
        </div>
      </div>

      <!-- Error messages -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-6 p-4 bg-error-container/20 border border-error/30 rounded-xl flex items-center gap-3">
          <span class="material-symbols-outlined text-error">error</span>
          <p class="text-error text-sm"><%= error %></p>
        </div>
      <% } %>

      <!-- Form Card -->
      <form action="/admin/coupon-edit/<%= coupon._id %>" method="POST" id="couponForm" novalidate>

        <div class="bg-surface-container-high rounded-2xl overflow-hidden shadow-2xl">

          <!-- Section: Basic Info -->
          <div class="p-6 border-b border-outline-variant/10">
            <h3 class="text-on-surface font-bold text-base mb-5 flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">info</span>
              Basic Information
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

              <!-- Coupon Code -->
              <div class="md:col-span-2">
                <label class="block text-on-surface-variant text-xs font-bold uppercase tracking-wider mb-2">
                  Coupon Code <span class="text-error">*</span>
                </label>
                <div class="relative">
                  <span
                    class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">confirmation_number</span>
                  <input type="text" name="code" id="code" value="<%= coupon.code %>" placeholder="eg: SUMMER24"
                    maxlength="20"
                    oninput="this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, ''); validateField('code')"
                    onblur="validateField('code')"
                    class="w-full pl-10 pr-4 py-3 bg-surface-container-lowest border border-outline-variant/30 rounded-lg text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 transition-all" />
                </div>
                <div id="code-error" class="field-error-msg hidden">
                  <span>⚠</span><span id="code-error-text"></span>
                </div>
                <p class="text-on-surface-variant text-xs mt-1">3–20 characters, letters and numbers only</p>
              </div>

              <!-- Discount Type -->
              <div>
                <label class="block text-on-surface-variant text-xs font-bold uppercase tracking-wider mb-2">
                  Discount Type <span class="text-error">*</span>
                </label>
                <div class="relative">
                  <span
                    class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">percent</span>
                  <select name="discountType" id="discountType"
                    onchange="handleTypeChange(this.value); validateField('discountType')"
                    class="w-full pl-10 pr-4 py-3 bg-surface-container-lowest border border-outline-variant/30 rounded-lg text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 appearance-none cursor-pointer">
                    <option value="PERCENTAGE" <%= coupon.discountType === 'PERCENTAGE' ? 'selected' : '' %>>Percentage (%)</option>
                    <option value="FLAT" <%= coupon.discountType === 'FLAT' ? 'selected' : '' %>>Flat Amount (₹)</option>
                  </select>
                </div>
                <div id="discountType-error" class="field-error-msg hidden">
                  <span>⚠</span><span id="discountType-error-text"></span>
                </div>
              </div>

              <!-- Discount Value -->
              <div>
                <label class="block text-on-surface-variant text-xs font-bold uppercase tracking-wider mb-2">
                  Discount Value <span class="text-error">*</span>
                </label>
                <div class="relative">
                  <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant"
                    id="valueIcon">
                    <%= coupon.discountType === 'PERCENTAGE' ? 'percent' : 'currency_rupee' %>
                  </span>
                  <input type="number" name="discountValue" id="discountValue" value="<%= coupon.discountValue %>"
                    placeholder="eg: 20" min="1"
                    oninput="validateField('discountValue'); validateField('minOrderValue')"
                    onblur="validateField('discountValue')"
                    class="w-full pl-10 pr-16 py-3 bg-surface-container-lowest border border-outline-variant/30 rounded-lg text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 transition-all" />
                  <span id="valueSuffix"
                    class="absolute right-4 top-1/2 -translate-y-1/2 text-on-surface-variant text-sm font-bold">
                    <%= coupon.discountType === 'PERCENTAGE' ? '%' : '₹' %>
                  </span>
                </div>
                <div id="discountValue-error" class="field-error-msg hidden">
                  <span>⚠</span><span id="discountValue-error-text"></span>
                </div>
              </div>

            </div>
          </div>

          <!-- Section: Limits -->
          <div class="p-6 border-b border-outline-variant/10">
            <h3 class="text-on-surface font-bold text-base mb-5 flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">tune</span>
              Limits & Validity
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

              <!-- Min Order Value -->
              <div>
                <label class="block text-on-surface-variant text-xs font-bold uppercase tracking-wider mb-2">
                  Minimum Order Value
                  <span id="minOrderStar" class="text-error <%= coupon.discountType === 'FLAT' ? '' : 'hidden' %>">*</span>
                </label>
                <div class="relative">
                  <span
                    class="absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-sm font-bold">₹</span>
                  <input type="number" name="minOrderValue" id="minOrderValue" value="<%= coupon.minOrderValue || 0 %>"
                    placeholder="0" min="0"
                    oninput="validateField('minOrderValue'); validateField('discountValue')"
                    onblur="validateField('minOrderValue')"
                    class="w-full pl-8 pr-4 py-3 bg-surface-container-lowest border border-outline-variant/30 rounded-lg text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 transition-all" />
                </div>
                <div id="minOrderValue-error" class="field-error-msg hidden">
                  <span>⚠</span><span id="minOrderValue-error-text"></span>
                </div>
                <p class="text-on-surface-variant text-xs mt-1" id="minOrderHint">
                  <%= coupon.discountType === 'FLAT' ? 'Required — must be greater than discount value' : 'Leave 0 for no minimum' %>
                </p>
              </div>

              <!-- Max Discount -->
              <div id="maxDiscountField"
                class="<%= coupon.discountType === 'FLAT' ? 'opacity-40 pointer-events-none' : '' %>">
                <label class="block text-on-surface-variant text-xs font-bold uppercase tracking-wider mb-2">
                  Maximum Discount
                </label>
                <div class="relative">
                  <span
                    class="absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-sm font-bold">₹</span>
                  <input type="number" name="maxDiscount" id="maxDiscount" value="<%= coupon.maxDiscount || '' %>"
                    placeholder="No limit" min="0" oninput="validateField('maxDiscount')"
                    onblur="validateField('maxDiscount')"
                    class="w-full pl-8 pr-4 py-3 bg-surface-container-lowest border border-outline-variant/30 rounded-lg text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 transition-all" />
                </div>
                <div id="maxDiscount-error" class="field-error-msg hidden">
                  <span>⚠</span><span id="maxDiscount-error-text"></span>
                </div>
                <p class="text-on-surface-variant text-xs mt-1">Cap for percentage discounts</p>
              </div>

              <!-- Expiry Date -->
              <div>
                <label class="block text-on-surface-variant text-xs font-bold uppercase tracking-wider mb-2">
                  Expiry Date <span class="text-error">*</span>
                </label>
                <div class="relative">
                  <span
                    class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">calendar_month</span>
                  <input type="date" name="expiryDate" id="expiryDate"
                    value="<%= new Date(coupon.expiryDate).toISOString().split('T')[0] %>"
                    onchange="validateField('expiryDate')" onblur="validateField('expiryDate')"
                    class="w-full pl-10 pr-4 py-3 bg-surface-container-lowest border border-outline-variant/30 rounded-lg text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 transition-all" />
                </div>
                <div id="expiryDate-error" class="field-error-msg hidden">
                  <span>⚠</span><span id="expiryDate-error-text"></span>
                </div>
              </div>

              <!-- Usage Limit -->
              <div>
                <label class="block text-on-surface-variant text-xs font-bold uppercase tracking-wider mb-2">
                  Total Usage Limit
                </label>
                <div class="relative">
                  <span
                    class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">group</span>
                  <input type="number" name="usageLimit" id="usageLimit" value="<%= coupon.baseLimit || '' %>"
                    placeholder="Unlimited" min="1" oninput="validateField('usageLimit')"
                    onblur="validateField('usageLimit')"
                    class="w-full pl-10 pr-4 py-3 bg-surface-container-lowest border border-outline-variant/30 rounded-lg text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 transition-all" />
                </div>
                <div id="usageLimit-error" class="field-error-msg hidden">
                  <span>⚠</span><span id="usageLimit-error-text"></span>
                </div>
                <p class="text-on-surface-variant text-xs mt-1">Leave empty for unlimited uses</p>
              </div>

            </div>
          </div>

          <!-- Section: Status -->
          <div class="p-6 border-b border-outline-variant/10">
            <h3 class="text-on-surface font-bold text-base mb-5 flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">toggle_on</span>
              Status
            </h3>
            <div
              class="flex items-center justify-between p-4 bg-surface-container-lowest border border-outline-variant/20 rounded-lg">
              <div>
                <p class="text-on-surface text-sm font-bold">Active</p>
                <p class="text-on-surface-variant text-xs">Toggle to enable or disable this coupon</p>
              </div>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" name="isActive" id="isActive" class="sr-only peer"
                  <%= coupon.isActive ? 'checked' : '' %>>
                <div class="w-11 h-6 bg-outline-variant peer-focus:outline-none rounded-full peer
                  peer-checked:after:translate-x-full peer-checked:after:border-white
                  after:content-[''] after:absolute after:top-[2px] after:left-[2px]
                  after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all
                  peer-checked:bg-primary">
                </div>
              </label>
            </div>
          </div>

          <!-- Actions -->
          <div class="p-6 flex items-center justify-between">
            <a href="/admin/coupons">
              <button type="button"
                class="px-6 py-3 border border-outline-variant/40 rounded-lg text-on-surface text-sm hover:bg-surface-container transition-colors flex items-center gap-2">
                <span class="material-symbols-outlined text-sm">close</span>
                Cancel
              </button>
            </a>
            <button type="submit"
              class="px-8 py-3 luxe-gradient text-on-primary rounded-lg text-sm font-bold hover:brightness-110 active:scale-95 transition-all flex items-center gap-2">
              <span class="material-symbols-outlined text-sm">save</span>
              Save Changes
            </button>
          </div>

        </div>
      </form>

    </div>
  </main>

  <script>
    // ── Set min expiry date ──────────────────────────────────
    const todayStr = new Date().toISOString().split("T")[0];
    document.getElementById("expiryDate").min = todayStr;

    // ── Type change handler ──────────────────────────────────
    function handleTypeChange(value) {
      const suffix = document.getElementById("valueSuffix");
      const icon = document.getElementById("valueIcon");
      const maxDiv = document.getElementById("maxDiscountField");
      const minStar = document.getElementById("minOrderStar");
      const minHint = document.getElementById("minOrderHint");
      const valueInput = document.getElementById("discountValue");

      if (value === "PERCENTAGE") {
        suffix.textContent = "%";
        icon.textContent = "percent";
        maxDiv.classList.remove("opacity-40", "pointer-events-none");
        valueInput.max = 100;
        valueInput.placeholder = "eg: 20";
        minStar.classList.add("hidden");
        minHint.textContent = "Leave 0 for no minimum";
      } else if (value === "FLAT") {
        suffix.textContent = "₹";
        icon.textContent = "currency_rupee";
        maxDiv.classList.add("opacity-40", "pointer-events-none");
        document.getElementById("maxDiscount").value = "";
        valueInput.removeAttribute("max");
        valueInput.placeholder = "eg: 100";
        minStar.classList.remove("hidden");
        minHint.textContent = "Required — must be greater than discount value";
      } else {
        suffix.textContent = "";
      }

      // Re-validate related fields when type changes
      validateField("discountValue");
      validateField("minOrderValue");
    }

    // ── Show / Clear field error ─────────────────────────────
    function showError(fieldId, message) {
      const input = document.getElementById(fieldId);
      const errDiv = document.getElementById(fieldId + "-error");
      const errText = document.getElementById(fieldId + "-error-text");
      if (!input || !errDiv) return;

      input.classList.add("input-error");
      input.classList.remove("input-success");
      errDiv.classList.remove("hidden");
      errText.textContent = message;
    }

    function clearError(fieldId) {
      const input = document.getElementById(fieldId);
      const errDiv = document.getElementById(fieldId + "-error");
      if (!input || !errDiv) return;

      input.classList.remove("input-error");
      input.classList.add("input-success");
      errDiv.classList.add("hidden");
    }

    function resetField(fieldId) {
      const input = document.getElementById(fieldId);
      const errDiv = document.getElementById(fieldId + "-error");
      if (!input || !errDiv) return;

      input.classList.remove("input-error", "input-success");
      errDiv.classList.add("hidden");
    }

    // ── Per-field validation ─────────────────────────────────
    function validateField(fieldId) {
      const type = document.getElementById("discountType").value;
      const discount = parseFloat(document.getElementById("discountValue").value) || 0;
      const minOrder = parseFloat(document.getElementById("minOrderValue").value) || 0;

      switch (fieldId) {

        case "code": {
          const val = document.getElementById("code").value.trim();
          if (!val) return showError("code", "Coupon code is required");
          if (val.length < 3) return showError("code", "Minimum 3 characters required");
          if (!/^[A-Z0-9]+$/.test(val)) return showError("code", "Only letters and numbers allowed");
          clearError("code");
          break;
        }

        case "discountType": {
          if (!type) return showError("discountType", "Please select a discount type");
          clearError("discountType");
          break;
        }

        case "discountValue": {
          const val = parseFloat(document.getElementById("discountValue").value);
          if (!val || isNaN(val)) return showError("discountValue", "Discount value is required");
          if (val <= 0) return showError("discountValue", "Must be greater than 0");
          if (type === "PERCENTAGE" && val >= 100)
            return showError("discountValue", "Percentage must be between 1 and 99");
          if (type === "FLAT" && minOrder > 0 && val >= minOrder)
            return showError("discountValue", `Must be less than min order ₹${minOrder}`);
          clearError("discountValue");
          break;
        }

        case "minOrderValue": {
          if (minOrder < 0) return showError("minOrderValue", "Cannot be negative");
          if (type === "FLAT") {
            if (minOrder <= 0) return showError("minOrderValue", "Required for flat discount");
            if (discount > 0 && minOrder <= discount)
              return showError("minOrderValue", `Must be greater than discount ₹${discount}`);
          }
          if (minOrder > 0) clearError("minOrderValue");
          else resetField("minOrderValue");
          break;
        }

        case "maxDiscount": {
          const val = parseFloat(document.getElementById("maxDiscount").value);
          if (!val || isNaN(val)) { resetField("maxDiscount"); break; }
          if (val <= 0) return showError("maxDiscount", "Must be greater than 0");
          if (minOrder > 0 && val >= minOrder)
            return showError("maxDiscount", `Must be less than min order ₹${minOrder}`);
          clearError("maxDiscount");
          break;
        }

        case "expiryDate": {
          const val = document.getElementById("expiryDate").value;
          if (!val) return showError("expiryDate", "Expiry date is required");
          const today = new Date(); today.setHours(0, 0, 0, 0);
          if (new Date(val) <= today) return showError("expiryDate", "Must be a future date");
          clearError("expiryDate");
          break;
        }

        case "usageLimit": {
          const val = parseInt(document.getElementById("usageLimit").value);
          if (!document.getElementById("usageLimit").value) { resetField("usageLimit"); break; }
          if (isNaN(val) || val < 1) return showError("usageLimit", "Must be at least 1");
          clearError("usageLimit");
          break;
        }
      }
    }

    // ── Full form validation on submit ───────────────────────
    document.getElementById("couponForm").addEventListener("submit", function (e) {
      e.preventDefault();

      // Validate all fields
      ["code", "discountType", "discountValue", "minOrderValue", "maxDiscount", "expiryDate", "usageLimit"]
        .forEach(validateField);

      // Collect visible errors
      const errorMessages = [];
      document.querySelectorAll(".field-error-msg:not(.hidden) span:last-child").forEach(el => {
        if (el.textContent) errorMessages.push(el.textContent);
      });

      if (errorMessages.length > 0) {
        Swal.fire({
          title: "Please fix the following:",
          html: `<ul class="text-left space-y-2 mt-2">
            ${errorMessages.map(msg => `
              <li class="flex items-start gap-2 text-sm">
                <span style="color:#ff716c;margin-top:1px">✕</span>
                <span>${msg}</span>
              </li>`).join("")}
          </ul>`,
          icon: "error",
          background: "#141f38",
          color: "#dee5ff",
          confirmButtonColor: "#316bf3",
          confirmButtonText: "Fix Issues",
        });
        return;
      }

      // All valid — submit
      this.submit();
    });
  </script>
</body>

</html>
