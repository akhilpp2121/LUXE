<!DOCTYPE html>
<html class="dark" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>Order <%= order.orderCode %> — LUXE Admin</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap"
    rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    rel="stylesheet" />
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "secondary-container": "#313aa1", "on-primary-fixed-variant": "#00266e", "tertiary-dim": "#ef8fe5", "surface-container-highest": "#192540", "on-surface-variant": "#a3aac4", "on-tertiary-fixed-variant": "#711f6f", "outline": "#6d758c", "error-container": "#9f0519", "surface-bright": "#1f2b49", "secondary-fixed": "#cbceff", "primary-dim": "#316bf3", "background": "#060e20", "surface-variant": "#192540", "surface-container-lowest": "#000000", "primary-fixed": "#7b9cff", "surface-container-high": "#141f38", "surface-container": "#0f1930", "on-secondary-fixed-variant": "#3c45ab", "on-secondary-fixed": "#1c248e", "inverse-surface": "#faf8ff", "tertiary": "#ffb4f4", "surface-tint": "#90abff", "secondary-dim": "#8b94ff", "secondary": "#8b94ff", "on-primary-container": "#001e5a", "surface": "#060e20", "primary-fixed-dim": "#658eff", "on-tertiary": "#722070", "on-secondary-container": "#caccff", "on-primary-fixed": "#000000", "error-dim": "#d7383b", "error": "#ff716c", "tertiary-fixed-dim": "#ef8fe5", "on-surface": "#dee5ff", "surface-container-low": "#091328", "on-error-container": "#ffa8a3", "surface-dim": "#060e20", "on-secondary": "#000478", "on-error": "#490006", "outline-variant": "#40485d", "on-primary": "#002873", "primary": "#90abff", "on-tertiary-container": "#661466", "secondary-fixed-dim": "#bbbfff", "primary-container": "#7b9cff", "tertiary-fixed": "#fe9cf4", "on-background": "#dee5ff", "tertiary-container": "#fe9cf4", "on-tertiary-fixed": "#480049", "inverse-primary": "#0053dc", "inverse-on-surface": "#4d556b"
          },
          fontFamily: { "headline": ["Manrope"], "body": ["Inter"], "label": ["Inter"] },
          borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
        },
      },
    }
  </script>
  <style>
    body { font-family: 'Inter', sans-serif; }

    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #060e20; }
    ::-webkit-scrollbar-thumb { background: #1f2b49; border-radius: 10px; }

    .luxe-gradient {
      background: linear-gradient(135deg, #316bf3 0%, #90abff 100%);
    }

    /* ── Stepper ── */
    .stepper { display: flex; align-items: center; }
    .step { display: flex; flex-direction: column; align-items: center; flex: 1; position: relative; z-index: 1; }
    .step-connector {
      flex: 1; height: 2px; background: #40485d;
      position: relative; top: -14px; z-index: 0; transition: background 0.4s;
    }
    .step-connector.done { background: #90abff; }
    .step-dot {
      width: 32px; height: 32px; border-radius: 50%;
      border: 2px solid #40485d; background: #0f1930;
      display: flex; align-items: center; justify-content: center;
      transition: all 0.3s; margin-bottom: 8px;
    }
    .step-dot .material-symbols-outlined { font-size: 15px; color: #a3aac4; }
    .step.done .step-dot { border-color: #90abff; background: rgba(144,171,255,0.15); }
    .step.done .step-dot .material-symbols-outlined { color: #90abff; }
    .step.active .step-dot { border-color: #90abff; background: rgba(144,171,255,0.25); box-shadow: 0 0 0 4px rgba(144,171,255,0.12); }
    .step.active .step-dot .material-symbols-outlined { color: #90abff; font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    .step-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #a3aac4; text-align: center; white-space: nowrap; }
    .step.active .step-label { color: #90abff; }
    .step.done .step-label { color: #fff; }

    /* ── Status options ── */
    .status-option {
      display: flex; flex-direction: column; align-items: center; gap: 8px;
      padding: 14px 8px; border-radius: 12px;
      border: 1px solid #40485d; background: #0f1930;
      cursor: pointer; transition: all 0.2s; position: relative;
    }
    .status-option:hover { border-color: #90abff; background: rgba(144,171,255,0.06); }
    .status-option.selected { border-color: #90abff; background: rgba(144,171,255,0.12); }
    .status-option.selected::after {
      content: ''; position: absolute; top: 6px; right: 6px;
      width: 8px; height: 8px; border-radius: 50%; background: #90abff;
    }
    .status-option .material-symbols-outlined { font-size: 22px; color: #a3aac4; transition: color 0.2s; }
    .status-option:hover .material-symbols-outlined, .status-option.selected .material-symbols-outlined { color: #90abff; }
    .status-option span.label {
      font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
      color: #a3aac4; text-align: center; line-height: 1.3; transition: color 0.2s;
    }
    .status-option:hover span.label, .status-option.selected span.label { color: #fff; }

    .btn-update {
      display: inline-flex; align-items: center; gap: 8px;
      color: #002873; font-size: 13px; font-weight: 700;
      padding: 11px 24px; border-radius: 10px;
      border: none; cursor: pointer; transition: all 0.2s;
    }
    .btn-update:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(144,171,255,0.3); }
    .btn-update:disabled { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: none; }

    #toast {
      position: fixed; bottom: 28px; right: 28px; z-index: 9999;
      transform: translateY(80px); opacity: 0;
      transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      pointer-events: none;
    }
    #toast.show { transform: translateY(0); opacity: 1; }

    @keyframes fadeUp { from { opacity:0; transform:translateY(16px); } to { opacity:1; transform:translateY(0); } }
    .fu { animation: fadeUp 0.4s ease forwards; opacity: 0; }
    .d1 { animation-delay: 0.05s; } .d2 { animation-delay: 0.12s; } .d3 { animation-delay: 0.19s; } .d4 { animation-delay: 0.26s; }
    @keyframes spin { to { transform: rotate(360deg); } }

    @media (max-width: 900px) {
      .status-grid { grid-template-columns: repeat(3, 1fr); }
    }
  </style>
  <link rel="stylesheet" href="/css/navigation-consistency.css" />
</head>

<body class="bg-background text-on-background font-body antialiased min-h-screen">

  <!-- Toast -->
  <div id="toast">
    <div class="flex items-center gap-3 bg-surface-container-high border border-outline-variant/30 px-5 py-3.5 rounded-xl shadow-2xl min-w-[260px]">
      <span id="toast-icon" class="material-symbols-outlined" style="color:#4ade80;">check_circle</span>
      <span id="toast-msg" class="text-sm font-bold text-on-surface"></span>
    </div>
  </div>

  <!-- Sidebar -->
  <aside class="h-screen w-64 fixed left-0 top-0 bg-[#091328] dark:bg-slate-950 flex flex-col py-8 px-4 z-50">

    <div class="mb-10 px-4">
      <h1 class="font-['Manrope'] font-extrabold text-xl tracking-tighter text-white">LUXE Admin</h1>
      <p class="text-on-surface-variant text-[10px] uppercase tracking-widest mt-1">Premium Command</p>
    </div>

    <nav class="flex-1 space-y-1">
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/dashboard">
        <span class="material-symbols-outlined text-lg">dashboard</span>Dashboard
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-white border-l-4 border-[#90abff] bg-[#1f2b49] font-bold text-sm"
        href="/admin/order-management">
        <span class="material-symbols-outlined text-lg">shopping_cart</span>Orders
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/products">
        <span class="material-symbols-outlined text-lg">inventory_2</span>Products
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/users">
        <span class="material-symbols-outlined text-lg">group</span>Users
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/analystic">
        <span class="material-symbols-outlined text-lg">monitoring</span>Analytics
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/coupons">
        <span class="material-symbols-outlined text-lg">confirmation_number</span>Coupons
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/category">
        <span class="material-symbols-outlined text-lg">category</span>Categories
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/offer">
        <span class="material-symbols-outlined text-lg">local_offer</span>Offers
      </a>

    </nav>

    <div class="mt-auto px-4 pt-6 border-t border-[#1f2a44]">
      <form action="/admin/logout" method="POST">
        <button type="submit"
          class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-['Inter'] font-bold text-sm tracking-tight">
          <span class="material-symbols-outlined text-lg">logout</span>
          Logout
        </button>
      </form>
    </div>

  </aside>

  <!-- Main Content -->
  <main class="ml-64 min-h-screen relative">

    <!-- Top Nav -->
    <header
      class="fixed top-0 right-0 w-[calc(100%-16rem)] h-16 bg-[#060e20]/70 backdrop-blur-xl shadow-2xl shadow-blue-900/10 flex items-center justify-between px-8 z-40">
      <div class="flex items-center gap-3 text-sm">
        <a href="/admin/dashboard" class="text-on-surface-variant hover:text-primary transition-colors font-bold">Home</a>
        <span class="material-symbols-outlined text-[14px] text-on-surface-variant">chevron_right</span>
        <a href="/admin/order-management" class="text-on-surface-variant hover:text-primary transition-colors font-bold">Orders</a>
        <span class="material-symbols-outlined text-[14px] text-on-surface-variant">chevron_right</span>
        <span class="text-white font-bold"><%= order.orderCode %></span>
      </div>

      <div class="flex items-center gap-4">
        <a href="/admin/order-management"
          class="flex items-center gap-1.5 text-xs font-bold text-on-surface-variant hover:text-white border border-outline-variant/40 rounded-lg px-3 py-2 transition-colors">
          <span class="material-symbols-outlined text-[15px]">arrow_back</span>
          Back to Orders
        </a>
        <div class="h-8 w-px bg-outline-variant/20 mx-1"></div>
        <div class="w-9 h-9 rounded-full luxe-gradient flex items-center justify-center text-white text-xs font-bold">
          A
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <div class="pt-24 px-8 pb-12">

      <%
        /* ── Shared variables — declared ONCE, used throughout the template ── */
        const dStatus = order.deliveryStatus || 'pending';
        const oStatus = order.orderStatus   || 'placed';
        const method  = order.orderMethod   || 'cod';

        const chipClasses = {
          pending:              'bg-amber-400/10 text-amber-300 border border-amber-400/20',
          shipped:               'bg-blue-400/10 text-blue-300 border border-blue-400/20',
          out_for_delivery:      'bg-purple-400/10 text-purple-300 border border-purple-400/20',
          delivered:              'bg-emerald-400/10 text-emerald-400 border border-emerald-400/20',
          cancelled:              'bg-error/10 text-error border border-error/20',
          placed:                 'bg-primary/10 text-primary border border-primary/20',
          completed:              'bg-emerald-400/10 text-emerald-400 border border-emerald-400/20',
          partially_delivered:    'bg-blue-400/10 text-blue-300 border border-blue-400/20',
          returned:               'bg-purple-400/10 text-purple-300 border border-purple-400/20',
        };
        const codChipClass = 'bg-surface-container-low text-on-surface-variant border border-outline-variant/30';

        /* Set of cancelled variant IDs */
        const cancelledVariantIds = new Set();
        (order.cancelledAt || []).forEach(function(cancel) {
          (cancel.cancelledProducts || []).forEach(function(pid) {
            cancelledVariantIds.add(pid.toString ? pid.toString() : String(pid));
          });
        });

        /* Latest return request */
        const latestReturn = (order.returnedAt && order.returnedAt.length > 0)
          ? order.returnedAt[order.returnedAt.length - 1]
          : null;

        /* ── Approved-returned quantity per variant (money math must agree
           with the refund service, which only deducts stock/value once a
           return is Approved — Pending/Rejected returns don't change the
           amount the customer still owes). ── */
        const approvedReturnedQtyByVariant = {};
        (order.returnedAt || []).forEach(function(r) {
          if (r.variant && r.returnRequestStatus === 'Approved') {
            const vid = r.variant.toString ? r.variant.toString() : String(r.variant);
            approvedReturnedQtyByVariant[vid] =
              (approvedReturnedQtyByVariant[vid] || 0) + (r.quantity || 1);
          }
        });

        /* ── Count of pending return requests — used to decide whether the
           "Approve All Pending" bulk-action bar should be shown. Bulk
           approving credits ONE combined wallet refund (see
           updateReturnRequestService, which sums all approved items into a
           single totalRefund before calling creditWallet once) instead of
           one separate wallet transaction per individual approval click. ── */
        const pendingReturnsCount = (order.returnedAt || []).filter(function(r) {
          return r.returnRequestStatus === 'Pending';
        }).length;
      %>

      <!-- ── Order Header ── -->
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 mb-8 fu d1">
        <div>
          <h2 class="font-['Manrope'] font-extrabold text-2xl text-white">
            <span class="text-primary">#</span><%= order.orderCode %>
          </h2>
          <div class="flex items-center gap-3 mt-2 flex-wrap">
            <span class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-full <%= chipClasses[dStatus] || chipClasses.pending %>">
              <span class="material-symbols-outlined text-[12px]">local_shipping</span>
              <%= dStatus.replace(/_/g,' ') %>
            </span>
            <span class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-full <%= chipClasses[oStatus] || chipClasses.placed %>">
              <span class="material-symbols-outlined text-[12px]">receipt</span>
              <%= oStatus %>
            </span>
            <span class="inline-flex items-center text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-full <%= codChipClass %>">
              <%= method %>
            </span>
          </div>
        </div>
        <div class="text-right">
          <p class="text-[10px] text-on-surface-variant uppercase tracking-widest font-bold">Order Date</p>
          <p class="text-sm font-bold text-on-surface mt-0.5">
            <%= new Date(order.orderDate).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %>
          </p>
          <p class="text-[10px] text-on-surface-variant uppercase tracking-widest font-bold mt-2">Expected Delivery</p>
          <p class="text-sm font-bold text-emerald-400 mt-0.5">
            <%= new Date(order.expectedDeliveryDate).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %>
          </p>
        </div>
      </div>

      <!-- ── Delivery Status Card ── -->
      <div class="bg-surface-container-high rounded-2xl shadow-2xl overflow-hidden mb-8 fu d2">
        <div class="p-6 border-b border-outline-variant/10 flex items-center justify-between flex-wrap gap-3">
          <h3 class="font-['Manrope'] font-bold text-base text-white flex items-center gap-2">
            <span class="material-symbols-outlined text-lg text-primary">local_shipping</span>
            Delivery Status
          </h3>
          <span class="text-xs text-on-surface-variant">
            Current: <span id="current-status-label" class="text-primary font-extrabold">
              <%= dStatus.replace(/_/g,' ').toUpperCase() %>
            </span>
          </span>
        </div>

        <div class="p-6">

          <!-- Progress Stepper (hidden when cancelled) -->
          <% if (dStatus !== 'cancelled') { %>
          <%
            const steps = [
              { key: 'pending',          icon: 'hourglass_empty', label: 'Pending'           },
              { key: 'shipped',          icon: 'deployed_code',   label: 'Shipped'           },
              { key: 'out_for_delivery', icon: 'two_wheeler',     label: 'Out for Delivery' },
              { key: 'delivered',        icon: 'done_all',        label: 'Delivered'         },
            ];
            const stepOrder  = ['pending','shipped','out_for_delivery','delivered'];
            const currentIdx = stepOrder.indexOf(dStatus);
          %>
          <div class="stepper mb-8">
            <% steps.forEach(function(step, i) {
              const isDone   = i < currentIdx;
              const isActive = i === currentIdx;
              const cls = isDone ? 'done' : (isActive ? 'active' : '');
            %>
              <div class="step <%= cls %>">
                <div class="step-dot">
                  <span class="material-symbols-outlined"><%= step.icon %></span>
                </div>
                <span class="step-label"><%= step.label %></span>
              </div>
              <% if (i < steps.length - 1) { %>
                <div class="step-connector <%= isDone ? 'done' : '' %>"></div>
              <% } %>
            <% }); %>
          </div>
          <% } %>

          <!-- Status Selector -->
          <%
            const statusOptions = [
              { key: 'pending',          icon: 'hourglass_empty', label: 'Pending' },
              { key: 'shipped',          icon: 'deployed_code',   label: 'Shipped' },
              { key: 'out_for_delivery', icon: 'two_wheeler',     label: 'Out for Delivery' },
              { key: 'delivered',        icon: 'done_all',        label: 'Delivered' },
            ];
          %>
          <div class="status-grid grid grid-cols-4 gap-3 mb-6" id="status-grid">
            <% statusOptions.forEach(function(opt) { %>
              <div class="status-option <%= dStatus === opt.key ? 'selected' : '' %>"
                   data-status="<%= opt.key %>"
                   onclick="selectStatus('<%= opt.key %>')">
                <span class="material-symbols-outlined"><%= opt.icon %></span>
                <span class="label"><%= opt.label %></span>
              </div>
            <% }); %>
          </div>

          <div class="flex items-center gap-4 flex-wrap">
            <button class="btn-update luxe-gradient" id="update-btn" onclick="updateStatus()">
              <span class="material-symbols-outlined">sync</span>
              Update Status
            </button>
            <span id="status-hint" class="text-xs text-on-surface-variant">
              Select a status above then click update
            </span>
          </div>

        </div>
      </div>

      <!-- ── Order Items ── -->
      <div class="bg-surface-container-high rounded-2xl shadow-2xl overflow-hidden mb-8 fu d3">
        <div class="p-6 border-b border-outline-variant/10 flex items-center justify-between">
          <h3 class="font-['Manrope'] font-bold text-base text-white flex items-center gap-2">
            <span class="material-symbols-outlined text-lg text-primary">shopping_bag</span>
            Order Items
          </h3>
          <span class="text-xs text-on-surface-variant">
            <%= order.orderItems.length %> item<%= order.orderItems.length !== 1 ? 's' : '' %>
          </span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr class="bg-surface-container-low/50">
                <th class="px-6 py-4 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant" style="width:64px;"></th>
                <th class="px-6 py-4 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">Product</th>
                <th class="px-6 py-4 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">Price</th>
                <th class="px-6 py-4 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">Qty</th>
                <th class="px-6 py-4 text-right text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">Total</th>
                <th class="px-6 py-4 text-center text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant" style="width:250px;">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant/10 text-sm">
              <% order.orderItems.forEach(function(item) {
                const itemVariantIdStr = item.variantId.toString ? item.variantId.toString() : String(item.variantId);
                const itemDeliveryStatus = item.deliveryStatus || order.deliveryStatus || 'pending';
                const isCancelled = cancelledVariantIds.has(itemVariantIdStr) || itemDeliveryStatus === 'cancelled';
                const itemReturns = (order.returnedAt || []).filter(function(r) {
                  return r.variant && (r.variant.toString() === itemVariantIdStr);
                });
                const itemReturn = itemReturns.length > 0 ? itemReturns[itemReturns.length - 1] : null;
                const isReturned = itemReturn && itemReturn.returnRequestStatus === 'Approved';
                const isReturnRejected = itemReturn && itemReturn.returnRequestStatus === 'Rejected';
                const isReturnPending = itemReturn && itemReturn.returnRequestStatus === 'Pending';
                const itemStatusOptions = [
                  { key: 'pending', label: 'Pending' },
                  { key: 'shipped', label: 'Shipped' },
                  { key: 'out_for_delivery', label: 'Out for Delivery' },
                  { key: 'delivered', label: 'Delivered' },
                ];

                const rowClass = isCancelled
                  ? 'opacity-50 bg-error/5'
                  : isReturned
                    ? 'opacity-60 bg-purple-400/5'
                    : '';
                const strikeClass = (isCancelled || isReturned) ? 'line-through text-on-surface-variant' : 'text-on-surface';
              %>
              <tr class="hover:bg-surface-bright/50 transition-colors <%= rowClass %>">
                <td class="px-6 py-4">
                  <div class="w-12 h-14 rounded-lg bg-surface-container-low border border-outline-variant/30 flex items-center justify-center">
                    <span class="material-symbols-outlined text-on-surface-variant text-xl">deployed_code</span>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <div class="font-bold text-sm <%= strikeClass %>"><%= item.productName %></div>
                  <div class="text-xs text-on-surface-variant"><%= item.variantName %></div>
                </td>
                <td class="px-6 py-4">
                  <span class="font-bold text-sm <%= strikeClass %>">
                    ₹<%= item.price.toLocaleString('en-IN') %>
                  </span>
                </td>
                <td class="px-6 py-4">
                  <span class="text-xs font-bold bg-surface-container-low border border-outline-variant/30 px-2.5 py-1 rounded-md text-on-surface">
                    × <%= item.quantity %>
                  </span>
                </td>
                <td class="px-6 py-4 text-right">
                  <span class="font-extrabold text-sm text-primary <%= strikeClass %>">
                    ₹<%= item.totalPrice.toLocaleString('en-IN') %>
                  </span>
                </td>
                <td class="px-6 py-4 text-center">
                  <div class="flex flex-col items-center gap-2">
                    <% if (isCancelled) { %>
                      <span class="inline-block px-2 py-1 rounded text-[11px] font-bold bg-error/10 text-error">CANCELLED</span>
                    <% } else if (isReturned) { %>
                      <span class="inline-block px-2 py-1 rounded text-[11px] font-bold bg-purple-400/10 text-purple-300">RETURNED</span>
                    <% } else if (isReturnRejected) { %>
                      <span class="inline-block px-2 py-1 rounded text-[11px] font-bold bg-error/10 text-error border border-error/20">RTN REJECTED</span>
                    <% } else if (isReturnPending) { %>
                      <span class="inline-block px-2 py-1 rounded text-[11px] font-bold bg-amber-400/10 text-amber-300">RTN PENDING</span>
                    <% } else { %>
                      <span class="inline-block px-2 py-1 rounded text-[11px] font-bold bg-emerald-400/10 text-emerald-400"><%= itemDeliveryStatus.replace(/_/g, ' ').toUpperCase() %></span>
                    <% } %>

                    <% if (!isCancelled && !isReturned && !isReturnPending) { %>
                      <div class="flex gap-1.5 items-center justify-center">
                        <select id="item-status-<%= itemVariantIdStr %>"
                          class="bg-surface-container-low text-on-surface border border-outline-variant/40 rounded-md px-2 py-1.5 text-[11px]" style="max-width:138px;">
                          <% itemStatusOptions.forEach(function(opt) { %>
                            <option value="<%= opt.key %>" <%= itemDeliveryStatus === opt.key ? 'selected' : '' %>><%= opt.label %></option>
                          <% }); %>
                        </select>
                        <button onclick="updateItemStatus('<%= itemVariantIdStr %>')"
                          class="inline-flex items-center justify-center bg-primary/15 text-primary border border-primary/25 rounded-md w-8 h-8 hover:bg-primary/25 transition-colors"
                          title="Update product status">
                          <span class="material-symbols-outlined text-[16px]">sync</span>
                        </button>
                      </div>
                    <% } %>
                  </div>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- ── Address + Payment Summary ── -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8 fu d4">

        <!-- Shipping Address -->
        <div class="bg-surface-container-high rounded-2xl shadow-2xl p-6">
          <h3 class="font-['Manrope'] font-bold text-base text-white flex items-center gap-2 mb-5">
            <span class="material-symbols-outlined text-lg text-primary">location_on</span>
            Shipping Address
          </h3>
          <div class="text-sm text-on-surface leading-relaxed">
            <strong class="block text-white font-bold mb-1"><%= order.shippingAddress.username %></strong>
            <%= order.shippingAddress.street_address %><br/>
            <% if (order.shippingAddress.landmark) { %>
              Near <%= order.shippingAddress.landmark %>,<br/>
            <% } %>
            <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> — <%= order.shippingAddress.postal_code %><br/>
            <%= order.shippingAddress.country %>
          </div>
          <div class="flex items-center gap-2 mt-4 pt-4 border-t border-outline-variant/10">
            <span class="material-symbols-outlined text-on-surface-variant text-[15px]">call</span>
            <span class="text-xs text-on-surface font-bold">
              <%= order.shippingAddress.phone_number %>
            </span>
          </div>
        </div>

        <!-- Payment Summary -->
        <div class="bg-surface-container-high rounded-2xl shadow-2xl p-6">
          <h3 class="font-['Manrope'] font-bold text-base text-white flex items-center gap-2 mb-5">
            <span class="material-symbols-outlined text-lg text-primary">payments</span>
            Payment Summary
          </h3>
          <%
            /* ── Original subtotal: ALL items at their charged line total.
               This is the basis the coupon was originally applied against,
               and it must stay fixed regardless of later cancellations or
               returns — otherwise the coupon proration ratio below drifts. ── */
            const originalSubTotal = (order.orderItems || [])
              .reduce(function(sum, item) { return sum + (item.totalPrice || 0); }, 0);

            /* ── Active subtotal: exclude cancelled items entirely, and for
               items with an Approved return, subtract only the refunded
               quantity's value (partial returns leave the rest active).
               This mirrors updateReturnRequestService's unitValue math
               (item.totalPrice / item.quantity) so admin + refund agree. ── */
            const activeSubTotal = (order.orderItems || [])
              .reduce(function(sum, item) {
                const vid = item.variantId.toString ? item.variantId.toString() : String(item.variantId);
                if (cancelledVariantIds.has(vid)) return sum;
                const unitValue = item.totalPrice / item.quantity;
                const approvedQty = approvedReturnedQtyByVariant[vid] || 0;
                const remainingQty = Math.max(item.quantity - approvedQty, 0);
                return sum + (unitValue * remainingQty);
              }, 0);

            const hasActiveItems = activeSubTotal > 0;

            /* ── Coupon: prorate against the SAME active/original ratio
               used everywhere else, and only when something is still active. ── */
            let proratedCoupon = 0;
            if (hasActiveItems && order.couponApplied > 0) {
              proratedCoupon = Math.min(order.couponApplied, activeSubTotal);
            }

            /* ── GST: computed on the TAXABLE value (active subtotal minus
               its share of the coupon) — this is the same basis
               updateReturnRequestService uses for itemGst, so a refund for
               one item always matches what that item was contributing to
               this Grand Total. Previously this taxed the pre-coupon
               active subtotal, which disagreed with the refund service. ── */
            const GST_RATE_VIEW = 0.05;
            const taxableValueView = Math.max(activeSubTotal - proratedCoupon, 0);
            const gstAmountView = Math.round(taxableValueView * GST_RATE_VIEW);

            /* ── Shipping: recomputed live from the active subtotal against
               the ₹999 free-shipping threshold, never charged when the
               active cart is empty (fully cancelled/returned). ── */
            const SHIPPING_THRESHOLD_VIEW = 999;
            const SHIPPING_FEE_VIEW       = 99;
            const shippingChargeView = hasActiveItems
              ? (activeSubTotal >= SHIPPING_THRESHOLD_VIEW ? 0 : SHIPPING_FEE_VIEW)
              : 0;

            const finalTotal = Math.max(0, taxableValueView + gstAmountView + shippingChargeView);
          %>
          <div class="flex justify-between items-baseline py-2.5 border-b border-outline-variant/10 text-sm">
            <span class="text-on-surface-variant text-xs">Subtotal (Active Items)</span>
            <span class="font-bold text-xs text-on-surface">₹<%= activeSubTotal.toLocaleString('en-IN', {minimumFractionDigits:2, maximumFractionDigits:2}) %></span>
          </div>

          <% if (proratedCoupon > 0) { %>
          <div class="flex justify-between items-baseline py-2.5 border-b border-outline-variant/10 text-sm">
            <span class="text-on-surface-variant text-xs">
              Coupon Discount
              <% if (order.couponCode) { %>
                <span class="text-[10px] text-primary ml-1">(<%= order.couponCode %>)</span>
              <% } %>
            </span>
            <span class="font-bold text-xs text-emerald-400">− ₹<%= proratedCoupon.toLocaleString('en-IN', {minimumFractionDigits:2, maximumFractionDigits:2}) %></span>
          </div>
          <% } %>

          <!-- ── GST row (now computed on the post-coupon taxable value) ── -->
          <div class="flex justify-between items-baseline py-2.5 border-b border-outline-variant/10 text-sm">
            <span class="text-on-surface-variant text-xs">
              GST
              <span class="text-[10px] text-on-surface-variant ml-1">(<%= (GST_RATE_VIEW * 100).toFixed(0) %>%)</span>
            </span>
            <span class="font-bold text-xs text-on-surface">+ ₹<%= gstAmountView.toLocaleString('en-IN', {minimumFractionDigits:2, maximumFractionDigits:2}) %></span>
          </div>

          <% if (shippingChargeView > 0) { %>
          <div class="flex justify-between items-baseline py-2.5 border-b border-outline-variant/10 text-sm">
            <span class="text-on-surface-variant text-xs">Shipping Charge</span>
            <span class="font-bold text-xs text-on-surface">₹<%= shippingChargeView.toLocaleString('en-IN') %></span>
          </div>
          <% } else { %>
          <div class="flex justify-between items-baseline py-2.5 border-b border-outline-variant/10 text-sm">
            <span class="text-on-surface-variant text-xs">Shipping Charge</span>
            <span class="font-bold text-xs text-emerald-400">FREE</span>
          </div>
          <% } %>

          <div class="flex justify-between items-baseline pt-3 mt-1 border-t border-outline-variant/20 text-sm">
            <span class="font-extrabold text-white text-sm">Grand Total</span>
            <span class="font-['Manrope'] font-extrabold text-xl text-primary">₹<%= finalTotal.toLocaleString('en-IN', {minimumFractionDigits:2, maximumFractionDigits:2}) %></span>
          </div>
          <div class="flex justify-between items-baseline py-2.5 text-sm">
            <span class="text-on-surface-variant text-xs">Payment Method</span>
            <span class="font-bold text-xs text-primary uppercase"><%= order.orderMethod %></span>
          </div>
        </div>

      </div>

      <!-- ── Return Requests ── -->
      <% if (order.returnedAt && order.returnedAt.length > 0) { %>
      <div class="bg-surface-container-high rounded-2xl shadow-2xl overflow-hidden fu d4">
        <div class="p-6 border-b border-outline-variant/10 flex items-center justify-between">
          <h3 class="font-['Manrope'] font-bold text-base text-white flex items-center gap-2">
            <span class="material-symbols-outlined text-lg text-primary">undo</span>
            Return Requests
          </h3>
          <span class="text-xs text-on-surface-variant">
            <%= order.returnedAt.length %> request<%= order.returnedAt.length !== 1 ? 's' : '' %>
          </span>
        </div>

        <!-- ── Bulk "Approve All Pending" bar ──
             Only shown when MORE THAN ONE pending return exists. Uses the SAME
             PATCH endpoint (/admin/orders/:id/return) with variantId = 'ALL',
             which updateReturnRequest's controller already normalizes and
             updateReturnRequestService already sums into a single totalRefund
             before crediting the wallet ONCE. This is what avoids splitting
             ₹700+GST-coupon and ₹800+GST-coupon into two separate wallet
             transactions — approving them together produces one combined
             transaction of (700+GST-coupon) + (800+GST-coupon). ── -->
        <% if (pendingReturnsCount > 1) { %>
          <div class="px-6 py-4 border-b border-outline-variant/10 bg-primary/5">
            <div class="flex items-center justify-between gap-4 flex-wrap">
              <div>
                <div class="text-sm font-bold text-white">
                  <%= pendingReturnsCount %> pending returns for this order
                </div>
                <div class="text-[11px] text-on-surface-variant mt-0.5">
                  Approving all at once credits ONE combined wallet refund instead of separate transactions
                </div>
              </div>
              <div class="flex gap-2.5 items-center flex-wrap">
                <input type="text" id="bulkAdminRemark" placeholder="Admin remark for all approvals…"
                  class="bg-surface-container-low text-on-surface border border-outline-variant/40 rounded-md px-3 py-2 text-xs w-56 focus:outline-none focus:border-primary">
                <button id="bulkApproveBtn" onclick="handleBulkReturn('<%= order._id %>', 'Approved')"
                  class="inline-flex items-center gap-1.5 bg-emerald-400/15 text-emerald-400 border border-emerald-400/30 px-4 py-2.5 rounded-lg text-xs font-bold hover:bg-emerald-400/25 transition-colors whitespace-nowrap">
                  <span class="material-symbols-outlined text-[16px]">done_all</span>
                  Approve All Pending
                </button>
              </div>
            </div>
          </div>
        <% } %>

        <div>
          <% order.returnedAt.forEach(function(ret) {
            const retStatus  = ret.returnRequestStatus || 'Pending';
            const isPending  = retStatus === 'Pending';
            const isApproved = retStatus === 'Approved';
            const isRejected = retStatus === 'Rejected';
            const statusTextClass = isApproved ? 'text-emerald-400' : isRejected ? 'text-error' : 'text-amber-300';
            const statusBgClass   = isApproved ? 'bg-emerald-400/10' : isRejected ? 'bg-error/10' : 'bg-amber-400/10';
            const statusIcon  = isApproved ? 'check_circle' : isRejected ? 'cancel' : 'hourglass_top';
            const retVariantIdStr = ret.variant ? ret.variant.toString() : '';
            const retItem = (order.orderItems || []).find(function(oi) {
              return oi.variantId && (oi.variantId.toString() === retVariantIdStr);
            });
            const retItemName        = retItem ? retItem.productName  : 'Item';
            const retItemVariantName = retItem ? retItem.variantName  : '';
            const retItemQty         = ret.quantity || (retItem ? retItem.quantity : 1);
          %>
            <div class="px-6 py-5 border-b border-outline-variant/10">

              <!-- Status + Date row -->
              <div class="flex justify-between items-center mb-4">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full <%= statusBgClass %> <%= statusTextClass %> text-[11px] font-bold uppercase tracking-widest">
                  <span class="material-symbols-outlined text-[13px]"><%= statusIcon %></span>
                  <%= retStatus %>
                </span>
                <span class="text-[11px] text-on-surface-variant">
                  <%= new Date(ret.requestedAt).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %>
                  &nbsp;·&nbsp;
                  <%= new Date(ret.requestedAt).toLocaleTimeString('en-IN', { hour:'2-digit', minute:'2-digit' }) %>
                </span>
              </div>

              <!-- Item summary -->
              <div class="bg-surface-container-low border border-outline-variant/10 rounded-lg p-3 mb-3 flex items-center gap-3">
                <span class="material-symbols-outlined text-primary text-xl">shopping_bag</span>
                <div>
                  <div class="text-sm text-on-surface font-bold"><%= retItemName %></div>
                  <div class="text-[11px] text-on-surface-variant">
                    <%= retItemVariantName %> · Qty: <%= retItemQty %>
                  </div>
                </div>
              </div>

              <!-- Reason / Resolution / Customer remark grid -->
              <div class="grid grid-cols-2 gap-3 mb-4">
                <div class="bg-surface-container-low border border-outline-variant/10 rounded-lg p-3">
                  <div class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-1.5">Reason</div>
                  <div class="text-sm text-on-surface"><%= ret.reason %></div>
                </div>
                <div class="bg-surface-container-low border border-outline-variant/10 rounded-lg p-3">
                  <div class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-1.5">Resolution Requested</div>
                  <div class="text-sm text-on-surface capitalize"><%= ret.resolution || 'Refund' %></div>
                </div>
                <% if (ret.remark) { %>
                <div class="bg-surface-container-low border border-outline-variant/10 rounded-lg p-3 col-span-2">
                  <div class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-1.5">Customer Remarks</div>
                  <div class="text-sm text-on-surface"><%= ret.remark %></div>
                </div>
                <% } %>
              </div>

              <!-- Pending: show textarea + buttons -->
              <% if (isPending) { %>
                <div class="mb-3">
                  <div class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-1.5">
                    Admin Remark (required)
                  </div>
                  <textarea
                    id="adminRemark-<%= retVariantIdStr %>"
                    placeholder="Provide a mandatory reason for approval or rejection…"
                    rows="2"
                    class="w-full bg-surface-container-low text-on-surface border border-outline-variant/40 rounded-lg px-3.5 py-2.5 text-sm resize-y focus:outline-none focus:border-primary"></textarea>
                </div>
                <div class="flex gap-2.5">
                  <button
                    onclick="handleReturn('<%= order._id %>', 'Approved', '<%= retVariantIdStr %>')"
                    class="inline-flex items-center gap-1.5 bg-emerald-400/10 text-emerald-400 border border-emerald-400/30 px-5 py-2.5 rounded-lg text-xs font-bold hover:bg-emerald-400/20 transition-colors">
                    <span class="material-symbols-outlined text-[16px]">check_circle</span>
                    Approve Return
                  </button>
                  <button
                    onclick="handleReturn('<%= order._id %>', 'Rejected', '<%= retVariantIdStr %>')"
                    class="inline-flex items-center gap-1.5 bg-error/10 text-error border border-error/30 px-5 py-2.5 rounded-lg text-xs font-bold hover:bg-error/20 transition-colors">
                    <span class="material-symbols-outlined text-[16px]">cancel</span>
                    Reject Return
                  </button>
                </div>

              <!-- Already processed: show info + admin remark if exists -->
              <% } else { %>
                <div class="text-xs text-on-surface-variant flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-[15px]">info</span>
                  This return request has already been <%= retStatus.toLowerCase() %>.
                </div>
                <% if (ret.adminRemark) { %>
                <div class="mt-2.5 bg-surface-container-low border border-outline-variant/10 rounded-lg p-3">
                  <div class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-1.5">Admin Remark</div>
                  <div class="text-sm <%= isApproved ? 'text-emerald-400' : 'text-error' %>"><%= ret.adminRemark %></div>
                </div>
                <% } %>
              <% } %>

            </div>
          <% }); %>  <%# ← closes returnedAt.forEach %>
        </div>
      </div>
      <% } %>  <%# ← closes if returnedAt.length > 0 %>

    </div>

  </main>

  <script>

    const couponDiscount = <%= order.couponApplied || 0 %>;
    let selectedStatus = '<%= order.deliveryStatus || "pending" %>';
    const orderId      = '<%= order._id %>';

    const chipClassMap = {
      pending:              'bg-amber-400/10 text-amber-300 border border-amber-400/20',
      shipped:               'bg-blue-400/10 text-blue-300 border border-blue-400/20',
      out_for_delivery:      'bg-purple-400/10 text-purple-300 border border-purple-400/20',
      delivered:              'bg-emerald-400/10 text-emerald-400 border border-emerald-400/20',
      cancelled:              'bg-error/10 text-error border border-error/20',
      placed:                 'bg-primary/10 text-primary border border-primary/20',
      completed:              'bg-emerald-400/10 text-emerald-400 border border-emerald-400/20',
      partially_delivered:    'bg-blue-400/10 text-blue-300 border border-blue-400/20',
      returned:               'bg-purple-400/10 text-purple-300 border border-purple-400/20',
    };

    let _tt;
    function showToast(msg, icon, color) {
      icon  = icon  || 'check_circle';
      color = color || '#4ade80';
      const t = document.getElementById('toast');
      document.getElementById('toast-icon').textContent  = icon;
      document.getElementById('toast-icon').style.color  = color;
      document.getElementById('toast-msg').textContent   = msg;
      t.classList.add('show');
      clearTimeout(_tt);
      _tt = setTimeout(function() { t.classList.remove('show'); }, 3000);
    }

    function selectStatus(status) {
      selectedStatus = status;
      document.querySelectorAll('.status-option').forEach(function(el) {
        el.classList.toggle('selected', el.dataset.status === status);
      });
      const hint = document.getElementById('status-hint');
      hint.textContent = '"' + status.replace(/_/g, ' ').toUpperCase() + '" selected — click Update Status to save';
      hint.style.color = status === 'cancelled' ? '#ff716c' : '#90abff';
    }

    async function updateStatus() {
      const btn = document.getElementById('update-btn');
      btn.disabled = true;
      btn.innerHTML = '<span class="material-symbols-outlined" style="animation:spin 0.8s linear infinite;display:inline-block;">sync</span> Updating…';
      try {
        const res  = await fetch('/admin/orders/' + orderId + '/status', {
          method : 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body   : JSON.stringify({ deliveryStatus: selectedStatus })
        });
        const data = await res.json();
        if (!data.success) { showToast(data.message || 'Update failed', 'error', '#ff716c'); return; }

        updateChips(selectedStatus, data.orderStatus);
        showToast('Order status updated successfully', 'check_circle', '#4ade80');
        document.getElementById('status-hint').textContent = 'Status saved ✓';
        document.getElementById('status-hint').style.color = '#4ade80';

        if (selectedStatus !== 'cancelled') {
          updateStepper(selectedStatus);
        } else {
          const stepperEl = document.querySelector('.stepper');
          if (stepperEl) stepperEl.style.display = 'none';
        }
      } catch (err) {
        console.error(err);
        showToast('Something went wrong', 'error', '#ff716c');
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<span class="material-symbols-outlined">sync</span> Update Status';
      }
    }

    async function handleReturn(orderId, action, variantId) {
      const adminRemark = document.getElementById('adminRemark-' + variantId)?.value?.trim() || '';
      if (!adminRemark) {
        showToast('A reason (admin remark) is required.', 'error', '#ff716c');
        return;
      }
      try {
        const res = await fetch('/admin/orders/' + orderId + '/return', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action, variantId, adminRemark })
        });
        const data = await res.json();
        if (!data.success) { showToast(data.message || 'Update failed', 'error', '#ff716c'); return; }
        showToast(data.message, 'check_circle', '#4ade80');
        setTimeout(function() { window.location.reload(); }, 1500);
      } catch (err) {
        console.error(err);
        showToast('Something went wrong', 'error', '#ff716c');
      }
    }

    /* ── Bulk approve/reject ALL pending returns on this order in one call.
       variantId = 'ALL' is already handled by updateReturnRequest's
       normalizedVariant logic and by updateReturnRequestService's isAll
       filter, which sums every approved item's refund into ONE totalRefund
       before calling creditWallet a single time — giving one combined
       wallet transaction instead of N separate ones. ── */
    async function handleBulkReturn(orderId, action) {
      const adminRemark = document.getElementById('bulkAdminRemark')?.value?.trim() || '';
      if (!adminRemark) {
        showToast('A reason (admin remark) is required.', 'error', '#ff716c');
        return;
      }
      const btn = document.getElementById('bulkApproveBtn');
      if (btn) {
        btn.disabled = true;
        btn.style.opacity = '0.6';
      }
      try {
        const res = await fetch('/admin/orders/' + orderId + '/return', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action, variantId: 'ALL', adminRemark })
        });
        const data = await res.json();
        if (!data.success) {
          showToast(data.message || 'Update failed', 'error', '#ff716c');
          if (btn) { btn.disabled = false; btn.style.opacity = ''; }
          return;
        }
        showToast(data.message, 'check_circle', '#4ade80');
        setTimeout(function() { window.location.reload(); }, 1500);
      } catch (err) {
        console.error(err);
        showToast('Something went wrong', 'error', '#ff716c');
        if (btn) { btn.disabled = false; btn.style.opacity = ''; }
      }
    }

    async function updateItemStatus(variantId) {
      const select = document.getElementById('item-status-' + variantId);
      if (!select) return;

      const deliveryStatus = select.value;
      try {
        const res = await fetch('/admin/orders/' + orderId + '/items/' + variantId + '/status', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ deliveryStatus: deliveryStatus })
        });
        const data = await res.json();
        if (!data.success) {
          showToast(data.message || 'Product status update failed', 'error', '#ff716c');
          return;
        }

        selectedStatus = data.deliveryStatus || selectedStatus;
        updateChips(selectedStatus, data.orderStatus);
        showToast(data.message || 'Product status updated', 'check_circle', '#4ade80');
        setTimeout(function() { window.location.reload(); }, 900);
      } catch (err) {
        console.error(err);
        showToast('Something went wrong', 'error', '#ff716c');
      }
    }

    function setChipClass(el, statusKey, extraClasses) {
      el.className = 'inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-full ' +
        (chipClassMap[statusKey] || chipClassMap.pending) + (extraClasses ? ' ' + extraClasses : '');
    }

    function updateChips(dStatus, oStatus) {
      document.getElementById('current-status-label').textContent = dStatus.replace(/_/g, ' ').toUpperCase();
      const chips = document.querySelectorAll('header + div .fu.d1 span.inline-flex, .fu.d1 span.inline-flex');
      const dChip = document.querySelector('.fu.d1 span.inline-flex');
      if (dChip) {
        setChipClass(dChip, dStatus);
        const iconSpan = dChip.querySelector('.material-symbols-outlined');
        dChip.innerHTML = '';
        dChip.appendChild(iconSpan || document.createElement('span'));
        dChip.appendChild(document.createTextNode(' ' + dStatus.replace(/_/g, ' ')));
      }
      const allBadges = document.querySelectorAll('.fu.d1 .inline-flex');
      if (allBadges[1] && oStatus) {
        setChipClass(allBadges[1], oStatus);
        const iconSpan2 = allBadges[1].querySelector('.material-symbols-outlined');
        allBadges[1].innerHTML = '';
        allBadges[1].appendChild(iconSpan2 || document.createElement('span'));
        allBadges[1].appendChild(document.createTextNode(' ' + oStatus));
      }
    }

    function updateStepper(currentStatus) {
      const stepOrder  = ['pending','shipped','out_for_delivery','delivered'];
      const currentIdx = stepOrder.indexOf(currentStatus);
      document.querySelectorAll('.step').forEach(function(step, i) {
        step.classList.remove('done', 'active');
        if (i < currentIdx)        step.classList.add('done');
        else if (i === currentIdx) step.classList.add('active');
      });
      document.querySelectorAll('.step-connector').forEach(function(c, i) {
        c.classList.toggle('done', i < currentIdx);
      });
    }
  </script>

</body>
</html>
