<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>LUXE | Refer &amp; Earn</title>
<script src="/js/blockedUserGuard.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Syne:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@300,0..1&display=swap" rel="stylesheet"/>
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
<style>
  :root {
    --bg: #080c14; --sur: #0e1523; --sur2: #141c2e; --sur3: #1a2338; --sur4: #212c42;
    --bord: rgba(255,255,255,0.07); --bord2: rgba(255,255,255,0.13);
    --pri: #3a6ff7; --gold: #c9a96e; --gold2: #e0c08a;
    --txt: #e8edf8; --txt2: #8892a4; --txt3: #5a6478;
    --green: #22c55e; --red: #ef4444;
    --nav-h: 68px; --side-w: 260px; --r: 12px; --rl: 18px;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--txt); min-height: 100vh; overflow-x: hidden; }
  ::-webkit-scrollbar { width: 4px; } ::-webkit-scrollbar-track { background: var(--bg); } ::-webkit-scrollbar-thumb { background: var(--sur4); border-radius: 99px; }

  /* ── NAV ── */
  nav.topnav {
    position: fixed; top: 0; left: 0; right: 0; height: var(--nav-h);
    background: rgba(8,12,20,0.9); backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--bord);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 36px; z-index: 100;
  }
  .brand { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 1rem; letter-spacing: .22em; text-transform: uppercase; }
  .brand span { color: var(--gold); }
  .nav-links { display: flex; gap: 32px; list-style: none; }
  .nav-links a { font-family: 'Syne', sans-serif; font-size: .6rem; letter-spacing: .18em; text-transform: uppercase; color: var(--txt2); text-decoration: none; transition: color .2s; }
  .nav-links a:hover { color: var(--txt); }
  .nav-acts { display: flex; align-items: center; gap: 16px; }
  .nav-btn { background: none; border: none; cursor: pointer; color: var(--txt2); display: flex; align-items: center; transition: color .2s; text-decoration: none; position: relative; }
  .nav-btn:hover { color: var(--txt); } .nav-btn.on { color: var(--pri); }
  .nav-btn .ms { font-size: 22px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }
  .nav-badge { position: absolute; top: -6px; right: -8px; width: 16px; height: 16px; background: var(--pri); color: #fff; font-size: .58rem; font-weight: 700; border-radius: 50%; display: flex; align-items: center; justify-content: center; }

  /* ── SIDEBAR ── */
  aside.sidebar {
    position: fixed; top: var(--nav-h); left: 0;
    width: var(--side-w); height: calc(100vh - var(--nav-h));
    background: var(--sur); border-right: 1px solid var(--bord);
    display: flex; flex-direction: column; padding: 28px 0 20px; z-index: 50; overflow-y: auto;
  }
  .sidebar-header { padding: 0 24px 24px; border-bottom: 1px solid var(--bord); margin-bottom: 12px; }
  .sidebar-header h3 { font-family: 'Syne', sans-serif; font-weight: 700; font-size: .9rem; margin-bottom: 6px; }
  .sidebar-tier { display: inline-flex; align-items: center; gap: 5px; background: rgba(201,169,110,.1); border: 1px solid rgba(201,169,110,.25); border-radius: 99px; padding: 3px 10px; }
  .tier-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--gold); flex-shrink: 0; }
  .sidebar-nav { display: flex; flex-direction: column; gap: 2px; padding: 0 10px; }
  .sidebar-link {
    display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 8px;
    text-decoration: none; color: var(--txt2); font-size: .625rem; font-family: 'Syne', sans-serif;
    font-weight: 600; letter-spacing: .1em; text-transform: uppercase; transition: all .2s;
  }
  .sidebar-link .material-symbols-outlined { font-size: 17px; flex-shrink: 0; font-variation-settings: 'FILL' 0, 'wght' 300; }
  .sidebar-link:hover { background: var(--sur3); color: var(--txt); }
  .sidebar-link.active { background: rgba(58,111,247,.12); color: var(--pri); }
  .sidebar-footer { margin-top: auto; padding: 18px 24px 0; border-top: 1px solid var(--bord); }
  .sidebar-footer a { display: flex; align-items: center; gap: 9px; text-decoration: none; color: var(--txt3); font-size: .625rem; font-family: 'Syne', sans-serif; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; transition: color .2s; }
  .sidebar-footer a:hover { color: var(--txt2); }
  .sidebar-footer .material-symbols-outlined { font-size: 17px; font-variation-settings: 'FILL' 0, 'wght' 300; }

  /* ── MAIN ── */
  main { margin-left: var(--side-w); padding: calc(var(--nav-h) + 44px) 48px 80px; min-height: 100vh; }
  .page-header { margin-bottom: 36px; }
  .page-header h1 { font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: 3.2rem; letter-spacing: -.01em; line-height: 1.05; margin-bottom: 6px; }
  .page-header h1 em { font-style: italic; color: var(--gold2); }
  .page-header p { color: var(--txt3); font-size: .82rem; font-weight: 300; }

  /* ── Hero ── */
  .hero-card {
    position: relative; overflow: hidden; border-radius: var(--rl);
    background: var(--sur); border: 1px solid var(--bord);
    padding: 44px; margin-bottom: 24px;
    display: flex; align-items: center; justify-content: space-between; gap: 40px; flex-wrap: wrap;
  }
  .hero-card::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 60% 70% at 85% 15%, rgba(58,111,247,.16), transparent 60%), radial-gradient(ellipse 45% 55% at 8% 90%, rgba(201,169,110,.1), transparent 60%); pointer-events: none; }
  .hero-left { position: relative; z-index: 1; max-width: 560px; }
  .hero-pill { display: inline-flex; align-items: center; gap: 6px; background: rgba(58,111,247,.1); border: 1px solid rgba(58,111,247,.25); border-radius: 99px; padding: 4px 14px; margin-bottom: 16px; }
  .hero-pill span { font-family: 'Syne', sans-serif; font-size: .5rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--pri); }
  .hero-title { font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: 2.4rem; line-height: 1.15; margin-bottom: 14px; }
  .hero-title em { font-style: italic; color: var(--gold2); }
  .hero-text { color: var(--txt2); font-size: .85rem; line-height: 1.7; font-weight: 300; margin-bottom: 22px; }
  .hero-stat { display: flex; align-items: center; gap: 10px; }
  .hero-stat .ms { font-size: 22px; color: var(--pri); font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }
  .hero-stat p { font-size: .82rem; color: var(--txt2); }
  .hero-stat strong { color: var(--pri); font-family: 'Syne', sans-serif; font-weight: 700; }

  .hero-reward {
    position: relative; z-index: 1; width: 220px; aspect-ratio: 4/3; border-radius: var(--r);
    background: var(--sur2); border: 1px solid var(--bord2);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; flex-shrink: 0;
  }
  .hero-reward .ms { font-size: 40px; color: var(--gold2); font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 1, 'wght' 300; }
  .hero-reward-lbl { font-family: 'Syne', sans-serif; font-size: .5rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--txt3); }
  .hero-reward-val { font-family: 'Cormorant Garamond', serif; font-size: 1.7rem; font-weight: 400; color: var(--gold2); }

  /* ── Grid cards ── */
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
  .detail-card { background: var(--sur); border: 1px solid var(--bord); border-radius: var(--rl); padding: 28px; animation: fu .5s ease both; }
  .card-title { font-family: 'Syne', sans-serif; font-weight: 700; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; color: var(--txt2); margin-bottom: 20px; display: flex; align-items: center; gap: 8px; }
  .card-title .ms { font-size: 16px; color: var(--pri); font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }

  /* Referral code box */
  .code-box {
    display: flex; align-items: center; justify-content: space-between; gap: 14px;
    border: 2px dashed var(--bord2); border-radius: var(--r); background: var(--sur2);
    padding: 16px 18px; margin-bottom: 12px;
  }
  .code-box span.code { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 1.05rem; letter-spacing: .04em; color: var(--txt); }
  .copy-btn { display: flex; align-items: center; gap: 6px; background: none; border: none; color: var(--pri); font-family: 'Syne', sans-serif; font-size: .68rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; cursor: pointer; transition: opacity .2s; }
  .copy-btn:hover { opacity: .7; }
  .copy-btn .ms { font-size: 17px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }
  .hint-text { font-size: .72rem; color: var(--txt3); font-style: italic; }

  /* Earned balance */
  .earned-row { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 16px; }
  .earned-lbl { font-family: 'Syne', sans-serif; font-size: .52rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--txt3); margin-bottom: 8px; }
  .earned-val { font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 2.1rem; color: var(--gold2); }
  .earned-icon { font-size: 30px; color: var(--gold2); font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 1, 'wght' 300; }
  .info-strip { display: flex; align-items: flex-start; gap: 8px; background: var(--sur2); border-radius: 10px; padding: 12px 14px; font-size: .74rem; color: var(--txt2); line-height: 1.6; }
  .info-strip .ms { font-size: 15px; flex-shrink: 0; margin-top: 1px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }
  .info-strip strong { color: var(--txt); }

  /* Link generator */
  .link-card { padding: 0; overflow: hidden; }
  .link-head { display: flex; align-items: center; justify-content: space-between; padding: 20px 28px; background: var(--sur3); border-bottom: 1px solid var(--bord); }
  .link-head-left { display: flex; align-items: center; gap: 14px; }
  .link-icon-wrap { width: 40px; height: 40px; border-radius: 10px; background: rgba(255,255,255,.06); display: flex; align-items: center; justify-content: center; }
  .link-icon-wrap .ms { font-size: 19px; color: var(--txt); font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }
  .link-head-title { font-family: 'Syne', sans-serif; font-weight: 700; font-size: .78rem; color: var(--txt); }
  .link-head-sub { font-size: .68rem; color: var(--txt3); margin-top: 2px; }
  .live-pill { display: flex; align-items: center; gap: 6px; border: 1px solid var(--bord2); border-radius: 99px; padding: 4px 12px; }
  @keyframes livepulse { 0%,100%{opacity:1} 50%{opacity:.35} }
  .live-dot { width: 6px; height: 6px; background: var(--green); border-radius: 50%; animation: livepulse 2s infinite; }
  .live-pill span.lbl { font-family: 'Syne', sans-serif; font-size: .5rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--txt2); }

  .link-body { padding: 28px; }
  .gen-btn {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--pri); color: #fff; border: none; border-radius: 10px;
    padding: 13px 26px; font-family: 'Syne', sans-serif; font-size: .72rem; font-weight: 700;
    letter-spacing: .08em; text-transform: uppercase; cursor: pointer; transition: all .2s;
    position: relative; overflow: hidden;
  }
  .gen-btn:hover { background: #5b84ff; box-shadow: 0 0 24px rgba(58,111,247,.35); }
  .gen-btn:disabled { opacity: .7; cursor: default; }
  .gen-btn .ms { font-size: 17px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }

  .link-result { background: var(--sur2); border: 1px solid var(--bord); border-radius: var(--r); padding: 20px; }
  .link-result-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .link-result-lbl { font-family: 'Syne', sans-serif; font-size: .52rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--txt3); }
  .active-tag { display: flex; align-items: center; gap: 4px; color: var(--green); font-size: .7rem; font-weight: 700; }
  .active-tag .ms { font-size: 14px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 1, 'wght' 300; }
  .link-url-box { font-size: .78rem; font-weight: 500; background: var(--sur); border: 1px solid var(--bord); border-radius: 8px; padding: 12px 16px; word-break: break-all; line-height: 1.6; margin-bottom: 14px; color: var(--txt); }
  .link-actions { display: flex; gap: 10px; }
  .link-action-btn {
    flex: 1; display: flex; align-items: center; justify-content: center; gap: 6px;
    border: 1px solid var(--bord2); background: var(--sur); color: var(--txt);
    font-family: 'Syne', sans-serif; font-size: .68rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
    border-radius: 8px; padding: 10px; cursor: pointer; transition: background .2s;
  }
  .link-action-btn:hover { background: var(--sur3); }
  .link-action-btn .ms { font-size: 16px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }

  .link-foot { display: flex; align-items: center; justify-content: space-between; padding: 14px 28px; background: var(--sur2); border-top: 1px solid var(--bord); }
  .link-foot a { display: flex; align-items: center; gap: 6px; text-decoration: none; color: var(--txt3); font-size: .7rem; font-weight: 500; transition: color .15s; }
  .link-foot a:hover { color: var(--txt2); }
  .link-foot a .ms { font-size: 15px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }
  .link-foot .note { font-size: .7rem; color: var(--txt3); }

  @keyframes spin { to { transform: rotate(360deg); } }
  .spinner { display: inline-block; width: 12px; height: 12px; border: 2px solid rgba(255,255,255,.35); border-top-color: #fff; border-radius: 50%; animation: spin .5s linear infinite; vertical-align: middle; }

  @keyframes rippleAnim { to { transform: scale(4); opacity: 0; } }

  @keyframes fu { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }

  @media (max-width: 900px) { :root { --side-w: 0px; } aside.sidebar { display: none; } main { padding: calc(var(--nav-h) + 28px) 20px 60px; } .nav-links { display: none; } }
  @media (max-width: 700px) { .grid-2 { grid-template-columns: 1fr; } .hero-card { flex-direction: column; } .hero-reward { width: 100%; } }
</style>
  <link rel="stylesheet" href="/css/navigation-consistency.css" />
</head>
<body>

<!-- ── NAV ── -->
<nav class="topnav">
  <div class="brand">LUXE <span>ATELIER</span></div>
  <ul class="nav-links">
    <li><a href="/">Showroom</a></li>
    <li><a href="/product-listing">Collections</a></li>
  </ul>
  <div class="nav-acts">
    <a href="/wishlist" class="nav-btn"><span class="ms material-symbols-outlined">favorite</span></a>
    <a href="/cart" class="nav-btn">
      <span class="ms material-symbols-outlined">shopping_bag</span>
      <% if (typeof cartCount !== 'undefined' && cartCount > 0) { %>
        <span class="nav-badge"><%= cartCount %></span>
      <% } %>
    </a>
    <a href="/profile" class="nav-btn"><span class="ms material-symbols-outlined">person</span></a>
  </div>
</nav>

<!-- ── SIDEBAR ── -->
<aside class="sidebar">
  <div class="sidebar-header">
    <h3>User Account</h3>
    <div class="sidebar-tier">
      <div class="tier-dot"></div>
    </div>
  </div>
  <nav class="sidebar-nav">
    <a href="/profile" class="sidebar-link">
      <span class="material-symbols-outlined">person</span>
      <span>Profile</span>
    </a>
    <a href="/order/my-orders" class="sidebar-link">
      <span class="material-symbols-outlined">package_2</span>
      <span>My Orders</span>
    </a>
    <a href="/address" class="sidebar-link">
      <span class="material-symbols-outlined">distance</span>
      <span>Manage Address</span>
    </a>
    <a href="/changePassword" class="sidebar-link">
      <span class="material-symbols-outlined">lock_reset</span>
      <span>Change Password</span>
    </a>
    <a href="/wishlist" class="sidebar-link">
      <span class="material-symbols-outlined">favorite</span>
      <span>Wishlist</span>
    </a>
    <a href="/referal" class="sidebar-link active">
      <span class="material-symbols-outlined">share_reviews</span>
      <span>Referral Link</span>
    </a>
    <a href="/wallet" class="sidebar-link">
      <span class="material-symbols-outlined">account_balance_wallet</span>
      <span>Wallet</span>
    </a>
  </nav>
  <div class="sidebar-footer">
    <a href="/logout">
      <span class="material-symbols-outlined">logout</span>
      <span>Sign Out</span>
    </a>
  </div>
</aside>

<!-- ── MAIN ── -->
<main>
  <div class="page-header">
    <h1>Refer <em>&amp; Earn</em></h1>
    <p>Invite friends and earn rewards on every successful referral.</p>
  </div>

  <!-- Hero -->
  <div class="hero-card">
    <div class="hero-left">
      <div class="hero-pill"><span>Refer &amp; Earn</span></div>
      <h2 class="hero-title">Invite friends, <em>earn rewards</em></h2>
      <p class="hero-text">Share LUXE with your circle. For every friend who signs up and completes their first order, you both walk away with a reward.</p>
      <div class="hero-stat">
        <span class="ms material-symbols-outlined">group</span>
        <p><strong><%= (typeof referralCount !== 'undefined' ? referralCount : 0) %></strong> friends have already joined your network.</p>
      </div>
    </div>
    <div class="hero-reward">
      <span class="ms material-symbols-outlined">redeem</span>
      <p class="hero-reward-lbl">Reward per referral</p>
      <p class="hero-reward-val">₹50 credit</p>
    </div>
  </div>

  <!-- Grid: code + balance -->
  <div class="grid-2">

    <!-- Referral Code -->
    <div class="detail-card">
      <div class="card-title"><span class="ms material-symbols-outlined">qr_code_2</span>Your unique referral code</div>
      <div class="code-box">
        <span class="code" id="refCode"><%= typeof referralCode !== 'undefined' ? referralCode : 'LUXE$$$$$' %></span>
        <button class="copy-btn" onclick="copyCode()">
          <span class="ms material-symbols-outlined">content_copy</span>Copy
        </button>
      </div>
      <p class="hint-text">Share this code or your personal link to start earning.</p>
    </div>

    <!-- Earned balance -->
    <div class="detail-card">
      <div class="earned-row">
        <div>
          <p class="earned-lbl">Total earned</p>
          <p class="earned-val" id="balanceDisplay">₹<%= balance || 0 %></p>
        </div>
        <span class="earned-icon ms material-symbols-outlined">military_tech</span>
      </div>
      <div class="info-strip">
        <span class="ms material-symbols-outlined">info</span>
        <span>Earn <strong>₹50</strong> credit for every friend who signs up with your link.</span>
      </div>
    </div>
  </div>

  <!-- Link Generator -->
  <div class="detail-card link-card">
    <div class="link-head">
      <div class="link-head-left">
        <div class="link-icon-wrap"><span class="ms material-symbols-outlined">link</span></div>
        <div>
          <p class="link-head-title">Referral link generator</p>
          <p class="link-head-sub">Generate and share your unique referral link</p>
        </div>
      </div>
      <div class="live-pill">
        <span class="live-dot"></span>
        <span class="lbl">Live</span>
      </div>
    </div>

    <div class="link-body">
      <% if (!link) { %>
      <div id="genSection">
        <button class="gen-btn" id="genBtn" onclick="handleGenerate(event)">
          <span class="ms material-symbols-outlined">bolt</span>
          <span id="genBtnLabel">Generate link</span>
        </button>
      </div>
      <% } %>

      <div class="link-result" id="linkBox" <% if (!link) { %>style="display:none"<% } %>>
        <div class="link-result-top">
          <span class="link-result-lbl">Your referral link</span>
          <span class="active-tag"><span class="ms material-symbols-outlined">check_circle</span>Active</span>
        </div>
        <div class="link-url-box" id="linkUrl">
          http://localhost:5000/signup?ref=<%= link || '' %>
        </div>
        <div class="link-actions">
          <button class="link-action-btn" onclick="copyLink()">
            <span class="ms material-symbols-outlined">content_copy</span>Copy link
          </button>
          <button class="link-action-btn" onclick="shareLink()">
            <span class="ms material-symbols-outlined">ios_share</span>Share
          </button>
        </div>
      </div>
    </div>

    <div class="link-foot">
      <a href="/profile"><span class="ms material-symbols-outlined">arrow_back</span>Back to profile</a>
      <span class="note">Links never expire</span>
    </div>
  </div>

</main>

<script>
  let currentLink = document.getElementById('linkUrl')
    ? document.getElementById('linkUrl').textContent.trim()
    : '';

  async function handleGenerate(e) {
    const btn     = document.getElementById('genBtn');
    const label   = document.getElementById('genBtnLabel');
    const linkBox = document.getElementById('linkBox');
    const linkUrl = document.getElementById('linkUrl');

    const rect   = btn.getBoundingClientRect();
    const ripple = document.createElement('span');
    const size   = Math.max(rect.width, rect.height);
    Object.assign(ripple.style, {
      position: 'absolute', borderRadius: '50%',
      background: 'rgba(255,255,255,.25)',
      width: size + 'px', height: size + 'px',
      left: (e.clientX - rect.left - size / 2) + 'px',
      top: (e.clientY - rect.top - size / 2) + 'px',
      transform: 'scale(0)',
      animation: 'rippleAnim .55s linear forwards',
      pointerEvents: 'none',
    });
    btn.appendChild(ripple);
    setTimeout(() => ripple.remove(), 600);

    btn.disabled = true;
    label.innerHTML = '<span class="spinner"></span> Generating…';

    try {
      const res = await fetch('/profile/referal-link', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: '<%= isLogged ? (isLogged.id || isLogged._id) : "" %>' }),
      });
      const data = await res.json();

      if (!data.success) {
        Swal.fire({ toast: true, icon: 'error', title: data.message, position: 'top-right', showConfirmButton: false, timer: 3000 });
        label.innerHTML = '<span class="ms material-symbols-outlined">bolt</span> Generate link';
        btn.disabled = false;
        return;
      }

      currentLink = 'http://localhost:5000/signup?ref=' + data.token;
      linkUrl.textContent = currentLink;
      linkBox.style.display = 'block';
      const genSection = document.getElementById('genSection');
      if (genSection) genSection.style.display = 'none';

      triggerSuccess();
      setTimeout(() => window.location.reload(), 1800);

    } catch (err) {
      console.error(err);
      Swal.fire({ toast: true, icon: 'error', title: 'Something went wrong. Please try again.', position: 'top-right', showConfirmButton: false, timer: 3000 });
      label.innerHTML = '<span class="ms material-symbols-outlined">bolt</span> Generate link';
      btn.disabled = false;
    }
  }

  function copyCode() {
    const code = document.getElementById('refCode').textContent.trim();
    navigator.clipboard.writeText(code).then(() => {
      Swal.fire({ toast: true, icon: 'success', title: 'Referral code copied!', position: 'top-right', showConfirmButton: false, timer: 2000 });
    });
  }

  function copyLink() {
    const link = currentLink || document.getElementById('linkUrl').textContent.trim();
    navigator.clipboard.writeText(link).then(() => {
      Swal.fire({ toast: true, icon: 'success', title: 'Link copied to clipboard!', position: 'top-right', showConfirmButton: false, timer: 2000 });
    });
  }

  function shareLink() {
    const link = currentLink || document.getElementById('linkUrl').textContent.trim();
    if (navigator.share) {
      navigator.share({ title: 'Join LUXE via my referral!', url: link });
    } else {
      copyLink();
    }
  }

  function triggerSuccess() {
    Swal.fire({
      icon: 'success',
      title: 'Link generated!',
      text: 'Your referral link is now active. Share it with friends and start earning rewards.',
      confirmButtonText: 'Done',
      confirmButtonColor: '#3a6ff7',
      timer: 3000,
      timerProgressBar: true,
    });
  }
</script>

</body>
</html>
