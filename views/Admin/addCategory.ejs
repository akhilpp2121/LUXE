<!-- Form starts here — wraps everything including header buttons -->
<form action="/admin/category-add" method="POST" id="categoryForm">

<!-- Header Section -->
<div class="flex flex-col md:flex-row md:items-end justify-between mb-xl gap-md">
<div>
<h2 class="font-h1 text-h1 text-on-surface mb-xs">Add New Category</h2>
<p class="font-body-md text-body-md text-on-surface-variant">Configure a new product classification for your enterprise inventory.</p>
</div>
<div class="flex gap-sm">
<button type="button" onclick="resetForm()"
    class="px-md h-10 border border-gray-700 bg-gray-900 text-white rounded-lg">
    Cancel
</button>

<button type="submit" class="px-6 h-10 bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-semibold rounded-lg flex items-center gap-2 shadow-lg shadow-purple-500/30 hover:shadow-xl hover:scale-[1.03] active:scale-[0.97] transition-all duration-200">
    <span class="material-symbols-outlined text-[20px]">save</span>
    <span class="tracking-wide">Save Category</span>
</button>
</div>
</div>

<!-- Bento Grid Layout for Form -->
<div class="grid grid-cols-12 gap-6">

    <!-- Primary Form Area -->
    <div class="col-span-12 lg:col-span-8 space-y-6">

        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">

            <h3 class="text-lg font-semibold text-white mb-6 flex items-center gap-2">
                <span class="material-symbols-outlined text-purple-500">info</span>
                Category Details
            </h3>

            <div class="space-y-6">

                <!-- Category Name -->
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">
                        Category Name <span class="text-red-500">*</span>
                    </label>
                    <input 
                        id="category_name"
                        name="categoryName"
                        type="text"
                        placeholder="Enter category name"
                        class="w-full px-4 py-3 rounded-lg 
                        bg-gray-950 border border-gray-700 
                        text-white placeholder-gray-400 
                        focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 
                        outline-none transition-all"
                    />
                    <p id="nameError" class="text-xs text-red-500 mt-1 hidden"></p>
                    <p class="text-xs text-gray-500 mt-1 italic">
                        This name will be visible to customers.
                    </p>
                </div>

                <!-- Description -->
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">
                        Description
                    </label>
                    <textarea 
                        id="description"
                        name="description"
                        rows="5"
                        placeholder="Enter description..."
                        class="w-full px-4 py-3 rounded-lg 
                        bg-gray-950 border border-gray-700 
                        text-white placeholder-gray-400 
                        focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 
                        outline-none transition-all resize-none">
                    </textarea>
                    <p id="descError" class="text-xs text-red-500 mt-1 hidden"></p>
                </div>

            </div>
        </div>

    </div>

    <!-- Secondary Column -->
    <div class="col-span-12 lg:col-span-4 space-y-6">

        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">

            <h3 class="text-xs text-gray-400 mb-4 uppercase tracking-wider">
                Settings
            </h3>

            <!-- Status -->
            <div>
                <label class="block text-sm font-medium text-gray-300 mb-3">
                    Category Status
                </label>

                <div class="flex flex-col gap-3">

                    <!-- Active -->
                    <label class="flex items-center gap-3 p-3 border border-gray-700 rounded-lg cursor-pointer 
                    hover:bg-gray-800 transition-all 
                    has-[:checked]:border-purple-500 has-[:checked]:bg-purple-500/10">
                        <input checked name="status" type="radio" value="active"
                            class="w-4 h-4 accent-purple-500">
                        <div>
                            <span class="font-medium text-white">Active</span>
                            <p class="text-xs text-gray-400">
                                Visible and available for products
                            </p>
                        </div>
                    </label>

                    <!-- Inactive -->
                    <label class="flex items-center gap-3 p-3 border border-gray-700 rounded-lg cursor-pointer 
                    hover:bg-gray-800 transition-all 
                    has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-500/10">
                        <input name="status" type="radio" value="inactive"
                            class="w-4 h-4 accent-indigo-500">
                        <div>
                            <span class="font-medium text-white">Inactive</span>
                            <p class="text-xs text-gray-400">
                                Hidden from storefront
                            </p>
                        </div>
                    </label>

                </div>
            </div>

        </div>

    </div>

</div>

<!-- Mobile Footer Actions (Visible on small screens only) -->
<div class="mt-xl lg:hidden flex flex-col gap-sm">
    <button type="submit" class="w-full py-3 bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-semibold rounded-lg shadow-lg shadow-purple-500/30">Save Category</button>
    <button type="button" onclick="resetForm()" class="w-full py-3 border border-gray-700 bg-gray-900 text-white font-label-md text-label-md rounded-lg">Cancel</button>
</div>

