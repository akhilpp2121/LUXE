<!DOCTYPE html>
<html class="dark" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>LUXE Admin - Sales Dashboard</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap"
    rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    rel="stylesheet" />
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "secondary-container": "#313aa1", "on-primary-fixed-variant": "#00266e", "tertiary-dim": "#ef8fe5", "surface-container-highest": "#192540", "on-surface-variant": "#a3aac4", "on-tertiary-fixed-variant": "#711f6f", "outline": "#6d758c", "error-container": "#9f0519", "surface-bright": "#1f2b49", "secondary-fixed": "#cbceff", "primary-dim": "#316bf3", "background": "#060e20", "surface-variant": "#192540", "surface-container-lowest": "#000000", "primary-fixed": "#7b9cff", "surface-container-high": "#141f38", "surface-container": "#0f1930", "on-secondary-fixed-variant": "#3c45ab", "on-secondary-fixed": "#1c248e", "inverse-surface": "#faf8ff", "tertiary": "#ffb4f4", "surface-tint": "#90abff", "secondary-dim": "#8b94ff", "secondary": "#8b94ff", "on-primary-container": "#001e5a", "surface": "#060e20", "primary-fixed-dim": "#658eff", "on-tertiary": "#722070", "on-secondary-container": "#caccff", "on-primary-fixed": "#000000", "error-dim": "#d7383b", "error": "#ff716c", "tertiary-fixed-dim": "#ef8fe5", "on-surface": "#dee5ff", "surface-container-low": "#091328", "on-error-container": "#ffa8a3", "surface-dim": "#060e20", "on-secondary": "#000478", "on-error": "#490006", "outline-variant": "#40485d", "on-primary": "#002873", "primary": "#90abff", "on-tertiary-container": "#661466", "secondary-fixed-dim": "#bbbfff", "primary-container": "#7b9cff", "tertiary-fixed": "#fe9cf4", "on-background": "#dee5ff", "tertiary-container": "#fe9cf4", "on-tertiary-fixed": "#480049", "inverse-primary": "#0053dc", "inverse-on-surface": "#4d556b"
          },
          fontFamily: { "headline": ["Manrope"], "body": ["Inter"], "label": ["Inter"] },
          borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
        },
      },
    }
  </script>
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }

    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    ::-webkit-scrollbar {
      width: 6px;
    }

    ::-webkit-scrollbar-track {
      background: #060e20;
    }

    ::-webkit-scrollbar-thumb {
      background: #1f2b49;
      border-radius: 10px;
    }

    .glass-effect {
      background: rgba(25, 37, 64, 0.7);
      backdrop-filter: blur(20px);
    }

    .luxe-gradient {
      background: linear-gradient(135deg, #316bf3 0%, #90abff 100%);
    }

    .search-btn {
      transition: all 0.15s ease;
    }

    .search-btn:active {
      transform: scale(0.93);
    }

    /* Pagination button styles */
    .page-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 32px;
      height: 32px;
      padding: 0 8px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      border: 1px solid rgba(64, 72, 93, 0.4);
      background: #0f1930;
      color: #a3aac4;
      transition: all 0.15s;
      user-select: none;
    }

    .page-btn:hover:not(:disabled) {
      background: #1f2b49;
      color: #fff;
    }

    .page-btn.active {
      background: linear-gradient(135deg, #316bf3 0%, #90abff 100%);
      color: #fff;
      border-color: transparent;
    }

    .page-btn:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }
  </style>
  <link rel="stylesheet" href="/css/navigation-consistency.css" />
</head>

<body class="bg-background text-on-background font-body antialiased min-h-screen">

  <!-- Sidebar -->
  <aside class="h-screen w-64 fixed left-0 top-0 bg-[#091328] dark:bg-slate-950 flex flex-col py-8 px-4 z-50">

    <div class="mb-10 px-4">
      <h1 class="font-['Manrope'] font-extrabold text-xl tracking-tighter text-white">LUXE Admin</h1>
      <p class="text-on-surface-variant text-[10px] uppercase tracking-widest mt-1">Premium Command</p>
    </div>

    <nav class="flex-1 space-y-1">
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-white border-l-4 border-[#90abff] bg-[#1f2b49] font-bold text-sm"
        href="/admin/dashboard">
        <span class="material-symbols-outlined text-lg">dashboard</span>Dashboard
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/order-management">
        <span class="material-symbols-outlined text-lg">shopping_cart</span>Orders
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/products">
        <span class="material-symbols-outlined text-lg">inventory_2</span>Products
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/users">
        <span class="material-symbols-outlined text-lg">group</span>Users
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/analystic">
        <span class="material-symbols-outlined text-lg">monitoring</span>Analytics
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/coupons">
        <span class="material-symbols-outlined text-lg">confirmation_number</span>Coupons
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/category">
        <span class="material-symbols-outlined text-lg">category</span>Categories
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/offer">
        <span class="material-symbols-outlined text-lg">local_offer</span>Offers
      </a>
      
    </nav>

    <div class="mt-auto px-4 pt-6 border-t border-[#1f2a44]">
      <form action="/admin/logout" method="POST">
        <button type="submit"
          class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-['Inter'] font-bold text-sm tracking-tight">
          <span class="material-symbols-outlined text-lg">logout</span>
          Logout
        </button>
      </form>
    </div>

  </aside>

  <!-- Main Content -->
  <main class="ml-64 min-h-screen relative">

    <!-- Top Nav -->
    <header
      class="fixed top-0 right-0 w-[calc(100%-16rem)] h-16 bg-[#060e20]/70 backdrop-blur-xl shadow-2xl shadow-blue-900/10 flex items-center justify-between px-8 z-40">
      <div class="flex items-center gap-6">
        <h2 class="font-['Manrope'] font-semibold text-lg text-[#90abff]">Dashboard</h2>
      </div>

      <div class="flex items-center gap-4">
        <button class="p-2 text-on-surface-variant hover:text-white transition-colors">
          <span class="material-symbols-outlined">notifications</span>
        </button>
        <button class="p-2 text-on-surface-variant hover:text-white transition-colors">
          <span class="material-symbols-outlined">settings</span>
        </button>
        <div class="h-8 w-px bg-outline-variant/20 mx-2"></div>
        <div class="w-9 h-9 rounded-full luxe-gradient flex items-center justify-center text-white text-xs font-bold">
          A
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <div class="pt-24 px-8 pb-12">

      <section class="mb-8">
        <h2 class="font-['Manrope'] font-extrabold text-2xl text-white">Sales Dashboard</h2>
        <p class="text-on-surface-variant text-sm mt-1">Real-time performance metrics and revenue tracking.</p>
      </section>

      <% const revenueSeries=(chartData && chartData.data) ? chartData.data : { labels: [], values: [] }; const
        fullRevenue=chartData && typeof chartData.fullRevenue==="number" ? chartData.fullRevenue : 0; const
        totalOrders=chartData && typeof chartData.totalOrders==="number" ? chartData.totalOrders : 0; const tabs=[ {
        key: "weekly" , label: "Weekly" }, { key: "monthly" , label: "Monthly" }, { key: "yearly" , label: "Yearly" }
        ]; %>

        <!-- Revenue Performance -->
        <div class="bg-surface-container-high rounded-2xl shadow-2xl overflow-hidden mb-8">
          <div
            class="p-6 border-b border-outline-variant/10 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
              <h3 class="font-['Manrope'] font-bold text-base text-white">Revenue Performance</h3>
              <div class="flex items-center gap-3 mt-1.5">
                <span class="font-['Manrope'] font-extrabold text-2xl text-primary">
                  ₹<%= fullRevenue.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </span>
                <span
                  class="text-[10px] font-bold text-on-surface-variant bg-surface-container-low px-2.5 py-1 rounded-full uppercase tracking-widest">
                  <%= totalOrders %> units sold
                </span>
              </div>
            </div>
            <div class="flex p-1 bg-surface-container-low rounded-xl">
              <% tabs.forEach(tab=> { %>
                <a href="/admin/dashboard?filter=<%= tab.key %>"
                  class="px-4 py-1.5 rounded-lg text-xs font-bold transition-colors <%= filter === tab.key ? 'luxe-gradient text-white' : 'text-on-surface-variant hover:text-white' %>">
                  <%= tab.label %>
                </a>
                <% }) %>
            </div>
          </div>

          <div class="p-6 h-[320px] relative">
            <% if (!revenueSeries.labels || revenueSeries.labels.length===0) { %>
              <div class="absolute inset-0 flex items-center justify-center text-on-surface-variant text-sm">
                No revenue data available for this period.
              </div>
              <% } else { %>
                <canvas id="revenueChart"></canvas>
                <% } %>
          </div>
        </div>

        <!-- Insights Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">

          <!-- Top Products -->
          <div class="bg-surface-container-high rounded-2xl shadow-2xl p-6">
            <div class="flex justify-between items-center mb-6">
              <h3 class="font-['Manrope'] font-bold text-base text-white">Top 10 Products</h3>
            </div>
            <% if (!topProducts || topProducts.length===0) { %>
              <p class="text-sm text-on-surface-variant">No product sales recorded yet.</p>
              <% } else { %>
                <div class="space-y-4">
                  <% const maxUnitsSold=topProducts[0].unitsSold || 1; %>
                    <% topProducts.forEach(product=> { %>
                      <div class="space-y-1.5">
                        <div class="flex justify-between text-xs font-bold">
                          <span class="text-on-surface">
                            <%= product.name %>
                          </span>
                          <span class="text-primary">
                            <%= product.unitsSold || 0 %> units sold
                          </span>
                        </div>
                        <div class="h-2 w-full bg-surface-container-low rounded-full overflow-hidden">
                          <div class="h-full luxe-gradient rounded-full"
                            style="width: <%= Math.min((product.unitsSold / maxUnitsSold) * 100, 100) %>%"></div>
                        </div>
                      </div>
                      <% }) %>
                </div>
                <% } %>
          </div>

          <!-- Category Performance -->
          <div class="bg-surface-container-high rounded-2xl shadow-2xl p-6">
            <div class="flex justify-between items-center mb-6">
              <h3 class="font-['Manrope'] font-bold text-base text-white">Top 10 Categories</h3>
            </div>
            <% if (!topCategories || topCategories.length===0) { %>
              <p class="text-sm text-on-surface-variant">No category sales recorded yet.</p>
              <% } else { %>
                <div class="space-y-4">
                  <% const maxCategoryUnitsSold=topCategories[0].unitsSold || 1; %>
                    <% topCategories.forEach(cat=> { %>
                      <div class="space-y-1.5">
                        <div class="flex justify-between text-xs font-bold">
                          <span class="text-on-surface">
                            <%= cat.name %>
                          </span>
                          <span class="text-primary">
                            <%= cat.unitsSold || 0 %> units sold
                          </span>
                        </div>
                        <div class="h-2 w-full bg-surface-container-low rounded-full overflow-hidden">
                          <div class="h-full luxe-gradient rounded-full"
                            style="width: <%= Math.min((cat.unitsSold / maxCategoryUnitsSold) * 100, 100) %>%"></div>
                        </div>
                      </div>
                      <% }) %>
                </div>
                <% } %>
          </div>

        </div>

        <%
          // ─── Net Balance Fix ───────────────────────────────────────────────────────
          // Previously: netBalance = ledger[last].runningBalance
          // Bug: if runningBalance isn't computed server-side, it comes through as 0.
          // Fix: recompute runningBalance client-side from credit/debit on each row,
          //       and derive the header totals + net from the full array, not the last row.
          //
          // Also ensure ledger rows always have a valid runningBalance by computing it
          // here if the server didn't supply one.
          let runningTotal = 0;
          const ledgerWithBalance = (ledger || []).map(entry => {
            runningTotal += (entry.credit || 0) - (entry.debit || 0);
            return { ...entry, runningBalance: entry.runningBalance || runningTotal };
          });

          const ledgerTotals = ledgerWithBalance.reduce((acc, entry) => {
            acc.credit += entry.credit || 0;
            acc.debit  += entry.debit  || 0;
            return acc;
          }, { credit: 0, debit: 0 });

          // Net balance = last row's running balance (or sum of credits minus debits)
          const netBalance = ledgerWithBalance.length > 0
            ? ledgerWithBalance[ledgerWithBalance.length - 1].runningBalance
            : 0;
        %>

          <!-- Ledger Book -->
          <section class="bg-surface-container-high rounded-2xl shadow-2xl overflow-hidden">
            <div
              class="p-6 border-b border-outline-variant/10 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
              <div>
                <h3 class="font-['Manrope'] font-bold text-base text-white">Ledger Book</h3>
                <p class="text-xs text-on-surface-variant mt-1">Last 30 days — completed sales (credit) vs returns
                  (debit)</p>
              </div>
              <div class="flex items-center gap-6">
                <div class="text-right">
                  <p class="text-[10px] text-on-surface-variant uppercase tracking-widest font-bold">Total Credit</p>
                  <p class="font-['Manrope'] font-bold text-emerald-400">
                    +₹<%= ledgerTotals.credit.toLocaleString('en-IN', { minimumFractionDigits: 2,
                        maximumFractionDigits: 2 }) %>
                  </p>
                </div>
                <div class="text-right">
                  <p class="text-[10px] text-on-surface-variant uppercase tracking-widest font-bold">Total Debit</p>
                  <p class="font-['Manrope'] font-bold text-error">
                    -₹<%= ledgerTotals.debit.toLocaleString('en-IN', { minimumFractionDigits: 2,
                        maximumFractionDigits: 2 }) %>
                  </p>
                </div>
                <div class="text-right border-l border-outline-variant/10 pl-6">
                  <p class="text-[10px] text-on-surface-variant uppercase tracking-widest font-bold">Net Balance</p>
                  <p class="font-['Manrope'] font-bold text-white">
                    ₹<%= netBalance.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                  </p>
                </div>
              </div>
            </div>

            <% if (!ledgerWithBalance || ledgerWithBalance.length===0) { %>
              <div class="p-6 text-sm text-on-surface-variant">No transactions in the last 30 days.</div>
              <% } else { %>
                <!-- Table (rows injected by JS pagination) -->
                <div class="overflow-x-auto">
                  <table class="w-full border-collapse">
                    <thead>
                      <tr class="bg-surface-container-low/50">
                        <th
                          class="px-6 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">
                          Date</th>
                        <th
                          class="px-6 py-5 text-right text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">
                          Credit</th>
                        <th
                          class="px-6 py-5 text-right text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">
                          Debit</th>
                        <th
                          class="px-6 py-5 text-right text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">
                          Balance</th>
                      </tr>
                    </thead>
                    <tbody id="ledger-tbody" class="divide-y divide-outline-variant/10 text-sm">
                      <%# rows rendered by renderLedgerPage() JS below %>
                    </tbody>
                  </table>
                </div>

                <!-- Pagination controls -->
                <div class="flex items-center justify-between px-6 py-5 bg-surface-container-low/30">
                  <span id="ledger-range-label" class="text-xs text-on-surface-variant"></span>
                  <div id="ledger-pagination" class="flex items-center gap-1"></div>
                </div>
                <% } %>
          </section>

    </div>

  </main>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    // ── Revenue chart ──────────────────────────────────────────────────────────
    const revenueSeries = JSON.parse('<%- JSON.stringify(revenueSeries).replace(/'/g, "\\'") %>');

    const canvas = document.getElementById('revenueChart');
    if (canvas && revenueSeries.labels && revenueSeries.labels.length > 0) {
      new Chart(canvas.getContext('2d'), {
        type: 'line',
        data: {
          labels: revenueSeries.labels,
          datasets: [{
            label: 'Revenue',
            data: revenueSeries.values,
            borderColor: '#90abff',
            backgroundColor: 'rgba(144, 171, 255, 0.12)',
            fill: true,
            tension: 0.4,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: {
              ticks: { color: '#a3aac4' },
              grid: { color: 'rgba(64,72,93,0.25)' }
            },
            y: {
              beginAtZero: true,
              ticks: {
                color: '#a3aac4',
                callback: (value) => '₹' + value.toLocaleString('en-IN')
              },
              grid: { color: 'rgba(64,72,93,0.25)' }
            }
          }
        }
      });
    }

    // ── Ledger pagination ──────────────────────────────────────────────────────
    const LEDGER_DATA = JSON.parse('<%- JSON.stringify(ledgerWithBalance).replace(/'/g, "\\'") %>');
    const ROWS_PER_PAGE = 10;
    let currentPage = 1;

    function fmtINR(amount) {
      return '₹' + Number(amount).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function totalPages() {
      return Math.max(1, Math.ceil(LEDGER_DATA.length / ROWS_PER_PAGE));
    }

    function renderLedgerPage(page) {
      const tbody = document.getElementById('ledger-tbody');
      if (!tbody) return;

      const start = (page - 1) * ROWS_PER_PAGE;
      const end = Math.min(start + ROWS_PER_PAGE, LEDGER_DATA.length);
      const slice = LEDGER_DATA.slice(start, end);

      tbody.innerHTML = slice.map(entry => `
      <tr class="hover:bg-surface-bright/50 transition-colors">
        <td class="px-6 py-4 font-medium text-on-surface">${entry.date}</td>
        <td class="px-6 py-4 text-right font-bold text-emerald-400">
          ${entry.credit > 0 ? '+' + fmtINR(entry.credit) : '—'}
        </td>
        <td class="px-6 py-4 text-right font-bold text-error">
          ${entry.debit > 0 ? '-' + fmtINR(entry.debit) : '—'}
        </td>
        <td class="px-6 py-4 text-right font-bold text-white">
          ${fmtINR(entry.runningBalance)}
        </td>
      </tr>
    `).join('');

      // Range label
      const label = document.getElementById('ledger-range-label');
      if (label) {
        label.textContent = `Showing ${start + 1}–${end} of ${LEDGER_DATA.length} entries`;
      }

      renderPagination(page);
    }

    function renderPagination(page) {
      const container = document.getElementById('ledger-pagination');
      if (!container) return;
      const tp = totalPages();

      // Build page numbers to show: always first, last, current ±1, with ellipsis
      const pages = new Set([1, tp, page, page - 1, page + 1].filter(p => p >= 1 && p <= tp));
      const sorted = [...pages].sort((a, b) => a - b);

      let html = `
      <button class="page-btn" id="pg-prev" ${page === 1 ? 'disabled' : ''} onclick="goToPage(${page - 1})">
        <span class="material-symbols-outlined" style="font-size:16px;line-height:1">chevron_left</span>
      </button>`;

      let prev = null;
      for (const p of sorted) {
        if (prev !== null && p - prev > 1) {
          html += `<span class="page-btn" style="cursor:default;border:none;background:transparent;color:#6d758c">…</span>`;
        }
        html += `<button class="page-btn ${p === page ? 'active' : ''}" onclick="goToPage(${p})">${p}</button>`;
        prev = p;
      }

      html += `
      <button class="page-btn" id="pg-next" ${page === tp ? 'disabled' : ''} onclick="goToPage(${page + 1})">
        <span class="material-symbols-outlined" style="font-size:16px;line-height:1">chevron_right</span>
      </button>`;

      container.innerHTML = html;
    }

    function goToPage(page) {
      const tp = totalPages();
      if (page < 1 || page > tp) return;
      currentPage = page;
      renderLedgerPage(page);
    }

    // Initial render
    if (LEDGER_DATA.length > 0) {
      renderLedgerPage(1);
    }
  </script>
</body>

</html>
