<title>Luxe | Elevate Your Wardrobe</title>
</head>
<body class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-slate-100 antialiased h-screen overflow-hidden">
<div class="flex h-full w-full">
<!-- Left Side: High-end Fashion Photography -->
<div class="hidden lg:flex lg:w-1/2 relative">
<div class="absolute inset-0 bg-gradient-to-t from-background-dark/80 via-transparent to-transparent z-10"></div>
<div class="absolute top-10 left-10 z-20 flex items-center gap-2">
<div class="size-8 text-primary">
