      <div class="lg:col-span-2 flex flex-col gap-10">

        <!-- SHIPPING ADDRESS -->
        <div class="fu d2">
          <h2 class="text-2xl font-extrabold uppercase tracking-tight font-serif mb-1">Shipping Address</h2>
          <p class="text-sm text-slate-500 mb-6">Select a saved address or add a new one</p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3" id="addressCardGrid">
            <% address.forEach((ad) => {
              const isSelected = defaultAddress && String(ad._id) === String(defaultAddress._id);
            %>
              <div class="addr-card <%= isSelected ? 'selected' : '' %>"
                   data-id="<%= ad._id %>"
                   onclick="selectAddress(this)">
                <div class="addr-check">✓</div>
                <% if (ad.isDefault) { %>
                  <span class="inline-block text-[9px] font-bold uppercase tracking-widest text-primary border border-primary/40 bg-primary/10 px-2.5 py-0.5 rounded-full mb-2">Default</span>
                <% } %>
                <div class="text-[13px] font-bold uppercase tracking-wide text-white mb-2"><%= ad.fullName %></div>
                <div class="text-[13px] text-slate-400 leading-relaxed">
                  <%= ad.houseNumber %>, <%= ad.streetName %><br>
                  <%= ad.city %>, <%= ad.state %> <%= ad.pincode %><br>
                  <%= ad.country %>
                </div>
                <div class="text-xs text-slate-500 mt-2"><%= ad.phoneNumber %></div>
                <div class="flex gap-2 mt-3.5">
                  <button type="button" class="text-[10px] font-bold uppercase tracking-widest text-primary border border-primary/30 rounded-lg px-3 py-1.5 hover:bg-primary hover:text-white transition-all"
                          onclick="openEditAddress(event, '<%= ad._id %>')">Edit</button>
                  <% if (!ad.isDefault) { %>
                    <button type="button" class="text-[10px] font-bold uppercase tracking-widest text-slate-400 border border-slate-700 rounded-lg px-3 py-1.5 hover:bg-emerald-500 hover:text-white hover:border-emerald-500 transition-all"
                            onclick="setAsDefault(event, '<%= ad._id %>')">Set Default</button>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>

          <p id="addr-select-error" class="text-xs text-red-400 mb-3" style="display:none">Please select a shipping address to continue.</p>

          <button class="w-full border border-dashed border-slate-700 rounded-xl py-4 text-xs font-bold uppercase tracking-widest text-slate-500 hover:border-primary hover:text-primary transition-all flex items-center justify-center gap-2"
                  onclick="openNewAddressForm()" id="addAddrToggle">
            <span class="material-symbols-outlined msym text-base">add</span>
            Add New Address
          </button>

          <!-- ADDRESS FORM -->
          <div class="form-panel bg-[#0d1322] border border-slate-800 rounded-xl p-6 mt-4" id="newAddrForm">
            <div class="text-lg font-bold font-serif text-white mb-5" id="addrFormTitle">Add New Address</div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] uppercase tracking-widest text-slate-500" for="f_name">Full Name</label>
                <input class="form-input" type="text" id="f_name" autocomplete="off" placeholder="e.g. Alexander Thorne">
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] uppercase tracking-widest text-slate-500" for="f_mobile">Mobile Number</label>
                <input class="form-input" type="tel" id="f_mobile" autocomplete="off" placeholder="+91 00000 00000">
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] uppercase tracking-widest text-slate-500" for="f_house">House / Flat No.</label>
                <input class="form-input" type="text" id="f_house" autocomplete="off" placeholder="e.g. 721, Apt B">
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] uppercase tracking-widest text-slate-500" for="f_street">Street / Road</label>
                <input class="form-input" type="text" id="f_street" autocomplete="off" placeholder="e.g. Fifth Avenue">
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] uppercase tracking-widest text-slate-500" for="f_pincode">Pincode / ZIP</label>
                <input class="form-input" type="text" id="f_pincode" autocomplete="off" placeholder="6-digit pincode" maxlength="6">
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] uppercase tracking-widest text-slate-500" for="f_city">City / District</label>
                <input class="form-input" type="text" id="f_city" autocomplete="off" placeholder="Auto-filled from pincode">
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] uppercase tracking-widest text-slate-500" for="f_state">State</label>
                <input class="form-input" type="text" id="f_state" autocomplete="off" placeholder="Auto-filled from pincode">
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] uppercase tracking-widest text-slate-500" for="f_country">Country</label>
                <input class="form-input" type="text" id="f_country" autocomplete="off" placeholder="India">
              </div>
            </div>
            <div class="grid grid-cols-1 gap-4 mb-4">
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] uppercase tracking-widest text-slate-500" for="f_landmark">Landmark <span class="text-slate-600">(optional)</span></label>
                <input class="form-input" type="text" id="f_landmark" autocomplete="off" placeholder="Near ...">
              </div>
            </div>

            <div class="flex gap-4 items-center flex-wrap mt-2">
              <button class="bg-transparent border border-primary text-primary hover:bg-primary hover:text-white text-[11px] font-bold uppercase tracking-widest px-6 py-2.5 rounded-lg transition-all"
                      id="saveAddressBtn" onclick="saveAddressFromCheckout()">
                Save &amp; Use This Address
              </button>
              <button onclick="closeAddressForm()"
                      class="bg-transparent border-none text-slate-500 hover:text-white text-[11px] font-semibold uppercase tracking-widest cursor-pointer">
                Cancel
              </button>
            </div>
          </div>
        </div>

        <!-- PAYMENT METHOD -->
        <div class="fu d2">
          <h2 class="text-2xl font-extrabold uppercase tracking-tight font-serif mb-1">Payment Method</h2>
          <p class="text-sm text-slate-500 mb-6">Choose how you'd like to pay</p>

          <div class="flex flex-col gap-2.5">
            <div class="pay-option selected flex items-center gap-4" id="pay_cod" onclick="selectPayment('cod')">
              <div class="pay-radio"><div class="pay-dot"></div></div>
              <span class="material-symbols-outlined msym text-slate-400 text-2xl">payments</span>
              <div class="flex-1">
                <div class="text-sm font-bold text-white">Cash on Delivery</div>
                <div class="text-xs text-slate-500 mt-0.5">Pay when your order arrives</div>
              </div>
              <span class="text-[10px] font-bold uppercase tracking-widest text-emerald-400 bg-emerald-500/10 border border-emerald-500/25 px-2.5 py-1 rounded-full">Available</span>
            </div>

            <div class="pay-option flex items-center gap-4" id="pay_paypal" onclick="selectPayment('paypal')">
              <div class="pay-radio"><div class="pay-dot"></div></div>
              <span class="material-symbols-outlined msym text-slate-400 text-2xl">account_balance</span>
              <div class="flex-1">
                <div class="text-sm font-bold text-white">PayPal</div>
                <div class="text-xs text-slate-500 mt-0.5">Pay securely via PayPal</div>
              </div>
              <span class="text-[10px] font-bold uppercase tracking-widest text-emerald-400 bg-emerald-500/10 border border-emerald-500/25 px-2.5 py-1 rounded-full">Available</span>
            </div>

            <!-- PayPal button renders here, shown only when paypal is selected.
                 Wrapped in .paypal-card so the SDK's own white iframe sits
                 inside a framed, intentional-looking panel instead of
                 floating bare on the dark page. -->
            <div id="paypal-button-wrapper" style="display:none; margin-top:4px;">
              <div class="paypal-card">
                <div id="paypal-button-container"></div>
              </div>
            </div>

            <% const canPayWallet = walletBalance >= grandTotal; %>
            <div class="pay-option flex items-center gap-4 <%= !canPayWallet ? 'disabled' : '' %>"
                 id="pay_wallet"
                 onclick="<%= canPayWallet ? 'selectPayment(\'wallet\')' : '' %>">
              <div class="pay-radio"><div class="pay-dot"></div></div>
              <span class="material-symbols-outlined msym text-slate-400 text-2xl">account_balance_wallet</span>
              <div class="flex-1">
                <div class="text-sm font-bold text-white">Luxe Wallet</div>
                <div class="text-xs text-slate-500 mt-0.5">
                  Balance:
                  <span class="font-bold <%= canPayWallet ? 'text-emerald-400' : 'text-red-400' %>">
                    ₹<%= walletBalance.toLocaleString('en-IN') %>
                  </span>
                  <% if (!canPayWallet) { %>
                    &nbsp;·&nbsp;<span class="text-red-400">Need ₹<%= (grandTotal - walletBalance).toLocaleString('en-IN') %> more</span>
                  <% } %>
                </div>
              </div>
              <% if (canPayWallet) { %>
                <span class="text-[10px] font-bold uppercase tracking-widest text-emerald-400 bg-emerald-500/10 border border-emerald-500/25 px-2.5 py-1 rounded-full">Available</span>
              <% } else { %>
                <span class="text-[10px] font-bold uppercase tracking-widest text-red-400 bg-red-500/10 border border-red-500/25 px-2.5 py-1 rounded-full">Low Balance</span>
              <% } %>
            </div>
          </div>
        </div>

      </div><!-- /left column -->


      <!-- ═══════════ RIGHT COLUMN ═══════════ -->
      <div class="fu d3">
        <div class="summary-card">
          <h2 class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-5 pb-4 border-b border-slate-800">Order Summary</h2>

          <!-- PRODUCT LIST -->
          <div class="max-h-[340px] overflow-y-auto scroll-thin mb-5 pr-1">
            <% cart.forEach((p) => {
              const variant     = p.variantId;
              const product     = variant?.productId;
              const inStock     = (variant?.stock ?? 0) > 0;
              const isInvalid   = !product?.isActive || !variant?.isActive || !inStock;
              const hasDiscount = variant?.discount && variant.discount < variant?.price;
              const itemPrice   = hasDiscount ? variant.discount : (variant?.price || 0);
              const origPrice   = variant?.price || 0;
              const qty         = p.quantity || 1;
              const lineTotal   = itemPrice * qty;
              const origTotal   = origPrice * qty;
              const savedAmt    = hasDiscount ? (origTotal - lineTotal) : 0;
              const imgSrc      = variant?.images?.[0] ? '/uploads/' + variant.images[0] : null;
              const itemGst     = Math.round(lineTotal * 0.05);
              const itemGross   = lineTotal + itemGst;
            %>
              <div class="prod-item <%= isInvalid ? 'invalid' : '' %> flex gap-3.5 py-3.5 border-b border-slate-800 last:border-b-0 last:pb-0">
                <% if (imgSrc) { %>
                  <img class="w-[62px] h-[74px] object-cover flex-shrink-0 bg-slate-800 rounded-lg border border-slate-800"
                       src="<%= imgSrc %>" alt="<%= product?.name || 'Product' %>" onerror="this.style.display='none'">
                <% } else { %>
                  <div class="w-[62px] h-[74px] flex-shrink-0 bg-slate-800 rounded-lg border border-slate-800 flex items-center justify-center text-slate-600">
                    <span class="material-symbols-outlined msym">image_not_supported</span>
                  </div>
                <% } %>
                <div class="flex-1 min-w-0">
                  <div class="text-xs font-bold uppercase tracking-wide text-white mb-1 truncate"><%= product?.name || 'Unknown Product' %></div>
                  <div class="text-[11px] text-slate-500 leading-relaxed flex flex-wrap gap-1.5">
                    <% if (variant?.color) { %><span class="bg-slate-800/70 border border-slate-800 rounded px-1.5 py-0.5">Color: <%= variant.color %></span><% } %>
                    <% if (variant?.size)  { %><span class="bg-slate-800/70 border border-slate-800 rounded px-1.5 py-0.5">Size: <%= variant.size %></span><% } %>
                  </div>
                  <div class="text-[11px] text-slate-500 mt-1.5">Qty: <%= qty %></div>
                  <% if (!isInvalid) { %>
                    <div class="mt-2 border-t border-slate-800 pt-1.5 flex flex-col gap-1">
                      <div class="flex justify-between text-[11px] text-slate-500">
                        <span>Item Price</span>
                        <% if (hasDiscount) { %>
                          <span class="line-through text-slate-600">₹<%= origTotal.toLocaleString('en-IN') %></span>
                        <% } else { %>
                          <span>₹<%= lineTotal.toLocaleString('en-IN') %></span>
                        <% } %>
                      </div>
                      <% if (hasDiscount) { %>
                        <div class="flex justify-between text-[11px] text-emerald-400"><span>Discount</span><span>— ₹<%= savedAmt.toLocaleString('en-IN') %></span></div>
                      <% } %>
                      <div class="flex justify-between text-[11px] text-slate-600"><span>Taxable Value</span><span>₹<%= lineTotal.toLocaleString('en-IN') %></span></div>
                      <div class="flex justify-between text-[11px] text-amber-400"><span>GST (5%)</span><span>+ ₹<%= itemGst.toLocaleString('en-IN') %></span></div>
                      <div class="flex justify-between text-[11px] text-slate-300 font-semibold border-t border-dashed border-slate-800 pt-1 mt-0.5"><span>Item Total</span><span>₹<%= itemGross.toLocaleString('en-IN') %></span></div>
                    </div>
                  <% } %>
                  <% if (!inStock) { %>
                    <span class="invalid-badge mt-1.5">Out of stock</span>
                  <% } else if (!product?.isActive || !variant?.isActive) { %>
                    <span class="invalid-badge mt-1.5">Unavailable</span>
                  <% } %>
                </div>
                <div class="flex flex-col items-end pt-0.5">
                  <% if (isInvalid) { %>
                    <div class="text-sm text-slate-600 line-through">₹<%= origTotal.toLocaleString('en-IN') %></div>
                  <% } else { %>
                    <div class="text-[13px] font-bold text-primary whitespace-nowrap">₹<%= itemGross.toLocaleString('en-IN') %></div>
                    <% if (hasDiscount) { %>
                      <div class="text-[11px] text-slate-600 line-through mt-0.5">₹<%= origTotal.toLocaleString('en-IN') %></div>
                    <% } %>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div><!-- /product-list -->

          <!-- ══════════════════════════════
               COUPON SECTION
          ══════════════════════════════ -->
          <div class="coupon-wrap">
            <div class="coupon-header" onclick="toggleCouponPanel()">
              <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined msym text-primary" style="font-size:16px">sell</span>
                <span class="text-[11px] font-bold uppercase tracking-widest text-slate-300">Promo Code</span>
                <% if (eligibleCoupons.length > 0) { %>
  <span class="text-[10px] text-primary bg-primary/10 border border-primary/30 px-2 py-0.5 rounded-full"><%= eligibleCoupons.length %> available</span>
<% } %>
              </div>
              <span class="material-symbols-outlined msym coupon-chevron text-slate-500" id="couponChevron" style="font-size:16px">expand_more</span>
            </div>

            <div class="coupon-body" id="couponBody">
              <% if (eligibleCoupons.length > 0) { %>
  <p class="text-[10px] uppercase tracking-widest text-slate-500 mb-2.5">Tap a coupon to apply</p>
  <div class="flex flex-col gap-2 mb-3.5 max-h-[220px] overflow-y-auto scroll-thin pr-0.5" id="couponCardsList">
    <% eligibleCoupons.forEach(c => { %>
                    <div class="coupon-card" id="couponCard_<%= c.code %>">
                      <div class="flex-1 min-w-0">
                        <span class="coupon-card-code text-[13px] font-bold tracking-wider text-primary block mb-0.5"><%= c.code %></span>
                        <span class="text-[11px] text-slate-500 leading-relaxed">
                          <% if (c.discountType === 'PERCENTAGE') { %>
                            <%= c.discountValue %>% off
                            <% if (c.maxDiscount) { %>· Max ₹<%= c.maxDiscount %><% } %>
                          <% } else { %>
                            ₹<%= c.discountValue %> flat off
                          <% } %>
                          · Min order ₹<%= c.minOrderValue %>
                        </span>
                        <span class="text-[10px] text-emerald-400 mt-0.5 block" id="couponSave_<%= c.code %>" style="display:none"></span>
                      </div>
                      <button class="coupon-card-btn" id="couponBtn_<%= c.code %>" onclick="applyCoupon('<%= c.code %>')">Apply</button>
                    </div>
                  <% }) %>
                </div>
                <div class="h-px bg-slate-800 my-3"></div>
              <% } %>

              <div class="coupon-row flex">
                <input class="coupon-input" type="text" id="couponInput" placeholder="Enter promo code" autocomplete="off">
                <button class="coupon-btn" id="couponApplyBtn" onclick="applyCoupon()">Apply</button>
              </div>
              <p class="coupon-msg" id="couponMsg"></p>
            </div>
          </div><!-- /coupon-wrap -->

          <!-- SAVINGS BANNER -->
          <% if (totalSavings > 0) { %>
            <div class="flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/20 rounded-lg px-3.5 py-2.5 mb-5">
              <span class="material-symbols-outlined msym text-emerald-400" style="font-size:16px;font-variation-settings:'FILL' 1">check_circle</span>
              <p class="text-xs text-emerald-400">You're saving <strong>₹<%= totalSavings.toLocaleString('en-IN') %></strong> on this order</p>
            </div>
          <% } %>

          <!-- PRICE BREAKDOWN -->
          <div class="price-section">
            <div class="price-row">
              <span class="text-sm text-slate-400">Total Price</span>
              <span class="text-sm font-semibold text-white">₹<%= totalPrice.toLocaleString('en-IN') %></span>
            </div>

            <% if (totalSavings > 0) { %>
            <div class="price-row">
              <span class="text-sm text-emerald-400">Product Discount</span>
              <span class="text-sm font-semibold text-emerald-400">— ₹<%= totalSavings.toLocaleString('en-IN') %></span>
            </div>
            <% } %>

            <div class="price-row coupon-discount-row" id="couponDiscountRow">
              <span class="text-sm text-primary">Coupon (<span id="appliedCouponLabel">—</span>)</span>
              <span class="text-sm font-semibold text-primary" id="couponDiscountDisplay">— ₹0</span>
            </div>

            <div class="price-row">
              <span class="text-sm text-slate-500">Taxable Value</span>
              <span class="text-xs text-slate-400">₹<%= subtotal.toLocaleString('en-IN') %></span>
            </div>

            <div class="price-row">
              <span class="text-sm text-amber-400">GST (5%)</span>
              <span class="text-xs text-amber-400" id="displayGst">+ ₹<%= gstAmount.toLocaleString('en-IN') %></span>
            </div>

            <div class="price-row">
              <span class="text-sm text-slate-400">Shipping Fee</span>
              <span class="text-sm font-semibold" id="displayShipping">
                <% if (subtotal >= 999) { %><span class="text-emerald-400">Free</span><% } else { %><span class="text-white">₹99</span><% } %>
              </span>
            </div>

            <div class="price-row total">
              <span class="text-lg font-extrabold text-white font-serif">Grand Total</span>
              <span class="text-2xl font-extrabold text-primary font-serif" id="displayTotal">₹<%= grandTotal.toLocaleString('en-IN') %></span>
            </div>
          </div>

          <p class="text-[10px] text-slate-600 text-right -mt-3.5 mb-4">
            Incl. ₹<%= gstAmount.toLocaleString('en-IN') %> GST @ 5% on clothing
          </p>

          <!-- PLACE ORDER -->
          <button class="place-btn flex items-center justify-center gap-2 w-full bg-primary hover:bg-primary-dark text-white font-bold py-4 rounded-xl transition-all shadow-xl shadow-primary/20 active:scale-95 text-sm uppercase tracking-widest mb-4"
                  id="placeOrderBtn" onclick="placeOrder()">
            <span class="material-symbols-outlined msym text-base">lock</span>
            Place Order
          </button>

          <p class="text-center text-xs text-slate-600 flex items-center justify-center gap-1.5">
            <span class="material-symbols-outlined msym text-emerald-400" style="font-size:14px;font-variation-settings:'FILL' 1">verified_user</span>
            Free returns within 30 days
          </p>
        </div><!-- /summary-card -->
      </div><!-- /right column -->

    </div><!-- /grid -->
  </main>

  <!-- ══ FOOTER ══ -->
  <footer class="bg-slate-900/60 mt-20 px-6 lg:px-20 py-12 border-t border-slate-800">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-600 uppercase tracking-widest">
      <div class="logo-link flex items-center gap-2 text-primary">
  <span class="diamond-puzzle" aria-hidden="true">
    <span class="material-symbols-outlined msym piece piece-1">diamond</span>
    <span class="material-symbols-outlined msym piece piece-2">diamond</span>
    <span class="material-symbols-outlined msym piece piece-3">diamond</span>
    <span class="material-symbols-outlined msym piece piece-4">diamond</span>
  </span>
  <span class="logo-text text-white text-2xl font-extrabold tracking-tight">LUXE</span>
</div>
      <p>© <%= new Date().getFullYear() %> Luxe Menswear. All Rights Reserved.</p>
      <div class="flex gap-6"></div>
    </div>
  </footer>

</div>

<script src="https://www.paypal.com/sdk/js?client-id=AUVHxcEAGa6HevQSXIEiiZsdjAsegfmTNURoAmrnB8bwpdC7o8UHeuImbPwCGu7Gq-33yqvrfJq4dM8l&currency=USD"></script>

<script>
  /* ── STATE ── */
  let selectedAddressId     = '<%= defaultAddress ? String(defaultAddress._id) : "" %>';
  let selectedPayment       = 'cod';
  let appliedDiscount       = 0;
  let appliedCouponCode     = '';
  let editingAddressId      = '';
  let editingAddressDefault = false;
  let paypalButtonsRendered = false;
  let currentOrderCode      = ''; // ← tracks the pending PayPal order for failure/retry redirects

  const checkoutAddresses = <%- JSON.stringify(address).replace(/</g, '\\u003c') %>;
  const baseGrandTotal    = <%= grandTotal %>;
  const baseSubtotal      = <%= subtotal %>;
  const orderTotal        = <%= orderTotal %>;
  const walletBalance     = <%= walletBalance %>;

  /* ── LOADER ── */
  const overlay    = document.getElementById('loadingOverlay');
  const showLoader = () => overlay.classList.add('active');
  const hideLoader = () => overlay.classList.remove('active');

  /* ── TOAST (matches cart page) ── */
  let _toastTimer;
  function showToast(msg, icon = 'check_circle', cls = 'text-green-400') {
    document.getElementById('toast-msg').textContent = msg;
    const ic = document.getElementById('toast-icon');
    ic.textContent = icon;
    ic.className   = 'material-symbols-outlined msym ' + cls;
    document.getElementById('toast').classList.add('show');
    clearTimeout(_toastTimer);
    _toastTimer = setTimeout(() => document.getElementById('toast').classList.remove('show'), 2800);
  }
  function toastError(msg) { showToast(msg, 'error', 'text-red-400'); }
  function toastSuccess(msg) { showToast(msg, 'check_circle', 'text-green-400'); }

  /* ══════════════════════════════
     PAYMENT SELECTION
  ══════════════════════════════ */
  function selectPayment(method) {
    document.querySelectorAll('.pay-option:not(.disabled)')
            .forEach(p => p.classList.remove('selected'));
    document.getElementById('pay_' + method)?.classList.add('selected');
    selectedPayment = method;

    const paypalWrapper = document.getElementById('paypal-button-wrapper'); // ← now targets the framed wrapper
    const placeBtn       = document.getElementById('placeOrderBtn');

    if (method === 'paypal') {
      paypalWrapper.style.display = 'block';
      placeBtn.style.display      = 'none';   // PayPal has its own button
      if (!paypalButtonsRendered) renderPaypalButtons();
    } else {
      paypalWrapper.style.display = 'none';
      placeBtn.style.display      = 'flex';
    }
  }

  /* ══════════════════════════════
     PAYPAL INTEGRATION
  ══════════════════════════════ */
  function renderPaypalButtons() {
    paypal.Buttons({

      // Restrict to the PayPal wallet button only — without this, PayPal's
      // SDK also renders a separate "Debit or Credit Card" button beneath
      // it, which adds a second white block and duplicate payment option
      // that isn't needed here.
      fundingSource: paypal.FUNDING.PAYPAL,

      createOrder: async function () {
        if (!selectedAddressId) {
          document.getElementById('addr-select-error').style.display = 'block';
          document.getElementById('addressCardGrid')
                  .scrollIntoView({ behavior: 'smooth', block: 'start' });
          toastError('Please select a shipping address.');
          return Promise.reject(new Error('No address selected'));
        }

        try {
          const res  = await fetch('/checkout/paypal/create-order', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              addressId:  selectedAddressId,
              couponCode: appliedCouponCode || null,
              discount:   appliedDiscount   || 0,
            }),
          });
          const data = await res.json();
          if (!data.id) throw new Error(data.message || 'Could not create PayPal order');
          currentOrderCode = data.orderCode || currentOrderCode; // track for failure redirect
          return data.id;
        } catch (err) {
          toastError(err.message || 'PayPal order creation failed.');
          return Promise.reject(err);
        }
      },

      onApprove: async function (data) {
        showLoader();
        try {
          const captureRes  = await fetch('/checkout/paypal/capture-order', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ orderID: data.orderID }),
          });
          const captureData = await captureRes.json();
          hideLoader();

          if (!captureData.success || captureData.status !== 'COMPLETED') {
            const failedCode = captureData.orderCode || currentOrderCode;
            if (failedCode) {
              toastError('Payment could not be completed — redirecting to retry…');
              setTimeout(() => { window.location.href = `/checkout/order-failed/${failedCode}`; }, 1400);
            } else {
              toastError(captureData.message || 'PayPal payment was not completed. Please try again.');
            }
            return;
          }

          toastSuccess('Payment successful — redirecting…');
          setTimeout(() => { window.location.href = captureData.redirect; }, 1400);

        } catch (err) {
          hideLoader();
          if (currentOrderCode) {
            toastError('Something went wrong — redirecting to retry…');
            setTimeout(() => { window.location.href = `/checkout/order-failed/${currentOrderCode}`; }, 1400);
          } else {
            toastError('Something went wrong during payment. Please try again.');
          }
        }
      },

      onCancel: function () {
        if (currentOrderCode) {
          window.location.href = `/checkout/order-failed/${currentOrderCode}`;
        } else {
          window.location.href = '/checkout/cancel';
        }
      },

      onError: function (err) {
        console.error('PayPal error:', err);
        toastError('A PayPal error occurred. Please try again.');
      },

      style: {
        layout: 'vertical',
        color:  'blue',
        shape:  'rect',
        label:  'pay',
        height: 45,
      },

    }).render('#paypal-button-container');

    paypalButtonsRendered = true;
  }

  /* ══════════════════════════════
     COUPON LOGIC
  ══════════════════════════════ */
  function toggleCouponPanel() {
    const body    = document.getElementById('couponBody');
    const chevron = document.getElementById('couponChevron');
    const isOpen  = body.style.display !== 'none';
    body.style.display = isOpen ? 'none' : 'block';
    chevron.classList.toggle('open', !isOpen);
  }

  async function applyCoupon(code) {
    const inputEl    = document.getElementById('couponInput');
    const couponCode = (code || inputEl.value || '').trim().toUpperCase();
    if (!couponCode) { showCouponMsg('Please enter a coupon code.', 'error'); inputEl.focus(); return; }
    if (appliedCouponCode && appliedCouponCode === couponCode) { removeCoupon(); return; }
    showCouponMsg('Checking…', '');
    try {
      const res  = await fetch('/checkout/apply-coupon', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code: couponCode, orderTotal }),
      });
      const data = await res.json();
      if (data.success) {
        appliedDiscount   = data.discount;
        appliedCouponCode = data.couponCode;
        inputEl.value     = data.couponCode;
        resetAllCouponCards();
        const card   = document.getElementById('couponCard_' + data.couponCode);
        const btn    = document.getElementById('couponBtn_' + data.couponCode);
        const saveEl = document.getElementById('couponSave_' + data.couponCode);
        if (card) { card.classList.add('applied'); saveEl.textContent = '✓ Saves ₹' + data.discount.toLocaleString('en-IN'); saveEl.style.display = 'block'; }
        if (btn)  { btn.textContent = 'Remove'; btn.classList.add('remove-btn'); btn.onclick = () => removeCoupon(); }
        updateGrandTotal(data.discount, data.couponCode);
        showCouponMsg('✓ ' + data.message, 'success');
      } else {
        showCouponMsg(data.message, 'error');
      }
    } catch { showCouponMsg('Something went wrong. Please try again.', 'error'); }
  }

  function removeCoupon() {
    resetAllCouponCards();
    appliedDiscount = 0; appliedCouponCode = '';
    document.getElementById('couponInput').value = '';
    updateGrandTotal(0, null);
    showCouponMsg('Coupon removed.', '');
  }

  function resetAllCouponCards() {
    document.querySelectorAll('.coupon-card').forEach(card => {
      card.classList.remove('applied');
      const code   = card.id.replace('couponCard_', '');
      const btn    = document.getElementById('couponBtn_' + code);
      const saveEl = document.getElementById('couponSave_' + code);
      if (btn)    { btn.textContent = 'Apply'; btn.classList.remove('remove-btn'); btn.onclick = () => applyCoupon(code); }
      if (saveEl) { saveEl.style.display = 'none'; saveEl.textContent = ''; }
    });
  }

  function updateGrandTotal(discount, couponCode) {
    const taxable  = Math.max(baseSubtotal - discount, 0);
    const gst      = Math.round(taxable * 0.05);
    const shipping = baseSubtotal >= 999 ? 0 : 99;
    const newTotal = taxable + gst + shipping;

    const totalEl     = document.getElementById('displayTotal');
    const gstEl       = document.getElementById('displayGst');
    const shippingEl  = document.getElementById('displayShipping');
    const discountRow = document.getElementById('couponDiscountRow');
    const discountEl  = document.getElementById('couponDiscountDisplay');
    const labelEl     = document.getElementById('appliedCouponLabel');

    totalEl.textContent  = '₹' + newTotal.toLocaleString('en-IN');
    gstEl.textContent    = '+ ₹' + gst.toLocaleString('en-IN');
    shippingEl.innerHTML = shipping === 0
      ? '<span class="text-emerald-400">Free</span>'
      : '<span class="text-white">₹' + shipping + '</span>';

    if (discount > 0 && couponCode) {
      discountRow.classList.add('visible');
      discountEl.textContent = '— ₹' + discount.toLocaleString('en-IN');
      labelEl.textContent    = couponCode;
    } else {
      discountRow.classList.remove('visible');
    }
  }
  function showCouponMsg(text, type) {
    const el = document.getElementById('couponMsg');
    el.textContent = text;
    el.className   = 'coupon-msg' + (type ? ' ' + type : '');
  }

  /* ══════════════════════════════
     ADDRESS LOGIC
  ══════════════════════════════ */
  function selectAddress(card) {
    document.querySelectorAll('.addr-card').forEach(c => c.classList.remove('selected'));
    card.classList.add('selected');
    selectedAddressId = card.dataset.id;
    document.getElementById('addr-select-error').style.display = 'none';
    closeAddressForm();
  }

  function clearAddressForm() {
    ['f_name','f_mobile','f_house','f_street','f_pincode','f_city','f_state','f_country','f_landmark'].forEach(id => {
      const el = document.getElementById(id); el.value = ''; el.classList.remove('error');
    });
    document.getElementById('f_country').value = 'India';
  }

  function openNewAddressForm() {
    editingAddressId = ''; editingAddressDefault = false;
    clearAddressForm();
    document.getElementById('addrFormTitle').textContent  = 'Add New Address';
    document.getElementById('saveAddressBtn').textContent = 'Save & Use This Address';
    document.querySelectorAll('.addr-card').forEach(c => c.classList.remove('selected'));
    selectedAddressId = '';
    document.getElementById('newAddrForm').classList.add('open');
    document.getElementById('f_name').focus();
  }

  function closeAddressForm() {
    document.getElementById('newAddrForm').classList.remove('open');
    editingAddressId = ''; editingAddressDefault = false;
  }

  function openEditAddress(event, id) {
    event.stopPropagation();
    const addr = checkoutAddresses.find(a => String(a._id) === String(id));
    if (!addr) return toastError('Address not found.');
    editingAddressId      = String(id);
    editingAddressDefault = Boolean(addr.isDefault);
    document.getElementById('addrFormTitle').textContent    = 'Edit Address';
    document.getElementById('saveAddressBtn').textContent   = 'Update & Use This Address';
    document.getElementById('f_name').value    = addr.fullName    || '';
    document.getElementById('f_mobile').value  = addr.phoneNumber || '';
    document.getElementById('f_house').value   = addr.houseNumber || '';
    document.getElementById('f_street').value  = addr.streetName  || '';
    document.getElementById('f_pincode').value = addr.pincode     || '';
    document.getElementById('f_city').value    = addr.city        || '';
    document.getElementById('f_state').value   = addr.state       || '';
    document.getElementById('f_country').value = addr.country     || 'India';
    document.getElementById('f_landmark').value= addr.landmark    || '';
    document.querySelectorAll('.addr-card').forEach(c =>
      c.classList.toggle('selected', c.dataset.id === editingAddressId));
    selectedAddressId = editingAddressId;
    document.getElementById('addr-select-error').style.display = 'none';
    document.getElementById('newAddrForm').classList.add('open');
    document.getElementById('newAddrForm').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  async function setAsDefault(event, id) {
    event.stopPropagation(); showLoader();
    try {
      const res  = await fetch(`/address/default/${id}`, { method: 'PATCH' });
      const data = await res.json();
      hideLoader();
      if (!res.ok || !data.success) return toastError(data.message || 'Failed to set default.');
      toastSuccess('Default address updated');
      setTimeout(() => window.location.reload(), 1000);
    } catch(e) { hideLoader(); toastError('Something went wrong. Please try again.'); }
  }

  /* ── FORM VALIDATION ── */
  function getPhoneDigits(value) {
    let digits = String(value || '').replace(/\D/g, '');
    if (digits.length === 12 && digits.startsWith('91')) digits = digits.slice(2);
    if (digits.length === 11 && digits.startsWith('0'))  digits = digits.slice(1);
    return digits;
  }

  const fieldValidators = {
    f_name(val)    { if (!val) return 'Full name is required.'; if (val.length < 2) return 'Min 2 characters.'; if (!/^[A-Za-z][A-Za-z .'-]*$/.test(val)) return 'Letters, spaces, dots, hyphens only.'; return ''; },
    f_mobile(val)  { if (!val) return 'Mobile number is required.'; const d = getPhoneDigits(val); if (d.length !== 10) return 'Enter a valid 10-digit number.'; if (!/^[6-9]/.test(d)) return 'Must start with 6–9.'; return ''; },
    f_house(val)   { if (!val) return 'House / flat number is required.'; return ''; },
    f_street(val)  { if (!val) return 'Street is required.'; if (val.length < 3) return 'Min 3 characters.'; return ''; },
    f_pincode(val) { if (!val) return 'Pincode is required.'; if (!/^\d{6}$/.test(val)) return 'Must be exactly 6 digits.'; if (!/^[1-9]/.test(val)) return 'Cannot start with 0.'; return ''; },
    f_city(val)    { if (!val) return 'City is required.'; if (val.length < 2) return 'Min 2 characters.'; return ''; },
    f_state(val)   { if (!val) return 'State is required.'; return ''; },
    f_country(val) { if (!val) return 'Country is required.'; return ''; },
    f_landmark()   { return ''; },
  };

  function setFieldError(id, message) {
    const el = document.getElementById(id);
    let errEl = document.getElementById(id + '_err');
    if (!errEl) {
      errEl = document.createElement('span');
      errEl.id = id + '_err';
      errEl.style.cssText = 'font-size:10px;color:#f87171;margin-top:3px;display:block;';
      el.parentNode.appendChild(errEl);
    }
    if (message) { el.classList.add('error'); errEl.textContent = message; errEl.style.display = 'block'; }
    else         { el.classList.remove('error'); errEl.textContent = ''; errEl.style.display = 'none'; }
  }

  function validateForm() {
    let firstErrorId = null, hasError = false;
    for (const [id, validator] of Object.entries(fieldValidators)) {
      const el  = document.getElementById(id);
      const val = el.value.trim().replace(/\s+/g, ' ');
      el.value  = val;
      const msg = validator(val);
      setFieldError(id, msg);
      if (msg && !firstErrorId) firstErrorId = id;
      if (msg) hasError = true;
    }
    if (firstErrorId) document.getElementById(firstErrorId).focus();
    return !hasError;
  }

  Object.keys(fieldValidators).forEach(id => {
    const el = document.getElementById(id);
    if (!el) return;
    el.addEventListener('input', () => { const val = el.value.trim(); setFieldError(id, fieldValidators[id](val)); });
    el.addEventListener('blur',  () => { el.value = el.value.trim();  setFieldError(id, fieldValidators[id](el.value)); });
  });

  function getNewAddressPayload() {
    return { fullName: document.getElementById('f_name').value.trim(), phoneNumber: document.getElementById('f_mobile').value.trim(), houseNumber: document.getElementById('f_house').value.trim(), streetName: document.getElementById('f_street').value.trim(), pincode: document.getElementById('f_pincode').value.trim(), city: document.getElementById('f_city').value.trim(), state: document.getElementById('f_state').value.trim(), landmark: document.getElementById('f_landmark').value.trim(), country: document.getElementById('f_country').value.trim(), isDefault: false };
  }
  function getEditAddressPayload() {
    return { fullName: document.getElementById('f_name').value.trim(), phoneNumber: document.getElementById('f_mobile').value.trim(), houseNumber: document.getElementById('f_house').value.trim(), streetName: document.getElementById('f_street').value.trim(), pincode: document.getElementById('f_pincode').value.trim(), city: document.getElementById('f_city').value.trim(), state: document.getElementById('f_state').value.trim(), landmark: document.getElementById('f_landmark').value.trim(), country: document.getElementById('f_country').value.trim(), isDefault: editingAddressDefault };
  }

  async function addAddress() {
    if (!validateForm()) return; showLoader();
    try {
      const res    = await fetch('/address/add', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(getNewAddressPayload()) });
      const result = await res.json();
      hideLoader();
      if (!res.ok || result.success === false) return toastError(result.message || 'Failed to add address.');
      toastSuccess('Address saved');
      setTimeout(() => window.location.reload(), 1000);
    } catch { hideLoader(); toastError('Something went wrong. Please try again.'); }
  }

  async function updateAddress() {
    if (!editingAddressId) return toastError('No address selected for editing.');
    if (!validateForm()) return; showLoader();
    try {
      const res    = await fetch(`/address/edit/${editingAddressId}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(getEditAddressPayload()) });
      const result = await res.json();
      hideLoader();
      if (!res.ok || result.success === false) return toastError(result.message || 'Failed to update address.');
      toastSuccess('Address updated');
      setTimeout(() => window.location.reload(), 1000);
    } catch { hideLoader(); toastError('Something went wrong. Please try again.'); }
  }

  function saveAddressFromCheckout() {
    editingAddressId ? updateAddress() : addAddress();
  }

  /* ── COD / WALLET PLACE ORDER ── */
  async function placeOrder() {
    if (!selectedAddressId) {
      document.getElementById('addr-select-error').style.display = 'block';
      document.getElementById('addressCardGrid').scrollIntoView({ behavior: 'smooth', block: 'start' });
      return toastError('Please select a shipping address.');
    }

    const taxable_     = Math.max(baseSubtotal - appliedDiscount, 0);
    const gst_         = Math.round(taxable_ * 0.05);
    const shipping_    = baseSubtotal >= 999 ? 0 : 99;
    const currentTotal = taxable_ + gst_ + shipping_;

    if (selectedPayment === 'wallet' && walletBalance < currentTotal) {
      return toastError(`Insufficient wallet balance. You need ₹${(currentTotal - walletBalance).toLocaleString('en-IN')} more.`);
    }

    const loadingText = document.querySelector('.loading-text');
    loadingText.textContent = selectedPayment === 'wallet'
      ? 'Debiting wallet · Please wait'
      : 'Processing · Please wait';

    showLoader();
    try {
      const res  = await fetch('/checkout/place-order', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          addressId:     selectedAddressId,
          paymentMethod: selectedPayment,
          couponCode:    appliedCouponCode || null,
          discount:      appliedDiscount   || 0,
        }),
      });
      const data = await res.json();
      hideLoader();
      if (!data.success) return toastError(data.message);
      toastSuccess(selectedPayment === 'wallet'
        ? `₹${currentTotal.toLocaleString('en-IN')} debited from your wallet.`
        : 'Order confirmed — redirecting…');
      setTimeout(() => { window.location.href = data.redirect; }, 1400);
    } catch {
      hideLoader();
      toastError('Something went wrong. Please try again.');
    }
  }
</script>

</body>
