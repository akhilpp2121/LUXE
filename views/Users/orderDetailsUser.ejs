<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Order <%= order[0].orderCode %> | THE DIGITAL ATELIER</title>
  <link rel="icon" type="image/x-icon" href="/favicon.png"/>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=DM+Serif+Display:ital@0;1&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet"/>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>

  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "surface":                   "#0b1326",
            "background":                "#0b1326",
            "surface-container":         "#171f33",
            "surface-container-low":     "#131b2e",
            "surface-container-high":    "#222a3d",
            "surface-container-highest": "#2d3449",
            "on-surface":                "#dae2fd",
            "on-surface-variant":        "#c4c5d7",
            "primary":                   "#b7c4ff",
            "primary-container":         "#1d4ed8",
            "on-primary-container":      "#cad3ff",
            "outline-variant":           "#434655",
            "outline":                   "#8e90a0",
            "error":                     "#ffb4ab",
            "error-container":           "#93000a",
          },
          fontFamily: {
            headline: ["Plus Jakarta Sans", "sans-serif"],
            serif:    ["DM Serif Display", "serif"],
            mono:     ["DM Mono", "monospace"],
          },
          borderRadius: {
            DEFAULT: "0.125rem",
            lg:      "0.25rem",
            xl:      "0.5rem",
            "2xl":   "0.75rem",
            full:    "9999px",
          },
        }
      }
    }
  </script>

  <style>
    * { box-sizing: border-box; }
    body { background-color: #0b1326; color: #dae2fd; font-family: "Plus Jakarta Sans", sans-serif; }
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24; }

    body::before {
      content: "";
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
      background-size: 200px 200px; opacity: .4;
    }
    main, nav, footer { position: relative; z-index: 1; }

    .glass { background: rgba(23,31,51,.6); backdrop-filter: blur(20px); border: 1px solid rgba(67,70,85,.4); }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(18px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .fade-up { opacity: 0; animation: fadeUp .55s cubic-bezier(.22,1,.36,1) forwards; }
    .d1 { animation-delay: .05s; } .d2 { animation-delay: .13s; }
    .d3 { animation-delay: .21s; } .d4 { animation-delay: .29s; }
    .d5 { animation-delay: .37s; } .d6 { animation-delay: .45s; }

    .item-row { border-bottom: 1px solid rgba(67,70,85,.3); transition: background .2s, transform .2s; }
    .item-row:hover { background: rgba(29,78,216,.06); transform: translateX(3px); }
    .item-row:last-child { border-bottom: none; }
    .item-row.is-cancelled:hover { transform: none; background: transparent; }

    @keyframes strikeIn { from { opacity: 1; } to { opacity: .38; } }
    .item-row.cancelling { animation: strikeIn .4s ease forwards; pointer-events: none; }

    .pill-transit   { background: rgba(183,196,255,.1); border: 1px solid rgba(183,196,255,.3); color: #b7c4ff; }
    .pill-completed { background: rgba(52,211,153,.1);  border: 1px solid rgba(52,211,153,.3);  color: #34d399; }
    .pill-cancelled { background: rgba(255,180,171,.1); border: 1px solid rgba(255,180,171,.3); color: #ffb4ab; }
    .pill-pending   { background: rgba(251,191,36,.1);  border: 1px solid rgba(251,191,36,.3);  color: #fbbf24; }
    .pill-shipped   { background: rgba(167,139,250,.1); border: 1px solid rgba(167,139,250,.3); color: #a78bfa; }

    .step-done   { background: #1d4ed8; }
    .step-active { background: #0b1326; border: 2px solid #1d4ed8; }
    .step-future { background: #0b1326; border: 1px solid #434655; }
    .conn-full { background: #1d4ed8; }
    .conn-half { background: linear-gradient(90deg, #1d4ed8 50%, #222a3d 50%); }
    .conn-empty { background: #222a3d; }

    .da-modal {
      display: none; position: fixed; inset: 0; z-index: 200;
      background: rgba(6,14,32,.85); backdrop-filter: blur(8px);
      align-items: center; justify-content: center;
    }
    .da-modal.active { display: flex; }
    .da-modal-box {
      background: #131b2e; border: 1px solid #434655;
      border-radius: .5rem; max-width: 540px; width: 92%;
      animation: slideUp .3s cubic-bezier(.22,1,.36,1);
      max-height: 90vh; overflow-y: auto;
    }
    @keyframes slideUp {
      from { transform: translateY(28px); opacity: 0; }
      to   { transform: translateY(0); opacity: 1; }
    }

    .da-input {
      width: 100%; background: #0b1326; border: 1px solid #434655;
      color: #dae2fd; border-radius: .25rem;
      padding: .75rem 1rem; font-family: "Plus Jakarta Sans", sans-serif;
      font-size: .875rem; transition: border-color .2s; appearance: none;
    }
    .da-input:focus { outline: none; border-color: #1d4ed8; }
    .da-input option { background: #131b2e; }

    /* qty spinner */
    .qty-spinner {
      display: flex; align-items: center; gap: 0;
      border: 1px solid #434655; border-radius: .25rem; overflow: hidden;
      width: fit-content;
    }
    .qty-spinner button {
      background: #0b1326; border: none; color: #dae2fd;
      width: 36px; height: 36px; font-size: 1.1rem; cursor: pointer;
      transition: background .15s; flex-shrink: 0;
    }
    .qty-spinner button:hover { background: #222a3d; }
    .qty-spinner button:disabled { opacity: .3; cursor: not-allowed; }
    .qty-spinner input {
      background: #0b1326; border: none; border-left: 1px solid #434655;
      border-right: 1px solid #434655; color: #dae2fd;
      width: 52px; height: 36px; text-align: center;
      font-family: "DM Mono", monospace; font-size: .875rem;
      -moz-appearance: textfield;
    }
    .qty-spinner input::-webkit-outer-spin-button,
    .qty-spinner input::-webkit-inner-spin-button { -webkit-appearance: none; }
    .qty-spinner input:focus { outline: none; }

    .btn-atelier {
      display: inline-flex; align-items: center; gap: .5rem;
      padding: .7rem 1.6rem; border-radius: .25rem;
      font-family: "Plus Jakarta Sans", sans-serif;
      font-size: .75rem; font-weight: 700; letter-spacing: .1em;
      text-transform: uppercase; transition: all .2s; cursor: pointer;
    }
    .btn-primary-da  { background: #1d4ed8; color: #cad3ff; border: none; }
    .btn-primary-da:hover  { opacity: .9; transform: translateY(-1px); }
    .btn-ghost-da    { background: transparent; color: #dae2fd; border: 1px solid #434655; }
    .btn-ghost-da:hover    { background: rgba(255,255,255,.04); }
    .btn-danger-da   { background: transparent; color: #ffb4ab; border: 1px solid rgba(255,180,171,.3); }
    .btn-danger-da:hover   { background: rgba(255,180,171,.06); }
    .btn-atelier:disabled  { opacity: .4; cursor: not-allowed; transform: none !important; }

    @keyframes totalFlash {
      0%   { color: #34d399; }
      100% { color: #dae2fd; }
    }
    .total-flash { animation: totalFlash .8s ease; }

    .swal2-popup   { background: #131b2e !important; color: #dae2fd !important; border: 1px solid #434655 !important; }
    .swal2-title   { color: #dae2fd !important; font-family: "Plus Jakarta Sans" !important; }
    .swal2-confirm { background: #1d4ed8 !important; font-family: "Plus Jakarta Sans" !important; }
    .swal2-cancel  { background: #222a3d !important; color: #dae2fd !important; font-family: "Plus Jakarta Sans" !important; }

    /* return item card inside modal */
    .return-item-card {
      border: 1px solid #434655; border-radius: .25rem;
      padding: .75rem 1rem; cursor: pointer;
      transition: border-color .2s, background .2s;
      display: flex; align-items: center; gap: .75rem;
    }
    .return-item-card:hover { border-color: #1d4ed8; background: rgba(29,78,216,.05); }
    .return-item-card.selected { border-color: #1d4ed8; background: rgba(29,78,216,.08); }
    .return-item-card input[type="checkbox"] { accent-color: #1d4ed8; width: 16px; height: 16px; flex-shrink: 0; }
  </style>
</head>
<body>

<%
  const ord         = order[0];
  const orderItems  = ord.orderItems  || [];
  const cancelledAt = ord.cancelledAt || [];
  const returnedAt  = ord.returnedAt  || [];
  const shipAddr    = ord.shippingAddress || {};

  const st = (ord.orderStatus || '').toUpperCase();

  const stepOrder  = ['PENDING','PROCESSING','SHIPPED','COMPLETED'];
  const currentIdx = stepOrder.indexOf(st) >= 0 ? stepOrder.indexOf(st) : 0;

  const canCancel = (ord.deliveryStatus === 'pending');

  const pillClass = st === 'COMPLETED' ? 'pill-completed'
                  : st === 'CANCELLED' ? 'pill-cancelled'
                  : st === 'PENDING'   ? 'pill-pending'
                  : st === 'SHIPPED'   ? 'pill-shipped'
                  : 'pill-transit';

  const dotAnim = (st !== 'COMPLETED' && st !== 'CANCELLED') ? 'animate-pulse' : '';

  /* Set of cancelled variantIds */
  const cancelledVIds = new Set();
  cancelledAt.forEach(function(ca) {
    (ca.cancelledProducts || []).forEach(function(cp) {
      cancelledVIds.add(cp && cp._id ? cp._id.toString() : String(cp));
    });
  });

  /* Set of already-returned variantIds */
  const returnedVIds = new Set();
  returnedAt.forEach(function(r) {
    if (r.variant) returnedVIds.add(r.variant.toString());
  });

  function resolveItem(item) {
    const variant   = item.variantId && typeof item.variantId === 'object' ? item.variantId : null;
    const variantId = variant ? variant._id.toString() : String(item.variantId || '');
    const images    = variant ? (variant.images || variant.image || []) : [];
    const thumb     = images[0] ? '/uploads/' + images[0] : '/images/placeholder.png';
    const sku       = variant && variant.SKU ? variant.SKU : variantId.slice(-8).toUpperCase();
    const cancelled = cancelledVIds.has(variantId) || !!item.isCancelled;
    const returned  = returnedVIds.has(variantId);

    let cancelStatus = 'Cancelled';
    if (cancelled) {
      const ca = cancelledAt.find(function(c) {
        return (c.cancelledProducts || []).some(function(cp) {
          return (cp && cp._id ? cp._id.toString() : String(cp)) === variantId;
        });
      });
      if (ca) cancelStatus = ca.cancelRequestStatus || 'Cancelled';
    }

    let returnStatus = null;
    if (returned) {
      const itemReturns = returnedAt.filter(r => r.variant && r.variant.toString() === variantId);
      const ret = itemReturns.length > 0 ? itemReturns[itemReturns.length - 1] : null;
      if (ret) returnStatus = ret.returnRequestStatus || 'Pending';
    }

    return { variantId, thumb, sku, cancelled, cancelStatus, returned, returnStatus };
  }

  /* Active-only grand total */
  const activeSubTotal = orderItems.reduce(function(sum, item) {
    const { cancelled } = resolveItem(item);
    return cancelled ? sum : sum + (item.totalPrice || 0);
  }, 0);
  const shippingCharge = ord.shippingCharge || 0;
  const couponDiscount = ord.couponApplied  || 0;
  const activeTotal    = +(activeSubTotal + shippingCharge - couponDiscount).toFixed(2);

  /* Items eligible for return (not cancelled, not already returned) */
  const returnableItems = orderItems.filter(function(item) {
    const r = resolveItem(item);
    return !r.cancelled && !r.returned;
  });
%>

<main class="pt-28 pb-24 px-6 md:px-12 max-w-[1400px] mx-auto min-h-screen">

  <!-- Back -->
  <div class="mb-10 fade-up d1">
    <a href="/order/my-orders" class="inline-flex items-center gap-2 text-[11px] uppercase tracking-[.18em] font-bold text-on-surface-variant hover:text-primary transition-colors group">
      <span class="material-symbols-outlined text-sm group-hover:-translate-x-1 transition-transform">arrow_back</span>
      Order Archive
    </a>
  </div>

  <!-- Page Header -->
  <header class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-8 fade-up d2">
    <div>
      <p class="text-[10px] uppercase tracking-[.25em] text-primary/60 mb-2 font-semibold">Order Identity</p>
      <h1 class="font-serif text-5xl md:text-6xl text-white leading-none mb-3"><%= ord.orderCode %></h1>

      <div class="flex flex-wrap items-center gap-4 text-sm text-on-surface-variant">
        <span class="flex items-center gap-1.5">
          <span class="material-symbols-outlined text-base">calendar_today</span>
          <%= new Date(ord.orderDate).toDateString() %>
        </span>
        <% if (ord.expectedDeliveryDate) { %>
          <span class="text-outline-variant">·</span>
          <span class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-base">local_shipping</span>
            Est. <%= new Date(ord.expectedDeliveryDate).toDateString() %>
          </span>
        <% } %>
      </div>

      <div class="mt-4 inline-flex items-center gap-2.5 px-4 py-2 rounded-full <%= pillClass %>">
        <span class="w-1.5 h-1.5 rounded-full bg-current <%= dotAnim %>"></span>
        <span class="text-[10px] uppercase tracking-[.18em] font-bold"><%= st %></span>
      </div>

      <% const pendingCancels = cancelledAt.filter(function(ca) { return ca.cancelRequestStatus === 'Pending'; }); %>
      <% if (pendingCancels.length > 0) { %>
        <div class="mt-4 flex items-center gap-3 px-4 py-3 bg-yellow-500/5 border border-yellow-500/20 rounded text-sm text-yellow-400/90">
          <span class="material-symbols-outlined text-base text-yellow-400">hourglass_top</span>
          <%= pendingCancels.length %> cancel request<%= pendingCancels.length > 1 ? 's' : '' %> pending approval
        </div>
      <% } %>

      <% if (cancelledAt.length > 0) { %>
        <% const lastCancel = cancelledAt[cancelledAt.length - 1]; %>
        <% if (lastCancel.cancelRequestStatus !== 'Pending') { %>
          <div class="mt-4 flex items-center gap-3 px-4 py-3 bg-error-container/10 border border-error/20 rounded text-sm text-error/80">
            <span class="material-symbols-outlined text-base text-error">info</span>
            Cancel request: <%= new Date(lastCancel.requestedAt).toLocaleString("en-IN") %>
            <span class="ml-2 px-2 py-0.5 bg-error/10 rounded text-[10px] uppercase tracking-wider"><%= lastCancel.cancelRequestStatus %></span>
          </div>
        <% } %>
      <% } %>
    </div>

    <!-- Actions -->
    <div class="flex flex-wrap gap-3">
      <a href="/order/invoice/<%= ord._id %>">
        <button class="btn-atelier btn-ghost-da">
          <span class="material-symbols-outlined text-base">receipt_long</span>
          Download Invoice
        </button>
      </a>
    </div>
  </header>

  <!-- Progress Tracker -->
  <% if (st !== 'CANCELLED') { %>
    <%
      const steps = [
        { label: 'Confirmed',        icon: 'check'          },
        { label: 'Shipped',          icon: 'local_shipping' },
        { label: 'Out for Delivery', icon: 'package_2'      },
        { label: 'Delivered',        icon: 'verified'       },
      ];
    %>
    <div class="mb-16 glass rounded-xl p-8 md:p-10 fade-up d3">
      <div class="flex justify-between items-center mb-10">
        <% steps.forEach(function(step, i) { %>
          <% const done = i < currentIdx; const active = i === currentIdx; %>
          <div class="flex flex-col items-center gap-3 relative z-10">
            <% if (done) { %>
              <div class="w-10 h-10 rounded-full step-done flex items-center justify-center shadow-lg shadow-blue-900/30">
                <span class="material-symbols-outlined text-sm text-white"><%= step.icon %></span>
              </div>
              <span class="text-[9px] uppercase tracking-widest font-bold text-white hidden sm:block"><%= step.label %></span>
            <% } else if (active) { %>
              <div class="w-10 h-10 rounded-full step-active flex items-center justify-center">
                <span class="material-symbols-outlined text-sm text-primary"><%= step.icon %></span>
              </div>
              <span class="text-[9px] uppercase tracking-widest font-bold text-primary hidden sm:block"><%= step.label %></span>
            <% } else { %>
              <div class="w-10 h-10 rounded-full step-future flex items-center justify-center">
                <span class="material-symbols-outlined text-sm text-on-surface-variant"><%= step.icon %></span>
              </div>
              <span class="text-[9px] uppercase tracking-widest font-bold text-on-surface-variant/40 hidden sm:block"><%= step.label %></span>
            <% } %>
          </div>
          <% if (i < steps.length - 1) { %>
            <%
              const connClass = i < currentIdx - 1 ? 'conn-full'
                              : i === currentIdx - 1 ? 'conn-half'
                              : 'conn-empty';
            %>
            <div class="flex-1 h-px mx-2 relative overflow-hidden rounded">
              <div class="absolute inset-0 <%= connClass %>"></div>
            </div>
          <% } %>
        <% }) %>
      </div>

      <div class="pt-8 border-t border-outline-variant/20 flex items-start gap-5">
        <div class="w-11 h-11 rounded-xl bg-primary-container/10 flex items-center justify-center flex-shrink-0">
          <span class="material-symbols-outlined text-primary">history</span>
        </div>
        <div>
          <% if (st === 'PENDING') { %>
            <p class="text-white font-semibold font-headline">Order confirmed — being prepared</p>
            <p class="text-on-surface-variant text-sm mt-0.5">Placed <%= new Date(ord.orderDate).toLocaleString("en-IN") %></p>
          <% } else if (st === 'PROCESSING') { %>
            <p class="text-white font-semibold font-headline">Order packed and dispatched</p>
            <p class="text-on-surface-variant text-sm mt-0.5">Est. delivery <%= ord.expectedDeliveryDate ? new Date(ord.expectedDeliveryDate).toDateString() : 'TBD' %></p>
          <% } else if (st === 'SHIPPED') { %>
            <p class="text-white font-semibold font-headline">Out for delivery — arriving today</p>
            <p class="text-on-surface-variant text-sm mt-0.5">Your order is with the delivery partner</p>
          <% } else if (st === 'COMPLETED') { %>
            <p class="text-white font-semibold font-headline">Delivered successfully</p>
            <p class="text-on-surface-variant text-sm mt-0.5">Thank you for shopping with The Digital Atelier</p>
          <% } %>
        </div>
      </div>
    </div>

  <% } else { %>
    <div class="mb-16 flex items-center gap-5 px-8 py-6 bg-error-container/10 border border-error/20 rounded-xl fade-up d3">
      <div class="w-11 h-11 rounded-xl bg-error/10 flex items-center justify-center flex-shrink-0">
        <span class="material-symbols-outlined text-error">cancel</span>
      </div>
      <div>
        <p class="text-error font-bold font-headline uppercase tracking-wide text-sm">Order Cancelled</p>
        <% if (cancelledAt.length > 0) { %>
          <p class="text-on-surface-variant text-sm"><%= new Date(cancelledAt[cancelledAt.length-1].requestedAt).toLocaleString("en-IN") %></p>
        <% } %>
      </div>
    </div>
  <% } %>

  <!-- Shipped hint -->
  <% if (st === 'SHIPPED') { %>
    <div class="mb-8 flex items-center gap-4 px-6 py-4 bg-primary-container/5 border border-primary/15 rounded-xl fade-up d3">
      <span class="material-symbols-outlined text-primary flex-shrink-0">info</span>
      <p class="text-on-surface-variant text-sm">
        Your order is <span class="text-white font-semibold">out for delivery</span> — cancellations are no longer available at this stage.
      </p>
    </div>
  <% } %>

  <!-- Main Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">

    <!-- LEFT: Items -->
    <div class="lg:col-span-8 fade-up d4">
      <div class="flex items-end justify-between mb-6">
        <h2 class="font-headline font-bold text-xl text-white">
          Consignment Items
          <span class="font-mono text-sm text-on-surface-variant ml-2">(<%= String(orderItems.length).padStart(2,'0') %>)</span>
        </h2>

        <% if (canCancel && orderItems.length > 0) { %>
          <button onclick="openCancelALLModal('ALL','<%= ord._id %>')" class="btn-atelier btn-danger-da text-[10px]">
            <span class="material-symbols-outlined text-sm">delete_sweep</span>
            Cancel All
          </button>
        <% } %>
      </div>

      <div class="glass rounded-xl overflow-hidden" id="itemList">
        <% orderItems.forEach(function(item) {
          const r = resolveItem(item);
        %>
          <div class="item-row p-6 flex flex-col sm:flex-row gap-6 items-start sm:items-center <%= r.cancelled ? 'is-cancelled opacity-40' : '' %>"
               id="item-row-<%= r.variantId %>"
               data-price="<%= item.totalPrice || 0 %>"
               data-qty="<%= item.quantity || 1 %>"
               data-cancelled="<%= r.cancelled ? 'true' : 'false' %>">

            <!-- Thumbnail -->
            <div class="w-20 h-28 bg-surface-container-highest rounded-sm overflow-hidden flex-shrink-0">
              <img src="<%= r.thumb %>" alt="<%= item.productName %>"
                   class="w-full h-full object-cover <%= r.cancelled ? 'grayscale opacity-50' : 'grayscale hover:grayscale-0 transition-all duration-700' %>"/>
            </div>

            <!-- Info -->
            <div class="flex-grow min-w-0">
              <div class="flex flex-wrap justify-between items-start gap-2 mb-3">
                <div>
                  <h3 class="text-white font-headline font-semibold uppercase tracking-tight leading-tight text-base">
                    <%= item.productName %>
                    <% if (r.cancelled) { %>
                      <span class="ml-2 inline-flex items-center gap-1 px-2 py-0.5 bg-error/10 border border-error/20 text-error text-[9px] uppercase tracking-widest rounded font-bold">
                        <span class="material-symbols-outlined text-xs">block</span>
                        <%= r.cancelStatus %>
                      </span>
                    <% } %>
                    <% if (r.returned) { %>
                      <span class="ml-2 inline-flex items-center gap-1 px-2 py-0.5 bg-primary/10 border border-primary/20 text-primary text-[9px] uppercase tracking-widest rounded font-bold">
                        <span class="material-symbols-outlined text-xs">undo</span>
                        Return <%= r.returnStatus %>
                      </span>
                    <% } %>
                  </h3>
                  <p class="font-mono text-[11px] text-on-surface-variant mt-1">
                    SKU: <%= r.sku %>
                    <% if (item.variantName) { %> · <%= item.variantName %><% } %>
                  </p>
                </div>
                <div class="text-right">
                  <span class="text-xl font-headline font-black <%= r.cancelled ? 'line-through text-on-surface-variant' : 'text-white' %>">
                    ₹<%= item.totalPrice %>
                  </span>
                  <% if (r.cancelled) { %>
                    <p class="text-[10px] text-on-surface-variant/60 uppercase tracking-wider mt-0.5">Not charged</p>
                  <% } %>
                </div>
              </div>
              <div class="flex flex-wrap gap-6 text-[10px] uppercase tracking-widest font-semibold text-on-surface-variant">
                <div>Unit Price <span class="text-white ml-1">₹<%= item.price %></span></div>
                <div>Qty <span class="text-white ml-1"><%= String(item.quantity).padStart(2,'0') %></span></div>
              </div>
            </div>

            <!-- Per-item actions -->
            <div class="flex flex-col gap-2 flex-shrink-0" id="cancel-btn-wrap-<%= r.variantId %>">
              <% if (!r.cancelled && canCancel && orderItems.length > 1) { %>
                <button onclick="openCancelModal('<%= r.variantId %>','<%= ord._id %>')"
                  class="btn-atelier btn-danger-da text-[10px] py-2 px-3">
                  <span class="material-symbols-outlined text-sm">close</span>
                  Cancel
                </button>
              <% } %>

              <!-- Return button per item — only when COMPLETED, not cancelled -->
              <% if (st === 'COMPLETED' && !r.cancelled) { %>
                <% if (r.returned) { %>
                  <% if (r.returnStatus === 'Pending') { %>
                    <button disabled
                      class="btn-atelier btn-ghost-da text-[10px] py-2 px-3 opacity-50 cursor-not-allowed">
                      <span class="material-symbols-outlined text-sm">hourglass_top</span>
                      Return Requested
                    </button>
                  <% } else if (r.returnStatus === 'Approved') { %>
                    <button disabled
                      class="btn-atelier btn-ghost-da text-[10px] py-2 px-3 opacity-50 cursor-not-allowed">
                      <span class="material-symbols-outlined text-sm">check_circle</span>
                      Returned
                    </button>
                  <% } else if (r.returnStatus === 'Rejected') { %>
                    <button disabled
                      class="btn-atelier btn-ghost-da text-[10px] py-2 px-3 opacity-50 cursor-not-allowed">
                      <span class="material-symbols-outlined text-sm">cancel</span>
                      Return Rejected
                    </button>
                  <% } %>
                <% } else { %>
                  <button data-return-btn onclick="openReturnModal('<%= ord._id %>', '<%= r.variantId %>', '<%= item.productName %>', <%= item.quantity %>)"
                    class="btn-atelier btn-ghost-da text-[10px] py-2 px-3">
                    <span class="material-symbols-outlined text-sm">undo</span>
                    Return
                  </button>
                <% } %>
              <% } %>

              <% if (!r.cancelled && st === 'SHIPPED') { %>
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-primary/5 border border-primary/20 text-primary text-[9px] uppercase tracking-widest font-bold">
                  <span class="material-symbols-outlined text-xs">local_shipping</span>
                  In Transit
                </span>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- Return All CTA — only when COMPLETED and at least one returnable item remains -->
      <% if (st === 'COMPLETED' && returnableItems.length > 1) { %>
        <div class="mt-8 glass rounded-xl p-6 flex flex-col sm:flex-row justify-between items-center gap-6 border-l-4 border-primary-container">
          <div class="flex items-center gap-5">
            <div class="w-12 h-12 rounded-xl bg-primary-container/10 flex items-center justify-center flex-shrink-0">
              <span class="material-symbols-outlined text-primary">package_2</span>
            </div>
            <div>
              <p class="text-white font-headline font-bold tracking-tight">Return multiple items?</p>
              <p class="text-on-surface-variant text-sm mt-0.5"><%= returnableItems.length %> item<%= returnableItems.length > 1 ? 's' : '' %> eligible · within 30 days of delivery.</p>
            </div>
          </div>
          <button onclick="openReturnModal('<%= ord._id %>', 'ALL', 'All Items', 0)" class="btn-atelier btn-primary-da whitespace-nowrap">
            <span class="material-symbols-outlined text-base">undo</span>
            Return All
          </button>
        </div>
      <% } %>

      <!-- Return status banners per returned item -->
      <% if (returnedAt.length > 0) { %>
        <div class="mt-8 space-y-4">
          <% returnedAt.forEach(function(ret) {
            const retApproved = ret.returnRequestStatus === 'Approved';
            const retPending  = ret.returnRequestStatus === 'Pending';
            const retBorder   = retApproved ? 'border-green-500' : retPending ? 'border-primary-container' : 'border-error';
            const retBg       = retApproved ? 'bg-green-500/10'  : retPending ? 'bg-primary-container/10'  : 'bg-error/10';
            const retColor    = retApproved ? 'text-green-400'   : retPending ? 'text-primary'             : 'text-error';
            const retIcon     = (retApproved || retPending) ? 'check_circle' : 'cancel';

            /* Try to find product name */
            const retItem = orderItems.find(function(oi) {
              return oi.variantId && oi.variantId.toString ? oi.variantId.toString() === (ret.variant ? ret.variant.toString() : '') : false;
            });
            const retName = retItem ? retItem.productName : 'Item';
          %>
            <div class="glass rounded-xl p-5 flex items-start gap-5 border-l-4 <%= retBorder %>">
              <div class="w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0 <%= retBg %>">
                <span class="material-symbols-outlined <%= retColor %>"><%= retIcon %></span>
              </div>
              <div class="flex-grow">
                <div class="flex items-center justify-between gap-4 flex-wrap">
                  <p class="text-white font-headline font-bold tracking-tight">Return: <%= retName %></p>
                  <span class="px-2 py-0.5 rounded text-[10px] uppercase tracking-widest font-bold
                    <%= retApproved ? 'bg-green-500/10 text-green-400' : retPending ? 'bg-primary/10 text-primary' : 'bg-error/10 text-error' %>">
                    <%= ret.returnRequestStatus %>
                  </span>
                </div>
                <p class="text-on-surface-variant text-sm mt-1">
                  Qty: <span class="text-white font-semibold"><%= ret.quantity || '—' %></span>
                  · Reason: <span class="text-white"><%= ret.reason %></span>
                  · Resolution: <span class="text-white"><%= ret.resolution %></span>
                </p>
                <p class="text-on-surface-variant/50 text-xs mt-1"><%= new Date(ret.requestedAt).toLocaleString("en-IN") %></p>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- RIGHT: Info -->
    <div class="lg:col-span-4 space-y-8 fade-up d5">

      <!-- Shipping -->
      <section>
        <p class="text-[10px] uppercase tracking-[.22em] font-bold text-primary mb-4">Shipping Destination</p>
        <div class="glass rounded-xl p-6">
          <div class="flex items-start gap-4">
            <span class="material-symbols-outlined text-primary mt-0.5">location_on</span>
            <div class="space-y-1">
              <p class="text-white font-headline font-bold uppercase tracking-tight"><%= shipAddr.username || 'N/A' %></p>
              <p class="text-on-surface-variant text-sm leading-relaxed">
                <%= shipAddr.street_address || '' %><br/>
                <% if (shipAddr.landmark) { %><%= shipAddr.landmark %><br/><% } %>
                <%= shipAddr.city || '' %>, <%= shipAddr.state || '' %><br/>
                <%= shipAddr.country || '' %><% if (shipAddr.postal_code) { %> — <%= shipAddr.postal_code %><% } %>
              </p>
              <% if (shipAddr.phone_number) { %>
                <p class="text-on-surface-variant text-xs flex items-center gap-1 pt-1">
                  <span class="material-symbols-outlined text-xs">call</span><%= shipAddr.phone_number %>
                </p>
              <% } %>
            </div>
          </div>
        </div>
      </section>

      <!-- Payment -->
      <section>
        <p class="text-[10px] uppercase tracking-[.22em] font-bold text-primary mb-4">Payment Method</p>
        <div class="glass rounded-xl p-6">
          <div class="flex items-center gap-4">
            <div class="w-12 h-8 bg-surface-container rounded border border-outline-variant/30 flex items-center justify-center">
              <span class="material-symbols-outlined text-sm text-on-surface-variant">payments</span>
            </div>
            <p class="text-white font-headline font-bold uppercase tracking-tight text-sm"><%= (ord.orderMethod || 'N/A').toUpperCase() %></p>
          </div>
        </div>
      </section>

      <!-- Financial Summary -->
      <section>
        <p class="text-[10px] uppercase tracking-[.22em] font-bold text-primary mb-4">Financial Summary</p>
        <div class="glass rounded-xl p-6 space-y-4">
          <div class="space-y-3" id="summaryLines">
            <div class="flex justify-between text-sm">
              <span class="text-on-surface-variant">Subtotal</span>
              <span class="text-white font-medium" id="displaySubtotal">₹<%= activeSubTotal.toFixed(2) %></span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-on-surface-variant">Shipping</span>
              <span id="displayShipping" class="<%= shippingCharge === 0 ? 'text-primary font-bold' : 'text-white font-medium' %>">
                <%= shippingCharge === 0 ? 'FREE' : '₹' + shippingCharge.toFixed(2) %>
              </span>
            </div>
            <% if (couponDiscount > 0) { %>
              <div class="flex justify-between text-sm">
                <span class="text-on-surface-variant">Coupon</span>
                <span class="text-primary font-medium">−₹<%= couponDiscount.toFixed(2) %></span>
              </div>
            <% } %>
          </div>

          <div class="pt-5 border-t border-outline-variant/20 flex justify-between items-end">
            <span class="text-[10px] uppercase tracking-[.15em] font-bold text-white">Grand Total</span>
            <span class="font-serif text-3xl text-white" id="displayTotal">₹<%= activeTotal.toFixed(2) %></span>
          </div>

          <% if (cancelledVIds.size > 0) { %>
            <p class="text-[10px] text-on-surface-variant/50 text-right -mt-2">Cancelled items excluded</p>
          <% } %>
        </div>
      </section>
    </div>
  </div>
</main>

<footer class="relative z-10 mt-20 py-10 px-12 border-t border-outline-variant/10 text-center">
  <p class="text-[10px] uppercase tracking-[.4em] font-bold text-on-surface-variant/30">© 2024 THE DIGITAL ATELIER · ALL RIGHTS RESERVED</p>
</footer>


