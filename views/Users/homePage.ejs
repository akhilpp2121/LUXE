     /* ---- Animated Logo (Puzzle Assembly) ---- */
.brand-mark {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    opacity: 0;
    animation: logoEntrance 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes logoEntrance {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
}

/* Puzzle container */
.diamond-puzzle {
    position: relative;
    display: inline-block;
    width: 30px;
    height: 30px;
    flex-shrink: 0;
}

.diamond-puzzle .piece {
    position: absolute;
    inset: 0;
    font-size: 30px;
    line-height: 30px;
    color: #1152d4;
    font-variation-settings: 'FILL' 1, 'wght' 500;
    filter: drop-shadow(0 0 6px rgba(17, 82, 212, 0.4));
}

/* Each piece = one quadrant of the glyph */
.piece-1 { clip-path: polygon(0 0, 50% 0, 50% 50%, 0 50%); }
.piece-2 { clip-path: polygon(50% 0, 100% 0, 100% 50%, 50% 50%); }
.piece-3 { clip-path: polygon(0 50%, 50% 50%, 50% 100%, 0 100%); }
.piece-4 { clip-path: polygon(50% 50%, 100% 50%, 100% 100%, 50% 100%); }

/* Ambient puzzle-assemble loop */
.piece-1 { animation: puzzle1 5s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
.piece-2 { animation: puzzle2 5s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
.piece-3 { animation: puzzle3 5s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
.piece-4 { animation: puzzle4 5s cubic-bezier(0.65, 0, 0.35, 1) infinite; }

@keyframes puzzle1 {
    0%, 100% { transform: translate(-10px, -10px) rotate(-25deg); opacity: 0.4; }
    35%, 65% { transform: translate(0, 0) rotate(0deg); opacity: 1; }
}
@keyframes puzzle2 {
    0%, 100% { transform: translate(10px, -10px) rotate(25deg); opacity: 0.4; }
    35%, 65% { transform: translate(0, 0) rotate(0deg); opacity: 1; }
}
@keyframes puzzle3 {
    0%, 100% { transform: translate(-10px, 10px) rotate(25deg); opacity: 0.4; }
    35%, 65% { transform: translate(0, 0) rotate(0deg); opacity: 1; }
}
@keyframes puzzle4 {
    0%, 100% { transform: translate(10px, 10px) rotate(-25deg); opacity: 0.4; }
    35%, 65% { transform: translate(0, 0) rotate(0deg); opacity: 1; }
}

/* Snappy "solve" burst on hover */
.brand-mark:hover .piece {
    animation-play-state: paused;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.3s ease;
}
.brand-mark:hover .piece-1 { transform: translate(-6px, -6px) rotate(-15deg); }
.brand-mark:hover .piece-2 { transform: translate(6px, -6px) rotate(15deg); }
.brand-mark:hover .piece-3 { transform: translate(-6px, 6px) rotate(15deg); }
.brand-mark:hover .piece-4 { transform: translate(6px, 6px) rotate(-15deg); }

.brand-mark:hover .diamond-puzzle {
    animation: solveSnap 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.4s forwards;
}
@keyframes solveSnap {
    to { filter: drop-shadow(0 0 12px rgba(17, 82, 212, 0.7)); }
}
.brand-mark:hover .piece-1,
.brand-mark:hover .piece-2,
.brand-mark:hover .piece-3,
.brand-mark:hover .piece-4 {
    animation: none;
    transition-delay: 0.15s;
}
.brand-mark:hover .piece-1 { transition-property: transform; }
.brand-mark:not(:hover) .piece { transition: none; }

/* Actual re-snap to center when mouse leaves the burst */
.brand-mark:hover .diamond-puzzle:hover .piece,
.brand-mark:active .piece {
    transform: translate(0, 0) rotate(0deg) !important;
}

/* Shimmer text stays the same */
.brand-mark .brand-name {
    font-weight: 800;
    letter-spacing: 0.06em;
    background: linear-gradient(
        100deg,
        currentColor 30%,
        #1152d4 45%,
        #6ea0ff 50%,
        #1152d4 55%,
        currentColor 70%
    );
    background-size: 250% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmerSweep 4s ease-in-out infinite;
}

@keyframes shimmerSweep {
    0%   { background-position: 160% 0; }
    50%  { background-position: -60% 0; }
    100% { background-position: -60% 0; }
}

.brand-mark:hover .brand-name {
    animation-duration: 1.2s;
}

@media (max-width: 768px) {
    .diamond-puzzle { width: 26px; height: 26px; }
    .diamond-puzzle .piece { font-size: 26px; line-height: 26px; }
}

        /* Nav links with sliding underline */
        .nav-link {
            position: relative;
            padding-bottom: 4px;
            color: inherit;
            font-weight: 600;
            letter-spacing: 0.01em;
        }

        .nav-link::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: 0;
            height: 2px;
            width: 0%;
            background: #1152d4;
            border-radius: 999px;
            transition: width 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .nav-link:hover::after,
        .nav-link.active::after {
            width: 100%;
        }

        .nav-link.active {
            color: #1152d4;
        }

        /* Icon buttons */
        .icon-btn {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            border-radius: 999px;
            transition: background-color 0.2s ease, transform 0.15s ease, color 0.2s ease;
        }

        .icon-btn:hover {
            background: rgba(17, 82, 212, 0.1);
            color: #1152d4;
            transform: translateY(-1px);
        }

        .icon-btn:active {
            transform: translateY(0) scale(0.94);
        }

        .cart-badge {
            box-shadow: 0 0 0 2px var(--badge-ring, #f6f6f8);
        }
        .dark .cart-badge {
            --badge-ring: #101622;
        }

        /* Avatar */
        .avatar-btn {
            width: 40px;
            height: 40px;
            border-radius: 999px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, rgba(17, 82, 212, 0.16), rgba(17, 82, 212, 0.04));
            border: 1px solid rgba(17, 82, 212, 0.25);
            transition: border-color 0.2s ease, transform 0.15s ease;
        }
        .avatar-btn:hover {
            border-color: #1152d4;
            transform: translateY(-1px);
        }

        /* Mobile menu */
        .mobile-menu-btn {
            display: none;
        }

        .mobile-nav {
            display: none;
            flex-direction: column;
            gap: 2px;
            padding: 8px 24px 20px;
            border-top: 1px solid rgba(148, 163, 184, 0.15);
        }

        .mobile-nav.open {
            display: flex;
        }

        .mobile-nav a {
            padding: 12px 4px;
            font-weight: 600;
            border-radius: 8px;
        }

        .mobile-nav a:hover {
            background: rgba(17, 82, 212, 0.08);
            color: #1152d4;
        }

        .header-icons .hide-on-mobile {
            display: flex;
        }

        .mobile-nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .mobile-nav-item .material-symbols-outlined {
            font-size: 20px;
            color: #1152d4;
        }

        @media (max-width: 768px) {
            .mobile-menu-btn {
                display: flex;
            }
            .desktop-search {
                display: none;
            }
            .header-icons {
                gap: 4px;
            }
            .header-icons .hide-on-mobile {
                display: none;
            }
            .icon-btn {
                width: 38px;
                height: 38px;
            }
            .brand-mark .material-symbols-outlined {
                font-size: 26px !important;
            }
            .brand-mark .brand-name {
                font-size: 1.125rem;
            }
        }

        @media (max-width: 380px) {
            .brand-mark .brand-name {
                display: none;
            }
        }
    </style>
