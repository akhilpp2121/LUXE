<!DOCTYPE html>
<html class="dark" lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Literata:wght@400;500;700&family=Lexend:wght@400;500;700&family=Inter:wght@400;500;700&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<script id="tailwind-config">tailwind.config = {darkMode: "class", theme: {extend: {colors: {"on-surface": "#e4e1e8", "inverse-primary": "#4c599f", "surface-dim": "#131318", "surface-bright": "#39393e", background: "#131318", "secondary-fixed-dim": "#c1c4e6", "inverse-surface": "#e4e1e8", "on-primary-container": "#7e8bd4", surface: "#131318", "surface-container-low": "#1b1b20", "surface-container-highest": "#343439", "on-error": "#690005", "primary-fixed": "#dee1ff", "on-tertiary-container": "#cc7a59", "secondary-container": "#414561", "primary-container": "#122165", "on-surface-variant": "#c6c5d2", "error-container": "#93000a", "surface-variant": "#343439", "on-secondary-container": "#afb3d4", "tertiary-fixed-dim": "#ffb598", "on-error-container": "#ffdad6", "surface-container-lowest": "#0d0e12", "on-tertiary-fixed": "#370e00", "inverse-on-surface": "#303035", "tertiary-container": "#4c1700", "outline-variant": "#454650", "secondary-fixed": "#dee0ff", error: "#ffb4ab", "primary-fixed-dim": "#bac3ff", "on-secondary-fixed": "#151a33", "on-tertiary": "#571f04", "on-primary-fixed": "#001159", tertiary: "#ffb598", "surface-tint": "#bac3ff", "surface-container-high": "#29292f", "on-secondary-fixed-variant": "#414561", secondary: "#c1c4e6", "on-primary": "#1c2a6d"}, borderRadius: {DEFAULT: "0.125rem", lg: "0.25rem", xl: "0.5rem", full: "0.75rem"}, spacing: {base: "4px", lg: "24px", sm: "12px", xl: "32px", xs: "8px", gutter: "20px", md: "16px", margin: "24px"}, fontFamily: {h1: ["Inter"], "label-sm": ["Inter"], "body-md": ["Lexend"], h3: ["Inter"], "body-sm": ["Inter"], "label-md": ["Inter"], "body-lg": ["Lexend"], h2: ["Inter"], "headline-sm": ["Literata"], "headline-lg": ["Literata"], "headline-md": ["Literata"]}, fontSize: {h1: ["30px", {lineHeight: "38px", letterSpacing: "-0.02em", fontWeight: "700"}], "label-sm": ["11px", {lineHeight: "14px", letterSpacing: "0em", fontWeight: "500"}], "body-md": ["14px", {lineHeight: "20px", letterSpacing: "0em", fontWeight: "400"}], h3: ["20px", {lineHeight: "28px", letterSpacing: "-0.01em", fontWeight: "600"}], "body-sm": ["12px", {lineHeight: "16px", fontWeight: "400"}], "label-md": ["12px", {lineHeight: "16px", letterSpacing: "0.05em", fontWeight: "600"}], "body-lg": ["16px", {lineHeight: "24px", letterSpacing: "0em", fontWeight: "400"}], h2: ["24px", {lineHeight: "32px", letterSpacing: "-0.01em", fontWeight: "600"}], "headline-sm": ["20px", {lineHeight: "28px", letterSpacing: "0em", fontWeight: "500"}], "headline-lg": ["30px", {lineHeight: "38px", letterSpacing: "-0.01em", fontWeight: "600"}], "headline-md": ["24px", {lineHeight: "32px", letterSpacing: "0em", fontWeight: "600"}]}}}};</script>
<style>
  body { font-family: 'Inter', sans-serif; }
  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }

  /* Modal backdrop animation */
  #status-confirm-modal {
    animation: fadeIn 0.15s ease;
  }
  #status-confirm-modal .modal-card {
    animation: slideUp 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes slideUp {
    from { transform: translateY(12px) scale(0.97); opacity: 0; }
    to   { transform: translateY(0)    scale(1);    opacity: 1; }
  }
</style>
</head>
<body class="bg-gray-950 text-white">

<!-- ───────────────────────────── Sidebar ───────────────────────────── -->
<aside class="fixed flex flex-col h-full py-4 bg-gray-950 h-screen w-64 left-0 border-r border-gray-800 z-50">

  <div class="px-6 mb-8 flex items-center gap-3">
    <div class="w-8 h-8 bg-gradient-to-br from-yellow-400 to-yellow-600 rounded flex items-center justify-center text-white font-black text-sm shadow-md">
      L
    </div>
    <div>
      <h2 class="text-lg font-black text-on-surface leading-tight">System Admin</h2>
      <p class="text-[10px] text-on-surface-variant uppercase tracking-widest font-bold">LUXE</p>
    </div>
  </div>

  <nav class="flex flex-col gap-2 px-4">
    <a href="/admin/dashboard" class="text-white bg-gray-900 border border-purple-500/30 shadow-lg shadow-purple-500/10 px-4 py-3 rounded-xl flex items-center gap-4 font-bold">
      <span class="material-symbols-outlined text-lg opacity-70">dashboard</span>
      <span>Dashboard</span>
    </a>
    <a href="/admin/orders" class="text-white bg-gray-900 border border-purple-500/30 shadow-lg shadow-purple-500/10 px-4 py-3 rounded-xl flex items-center gap-4 font-bold">
      <span class="material-symbols-outlined text-lg opacity-70">shopping_cart</span>
      <span>Orders</span>
    </a>
    <a href="/admin/products" class="text-white bg-gray-900 border border-purple-500/30 shadow-lg shadow-purple-500/10 px-4 py-3 rounded-xl flex items-center gap-4 font-bold">
      <span class="material-symbols-outlined text-lg opacity-70">inventory_2</span>
      <span>Products</span>
    </a>
    <!-- Active: Categories -->
    <a href="/admin/category" class="text-white bg-purple-600/20 border border-purple-500 shadow-lg shadow-purple-500/20 px-4 py-3 rounded-xl flex items-center gap-4 font-bold">
      <span class="material-symbols-outlined text-lg text-primary">category</span>
      <span>Categories</span>
    </a>
    <a href="/admin/users" class="text-white bg-gray-900 border border-purple-500/30 shadow-lg shadow-purple-500/10 px-4 py-3 rounded-xl flex items-center gap-4 font-bold">
      <span class="material-symbols-outlined text-lg opacity-70">group</span>
      <span>Users</span>
    </a>
    <a href="/admin/analytics" class="text-white bg-gray-900 border border-purple-500/30 shadow-lg shadow-purple-500/10 px-4 py-3 rounded-xl flex items-center gap-4 font-bold">
      <span class="material-symbols-outlined text-lg opacity-70">analytics</span>
      <span>Analytics</span>
    </a>
    <a href="/admin/coupons" class="text-white bg-gray-900 border border-purple-500/30 shadow-lg shadow-purple-500/10 px-4 py-3 rounded-xl flex items-center gap-4 font-bold">
      <span class="material-symbols-outlined text-lg opacity-70">image</span>
      <span>coupons</span>
    </a>
  </nav>

</aside>

<!-- ───────────────────────────── Main ───────────────────────────── -->
<main class="ml-64 min-h-screen bg-gray-950">

  <!-- TopNav -->
  <header class="flex items-center justify-between px-6 h-16 w-full bg-surface-container-low border-b border-outline-variant sticky top-0 z-40 font-['Inter'] antialiased">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined bg-gradient-to-r from-purple-600 to-indigo-600 text-transparent bg-clip-text"
            style="font-variation-settings: 'FILL' 1;">
        add_circle
      </span>
      <h1 class="text-xl font-bold tracking-tight bg-gradient-to-r from-purple-600 to-indigo-600 text-transparent bg-clip-text">
        AdminConsole
      </h1>
    </div>
    <div class="flex items-center gap-6">
      <div class="flex items-center gap-1">
        <button class="p-2 text-on-surface-variant hover:bg-surface-container-highest transition-colors cursor-pointer rounded"></button>
        <button class="p-2 text-on-surface-variant hover:bg-surface-container-highest transition-colors cursor-pointer rounded"></button>
        <button class="p-2 text-on-surface-variant hover:bg-surface-container-highest transition-colors cursor-pointer rounded"></button>
      </div>
    </div>
  </header>
  
  <!-- Page Canvas -->
  <div class="p-lg md:p-xl max-w-5xl mx-auto">

    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-body-sm text-on-secondary-container mb-md">
      <span class="material-symbols-outlined text-sm">chevron_right</span>
      <a href="/admin/category" class="hover:text-primary transition-colors">Categories</a>
      <span class="material-symbols-outlined text-sm">chevron_right</span>
      <span class="font-semibold text-on-surface">Edit Category</span>
    </nav>

    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-xl gap-md">
      <div>
        <h2 class="font-h1 text-h1 text-on-surface mb-xs">Edit Category</h2>
        <p class="font-body-md text-body-md text-on-surface-variant">
          Update the product classification details.
        </p>
      </div>
      <div class="flex gap-sm">
        <button type="button" onclick="window.location.href='/admin/category'"
          class="px-md h-10 border border-gray-700 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-all">
          Cancel
        </button>
        <button type="submit" form="editCategoryForm"
          class="px-6 h-10 bg-gradient-to-r from-purple-600 to-indigo-600 text-white 
          font-semibold rounded-lg flex items-center gap-2 shadow-lg shadow-purple-500/30 
          hover:shadow-xl hover:scale-[1.03] active:scale-[0.97] transition-all duration-200">
          <span class="material-symbols-outlined text-[20px]">save</span>
          <span class="tracking-wide">Update Category</span>
        </button>
      </div>
    </div>

    <!-- Form -->
    <form id="editCategoryForm">
      <div class="grid grid-cols-12 gap-6">

        <!-- Left Column -->
        <div class="col-span-12 lg:col-span-8 space-y-6">
          <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-6 flex items-center gap-2">
              <span class="material-symbols-outlined text-purple-500">info</span>
              Category Details
            </h3>

            <div class="space-y-6">

              <!-- Category Name -->
              <div>
                <label class="block text-sm font-medium text-gray-300 mb-2">
                  Category Name <span class="text-red-500">*</span>
                </label>
                <input
                  id="category_name"
                  name="category_name"
                  type="text"
                  value="<%= name %>"
                  placeholder="Enter category name"
                  class="w-full px-4 py-3 rounded-lg bg-gray-950 border border-gray-700
                  text-white placeholder-gray-400 focus:border-purple-500 
                  focus:ring-2 focus:ring-purple-500/20 outline-none transition-all"
                />
                <p id="nameError" class="text-xs text-red-500 mt-1 hidden"></p>
                <p class="text-xs text-gray-500 mt-1 italic">
                  This name will be visible to customers.
                </p>
              </div>

              <!-- Description -->
              <div>
                <label class="block text-sm font-medium text-gray-300 mb-2">
                  Description <span class="text-red-500">*</span>
                </label>
                <textarea
                  id="description"
                  name="description"
                  rows="5"
                  placeholder="Enter description..."
                  class="w-full px-4 py-3 rounded-lg bg-gray-950 border border-gray-700
                  text-white placeholder-gray-400 focus:border-purple-500 
                  focus:ring-2 focus:ring-purple-500/20 outline-none transition-all resize-none"
                ><%= description %></textarea>
                <p id="descError" class="text-xs text-red-500 mt-1 hidden"></p>
              </div>

            </div>
          </div>
        </div>

        <!-- Right Column -->
        <div class="col-span-12 lg:col-span-4 space-y-6">
          <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
            <h3 class="text-xs text-gray-400 mb-4 uppercase tracking-wider">Settings</h3>

            <div>
              <label class="block text-sm font-medium text-gray-300 mb-3">
                Category Status
              </label>
              <div class="flex flex-col gap-3">

                <!-- Active -->
                <label class="flex items-center gap-3 p-3 border border-gray-700 rounded-lg 
                cursor-pointer hover:bg-gray-800 transition-all 
                has-[:checked]:border-purple-500 has-[:checked]:bg-purple-500/10">
                  <input
                    name="status" type="radio" value="active"
                    <%= status === true ? 'checked' : '' %>
                    class="w-4 h-4 accent-purple-500"
                    onchange="requestStatusChange(this)"
                  />
                  <div>
                    <span class="font-medium text-white">Active</span>
                    <p class="text-xs text-gray-400">Visible and available for products</p>
                  </div>
                </label>

                <!-- Inactive -->
                <label class="flex items-center gap-3 p-3 border border-gray-700 rounded-lg 
                cursor-pointer hover:bg-gray-800 transition-all 
                has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-500/10">
                  <input
                    name="status" type="radio" value="inactive"
                    <%= status === false ? 'checked' : '' %>
                    class="w-4 h-4 accent-indigo-500"
                    onchange="requestStatusChange(this)"
                  />
                  <div>
                    <span class="font-medium text-white">Inactive</span>
                    <p class="text-xs text-gray-400">Hidden from storefront</p>
                  </div>
                </label>

              </div>

              <!-- Current status indicator -->
              <div id="status-indicator" class="mt-3 flex items-center gap-2">
                <span id="status-dot" class="w-2 h-2 rounded-full bg-green-500 inline-block"></span>
                <span class="text-xs text-gray-400">Currently: <span id="status-label" class="text-gray-200 font-medium">Active</span></span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </form>

  </div>
</main>

<!-- ───────────────── Status Confirmation Modal ───────────────── -->
<div
  id="status-confirm-modal"
  class="hidden fixed inset-0 z-[9998] flex items-center justify-center"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-heading"
>
  <!-- Backdrop -->
  <div
    class="absolute inset-0 bg-black/60 backdrop-blur-sm"
    onclick="cancelStatusChange()"
  ></div>

  <!-- Card -->
  <div class="modal-card relative z-10 w-[340px] bg-gray-900 border border-gray-700 rounded-2xl shadow-2xl shadow-black/60 p-6">

    <!-- Icon + Title -->
    <div class="flex items-start gap-3 mb-3">
      <div class="w-9 h-9 rounded-lg bg-amber-500/15 border border-amber-500/30 flex items-center justify-center flex-shrink-0">
        <span class="material-symbols-outlined text-amber-400 text-[20px]"
              style="font-variation-settings: 'FILL' 1;">warning</span>
      </div>
      <div>
        <h3 id="modal-heading" class="text-base font-semibold text-white leading-snug">Confirm status change</h3>
        <p id="modal-new-status" class="text-xs text-gray-400 mt-0.5"></p>
      </div>
    </div>

    <!-- Body -->
    <p id="modal-body" class="text-sm text-gray-400 leading-relaxed mb-5 pl-12"></p>

    <!-- Divider -->
    <div class="border-t border-gray-800 mb-4"></div>

    <!-- Actions -->
    <div class="flex gap-3 justify-end">
      <button
        onclick="cancelStatusChange()"
        class="px-4 h-9 text-sm font-medium border border-gray-700 bg-gray-800 text-gray-300 
        rounded-lg hover:bg-gray-700 hover:text-white transition-all"
      >
        Keep current
      </button>
      <button
        id="modal-confirm-btn"
        onclick="confirmStatusChange()"
        class="px-4 h-9 text-sm font-semibold rounded-lg transition-all"
      >
        Confirm
      </button>
    </div>
  </div>
</div>

<!-- ───────────────── Toast Notification ───────────────── -->
<div id="toast" class="fixed top-6 right-6 z-[9999] hidden items-center gap-3 px-5 py-4 rounded-xl shadow-2xl border text-sm font-semibold transition-all duration-300">
  <span id="toastIcon" class="material-symbols-outlined text-[20px]"></span>
  <span id="toastMsg"></span>
</div>

<!-- ───────────────────────────── Scripts ───────────────────────────── -->
<script>
  /* ── Status confirmation logic ── */
  let _confirmedStatus = document.querySelector('input[name="status"]:checked')?.value || 'active';
  let _pendingStatus   = null;

  const statusConfig = {
  active: {
    label: 'Active',
    subtitle: 'Set category to Active',
    body: 'This will make the category visible to customers.',
    dotColor: 'bg-green-500',
    btnClass: 'bg-gradient-to-r from-purple-600 to-indigo-600 text-white',
  },
  inactive: {
    label: 'Inactive',
    subtitle: 'Set category to Inactive',
    body: 'This will hide the category from customers.',
    dotColor: 'bg-gray-500',
    btnClass: 'bg-red-600 text-white',
  },
};

  function syncStatusIndicator(value) {
    const cfg = statusConfig[value];
    document.getElementById('status-dot').className   = `w-2 h-2 rounded-full inline-block ${cfg.dotColor}`;
    document.getElementById('status-label').textContent = cfg.label;
  }

  // Initialise indicator on load
  syncStatusIndicator(_confirmedStatus);

  function requestStatusChange(input) {
    const newVal = input.value;
    if (newVal === _confirmedStatus) return;

    _pendingStatus = newVal;

    const cfg = statusConfig[newVal];

    document.getElementById('modal-new-status').textContent = cfg.subtitle;
    document.getElementById('modal-body').textContent       = cfg.body;

    const confirmBtn = document.getElementById('modal-confirm-btn');
    confirmBtn.className = `px-4 h-9 text-sm font-semibold rounded-lg transition-all ${cfg.btnClass}`;
    confirmBtn.textContent = `Set ${cfg.label}`;

    document.getElementById('status-confirm-modal').classList.remove('hidden');
    document.getElementById('status-confirm-modal').classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function confirmStatusChange() {
    _confirmedStatus = _pendingStatus;
    _pendingStatus   = null;
    closeModal();
    syncStatusIndicator(_confirmedStatus);
    // Ensure the correct radio stays checked (edge case guard)
    document.querySelectorAll('input[name="status"]').forEach(r => {
      r.checked = r.value === _confirmedStatus;
    });
  }

  function cancelStatusChange() {
    // Revert radio to last confirmed value
    document.querySelectorAll('input[name="status"]').forEach(r => {
      r.checked = r.value === _confirmedStatus;
    });
    _pendingStatus = null;
    closeModal();
  }

  function closeModal() {
    document.getElementById('status-confirm-modal').classList.add('hidden');
    document.getElementById('status-confirm-modal').classList.remove('flex');
    document.body.style.overflow = '';
  }

  // Close on Escape key
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') cancelStatusChange();
  });


  /* ── Toast ── */
  function showToast(message, type = "success") {
    const toast     = document.getElementById("toast");
    const toastMsg  = document.getElementById("toastMsg");
    const toastIcon = document.getElementById("toastIcon");

    toastMsg.innerText = message;

    if (type === "success") {
      toast.className = "fixed top-6 right-6 z-[9999] flex items-center gap-3 px-5 py-4 rounded-xl shadow-2xl border text-sm font-semibold bg-green-900/90 border-green-500/50 text-green-300";
      toastIcon.innerText = "check_circle";
    } else {
      toast.className = "fixed top-6 right-6 z-[9999] flex items-center gap-3 px-5 py-4 rounded-xl shadow-2xl border text-sm font-semibold bg-red-900/90 border-red-500/50 text-red-300";
      toastIcon.innerText = "error";
    }

    setTimeout(() => {
      toast.classList.add("hidden");
    }, 3000);
  }


  /* ── Form submission ── */
  const form = document.getElementById("editCategoryForm");

  form.addEventListener("submit", async function (e) {
    e.preventDefault();

    const nameEl  = document.getElementById("category_name");
    const descEl  = document.getElementById("description");
    const nameErr = document.getElementById("nameError");
    const descErr = document.getElementById("descError");

    // Reset errors
    nameErr.classList.add("hidden");
    descErr.classList.add("hidden");
    nameEl.classList.remove("border-red-500");
    descEl.classList.remove("border-red-500");

    let isValid = true;

    if (nameEl.value.trim() === "") {
      nameErr.innerText = "Category name is required";
      nameErr.classList.remove("hidden");
      nameEl.classList.add("border-red-500");
      isValid = false;
    } else if (nameEl.value.trim().length < 3) {
      nameErr.innerText = "Minimum 3 characters required";
      nameErr.classList.remove("hidden");
      nameEl.classList.add("border-red-500");
      isValid = false;
    }

    if (descEl.value.trim() === "") {
      descErr.innerText = "Description is required";
      descErr.classList.remove("hidden");
      descEl.classList.add("border-red-500");
      isValid = false;
    }

    if (!isValid) return;

    const formData = new FormData(form);

    const res = await fetch("/admin/editCategory/<%= id %>", {
      method: "POST",
      body: new URLSearchParams(formData),
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
    });

    const data = await res.json();

    if (data.success) {
      showToast("Category updated successfully!", "success");
      setTimeout(() => {
        window.location.href = data.redirect;
      }, 1500);
    } else {
      showToast(data.message, "error");
      nameErr.innerText = data.message;
      nameErr.classList.remove("hidden");
      nameEl.classList.add("border-red-500");
    }
  });
</script>

</body>
</html>