<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>LUXE — New Arrivals</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            primary: "#1152d4",
            "background-light": "#f6f6f8",
            "background-dark":  "#101622",
          },
          fontFamily: { display: ["Manrope", "sans-serif"] },
          borderRadius: { DEFAULT: "0.25rem", lg: "0.5rem", xl: "0.75rem", full: "9999px" },
        },
      },
    };
  </script>
  <style>
    body { font-family: 'Manrope', sans-serif; }
    .material-symbols-outlined { font-variation-settings: 'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24; }

    aside {
      max-height: calc(100vh - 88px);
      overflow-y: auto;
      position: sticky;
      top: 88px;
    }
    aside::-webkit-scrollbar { width: 4px; }
    aside::-webkit-scrollbar-thumb { background: #334155; border-radius: 99px; }

    .search-clear {
      display: flex; align-items: center; gap: 3px;
      transition: opacity 0.15s, color 0.15s;
    }
    .search-clear.hidden-clear { opacity: 0; pointer-events: none; }

    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    /* Wishlist heart button */
    .wish-btn {
      position: absolute;
      top: 12px; right: 12px;
      z-index: 10;
      width: 36px; height: 36px;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      background: rgba(255,255,255,0.85);
      backdrop-filter: blur(4px);
      border: none;
      cursor: pointer;
      transition: transform 0.2s, background 0.2s;
      box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }
    .dark .wish-btn { background: rgba(15,23,42,0.85); }
    .wish-btn:hover { transform: scale(1.12); }
    .wish-btn .material-symbols-outlined { font-size: 20px; transition: color 0.2s; }
    .wish-btn.wishlisted .material-symbols-outlined { color: #ef4444; font-variation-settings: 'FILL' 1,'wght' 400,'GRAD' 0,'opsz' 24; }
    .wish-btn:not(.wishlisted) .material-symbols-outlined { color: #64748b; }
    .dark .wish-btn:not(.wishlisted) .material-symbols-outlined { color: #94a3b8; }

    /* Card image zoom */
    .card-img { overflow: hidden; }
    .card-img img { transition: transform 0.5s cubic-bezier(0.25,0.46,0.45,0.94); }
    .group:hover .card-img img { transform: scale(1.08); }

    /* Add to cart hover bar */
    .cart-bar {
      position: absolute; inset-x: 0; bottom: 0;
      padding: 10px;
      transform: translateY(100%);
      transition: transform 0.28s ease;
    }
    .group:hover .cart-bar { transform: translateY(0); }
  </style>
</head>

<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 font-display">
<div class="relative flex min-h-screen w-full flex-col overflow-x-hidden">

  <!-- ═══════════ HEADER ═══════════ -->
  <header class="sticky top-0 z-50 w-full border-b border-slate-200 dark:border-slate-800
                 bg-background-light/80 dark:bg-background-dark/80 backdrop-blur-md px-6 lg:px-20 py-4">
    <div class="max-w-[1440px] mx-auto flex items-center justify-between gap-8">

      <div class="flex items-center gap-8 flex-1">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 text-primary shrink-0">
          <span class="material-symbols-outlined text-4xl font-bold">diamond</span>
          <h2 class="text-2xl font-extrabold tracking-tighter text-slate-900 dark:text-white uppercase">LUXE</h2>
        </a>

        <%
          const qs = {
            search:   searchValue   || '',
            sort:     sortValue     || '',
            category: categoryValue || '',
            minPrice: minPrice      || '',
            maxPrice: maxPrice      || '',
          };
          function buildQS(overrides) {
            const merged = Object.assign({}, qs, overrides);
            return Object.entries(merged)
              .filter(([, v]) => v !== '' && v !== null && v !== undefined)
              .map(([k, v]) => k + '=' + encodeURIComponent(v))
              .join('&');
          }
        %>

        <!-- Desktop Search -->
        <form method="GET" action="" class="hidden md:flex flex-1 max-w-md">
          <% if (sortValue)     { %><input type="hidden" name="sort"     value="<%= sortValue %>"/><% } %>
          <% if (categoryValue) { %><input type="hidden" name="category" value="<%= categoryValue %>"/><% } %>
          <% if (minPrice)      { %><input type="hidden" name="minPrice" value="<%= minPrice %>"/><% } %>
          <% if (maxPrice)      { %><input type="hidden" name="maxPrice" value="<%= maxPrice %>"/><% } %>

          <div class="relative w-full">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
            <input
              name="search" type="text" id="srch-desk"
              value="<%= searchValue %>"
              placeholder="Search by name or description…"
              autocomplete="off"
              oninput="toggleClear('clr-desk', this.value)"
              class="w-full bg-slate-100 dark:bg-slate-800 border-none rounded-lg py-2.5
                     pl-10 pr-32 text-sm outline-none focus:ring-2 focus:ring-primary transition-all"
            />
            <button type="button" id="clr-desk"
              onclick="clearSearch('srch-desk','clr-desk')"
              class="search-clear absolute right-[72px] top-1/2 -translate-y-1/2
                     text-slate-400 hover:text-red-400 text-xs font-semibold
                     <%= searchValue ? '' : 'hidden-clear' %>">
              <span class="material-symbols-outlined" style="font-size:15px">search_off</span>Clear
            </button>
            <button type="submit"
              class="absolute right-1 top-1/2 -translate-y-1/2 px-3 py-1.5 bg-primary text-white
                     text-xs font-bold rounded-md hover:brightness-110 transition-all">Go</button>
          </div>
        </form>
      </div>

      <!-- Nav -->
      <nav class="hidden xl:flex items-center gap-8">
        <a class="text-sm font-semibold hover:text-primary transition-colors" href="#">Collections</a>
        <a class="text-sm font-semibold hover:text-primary transition-colors" href="#">New Arrivals</a>
        <a class="text-sm font-semibold hover:text-primary transition-colors" href="#">About</a>
      </nav>

      <!-- Actions -->
      <div class="flex items-center gap-3">
        <a href="/profile"
           class="hidden sm:flex items-center gap-2 px-4 py-2 bg-slate-100 dark:bg-slate-800
                  rounded-lg text-sm font-bold hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
          <span class="material-symbols-outlined text-base">person</span>Account
        </a>
        <a href="/wishlist"
           class="p-2 bg-slate-100 dark:bg-slate-800 rounded-lg hover:text-primary transition-colors">
          <span class="material-symbols-outlined">favorite</span>
        </a>
        <a href="/cart" class="relative p-2 text-slate-400 hover:text-white hover:bg-slate-800 rounded-lg transition-all">
          <span class="material-symbols-outlined">shopping_cart</span>
          <% if (cartCount > 0) { %>
            <span class="absolute -top-1 -right-1 w-5 h-5 bg-primary text-white text-xs font-bold rounded-full flex items-center justify-center">
              <%= cartCount %>
            </span>
          <% } %>
        </a>
      </div>
    </div>
  </header>

  <!-- ═══════════ MAIN ═══════════ -->
  <main class="flex-1 w-full max-w-[1440px] mx-auto px-6 lg:px-20 py-10 flex gap-10">

    <!-- ══ SIDEBAR ══ -->
    <aside class="hidden lg:flex flex-col w-60 shrink-0 gap-7 pb-10">

      <% const hasFilter = searchValue || categoryValue || minPrice || maxPrice; %>
      <% if (hasFilter) { %>
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-bold uppercase tracking-widest text-slate-500">Active Filters</span>
            <a href="?" class="text-xs text-red-500 font-bold hover:underline">Clear all</a>
          </div>
          <div class="flex flex-wrap gap-2">
            <% if (searchValue) { %>
              <a href="?<%= buildQS({ search: '' }) %>"
                 class="flex items-center gap-1 px-2 py-1 bg-primary/10 text-primary text-xs font-bold rounded-full">
                "<%= searchValue %>"
                <span class="material-symbols-outlined text-sm leading-none">close</span>
              </a>
            <% } %>
            <% if (categoryValue) { %>
              <% const activeCat = categories.find(c => c._id.toString() === categoryValue); %>
              <a href="?<%= buildQS({ category: '' }) %>"
                 class="flex items-center gap-1 px-2 py-1 bg-primary/10 text-primary text-xs font-bold rounded-full capitalize">
                <%= activeCat ? (activeCat.categoryName || activeCat.name) : 'Category' %>
                <span class="material-symbols-outlined text-sm leading-none">close</span>
              </a>
            <% } %>
            <% if (minPrice || maxPrice) { %>
              <a href="?<%= buildQS({ minPrice: '', maxPrice: '' }) %>"
                 class="flex items-center gap-1 px-2 py-1 bg-primary/10 text-primary text-xs font-bold rounded-full">
                ₹<%= minPrice || '0' %> – ₹<%= maxPrice || '∞' %>
                <span class="material-symbols-outlined text-sm leading-none">close</span>
              </a>
            <% } %>
          </div>
        </div>
      <% } %>

      <!-- Category -->
      <div>
        <h3 class="text-base font-bold mb-3 flex items-center gap-2">
          <span class="material-symbols-outlined text-primary text-lg">category</span>Category
        </h3>
        <div class="flex flex-col gap-0.5">
          <a href="?<%= buildQS({ category: '', page: '' }) %>"
             class="flex items-center justify-between px-3 py-2 rounded-lg transition-colors
                    <%= !categoryValue ? 'bg-primary/10 text-primary font-bold' : 'hover:bg-slate-100 dark:hover:bg-slate-800' %>">
            <span class="text-sm">All</span>
            <% if (!categoryValue) { %><span class="material-symbols-outlined text-base text-primary">check</span><% } %>
          </a>
          <% categories.forEach(function(cat) { %>
            <%
              const isActive = categoryValue === cat._id.toString();
              const catLink  = '?' + buildQS({ category: cat._id.toString(), page: '' });
            %>
            <a href="<%= catLink %>"
               class="flex items-center justify-between px-3 py-2 rounded-lg transition-colors capitalize
                      <%= isActive ? 'bg-primary/10 text-primary font-bold' : 'hover:bg-slate-100 dark:hover:bg-slate-800' %>">
              <span class="text-sm"><%= cat.categoryName || cat.name %></span>
              <% if (isActive) { %><span class="material-symbols-outlined text-base text-primary">check</span><% } %>
            </a>
          <% }) %>
        </div>
      </div>

      <!-- Price -->
      <%
        const priceRanges = [
          { label: 'All Prices',       min: '',     max: ''     },
          { label: 'Under ₹500',       min: '0',    max: '500'  },
          { label: '₹500 – ₹1,000',    min: '500',  max: '1000' },
          { label: '₹1,000 – ₹2,000',  min: '1000', max: '2000' },
          { label: '₹2,000 – ₹5,000',  min: '2000', max: '5000' },
          { label: 'Above ₹5,000',     min: '5000', max: ''     },
        ];
      %>
      <div class="border-t border-slate-200 dark:border-slate-800 pt-6">
        <h3 class="text-base font-bold mb-3">Price Range</h3>
        <div class="flex flex-col gap-0.5">
          <% priceRanges.forEach(function(r) { %>
            <%
              const isPriceActive = minPrice === r.min && maxPrice === r.max;
              const priceLink = '?' + buildQS({ minPrice: r.min, maxPrice: r.max, page: '' });
            %>
            <a href="<%= priceLink %>"
               class="flex items-center justify-between px-3 py-2 rounded-lg transition-colors
                      <%= isPriceActive ? 'bg-primary/10 text-primary font-bold' : 'hover:bg-slate-100 dark:hover:bg-slate-800' %>">
              <span class="text-sm"><%= r.label %></span>
              <% if (isPriceActive) { %><span class="material-symbols-outlined text-base text-primary">check</span><% } %>
            </a>
          <% }) %>
        </div>
      </div>

    </aside>

    <!-- ══ PRODUCT AREA ══ -->
    <div class="flex-1 min-w-0">

      <!-- Toolbar -->
      <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
        <div>
          <h1 class="text-2xl font-extrabold">
            <% if (searchValue) { %>Results for "<%= searchValue %>"
            <% } else { %>New Arrivals<% } %>
          </h1>
          <p class="text-slate-500 text-sm mt-0.5">
            <% if (totalProducts === 0) { %>No products found
            <% } else { %>
              Showing
              <%= (currentPage - 1) * productsPerPage + 1 %>–<%= Math.min(currentPage * productsPerPage, totalProducts) %>
              of <%= totalProducts %> products
            <% } %>
          </p>
        </div>

        <!-- Sort -->
        <form method="GET" action="" class="flex items-center gap-2">
          <input type="hidden" name="search"   value="<%= searchValue %>"/>
          <input type="hidden" name="category" value="<%= categoryValue %>"/>
          <input type="hidden" name="minPrice" value="<%= minPrice %>"/>
          <input type="hidden" name="maxPrice" value="<%= maxPrice %>"/>
          <input type="hidden" name="page"     value="1"/>
          <label class="text-sm text-slate-500 font-medium hidden sm:block">Sort</label>
          <select name="sort" onchange="this.form.submit()"
                  class="bg-slate-100 dark:bg-slate-800 border-none rounded-lg text-sm font-bold
                         py-2.5 px-4 focus:ring-2 focus:ring-primary outline-none cursor-pointer">
            <option value="">Sort By</option>
            <option value="lowToHigh" <%= sortValue === 'lowToHigh' ? 'selected' : '' %>>Price: Low to High</option>
            <option value="highToLow" <%= sortValue === 'highToLow' ? 'selected' : '' %>>Price: High to Low</option>
            <option value="az"        <%= sortValue === 'az'        ? 'selected' : '' %>>A – Z</option>
            <option value="za"        <%= sortValue === 'za'        ? 'selected' : '' %>>Z – A</option>
          </select>
        </form>
      </div>

      <!-- Mobile search -->
      <form method="GET" action="" class="flex md:hidden mb-6">
        <% if (sortValue)     { %><input type="hidden" name="sort"     value="<%= sortValue %>"/><% } %>
        <% if (categoryValue) { %><input type="hidden" name="category" value="<%= categoryValue %>"/><% } %>
        <% if (minPrice)      { %><input type="hidden" name="minPrice" value="<%= minPrice %>"/><% } %>
        <% if (maxPrice)      { %><input type="hidden" name="maxPrice" value="<%= maxPrice %>"/><% } %>
        <div class="relative w-full">
          <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
          <input name="search" type="text" id="srch-mob"
                 value="<%= searchValue %>" placeholder="Search…"
                 oninput="toggleClear('clr-mob', this.value)"
                 class="w-full bg-slate-100 dark:bg-slate-800 border-none rounded-lg py-2.5 pl-10 pr-32 text-sm
                        outline-none focus:ring-2 focus:ring-primary transition-all"/>
          <button type="button" id="clr-mob"
            onclick="clearSearch('srch-mob','clr-mob')"
            class="search-clear absolute right-[72px] top-1/2 -translate-y-1/2
                   text-slate-400 hover:text-red-400 text-xs font-semibold
                   <%= searchValue ? '' : 'hidden-clear' %>">
            <span class="material-symbols-outlined" style="font-size:15px">search_off</span>Clear
          </button>
          <button type="submit"
                  class="absolute right-1 top-1/2 -translate-y-1/2 px-3 py-1.5 bg-primary text-white
                         text-xs font-bold rounded-md hover:brightness-110 transition-all">Go</button>
        </div>
      </form>

      <!-- Mobile category pills -->
      <div class="flex lg:hidden gap-2 overflow-x-auto pb-2 mb-6 no-scrollbar">
        <a href="?<%= buildQS({ category: '', page: '' }) %>"
           class="shrink-0 px-3 py-1.5 rounded-full text-xs font-bold border transition-colors
                  <%= !categoryValue ? 'bg-primary text-white border-primary' : 'border-slate-300 dark:border-slate-700 hover:border-primary hover:text-primary' %>">
          All
        </a>
        <% categories.forEach(function(cat) { %>
          <a href="?<%= buildQS({ category: cat._id.toString(), page: '' }) %>"
             class="shrink-0 px-3 py-1.5 rounded-full text-xs font-bold border capitalize transition-colors
                    <%= categoryValue === cat._id.toString() ? 'bg-primary text-white border-primary' : 'border-slate-300 dark:border-slate-700 hover:border-primary hover:text-primary' %>">
            <%= cat.categoryName || cat.name %>
          </a>
        <% }) %>
      </div>

      <!-- Error banner -->
      <% if (error) { %>
        <div class="mb-6 px-4 py-3 rounded-lg bg-red-50 dark:bg-red-900/20 border border-red-200
                    dark:border-red-800 text-red-600 dark:text-red-400 text-sm font-medium flex gap-2 items-center">
          <span class="material-symbols-outlined text-base">error</span><%= error %>
        </div>
      <% } %>

      <!-- ══ PRODUCT GRID ══ -->
      <% if (product && product.length > 0) { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-x-6 gap-y-10">

          <% product.forEach(function(p) { %>
            <%
              /* p is already a variant document */
              const isWishlisted = Array.isArray(wishlistedIds) && wishlistedIds.includes(p._id.toString());
              const ep  = (p.discount && p.discount < p.price) ? p.discount : p.price;
              const fmt = (n) => Number(n).toLocaleString('en-IN');
              const savePct = (p.discount && p.discount < p.price)
                ? Math.round((p.price - p.discount) / p.price * 100) : 0;
            %>

            <div class="group flex flex-col gap-3">

              <!-- Image box -->
              <div class="relative aspect-[3/4] rounded-xl bg-slate-100 dark:bg-slate-800 card-img">

                <% if (p.images && p.images.length > 0) { %>
                  <a href="/product-details/<%= p.productId._id %>?size=<%= p.size %>&color=<%= p.color %>">
                    <img
                      src="/uploads/<%= p.images[0] %>"
                      alt="<%= p.productId ? p.productId.name : 'Product' %>"
                      class="h-full w-full object-cover rounded-xl"
                      onerror="this.src='https://placehold.co/400x533/1e293b/64748b?text=No+Image'"
                    />
                  </a>
                <% } else { %>
                  <div class="h-full w-full flex flex-col items-center justify-center text-slate-400 gap-2 rounded-xl">
                    <span class="material-symbols-outlined text-5xl">image_not_supported</span>
                    <span class="text-xs">No image</span>
                  </div>
                <% } %>

                <!-- Discount badge -->
                <% if (savePct) { %>
                  <span class="absolute top-3 left-3 z-10 bg-green-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full">
                    <%= savePct %>% OFF
                  </span>
                <% } %>

                <!-- ✅ Wishlist heart button -->
                <button
                  type="button"
                  onclick="toggleWishlist('<%= p._id %>', this)"
                  class="wish-btn <%= isWishlisted ? 'wishlisted' : '' %>"
                  title="<%= isWishlisted ? 'Remove from wishlist' : 'Add to wishlist' %>"
                >
                  <span class="material-symbols-outlined">favorite</span>
                </button>

                <!-- Add to cart hover bar -->
                <div class="cart-bar">
                  <button
                    onclick="addToCart('<%= p._id %>')"
                    class="w-full py-2 px-3 rounded-lg font-medium text-xs bg-black text-white
                           hover:bg-gray-800 flex items-center justify-center gap-1"
                  >
                    <span class="material-symbols-outlined" style="font-size:14px">shopping_bag</span>
                    Add to Cart
                  </button>
                </div>

              </div><!-- /image box -->

              <!-- Info -->
              <div>
                <h3 class="text-base font-bold leading-snug">
                  <%= p.productId ? p.productId.name : 'Unknown Product' %>
                </h3>
                <p class="text-slate-500 text-xs mt-0.5 capitalize flex items-center gap-2 flex-wrap">
                  <% if (p.size) { %>
                    <span class="flex items-center gap-0.5">
                      <span class="material-symbols-outlined text-xs">straighten</span><%= p.size %>
                    </span>
                  <% } %>
                  <% if (p.color) { %>
                    <span class="flex items-center gap-0.5">
                      <span class="material-symbols-outlined text-xs">palette</span><%= p.color %>
                    </span>
                  <% } %>
                </p>
                <div class="mt-2 flex items-center gap-2 flex-wrap">
                  <span class="text-lg font-extrabold text-primary">₹<%= fmt(ep) %></span>
                  <% if (savePct) { %>
                    <span class="text-sm line-through text-slate-400">₹<%= fmt(p.price) %></span>
                    <span class="text-[10px] font-bold text-green-600 bg-green-50
                                 dark:bg-green-900/20 px-2 py-0.5 rounded-full">
                      <%= savePct %>% OFF
                    </span>
                  <% } %>
                </div>
              </div>

            </div>
          <% }) %>

        </div>

      <% } else { %>
        <div class="flex flex-col items-center justify-center py-28 text-center">
          <span class="material-symbols-outlined text-7xl text-slate-300 dark:text-slate-700 mb-4">search_off</span>
          <h3 class="text-xl font-bold text-slate-600 dark:text-slate-400">No products found</h3>
          <p class="text-slate-400 mt-2 text-sm max-w-xs">
            Try a different search term, change the sort order, or clear your filters.
          </p>
          <a href="?"
             class="mt-6 px-6 py-2.5 bg-primary text-white text-sm font-bold rounded-lg
                    hover:brightness-110 transition-all inline-flex items-center gap-2">
            <span class="material-symbols-outlined text-base">filter_alt_off</span>Clear all filters
          </a>
        </div>
      <% } %>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
        <nav class="mt-14 flex justify-center items-center gap-2" aria-label="Pagination">

          <% if (currentPage > 1) { %>
            <a href="?<%= buildQS({ page: currentPage - 1 }) %>"
               class="p-2.5 border border-slate-200 dark:border-slate-700 rounded-lg
                      hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
              <span class="material-symbols-outlined text-lg">chevron_left</span>
            </a>
          <% } else { %>
            <span class="p-2.5 border border-slate-100 dark:border-slate-800 rounded-lg opacity-30 cursor-not-allowed">
              <span class="material-symbols-outlined text-lg">chevron_left</span>
            </span>
          <% } %>

          <% paginationPages.forEach(function(pg) { %>
            <% if (pg === '…') { %>
              <span class="w-9 h-9 flex items-center justify-center text-slate-400 text-sm select-none">…</span>
            <% } else if (pg === currentPage) { %>
              <span class="w-9 h-9 flex items-center justify-center rounded-lg bg-primary text-white text-sm font-bold shadow shadow-primary/30"
                    aria-current="page"><%= pg %></span>
            <% } else { %>
              <a href="?<%= buildQS({ page: pg }) %>"
                 class="w-9 h-9 flex items-center justify-center rounded-lg text-sm font-bold
                        hover:bg-slate-100 dark:hover:bg-slate-800 border border-transparent
                        hover:border-slate-200 dark:hover:border-slate-700 transition-colors">
                <%= pg %>
              </a>
            <% } %>
          <% }) %>

          <% if (currentPage < totalPages) { %>
            <a href="?<%= buildQS({ page: currentPage + 1 }) %>"
               class="p-2.5 border border-slate-200 dark:border-slate-700 rounded-lg
                      hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
              <span class="material-symbols-outlined text-lg">chevron_right</span>
            </a>
          <% } else { %>
            <span class="p-2.5 border border-slate-100 dark:border-slate-800 rounded-lg opacity-30 cursor-not-allowed">
              <span class="material-symbols-outlined text-lg">chevron_right</span>
            </span>
          <% } %>

        </nav>
        <p class="text-center text-xs text-slate-400 mt-3 font-medium">
          Page <%= currentPage %> of <%= totalPages %>
        </p>
      <% } %>

    </div><!-- /product area -->
