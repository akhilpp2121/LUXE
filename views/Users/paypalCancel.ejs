<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Payment Cancelled</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: 'Inter', sans-serif;
      background: linear-gradient(135deg, #0d0d0d, #1a1a2e);
      color: #e8f1ff;
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100vh;
    }
    .container {
      text-align: center;
      backdrop-filter: blur(8px);
      background: rgba(255, 255, 255, 0.05);
      padding: 40px 60px;
      border-radius: 12px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    }
    h1 {
      font-size: 2.2rem;
      margin-bottom: 0.5rem;
      color: #ff4d4d;
    }
    p {
      margin: 1rem 0;
      font-size: 1.1rem;
    }
    a {
      display: inline-block;
      margin-top: 1.5rem;
      padding: 12px 24px;
      background: #4da6ff;
      color: #0d0d0d;
      text-decoration: none;
      border-radius: 6px;
      transition: background 0.3s, transform 0.2s;
    }
    a:hover {
      background: #80bfff;
      transform: translateY(-2px);
    }
  </style>
  <link rel="stylesheet" href="/css/navigation-consistency.css" />
</head>
<body>
  <div class="container">
    <h1>Payment Cancelled</h1>
    <p>Your PayPal payment was not completed.</p>
    <p>You can retry the payment or continue shopping.</p>
    <a href="/checkout">Return to Checkout</a>
  </div>
</body>
</html>
