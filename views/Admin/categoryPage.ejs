<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>LUXE | Category Management</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200;400;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "inverse-surface": "#faf8ff",
            "tertiary": "#ffb4f4",
            "surface-variant": "#192540",
            "on-secondary": "#000478",
            "surface-container-lowest": "#000000",
            "on-tertiary-fixed-variant": "#711f6f",
            "on-secondary-fixed-variant": "#3c45ab",
            "primary-container": "#7b9cff",
            "on-tertiary-fixed": "#480049",
            "on-primary-fixed-variant": "#00266e",
            "inverse-on-surface": "#4d556b",
            "surface-bright": "#1f2b49",
            "error": "#ff716c",
            "on-error": "#490006",
            "secondary-container": "#313aa1",
            "on-tertiary-container": "#661466",
            "on-tertiary": "#722070",
            "error-dim": "#d7383b",
            "outline": "#6d758c",
            "secondary-dim": "#8b94ff",
            "secondary-fixed-dim": "#bbbfff",
            "tertiary-dim": "#ef8fe5",
            "secondary": "#8b94ff",
            "on-surface": "#dee5ff",
            "primary-dim": "#316bf3",
            "surface-container-low": "#091328",
            "outline-variant": "#40485d",
            "on-primary": "#002873",
            "on-error-container": "#ffa8a3",
            "primary": "#90abff",
            "on-secondary-fixed": "#1c248e",
            "on-secondary-container": "#caccff",
            "tertiary-fixed-dim": "#ef8fe5",
            "on-surface-variant": "#a3aac4",
            "on-primary-fixed": "#000000",
            "surface-container": "#0f1930",
            "tertiary-container": "#fe9cf4",
            "surface-container-high": "#141f38",
            "on-primary-container": "#001e5a",
            "background": "#060e20",
            "surface-dim": "#060e20",
            "inverse-primary": "#0053dc",
            "tertiary-fixed": "#fe9cf4",
            "on-background": "#dee5ff",
            "surface-container-highest": "#192540",
            "primary-fixed": "#7b9cff",
            "primary-fixed-dim": "#658eff",
            "surface-tint": "#90abff",
            "secondary-fixed": "#cbceff",
            "error-container": "#9f0519",
            "surface": "#060e20"
          },
          fontFamily: {
            "headline": ["Manrope"],
            "body": ["Inter"],
            "label": ["Inter"]
          },
          borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
        },
      },
    }
  </script>
  <style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
    body {
      background-color: #060e20;
      color: #dee5ff;
      font-family: 'Inter', sans-serif;
    }
    /* Sidebar collapse for mobile */
    @media (max-width: 1023px) {
      #sidebar { transform: translateX(-100%); }
      #sidebar.open { transform: translateX(0); }
      main { margin-left: 0 !important; }
      header { left: 0 !important; }
    }
    /* Toast */
    #toast { transition: opacity 0.4s ease; }
    /* Table row fade-in */
    tbody tr { animation: rowIn 0.3s ease both; }
    tbody tr:nth-child(1) { animation-delay: 0.05s; }
    tbody tr:nth-child(2) { animation-delay: 0.10s; }
    tbody tr:nth-child(3) { animation-delay: 0.15s; }
    tbody tr:nth-child(4) { animation-delay: 0.20s; }
    tbody tr:nth-child(5) { animation-delay: 0.25s; }
    tbody tr:nth-child(6) { animation-delay: 0.30s; }
    @keyframes rowIn {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    /* Modal backdrop */
    .modal-backdrop { backdrop-filter: blur(6px); }
    /* Scrollbar */
    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #40485d; border-radius: 4px; }
    /* Card shadow */
    .stat-card { background: rgba(20, 31, 56, 0.8); }
  </style>
</head>
<body class="antialiased">

<!-- =========================================================
     SIDEBAR
     ========================================================= -->
<aside id="sidebar" class="h-screen w-64 xl:w-72 fixed left-0 top-0 z-40 bg-[#091328] flex flex-col py-8 transition-transform duration-300">
  <div class="px-6 xl:px-8 mb-10">
    <h1 class="text-2xl font-black font-headline text-[#90abff] uppercase tracking-widest">LUXE</h1>
    <p class="text-[10px] uppercase tracking-[0.2em] text-on-surface-variant font-bold mt-1">Admin Command Center</p>
  </div>

  <nav class="flex-1 space-y-0.5 overflow-y-auto px-2">
    <% const navItems = [
      { href: '/admin/dashboard', icon: 'dashboard',           label: 'Dashboard' },
      { href: '/admin/orders',    icon: 'shopping_cart',       label: 'Orders' },
      { href: '/admin/products',  icon: 'inventory_2',         label: 'Products' },
      { href: '/admin/users',     icon: 'group',               label: 'Users' },
      { href: '/admin/analytics', icon: 'analytics',           label: 'Analytics' },
      { href: '/admin/coupons',   icon: 'confirmation_number', label: 'Coupons' },
      { href: '/admin/categories',icon: 'category',            label: 'Categories' },
      { href: '/admin/offers',    icon: 'local_offer',         label: 'Offers' },
      { href: '/admin/banners',   icon: 'ad_units',            label: 'Banners' },
    ]; %>
    <% navItems.forEach(item => { %>
      <% const isActive = activePage === item.label.toLowerCase(); %>
      <a href="<%= item.href %>"
         class="<%= isActive
           ? 'border-l-4 border-[#90abff] bg-[#1f2b49] text-white'
           : 'border-l-4 border-transparent text-[#a3aac4] hover:bg-[#141f38] hover:text-white' %>
                py-2.5 px-4 xl:px-6 flex items-center gap-3 xl:gap-4 transition-all duration-200 rounded-r-lg">
        <span class="material-symbols-outlined text-xl"><%= item.icon %></span>
        <span class="font-label text-sm <%= isActive ? 'font-bold' : 'font-medium' %>"><%= item.label %></span>
      </a>
    <% }) %>

    <a href="/admin/profile"
       class="border-l-4 border-transparent text-[#a3aac4] hover:bg-[#141f38] hover:text-white py-2.5 px-4 xl:px-6 flex items-center gap-3 xl:gap-4 transition-all duration-200 rounded-r-lg mt-4">
      <span class="material-symbols-outlined text-xl">account_circle</span>
      <span class="font-label text-sm font-medium">Profile</span>
    </a>
  </nav>

  <div class="px-4 xl:px-6 py-4 border-t border-outline-variant/10 mt-2">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-full bg-primary/20 flex items-center justify-center border border-primary/30 shrink-0">
        <span class="material-symbols-outlined text-primary text-lg">admin_panel_settings</span>
      </div>
      <div>
        <p class="text-xs font-bold text-white">Executive Admin</p>
        <p class="text-[10px] text-on-surface-variant">System Master</p>
      </div>
    </div>
  </div>
</aside>

<!-- Sidebar overlay (mobile) -->
<div id="overlay" onclick="closeSidebar()" class="hidden fixed inset-0 bg-black/60 z-30 lg:hidden"></div>

<!-- =========================================================
     TOP APP BAR
     ========================================================= -->
<header class="fixed top-0 right-0 left-0 lg:left-64 xl:left-72 z-30 h-16 xl:h-20 bg-[#060e20]/80 backdrop-blur-xl flex items-center justify-between px-4 xl:px-10">
  <!-- Mobile menu toggle -->
  <button onclick="toggleSidebar()" class="lg:hidden p-2 hover:bg-[#1f2b49] rounded-full transition-all mr-2">
    <span class="material-symbols-outlined text-white">menu</span>
  </button>

  <!-- Search -->
  <form method="GET" action="/admin/categories" class="flex-1 max-w-xs xl:max-w-md">
    <div class="relative">
      <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-lg">search</span>
      <input
        name="search"
        value="<%= search %>"
        class="w-full bg-[#091328] border border-outline-variant/20 focus:border-primary text-sm rounded-lg pl-10 pr-4 py-2 text-white placeholder-on-surface-variant focus:ring-0 focus:outline-none transition-all"
        placeholder="Search categories…"
        type="text"
        autocomplete="off"
      />
      <!-- Preserve other query params -->
      <input type="hidden" name="status" value="<%= status %>"/>
      <input type="hidden" name="sort" value="<%= sort %>"/>
      <input type="hidden" name="page" value="1"/>
    </div>
  </form>

  <div class="flex items-center gap-2 xl:gap-4 ml-4">
    <button class="hover:bg-[#1f2b49] rounded-full p-2 transition-all relative">
      <span class="material-symbols-outlined text-white text-xl">notifications</span>
      <span class="absolute top-2 right-2 w-2 h-2 bg-error rounded-full"></span>
    </button>
    <button class="hidden sm:flex hover:bg-[#1f2b49] rounded-full p-2 transition-all">
      <span class="material-symbols-outlined text-white text-xl">settings</span>
    </button>
    <div class="h-6 w-px bg-outline-variant/20 mx-1 hidden sm:block"></div>
    <div class="w-8 h-8 xl:w-10 xl:h-10 rounded-full bg-surface-container-high border border-outline-variant/30 flex items-center justify-center overflow-hidden">
      <span class="material-symbols-outlined text-primary">person</span>
    </div>
  </div>
</header>

<!-- =========================================================
     TOAST NOTIFICATION
     ========================================================= -->
<% if (error && error !== '') { %>
<div id="toast" class="fixed bottom-6 right-6 z-50 flex items-center gap-3 bg-error-container border border-error/30 text-on-error-container px-5 py-3 rounded-xl shadow-xl">
  <span class="material-symbols-outlined text-error">error</span>
  <span class="text-sm font-medium"><%= error %></span>
  <button onclick="document.getElementById('toast').style.opacity='0'; setTimeout(()=>document.getElementById('toast').remove(),400)" class="ml-2 text-on-error-container/60 hover:text-on-error-container">
    <span class="material-symbols-outlined text-base">close</span>
  </button>
</div>
<% } %>

<!-- =========================================================
     MAIN CONTENT
     ========================================================= -->
<main class="ml-0 lg:ml-64 xl:ml-72 pt-16 xl:pt-20 min-h-screen bg-background">
  <div class="p-4 sm:p-6 xl:p-10">

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-end gap-4 mb-8 xl:mb-12">
      <div>
        <nav class="flex text-xs text-on-surface-variant gap-2 mb-2 font-medium">
          <span>Admin</span><span>/</span>
          <span class="text-primary">Catalog Management</span>
        </nav>
        <h2 class="text-2xl xl:text-4xl font-extrabold font-headline tracking-tight text-white">Category Management</h2>
        <p class="text-on-surface-variant mt-1.5 max-w-md text-sm xl:text-base">Orchestrate your product hierarchy with sophisticated classification and seasonal offers.</p>
      </div>
      <button
        onclick="openAddModal()"
        class="flex items-center gap-2 px-5 py-2.5 xl:px-6 xl:py-3 bg-gradient-to-br from-primary-dim to-primary text-on-primary font-bold rounded-xl shadow-lg shadow-primary/20 hover:scale-105 active:scale-95 transition-all text-sm self-start sm:self-auto whitespace-nowrap">
        <span class="material-symbols-outlined text-lg">add_circle</span>
        <span>Add Category</span>
      </button>
    </div>

    <!-- Stats Row -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 xl:gap-6 mb-8 xl:mb-10">
      <div class="stat-card p-4 xl:p-6 rounded-xl border-l-4 border-primary">
        <p class="text-[10px] font-bold text-on-surface-variant uppercase tracking-widest mb-1 xl:mb-2">Total Categories</p>
        <p class="text-2xl xl:text-3xl font-extrabold font-headline text-white"><%= totalUser %></p>
        <div class="mt-3 xl:mt-4 flex items-center text-xs text-primary font-bold">
          <span class="material-symbols-outlined text-sm mr-1">trending_up</span>
          <span>All time</span>
        </div>
      </div>
      <div class="stat-card p-4 xl:p-6 rounded-xl">
        <p class="text-[10px] font-bold text-on-surface-variant uppercase tracking-widest mb-1 xl:mb-2">Active Catalog</p>
        <p class="text-2xl xl:text-3xl font-extrabold font-headline text-white">
          <%= data.filter(c => c.isActive).length %>
        </p>
        <div class="mt-3 xl:mt-4 text-xs text-on-surface-variant">
          Current page active
        </div>
      </div>
      <div class="stat-card p-4 xl:p-6 rounded-xl">
        <p class="text-[10px] font-bold text-on-surface-variant uppercase tracking-widest mb-1 xl:mb-2">Live Offers</p>
        <p class="text-2xl xl:text-3xl font-extrabold font-headline text-tertiary"><%= offer.length.toString().padStart(2,'0') %></p>
        <div class="mt-3 xl:mt-4 flex items-center text-xs text-tertiary font-bold">
          <span class="material-symbols-outlined text-sm mr-1">auto_awesome</span>
          <span>Active Seasonal Push</span>
        </div>
      </div>
      <div class="stat-card p-4 xl:p-6 rounded-xl">
        <p class="text-[10px] font-bold text-on-surface-variant uppercase tracking-widest mb-1 xl:mb-2">Total Pages</p>
        <p class="text-2xl xl:text-3xl font-extrabold font-headline text-white"><%= totalPage %></p>
        <div class="mt-3 xl:mt-4 flex items-center text-xs text-on-surface-variant">
          <span class="material-symbols-outlined text-sm mr-1">layers</span>
          <span>Page <%= currentPage %> of <%= totalPage %></span>
        </div>
      </div>
    </div>

    <!-- Table Card -->
    <div class="bg-[#0f1930] rounded-xl overflow-hidden border border-outline-variant/10">

      <!-- Table Toolbar -->
      <div class="px-4 sm:px-6 xl:px-8 py-4 xl:py-6 border-b border-outline-variant/10 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <h3 class="text-base xl:text-xl font-bold font-headline text-white">Inventory Classification</h3>

        <div class="flex flex-wrap gap-2 xl:gap-4 w-full sm:w-auto">
          <!-- Status Filter -->
          <form method="GET" action="/admin/categories" id="filterForm" class="flex flex-wrap gap-2">
            <input type="hidden" name="search" value="<%= search %>"/>
            <input type="hidden" name="sort" value="<%= sort %>"/>
            <input type="hidden" name="page" value="1"/>

            <select name="status" onchange="document.getElementById('filterForm').submit()"
              class="bg-[#1f2b49] border border-outline-variant/20 text-on-surface text-xs xl:text-sm font-medium rounded-lg px-3 py-2 focus:ring-0 focus:outline-none focus:border-primary transition-all cursor-pointer">
              <option value="all" <%= (status === 'undefined' || status === 'all') ? 'selected' : '' %>>All Status</option>
              <option value="true"  <%= status === 'true'  ? 'selected' : '' %>>Active</option>
              <option value="false" <%= status === 'false' ? 'selected' : '' %>>Inactive</option>
            </select>

            <select name="sort" onchange="document.getElementById('filterForm').submit()"
              class="bg-[#1f2b49] border border-outline-variant/20 text-on-surface text-xs xl:text-sm font-medium rounded-lg px-3 py-2 focus:ring-0 focus:outline-none focus:border-primary transition-all cursor-pointer">
              <option value="latest"  <%= sort === 'latest'  ? 'selected' : '' %>>Newest First</option>
              <option value="oldest"  <%= sort === 'oldest'  ? 'selected' : '' %>>Oldest First</option>
            </select>
          </form>

          <a href="/admin/categories/export"
            class="flex items-center gap-2 px-3 py-2 bg-[#1f2b49] text-on-surface text-xs xl:text-sm font-medium rounded-lg border border-outline-variant/20 hover:border-primary/30 transition-all">
            <span class="material-symbols-outlined text-base xl:text-lg">file_download</span>
            <span class="hidden sm:inline">Export</span>
          </a>
        </div>
      </div>

      <!-- Desktop Table -->
      <div class="hidden md:block overflow-x-auto">
        <table class="w-full text-left min-w-[720px]">
          <thead>
            <tr class="bg-[#091328]/50">
              <th class="px-6 xl:px-8 py-3 xl:py-4 text-[10px] uppercase tracking-widest font-bold text-on-surface-variant">#</th>
              <th class="px-6 xl:px-8 py-3 xl:py-4 text-[10px] uppercase tracking-widest font-bold text-on-surface-variant">Category</th>
              <th class="px-6 xl:px-8 py-3 xl:py-4 text-[10px] uppercase tracking-widest font-bold text-on-surface-variant">Description</th>
              <th class="px-6 xl:px-8 py-3 xl:py-4 text-[10px] uppercase tracking-widest font-bold text-on-surface-variant">Status</th>
              <th class="px-6 xl:px-8 py-3 xl:py-4 text-[10px] uppercase tracking-widest font-bold text-on-surface-variant">Current Offer</th>
              <th class="px-6 xl:px-8 py-3 xl:py-4 text-[10px] uppercase tracking-widest font-bold text-on-surface-variant text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-outline-variant/5">
            <% if (data && data.length > 0) { %>
              <% data.forEach((category, index) => { %>
              <tr class="hover:bg-[#1f2b49]/30 transition-colors <%= index % 2 !== 0 ? 'bg-[#091328]/20' : '' %>">

                <!-- Index -->
                <td class="px-6 xl:px-8 py-4 xl:py-6 text-sm text-on-surface-variant font-mono">
                  <%= ((currentPage - 1) * 10) + index + 1 %>
                </td>

                <!-- Category Name + Image -->
                <td class="px-6 xl:px-8 py-4 xl:py-6">
                  <div class="flex items-center gap-3 xl:gap-4">
                    <div class="w-10 h-10 xl:w-12 xl:h-12 rounded-lg bg-[#091328] flex items-center justify-center overflow-hidden shrink-0 border border-outline-variant/20">
                      <% if (category.image) { %>
                        <img src="<%= category.image %>" alt="<%= category.categoryName %>" class="w-full h-full object-cover opacity-80"/>
                      <% } else { %>
                        <span class="material-symbols-outlined text-on-surface-variant text-xl">category</span>
                      <% } %>
                    </div>
                    <div>
                      <p class="font-bold text-white text-sm"><%= category.categoryName %></p>
                      <p class="text-[10px] text-primary uppercase font-bold tracking-tighter">
                        <% if (category.offer) { %><%= category.offer %><% } else { %>No Tag<% } %>
                      </p>
                    </div>
                  </div>
                </td>

                <!-- Description -->
                <td class="px-6 xl:px-8 py-4 xl:py-6">
                  <p class="text-sm text-on-surface-variant max-w-xs leading-relaxed line-clamp-2">
                    <%= category.description || '—' %>
                  </p>
                </td>

                <!-- Status Badge -->
                <td class="px-6 xl:px-8 py-4 xl:py-6">
                  <% if (category.isActive) { %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-primary/10 text-primary text-[10px] font-bold uppercase tracking-widest border border-primary/20">
                      <span class="w-1.5 h-1.5 rounded-full bg-primary mr-1.5 animate-pulse"></span>Active
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-on-surface-variant/10 text-on-surface-variant text-[10px] font-bold uppercase tracking-widest border border-outline-variant/20">
                      <span class="w-1.5 h-1.5 rounded-full bg-on-surface-variant mr-1.5"></span>Inactive
                    </span>
                  <% } %>
                </td>

                <!-- Offer Dropdown -->
                <td class="px-6 xl:px-8 py-4 xl:py-6">
                  <% if (category.isActive) { %>
                  <form method="POST" action="/admin/categories/<%= category._id %>/offer">
                    <div class="relative inline-block w-full max-w-[180px]">
                      <select name="offerId"
                        onchange="this.form.submit()"
                        class="appearance-none w-full bg-[#000000] border border-primary/30 hover:border-primary/60 text-[11px] font-medium text-white rounded-lg px-3 py-2 pr-8 focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all cursor-pointer focus:outline-none">
                        <option value="">No Active Offer</option>
                        <% offer.forEach(o => { %>
                          <option value="<%= o._id %>" <%= (category.currentOffer && String(category.currentOffer) === String(o._id)) ? 'selected' : '' %>>
                            <%= o.offerName || o.name %> (<%= o.discountPercentage || o.discount %>%)
                          </option>
                        <% }) %>
                      </select>
                      <span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-primary pointer-events-none text-lg">expand_more</span>
                    </div>
                  </form>
                  <% } else { %>
                  <div class="relative inline-block w-full max-w-[180px] opacity-40">
                    <select disabled class="appearance-none w-full bg-[#091328] border border-outline-variant/30 text-[11px] font-medium text-on-surface-variant rounded-lg px-3 py-2 pr-8 cursor-not-allowed">
                      <option>Locked</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none text-base">lock</span>
                  </div>
                  <% } %>
                </td>

                <!-- Actions -->
                <td class="px-6 xl:px-8 py-4 xl:py-6 text-right">
                  <div class="flex justify-end gap-1">
                    <a href="/admin/categories/<%= category._id %>/edit"
                       title="Edit"
                       class="p-2 text-on-surface-variant hover:text-primary transition-colors hover:bg-primary/10 rounded-lg">
                      <span class="material-symbols-outlined text-lg">edit_note</span>
                    </a>
                    <% if (category.isActive) { %>
                    <form method="POST" action="/admin/categories/<%= category._id %>/deactivate" class="inline">
                      <button type="submit" title="Deactivate"
                        onclick="return confirm('Deactivate \'<%= category.categoryName %>\'?')"
                        class="p-2 text-on-surface-variant hover:text-error transition-colors hover:bg-error/10 rounded-lg">
                        <span class="material-symbols-outlined text-lg">block</span>
                      </button>
                    </form>
                    <% } else { %>
                    <form method="POST" action="/admin/categories/<%= category._id %>/activate" class="inline">
                      <button type="submit" title="Activate"
                        onclick="return confirm('Activate \'<%= category.categoryName %>\'?')"
                        class="p-2 text-on-surface-variant hover:text-primary transition-colors hover:bg-primary/10 rounded-lg">
                        <span class="material-symbols-outlined text-lg">check_circle</span>
                      </button>
                    </form>
                    <% } %>
                    <form method="POST" action="/admin/categories/<%= category._id %>/delete" class="inline">
                      <button type="submit" title="Delete"
                        onclick="return confirm('Permanently delete \'<%= category.categoryName %>\'? This cannot be undone.')"
                        class="p-2 text-on-surface-variant hover:text-error transition-colors hover:bg-error/10 rounded-lg">
                        <span class="material-symbols-outlined text-lg">delete</span>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
              <% }) %>
            <% } else { %>
            <!-- Empty State -->
            <tr>
              <td colspan="6" class="px-8 py-20 text-center">
                <div class="flex flex-col items-center gap-4">
                  <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center">
                    <span class="material-symbols-outlined text-primary text-3xl">category</span>
                  </div>
                  <p class="text-white font-bold text-lg">No categories found</p>
                  <p class="text-on-surface-variant text-sm max-w-xs">
                    <% if (search) { %>
                      No results for "<%= search %>". Try a different search term.
                    <% } else { %>
                      Get started by adding your first category.
                    <% } %>
                  </p>
                  <% if (search) { %>
                  <a href="/admin/categories" class="px-4 py-2 text-sm font-bold text-primary border border-primary/30 rounded-lg hover:bg-primary/10 transition-all">
                    Clear search
                  </a>
                  <% } else { %>
                  <button onclick="openAddModal()" class="px-4 py-2 text-sm font-bold bg-primary text-on-primary rounded-lg hover:scale-105 transition-all">
                    Add Category
                  </button>
                  <% } %>
                </div>
              </td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Mobile Card List (shown on small screens) -->
      <div class="md:hidden divide-y divide-outline-variant/10">
        <% if (data && data.length > 0) { %>
          <% data.forEach((category, index) => { %>
          <div class="p-4 hover:bg-[#1f2b49]/20 transition-colors">
            <div class="flex items-start justify-between gap-3">
              <!-- Left: image + name -->
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-[#091328] flex items-center justify-center overflow-hidden shrink-0 border border-outline-variant/20">
                  <% if (category.image) { %>
                    <img src="<%= category.image %>" alt="<%= category.categoryName %>" class="w-full h-full object-cover opacity-80"/>
                  <% } else { %>
                    <span class="material-symbols-outlined text-on-surface-variant">category</span>
                  <% } %>
                </div>
                <div>
                  <p class="font-bold text-white text-sm"><%= category.categoryName %></p>
                  <% if (category.isActive) { %>
                    <span class="inline-flex items-center gap-1 text-[10px] text-primary font-bold uppercase">
                      <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>Active
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 text-[10px] text-on-surface-variant font-bold uppercase">
                      <span class="w-1.5 h-1.5 rounded-full bg-on-surface-variant"></span>Inactive
                    </span>
                  <% } %>
                </div>
              </div>
              <!-- Right: actions -->
              <div class="flex gap-1 shrink-0">
                <a href="/admin/categories/<%= category._id %>/edit"
                   class="p-1.5 text-on-surface-variant hover:text-primary hover:bg-primary/10 rounded-lg transition-all">
                  <span class="material-symbols-outlined text-base">edit_note</span>
                </a>
                <form method="POST" action="/admin/categories/<%= category._id %>/delete" class="inline">
                  <button type="submit"
                    onclick="return confirm('Delete \'<%= category.categoryName %>\'?')"
                    class="p-1.5 text-on-surface-variant hover:text-error hover:bg-error/10 rounded-lg transition-all">
                    <span class="material-symbols-outlined text-base">delete</span>
                  </button>
                </form>
              </div>
            </div>
            <% if (category.description) { %>
            <p class="text-xs text-on-surface-variant mt-2 leading-relaxed line-clamp-2 ml-13"><%= category.description %></p>
            <% } %>
          </div>
          <% }) %>
        <% } else { %>
        <div class="p-8 text-center">
          <p class="text-on-surface-variant text-sm">No categories found.</p>
        </div>
        <% } %>
      </div>

      <!-- Pagination Footer -->
      <div class="px-4 sm:px-6 xl:px-8 py-4 xl:py-6 bg-[#091328]/30 border-t border-outline-variant/10 flex flex-col sm:flex-row justify-between items-center gap-4">
        <p class="text-xs text-on-surface-variant text-center sm:text-left">
          Showing <span class="text-white font-bold"><%= data.length %></span> of
          <span class="text-white font-bold"><%= totalUser %></span> categories
          &nbsp;·&nbsp; Page <span class="text-white font-bold"><%= currentPage %></span> of
          <span class="text-white font-bold"><%= totalPage %></span>
        </p>

        <div class="flex gap-1.5 flex-wrap justify-center">
          <!-- Prev -->
          <% if (currentPage > 1) { %>
          <a href="/admin/categories?page=<%= currentPage - 1 %>&search=<%= search %>&status=<%= status %>&sort=<%= sort %>"
             class="w-8 h-8 flex items-center justify-center rounded-lg border border-outline-variant/20 text-on-surface-variant hover:bg-[#1f2b49] transition-all">
            <span class="material-symbols-outlined text-sm">chevron_left</span>
          </a>
          <% } else { %>
          <span class="w-8 h-8 flex items-center justify-center rounded-lg border border-outline-variant/10 text-outline opacity-40 cursor-default">
            <span class="material-symbols-outlined text-sm">chevron_left</span>
          </span>
          <% } %>

          <!-- Page Numbers (show up to 5 around current) -->
          <%
            let startPage = Math.max(1, currentPage - 2);
            let endPage   = Math.min(totalPage, startPage + 4);
            if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);
          %>
          <% for (let p = startPage; p <= endPage; p++) { %>
            <% if (p === currentPage) { %>
            <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-primary text-on-primary text-xs font-bold">
              <%= p %>
            </span>
            <% } else { %>
            <a href="/admin/categories?page=<%= p %>&search=<%= search %>&status=<%= status %>&sort=<%= sort %>"
               class="w-8 h-8 flex items-center justify-center rounded-lg border border-outline-variant/20 text-on-surface-variant hover:bg-[#1f2b49] transition-all text-xs font-bold">
              <%= p %>
            </a>
            <% } %>
          <% } %>

          <!-- Next -->
          <% if (currentPage < totalPage) { %>
          <a href="/admin/categories?page=<%= currentPage + 1 %>&search=<%= search %>&status=<%= status %>&sort=<%= sort %>"
             class="w-8 h-8 flex items-center justify-center rounded-lg border border-outline-variant/20 text-on-surface-variant hover:bg-[#1f2b49] transition-all">
            <span class="material-symbols-outlined text-sm">chevron_right</span>
          </a>
          <% } else { %>
          <span class="w-8 h-8 flex items-center justify-center rounded-lg border border-outline-variant/10 text-outline opacity-40 cursor-default">
            <span class="material-symbols-outlined text-sm">chevron_right</span>
          </span>
          <% } %>
        </div>
      </div>
    </div><!-- /table card -->

    <!-- Footer hint -->
    <div class="mt-8 xl:mt-12 text-center pb-8">
      <p class="text-xs text-on-surface-variant">
        Need to re-organize global taxonomy?
        <a class="text-primary hover:underline font-bold" href="/admin/categories/bulk">Access Database Controls</a>
      </p>
    </div>

  </div>
</main>

<!-- =========================================================
     ADD CATEGORY MODAL
     ========================================================= -->
<div id="addModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
  <div class="modal-backdrop absolute inset-0 bg-black/70" onclick="closeAddModal()"></div>
  <div class="relative bg-[#0f1930] border border-outline-variant/20 rounded-2xl w-full max-w-lg shadow-2xl">
    <!-- Modal Header -->
    <div class="flex items-center justify-between px-6 py-5 border-b border-outline-variant/10">
      <div>
        <h3 class="text-lg font-bold font-headline text-white">New Category</h3>
        <p class="text-xs text-on-surface-variant mt-0.5">Add a new product classification</p>
      </div>
      <button onclick="closeAddModal()" class="p-2 hover:bg-[#1f2b49] rounded-full transition-all text-on-surface-variant hover:text-white">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>

    <!-- Modal Body -->
    <form method="POST" action="/admin/categories/add" enctype="multipart/form-data" class="p-6 space-y-5">
      <!-- Category Name -->
      <div>
        <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-widest mb-2">Category Name *</label>
        <input
          name="categoryName"
          required
          placeholder="e.g. T-Shirts, Kurtas, Footwear…"
          class="w-full bg-[#091328] border border-outline-variant/20 focus:border-primary rounded-xl px-4 py-3 text-sm text-white placeholder-on-surface-variant focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all"
        />
      </div>

      <!-- Description -->
      <div>
        <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-widest mb-2">Description</label>
        <textarea
          name="description"
          rows="3"
          placeholder="Brief description of this category…"
          class="w-full bg-[#091328] border border-outline-variant/20 focus:border-primary rounded-xl px-4 py-3 text-sm text-white placeholder-on-surface-variant focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all resize-none"
        ></textarea>
      </div>

      <!-- Image Upload -->
      <div>
        <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-widest mb-2">Category Image</label>
        <label class="flex items-center gap-3 cursor-pointer w-full bg-[#091328] border border-dashed border-outline-variant/40 hover:border-primary/50 rounded-xl px-4 py-4 transition-all group">
          <span class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors">upload_file</span>
          <span class="text-sm text-on-surface-variant group-hover:text-white transition-colors" id="fileLabel">Click to upload image</span>
          <input type="file" name="image" accept="image/*" class="hidden" onchange="document.getElementById('fileLabel').textContent = this.files[0]?.name || 'Click to upload image'"/>
        </label>
      </div>

      <!-- Initial Offer -->
      <div>
        <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-widest mb-2">Assign Offer (optional)</label>
        <div class="relative">
          <select name="offerId"
            class="appearance-none w-full bg-[#091328] border border-outline-variant/20 focus:border-primary text-sm text-white rounded-xl px-4 py-3 pr-10 focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all cursor-pointer">
            <option value="">No Offer</option>
            <% offer.forEach(o => { %>
              <option value="<%= o._id %>"><%= o.offerName || o.name %> (<%= o.discountPercentage || o.discount %>%)</option>
            <% }) %>
          </select>
          <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-primary pointer-events-none">expand_more</span>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="closeAddModal()"
          class="flex-1 px-4 py-3 text-sm font-bold text-on-surface-variant border border-outline-variant/20 rounded-xl hover:bg-[#1f2b49] transition-all">
          Cancel
        </button>
        <button type="submit"
          class="flex-1 px-4 py-3 text-sm font-bold bg-gradient-to-br from-primary-dim to-primary text-on-primary rounded-xl hover:scale-[1.02] active:scale-[0.98] transition-all shadow-lg shadow-primary/20">
          Create Category
        </button>
      </div>
    </form>
  </div>
</div>

<!-- =========================================================
     SCRIPTS
     ========================================================= -->
<script>
  // Sidebar toggle (mobile)
  function toggleSidebar() {
    const sb = document.getElementById('sidebar');
    const ov = document.getElementById('overlay');
    sb.classList.toggle('open');
    ov.classList.toggle('hidden');
  }
  function closeSidebar() {
    document.getElementById('sidebar').classList.remove('open');
    document.getElementById('overlay').classList.add('hidden');
  }

  // Add modal
  function openAddModal() {
    const m = document.getElementById('addModal');
    m.classList.remove('hidden');
    m.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }
  function closeAddModal() {
    const m = document.getElementById('addModal');
    m.classList.add('hidden');
    m.classList.remove('flex');
    document.body.style.overflow = '';
  }
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeAddModal(); });

  // Auto-dismiss toast after 4 s
  const toast = document.getElementById('toast');
  if (toast) setTimeout(() => { toast.style.opacity = '0'; setTimeout(() => toast.remove(), 400); }, 4000);
</script>
</body>
</html>
