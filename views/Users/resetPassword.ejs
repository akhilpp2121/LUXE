<!DOCTYPE html>

<html class="dark" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200;300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#1152d4",
                        "background-light": "#f6f6f8",
                        "background-dark": "#101622",
                        "accent-gold": "#d4af37"
                    },
                    fontFamily: {
                        "display": ["Manrope", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
<style>
        body {
            font-family: 'Manrope', sans-serif;
        }
        .luxury-gradient {
            background: linear-gradient(135deg, #1a2235 0%, #101622 100%);
        }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 font-display overflow-hidden">
<div class="flex min-h-screen">
<!-- Left Side: Visual -->
<div class="hidden lg:flex lg:w-1/2 relative overflow-hidden bg-slate-900">
<div class="absolute inset-0 bg-cover bg-center opacity-80" data-alt="High-end fashion male model in minimal studio setting" style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuAgo3GR0h-s5_0TjA8mmBM2opMrFEOmK_BwL6lleA8qZZFDRGpl0Wuis1qltln_9xT26qlw-xmpHApH7q4YE_9A4VvbINoURp1Txfhm9G06r0yqv73C63n5ye-j9Z9Odi6QB0Qvjqh-YnXzh1a1s59ySB8j1PlIOPHqBnSfqm5MpnnN9EQMrECuWtHHVtPiI1n3ljx7LSntqVY6vez11F3oN6UPCq5uJhX1n5aP4tSPc_aiIImOgfoNveky2Jl51zPHjxt97DMIGOFH");'>
</div>
<div class="absolute inset-0 bg-gradient-to-t from-background-dark via-transparent to-transparent"></div>
<div class="relative z-10 flex flex-col justify-end p-20 w-full">
<div class="border-l-2 border-accent-gold pl-6">
<h1 class="text-4xl font-extrabold tracking-tight text-white mb-2 uppercase italic">Luxe</h1>
<p class="text-slate-400 text-sm tracking-widest uppercase">The Essence of Modern Luxury</p>
</div>
</div>
</div>
<!-- Right Side: Form -->
<div class="w-full lg:w-1/2 flex flex-col luxury-gradient min-h-screen">
<!-- Header Area -->
<header class="flex items-center justify-between px-8 lg:px-16 py-10">
<div class="flex items-center gap-3">
<div class="size-8 text-primary">
<svg fill="none" viewbox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
<path d="M44 11.2727C44 14.0109 39.8386 16.3957 33.69 17.6364C39.8386 18.877 44 21.2618 44 24C44 26.7382 39.8386 29.123 33.69 30.3636C39.8386 31.6043 44 33.9891 44 36.7273C44 40.7439 35.0457 44 24 44C12.9543 44 4 40.7439 4 36.7273C4 33.9891 8.16144 31.6043 14.31 30.3636C8.16144 29.123 4 26.7382 4 24C4 21.2618 8.16144 18.877 14.31 17.6364C8.16144 16.3957 4 14.0109 4 11.2727C4 7.25611 12.9543 4 24 4C35.0457 4 44 7.25611 44 11.2727Z" fill="currentColor"></path>
</svg>
</div>
<div class="flex flex-col">
<span class="text-white text-xl font-bold leading-tight tracking-tight">LUXE</span>
<span class="text-slate-500 text-[10px] uppercase tracking-[0.2em] font-bold">user portal</span>
</div>
</div>
<div>
<span class="px-3 py-1 rounded-full border border-slate-700 text-[10px] text-slate-400 uppercase font-bold tracking-widest">v4.2.0</span>
</div>
</header>
<!-- Form Content -->
<main class="flex-1 flex flex-col justify-center px-8 lg:px-16 pb-20 max-w-xl mx-auto lg:mx-0 w-full">
<div class="mb-10">
<h2 class="text-white text-4xl font-black leading-tight tracking-tight mb-3">Reset Password</h2>
<p class="text-slate-400 text-lg font-light leading-relaxed">Secure your administrative account by establishing new credentials.</p>
</div>
<form class="space-y-6">
<!-- New Password -->
<div class="flex flex-col gap-2">
<label class="text-slate-300 text-sm font-semibold uppercase tracking-wider">New Password</label>
<div class="relative group">
<input class="w-full bg-slate-800/40 border border-slate-700 focus:border-primary focus:ring-1 focus:ring-primary rounded-lg h-14 px-4 text-white placeholder-slate-500 transition-all outline-none" placeholder="Enter secure password" type="password"/>
<button class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 hover:text-white transition-colors" type="button">
<span class="material-symbols-outlined">visibility</span>
</button>
</div>
</div>
<!-- Confirm New Password -->
<div class="flex flex-col gap-2">
<label class="text-slate-300 text-sm font-semibold uppercase tracking-wider">Confirm New Password</label>
<div class="relative group">
<input class="w-full bg-slate-800/40 border border-slate-700 focus:border-primary focus:ring-1 focus:ring-primary rounded-lg h-14 px-4 text-white placeholder-slate-500 transition-all outline-none" placeholder="Re-type secure password" type="password"/>
<button class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 hover:text-white transition-colors" type="button">
<span class="material-symbols-outlined">visibility</span>
</button>
</div>
</div>
<div class="pt-4">
<button class="w-full bg-primary hover:bg-primary/90 text-white font-bold py-4 rounded-lg shadow-xl shadow-primary/20 transition-all flex items-center justify-center gap-2 group">
<span>UPDATE PASSWORD</span>
<span class="material-symbols-outlined text-xl group-hover:translate-x-1 transition-transform">arrow_forward</span>
</button>
</div>
</form>
<div class="mt-12 flex justify-center lg:justify-start">
<a class="flex items-center gap-2 text-slate-500 hover:text-white transition-colors text-sm font-medium" href="/login">
<span class="material-symbols-outlined text-lg">arrow_back</span>
<span>Back to Login</span>
</a>
</div>
</main>
<!-- Footer -->
<footer class="px-8 lg:px-16 py-10 mt-auto border-t border-slate-800/50">
<div class="flex justify-between items-center text-[10px] text-slate-600 uppercase tracking-[0.2em] font-bold">
<span>© 2024 Luxe Global</span>
<div class="flex gap-6">
<a class="hover:text-primary transition-colors" href="#">Security</a>
<a class="hover:text-primary transition-colors" href="#">Support</a>
</div>
</div>
</footer>
</div>
</div>
</body></html>