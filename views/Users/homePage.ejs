    <script>


document.addEventListener("DOMContentLoaded", function () {
    const heroSwiper = new Swiper('.myHeroSwiper', {
        loop: true,
        autoplay: {
            delay: 3500, 
            disableOnInteraction: false,
        },
        effect: 'fade',
        fadeEffect: {
            crossFade: true
        },
        pagination: {
            el: '.swiper-pagination',
            clickable: true,
        },
        navigation: {
            nextEl: '.swiper-button-next',
            prevEl: '.swiper-button-prev',
        },
    });
});

// ── Header: shadow on scroll ──────────────────────────
(function () {
    const header = document.getElementById('site-header');
    const onScroll = () => {
        if (window.scrollY > 8) header.classList.add('scrolled');
        else header.classList.remove('scrolled');
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
})();

// ── Header: mobile menu toggle ────────────────────────
(function () {
    const btn = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-nav');
    const icon = document.getElementById('mobile-menu-icon');
    if (!btn || !menu) return;
    btn.addEventListener('click', () => {
        const open = menu.classList.toggle('open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        icon.textContent = open ? 'close' : 'menu';
    });
})();


        // ── Variant selection modal ──────────────────────────
        let vmState = { variants: [], selectedColor: null, selectedVariant: null, productId: null, wishlistId: null, cardEl: null };

        async function openVariantModal(productId, meta = {}) {
            vmState = { variants: [], selectedColor: null, selectedVariant: null, productId, wishlistId: meta.wishlistId || null, cardEl: meta.cardEl || null };

            document.getElementById('vm-image').src = meta.image || '';
            document.getElementById('vm-name').textContent = meta.name || '';
            document.getElementById('vm-loading').classList.remove('hidden');
            document.getElementById('vm-content').classList.add('hidden');
            document.getElementById('vm-empty').classList.add('hidden');
            document.getElementById('vm-error').classList.add('hidden');
            document.getElementById('vm-stock-note').classList.add('hidden');
            document.getElementById('vm-confirm-btn').disabled = true;
            document.getElementById('vm-confirm-text').textContent = 'Select a Size';

            const modal = document.getElementById('variant-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');

            try {
                const res = await fetch(`/product/${productId}/variants`);
                const data = await res.json();
                document.getElementById('vm-loading').classList.add('hidden');

                if (!data.success || !data.variants.length) {
                    document.getElementById('vm-empty').classList.remove('hidden');
                    return;
                }

                vmState.variants = data.variants;
                document.getElementById('vm-content').classList.remove('hidden');
                renderColors();
            } catch (e) {
                console.error('openVariantModal error:', e);
                document.getElementById('vm-loading').classList.add('hidden');
                document.getElementById('vm-empty').classList.remove('hidden');
            }
        }

        function renderColors() {
            const colors = [...new Set(vmState.variants.map(v => v.color))];
            const block = document.getElementById('vm-color-block');
            const wrap = document.getElementById('vm-color-options');
            wrap.innerHTML = '';

            if (colors.length <= 1) {
                block.classList.add('hidden');
                vmState.selectedColor = colors[0] || null;
                renderSizes();
                return;
            }

            block.classList.remove('hidden');
            vmState.selectedColor = colors[0];
            document.getElementById('vm-selected-color').textContent = vmState.selectedColor;

            colors.forEach(color => {
                const swatch = document.createElement('button');
                swatch.type = 'button';
                swatch.className = 'vm-color-swatch' + (color === vmState.selectedColor ? ' selected' : '');
                swatch.title = color;
                swatch.innerHTML = `<span class="swatch-inner" style="background:${cssColor(color)}"></span>`;
                swatch.onclick = () => {
                    vmState.selectedColor = color;
                    document.getElementById('vm-selected-color').textContent = color;
                    [...wrap.children].forEach(c => c.classList.remove('selected'));
                    swatch.classList.add('selected');
                    renderSizes();
                };
                wrap.appendChild(swatch);
            });

            renderSizes();
        }

        function cssColor(name) {
            const s = new Option().style;
            s.color = name.toLowerCase();
            return s.color ? name.toLowerCase() : '#cbd5e1';
        }

        function renderSizes() {
            const wrap = document.getElementById('vm-size-options');
            wrap.innerHTML = '';
            vmState.selectedVariant = null;
            updateConfirmState();

            const sizeVariants = vmState.variants.filter(v => v.color === vmState.selectedColor);

            sizeVariants.forEach(v => {
                const chip = document.createElement('button');
                chip.type = 'button';
                const isOOS = v.stock <= 0;
                chip.className = 'vm-chip' + (isOOS ? ' out-of-stock' : '');
                chip.textContent = v.size;
                chip.disabled = isOOS;
                chip.onclick = () => {
                    [...wrap.children].forEach(c => c.classList.remove('selected'));
                    chip.classList.add('selected');
                    vmState.selectedVariant = v;
                    updatePriceDisplay(v);
                    document.getElementById('vm-error').classList.add('hidden');

                    const note = document.getElementById('vm-stock-note');
                    if (v.stock <= 5) {
                        note.textContent = `Only ${v.stock} left in stock`;
                        note.className = 'text-xs font-medium mt-3 text-amber-600';
                        note.classList.remove('hidden');
                    } else {
                        note.classList.add('hidden');
                    }
                    updateConfirmState();
                };
                wrap.appendChild(chip);
            });

            const firstAvailable = sizeVariants.find(v => v.stock > 0) || sizeVariants[0];
            if (firstAvailable) updatePriceDisplay(firstAvailable);
        }

        function updatePriceDisplay(v) {
            const price = (v.discount && v.discount < v.price) ? v.discount : v.price;
            document.getElementById('vm-price').textContent = '₹' + price.toLocaleString('en-IN');
            const origEl = document.getElementById('vm-original-price');
            if (v.discount && v.discount < v.price) {
                origEl.textContent = '₹' + v.price.toLocaleString('en-IN');
            } else {
                origEl.textContent = '';
            }
        }

        function updateConfirmState() {
            const btn = document.getElementById('vm-confirm-btn');
            const text = document.getElementById('vm-confirm-text');
            if (vmState.selectedVariant) {
                btn.disabled = false;
                text.textContent = 'Add to Cart';
            } else {
                btn.disabled = true;
                text.textContent = 'Select a Size';
            }
        }

        function closeVariantModal() {
            const modal = document.getElementById('variant-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        async function confirmVariantAddToCart() {
            if (!vmState.selectedVariant) {
                const err = document.getElementById('vm-error');
                err.classList.remove('hidden');
                err.classList.add('flex');
                return;
            }

            const btn = document.getElementById('vm-confirm-btn');
            const text = document.getElementById('vm-confirm-text');
            btn.disabled = true;
            text.textContent = 'Adding…';

            try {
                const res = await fetch('/cart/add-cart', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ variantId: vmState.selectedVariant._id, qty: 1 })
                });
                const result = await res.json();

                if (!result.success) {
                    btn.disabled = false;
                    text.textContent = 'Add to Cart';
                    return Swal.fire({ toast: true, icon: 'error', title: result.message, position: 'top-right', showConfirmButton: false, timer: 2500 });
                }

                if (vmState.wishlistId) {
                    await fetch('/wishlist/remove', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id: vmState.wishlistId })
                    });
                    if (vmState.cardEl) {
                        vmState.cardEl.style.opacity = '0';
                        vmState.cardEl.style.transform = 'translateY(20px)';
                        setTimeout(() => {
                            vmState.cardEl.remove();
                            if (typeof updateCounter === 'function') updateCounter();
                        }, 350);
                    }
                }

                if (typeof updateCartBadge === 'function') updateCartBadge();

                Swal.fire({ toast: true, icon: 'success', title: result.message, position: 'top-right', showConfirmButton: false, timer: 2500 });
                closeVariantModal();

            } catch (e) {
                console.error('confirmVariantAddToCart error:', e);
                btn.disabled = false;
                text.textContent = 'Add to Cart';
                Swal.fire({ toast: true, icon: 'error', title: 'Something went wrong', position: 'top-right', showConfirmButton: false, timer: 2500 });
            }
        }

        document.getElementById('variant-modal')?.addEventListener('click', e => {
            if (e.target.id === 'variant-modal') closeVariantModal();
        });
    </script>

<!-- Swiper JS -->
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
</body>

