<!DOCTYPE html>
<html class="dark" lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>LUXE Products Management</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<script id="tailwind-config">
  tailwind.config = {
    darkMode: "class",
    theme: {
      extend: {
        colors: {
          "secondary-container": "#313aa1","on-primary-fixed-variant": "#00266e","tertiary-dim": "#ef8fe5","surface-container-highest": "#192540","on-surface-variant": "#a3aac4","on-tertiary-fixed-variant": "#711f6f","outline": "#6d758c","error-container": "#9f0519","surface-bright": "#1f2b49","secondary-fixed": "#cbceff","primary-dim": "#316bf3","background": "#060e20","surface-variant": "#192540","surface-container-lowest": "#000000","primary-fixed": "#7b9cff","surface-container-high": "#141f38","surface-container": "#0f1930","on-secondary-fixed-variant": "#3c45ab","on-secondary-fixed": "#1c248e","inverse-surface": "#faf8ff","tertiary": "#ffb4f4","surface-tint": "#90abff","secondary-dim": "#8b94ff","secondary": "#8b94ff","on-primary-container": "#001e5a","surface": "#060e20","primary-fixed-dim": "#658eff","on-tertiary": "#722070","on-secondary-container": "#caccff","on-primary-fixed": "#000000","error-dim": "#d7383b","error": "#ff716c","tertiary-fixed-dim": "#ef8fe5","on-surface": "#dee5ff","surface-container-low": "#091328","on-error-container": "#ffa8a3","surface-dim": "#060e20","on-secondary": "#000478","on-error": "#490006","outline-variant": "#40485d","on-primary": "#002873","primary": "#90abff","on-tertiary-container": "#661466","secondary-fixed-dim": "#bbbfff","primary-container": "#7b9cff","tertiary-fixed": "#fe9cf4","on-background": "#dee5ff","tertiary-container": "#fe9cf4","on-tertiary-fixed": "#480049","inverse-primary": "#0053dc","inverse-on-surface": "#4d556b"
        },
        fontFamily: {"headline": ["Manrope"],"body": ["Inter"],"label": ["Inter"]},
        borderRadius: {"DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem"},
      },
    },
  }
</script>
<style>
  .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: #060e20; }
  ::-webkit-scrollbar-thumb { background: #1f2b49; border-radius: 10px; }
  .glass-effect { background: rgba(25, 37, 64, 0.7); backdrop-filter: blur(20px); }
  .luxe-gradient { background: linear-gradient(135deg, #316bf3 0%, #90abff 100%); }
  .search-btn { transition: all 0.15s ease; }
  .search-btn:active { transform: scale(0.93); }
  .logout-btn {
    display: flex; align-items: center; gap: 10px; padding: 10px 18px;
    border-radius: 8px; border: none;
    background: linear-gradient(135deg, #ff4d4d, #cc0000);
    color: #fff; font-weight: 600; font-size: 14px; cursor: pointer;
    transition: all 0.3s ease; box-shadow: 0 4px 12px rgba(255,0,0,0.2);
  }
  .logout-btn:hover {
    background: linear-gradient(135deg, #ff1a1a, #990000);
    transform: translateY(-2px); box-shadow: 0 6px 16px rgba(255,0,0,0.3);
  }
  .logout-btn:active { transform: scale(0.96); }
</style>
</head>
<body class="bg-background text-on-background font-body antialiased min-h-screen">

<!-- Sidebar -->
<aside class="h-screen w-64 fixed left-0 top-0 bg-[#091328] dark:bg-slate-950 flex flex-col py-8 px-4 z-50">

  <div class="mb-10 px-4">
    <h1 class="font-['Manrope'] font-extrabold text-xl tracking-tighter text-white">LUXE Admin</h1>
    <p class="text-on-surface-variant text-[10px] uppercase tracking-widest mt-1">Premium Command</p>
  </div>

  <nav class="flex-1 space-y-1">
    <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm" href="/admin/dashboard">
      <span class="material-symbols-outlined text-lg">dashboard</span>Dashboard
    </a>
    <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm" href="#">
      <span class="material-symbols-outlined text-lg">shopping_cart</span>Orders
    </a>
    <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-white border-l-4 border-[#90abff] bg-[#1f2b49] font-bold text-sm" href="/admin/products">
      <span class="material-symbols-outlined text-lg">inventory_2</span>Products
    </a>
    <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm" href="/admin/users">
      <span class="material-symbols-outlined text-lg">group</span>Users
    </a>
    <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm" href="#">
      <span class="material-symbols-outlined text-lg">monitoring</span>Analytics
    </a>
    <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm" href="#">
      <span class="material-symbols-outlined text-lg">confirmation_number</span>Coupons
    </a>
    <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm" href="/admin/category">
      <span class="material-symbols-outlined text-lg">category</span>Categories
    </a>
    <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm" href="#">
      <span class="material-symbols-outlined text-lg">local_offer</span>Offers
    </a>
    <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm" href="#">
      <span class="material-symbols-outlined text-lg">ad_units</span>Banners
    </a>
  </nav>

  <div class="mt-auto px-4 pt-6 border-t border-[#1f2a44]">
    <form action="/admin/logout" method="POST">
      <button type="submit" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-['Inter'] font-bold text-sm tracking-tight">
        <span class="material-symbols-outlined text-lg">logout</span>
        Logout
      </button>
    </form>
  </div>

</aside>

<!-- Main Content -->
<main class="ml-64 min-h-screen relative">

  <!-- Top Nav -->
  <header class="fixed top-0 right-0 w-[calc(100%-16rem)] h-16 bg-[#060e20]/70 backdrop-blur-xl shadow-2xl shadow-blue-900/10 flex items-center justify-between px-8 z-40">
    <div class="flex items-center gap-6">
      <h2 class="font-['Manrope'] font-semibold text-lg text-[#90abff]">Products</h2>

      <!-- Search Form — submits to BE, zero JS involved -->
      <form action="/admin/products" method="GET" class="flex items-center gap-0">

        <!-- Preserve sort across searches -->
        <input type="hidden" name="sort" value="<%= sort || 'latest' %>" />
        <input type="hidden" name="page" value="1" />

        <div class="relative flex items-center">
          <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-sm pointer-events-none">search</span>
          <input
            name="search"
            class="w-80 bg-surface-container-lowest border-b-2 border-transparent focus:border-primary py-2 pl-10 pr-3 text-sm text-on-surface transition-all outline-none rounded-l-sm"
            placeholder="Search product portfolio..."
            type="text"
            value="<%= searchQuery || '' %>"
          />
        </div>

        <button
          type="submit"
          class="search-btn flex items-center justify-center gap-1.5 h-[38px] px-4 bg-primary/15 border-b-2 border-transparent hover:bg-primary/25 hover:border-primary text-primary font-['Inter'] font-bold text-xs transition-colors rounded-r-sm"
          style="border-left: 1px solid rgba(64,72,93,0.4);"
        >
          <span class="material-symbols-outlined text-sm">travel_explore</span>
          Search
        </button>

      </form>

      <!-- Reset — simple link, clears search, keeps sort -->
      <% if (searchQuery) { %>
        <a href="/admin/products?sort=<%= sort || 'latest' %>&page=1"
          class="search-btn flex items-center justify-center gap-1.5 h-[38px] px-3 bg-error/10 border border-error/20 hover:bg-error/20 hover:border-error/40 text-error font-['Inter'] font-bold text-xs rounded-sm">
          <span class="material-symbols-outlined text-sm">close</span>
          Reset
        </a>
      <% } %>

    </div>

    <div class="flex items-center gap-4">
      <button class="p-2 text-on-surface-variant hover:text-white transition-colors">
        <span class="material-symbols-outlined">notifications</span>
      </button>
      <button class="p-2 text-on-surface-variant hover:text-white transition-colors">
        <span class="material-symbols-outlined">settings</span>
      </button>
      <div class="h-8 w-px bg-outline-variant/20 mx-2"></div>
      <a href="/admin/addProduct">
        <button class="luxe-gradient text-on-primary font-['Inter'] font-bold text-xs px-6 py-2.5 rounded-md hover:brightness-110 active:scale-95 transition-all flex items-center gap-2">
          <span class="material-symbols-outlined text-sm">add</span>
          Add Product
        </button>
      </a>
    </div>
  </header>

  <!-- Page Content -->
  <div class="pt-24 px-8 pb-12">

    <!-- Filter Controls -->
    <div class="flex items-center justify-between mb-8">

      <!-- Sort Form — preserves search across sort changes -->
      <form action="/admin/products" method="GET" class="flex gap-3">
        <input type="hidden" name="search" value="<%= searchQuery || '' %>" />
        <input type="hidden" name="page" value="1" />

        <div class="bg-surface-container-high rounded-lg px-4 py-2 flex items-center gap-3 border border-outline-variant/5">
          <span class="material-symbols-outlined text-on-surface-variant text-sm">sort</span>
          <select
            name="sort"
            onchange="this.form.submit()"
            class="text-xs font-bold text-on-surface bg-transparent outline-none cursor-pointer"
          >
            <option value="latest" class="bg-surface-container-high" <%= sort === 'latest' ? 'selected' : '' %>>🕐 Latest</option>
            <option value="oldest" class="bg-surface-container-high" <%= sort === 'oldest' ? 'selected' : '' %>>⏰ Oldest</option>
          </select>
          <span class="material-symbols-outlined text-xs text-on-surface-variant">expand_more</span>
        </div>
      </form>

      <div class="text-on-surface-variant text-xs font-medium">
        Total <span class="text-on-surface font-bold"><%= totalUser %></span> products
      </div>
    </div>

    <!-- Products Table -->
    <div class="bg-surface-container-high rounded-2xl overflow-hidden shadow-2xl">
      <table class="w-full border-collapse">
        <thead>
          <tr class="bg-surface-container-low/50">
            <th class="px-8 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">Product</th>
            <th class="px-8 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">Category</th>
            <th class="px-8 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">Status</th>
            <th class="px-8 py-5 text-right text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-outline-variant/10">

          <% if (data && data.length > 0) { %>
            <% data.forEach(function(product) { %>

              <tr class="group hover:bg-surface-bright/50 transition-colors">
                

                <!-- Product Name + Image -->
                <td class="px-8 py-5">
                  <div class="flex items-center gap-4">
                    <% if (product.images && product.images.length > 0) { %>
                      <img
                        src="<%= product.images[0] %>"
                        alt="<%= product.name %>"
                        class="w-12 h-12 rounded-lg object-cover flex-shrink-0"
                      />
                    <% } else { %>
                      <div class="w-12 h-12 rounded-lg luxe-gradient flex items-center justify-center text-white font-['Manrope'] font-extrabold text-lg flex-shrink-0">
                        <%= product.name.charAt(0).toUpperCase() %>
                      </div>
                    <% } %>
                    <div>
                      <p class="text-sm font-bold text-white mb-0.5"><%= product.name %></p>
                    </div>
                  </div>
                </td>

                <!-- Category -->
                <td class="px-8 py-5">
                  <span class="text-[10px] font-bold text-primary uppercase tracking-widest px-2.5 py-1 bg-primary/10 rounded">
                    <%= product.categoryId ? product.categoryId.categoryName : 'No Category' %>
                  </span>
                </td>

         <!-- Status -->


         <td class="px-8 py-5">
  <%
    const hasVariants = product.variants && product.variants.length > 0;

    const isEffectivelyActive = hasVariants &&
      product.variants.some(function(v) { return v.isActive === true; });
  %>

  <% if (isEffectivelyActive) { %>
    <span class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded bg-emerald-500/10 text-emerald-400">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block"></span>
      Active
    </span>
  <% } else { %>
    <span class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded bg-error/10 text-error">
      <span class="w-1.5 h-1.5 rounded-full bg-error inline-block"></span>
      Inactive
    </span>
  <% } %>
</td>
                <!-- Actions -->
                <td class="px-8 py-5 text-right">
                  <div class="flex items-center justify-end gap-3">
                    <a href="/admin/editProducts/<%= product._id %>">
                      <button class="p-2 hover:bg-surface-container-low rounded-lg text-primary transition-colors" title="Edit">
                        <span class="material-symbols-outlined text-lg">edit</span>
                      </button>
                    </a>
                  </div>
                </td>

              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="4" class="px-8 py-16 text-center">
                <div class="flex flex-col items-center gap-3">
                  <span class="material-symbols-outlined text-4xl text-on-surface-variant">inventory_2</span>
                  <p class="text-sm font-bold text-on-surface-variant">No products found</p>
                  <% if (searchQuery) { %>
                    <p class="text-xs text-on-surface-variant/60">No results for "<%= searchQuery %>"</p>
                    <a href="/admin/products?sort=<%= sort || 'latest' %>&page=1"
                      class="mt-2 text-xs font-bold text-primary hover:underline">
                      Clear search
                    </a>
                  <% } %>
                </div>
              </td>
            </tr>
          <% } %>

        </tbody>
      </table>

      <!-- Pagination — pure BE links, no JS -->
      <% if (totalPage > 1) { %>
        <div class="px-8 py-6 bg-surface-container-low/30 flex items-center justify-between">

          <!-- Previous -->
          <% if (currentPage > 1) { %>
            <a href="/admin/products?page=<%= currentPage - 1 %>&search=<%= searchQuery || '' %>&sort=<%= sort || 'latest' %>">
              <button class="px-4 py-2 text-xs font-bold text-on-surface-variant hover:text-white transition-colors flex items-center gap-2">
                <span class="material-symbols-outlined text-sm">chevron_left</span>Previous
              </button>
            </a>
          <% } else { %>
            <button disabled class="px-4 py-2 text-xs font-bold text-on-surface-variant/30 flex items-center gap-2 cursor-not-allowed">
              <span class="material-symbols-outlined text-sm">chevron_left</span>Previous
            </button>
          <% } %>

          <!-- Page Numbers -->
          <div class="flex items-center gap-2">
            <% for (let i = 1; i <= totalPage; i++) { %>
              <a href="/admin/products?page=<%= i %>&search=<%= searchQuery || '' %>&sort=<%= sort || 'latest' %>">
                <button class="w-8 h-8 rounded-lg text-xs font-bold <%= currentPage === i ? 'luxe-gradient text-white' : 'hover:bg-surface-bright text-on-surface-variant' %>">
                  <%= i %>
                </button>
              </a>
            <% } %>
          </div>

          <!-- Next -->
          <% if (currentPage < totalPage) { %>
            <a href="/admin/products?page=<%= currentPage + 1 %>&search=<%= searchQuery || '' %>&sort=<%= sort || 'latest' %>">
              <button class="px-4 py-2 text-xs font-bold text-on-surface-variant hover:text-white transition-colors flex items-center gap-2">
                Next<span class="material-symbols-outlined text-sm">chevron_right</span>
              </button>
            </a>
          <% } else { %>
            <button disabled class="px-4 py-2 text-xs font-bold text-on-surface-variant/30 flex items-center gap-2 cursor-not-allowed">
              Next<span class="material-symbols-outlined text-sm">chevron_right</span>
            </button>
          <% } %>

        </div>
      <% } %>

    </div>
  </div>

</main>

<!-- NO <script> block — everything is server-driven -->

</body>
</html>
