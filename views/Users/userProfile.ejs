<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>LUXE | My Profile</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Syne:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@300,0..1&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg: #080c14; --sur: #0e1523; --sur2: #141c2e; --sur3: #1a2338; --sur4: #212c42;
    --bord: rgba(255,255,255,0.07); --bord2: rgba(255,255,255,0.13);
    --pri: #3a6ff7; --gold: #c9a96e; --gold2: #e0c08a;
    --txt: #e8edf8; --txt2: #8892a4; --txt3: #5a6478;
    --green: #22c55e; --red: #ef4444;
    --nav-h: 68px; --side-w: 260px; --r: 12px; --rl: 18px;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--txt); min-height: 100vh; overflow-x: hidden; }
  ::-webkit-scrollbar { width: 4px; } ::-webkit-scrollbar-track { background: var(--bg); } ::-webkit-scrollbar-thumb { background: var(--sur4); border-radius: 99px; }

  /* ── NAV ── */
  nav.topnav {
    position: fixed; top: 0; left: 0; right: 0; height: var(--nav-h);
    background: rgba(8,12,20,0.9); backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--bord);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 36px; z-index: 100;
  }
  .brand { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 1rem; letter-spacing: .22em; text-transform: uppercase; }
  .brand span { color: var(--gold); }
  .nav-links { display: flex; gap: 32px; list-style: none; }
  .nav-links a { font-family: 'Syne', sans-serif; font-size: .6rem; letter-spacing: .18em; text-transform: uppercase; color: var(--txt2); text-decoration: none; transition: color .2s; }
  .nav-links a:hover { color: var(--txt); }
  .nav-acts { display: flex; align-items: center; gap: 16px; }
  .nav-btn { background: none; border: none; cursor: pointer; color: var(--txt2); display: flex; align-items: center; transition: color .2s; }
  .nav-btn:hover { color: var(--txt); } .nav-btn.on { color: var(--pri); }
  .nav-btn .ms { font-size: 22px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }

  /* ── SIDEBAR ── */
  aside.sidebar {
    position: fixed; top: var(--nav-h); left: 0;
    width: var(--side-w); height: calc(100vh - var(--nav-h));
    background: var(--sur); border-right: 1px solid var(--bord);
    display: flex; flex-direction: column; padding: 28px 0 20px; z-index: 50; overflow-y: auto;
  }
  .sidebar-header { padding: 0 24px 24px; border-bottom: 1px solid var(--bord); margin-bottom: 12px; }
  .sidebar-header h3 { font-family: 'Syne', sans-serif; font-weight: 700; font-size: .9rem; margin-bottom: 6px; }
  .sidebar-tier { display: inline-flex; align-items: center; gap: 5px; background: rgba(201,169,110,.1); border: 1px solid rgba(201,169,110,.25); border-radius: 99px; padding: 3px 10px; }
  .sidebar-tier span { font-family: 'Syne', sans-serif; font-size: .5rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--gold); }
  .tier-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--gold); flex-shrink: 0; }
  .sidebar-nav { display: flex; flex-direction: column; gap: 2px; padding: 0 10px; }
  .sidebar-link {
    display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 8px;
    text-decoration: none; color: var(--txt2); font-size: .625rem; font-family: 'Syne', sans-serif;
    font-weight: 600; letter-spacing: .1em; text-transform: uppercase; transition: all .2s;
  }
  .sidebar-link .material-symbols-outlined { font-size: 17px; flex-shrink: 0; font-variation-settings: 'FILL' 0, 'wght' 300; }
  .sidebar-link:hover { background: var(--sur3); color: var(--txt); }
  .sidebar-link.active { background: rgba(58,111,247,.12); color: var(--pri); }
  .sidebar-footer { margin-top: auto; padding: 18px 24px 0; border-top: 1px solid var(--bord); }
  .sidebar-footer a { display: flex; align-items: center; gap: 9px; text-decoration: none; color: var(--txt3); font-size: .625rem; font-family: 'Syne', sans-serif; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; transition: color .2s; }
  .sidebar-footer a:hover { color: var(--txt2); }
  .sidebar-footer .material-symbols-outlined { font-size: 17px; font-variation-settings: 'FILL' 0, 'wght' 300; }

  /* ── MAIN ── */
  main { margin-left: var(--side-w); padding: calc(var(--nav-h) + 44px) 48px 80px; min-height: 100vh; }
  .page-header { margin-bottom: 36px; }
  .page-header h1 { font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: 3.2rem; letter-spacing: -.01em; line-height: 1.05; margin-bottom: 6px; }
  .page-header h1 em { font-style: italic; color: var(--gold2); }
  .page-header p { color: var(--txt3); font-size: .82rem; font-weight: 300; }

  /* ── PROFILE LAYOUT ── */
  .profile-layout { display: grid; grid-template-columns: 300px 1fr; gap: 24px; align-items: start; }

  /* LEFT CARD */
  .left-card { background: var(--sur); border: 1px solid var(--bord); border-radius: var(--rl); overflow: hidden; animation: fu .5s ease both; }
  .avatar-banner { background: linear-gradient(135deg, rgba(58,111,247,.2) 0%, rgba(201,169,110,.1) 100%); height: 90px; position: relative; }
  .avatar-banner::after { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 80% 60% at 80% 20%, rgba(58,111,247,.3), transparent); }
  .avatar-wrap { display: flex; flex-direction: column; align-items: center; padding: 0 24px 28px; }
  .avatar-ring { position: relative; margin-top: -44px; z-index: 1; }
  .avatar-ring img { width: 88px; height: 88px; border-radius: 50%; object-fit: cover; border: 3px solid var(--sur); display: block; }
  .avatar-online { position: absolute; bottom: 4px; right: 4px; width: 16px; height: 16px; background: var(--green); border: 2.5px solid var(--sur); border-radius: 50%; }
  .user-name { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 1.15rem; margin: 14px 0 4px; text-align: center; }
  .user-email { font-size: .8rem; color: var(--txt3); font-weight: 300; text-align: center; word-break: break-all; }
  .member-pill { display: inline-flex; align-items: center; gap: 5px; background: rgba(201,169,110,.1); border: 1px solid rgba(201,169,110,.25); border-radius: 99px; padding: 4px 12px; margin: 12px 0; }
  .member-pill span { font-family: 'Syne', sans-serif; font-size: .5rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--gold); }
  .edit-profile-btn {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    width: 100%; background: var(--pri); color: #fff; border: none; border-radius: 8px;
    padding: 11px; font-family: 'Syne', sans-serif; font-size: .65rem; font-weight: 700;
    letter-spacing: .12em; text-transform: uppercase; cursor: pointer; transition: all .2s;
    text-decoration: none; margin-top: 4px;
  }
  .edit-profile-btn:hover { background: #5b84ff; box-shadow: 0 0 24px rgba(58,111,247,.35); }
  .edit-profile-btn .ms { font-size: 16px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }

  /* STATS */
  .stats-row { display: grid; grid-template-columns: repeat(3,1fr); border-top: 1px solid var(--bord); margin-top: 20px; }
  .stat-cell { padding: 16px 10px; text-align: center; border-right: 1px solid var(--bord); }
  .stat-cell:last-child { border-right: none; }
  .stat-val { font-family: 'Cormorant Garamond', serif; font-size: 1.6rem; font-weight: 400; color: var(--gold2); line-height: 1; }
  .stat-lbl { font-family: 'Syne', sans-serif; font-size: .48rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--txt3); margin-top: 4px; }

  /* RIGHT: DETAILS */
  .right-col { display: flex; flex-direction: column; gap: 20px; }
  .detail-card { background: var(--sur); border: 1px solid var(--bord); border-radius: var(--rl); padding: 28px; animation: fu .5s .08s ease both; }
  .card-title { font-family: 'Syne', sans-serif; font-weight: 700; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; color: var(--txt2); margin-bottom: 20px; display: flex; align-items: center; gap: 8px; }
  .card-title .ms { font-size: 16px; color: var(--pri); font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }

  .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .detail-item { display: flex; flex-direction: column; gap: 5px; }
  .detail-label { font-family: 'Syne', sans-serif; font-size: .52rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--txt3); }
  .detail-value { font-size: .875rem; color: var(--txt); font-weight: 400; display: flex; align-items: center; gap: 6px; }
  .verified-badge { display: inline-flex; align-items: center; gap: 3px; background: rgba(34,197,94,.08); border: 1px solid rgba(34,197,94,.2); border-radius: 99px; padding: 2px 7px; font-family: 'Syne', sans-serif; font-size: .47rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #4ade80; }
  .verified-badge .ms { font-size: 11px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 1, 'wght' 300; }
  .unverified-badge { display: inline-flex; align-items: center; gap: 3px; background: rgba(245,158,11,.08); border: 1px solid rgba(245,158,11,.2); border-radius: 99px; padding: 2px 7px; font-family: 'Syne', sans-serif; font-size: .47rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #fbbf24; }
  .unverified-badge .ms { font-size: 11px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 1, 'wght' 300; }
  .detail-span { grid-column: 1 / -1; }

  /* ADDRESS CARD */
  .address-card { background: var(--sur2); border: 1px solid var(--bord); border-radius: var(--r); padding: 18px 20px; display: flex; align-items: flex-start; gap: 14px; }
  .addr-icon { width: 36px; height: 36px; border-radius: 8px; background: rgba(58,111,247,.1); border: 1px solid rgba(58,111,247,.2); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .addr-icon .ms { font-size: 18px; color: var(--pri); font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }
  .addr-info { flex: 1; }
  .addr-name { font-family: 'Syne', sans-serif; font-weight: 600; font-size: .8rem; color: var(--txt); margin-bottom: 4px; }
  .addr-text { font-size: .8rem; color: var(--txt2); line-height: 1.6; font-weight: 300; }
  .addr-default { display: inline-flex; align-items: center; gap: 4px; background: rgba(58,111,247,.1); border: 1px solid rgba(58,111,247,.2); border-radius: 99px; padding: 2px 8px; font-family: 'Syne', sans-serif; font-size: .47rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--pri); margin-top: 8px; }
  .addr-default .ms { font-size: 11px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 1, 'wght' 300; }

  /* MEMBERSHIP CARD */
  .membership-card { background: var(--sur2); border: 1px solid var(--bord); border-radius: var(--rl); padding: 26px; position: relative; overflow: hidden; animation: fu .5s .16s ease both; }
  .membership-card::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 70% 55% at 88% 10%, rgba(58,111,247,.28), transparent 60%), radial-gradient(ellipse 50% 65% at 12% 95%, rgba(201,169,110,.12), transparent 60%); pointer-events: none; }
  .mc-inner { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .mc-left { }
  .mc-tier { display: inline-flex; align-items: center; gap: 5px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1); border-radius: 99px; padding: 3px 10px; margin-bottom: 10px; }
  .mc-tier span { font-family: 'Syne', sans-serif; font-size: .5rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--gold2); }
  .mc-title { font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: 1.6rem; line-height: 1.2; }
  .mc-title em { font-style: italic; color: var(--gold2); }
  .mc-right { text-align: right; }
  .mc-credits-label { font-family: 'Syne', sans-serif; font-size: .52rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.35); margin-bottom: 4px; }
  .mc-credits-val { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 1.5rem; letter-spacing: -.02em; }
  .mc-credits-val sub { font-size: .65rem; font-weight: 400; color: var(--txt2); margin-left: 3px; }
  .prog-track { height: 3px; background: rgba(255,255,255,.07); border-radius: 99px; overflow: hidden; margin-top: 16px; }
  .prog-fill { height: 100%; width: 74%; background: linear-gradient(90deg, var(--pri), var(--gold)); border-radius: 99px; }
  .prog-labels { display: flex; justify-content: space-between; margin-top: 6px; }
  .prog-labels span { font-size: .58rem; color: var(--txt3); }

  @keyframes fu { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }

  @media (max-width: 1100px) { .profile-layout { grid-template-columns: 1fr; } }
  @media (max-width: 900px) { :root { --side-w: 0px; } aside.sidebar { display: none; } main { padding: calc(var(--nav-h) + 28px) 20px 60px; } .nav-links { display: none; } }
  @media (max-width: 600px) { .detail-grid { grid-template-columns: 1fr; } .mc-inner { flex-direction: column; align-items: flex-start; } }
</style>
</head>
<body>

<!-- ── NAV ── -->
<nav class="topnav">
  <div class="brand">LUXE <span>ATELIER</span></div>
  <ul class="nav-links">
    <li><a href="#">Showroom</a></li>
    <li><a href="#">Collections</a></li>
    <li><a href="#">Atelier</a></li>
    <li><a href="#">Journal</a></li>
  </ul>
  <div class="nav-acts">
    <button class="nav-btn"><span class="ms material-symbols-outlined">shopping_bag</span></button>
    <button class="nav-btn on"><span class="ms material-symbols-outlined">person</span></button>
  </div>
</nav>

<!-- ── SIDEBAR ── -->
<aside class="sidebar">
  <div class="sidebar-header">
    <h3>User Account</h3>
    <div class="sidebar-tier">
      <div class="tier-dot"></div>
    </div>
  </div>
  <nav class="sidebar-nav">
    <a href="/profile" class="sidebar-link active">
      <span class="material-symbols-outlined">person</span>
      <span>Profile</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">package_2</span>
      <span>My Orders</span>
    </a>
    <a href="/address" class="sidebar-link">
      <span class="material-symbols-outlined">distance</span>
      <span>Manage Address</span>
    </a>
    <a href="/changePassword" class="sidebar-link">
      <span class="material-symbols-outlined">lock_reset</span>
      <span>Change Password</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">favorite</span>
      <span>Wishlist</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">share_reviews</span>
      <span>Referral Link</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">account_balance_wallet</span>
      <span>Wallet</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">confirmation_number</span>
      <span>Coupons</span>
    </a>
  </nav>
  <div class="sidebar-footer">
    <a href="/logout">
  <span class="material-symbols-outlined">logout</span>
  <span>Sign Out</span>
</a>

  </div>
</aside>

<!-- ── MAIN ── -->
<main>
  <div class="page-header">
    <h1>My <em>Profile</em></h1>
    <p>View your personal details and membership status.</p>
  </div>

  <div class="profile-layout">

    <!-- LEFT: Avatar + Quick Stats -->
    <div class="left-card">
      <div class="avatar-banner"></div>
      <div class="avatar-wrap">
        <div class="avatar-ring">
          <img src="<%= user.avatar || '/images/default-avatar.png' %>" alt="<%= user.fullName %>"/>
          <div class="avatar-online"></div>
        </div>
        <div class="user-name"><%= user.fullName %></div>
        <div class="user-email"><%= user.email %></div>
        <a href="/profile/edit" class="edit-profile-btn">
          <span class="ms material-symbols-outlined">edit</span>
          Edit Profile
        </a>
      </div>
      
    </div>

    <!-- RIGHT: Details -->
    <div class="right-col">

      <!-- Personal Info -->
      <div class="detail-card">
        <div class="card-title"><span class="ms material-symbols-outlined">badge</span>Personal Information</div>
        <div class="detail-grid">
          <div class="detail-item">
            <div class="detail-label">Full Name</div>
            <div class="detail-value"><%= user.fullName %></div>
          </div>
          <div class="detail-item">
            <div class="detail-label">Phone Number</div>
            <div class="detail-value"><%= user.phoneNumber || '—' %></div>
          </div>
          <div class="detail-item">
            <div class="detail-label">Email Address</div>
            <div class="detail-value">
              <%= user.email %>
              
            </div>
          </div>
        
          
          
        </div>
      </div>

     
      


     

    </div>
  </div>
</main>
<script>
  function showToast(msg, type) {
    type = type || "success";
    const toast = document.createElement("div");
    toast.innerText = msg;
    toast.style.position = "fixed";
    toast.style.bottom = "20px";
    toast.style.right = "20px";
    toast.style.padding = "12px 16px";
    toast.style.borderRadius = "8px";
    toast.style.color = "#fff";
    toast.style.fontSize = "14px";
    toast.style.zIndex = "9999";
    toast.style.boxShadow = "0 8px 20px rgba(0,0,0,0.2)";
    toast.style.background = type === "success" ? "#22c55e" : "#ef4444";
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 3000);
  }

  document.addEventListener("DOMContentLoaded", () => {
    // typeof guard prevents crash when flash is not passed
    <% if (typeof flash !== 'undefined' && flash) { %>
      showToast("<%= flash.text %>", "<%= flash.type %>");
    <% } %>
  });
</script>

</body>
</html>
