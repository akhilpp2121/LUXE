    @keyframes spin { to { transform: rotate(360deg); } }
    .loading-text { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--text-3); }

    /* ── LAYOUT ── */
    .page { max-width: 1180px; margin: 0 auto; padding: 0 28px 90px; }

    /* ── HEADER ── */
    header {
