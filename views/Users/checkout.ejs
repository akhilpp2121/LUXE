<%
  /* ── SERVER-SIDE CALCULATIONS ── */
  const GST_RATE = 0.05;
  let subtotal     = 0;
  let totalSavings = 0;

  cart.forEach(p => {
    const v     = p.variantId;
    const inStk = (v?.stock ?? 0) > 0;
    const isInv = !v?.productId?.isActive || !v?.isActive || !inStk;
    if (!isInv) {
      const hasDiscount = v?.discount && v.discount < v?.price;
      const ep  = hasDiscount ? v.discount : (v?.price || 0);
      const op  = v?.price || 0;
      const qty = p.quantity || 1;
      subtotal     += ep * qty;
      totalSavings += hasDiscount ? ((op - ep) * qty) : 0;
    }
  });
  const gstAmount  = Math.round(subtotal * GST_RATE);
const shipping   = subtotal >= 999 ? 0 : 99;
const totalPrice = subtotal + totalSavings;
const grandTotal = subtotal + gstAmount + shipping;
const eligibleCoupons = (availableCoupons || []).filter(c => grandTotal >= (c.minOrderValue || 0));
%>

 

