<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Order <%= order[0].orderCode %> | THE DIGITAL ATELIER</title>
  <link rel="icon" type="image/x-icon" href="/favicon.png"/>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=DM+Serif+Display:ital@0;1&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet"/>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>

  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "surface":                   "#0b1326",
            "background":                "#0b1326",
            "surface-container":         "#171f33",
            "surface-container-low":     "#131b2e",
            "surface-container-high":    "#222a3d",
            "surface-container-highest": "#2d3449",
            "on-surface":                "#dae2fd",
            "on-surface-variant":        "#c4c5d7",
            "primary":                   "#b7c4ff",
            "primary-container":         "#1d4ed8",
            "on-primary-container":      "#cad3ff",
            "outline-variant":           "#434655",
            "outline":                   "#8e90a0",
            "error":                     "#ffb4ab",
            "error-container":           "#93000a",
          },
          fontFamily: {
            headline: ["Plus Jakarta Sans", "sans-serif"],
            serif:    ["DM Serif Display", "serif"],
            mono:     ["DM Mono", "monospace"],
          },
          borderRadius: {
            DEFAULT: "0.125rem",
            lg:      "0.25rem",
            xl:      "0.5rem",
            "2xl":   "0.75rem",
            full:    "9999px",
          },
        }
      }
    }
  </script>

  <style>
    * { box-sizing: border-box; }
    body { background-color: #0b1326; color: #dae2fd; font-family: "Plus Jakarta Sans", sans-serif; }
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24; }

    body::before {
      content: "";
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
      background-size: 200px 200px; opacity: .4;
    }
    main, nav, footer { position: relative; z-index: 1; }

    .glass { background: rgba(23,31,51,.6); backdrop-filter: blur(20px); border: 1px solid rgba(67,70,85,.4); }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(18px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .fade-up { opacity: 0; animation: fadeUp .55s cubic-bezier(.22,1,.36,1) forwards; }
    .d1 { animation-delay: .05s; } .d2 { animation-delay: .13s; }
    .d3 { animation-delay: .21s; } .d4 { animation-delay: .29s; }
    .d5 { animation-delay: .37s; } .d6 { animation-delay: .45s; }

    .item-row { border-bottom: 1px solid rgba(67,70,85,.3); transition: background .2s, transform .2s; }
    .item-row:hover { background: rgba(29,78,216,.06); transform: translateX(3px); }
    .item-row:last-child { border-bottom: none; }
    .item-row.is-cancelled:hover { transform: none; background: transparent; }

    @keyframes strikeIn { from { opacity: 1; } to { opacity: .38; } }
    .item-row.cancelling { animation: strikeIn .4s ease forwards; pointer-events: none; }

    .pill-transit   { background: rgba(183,196,255,.1); border: 1px solid rgba(183,196,255,.3); color: #b7c4ff; }
    .pill-completed { background: rgba(52,211,153,.1);  border: 1px solid rgba(52,211,153,.3);  color: #34d399; }
    .pill-cancelled { background: rgba(255,180,171,.1); border: 1px solid rgba(255,180,171,.3); color: #ffb4ab; }
    .pill-pending   { background: rgba(251,191,36,.1);  border: 1px solid rgba(251,191,36,.3);  color: #fbbf24; }
    .pill-shipped   { background: rgba(167,139,250,.1); border: 1px solid rgba(167,139,250,.3); color: #a78bfa; }
    .pill-returned  { background: rgba(52,211,153,.1);  border: 1px solid rgba(52,211,153,.3);  color: #34d399; }

    .step-done   { background: #1d4ed8; }
    .step-active { background: #0b1326; border: 2px solid #1d4ed8; }
    .step-future { background: #0b1326; border: 1px solid #434655; }
    .conn-full { background: #1d4ed8; }
    .conn-half { background: linear-gradient(90deg, #1d4ed8 50%, #222a3d 50%); }
    .conn-empty { background: #222a3d; }

    .da-modal {
      display: none; position: fixed; inset: 0; z-index: 200;
      background: rgba(6,14,32,.85); backdrop-filter: blur(8px);
      align-items: center; justify-content: center;
    }
    .da-modal.active { display: flex; }
    .da-modal-box {
      background: #131b2e; border: 1px solid #434655;
      border-radius: .5rem; max-width: 540px; width: 92%;
      animation: slideUp .3s cubic-bezier(.22,1,.36,1);
      max-height: 90vh; overflow-y: auto;
    }
    @keyframes slideUp {
      from { transform: translateY(28px); opacity: 0; }
      to   { transform: translateY(0); opacity: 1; }
    }

    .da-input {
      width: 100%; background: #0b1326; border: 1px solid #434655;
      color: #dae2fd; border-radius: .25rem;
      padding: .75rem 1rem; font-family: "Plus Jakarta Sans", sans-serif;
      font-size: .875rem; transition: border-color .2s; appearance: none;
    }
    .da-input:focus { outline: none; border-color: #1d4ed8; }
    .da-input option { background: #131b2e; }

    .qty-spinner {
      display: flex; align-items: center; gap: 0;
      border: 1px solid #434655; border-radius: .25rem; overflow: hidden;
      width: fit-content;
    }
    .qty-spinner button {
      background: #0b1326; border: none; color: #dae2fd;
      width: 36px; height: 36px; font-size: 1.1rem; cursor: pointer;
      transition: background .15s; flex-shrink: 0;
    }
    .qty-spinner button:hover { background: #222a3d; }
    .qty-spinner button:disabled { opacity: .3; cursor: not-allowed; }
    .qty-spinner input {
      background: #0b1326; border: none; border-left: 1px solid #434655;
      border-right: 1px solid #434655; color: #dae2fd;
      width: 52px; height: 36px; text-align: center;
      font-family: "DM Mono", monospace; font-size: .875rem;
      -moz-appearance: textfield;
    }
    .qty-spinner input::-webkit-outer-spin-button,
    .qty-spinner input::-webkit-inner-spin-button { -webkit-appearance: none; }
    .qty-spinner input:focus { outline: none; }

    .btn-atelier {
      display: inline-flex; align-items: center; gap: .5rem;
      padding: .7rem 1.6rem; border-radius: .25rem;
      font-family: "Plus Jakarta Sans", sans-serif;
      font-size: .75rem; font-weight: 700; letter-spacing: .1em;
      text-transform: uppercase; transition: all .2s; cursor: pointer;
    }
    .btn-primary-da  { background: #1d4ed8; color: #cad3ff; border: none; }
    .btn-primary-da:hover  { opacity: .9; transform: translateY(-1px); }
    .btn-ghost-da    { background: transparent; color: #dae2fd; border: 1px solid #434655; }
    .btn-ghost-da:hover    { background: rgba(255,255,255,.04); }
    .btn-danger-da   { background: transparent; color: #ffb4ab; border: 1px solid rgba(255,180,171,.3); }
    .btn-danger-da:hover   { background: rgba(255,180,171,.06); }
    .btn-atelier:disabled  { opacity: .4; cursor: not-allowed; transform: none !important; }

    @keyframes totalFlash {
      0%   { color: #34d399; }
      100% { color: #dae2fd; }
    }
    .total-flash { animation: totalFlash .8s ease; }

    .swal2-popup   { background: #131b2e !important; color: #dae2fd !important; border: 1px solid #434655 !important; }
    .swal2-title   { color: #dae2fd !important; font-family: "Plus Jakarta Sans" !important; }
    .swal2-confirm { background: #1d4ed8 !important; font-family: "Plus Jakarta Sans" !important; }
    .swal2-cancel  { background: #222a3d !important; color: #dae2fd !important; font-family: "Plus Jakarta Sans" !important; }
  </style>
  <link rel="stylesheet" href="/css/navigation-consistency.css" />
</head>
<body>

<%
  var ord         = order[0];
  var orderItems  = ord.orderItems  || [];
  var cancelledAt = ord.cancelledAt || [];
  var returnedAt  = ord.returnedAt  || [];
  var shipAddr    = ord.shippingAddress || {};

  var delivSt  = (ord.deliveryStatus || 'pending').toLowerCase();
  var orderSt  = (ord.orderStatus || '').toLowerCase();

  var stepOrder  = ['pending', 'shipped', 'out_for_delivery', 'delivered'];
  var currentIdx = stepOrder.indexOf(delivSt) >= 0 ? stepOrder.indexOf(delivSt) : 0;

  var pillClass = orderSt === 'completed' ? 'pill-completed'
                : orderSt === 'cancelled' ? 'pill-cancelled'
                : orderSt === 'returned'  ? 'pill-returned'
                : delivSt === 'shipped'   ? 'pill-shipped'
                : delivSt === 'out_for_delivery' ? 'pill-transit'
                : 'pill-pending';

  var pillLabel = orderSt === 'completed' ? 'Completed'
                : orderSt === 'cancelled' ? 'Cancelled'
                : orderSt === 'returned'  ? 'Returned'
                : delivSt === 'out_for_delivery' ? 'Out for Delivery'
                : delivSt === 'shipped'   ? 'Shipped'
                : 'Pending';

  var dotAnim = (orderSt !== 'completed' && orderSt !== 'cancelled' && orderSt !== 'returned') ? 'animate-pulse' : '';

  // Cancelled variant IDs
  var cancelledVIds = {};
  cancelledAt.forEach(function(ca) {
    (ca.cancelledProducts || []).forEach(function(cp) {
      var cpId = cp && cp._id ? cp._id.toString() : String(cp);
      cancelledVIds[cpId] = true;
    });
  });

  // Returned variant IDs
  var returnedVIds = {};
  returnedAt.forEach(function(r) {
    if (r.variant) returnedVIds[r.variant.toString()] = true;
  });

  function resolveItem(item) {
    var variant   = item.variantId && typeof item.variantId === 'object' ? item.variantId : null;
    var variantId = variant ? variant._id.toString() : String(item.variantId || '');
    var images    = variant ? (variant.images || variant.image || []) : [];
    var thumb     = images[0] ? '/uploads/' + images[0] : '/images/placeholder.png';
    var sku       = variant && variant.SKU ? variant.SKU : variantId.slice(-8).toUpperCase();

    // item-level only — do NOT fall back to ord.deliveryStatus
    var itemStatus = item.deliveryStatus || 'pending';

    var cancelled = cancelledVIds[variantId] || !!item.isCancelled || itemStatus === 'cancelled';

    // Calculate total quantity of this variant already returned/pending (exclude Rejected)
    // and track whether ANY return request (of any status) exists for this variant.
    var activeReturnedQty  = 0;
    // Quantity actually refunded (Approved only) — this is the basis for money
    // math (subtotal/GST/total), since a Pending return hasn't been refunded
    // yet and a Rejected one was never refunded at all. This must match
    // updateReturnRequestService, which only deducts value on Approval.
    var approvedReturnedQty = 0;
    var returnStatus       = null;
    var adminRemark        = null;
    var lastRet             = null;
    var hasReturnRequest   = false;

    returnedAt.forEach(function(r) {
      if (r.variant && r.variant.toString() === variantId) {
        hasReturnRequest = true;
        if (r.returnRequestStatus !== 'Rejected') {
          activeReturnedQty += (r.quantity || 1);
        }
        if (r.returnRequestStatus === 'Approved') {
          approvedReturnedQty += (r.quantity || 1);
        }
        lastRet = r;
      }
    });

    if (lastRet) {
      returnStatus = lastRet.returnRequestStatus || 'Pending';
      adminRemark  = lastRet.adminRemark || null;
    }

    var returned = activeReturnedQty >= item.quantity || itemStatus === 'returned';
    var remainingReturnableQty = item.quantity - activeReturnedQty;

    // cancel status label
    var cancelStatus = 'Cancelled';
    if (cancelled) {
      var foundCa = null;
      for (var ci = 0; ci < cancelledAt.length; ci++) {
        var ca = cancelledAt[ci];
        var prods = ca.cancelledProducts || [];
        for (var pi = 0; pi < prods.length; pi++) {
          var cp = prods[pi];
          var cpId = cp && cp._id ? cp._id.toString() : String(cp);
          if (cpId === variantId) { foundCa = ca; break; }
        }
        if (foundCa) break;
      }
      if (foundCa) cancelStatus = foundCa.cancelRequestStatus || 'Cancelled';
    }

    // cancel only if item is still pending
    var canCancelItem = !cancelled && !returned && itemStatus === 'pending';

    // return only if item is delivered, has remaining quantity, AND no return
    // request (pending / approved / rejected) has ever been made for it.
    // Previously a Rejected request left remainingReturnableQty at full
    // quantity, so the Return button reappeared after rejection — fixed
    // by gating on hasReturnRequest as well.
    var canReturnItem = !cancelled && !hasReturnRequest && remainingReturnableQty > 0 && itemStatus === 'delivered';

    return {
      variantId: variantId,
      thumb: thumb,
      sku: sku,
      cancelled: cancelled,
      cancelStatus: cancelStatus,
      returned: returned,
      returnStatus: returnStatus,
      hasReturnRequest: hasReturnRequest,
      approvedReturnedQty: approvedReturnedQty,
      adminRemark: adminRemark,
      itemStatus: itemStatus,
      canCancelItem: canCancelItem,
      canReturnItem: canReturnItem,
      remainingReturnableQty: remainingReturnableQty
    };
  }

  var canCancelAll = orderItems.length > 0;
  if (canCancelAll) {
    var hasPending = false;
    for (var i = 0; i < orderItems.length; i++) {
      var s = orderItems[i].deliveryStatus || 'pending';
      if (s !== 'pending' && s !== 'cancelled') { canCancelAll = false; break; }
      if (s === 'pending') hasPending = true;
    }
    if (!hasPending) canCancelAll = false;
  }

  // ── Original subtotal: ALL items at their charged line total. This is the
  // fixed basis the coupon was originally applied against — it must NOT
  // change as items get cancelled/returned, or the coupon proration ratio
  // below would drift with every cancellation. ──
  var originalSubTotal = 0;
  for (var i = 0; i < orderItems.length; i++) {
    originalSubTotal += (orderItems[i].totalPrice || 0);
  }

  // ── Active subtotal: exclude cancelled items entirely; for items with an
  // Approved return, subtract only the refunded quantity's value so a
  // partial return correctly leaves the remaining quantity "active". This
  // uses the SAME per-unit math (totalPrice / quantity) as
  // updateReturnRequestService's unitValue, so this total and any refund
  // issued for the item always agree. ──
  var activeSubTotal = 0;
  for (var i = 0; i < orderItems.length; i++) {
    var ri = resolveItem(orderItems[i]);
    if (ri.cancelled) continue;
    var unitValue = orderItems[i].totalPrice / orderItems[i].quantity;
    var remainingQty = Math.max(orderItems[i].quantity - ri.approvedReturnedQty, 0);
    activeSubTotal += unitValue * remainingQty;
  }

  // ---- BUGFIX: empty cart / fully-cancelled-or-returned cart must not carry
  // shipping or coupon discount into the total — otherwise the total can go
  // negative. hasActiveItems is true only when at least one item still
  // contributes a positive amount to the subtotal.
  var hasActiveItems = orderItems.length > 0 && activeSubTotal > 0;


  var couponDiscount = 0;
if (hasActiveItems && ord.couponApplied > 0) {
  couponDiscount = Math.min(ord.couponApplied, activeSubTotal);
}

  
  
  // ---- BUGFIX: GST must be computed on the TAXABLE value (active subtotal
  // minus its share of the coupon), matching updateReturnRequestService's
  // itemGst basis. Previously GST was taxed on the pre-coupon active
  // subtotal, which meant a per-item refund never quite matched what that
  // item had contributed to this order's Grand Total.
  var GST_RATE = 0.05;
  var taxableValue = Math.max(activeSubTotal - couponDiscount, 0);
  var gstAmount     = Math.round(taxableValue * GST_RATE);

  // ---- BUGFIX: shipping must be recomputed from the live active subtotal
  // against the free-shipping threshold (₹999), not pulled straight from
  // the stored ord.shippingCharge. Below ₹999 → ₹99 charged; ₹999 or above
  // → free. Never charged at all when there are no active items.
  var SHIPPING_THRESHOLD = 999;
  var SHIPPING_FEE       = 99;
  var shippingCharge = hasActiveItems
    ? (activeSubTotal >= SHIPPING_THRESHOLD ? 0 : SHIPPING_FEE)
    : 0;

  var activeTotalRaw = taxableValue + gstAmount + shippingCharge;
  // Final safety net: total should never display as negative.
  var activeTotal    = +(Math.max(0, activeTotalRaw)).toFixed(2);

  // Items eligible to return
  var returnableItems = [];
  for (var i = 0; i < orderItems.length; i++) {
    var ri = resolveItem(orderItems[i]);
    if (ri.canReturnItem) returnableItems.push(orderItems[i]);
  }

  // Pending cancel requests
  var pendingCancels = [];
  for (var i = 0; i < cancelledAt.length; i++) {
    if (cancelledAt[i].cancelRequestStatus === 'Pending') pendingCancels.push(cancelledAt[i]);
  }

  var cancelledVIdCount = Object.keys(cancelledVIds).length;
%>

<main class="pt-28 pb-24 px-6 md:px-12 max-w-[1400px] mx-auto min-h-screen">

  <!-- Back -->
  <div class="mb-10 fade-up d1">
  <a href="/order/my-orders" class="inline-flex items-center gap-2 text-[11px] uppercase tracking-[.18em] font-bold text-on-surface-variant hover:text-primary transition-colors group">
    <span class="material-symbols-outlined text-sm group-hover:-translate-x-1 transition-transform">arrow_back</span>
    Order Archive
  </a>
  <a href="/" class="ml-6 inline-flex items-center gap-2 text-[11px] uppercase tracking-[.18em] font-bold text-on-surface-variant hover:text-primary transition-colors group">
    <span class="material-symbols-outlined text-sm group-hover:-translate-x-1 transition-transform">arrow_back</span>
    Back to Home
  </a>
</div>

  <!-- Page Header -->
  <header class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-8 fade-up d2">
    <div>
      <p class="text-[10px] uppercase tracking-[.25em] text-primary/60 mb-2 font-semibold">Order Identity</p>
      <h1 class="font-serif text-5xl md:text-6xl text-white leading-none mb-3"><%= ord.orderCode %></h1>

      <div class="flex flex-wrap items-center gap-4 text-sm text-on-surface-variant">
        <span class="flex items-center gap-1.5">
          <span class="material-symbols-outlined text-base">calendar_today</span>
          <%= new Date(ord.orderDate).toDateString() %>
        </span>
        <% if (ord.expectedDeliveryDate) { %>
          <span class="text-outline-variant">·</span>
          <span class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-base">local_shipping</span>
            Est. <%= new Date(ord.expectedDeliveryDate).toDateString() %>
          </span>
        <% } %>
      </div>

      <!-- Order status pill -->
      <div class="mt-4 inline-flex items-center gap-2.5 px-4 py-2 rounded-full <%= pillClass %>">
        <span class="w-1.5 h-1.5 rounded-full bg-current <%= dotAnim %>"></span>
        <span class="text-[10px] uppercase tracking-[.18em] font-bold"><%= pillLabel %></span>
      </div>

      <!-- Pending cancel requests banner -->
      <% if (pendingCancels.length > 0) { %>
        <div class="mt-4 flex items-center gap-3 px-4 py-3 bg-yellow-500/5 border border-yellow-500/20 rounded text-sm text-yellow-400/90">
          <span class="material-symbols-outlined text-base text-yellow-400">hourglass_top</span>
          <%= pendingCancels.length %> cancel request<%= pendingCancels.length > 1 ? 's' : '' %> pending approval
        </div>
      <% } %>

      <!-- Last cancel status (non-pending) -->
      <% if (cancelledAt.length > 0) { %>
        <% var lastCancel = cancelledAt[cancelledAt.length - 1]; %>
        <% if (lastCancel.cancelRequestStatus !== 'Pending') { %>
          <div class="mt-4 flex items-center gap-3 px-4 py-3 bg-error-container/10 border border-error/20 rounded text-sm text-error/80">
            <span class="material-symbols-outlined text-base text-error">info</span>
            Cancel request: <%= new Date(lastCancel.requestedAt).toLocaleString("en-IN") %>
            <span class="ml-2 px-2 py-0.5 bg-error/10 rounded text-[10px] uppercase tracking-wider"><%= lastCancel.cancelRequestStatus %></span>
          </div>
        <% } %>
      <% } %>
    </div>

    <!-- Actions -->
    <div class="flex flex-wrap gap-3">
      <a href="/order/invoice/<%= ord._id %>">
        <button class="btn-atelier btn-ghost-da">
          <span class="material-symbols-outlined text-base">receipt_long</span>
          Download Invoice
        </button>
      </a>
    </div>
  </header>

  <!-- Progress Tracker -->
  <% if (orderSt !== 'cancelled' && orderSt !== 'returned') { %>
    <%
      var steps = [
        { label: 'Confirmed',        icon: 'check'          },
        { label: 'Shipped',          icon: 'local_shipping' },
        { label: 'Out for Delivery', icon: 'package_2'      },
        { label: 'Delivered',        icon: 'verified'       },
      ];
    %>
    <div class="mb-16 glass rounded-xl p-8 md:p-10 fade-up d3">
      <div class="flex justify-between items-center mb-10">
        <% for (var si = 0; si < steps.length; si++) { %>
          <% var step = steps[si]; %>
          <% var isDone = si < currentIdx; var isActive = si === currentIdx; %>
          <div class="flex flex-col items-center gap-3 relative z-10">
            <% if (isDone) { %>
              <div class="w-10 h-10 rounded-full step-done flex items-center justify-center shadow-lg shadow-blue-900/30">
                <span class="material-symbols-outlined text-sm text-white"><%= step.icon %></span>
              </div>
              <span class="text-[9px] uppercase tracking-widest font-bold text-white hidden sm:block"><%= step.label %></span>
            <% } else if (isActive) { %>
              <div class="w-10 h-10 rounded-full step-active flex items-center justify-center">
                <span class="material-symbols-outlined text-sm text-primary"><%= step.icon %></span>
              </div>
              <span class="text-[9px] uppercase tracking-widest font-bold text-primary hidden sm:block"><%= step.label %></span>
            <% } else { %>
              <div class="w-10 h-10 rounded-full step-future flex items-center justify-center">
                <span class="material-symbols-outlined text-sm text-on-surface-variant"><%= step.icon %></span>
              </div>
              <span class="text-[9px] uppercase tracking-widest font-bold text-on-surface-variant/40 hidden sm:block"><%= step.label %></span>
            <% } %>
          </div>
          <% if (si < steps.length - 1) { %>
            <%
              var connClass = si < currentIdx - 1 ? 'conn-full'
                            : si === currentIdx - 1 ? 'conn-half'
                            : 'conn-empty';
            %>
            <div class="flex-1 h-px mx-2 relative overflow-hidden rounded">
              <div class="absolute inset-0 <%= connClass %>"></div>
            </div>
          <% } %>
        <% } %>
      </div>

      <div class="pt-8 border-t border-outline-variant/20 flex items-start gap-5">
        <div class="w-11 h-11 rounded-xl bg-primary-container/10 flex items-center justify-center flex-shrink-0">
          <span class="material-symbols-outlined text-primary">history</span>
        </div>
        <div>
          <% if (delivSt === 'pending') { %>
            <p class="text-white font-semibold font-headline">Order confirmed — being prepared</p>
            <p class="text-on-surface-variant text-sm mt-0.5">Placed <%= new Date(ord.orderDate).toLocaleString("en-IN") %></p>
          <% } else if (delivSt === 'shipped') { %>
            <p class="text-white font-semibold font-headline">Order packed and dispatched</p>
            <p class="text-on-surface-variant text-sm mt-0.5">Est. delivery <%= ord.expectedDeliveryDate ? new Date(ord.expectedDeliveryDate).toDateString() : 'TBD' %></p>
          <% } else if (delivSt === 'out_for_delivery') { %>
            <p class="text-white font-semibold font-headline">Out for delivery — arriving today</p>
            <p class="text-on-surface-variant text-sm mt-0.5">Your order is with the delivery partner</p>
          <% } else if (delivSt === 'delivered') { %>
            <p class="text-white font-semibold font-headline">Delivered successfully</p>
            <p class="text-on-surface-variant text-sm mt-0.5">Thank you for shopping with The Digital Atelier</p>
          <% } %>
        </div>
      </div>
    </div>

  <% } else if (orderSt === 'cancelled') { %>
    <div class="mb-16 flex items-center gap-5 px-8 py-6 bg-error-container/10 border border-error/20 rounded-xl fade-up d3">
      <div class="w-11 h-11 rounded-xl bg-error/10 flex items-center justify-center flex-shrink-0">
        <span class="material-symbols-outlined text-error">cancel</span>
      </div>
      <div>
        <p class="text-error font-bold font-headline uppercase tracking-wide text-sm">Order Cancelled</p>
        <% if (cancelledAt.length > 0) { %>
          <p class="text-on-surface-variant text-sm"><%= new Date(cancelledAt[cancelledAt.length-1].requestedAt).toLocaleString("en-IN") %></p>
        <% } %>
      </div>
    </div>
  <% } else if (orderSt === 'returned') { %>
    <div class="mb-16 flex items-center gap-5 px-8 py-6 bg-primary/5 border border-primary/20 rounded-xl fade-up d3">
      <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0">
        <span class="material-symbols-outlined text-primary">undo</span>
      </div>
      <div>
        <p class="text-primary font-bold font-headline uppercase tracking-wide text-sm">Order Returned</p>
        <% if (returnedAt.length > 0) { %>
          <p class="text-on-surface-variant text-sm"><%= new Date(returnedAt[returnedAt.length-1].requestedAt).toLocaleString("en-IN") %></p>
        <% } %>
      </div>
    </div>
  <% } %>

  <!-- Shipped hint -->
  <% if (delivSt === 'shipped' || delivSt === 'out_for_delivery') { %>
    <div class="mb-8 flex items-center gap-4 px-6 py-4 bg-primary-container/5 border border-primary/15 rounded-xl fade-up d3">
      <span class="material-symbols-outlined text-primary flex-shrink-0">info</span>
      <p class="text-on-surface-variant text-sm">
        Your order is <span class="text-white font-semibold">
          <%= delivSt === 'out_for_delivery' ? 'out for delivery' : 'shipped' %>
        </span> — cancellations are no longer available at this stage.
      </p>
    </div>
  <% } %>

  <!-- Main Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">

    <!-- LEFT: Items -->
    <div class="lg:col-span-8 fade-up d4">
      <div class="flex items-end justify-between mb-6">
        <h2 class="font-headline font-bold text-xl text-white">
          Consignment Items
          <span class="font-mono text-sm text-on-surface-variant ml-2">(<%= String(orderItems.length).padStart(2,'0') %>)</span>
        </h2>

        <% if (canCancelAll && orderItems.length > 1) { %>
          <button onclick="openCancelALLModal('ALL','<%= ord._id %>')" class="btn-atelier btn-danger-da text-[10px]">
            <span class="material-symbols-outlined text-sm">delete_sweep</span>
            Cancel All
          </button>
        <% } %>
      </div>

      <div class="glass rounded-xl overflow-hidden" id="itemList">
        <% for (var ii = 0; ii < orderItems.length; ii++) { %>
          <% var item = orderItems[ii]; %>
          <% var r = resolveItem(item); %>
          <div class="item-row p-6 flex flex-col sm:flex-row gap-6 items-start sm:items-center <%= r.cancelled ? 'is-cancelled opacity-40' : '' %>"
               id="item-row-<%= r.variantId %>"
               data-price="<%= item.totalPrice || 0 %>"
               data-qty="<%= item.quantity || 1 %>"
               data-cancelled="<%= r.cancelled ? 'true' : 'false' %>">

            <!-- Thumbnail -->
            <div class="w-20 h-28 bg-surface-container-highest rounded-sm overflow-hidden flex-shrink-0">
              <img src="<%= r.thumb %>" alt="<%= item.productName %>"
                   class="w-full h-full object-cover <%= r.cancelled ? 'grayscale opacity-50' : 'grayscale hover:grayscale-0 transition-all duration-700' %>"/>
            </div>

            <!-- Info -->
            <div class="flex-grow min-w-0">
              <div class="flex flex-wrap justify-between items-start gap-2 mb-3">
                <div>
                  <h3 class="text-white font-headline font-semibold uppercase tracking-tight leading-tight text-base">
                    <%= item.productName %>

                    <% if (r.cancelled) { %>
                      <span class="ml-2 inline-flex items-center gap-1 px-2 py-0.5 bg-error/10 border border-error/20 text-error text-[9px] uppercase tracking-widest rounded font-bold">
                        <span class="material-symbols-outlined text-xs">block</span>
                        <%= r.cancelStatus %>
                      </span>
                    <% } %>

                    <% if (r.hasReturnRequest) { %>
                      <span class="ml-2 inline-flex items-center gap-1 px-2 py-0.5 bg-primary/10 border border-primary/20 text-primary text-[9px] uppercase tracking-widest rounded font-bold">
                        <span class="material-symbols-outlined text-xs">undo</span>
                        Return <%= r.returnStatus %>
                      </span>
                    <% } %>
                  </h3>
                  <p class="font-mono text-[11px] text-on-surface-variant mt-1">
                    SKU: <%= r.sku %>
                    <% if (item.variantName) { %> · <%= item.variantName %><% } %>
                  </p>
                  <p class="font-mono text-[10px] text-on-surface-variant/70 uppercase tracking-widest mt-1">
                    Status: <span class="text-primary"><%= r.itemStatus.replace(/_/g, ' ') %></span>
                  </p>
                  <% if (r.hasReturnRequest && r.adminRemark) { %>
                    <p class="text-xs text-error mt-2 font-medium">
                      Return Remark: <span class="text-on-surface-variant"><%= r.adminRemark %></span>
                    </p>
                  <% } %>
                </div>

                <div class="text-right">
                  <span class="text-xl font-headline font-black <%= r.cancelled ? 'line-through text-on-surface-variant' : 'text-white' %>">
                    &#8377;<%= item.totalPrice %>
                  </span>
                  <% if (r.cancelled) { %>
                    <p class="text-[10px] text-on-surface-variant/60 uppercase tracking-wider mt-0.5">Not charged</p>
                  <% } %>
                </div>
              </div>

              <div class="flex flex-wrap gap-6 text-[10px] uppercase tracking-widest font-semibold text-on-surface-variant">
                <div>Unit Price <span class="text-white ml-1">&#8377;<%= item.price %></span></div>
                <div>Qty <span class="text-white ml-1"><%= String(item.quantity).padStart(2,'0') %></span></div>
              </div>
            </div>

            <!-- Per-item actions -->
            <div class="flex flex-col gap-2 flex-shrink-0" id="cancel-btn-wrap-<%= r.variantId %>">

              <% if (r.canCancelItem ) { %>
                <button onclick="openCancelModal('<%= r.variantId %>','<%= ord._id %>')"
                  class="btn-atelier btn-danger-da text-[10px] py-2 px-3">
                  <span class="material-symbols-outlined text-sm">close</span>
                  Cancel
                </button>
              <% } %>

              <!--
                Return button only shows when canReturnItem is true, which now
                requires hasReturnRequest === false. Once a request exists
                (Pending, Approved, or Rejected) the button is gone for good
                and one of the status badges below is shown instead.
              -->
              <% if (r.canReturnItem) { %>
                <button data-return-btn
                  onclick="openReturnModal('<%= ord._id %>', '<%= r.variantId %>', '<%= item.productName %>', <%= r.remainingReturnableQty %>)"
                  class="btn-atelier btn-ghost-da text-[10px] py-2 px-3">
                  <span class="material-symbols-outlined text-sm">undo</span>
                  Return
                </button>
              <% } %>

              <% if (r.hasReturnRequest) { %>
                <% if (r.returnStatus === 'Pending') { %>
                  <span class="btn-atelier btn-ghost-da text-[10px] py-2 px-3 opacity-50 cursor-not-allowed">
                    <span class="material-symbols-outlined text-sm">hourglass_top</span>
                    Return Requested
                  </span>
                <% } else if (r.returnStatus === 'Approved') { %>
                  <span class="btn-atelier btn-ghost-da text-[10px] py-2 px-3 opacity-50 cursor-not-allowed">
                    <span class="material-symbols-outlined text-sm">check_circle</span>
                    Returned
                  </span>
                <% } else if (r.returnStatus === 'Rejected') { %>
                  <span class="btn-atelier btn-ghost-da text-[10px] py-2 px-3 opacity-50 cursor-not-allowed">
                    <span class="material-symbols-outlined text-sm">cancel</span>
                    Return Rejected
                  </span>
                <% } %>
              <% } %>

              <% if (!r.cancelled && !r.hasReturnRequest && (r.itemStatus === 'shipped' || r.itemStatus === 'out_for_delivery')) { %>
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-primary/5 border border-primary/20 text-primary text-[9px] uppercase tracking-widest font-bold">
                  <span class="material-symbols-outlined text-xs">local_shipping</span>
                  In Transit
                </span>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>

      <!-- Return All CTA -->
      <% if (returnableItems.length > 1) { %>
        <div class="mt-8 glass rounded-xl p-6 flex flex-col sm:flex-row justify-between items-center gap-6 border-l-4 border-primary-container">
          <div class="flex items-center gap-5">
            <div class="w-12 h-12 rounded-xl bg-primary-container/10 flex items-center justify-center flex-shrink-0">
              <span class="material-symbols-outlined text-primary">package_2</span>
            </div>
            <div>
              <p class="text-white font-headline font-bold tracking-tight">Return multiple items?</p>
              <p class="text-on-surface-variant text-sm mt-0.5">
                <%= returnableItems.length %> item<%= returnableItems.length > 1 ? 's' : '' %> eligible · within 30 days of delivery.
              </p>
            </div>
          </div>
          <button onclick="openReturnModal('<%= ord._id %>', 'ALL', 'All Items', 0)" class="btn-atelier btn-primary-da whitespace-nowrap">
            <span class="material-symbols-outlined text-base">undo</span>
            Return All
          </button>
        </div>
      <% } %>

      <!-- Return status banners -->
      <% if (returnedAt.length > 0) { %>
        <div class="mt-8 space-y-4">
          <% for (var reti = 0; reti < returnedAt.length; reti++) { %>
            <% var ret = returnedAt[reti]; %>
            <% var retApproved = ret.returnRequestStatus === 'Approved'; %>
            <% var retPending  = ret.returnRequestStatus === 'Pending'; %>
            <% var retBorder   = retApproved ? 'border-green-500' : retPending ? 'border-primary-container' : 'border-error'; %>
            <% var retBg       = retApproved ? 'bg-green-500/10'  : retPending ? 'bg-primary-container/10'  : 'bg-error/10'; %>
            <% var retColor    = retApproved ? 'text-green-400'   : retPending ? 'text-primary'             : 'text-error'; %>
            <% var retIcon     = retApproved ? 'check_circle' : retPending ? 'hourglass_top' : 'cancel'; %>
            <%
              var retItem = null;
              var retVariantStr = ret.variant ? ret.variant.toString() : '';
              for (var rij = 0; rij < orderItems.length; rij++) {
                var oi = orderItems[rij];
                var oiVid = oi.variantId && oi.variantId.toString ? oi.variantId.toString() : '';
                if (oiVid === retVariantStr) { retItem = oi; break; }
              }
              var retName = retItem ? retItem.productName : 'Item';
            %>
            <div class="glass rounded-xl p-5 flex items-start gap-5 border-l-4 <%= retBorder %>">
              <div class="w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0 <%= retBg %>">
                <span class="material-symbols-outlined <%= retColor %>"><%= retIcon %></span>
              </div>
              <div class="flex-grow">
                <div class="flex items-center justify-between gap-4 flex-wrap">
                  <p class="text-white font-headline font-bold tracking-tight">Return: <%= retName %></p>
                  <span class="px-2 py-0.5 rounded text-[10px] uppercase tracking-widest font-bold
                    <%= retApproved ? 'bg-green-500/10 text-green-400' : retPending ? 'bg-primary/10 text-primary' : 'bg-error/10 text-error' %>">
                    <%= ret.returnRequestStatus %>
                  </span>
                </div>
                <p class="text-on-surface-variant text-sm mt-1">
                  Qty: <span class="text-white font-semibold"><%= ret.quantity || '—' %></span>
                  · Reason: <span class="text-white"><%= ret.reason %></span>
                  · Resolution: <span class="text-white"><%= ret.resolution %></span>
                </p>
                <% if (ret.adminRemark) { %>
                  <p class="text-on-surface-variant/70 text-xs mt-1">Admin note: <span class="text-on-surface-variant"><%= ret.adminRemark %></span></p>
                <% } %>
                <p class="text-on-surface-variant/50 text-xs mt-1"><%= new Date(ret.requestedAt).toLocaleString("en-IN") %></p>
              </div>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- RIGHT: Info -->
    <div class="lg:col-span-4 space-y-8 fade-up d5">

      <!-- Shipping -->
      <section>
        <p class="text-[10px] uppercase tracking-[.22em] font-bold text-primary mb-4">Shipping Destination</p>
        <div class="glass rounded-xl p-6">
          <div class="flex items-start gap-4">
            <span class="material-symbols-outlined text-primary mt-0.5">location_on</span>
            <div class="space-y-1">
              <p class="text-white font-headline font-bold uppercase tracking-tight"><%= shipAddr.username || 'N/A' %></p>
              <p class="text-on-surface-variant text-sm leading-relaxed">
                <%= shipAddr.street_address || '' %><br/>
                <% if (shipAddr.landmark) { %><%= shipAddr.landmark %><br/><% } %>
                <%= shipAddr.city || '' %>, <%= shipAddr.state || '' %><br/>
                <%= shipAddr.country || '' %><% if (shipAddr.postal_code) { %> — <%= shipAddr.postal_code %><% } %>
              </p>
              <% if (shipAddr.phone_number) { %>
                <p class="text-on-surface-variant text-xs flex items-center gap-1 pt-1">
                  <span class="material-symbols-outlined text-xs">call</span><%= shipAddr.phone_number %>
                </p>
              <% } %>
            </div>
          </div>
        </div>
      </section>

      <!-- Payment -->
      <section>
        <p class="text-[10px] uppercase tracking-[.22em] font-bold text-primary mb-4">Payment Method</p>
        <div class="glass rounded-xl p-6">
          <div class="flex items-center gap-4">
            <div class="w-12 h-8 bg-surface-container rounded border border-outline-variant/30 flex items-center justify-center">
              <span class="material-symbols-outlined text-sm text-on-surface-variant">payments</span>
            </div>
            <p class="text-white font-headline font-bold uppercase tracking-tight text-sm"><%= (ord.orderMethod || 'N/A').toUpperCase() %></p>
          </div>
        </div>
      </section>

      <!-- Financial Summary -->
      <section>
        <p class="text-[10px] uppercase tracking-[.22em] font-bold text-primary mb-4">Financial Summary</p>
        <div class="glass rounded-xl p-6 space-y-4">
          <div class="space-y-3" id="summaryLines">

            <div class="flex justify-between text-sm">
              <span class="text-on-surface-variant">Subtotal</span>
              <span class="text-white font-medium" id="displaySubtotal">&#8377;<%= activeSubTotal.toFixed(2) %></span>
            </div>

            <% if (couponDiscount > 0) { %>
              <div class="flex justify-between text-sm">
                <span class="text-on-surface-variant">Coupon</span>
                <span class="text-primary font-medium" id="displayCoupon">&#8722;&#8377;<%= couponDiscount.toFixed(2) %></span>
              </div>
            <% } %>

            <div class="flex justify-between text-sm">
              <span class="text-on-surface-variant flex items-center gap-1.5">
                GST
                <span class="px-1.5 py-0.5 bg-yellow-500/10 border border-yellow-500/20 text-yellow-400 text-[9px] uppercase tracking-widest rounded font-bold">5%</span>
              </span>
              <span class="text-yellow-400 font-medium" id="displayGst">+ &#8377;<%= gstAmount.toFixed(2) %></span>
            </div>

            <div class="flex justify-between text-sm">
              <span class="text-on-surface-variant">Shipping</span>
              <span id="displayShipping" class="<%= shippingCharge === 0 ? 'text-primary font-bold' : 'text-white font-medium' %>">
                <%= shippingCharge === 0 ? 'FREE' : '&#8377;' + shippingCharge.toFixed(2) %>
              </span>
            </div>
          </div>

          <div class="border-t border-outline-variant/20"></div>
          <p class="text-[10px] text-on-surface-variant/40 tracking-wide">GST of 5% applied on the coupon-discounted taxable subtotal · Free shipping over &#8377;999</p>

          <div class="flex justify-between items-end">
            <span class="text-[10px] uppercase tracking-[.15em] font-bold text-white">Grand Total</span>
            <span class="font-serif text-3xl text-white" id="displayTotal">&#8377;<%= activeTotal.toFixed(2) %></span>
          </div>

          <% if (cancelledVIdCount > 0) { %>
            <p class="text-[10px] text-on-surface-variant/50 text-right -mt-2">Cancelled / returned items excluded</p>
          <% } %>
        </div>
      </section>
    </div>
  </div>
</main>

<footer class="relative z-10 mt-20 py-10 px-12 border-t border-outline-variant/10 text-center">
  <p class="text-[10px] uppercase tracking-[.4em] font-bold text-on-surface-variant/30">© 2024 THE DIGITAL ATELIER · ALL RIGHTS RESERVED</p>
</footer>


<!-- MODAL: Cancel Single Item -->
<div id="cancelModal" class="da-modal">
  <div class="da-modal-box">
    <div class="p-7">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 rounded-xl bg-error/10 flex items-center justify-center">
            <span class="material-symbols-outlined text-error text-lg">warning</span>
          </div>
          <h2 class="font-headline font-bold text-white text-lg uppercase tracking-tight">Cancel Item</h2>
        </div>
        <button onclick="closeCancelModal()" class="text-on-surface-variant hover:text-white p-1">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <p class="text-on-surface-variant text-sm mb-5">This cannot be undone. Refund processed in 5–7 business days.</p>
      <input type="hidden" id="variantId"/>
      <input type="hidden" id="orderId"/>
      <div class="space-y-4">
        <div>
          <label class="block text-[10px] uppercase tracking-widest font-bold text-on-surface-variant mb-2">Reason *</label>
          <select id="reason" class="da-input">
            <option value="">Select a reason</option>
            <option value="changed_mind">Changed my mind</option>
            <option value="wrong_item">Ordered wrong item</option>
            <option value="found_better_price">Found better price</option>
            <option value="delivery_time">Delivery time too long</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div>
          <label class="block text-[10px] uppercase tracking-widest font-bold text-on-surface-variant mb-2">Comments *</label>
          <textarea id="remark" rows="3" class="da-input resize-none" placeholder="Tell us more…"></textarea>
        </div>
      </div>
      <div class="flex gap-3 justify-end mt-6">
        <button onclick="closeCancelModal()" class="btn-atelier btn-ghost-da">Keep Order</button>
        <button id="cancelbtn" class="btn-atelier btn-danger-da">
          <span class="material-symbols-outlined text-sm">close</span>Cancel Item
        </button>
      </div>
    </div>
  </div>
</div>

<!-- MODAL: Cancel All Items -->
<div id="cancelAllModal" class="da-modal">
  <div class="da-modal-box">
    <div class="p-7">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 rounded-xl bg-error/10 flex items-center justify-center">
            <span class="material-symbols-outlined text-error text-lg">delete_sweep</span>
          </div>
          <h2 class="font-headline font-bold text-white text-lg uppercase tracking-tight">Cancel All Items</h2>
        </div>
        <button onclick="closeCancelALLModal()" class="text-on-surface-variant hover:text-white p-1">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <p class="text-on-surface-variant text-sm mb-5">Cancel the entire order. This cannot be undone.</p>
      <input type="hidden" id="variantIdAll"/>
      <input type="hidden" id="orderIdAll"/>
      <div class="space-y-4">
        <div>
          <label class="block text-[10px] uppercase tracking-widest font-bold text-on-surface-variant mb-2">Reason *</label>
          <select id="reasonAll" class="da-input">
            <option value="">Select a reason</option>
            <option value="changed_mind">Changed my mind</option>
            <option value="wrong_item">Ordered wrong item</option>
            <option value="found_better_price">Found better price</option>
            <option value="delivery_time">Delivery time too long</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div>
          <label class="block text-[10px] uppercase tracking-widest font-bold text-on-surface-variant mb-2">Comments *</label>
          <textarea id="remarkAll" rows="3" class="da-input resize-none" placeholder="Tell us more…"></textarea>
        </div>
      </div>
      <div class="flex gap-3 justify-end mt-6">
        <button onclick="closeCancelALLModal()" class="btn-atelier btn-ghost-da">Keep Order</button>
        <button id="cancelALLbtn" class="btn-atelier btn-danger-da">
          <span class="material-symbols-outlined text-sm">delete_sweep</span>Cancel All
        </button>
      </div>
    </div>
  </div>
</div>

<!-- MODAL: Return -->
<div id="returnModal" class="da-modal">
  <div class="da-modal-box">
    <div class="p-7">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 rounded-xl bg-primary-container/10 flex items-center justify-center">
            <span class="material-symbols-outlined text-primary text-lg">undo</span>
          </div>
          <div>
            <h2 class="font-headline font-bold text-white text-lg uppercase tracking-tight">Return Request</h2>
            <p class="text-on-surface-variant text-[11px] mt-0.5" id="returnModalSubtitle"></p>
          </div>
        </div>
        <button onclick="closeReturnModal()" class="text-on-surface-variant hover:text-white p-1">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>

      <p class="text-on-surface-variant text-sm mb-5">Items must be unused and in original packaging. Refund processed within 7–10 business days.</p>

      <input type="hidden" id="returnOrderId"/>
      <input type="hidden" id="returnVariantId"/>

      <div id="returnItemChip" style="display:none;" class="mb-5 flex items-center gap-3 p-3 rounded bg-primary/5 border border-primary/20">
        <span class="material-symbols-outlined text-primary text-base">inventory_2</span>
        <div>
          <p class="text-white text-sm font-semibold" id="returnItemName"></p>
          <p class="text-on-surface-variant text-[11px]" id="returnItemMeta"></p>
        </div>
      </div>

      <div class="space-y-5">
        <div id="returnQtyRow">
          <label class="block text-[10px] uppercase tracking-widest font-bold text-on-surface-variant mb-2">Quantity to Return *</label>
          <div class="qty-spinner">
            <button type="button" id="qtyMinus" onclick="adjustQty(-1)">−</button>
            <input type="number" id="returnQty" value="1" min="1" max="1" readonly/>
            <button type="button" id="qtyPlus" onclick="adjustQty(1)">+</button>
          </div>
          <p class="text-[11px] text-on-surface-variant mt-2">
            Max returnable: <span id="returnQtyMax" class="text-white font-semibold">1</span>
          </p>
        </div>

        <div>
          <label class="block text-[10px] uppercase tracking-widest font-bold text-on-surface-variant mb-2">Reason *</label>
          <select id="returnReason" class="da-input">
            <option value="">Select a reason</option>
            <option value="defective">Defective or damaged</option>
            <option value="wrong_item">Received wrong item</option>
            <option value="not_as_described">Not as described</option>
            <option value="quality_issues">Quality issues</option>
            <option value="size_fit">Size / fit issues</option>
            <option value="changed_mind">Changed my mind</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div>
          <label class="block text-[10px] uppercase tracking-widest font-bold text-on-surface-variant mb-2">Details *</label>
          <textarea id="returnRemark" rows="3" class="da-input resize-none" placeholder="Describe the issue in detail…"></textarea>
        </div>

        <div>
          <label class="block text-[10px] uppercase tracking-widest font-bold text-on-surface-variant mb-2">Preferred Resolution *</label>
          <select id="returnResolution" class="da-input">
            <option value="">Select resolution</option>
            <option value="refund">Refund</option>
          </select>
        </div>
      </div>

      <div class="flex gap-3 justify-end mt-6">
        <button onclick="closeReturnModal()" class="btn-atelier btn-ghost-da">Cancel</button>
        <button id="returnSubmitBtn" class="btn-atelier btn-primary-da">
          <span class="material-symbols-outlined text-sm">send</span>Submit Request
        </button>
      </div>
    </div>
  </div>
</div>


<script>
  var GST_RATE           = 0.05;
  var SHIPPING_THRESHOLD = 999;
  var SHIPPING_FEE       = 99;
  var COUPON             = <%= ord.couponApplied || 0 %>;

  // ── Same fix applied here as server-side: originalSubTotal (ALL rows,
  // cancelled or not) is the fixed coupon basis; activeSubTotal (only
  // non-cancelled rows) is what the coupon/GST/shipping/total are actually
  // computed against. This keeps the live "cancel item" preview in sync
  // with the values the server will render on reload. Note: a Return
  // action doesn't update these rows live (the page reloads after a
  // successful return), so this function only needs to react to Cancel. ──
  function recalcTotal() {
    var sub         = 0; // active (non-cancelled) subtotal
    var originalSub = 0; // ALL items' subtotal — fixed coupon basis
    var rows = document.querySelectorAll('#itemList .item-row');
    for (var i = 0; i < rows.length; i++) {
      var price = parseFloat(rows[i].dataset.price || 0);
      originalSub += price;
      if (rows[i].dataset.cancelled !== 'true') sub += price;
    }

    var hasActive  = sub > 0;
     var couponUsed = hasActive ? Math.min(COUPON, sub) : 0;
    var taxable    = Math.max(sub - couponUsed, 0);
    var gst        = Math.round(taxable * GST_RATE);
    var shipping   = hasActive ? (sub >= SHIPPING_THRESHOLD ? 0 : SHIPPING_FEE) : 0;
    var total      = Math.max(0, +(taxable + gst + shipping).toFixed(2));

    var subEl      = document.getElementById('displaySubtotal');
    var couponEl   = document.getElementById('displayCoupon');
    var gstEl      = document.getElementById('displayGst');
    var shippingEl = document.getElementById('displayShipping');
    var totalEl    = document.getElementById('displayTotal');

    if (subEl)    subEl.textContent = '₹' + sub.toFixed(2);
    if (couponEl) couponEl.textContent = '−₹' + couponUsed.toFixed(2);
    if (gstEl)    gstEl.textContent = '+ ₹' + gst.toFixed(2);
    if (shippingEl) {
      shippingEl.className   = shipping === 0 ? 'text-primary font-bold' : 'text-white font-medium';
      shippingEl.textContent = shipping === 0 ? 'FREE' : '₹' + shipping.toFixed(2);
    }
    if (totalEl) {
      totalEl.textContent = '₹' + total.toFixed(2);
      totalEl.classList.remove('total-flash');
      void totalEl.offsetWidth;
      totalEl.classList.add('total-flash');
    }
  }

  function markItemCancelled(variantId, statusLabel) {
    var row = document.getElementById('item-row-' + variantId);
    if (!row) return;
    row.dataset.cancelled = 'true';
    row.classList.add('cancelling', 'is-cancelled');
    setTimeout(function() { row.style.opacity = '0.38'; }, 400);

    var priceEl = row.querySelector('.font-headline.font-black');
    if (priceEl) {
      priceEl.classList.add('line-through', 'text-on-surface-variant');
      priceEl.classList.remove('text-white');
    }
    var btnWrap = document.getElementById('cancel-btn-wrap-' + variantId);
    if (btnWrap) {
      btnWrap.innerHTML =
        '<span class="inline-flex items-center gap-1 px-2 py-1 bg-error/10 border border-error/20 text-error text-[9px] uppercase tracking-widest rounded font-bold">' +
        '<span class="material-symbols-outlined text-xs">block</span>' + (statusLabel || 'Cancelled') + '</span>';
    }
    var nameEl = row.querySelector('h3');
    if (nameEl && !nameEl.querySelector('.cancelled-tag')) {
      var tag = document.createElement('span');
      tag.className = 'cancelled-tag ml-2 inline-flex items-center gap-1 px-2 py-0.5 bg-error/10 border border-error/20 text-error text-[9px] uppercase tracking-widest rounded font-bold';
      tag.innerHTML = '<span class="material-symbols-outlined text-xs">block</span>' + (statusLabel || 'Cancelled');
      nameEl.appendChild(tag);
    }
    recalcTotal();
  }

  function markAllCancelled() {
    var rows = document.querySelectorAll('#itemList .item-row');
    for (var i = 0; i < rows.length; i++) {
      var vid = rows[i].id.replace('item-row-', '');
      if (rows[i].dataset.cancelled !== 'true') markItemCancelled(vid, 'Cancelled');
    }
  }

  function markItemReturned(variantId) {
    var btnWrap = document.getElementById('cancel-btn-wrap-' + variantId);
    if (btnWrap) {
      var returnBtn = btnWrap.querySelector('button[data-return-btn]');
      if (returnBtn) returnBtn.remove();
      var badge = document.createElement('span');
      badge.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-primary/5 border border-primary/20 text-primary text-[9px] uppercase tracking-widest font-bold';
      badge.innerHTML = '<span class="material-symbols-outlined text-xs">hourglass_top</span>Return Requested';
      btnWrap.appendChild(badge);
    }
    var nameEl = document.querySelector('#item-row-' + variantId + ' h3');
    if (nameEl && !nameEl.querySelector('.returned-tag')) {
      var tag = document.createElement('span');
      tag.className = 'returned-tag ml-2 inline-flex items-center gap-1 px-2 py-0.5 bg-primary/10 border border-primary/20 text-primary text-[9px] uppercase tracking-widest rounded font-bold';
      tag.innerHTML = '<span class="material-symbols-outlined text-xs">undo</span>Return Pending';
      nameEl.appendChild(tag);
    }
  }

  function openCancelModal(id, orderId) {
    document.getElementById('variantId').value = id;
    document.getElementById('orderId').value   = orderId;
    document.getElementById('cancelModal').classList.add('active');
    document.body.style.overflow = 'hidden';
  }
  function closeCancelModal() {
    document.getElementById('cancelModal').classList.remove('active');
    document.getElementById('reason').value = '';
    document.getElementById('remark').value = '';
    document.body.style.overflow = '';
  }

  function openCancelALLModal(id, orderId) {
    document.getElementById('variantIdAll').value = id;
    document.getElementById('orderIdAll').value   = orderId;
    document.getElementById('cancelAllModal').classList.add('active');
    document.body.style.overflow = 'hidden';
  }
  function closeCancelALLModal() {
    document.getElementById('cancelAllModal').classList.remove('active');
    document.getElementById('reasonAll').value = '';
    document.getElementById('remarkAll').value = '';
    document.body.style.overflow = '';
  }

  function openReturnModal(orderId, variantId, productName, maxQty) {
    document.getElementById('returnOrderId').value    = orderId;
    document.getElementById('returnVariantId').value  = variantId;
    document.getElementById('returnReason').value     = '';
    document.getElementById('returnRemark').value     = '';
    document.getElementById('returnResolution').value = '';

    document.getElementById('returnItemChip').style.display    = 'flex';
    document.getElementById('returnModalSubtitle').textContent = productName;
    document.getElementById('returnItemName').textContent      = productName;
    document.getElementById('returnItemMeta').textContent      = 'Max returnable: ' + maxQty;
    document.getElementById('returnQtyMax').textContent        = maxQty;

    var qtyInput = document.getElementById('returnQty');
    qtyInput.value = 1;
    qtyInput.max   = maxQty;

    document.getElementById('qtyMinus').disabled = true;
    document.getElementById('qtyPlus').disabled  = maxQty <= 1;

    document.getElementById('returnModal').classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeReturnModal() {
    document.getElementById('returnModal').classList.remove('active');
    document.getElementById('returnItemChip').style.display = 'none';
    document.body.style.overflow = '';
  }

  function adjustQty(delta) {
    var input   = document.getElementById('returnQty');
    var max     = parseInt(input.max, 10);
    var current = parseInt(input.value, 10);
    current = Math.min(max, Math.max(1, current + delta));
    input.value = current;
    document.getElementById('qtyMinus').disabled = current <= 1;
    document.getElementById('qtyPlus').disabled  = current >= max;
  }

  var modalIds = ['cancelModal', 'cancelAllModal', 'returnModal'];
  for (var mi = 0; mi < modalIds.length; mi++) {
    (function(id) {
      document.getElementById(id).addEventListener('click', function(e) {
        if (e.target === this) {
          this.classList.remove('active');
          document.body.style.overflow = '';
        }
      });
    })(modalIds[mi]);
  }

  function toast(icon, title) {
    Swal.fire({ toast: true, icon: icon, title: title, position: 'top-right', showConfirmButton: false, timer: 3000, background: '#131b2e', color: '#dae2fd' });
  }
  function postJSON(url, body) {
    return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
      .then(function(res) { return res.json(); });
  }
  function setLoading(btn, loading) {
    btn.disabled = loading;
    btn.style.opacity = loading ? '0.5' : '';
  }

  document.getElementById('cancelbtn').addEventListener('click', function() {
    var self    = this;
    var reason  = document.getElementById('reason').value;
    var remark  = document.getElementById('remark').value;
    var id      = document.getElementById('variantId').value;
    var orderId = document.getElementById('orderId').value;
    if (!reason)        return toast('error', 'Select a reason');
    if (!remark.trim()) return toast('error', 'Write a remark');
    setLoading(self, true);
    postJSON('/order/cancel-order', { id: id, reason: reason, remark: remark, orderId: orderId })
      .then(function(result) {
        if (!result.success) { setLoading(self, false); return toast('error', result.message || 'Something went wrong'); }
        markItemCancelled(id, result.pendingApproval ? 'Pending' : 'Cancelled');
        closeCancelModal();
        Swal.fire({ icon: 'success', title: result.message || 'Item cancelled', timer: 1500, showConfirmButton: false, background: '#131b2e', color: '#dae2fd' });
        setTimeout(function() { window.location.reload(); }, 1800);
      })
      .catch(function() { setLoading(self, false); toast('error', 'Something went wrong'); });
  });

  document.getElementById('cancelALLbtn').addEventListener('click', function() {
    var self    = this;
    var reason  = document.getElementById('reasonAll').value;
    var remark  = document.getElementById('remarkAll').value;
    var id      = document.getElementById('variantIdAll').value;
    var orderId = document.getElementById('orderIdAll').value;
    if (!reason)        return toast('error', 'Select a reason');
    if (!remark.trim()) return toast('error', 'Write a remark');
    setLoading(self, true);
    postJSON('/order/cancel-order', { id: id, reason: reason, remark: remark, orderId: orderId })
      .then(function(result) {
        if (!result.success) { setLoading(self, false); return toast('error', result.message || 'Something went wrong'); }
        markAllCancelled();
        closeCancelALLModal();
        Swal.fire({ icon: 'success', title: result.message || 'Order cancelled', timer: 1500, showConfirmButton: false, background: '#131b2e', color: '#dae2fd' });
        setTimeout(function() { window.location.reload(); }, 1800);
      })
      .catch(function() { setLoading(self, false); toast('error', 'Something went wrong'); });
  });

  document.getElementById('returnSubmitBtn').addEventListener('click', function() {
    var self       = this;
    var variantId  = document.getElementById('returnVariantId').value;
    var orderId    = document.getElementById('returnOrderId').value;
    var reason     = document.getElementById('returnReason').value;
    var remark     = document.getElementById('returnRemark').value;
    var resolution = document.getElementById('returnResolution').value;
    var quantity   = parseInt(document.getElementById('returnQty').value, 10);

    if (!reason)                   return toast('error', 'Select a reason');
    if (!remark.trim())            return toast('error', 'Provide details');
    if (!resolution)               return toast('error', 'Select preferred resolution');
    if (!quantity || quantity < 1) return toast('error', 'Invalid quantity');

    setLoading(self, true);
    postJSON('/order/return-request', { orderId: orderId, reason: reason, remark: remark, resolution: resolution, variant: variantId, quantity: quantity })
      .then(function(result) {
        if (!result.success) { setLoading(self, false); return toast('error', result.message || 'Something went wrong'); }
        closeReturnModal();
        markItemReturned(variantId);
        Swal.fire({ icon: 'success', title: result.message || 'Return request submitted', timer: 1500, showConfirmButton: false, background: '#131b2e', color: '#dae2fd' });
        setTimeout(function() { window.location.reload(); }, 1800);
      })
      .catch(function() { setLoading(self, false); toast('error', 'Something went wrong'); });
  });

  window.addEventListener('load', function() {
    recalcTotal();
    document.body.style.opacity = '0';
    var opacity = 0;
    var t = setInterval(function() {
      if (opacity >= 1) return clearInterval(t);
      document.body.style.opacity = opacity;
      opacity += 0.06;
    }, 16);
  });
</script>

</body>
</html>
