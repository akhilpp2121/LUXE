<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>LUXE | My Orders</title>
<script src="/js/blockedUserGuard.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Syne:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@300,0..1&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg: #080c14; --sur: #0e1523; --sur2: #141c2e; --sur3: #1a2338; --sur4: #212c42;
    --bord: rgba(255,255,255,0.07); --bord2: rgba(255,255,255,0.13);
    --pri: #3a6ff7; --gold: #c9a96e; --gold2: #e0c08a;
    --txt: #e8edf8; --txt2: #8892a4; --txt3: #5a6478;
    --green: #22c55e; --red: #ef4444; --amber: #fbbf24;
    --nav-h: 68px; --side-w: 260px; --r: 12px; --rl: 18px;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--txt); min-height: 100vh; overflow-x: hidden; }
  ::-webkit-scrollbar { width: 4px; } ::-webkit-scrollbar-track { background: var(--bg); } ::-webkit-scrollbar-thumb { background: var(--sur4); border-radius: 99px; }

  /* ── NAV ── */
  nav.topnav {
    position: fixed; top: 0; left: 0; right: 0; height: var(--nav-h);
    background: rgba(8,12,20,0.9); backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--bord);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 36px; z-index: 100;
  }
  .brand { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 1rem; letter-spacing: .22em; text-transform: uppercase; }
  .brand span { color: var(--gold); }
  .nav-links { display: flex; gap: 32px; list-style: none; }
  .nav-links a { font-family: 'Syne', sans-serif; font-size: .6rem; letter-spacing: .18em; text-transform: uppercase; color: var(--txt2); text-decoration: none; transition: color .2s; }
  .nav-links a:hover { color: var(--txt); }
  .nav-acts { display: flex; align-items: center; gap: 16px; }
  .nav-btn { background: none; border: none; cursor: pointer; color: var(--txt2); display: flex; align-items: center; text-decoration: none; position: relative; transition: color .2s; }
  .nav-btn:hover { color: var(--txt); } .nav-btn.on { color: var(--pri); }
  .nav-btn .ms { font-size: 22px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }
  .nav-badge { position: absolute; top: -6px; right: -8px; width: 17px; height: 17px; border-radius: 50%; background: var(--pri); color: #fff; font-size: .55rem; font-weight: 700; display: flex; align-items: center; justify-content: center; font-family: 'Syne', sans-serif; }

  /* ── SIDEBAR ── */
  aside.sidebar {
    position: fixed; top: var(--nav-h); left: 0;
    width: var(--side-w); height: calc(100vh - var(--nav-h));
    background: var(--sur); border-right: 1px solid var(--bord);
    display: flex; flex-direction: column; padding: 28px 0 20px; z-index: 50; overflow-y: auto;
  }
  .sidebar-header { padding: 0 24px 24px; border-bottom: 1px solid var(--bord); margin-bottom: 12px; }
  .sidebar-header h3 { font-family: 'Syne', sans-serif; font-weight: 700; font-size: .9rem; margin-bottom: 6px; }
  .sidebar-tier { display: inline-flex; align-items: center; gap: 5px; background: rgba(201,169,110,.1); border: 1px solid rgba(201,169,110,.25); border-radius: 99px; padding: 3px 10px; }
  .sidebar-tier span { font-family: 'Syne', sans-serif; font-size: .5rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--gold); }
  .tier-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--gold); flex-shrink: 0; }
  .sidebar-nav { display: flex; flex-direction: column; gap: 2px; padding: 0 10px; }
  .sidebar-link {
    display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 8px;
    text-decoration: none; color: var(--txt2); font-size: .625rem; font-family: 'Syne', sans-serif;
    font-weight: 600; letter-spacing: .1em; text-transform: uppercase; transition: all .2s;
  }
  .sidebar-link .material-symbols-outlined { font-size: 17px; flex-shrink: 0; font-variation-settings: 'FILL' 0, 'wght' 300; }
  .sidebar-link:hover { background: var(--sur3); color: var(--txt); }
  .sidebar-link.active { background: rgba(58,111,247,.12); color: var(--pri); }
  .sidebar-footer { margin-top: auto; padding: 18px 24px 0; border-top: 1px solid var(--bord); }
  .sidebar-footer a { display: flex; align-items: center; gap: 9px; text-decoration: none; color: var(--txt3); font-size: .625rem; font-family: 'Syne', sans-serif; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; transition: color .2s; }
  .sidebar-footer a:hover { color: var(--txt2); }
  .sidebar-footer .material-symbols-outlined { font-size: 17px; font-variation-settings: 'FILL' 0, 'wght' 300; }

  /* ── MAIN ── */
  main { margin-left: var(--side-w); padding: calc(var(--nav-h) + 44px) 48px 80px; min-height: 100vh; }
  .page-header { margin-bottom: 36px; display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .page-header h1 { font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: 3.2rem; letter-spacing: -.01em; line-height: 1.05; margin-bottom: 6px; }
  .page-header h1 em { font-style: italic; color: var(--gold2); }
  .page-header p { color: var(--txt3); font-size: .82rem; font-weight: 300; }

  /* ── BREADCRUMB ── */
  .crumb { display: flex; align-items: center; gap: 6px; font-size: .72rem; color: var(--txt3); margin-bottom: 22px; }
  .crumb a { color: var(--txt3); text-decoration: none; transition: color .2s; }
  .crumb a:hover { color: var(--pri); }
  .crumb .ms { font-size: 14px; font-family: 'Material Symbols Outlined'; }
  .crumb .cur { color: var(--txt2); font-weight: 500; }

  @keyframes fu { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
  .fu { animation: fu .5s ease both; }
  .d1 { animation-delay: .04s; } .d2 { animation-delay: .1s; } .d3 { animation-delay: .18s; }

  /* ── ORDER CARD ── */
  .orders-list { display: flex; flex-direction: column; gap: 16px; }
  .order-card {
    background: var(--sur); border: 1px solid var(--bord); border-radius: var(--rl);
    padding: 24px 26px; display: flex; flex-direction: column; gap: 18px;
    transition: border-color .2s, background .2s, transform .15s;
  }
  .order-card:hover { border-color: rgba(58,111,247,.35); background: var(--sur2); transform: translateY(-2px); }

  .order-top { display: flex; gap: 18px; }
  .order-thumbs { display: flex; flex-shrink: 0; }
  .thumb-zoom {
    width: 76px; height: 76px; border-radius: 10px; overflow: hidden;
    background: var(--sur3); border: 2px solid var(--sur); flex-shrink: 0; margin-left: -14px;
  }
  .thumb-zoom:first-child { margin-left: 0; }
  .thumb-zoom img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .order-card:hover .thumb-zoom img { transform: scale(1.08); }

  .order-meta { flex: 1; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 18px; }
  .meta-item { display: flex; flex-direction: column; gap: 5px; }
  .meta-label { font-family: 'Syne', sans-serif; font-size: .52rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--txt3); }
  .meta-value { font-size: .85rem; color: var(--txt); font-weight: 500; }
  .meta-value.price { color: var(--gold2); font-family: 'Syne', sans-serif; font-weight: 700; }

  .status-pill {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: 'Syne', sans-serif; font-size: .55rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    padding: 5px 11px; border-radius: 99px; width: fit-content;
  }
  .status-pill .ms { font-size: 13px; font-family: 'Material Symbols Outlined'; }
  .status-delivered  { color: #4ade80; background: rgba(34,197,94,.1);  border: 1px solid rgba(34,197,94,.25); }
  .status-cancelled  { color: #f87171; background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.25); }
  .status-transit    { color: #7ca4fb; background: rgba(58,111,247,.1); border: 1px solid rgba(58,111,247,.25); }
  .status-processing { color: var(--amber); background: rgba(251,191,36,.1); border: 1px solid rgba(251,191,36,.25); }
  .status-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--amber); animation: pulse 1.6s ease-in-out infinite; }
  @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .35; } }

  .order-bottom { display: flex; align-items: center; gap: 14px; padding-top: 18px; border-top: 1px solid var(--bord); }
  .order-item-name { font-family: 'Syne', sans-serif; font-weight: 600; font-size: .78rem; text-transform: uppercase; letter-spacing: .02em; color: var(--txt); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .order-item-qty { font-size: .72rem; color: var(--txt3); margin-top: 3px; font-weight: 300; }

  .view-details-btn {
    display: inline-flex; align-items: center; gap: 7px;
    background: transparent; border: 1px solid var(--bord2); color: var(--pri);
    font-family: 'Syne', sans-serif; font-size: .58rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
    padding: 10px 18px; border-radius: 8px; cursor: pointer; transition: all .2s; white-space: nowrap; text-decoration: none;
  }
  .view-details-btn:hover { background: var(--pri); color: #fff; border-color: var(--pri); }
  .view-details-btn .ms { font-size: 15px; font-family: 'Material Symbols Outlined'; transition: transform .2s; }
  .view-details-btn:hover .ms { transform: translateX(3px); }

  /* ── EMPTY STATE ── */
  .empty-state {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 16px; padding: 100px 20px; text-align: center;
    background: var(--sur); border: 1px solid var(--bord); border-radius: var(--rl);
  }
  .empty-state .ms { font-size: 52px; color: var(--sur4); font-family: 'Material Symbols Outlined'; }
  .empty-state h3 { font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 1.6rem; color: var(--txt); }
  .empty-state p { font-family: 'Syne', sans-serif; font-size: .6rem; letter-spacing: .14em; text-transform: uppercase; color: var(--txt3); }
  .shop-btn {
    margin-top: 6px; display: inline-flex; align-items: center; gap: 8px;
    background: var(--pri); color: #fff; border: none; border-radius: 8px;
    padding: 12px 26px; font-family: 'Syne', sans-serif; font-size: .62rem; font-weight: 700;
    letter-spacing: .12em; text-transform: uppercase; cursor: pointer; transition: all .2s; text-decoration: none;
  }
  .shop-btn:hover { background: #5b84ff; box-shadow: 0 0 24px rgba(58,111,247,.35); }

  /* ── PAGINATION ── */
  .pagination { margin-top: 36px; display: flex; justify-content: center; align-items: center; gap: 14px; }
  .page-btn {
    background: transparent; border: 1px solid var(--bord2); color: var(--txt2);
    font-family: 'Syne', sans-serif; font-size: .58rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
    padding: 10px 18px; border-radius: 8px; transition: all .2s; text-decoration: none;
  }
  .page-btn:hover { border-color: var(--pri); color: var(--pri); }
  .page-info { font-family: 'Syne', sans-serif; font-size: .58rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--txt3); }

  @media (max-width: 900px) { :root { --side-w: 0px; } aside.sidebar { display: none; } main { padding: calc(var(--nav-h) + 28px) 20px 60px; } .nav-links { display: none; } }
  @media (max-width: 640px) {
    .order-top { flex-direction: column; }
    .order-meta { gap: 14px; }
    .order-bottom { flex-wrap: wrap; }
    .page-header h1 { font-size: 2.4rem; }
  }
</style>
  <link rel="stylesheet" href="/css/navigation-consistency.css" />
</head>
<body>

<!-- ── NAV ── -->
<nav class="topnav">
  <div class="brand">LUXE <span>ATELIER</span></div>
  <ul class="nav-links">
    <li><a href="/">Showroom</a></li>
    <li><a href="/product-listing">Collections</a></li>
  </ul>
  <div class="nav-acts">
    <a href="/cart" class="nav-btn">
      <span class="ms material-symbols-outlined">shopping_bag</span>
      <% if (typeof cart !== 'undefined' && cart > 0) { %>
        <span class="nav-badge"><%= cart %></span>
      <% } %>
    </a>
    <a href="/profile" class="nav-btn"><span class="ms material-symbols-outlined">person</span></a>
  </div>
</nav>

<!-- ── SIDEBAR ── -->
<aside class="sidebar">
  <div class="sidebar-header">
    <h3>User Account</h3>
    <div class="sidebar-tier">
      <div class="tier-dot"></div>
    </div>
  </div>
  <nav class="sidebar-nav">
    <a href="/profile" class="sidebar-link">
      <span class="material-symbols-outlined">person</span>
      <span>Profile</span>
    </a>
    <a href="/order/my-orders" class="sidebar-link active">
      <span class="material-symbols-outlined">package_2</span>
      <span>My Orders</span>
    </a>
    <a href="/address" class="sidebar-link">
      <span class="material-symbols-outlined">distance</span>
      <span>Manage Address</span>
    </a>
    <a href="/changePassword" class="sidebar-link">
      <span class="material-symbols-outlined">lock_reset</span>
      <span>Change Password</span>
    </a>
    <a href="/wishlist" class="sidebar-link">
      <span class="material-symbols-outlined">favorite</span>
      <span>Wishlist</span>
    </a>
    <a href="/referal" class="sidebar-link">
      <span class="material-symbols-outlined">share_reviews</span>
      <span>Referral Link</span>
    </a>
    <a href="/wallet" class="sidebar-link">
      <span class="material-symbols-outlined">account_balance_wallet</span>
      <span>Wallet</span>
    </a>
  </nav>
  <div class="sidebar-footer">
    <a href="/logout">
      <span class="material-symbols-outlined">logout</span>
      <span>Sign Out</span>
    </a>
  </div>
</aside>

<!-- ── MAIN ── -->
<main>

  <div class="crumb fu d1">
    <a href="/">Home</a>
    <span class="ms material-symbols-outlined">chevron_right</span>
    <a href="/profile">Account</a>
    <span class="ms material-symbols-outlined">chevron_right</span>
    <span class="cur">My Orders</span>
  </div>

  <div class="page-header fu d1">
    <div>
      <h1>My <em>Orders</em></h1>
      <p>A curated history of your acquisitions</p>
    </div>
  </div>

  <% if (!orders || orders.length === 0) { %>

    <!-- ══ EMPTY STATE ══ -->
    <div class="empty-state fu d2">
      <span class="ms material-symbols-outlined">inbox</span>
      <h3>No orders yet</h3>
      <p>Your acquisitions will appear here</p>
      <a href="/product-listing" class="shop-btn">
        <span class="ms material-symbols-outlined" style="font-size:16px">shopping_bag</span>
        Begin Shopping
      </a>
    </div>

  <% } else { %>

    <div class="orders-list fu d2">
      <% orders.forEach(function(o) { %>
        <%
          /* ── resolve first active item for thumbnail ── */
          const cancelledVIds = new Set(
            (o.cancelledAt || []).flatMap(ca =>
              (ca.cancelledProducts || []).map(cp => cp && cp._id ? cp._id.toString() : String(cp))
            )
          );
          const activeItems = (o.orderItems || []).filter(item => {
            const vid = item.variantId && typeof item.variantId === 'object'
              ? item.variantId._id.toString()
              : String(item.variantId);
            return !cancelledVIds.has(vid);
          });
          const firstItem = activeItems[0] || (o.orderItems || [])[0];

          /* ── status display ── */
          const st = (o.orderStatus || '').toLowerCase();
          const isDelivered  = st === 'completed';
          const isCancelled  = st === 'cancelled';
          const isProcessing = st === 'placed' || st === 'pending';
          const isTransit    = st === 'processing' || st === 'shipped';

          /* ── total items count ── */
          const totalQty = (o.orderItems || []).reduce((s, i) => s + (i.quantity || 1), 0);
        %>

        <div class="order-card">

          <div class="order-top">

            <!-- Thumbnails -->
            <div class="order-thumbs">
              <% (o.orderItems || []).slice(0, 2).forEach(function(item) {
                const v   = item.variantId && typeof item.variantId === 'object' ? item.variantId : null;
                const img = v ? (v.images || v.image || [])[0] : null;
                const src = img ? '/uploads/' + img : '/images/placeholder.png';
              %>
                <div class="thumb-zoom">
                  <img alt="<%= item.productName || 'Product' %>" src="<%= src %>" onerror="this.src='/images/placeholder.png'"/>
                </div>
              <% }) %>
            </div>

            <!-- Meta -->
            <div class="order-meta">
              <div class="meta-item">
                <span class="meta-label">Order Reference</span>
                <span class="meta-value">#<%= o.orderCode %></span>
              </div>
              <div class="meta-item">
                <span class="meta-label">Placed On</span>
                <span class="meta-value"><%= new Date(o.orderDate).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %></span>
              </div>
              <div class="meta-item">
                <span class="meta-label">Status</span>
                <% if (isDelivered) { %>
                  <span class="status-pill status-delivered">
                    <span class="ms material-symbols-outlined" style="font-variation-settings:'FILL' 1">check_circle</span>
                    Delivered
                  </span>
                <% } else if (isCancelled) { %>
                  <span class="status-pill status-cancelled">
                    <span class="ms material-symbols-outlined">cancel</span>
                    Cancelled
                  </span>
                <% } else if (isTransit) { %>
                  <span class="status-pill status-transit">
                    <span class="ms material-symbols-outlined">local_shipping</span>
                    In Transit
                  </span>
                <% } else { %>
                  <span class="status-pill status-processing">
                    <span class="status-dot"></span>
                    Processing
                  </span>
                <% } %>
              </div>
              <div class="meta-item">
                <span class="meta-label">Total</span>
                <span class="meta-value price">&#8377;<%= (o.totalAmount || 0).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></span>
              </div>
            </div>

          </div>

          <!-- Bottom row -->
          <div class="order-bottom">
            <div style="min-width:0; flex:1;">
              <div class="order-item-name"><%= firstItem ? firstItem.productName : 'N/A' %></div>
              <div class="order-item-qty">Qty: <%= totalQty %> item<%= totalQty !== 1 ? 's' : '' %></div>
            </div>
            <a href="/order/details/<%= o._id %>" class="view-details-btn">
              View Details
              <span class="ms material-symbols-outlined">arrow_forward</span>
            </a>
          </div>

        </div>

      <% }) %>
    </div>

    <!-- ══ PAGINATION ══ -->
    <% if (pagination && pagination.totalPages > 1) { %>
      <div class="pagination fu d3">
        <% if (pagination.currentPage > 1) { %>
          <a href="?page=<%= pagination.currentPage - 1 %>" class="page-btn">Prev</a>
        <% } %>
        <span class="page-info">Page <%= pagination.currentPage %> of <%= pagination.totalPages %></span>
        <% if (pagination.currentPage < pagination.totalPages) { %>
          <a href="?page=<%= pagination.currentPage + 1 %>" class="page-btn">Next</a>
        <% } %>
      </div>
    <% } %>

  <% } %>

</main>

<script>
  function showToast(msg, type) {
    type = type || "success";
    const toast = document.createElement("div");
    toast.innerText = msg;
    toast.style.position = "fixed";
    toast.style.bottom = "20px";
    toast.style.right = "20px";
    toast.style.padding = "12px 16px";
    toast.style.borderRadius = "8px";
    toast.style.color = "#fff";
    toast.style.fontSize = "14px";
    toast.style.zIndex = "9999";
    toast.style.boxShadow = "0 8px 20px rgba(0,0,0,0.2)";
    toast.style.background = type === "success" ? "#22c55e" : "#ef4444";
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 3000);
  }

  document.addEventListener("DOMContentLoaded", () => {
    <% if (typeof flash !== 'undefined' && flash) { %>
      showToast("<%= flash.text %>", "<%= flash.type %>");
    <% } %>
  });
</script>

</body>
</html>
