                                        <span class="text-xs text-slate-400 line-through">₹<%=
                                                p.price.toLocaleString('en-IN') %></span>
                                        <% } else { %>
                                            <span class="text-sm font-bold">₹<%= p.price.toLocaleString('en-IN') %>
                                                    </span>
                                            <% } %>
                                </div>

                                <!-- Savings Badge (reserved height so layout doesn't shift) -->
                                <div class="min-h-[22px] flex items-center">
