<!DOCTYPE html>
<html class="dark" lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Add Coupon | AdminPanel</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
<script id="tailwind-config">
  tailwind.config = {
    darkMode: "class",
    theme: {
      extend: {
        colors: {
          "background": "#0b1326", "on-background": "#dae2fd",
          "surface": "#0b1326", "on-surface": "#dae2fd",
          "surface-variant": "#2d3449", "on-surface-variant": "#bdc8d1",
          "surface-container": "#171f33", "surface-container-low": "#131b2e",
          "surface-container-lowest": "#060e20", "surface-container-high": "#222a3d",
          "surface-container-highest": "#2d3449",
          "primary": "#8ed5ff", "on-primary": "#00354a",
          "primary-container": "#38bdf8", "on-primary-container": "#004965",
          "primary-fixed": "#c4e7ff", "primary-fixed-dim": "#7bd0ff",
          "secondary": "#b9c8de", "on-secondary": "#233143",
          "error": "#ffb4ab", "on-error": "#690005",
          "error-container": "#93000a", "on-error-container": "#ffdad6",
          "outline": "#87929a", "outline-variant": "#3e484f",
          "tertiary": "#ffc176", "tertiary-container": "#f1a02b",
        },
        fontFamily: {
          "body-md": ["Inter"], "body-sm": ["Inter"],
          "headline-lg": ["IBM Plex Sans"], "headline-md": ["IBM Plex Sans"],
          "label-md": ["JetBrains Mono"], "label-sm": ["JetBrains Mono"],
        }
      }
    }
  }
</script>
<style>
  body { font-family: 'Inter', sans-serif; }
  h1,h2,h3,h4 { font-family: 'IBM Plex Sans', sans-serif; }
  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24;
    vertical-align: middle;
  }
  input[type="date"]::-webkit-calendar-picker-indicator { filter: invert(1); }

  /* Validation styles */
  .input-error {
    border-color: #ffb4ab !important;
    box-shadow: 0 0 0 2px rgba(255,180,171,0.2) !important;
  }
  .input-success {
    border-color: #4ade80 !important;
  }
  .field-error-msg {
    color: #ffb4ab;
    font-size: 0.7rem;
    margin-top: 4px;
    display: flex;
    align-items: center;
    gap: 4px;
  }
</style>
</head>
<body class="bg-background text-on-background min-h-screen">

<!-- Sidebar -->
<aside class="fixed left-0 top-0 h-full w-[280px] bg-surface border-r border-outline-variant flex flex-col py-6 shadow-sm z-50">
  <div class="px-6 mb-8">
    <h1 class="font-bold text-2xl text-primary-fixed-dim">AdminPanel</h1>
    <p class="text-on-surface-variant text-sm">Coupon Management</p>
  </div>
  <nav class="flex-1 px-4 space-y-1">
    <a class="flex items-center gap-3 px-4 py-3 rounded-lg text-on-surface-variant hover:bg-surface-container-high" href="/admin/dashboard">
      <span class="material-symbols-outlined">dashboard</span>
      <span>Dashboard</span>
    </a>
    <a class="flex items-center gap-3 px-4 py-3 rounded-lg text-primary-container font-bold border-r-4 border-primary-container bg-surface-container-high" href="/admin/coupons">
      <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1;">confirmation_number</span>
      <span>Coupons</span>
    </a>
  </nav>
  <div class="px-4 mt-auto">
    <a href="/admin/coupons-add">
      <button class="w-full bg-primary-container text-on-primary-container py-3 rounded-lg text-sm font-bold flex items-center justify-center gap-2 hover:opacity-90">
        <span class="material-symbols-outlined">add_circle</span>
        New Coupon
      </button>
    </a>
  </div>
</aside>

<!-- Top Nav -->
<header class="fixed top-0 right-0 left-[280px] h-16 bg-surface border-b border-outline-variant flex justify-between items-center px-8 z-40">
  <div class="flex items-center gap-3">
    <a href="/admin/coupons" class="p-2 text-on-surface-variant hover:bg-surface-container-high rounded-lg transition-colors">
      <span class="material-symbols-outlined">arrow_back</span>
    </a>
    <div>
      <h2 class="text-on-surface font-bold text-sm">Add New Coupon</h2>
      <p class="text-on-surface-variant text-xs">Fill in the details below</p>
    </div>
  </div>
  <div class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center text-primary-fixed-dim">
    <span class="material-symbols-outlined">account_circle</span>
  </div>
</header>

<!-- Main -->
<main class="ml-[280px] pt-16 min-h-screen">
  <div class="p-8 max-w-3xl">

    <div class="mb-8">
      <h2 class="text-3xl font-bold text-primary-fixed-dim">Create Coupon</h2>
      <p class="text-on-surface-variant text-sm mt-1">Add a new promotional discount coupon</p>
    </div>

    <!-- Server error -->
    <% if (typeof error !== 'undefined' && error) { %>
    <div class="mb-6 p-4 bg-error-container border border-error/30 rounded-xl flex items-center gap-3">
      <span class="material-symbols-outlined text-on-error-container">error</span>
      <p class="text-on-error-container text-sm"><%= error %></p>
    </div>
    <% } %>

    <form action="/admin/coupons-add" method="POST" id="couponForm" novalidate>
      <div class="bg-surface-container-low border border-outline-variant rounded-xl overflow-hidden">

        <!-- Basic Info -->
        <div class="p-6 border-b border-outline-variant">
          <h3 class="text-on-surface font-bold text-base mb-5 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary-container">info</span>
            Basic Information
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

            <!-- Coupon Code -->
            <div class="md:col-span-2">
              <label class="block text-on-surface-variant text-xs font-bold uppercase tracking-wider mb-2">
                Coupon Code <span class="text-error">*</span>
              </label>
              <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">confirmation_number</span>
                <input
                  type="text" name="code" id="code"
                  placeholder="eg: SUMMER24" maxlength="20"
                  oninput="this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, ''); validateField('code')"
                  onblur="validateField('code')"
                  class="w-full pl-10 pr-4 py-3 bg-surface-container-lowest border border-outline-variant rounded-lg text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary-container/40 transition-all"
                />
              </div>
              <div id="code-error" class="field-error-msg hidden">
                <span>⚠</span><span id="code-error-text"></span>
              </div>
              <p class="text-on-surface-variant text-xs mt-1">3–20 characters, letters and numbers only</p>
            </div>

            <!-- Discount Type -->
            <div>
              <label class="block text-on-surface-variant text-xs font-bold uppercase tracking-wider mb-2">
                Discount Type <span class="text-error">*</span>
              </label>
              <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">percent</span>
                <select
                  name="discountType" id="discountType"
                  onchange="handleTypeChange(this.value); validateField('discountType')"
                  class="w-full pl-10 pr-4 py-3 bg-surface-container-lowest border border-outline-variant rounded-lg text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary-container/40 appearance-none cursor-pointer"
                >
                  <option value="">Select type</option>
                  <option value="PERCENTAGE">Percentage (%)</option>
                  <option value="FLAT">Flat Amount (₹)</option>
                </select>
              </div>
              <div id="discountType-error" class="field-error-msg hidden">
                <span>⚠</span><span id="discountType-error-text"></span>
              </div>
            </div>

            <!-- Discount Value -->
            <div>
              <label class="block text-on-surface-variant text-xs font-bold uppercase tracking-wider mb-2">
                Discount Value <span class="text-error">*</span>
              </label>
              <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant" id="valueIcon">tag</span>
                <input
                  type="number" name="discountValue" id="discountValue"
                  placeholder="eg: 20" min="1"
                  oninput="validateField('discountValue'); validateField('minOrderValue')"
                  onblur="validateField('discountValue')"
                  class="w-full pl-10 pr-16 py-3 bg-surface-container-lowest border border-outline-variant rounded-lg text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary-container/40 transition-all"
                />
                <span id="valueSuffix" class="absolute right-4 top-1/2 -translate-y-1/2 text-on-surface-variant text-sm font-bold"></span>
              </div>
              <div id="discountValue-error" class="field-error-msg hidden">
                <span>⚠</span><span id="discountValue-error-text"></span>
              </div>
            </div>

          </div>
        </div>

        <!-- Limits & Validity -->
        <div class="p-6 border-b border-outline-variant">
          <h3 class="text-on-surface font-bold text-base mb-5 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary-container">tune</span>
            Limits & Validity
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

            <!-- Min Order Value -->
            <div>
              <label class="block text-on-surface-variant text-xs font-bold uppercase tracking-wider mb-2">
                Minimum Order Value
                <span id="minOrderStar" class="text-error hidden">*</span>
              </label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-sm font-bold">₹</span>
                <input
                  type="number" name="minOrderValue" id="minOrderValue"
                  placeholder="0" min="0"
                  oninput="validateField('minOrderValue'); validateField('discountValue')"
                  onblur="validateField('minOrderValue')"
                  class="w-full pl-8 pr-4 py-3 bg-surface-container-lowest border border-outline-variant rounded-lg text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary-container/40 transition-all"
                />
              </div>
              <div id="minOrderValue-error" class="field-error-msg hidden">
                <span>⚠</span><span id="minOrderValue-error-text"></span>
              </div>
              <p class="text-on-surface-variant text-xs mt-1" id="minOrderHint">Leave 0 for no minimum</p>
            </div>

            <!-- Max Discount -->
            <div id="maxDiscountField">
              <label class="block text-on-surface-variant text-xs font-bold uppercase tracking-wider mb-2">
                Maximum Discount
              </label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-sm font-bold">₹</span>
                <input
                  type="number" name="maxDiscount" id="maxDiscount"
                  placeholder="No limit" min="0"
                  oninput="validateField('maxDiscount')"
                  onblur="validateField('maxDiscount')"
                  class="w-full pl-8 pr-4 py-3 bg-surface-container-lowest border border-outline-variant rounded-lg text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary-container/40 transition-all"
                />
              </div>
              <div id="maxDiscount-error" class="field-error-msg hidden">
                <span>⚠</span><span id="maxDiscount-error-text"></span>
              </div>
              <p class="text-on-surface-variant text-xs mt-1">Cap for percentage discounts</p>
            </div>

            <!-- Expiry Date -->
            <div>
              <label class="block text-on-surface-variant text-xs font-bold uppercase tracking-wider mb-2">
                Expiry Date <span class="text-error">*</span>
              </label>
              <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">calendar_month</span>
                <input
                  type="date" name="expiryDate" id="expiryDate"
                  onchange="validateField('expiryDate')"
                  onblur="validateField('expiryDate')"
                  class="w-full pl-10 pr-4 py-3 bg-surface-container-lowest border border-outline-variant rounded-lg text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary-container/40 transition-all"
                />
              </div>
              <div id="expiryDate-error" class="field-error-msg hidden">
                <span>⚠</span><span id="expiryDate-error-text"></span>
              </div>
            </div>

            <!-- Usage Limit -->
            <div>
              <label class="block text-on-surface-variant text-xs font-bold uppercase tracking-wider mb-2">
                Total Usage Limit
              </label>
              <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">group</span>
                <input
                  type="number" name="usageLimit" id="usageLimit"
                  placeholder="Unlimited" min="1"
                  oninput="validateField('usageLimit')"
                  onblur="validateField('usageLimit')"
                  class="w-full pl-10 pr-4 py-3 bg-surface-container-lowest border border-outline-variant rounded-lg text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary-container/40 transition-all"
                />
              </div>
              <div id="usageLimit-error" class="field-error-msg hidden">
                <span>⚠</span><span id="usageLimit-error-text"></span>
              </div>
              <p class="text-on-surface-variant text-xs mt-1">Leave empty for unlimited uses</p>
            </div>

          </div>
        </div>

        <!-- Status -->
        <div class="p-6 border-b border-outline-variant">
          <h3 class="text-on-surface font-bold text-base mb-5 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary-container">toggle_on</span>
            Status
          </h3>
          <div class="flex items-center justify-between p-4 bg-surface-container-lowest border border-outline-variant rounded-lg">
            <div>
              <p class="text-on-surface text-sm font-bold">Active</p>
              <p class="text-on-surface-variant text-xs">Coupon will be immediately usable</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" name="isActive" id="isActive" class="sr-only peer" checked>
              <div class="w-11 h-6 bg-outline-variant peer-focus:outline-none rounded-full peer
                peer-checked:after:translate-x-full peer-checked:after:border-white
                after:content-[''] after:absolute after:top-[2px] after:left-[2px]
                after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all
                peer-checked:bg-primary-container">
              </div>
            </label>
          </div>
        </div>

        <!-- Actions -->
        <div class="p-6 flex items-center justify-between">
          <a href="/admin/coupons">
            <button type="button" class="px-6 py-3 border border-outline-variant rounded-lg text-on-surface text-sm hover:bg-surface-container transition-colors flex items-center gap-2">
              <span class="material-symbols-outlined text-sm">close</span>
              Cancel
            </button>
          </a>
          <button type="submit" id="submitBtn" class="px-8 py-3 bg-primary-container text-on-primary-container rounded-lg text-sm font-bold hover:opacity-90 transition-opacity flex items-center gap-2">
            <span class="material-symbols-outlined text-sm">add_circle</span>
            Create Coupon
          </button>
        </div>

      </div>
    </form>
  </div>
</main>

<script>
  // ── Set min expiry date ──────────────────────────────────
  const todayStr = new Date().toISOString().split("T")[0];
  document.getElementById("expiryDate").min = todayStr;

  // ── Type change handler ──────────────────────────────────
  function handleTypeChange(value) {
    const suffix     = document.getElementById("valueSuffix");
    const icon       = document.getElementById("valueIcon");
    const maxDiv     = document.getElementById("maxDiscountField");
    const minStar    = document.getElementById("minOrderStar");
    const minHint    = document.getElementById("minOrderHint");
    const valueInput = document.getElementById("discountValue");

    if (value === "PERCENTAGE") {
      suffix.textContent = "%";
      icon.textContent   = "percent";
      maxDiv.classList.remove("opacity-40", "pointer-events-none");
      valueInput.max         = 100;
      valueInput.placeholder = "eg: 20";
      minStar.classList.add("hidden");
      minHint.textContent = "Leave 0 for no minimum";
    } else if (value === "FLAT") {
      suffix.textContent = "₹";
      icon.textContent   = "currency_rupee";
      maxDiv.classList.add("opacity-40", "pointer-events-none");
      document.getElementById("maxDiscount").value = "";
      valueInput.removeAttribute("max");
      valueInput.placeholder = "eg: 100";
      minStar.classList.remove("hidden");
      minHint.textContent = "Required — must be greater than discount value";
    } else {
      suffix.textContent = "";
    }

    // Re-validate related fields when type changes
    validateField("discountValue");
    validateField("minOrderValue");
  }

  // ── Show / Clear field error ─────────────────────────────
  function showError(fieldId, message) {
    const input = document.getElementById(fieldId);
    const errDiv  = document.getElementById(fieldId + "-error");
    const errText = document.getElementById(fieldId + "-error-text");
    if (!input || !errDiv) return;

    input.classList.add("input-error");
    input.classList.remove("input-success");
    errDiv.classList.remove("hidden");
    errText.textContent = message;
  }

  function clearError(fieldId) {
    const input  = document.getElementById(fieldId);
    const errDiv = document.getElementById(fieldId + "-error");
    if (!input || !errDiv) return;

    input.classList.remove("input-error");
    input.classList.add("input-success");
    errDiv.classList.add("hidden");
  }

  function resetField(fieldId) {
    const input  = document.getElementById(fieldId);
    const errDiv = document.getElementById(fieldId + "-error");
    if (!input || !errDiv) return;

    input.classList.remove("input-error", "input-success");
    errDiv.classList.add("hidden");
  }

  // ── Per-field validation ─────────────────────────────────
  function validateField(fieldId) {
    const type     = document.getElementById("discountType").value;
    const discount = parseFloat(document.getElementById("discountValue").value) || 0;
    const minOrder = parseFloat(document.getElementById("minOrderValue").value) || 0;

    switch (fieldId) {

      case "code": {
        const val = document.getElementById("code").value.trim();
        if (!val)                          return showError("code", "Coupon code is required");
        if (val.length < 3)               return showError("code", "Minimum 3 characters required");
        if (!/^[A-Z0-9]+$/.test(val))     return showError("code", "Only letters and numbers allowed");
        clearError("code");
        break;
      }

      case "discountType": {
        if (!type) return showError("discountType", "Please select a discount type");
        clearError("discountType");
        break;
      }

      case "discountValue": {
        const val = parseFloat(document.getElementById("discountValue").value);
        if (!val || isNaN(val))            return showError("discountValue", "Discount value is required");
        if (val <= 0)                      return showError("discountValue", "Must be greater than 0");
        if (type === "PERCENTAGE" && val >= 100)
  return showError("discountValue", "Percentage must be between 1 and 99");

        if (type === "FLAT" && minOrder > 0 && val >= minOrder)
          return showError("discountValue", `Must be less than min order ₹${minOrder}`);
        clearError("discountValue");
        break;
      }

      case "minOrderValue": {
        if (minOrder < 0) return showError("minOrderValue", "Cannot be negative");
        if (type === "FLAT") {
          if (minOrder <= 0)       return showError("minOrderValue", "Required for flat discount");
          if (discount > 0 && minOrder <= discount)
            return showError("minOrderValue", `Must be greater than discount ₹${discount}`);
        }
        if (minOrder > 0) clearError("minOrderValue");
        else resetField("minOrderValue");
        break;
      }

      case "maxDiscount": {
        const val = parseFloat(document.getElementById("maxDiscount").value);
        if (!val || isNaN(val)) { resetField("maxDiscount"); break; }
        if (val <= 0)             return showError("maxDiscount", "Must be greater than 0");
        if (minOrder > 0 && val >= minOrder)
          return showError("maxDiscount", `Must be less than min order ₹${minOrder}`);
        clearError("maxDiscount");
        break;
      }

      case "expiryDate": {
        const val = document.getElementById("expiryDate").value;
        if (!val) return showError("expiryDate", "Expiry date is required");
        const today = new Date(); today.setHours(0,0,0,0);
        if (new Date(val) <= today) return showError("expiryDate", "Must be a future date");
        clearError("expiryDate");
        break;
      }

      case "usageLimit": {
        const val = parseInt(document.getElementById("usageLimit").value);
        if (!document.getElementById("usageLimit").value) { resetField("usageLimit"); break; }
        if (isNaN(val) || val < 1) return showError("usageLimit", "Must be at least 1");
        clearError("usageLimit");
        break;
      }
    }
  }

  // ── Full form validation on submit ───────────────────────
  document.getElementById("couponForm").addEventListener("submit", function(e) {
    e.preventDefault();

    // Validate all fields
    ["code", "discountType", "discountValue", "minOrderValue", "maxDiscount", "expiryDate", "usageLimit"]
      .forEach(validateField);

    // Collect visible errors
    const errorMessages = [];
    document.querySelectorAll(".field-error-msg:not(.hidden) span:last-child").forEach(el => {
      if (el.textContent) errorMessages.push(el.textContent);
    });

    if (errorMessages.length > 0) {
      Swal.fire({
        title: "Please fix the following:",
        html: `<ul class="text-left space-y-2 mt-2">
          ${errorMessages.map(msg => `
            <li class="flex items-start gap-2 text-sm">
              <span style="color:#ffb4ab;margin-top:1px">✕</span>
              <span>${msg}</span>
            </li>`).join("")}
        </ul>`,
        icon: "error",
        background: "#171f33",
        color: "#dae2fd",
        confirmButtonColor: "#38bdf8",
        confirmButtonText: "Fix Issues",
      });
      return;
    }

    // All valid — submit
    this.submit();
  });
</script>
</body>
</html>
