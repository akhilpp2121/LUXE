<!DOCTYPE html>
<html class="dark" lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>My Orders | LUXE Internationale</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<script id="tailwind-config">
  tailwind.config = {
    darkMode: "class",
    theme: {
      extend: {
        colors: {
          "on-primary-container": "#74829d",
          "outline": "#8f9097",
          "on-surface": "#d8e2ff",
          "on-secondary-fixed": "#241a00",
          "on-primary-fixed": "#0d1c32",
          "tertiary-fixed": "#e2e2e4",
          "surface-container-low": "#091b39",
          "outline-variant": "#44474d",
          "on-tertiary-container": "#808284",
          "surface-dim": "#011230",
          "inverse-primary": "#515f78",
          "on-primary-fixed-variant": "#39475f",
          "error": "#ffb4ab",
          "secondary-container": "#af8d11",
          "on-tertiary-fixed-variant": "#454749",
          "on-background": "#d8e2ff",
          "secondary": "#e9c349",
          "on-secondary-fixed-variant": "#574500",
          "on-secondary-container": "#342800",
          "on-secondary": "#3c2f00",
          "primary-fixed": "#d6e3ff",
          "background": "#011230",
          "error-container": "#93000a",
          "on-tertiary": "#2f3132",
          "on-surface-variant": "#c5c6cd",
          "surface-tint": "#b9c7e4",
          "primary": "#b9c7e4",
          "tertiary-container": "#17191b",
          "inverse-on-surface": "#20304f",
          "primary-fixed-dim": "#b9c7e4",
          "primary-container": "#0a192f",
          "tertiary-fixed-dim": "#c6c6c8",
          "tertiary": "#c6c6c8",
          "surface-bright": "#293958",
          "on-error-container": "#ffdad6",
          "surface-container": "#0e1f3d",
          "surface": "#011230",
          "on-primary": "#233148",
          "on-error": "#690005",
          "surface-container-highest": "#253453",
          "inverse-surface": "#d8e2ff",
          "secondary-fixed-dim": "#e9c349",
          "surface-container-high": "#192a48",
          "secondary-fixed": "#ffe088",
          "on-tertiary-fixed": "#1a1c1d"
        },
        borderRadius: {
          "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px"
        },
        spacing: {
          "base": "8px", "gutter": "24px", "section-gap": "120px",
          "margin-desktop": "80px", "margin-mobile": "20px"
        },
        fontFamily: {
          "label-sm": ["Inter"], "label-md": ["Inter"],
          "body-lg": ["Inter"], "body-md": ["Inter"],
          "headline-md": ["Playfair Display"], "headline-lg": ["Playfair Display"],
          "display-lg": ["Playfair Display"], "headline-lg-mobile": ["Playfair Display"]
        },
        fontSize: {
          "label-sm": ["12px", {"lineHeight":"1.2","letterSpacing":"0.05em","fontWeight":"500"}],
          "label-md": ["14px", {"lineHeight":"1.2","letterSpacing":"0.1em","fontWeight":"600"}],
          "body-lg":  ["18px", {"lineHeight":"1.6","fontWeight":"400"}],
          "body-md":  ["16px", {"lineHeight":"1.6","fontWeight":"400"}],
          "headline-md": ["28px", {"lineHeight":"1.3","fontWeight":"500"}],
          "headline-lg": ["40px", {"lineHeight":"1.2","fontWeight":"600"}],
          "display-lg":  ["64px", {"lineHeight":"1.1","letterSpacing":"-0.02em","fontWeight":"700"}],
          "headline-lg-mobile": ["32px", {"lineHeight":"1.2","fontWeight":"600"}]
        }
      }
    }
  }
</script>
<style>
  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
    vertical-align: middle;
  }
  .order-card-hover { transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
  .order-card-hover:hover {
    background-color: #0e1f3d;
    border-color: #e9c349;
    transform: translateY(-2px);
  }
  .order-thumbnail-zoom { overflow: hidden; }
  .order-thumbnail-zoom img { transition: transform 0.5s ease; }
  .order-card-hover:hover .order-thumbnail-zoom img { transform: scale(1.1); }
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: #011230; }
  ::-webkit-scrollbar-thumb { background: #44474d; border-radius: 10px; }
  ::-webkit-scrollbar-thumb:hover { background: #e9c349; }
</style>
</head>
<body class="bg-background text-on-background font-body-md antialiased min-h-screen flex flex-col">

<!-- TopNavBar -->
<nav class="fixed top-0 w-full z-50 bg-background/80 backdrop-blur-md border-b border-outline-variant/30 shadow-sm flex justify-between items-center px-margin-desktop py-base w-full max-w-none">
  <div class="flex items-center">
    <span class="font-headline-lg text-headline-lg text-secondary">LUXE</span>
  </div>
  <div class="hidden md:flex items-center space-x-gutter">
    <a class="font-label-md text-label-md uppercase tracking-widest text-on-surface-variant hover:text-secondary transition-colors duration-300" href="#">Collections</a>
    <a class="font-label-md text-label-md uppercase tracking-widest text-on-surface-variant hover:text-secondary transition-colors duration-300" href="#">New Arrivals</a>
    <a class="font-label-md text-label-md uppercase tracking-widest text-on-surface-variant hover:text-secondary transition-colors duration-300" href="#">Bespoke</a>
    <a class="font-label-md text-label-md uppercase tracking-widest text-on-surface-variant hover:text-secondary transition-colors duration-300" href="#">Heritage</a>
  </div>
  <div class="flex items-center space-x-gutter">
    <button class="text-on-surface-variant hover:text-secondary transition-all duration-300 ease-in-out">
      <span class="material-symbols-outlined">shopping_bag</span>
    </button>
    <button class="text-secondary border-b border-secondary pb-1 transition-all duration-300 ease-in-out">
      <span class="material-symbols-outlined">person</span>
    </button>
  </div>
</nav>

<!-- Main Content -->
<main class="flex-grow pt-[120px] pb-section-gap px-margin-mobile md:px-margin-desktop max-w-[1440px] mx-auto w-full">

  <!-- Header -->
  <header class="mb-gutter md:mb-section-gap flex flex-col md:flex-row md:items-end justify-between gap-base">
    <div>
      <h1 class="font-headline-lg text-headline-lg mb-2">My Orders</h1>
      <p class="text-on-tertiary-container font-label-md uppercase tracking-widest">A curated history of your acquisitions</p>
    </div>
    <div class="flex gap-base">
      <button class="px-6 py-2 border border-outline-variant text-label-md uppercase tracking-wider hover:border-secondary hover:text-secondary transition-all duration-300">Filter</button>
      <button class="px-6 py-2 bg-secondary text-on-secondary font-label-md uppercase tracking-wider transition-all duration-300 hover:opacity-90">Track All</button>
    </div>
  </header>

  <!-- Order Listing -->
  <div class="space-y-gutter">

    <% if (!orders || orders.length === 0) { %>
      <!-- Empty State -->
      <div class="flex flex-col items-center justify-center py-32 gap-6 text-center">
        <span class="material-symbols-outlined text-6xl text-on-tertiary-container">inbox</span>
        <p class="font-headline-md text-headline-md text-on-surface">No orders yet</p>
        <p class="text-on-tertiary-container font-label-md uppercase tracking-widest">Your acquisitions will appear here</p>
        <a href="/shop">
          <button class="mt-4 px-8 py-3 bg-secondary text-on-secondary font-label-md uppercase tracking-wider hover:opacity-90 transition-all">
            Begin Shopping
          </button>
        </a>
      </div>

    <% } else { %>
      <% orders.forEach(function(o) { %>
        <%
          /* ── resolve first active item for thumbnail ── */
          const cancelledVIds = new Set(
            (o.cancelledAt || []).flatMap(ca =>
              (ca.cancelledProducts || []).map(cp => cp && cp._id ? cp._id.toString() : String(cp))
            )
          );
          const activeItems = (o.orderItems || []).filter(item => {
            const vid = item.variantId && typeof item.variantId === 'object'
              ? item.variantId._id.toString()
              : String(item.variantId);
            return !cancelledVIds.has(vid);
          });
          const firstItem  = activeItems[0] || (o.orderItems || [])[0];
          const firstVariant = firstItem && firstItem.variantId && typeof firstItem.variantId === 'object'
            ? firstItem.variantId : null;
          const firstImages  = firstVariant ? (firstVariant.images || firstVariant.image || []) : [];
          const firstThumb   = firstImages[0] ? '/uploads/' + firstImages[0] : '/images/placeholder.png';

          /* ── status display ── */
          const st = (o.orderStatus || '').toLowerCase();
          const isDelivered  = st === 'completed';
          const isCancelled  = st === 'cancelled';
          const isProcessing = st === 'placed' || st === 'pending';
          const isTransit    = st === 'processing' || st === 'shipped';

          /* ── total items count ── */
          const totalQty = (o.orderItems || []).reduce((s, i) => s + (i.quantity || 1), 0);
        %>

        <div class="order-card-hover border border-outline-variant/30 bg-surface-container-lowest p-gutter rounded-none flex flex-col md:flex-row gap-gutter">
          <div class="flex-grow flex flex-col justify-between">

            <!-- Top row: meta -->
            <div class="flex flex-wrap justify-between items-start gap-base mb-gutter">

              <div>
                <span class="font-label-sm text-label-sm text-on-tertiary-container uppercase mb-1 block">Order Reference</span>
                <h3 class="font-body-lg text-body-lg font-bold text-on-surface">#<%= o.orderCode %></h3>
              </div>

              <div>
                <span class="font-label-sm text-label-sm text-on-tertiary-container uppercase mb-1 block">Placed On</span>
                <p class="text-on-surface"><%= new Date(o.orderDate).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %></p>
              </div>

              <div>
                <span class="font-label-sm text-label-sm text-on-tertiary-container uppercase mb-1 block">Status</span>
                <% if (isDelivered) { %>
                  <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-secondary text-[18px]">check_circle</span>
                    <span class="text-secondary font-label-md uppercase">Delivered</span>
                  </div>
                <% } else if (isCancelled) { %>
                  <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-error text-[18px]">cancel</span>
                    <span class="text-error font-label-md uppercase">Cancelled</span>
                  </div>
                <% } else if (isTransit) { %>
                  <div class="flex items-center gap-2 text-on-primary-container">
                    <span class="material-symbols-outlined text-[18px]">local_shipping</span>
                    <span class="font-label-md uppercase">In Transit</span>
                  </div>
                <% } else { %>
                  <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
                    <span class="text-secondary font-label-md uppercase">Processing</span>
                  </div>
                <% } %>
              </div>

              <div>
                <span class="font-label-sm text-label-sm text-on-tertiary-container uppercase mb-1 block">Total</span>
                <p class="text-on-surface font-bold text-body-lg">₹<%= (o.totalAmount || 0).toFixed(2) %></p>
              </div>

            </div>

            <!-- Bottom row: thumbnail + actions -->
            <div class="flex items-center gap-4 mt-auto">

              <!-- Thumbnails (up to 2) -->
              <div class="flex -space-x-4">
                <% (o.orderItems || []).slice(0, 2).forEach(function(item, idx) {
                  const v   = item.variantId && typeof item.variantId === 'object' ? item.variantId : null;
                  const img = v ? (v.images || v.image || [])[0] : null;
                  const src = img ? '/uploads/' + img : '/images/placeholder.png';
                %>
                  <div class="order-thumbnail-zoom w-20 h-20 bg-surface-bright flex-shrink-0 border-2 border-background" style="z-index:<%= 20 - idx %>;">
                    <img alt="<%= item.productName || 'Product' %>" class="w-full h-full object-cover" src="<%= src %>"/>
                  </div>
                <% }) %>
              </div>

              <!-- Item name + qty -->
              <div class="hidden sm:block">
                <p class="text-on-surface font-label-md"><%= firstItem ? firstItem.productName : 'N/A' %></p>
                <p class="text-on-tertiary-container text-label-sm uppercase">
                  Qty: <%= totalQty %> item<%= totalQty !== 1 ? 's' : '' %>
                </p>
              </div>

              <!-- View Details -->
              <div class="ml-auto">
                <a href="/order/details/<%=o. _id %>">
                  <button class="group flex items-center gap-2 text-label-md uppercase tracking-widest text-on-surface-variant hover:text-secondary transition-colors">
                    View Details
                    <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
                  </button>
                </a>
              </div>

            </div>
          </div>
        </div>

      <% }) %>
    <% } %>

  </div>

  <!-- Pagination -->
  <% if (pagination && pagination.totalPages > 1) { %>
    <div class="mt-section-gap flex justify-center items-center gap-4">
      <% if (pagination.currentPage > 1) { %>
        <a href="?page=<%= pagination.currentPage - 1 %>" class="px-4 py-2 border border-outline-variant text-on-surface-variant hover:border-secondary hover:text-secondary transition-all font-label-md uppercase tracking-wider">Prev</a>
      <% } %>
      <span class="font-label-md text-on-tertiary-container uppercase tracking-widest">
        Page <%= pagination.currentPage %> of <%= pagination.totalPages %>
      </span>
      <% if (pagination.currentPage < pagination.totalPages) { %>
        <a href="?page=<%= pagination.currentPage + 1 %>" class="px-4 py-2 border border-outline-variant text-on-surface-variant hover:border-secondary hover:text-secondary transition-all font-label-md uppercase tracking-wider">Next</a>
      <% } %>
    </div>
  <% } %>

</main>

<!-- Footer -->
<footer class="w-full bg-surface-container-lowest border-t border-outline-variant/20 flex flex-col md:flex-row justify-between items-center px-margin-desktop py-gutter gap-base">
  <div class="flex flex-col items-center md:items-start gap-2">
    <span class="font-headline-md text-headline-md text-secondary">LUXE</span>
    <p class="font-label-sm text-label-sm uppercase tracking-tighter text-on-tertiary-container">© 2024 LUXE INTERNATIONALE. ALL RIGHTS RESERVED.</p>
  </div>
  <div class="flex flex-wrap justify-center gap-gutter">
    <a class="font-label-sm text-label-sm uppercase tracking-tighter text-on-tertiary-container hover:text-secondary transition-colors duration-300" href="#">Privacy Policy</a>
    <a class="font-label-sm text-label-sm uppercase tracking-tighter text-on-tertiary-container hover:text-secondary transition-colors duration-300" href="#">Terms of Service</a>
    <a class="font-label-sm text-label-sm uppercase tracking-tighter text-on-tertiary-container hover:text-secondary transition-colors duration-300" href="#">Shipping &amp; Returns</a>
    <a class="font-label-sm text-label-sm uppercase tracking-tighter text-on-tertiary-container hover:text-secondary transition-colors duration-300" href="#">Contact Us</a>
  </div>
</footer>

<script>
  document.querySelectorAll('.order-card-hover').forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
      card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
    });
  });

  window.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.order-card-hover').forEach((card, index) => {
      card.style.opacity = '0';
      card.style.transform = 'translateY(20px)';
      setTimeout(() => {
        card.style.transition = 'all 0.6s cubic-bezier(0.2, 0.8, 0.2, 1)';
        card.style.opacity = '1';
        card.style.transform = 'translateY(0)';
      }, 100 * index);
    });
  });
</script>
</body>
</html>