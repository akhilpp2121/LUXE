<!DOCTYPE html>
<html class="dark" lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Coupon Manager | All Coupons</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
<script id="tailwind-config">
  tailwind.config = {
    darkMode: "class",
    theme: {
      extend: {
        "colors": {
          "inverse-primary": "#00668a",
          "on-secondary-fixed-variant": "#39485a",
          "background": "#0b1326",
          "on-tertiary-fixed-variant": "#653e00",
          "secondary-container": "#39485a",
          "on-tertiary": "#472a00",
          "surface": "#0b1326",
          "outline": "#87929a",
          "on-tertiary-container": "#613b00",
          "tertiary-container": "#f1a02b",
          "inverse-surface": "#dae2fd",
          "error": "#ffb4ab",
          "error-container": "#93000a",
          "on-secondary-fixed": "#0d1c2d",
          "on-primary-fixed-variant": "#004c69",
          "on-surface-variant": "#bdc8d1",
          "on-error-container": "#ffdad6",
          "secondary": "#b9c8de",
          "on-secondary": "#233143",
          "on-error": "#690005",
          "on-primary-fixed": "#001e2c",
          "surface-variant": "#2d3449",
          "primary-container": "#38bdf8",
          "inverse-on-surface": "#283044",
          "secondary-fixed": "#d4e4fa",
          "on-secondary-container": "#a7b6cc",
          "surface-container": "#171f33",
          "surface-container-lowest": "#060e20",
          "primary": "#8ed5ff",
          "tertiary": "#ffc176",
          "surface-container-highest": "#2d3449",
          "surface-container-low": "#131b2e",
          "surface-bright": "#31394d",
          "secondary-fixed-dim": "#b9c8de",
          "surface-dim": "#0b1326",
          "tertiary-fixed": "#ffddb8",
          "on-surface": "#dae2fd",
          "surface-tint": "#7bd0ff",
          "primary-fixed": "#c4e7ff",
          "on-primary": "#00354a",
          "primary-fixed-dim": "#7bd0ff",
          "tertiary-fixed-dim": "#ffb960",
          "on-tertiary-fixed": "#2a1700",
          "on-primary-container": "#004965",
          "outline-variant": "#3e484f",
          "surface-container-high": "#222a3d",
          "on-background": "#dae2fd"
        },
        "borderRadius": {
          "DEFAULT": "0.125rem","lg": "0.25rem","xl": "0.5rem","full": "0.75rem"
        },
        "fontFamily": {
          "label-md": ["JetBrains Mono"],
          "body-lg": ["Inter"], "body-md": ["Inter"],
          "headline-xl-mobile": ["IBM Plex Sans"],
          "label-sm": ["JetBrains Mono"],
          "body-sm": ["Inter"],
          "headline-lg": ["IBM Plex Sans"],
          "headline-md": ["IBM Plex Sans"],
          "headline-xl": ["IBM Plex Sans"]
        }
      }
    }
  }
</script>
<style>
  body { font-family: 'Inter', sans-serif; }
  h1, h2, h3, h4 { font-family: 'IBM Plex Sans', sans-serif; }
  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    vertical-align: middle;
  }
  .custom-scrollbar::-webkit-scrollbar { width: 4px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: #3e484f; border-radius: 10px; }
  #clearBtn { display: none; }
  #clearBtn.visible { display: flex; }
</style>
</head>
<body class="bg-background text-on-background min-h-screen">

<!-- Sidebar -->
<aside class="fixed left-0 top-0 h-full w-[280px] bg-surface border-r border-outline-variant flex flex-col py-6 shadow-sm z-50">
  <div class="px-6 mb-8">
    <h1 class="font-bold text-2xl text-primary-fixed-dim">AdminPanel</h1>
    <p class="text-on-surface-variant text-sm">Coupon Management</p>
  </div>
  <nav class="flex-1 px-4 space-y-1">
    <a class="flex items-center gap-3 px-4 py-3 rounded-lg text-on-surface-variant hover:bg-surface-container-high" href="/admin/dashboard">
      <span class="material-symbols-outlined">dashboard</span>
      <span>Dashboard</span>
    </a>
    <a class="flex items-center gap-3 px-4 py-3 rounded-lg text-primary-container font-bold border-r-4 border-primary-container bg-surface-container-high" href="/admin/coupons">
      <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1;">confirmation_number</span>
      <span>Coupons</span>
    </a>
  </nav>
  <div class="px-4 mt-auto">
    <a href="/admin/coupons-add">
      <button class="w-full bg-primary-container text-on-primary-container py-3 rounded-lg text-sm font-bold flex items-center justify-center gap-2 hover:opacity-90">
        <span class="material-symbols-outlined">add_circle</span>
        New Coupon
      </button>
    </a>
  </div>
</aside>

<!-- Top Nav -->
<header class="fixed top-0 right-0 left-[280px] h-16 bg-surface border-b border-outline-variant flex justify-between items-center px-8 z-40">
  <div class="flex items-center flex-1 max-w-md">
    <div class="relative w-full">
      <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
      <input
        id="searchInput"
        class="w-full pl-10 pr-10 py-2 bg-surface-container-lowest border border-outline-variant rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-container/40 text-sm text-on-surface"
        placeholder="Search coupons..."
        type="text"
        value="<%= search %>"
        oninput="handleSearch(this.value); toggleClearBtn(this.value)"
      />
      <!-- Clear button -->
      <button
        id="clearBtn"
        onclick="clearSearch()"
        class="absolute right-2 top-1/2 -translate-y-1/2 items-center justify-center w-5 h-5 rounded-full bg-outline-variant hover:bg-on-surface-variant transition-colors"
        title="Clear search"
      >
        <span class="material-symbols-outlined text-on-background" style="font-size:14px;line-height:1">close</span>
      </button>
    </div>
  </div>
  <div class="flex items-center gap-4">
    <a href="/admin/coupons-add">
      <button class="bg-primary-container text-on-primary-container px-4 py-2 rounded-lg text-sm font-bold hover:opacity-90">
        Create New Coupon
      </button>
    </a>
    <div class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center text-primary-fixed-dim">
      <span class="material-symbols-outlined">account_circle</span>
    </div>
  </div>
</header>

<!-- Main -->
<main class="ml-[280px] pt-16 min-h-screen">
  <div class="p-8 space-y-6">

    <!-- Page Header -->
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-3xl font-bold text-primary-fixed-dim">Coupons</h2>
        <p class="text-on-surface-variant text-sm mt-1">Manage and monitor your promotional discount campaigns.</p>
      </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

      <!-- Active -->
      <div class="bg-surface-container-low border border-outline-variant p-6 rounded-xl flex items-start justify-between">
        <div>
          <p class="text-on-surface-variant text-xs font-bold uppercase tracking-wider mb-1">Active Coupons</p>
          <h3 class="text-3xl font-bold text-on-surface"><%= stats.activeCoupons %></h3>
          <p class="text-primary text-xs flex items-center gap-1 mt-2">
            <span class="material-symbols-outlined text-sm">confirmation_number</span>
            Total active
          </p>
        </div>
        <div class="w-12 h-12 bg-primary-container/20 rounded-lg flex items-center justify-center text-primary-container">
          <span class="material-symbols-outlined">confirmation_number</span>
        </div>
      </div>

      <!-- Expired -->
      <div class="bg-surface-container-low border border-outline-variant p-6 rounded-xl flex items-start justify-between">
        <div>
          <p class="text-on-surface-variant text-xs font-bold uppercase tracking-wider mb-1">Expired Coupons</p>
          <h3 class="text-3xl font-bold text-on-surface"><%= stats.expiredCoupons %></h3>
          <p class="text-on-surface-variant text-xs flex items-center gap-1 mt-2">
            <span class="material-symbols-outlined text-sm">event_busy</span>
            Past expiry date
          </p>
        </div>
        <div class="w-12 h-12 bg-surface-container rounded-lg flex items-center justify-center text-on-surface-variant">
          <span class="material-symbols-outlined">event_busy</span>
        </div>
      </div>

      <!-- Expiring Soon -->
      <div class="bg-surface-container-low border border-outline-variant p-6 rounded-xl flex items-start justify-between">
        <div>
          <p class="text-on-surface-variant text-xs font-bold uppercase tracking-wider mb-1">Expiring Soon</p>
          <h3 class="text-3xl font-bold text-on-surface"><%= stats.expiringSoon %></h3>
          <p class="text-error text-xs flex items-center gap-1 mt-2">
            <span class="material-symbols-outlined text-sm">schedule</span>
            Within 7 days
          </p>
        </div>
        <div class="w-12 h-12 bg-error-container rounded-lg flex items-center justify-center text-on-error-container">
          <span class="material-symbols-outlined">timer</span>
        </div>
      </div>

    </div>

    <!-- Table Card -->
    <div class="bg-surface-container-low border border-outline-variant rounded-xl shadow-sm overflow-hidden flex flex-col">

      <!-- Filters -->
      <div class="p-6 border-b border-outline-variant flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-4 w-full md:w-auto">

          <!-- Status Filter -->
          <div class="relative w-full md:w-56">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-sm">filter_list</span>
            <select
              onchange="handleStatus(this.value)"
              class="w-full pl-10 pr-4 py-2 bg-surface-container-lowest border border-outline-variant rounded-lg focus:outline-none text-on-surface text-sm appearance-none cursor-pointer"
            >
              <option value="" <%= status === '' ? 'selected' : '' %>>All Statuses</option>
              <option value="true"  <%= status === 'true'  ? 'selected' : '' %>>Active</option>
              <option value="false" <%= status === 'false' ? 'selected' : '' %>>Inactive</option>
            </select>
          </div>

          <!-- Reset -->
          <a href="/admin/coupons">
            <button class="px-4 py-2 bg-surface-container-lowest border border-outline-variant rounded-lg text-on-surface text-sm hover:bg-surface-container flex items-center gap-2">
              <span class="material-symbols-outlined text-sm">refresh</span>
              Reset
            </button>
          </a>

        </div>
        <div class="text-on-surface-variant text-xs font-bold">
          Showing
          <span class="text-on-surface">
            <%= pagination.total === 0 ? 0 : (pagination.currentPage - 1) * pagination.limit + 1 %>–<%= Math.min(pagination.currentPage * pagination.limit, pagination.total) %>
          </span>
          of
          <span class="text-on-surface"><%= pagination.total %></span>
          coupons
        </div>
      </div>

      <!-- Table -->
      <div class="overflow-x-auto custom-scrollbar">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-surface-container-lowest border-b border-outline-variant">
              <th class="px-6 py-4 text-on-surface-variant text-xs font-bold uppercase">#</th>
              <th class="px-6 py-4 text-on-surface-variant text-xs font-bold uppercase">Coupon Code</th>
              <th class="px-6 py-4 text-on-surface-variant text-xs font-bold uppercase">Type</th>
              <th class="px-6 py-4 text-on-surface-variant text-xs font-bold uppercase">Value</th>
              <th class="px-6 py-4 text-on-surface-variant text-xs font-bold uppercase">Min Order</th>
              <th class="px-6 py-4 text-on-surface-variant text-xs font-bold uppercase">Expiry</th>
              <th class="px-6 py-4 text-on-surface-variant text-xs font-bold uppercase">Usage</th>
              <th class="px-6 py-4 text-on-surface-variant text-xs font-bold uppercase text-center">Status</th>
              <th class="px-6 py-4 text-on-surface-variant text-xs font-bold uppercase text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-outline-variant">

            <% if (coupons.length === 0) { %>
            <tr>
              <td colspan="9" class="px-6 py-16 text-center text-on-surface-variant">
                <span class="material-symbols-outlined text-5xl block mb-3">confirmation_number</span>
                No coupons found
              </td>
            </tr>
            <% } %>

            <% coupons.forEach((c, i) => { %>
            <%
              const now = new Date();
              const isExpired = new Date(c.expiryDate) < now;
              const usagePercent = c.baseLimit ? Math.round(((c.baseLimit - c.usageLimit) / c.baseLimit) * 100) : 0;
              const usedCount = c.baseLimit ? (c.baseLimit - c.usageLimit) : 0;
            %>
            <tr class="hover:bg-surface-container-highest transition-colors">

              <!-- # -->
              <td class="px-6 py-4 text-on-surface-variant text-sm">
                <%= (pagination.currentPage - 1) * pagination.limit + i + 1 %>
              </td>

              <!-- Code -->
              <td class="px-6 py-4">
                <span class="font-bold text-on-surface text-sm font-mono"><%= c.code %></span>
              </td>

              <!-- Type -->
              <td class="px-6 py-4 text-on-surface text-sm">
                <%= c.discountType === 'PERCENTAGE' ? 'Percentage' : 'Flat Amount' %>
              </td>

              <!-- Value -->
              <td class="px-6 py-4 text-on-surface text-sm font-bold">
                <% if (c.discountType === 'PERCENTAGE') { %>
                  <%= c.discountValue %>%
                <% } else { %>
                  ₹<%= c.discountValue %>
                <% } %>
              </td>

              <!-- Min Order -->
              <td class="px-6 py-4 text-on-surface-variant text-sm">
                <% if (c.minOrderValue > 0) { %>
                  ₹<%= c.minOrderValue %>
                <% } else { %>
                  <span class="text-on-surface-variant">—</span>
                <% } %>
              </td>

              <!-- Expiry -->
              <td class="px-6 py-4 text-sm">
                <span class="<%= isExpired ? 'text-error' : 'text-on-surface-variant' %>">
                  <%= new Date(c.expiryDate).toDateString() %>
                </span>
              </td>

              <!-- Usage -->
              <td class="px-6 py-4">
                <% if (c.baseLimit) { %>
                <div class="w-full max-w-[100px]">
                  <div class="flex justify-between text-[10px] text-on-surface-variant mb-1">
                    <span><%= usedCount %>/<%= c.baseLimit %></span>
                    <span><%= usagePercent %>%</span>
                  </div>
                  <div class="w-full h-1.5 bg-surface-container rounded-full overflow-hidden">
                    <div class="h-full rounded-full
                      <%= usagePercent >= 100 ? 'bg-error' : usagePercent >= 80 ? 'bg-tertiary' : 'bg-primary-container' %>"
                      style="width: <%= Math.min(usagePercent, 100) %>%">
                    </div>
                  </div>
                </div>
                <% } else { %>
                <span class="text-on-surface-variant text-xs">Unlimited</span>
                <% } %>
              </td>

              <!-- Status -->
              <td class="px-6 py-4 text-center">
                <% if (isExpired) { %>
                  <span class="px-2 py-1 rounded bg-error-container text-on-error-container text-xs font-bold uppercase">Expired</span>
                <% } else if (c.isActive) { %>
                  <span class="px-2 py-1 rounded bg-primary-container/20 text-primary-fixed-dim text-xs font-bold uppercase">Active</span>
                <% } else { %>
                  <span class="px-2 py-1 rounded bg-surface-container text-on-surface-variant text-xs font-bold uppercase">Inactive</span>
                <% } %>
              </td>

              <!-- Actions -->
              <td class="px-6 py-4 text-right space-x-1">
                <!-- Edit -->
                <a href="/admin/coupon-edit/<%= c._id %>">
                  <button class="p-1 text-on-surface-variant hover:text-primary transition-colors" title="Edit">
                    <span class="material-symbols-outlined text-[20px]">edit</span>
                  </button>
                </a>
                <!-- Toggle Status -->
                <button
                  onclick="toggleStatus('<%= c._id %>', <%= c.isActive %>)"
                  class="p-1 text-on-surface-variant hover:text-tertiary transition-colors"
                  title="<%= c.isActive ? 'Deactivate' : 'Activate' %>"
                >
                  <span class="material-symbols-outlined text-[20px]">
                    <%= c.isActive ? 'toggle_on' : 'toggle_off' %>
                  </span>
                </button>
                <!-- Delete -->
                <button
                  onclick="deleteCoupon('<%= c._id %>')"
                  class="p-1 text-on-surface-variant hover:text-error transition-colors"
                  title="Delete"
                >
                  <span class="material-symbols-outlined text-[20px]">delete</span>
                </button>
              </td>

            </tr>
            <% }) %>

          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div class="p-6 border-t border-outline-variant flex items-center justify-between">

        <% if (pagination.currentPage > 1) { %>
        <a href="?page=<%= pagination.currentPage - 1 %>&search=<%= search %>&status=<%= status %>">
          <button class="px-4 py-2 border border-outline-variant rounded-lg text-on-surface text-sm hover:bg-surface-container">
            Previous
          </button>
        </a>
        <% } else { %>
        <button class="px-4 py-2 border border-outline-variant rounded-lg text-on-surface-variant text-sm opacity-40 cursor-not-allowed">
          Previous
        </button>
        <% } %>

        <div class="flex gap-2">
          <% for (let p = 1; p <= pagination.totalPages; p++) { %>
            <% if (
              p === 1 ||
              p === pagination.totalPages ||
              Math.abs(p - pagination.currentPage) <= 1
            ) { %>
              <a href="?page=<%= p %>&search=<%= search %>&status=<%= status %>">
                <button class="w-8 h-8 rounded text-sm
                  <%= p === pagination.currentPage
                    ? 'bg-primary-container text-on-primary-container font-bold'
                    : 'hover:bg-surface-container text-on-surface-variant' %>">
                  <%= p %>
                </button>
              </a>
            <% } else if (Math.abs(p - pagination.currentPage) === 2) { %>
              <span class="px-1 text-on-surface-variant self-center">...</span>
            <% } %>
          <% } %>
        </div>

        <% if (pagination.currentPage < pagination.totalPages) { %>
        <a href="?page=<%= pagination.currentPage + 1 %>&search=<%= search %>&status=<%= status %>">
          <button class="px-4 py-2 border border-outline-variant rounded-lg text-on-surface text-sm hover:bg-surface-container">
            Next
          </button>
        </a>
        <% } else { %>
        <button class="px-4 py-2 border border-outline-variant rounded-lg text-on-surface-variant text-sm opacity-40 cursor-not-allowed">
          Next
        </button>
        <% } %>

      </div>
    </div>

  </div>
</main>

<script>
  // Show/hide clear button based on input value
  function toggleClearBtn(value) {
    const btn = document.getElementById("clearBtn");
    if (value.length > 0) btn.classList.add("visible");
    else btn.classList.remove("visible");
  }

  // Clear search and redirect
  function clearSearch() {
    const input = document.getElementById("searchInput");
    input.value = "";
    toggleClearBtn("");
    const params = new URLSearchParams(window.location.search);
    params.delete("search");
    params.set("page", 1);
    window.location.search = params.toString();
  }

  // Show clear button on load if search has a value
  window.addEventListener("DOMContentLoaded", () => {
    const input = document.getElementById("searchInput");
    toggleClearBtn(input.value);
  });

  // Search with debounce
  let timer;
  function handleSearch(value) {
    clearTimeout(timer);
    timer = setTimeout(() => {
      const params = new URLSearchParams(window.location.search);
      params.set("search", value);
      params.set("page", 1);
      window.location.search = params.toString();
    }, 400);
  }

  // Status filter
  function handleStatus(value) {
    const params = new URLSearchParams(window.location.search);
    if (value) params.set("status", value);
    else params.delete("status");
    params.set("page", 1);
    window.location.search = params.toString();
  }

  // Toggle active/inactive
  async function toggleStatus(id, isActive) {
    const result = await Swal.fire({
      title: isActive ? "Deactivate Coupon?" : "Activate Coupon?",
      text:  isActive ? "This coupon will no longer be usable." : "This coupon will become usable.",
      icon: "question",
      showCancelButton: true,
      confirmButtonText: "Yes",
      background: "#171f33",
      color: "#dae2fd",
      confirmButtonColor: "#38bdf8",
    });
    if (!result.isConfirmed) return;

    const res  = await fetch(`/admin/coupons/${id}/toggle`, { method: "PATCH" });
    const data = await res.json();

    if (data.success) {
      Swal.fire({
        title: "Done!",
        icon: "success",
        timer: 1200,
        showConfirmButton: false,
        background: "#171f33",
        color: "#dae2fd",
      }).then(() => location.reload());
    }
  }

  // Delete
  async function deleteCoupon(id) {
    const result = await Swal.fire({
      title: "Delete Coupon?",
      text: "This action cannot be undone.",
      icon: "warning",
      showCancelButton: true,
      confirmButtonText: "Delete",
      background: "#171f33",
      color: "#dae2fd",
      confirmButtonColor: "#93000a",
    });
    if (!result.isConfirmed) return;

    const res  = await fetch(`/admin/coupons/${id}`, { method: "DELETE" });
    const data = await res.json();

    if (data.success) {
      Swal.fire({
        title: "Deleted!",
        icon: "success",
        timer: 1200,
        showConfirmButton: false,
        background: "#171f33",
        color: "#dae2fd",
      }).then(() => location.reload());
    }
  }
</script>
</body>
</html>
