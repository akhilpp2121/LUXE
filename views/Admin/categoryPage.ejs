<!DOCTYPE html>
<html class="dark" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Luxe Admin | Categories</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    
    <!-- New Premium Fonts: Plus Jakarta Sans (Body) & Outfit (Headings) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "error": "#ff716c",
                        "inverse-primary": "#0053dc",
                        "on-secondary-container": "#caccff",
                        "on-primary": "#002873",
                        "outline-variant": "#40485d",
                        "primary-fixed-dim": "#658eff",
                        "on-secondary": "#000478",
                        "primary-dim": "#316bf3",
                        "surface-container-lowest": "#000000",
                        "surface-container-low": "#091328",
                        "surface-container": "#0f1930",
                        "background": "#060e20",
                        "outline": "#6d758c",
                        "tertiary-dim": "#ef8fe5",
                        "on-surface-variant": "#a3aac4",
                        "surface": "#060e20",
                        "primary-container": "#7b9cff",
                        "surface-container-high": "#141f38",
                        "surface-variant": "#192540",
                        "surface-bright": "#1f2b49",
                        "tertiary": "#ffb4f4",
                        "primary": "#90abff",
                        "secondary": "#8b94ff",
                        "on-surface": "#dee5ff",
                    },
                    "fontFamily": {
                        "headline": ["Outfit", "sans-serif"],
                        "body": ["Plus Jakarta Sans", "sans-serif"],
                    }
                },
            },
        }
    </script>
    <style>
        body {
            background-color: #060e20;
            color: #dee5ff;
            font-family: 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
        }
        .sidebar-scroll::-webkit-scrollbar {
            width: 4px;
        }
        .sidebar-scroll::-webkit-scrollbar-track {
            background: transparent;
        }
        .sidebar-scroll::-webkit-scrollbar-thumb {
            background: #1f2b49;
            border-radius: 10px;
        }
        .primary-gradient {
            background: linear-gradient(135deg, #316bf3 0%, #90abff 100%);
        }
        .glass-panel {
            background: rgba(6, 14, 32, 0.6);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }
    </style>
</head>
<body class="bg-background text-on-background relative">

    <!-- Ambient Background Glows for attractiveness -->
    <div class="fixed top-[-20%] left-[-10%] w-[50%] h-[50%] rounded-full bg-primary/10 blur-[120px] pointer-events-none z-0"></div>
    <div class="fixed bottom-[-20%] right-[-10%] w-[50%] h-[50%] rounded-full bg-tertiary/10 blur-[120px] pointer-events-none z-0"></div>

    <!-- SideNavBar Shell -->
    <aside class="h-screen w-64 fixed left-0 top-0 overflow-y-auto bg-[#091328]/90 backdrop-blur-xl border-r border-white/5 sidebar-scroll flex flex-col gap-2 py-8 z-50">
        <div class="px-8 mb-10">
            <h1 class="font-['Outfit'] text-3xl font-black text-white tracking-tight drop-shadow-md">Luxe Admin</h1>
            <p class="text-primary-dim text-[10px] uppercase tracking-[0.2em] font-bold mt-1">Executive Portal</p>
        </div>
        <nav class="flex flex-col gap-2 px-4">
            <a class="text-[#a3aac4] hover:text-white px-4 py-3 rounded-xl transition-all font-['Plus_Jakarta_Sans'] text-sm font-semibold flex items-center gap-4 hover:bg-surface-bright/50" href="#">
                <span class="material-symbols-outlined text-lg opacity-70">dashboard</span>
                <span>Dashboard</span>
            </a>
            <a class="text-[#a3aac4] hover:text-white px-4 py-3 rounded-xl transition-all font-['Plus_Jakarta_Sans'] text-sm font-semibold flex items-center gap-4 hover:bg-surface-bright/50" href="#">
                <span class="material-symbols-outlined text-lg opacity-70">shopping_cart</span>
                <span>Orders</span>
            </a>
            <a class="text-[#a3aac4] hover:text-white px-4 py-3 rounded-xl transition-all font-['Plus_Jakarta_Sans'] text-sm font-semibold flex items-center gap-4 hover:bg-surface-bright/50" href="#">
                <span class="material-symbols-outlined text-lg opacity-70">inventory_2</span>
                <span>Products</span>
            </a>
            
            <!-- Active State: Categories -->
            <a class="text-white bg-primary-dim/10 border border-primary-dim/20 shadow-[0_0_15px_rgba(49,107,243,0.1)] px-4 py-3 rounded-xl transition-all font-['Plus_Jakarta_Sans'] text-sm font-bold flex items-center gap-4" href="#">
                <span class="material-symbols-outlined text-lg text-primary">category</span>
                <span>Categories</span>
            </a>

            <a class="text-[#a3aac4] hover:text-white px-4 py-3 rounded-xl transition-all font-['Plus_Jakarta_Sans'] text-sm font-semibold flex items-center gap-4 hover:bg-surface-bright/50" href="#">
                <span class="material-symbols-outlined text-lg opacity-70">group</span>
                <span>Users</span>
            </a>
            <a class="text-[#a3aac4] hover:text-white px-4 py-3 rounded-xl transition-all font-['Plus_Jakarta_Sans'] text-sm font-semibold flex items-center gap-4 hover:bg-surface-bright/50" href="#">
                <span class="material-symbols-outlined text-lg opacity-70">analytics</span>
                <span>Analytics</span>
            </a>
            <a class="text-[#a3aac4] hover:text-white px-4 py-3 rounded-xl transition-all font-['Plus_Jakarta_Sans'] text-sm font-semibold flex items-center gap-4 hover:bg-surface-bright/50" href="#">
                <span class="material-symbols-outlined text-lg opacity-70">image</span>
                <span>Banners</span>
            </a>
        </nav>
        
        <div class="mt-auto px-6">
            <div class="p-3 bg-surface-container-high/50 border border-white/5 rounded-2xl flex items-center gap-3 hover:bg-surface-container-high transition-colors cursor-pointer">
                <div class="w-10 h-10 rounded-full overflow-hidden bg-primary-dim ring-2 ring-primary/20">
                    <img alt="Executive Profile" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuA5sG-4-9mVDGCmpCFYeMKRkrtoXTifu_PVBvx8_Ymy0fwuTahffRpSpdw_S2yRgQHgsI_6RdzSRG5ZI2lTb7pITxv-YVrMmvAb2HH97iZYCEmpyfZy68O3jl8O8MU4x7nnUnTVrtUHMzhVpZW2wjQb5uZeb4XVIwvheUld6szMXPZ6l-3Ru0o9QANxpUOkA5qXYhoDhlXkWIcwyBZn6hmF56DH7bO62G5kh5FkTKDG0x6QByItmUhMW0cJUHLxit2tRdm9arJElsxE" />
                </div>
                <div class="overflow-hidden">
                    <p class="text-sm font-bold text-white truncate font-['Outfit']">Alexander Pierce</p>
                    <p class="text-[10px] text-primary tracking-wider uppercase">Administrator</p>
                </div>
            </div>
        </div>
    </aside>

    <!-- Main Content Canvas -->
    <main class="ml-64 min-h-screen pb-20 relative z-10">
        <!-- TopNavBar Shell -->
        <header class="fixed top-0 right-0 w-[calc(100%-16rem)] z-40 glass-panel flex justify-between items-center px-10 py-5">
            <div class="flex items-center gap-6 flex-1">
                <h2 class="font-['Outfit'] text-2xl font-bold text-white tracking-wide">Categories</h2>
                <div class="relative w-full max-w-md group">
                    <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant text-xl transition-colors group-focus-within:text-primary">search</span>
                    <input class="w-full bg-surface-container-low/50 border border-white/5 focus:bg-surface-container focus:border-primary/50 focus:ring-4 focus:ring-primary/10 text-sm py-2.5 pl-12 pr-10 text-white placeholder-on-surface-variant rounded-xl transition-all outline-none" placeholder="Search categories..." type="text" />
                </div>
            </div>
            <div class="flex items-center gap-6 ml-8">
                <div class="flex items-center gap-3 border-r border-white/10 pr-6">
                    <button class="w-10 h-10 flex items-center justify-center rounded-full bg-surface-container-low border border-white/5 text-on-surface-variant hover:text-white hover:bg-surface-bright transition-all relative">
                        <span class="material-symbols-outlined text-[20px]">notifications</span>
                        <span class="absolute top-2 right-2 w-2 h-2 bg-error rounded-full animate-pulse"></span>
                    </button>
                    <button class="w-10 h-10 flex items-center justify-center rounded-full bg-surface-container-low border border-white/5 text-on-surface-variant hover:text-white hover:bg-surface-bright transition-all">
                        <span class="material-symbols-outlined text-[20px]">settings</span>
                    </button>
                </div>
                
                <div class="flex items-center gap-3">
                    <!-- NEW: Clear Filters Button -->
                    <button class="bg-surface-container-low hover:bg-surface-bright border border-white/10 text-on-surface hover:text-white px-5 py-2.5 rounded-xl font-semibold flex items-center gap-2 transition-all hover:shadow-lg">
                        <span class="material-symbols-outlined text-[18px]">filter_alt_off</span>
                        <span class="text-sm">Clear</span>
                    </button>
                    
                    <button class="primary-gradient text-white px-6 py-2.5 rounded-xl font-bold flex items-center gap-2 hover:scale-[1.02] active:scale-[0.98] transition-all shadow-lg shadow-primary-dim/30">
                        <span class="material-symbols-outlined text-[20px]">add_circle</span>
                        <span class="text-sm tracking-wide">Add Category</span>
                    </button>
                </div>
            </div>
        </header>

        <!-- Content Body -->
        <section class="mt-28 px-10">
            <!-- Table Container -->
            <div class="bg-surface-container-high/80 backdrop-blur-md rounded-2xl border border-white/5 overflow-hidden shadow-2xl">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-surface-container-low/50 border-b border-white/5">
                                <th class="px-8 py-5 text-on-surface-variant font-semibold text-[11px] uppercase tracking-[0.15em]">Category Name</th>
                                <th class="px-8 py-5 text-on-surface-variant font-semibold text-[11px] uppercase tracking-[0.15em]">Description</th>
                                <th class="px-8 py-5 text-on-surface-variant font-semibold text-[11px] uppercase tracking-[0.15em] text-center">Status</th>
                                <th class="px-8 py-5 text-on-surface-variant font-semibold text-[11px] uppercase tracking-[0.15em] text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5">
                            <!-- Row: T-Shirts -->
                            <tr class="hover:bg-surface-bright/40 transition-colors group">
                                <td class="px-8 py-5">
                                    <div class="flex items-center gap-4">
                                        <div class="w-14 h-14 rounded-xl bg-surface-container overflow-hidden flex-shrink-0 border border-white/5">
                                            <img alt="T-Shirts" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAxoIhfYeJaNp38n58rfinRiDTDioiC2qBz1K3ZM2ZAvixhYIQmwtVm899MKHKI7w_UGidopgnA8pKqpuaKgMJNlN-XXM1JGaGHkF0IJ3HuU93gm-jHBFHXYrqkwDUS1JqQER5CPM7HIY7gYUtZPOdPoKKL87Ja1OEYHgyT6EcZaOg2UpyYVL1-K5QKrlWHvHH7Rdm78XC8-aIs0BfhFfgJf4BffaYdQtCvMac6DhXZLSxX7px4Kj9bG2Z4DlnaDWD07GPbr5Fd5cN6" />
                                        </div>
                                        <span class="font-bold text-white font-['Outfit'] text-base tracking-wide">T-Shirts</span>
                                    </div>
                                </td>
                                <td class="px-8 py-5 text-on-surface-variant text-sm max-w-md leading-relaxed">
                                    Premium heavyweight cotton essentials with a tailored fit for the modern executive wardrobe.
                                </td>
                                <td class="px-8 py-5 text-center">
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md text-[10px] font-bold uppercase tracking-widest bg-primary/10 text-primary border border-primary/20">
                                        <span class="w-1.5 h-1.5 rounded-full bg-primary"></span> Active
                                    </span>
                                </td>
                                <td class="px-8 py-5 text-right">
                                    <div class="flex items-center justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                        <button class="p-2.5 rounded-xl bg-surface-container-low border border-white/5 hover:bg-surface-bright text-on-surface-variant hover:text-primary transition-all">
                                            <span class="material-symbols-outlined text-[18px]">edit</span>
                                        </button>
                                        <button class="p-2.5 rounded-xl bg-surface-container-low border border-white/5 hover:bg-error/20 text-on-surface-variant hover:text-error transition-all">
                                            <span class="material-symbols-outlined text-[18px]">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            <!-- Row: Pants -->
                            <tr class="hover:bg-surface-bright/40 transition-colors group">
                                <td class="px-8 py-5">
                                    <div class="flex items-center gap-4">
                                        <div class="w-14 h-14 rounded-xl bg-surface-container overflow-hidden flex-shrink-0 border border-white/5">
                                            <img alt="Pants" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDGIG4JhL-yf5SwChGBqF_OY0x7wUvQzo4aaW6am-UmPAs4MW9l_jfxGmJyfsxlMUk0JIylKZWkfC34wcPlYWrzxqlkjIa05r3M8T75h6vaAtO3bgYeWwqLFWPH3lbNEald5ab3MlkPhBqohKiF4R3EbdJ3FJAgNUZmHXZGxJtC3XSkPPbYgN5BF6rzWyxRQq_Wby3lEsJJuiejSmbcxNY36wLibycMycNuXC0QDnhjD7nCe9Nfh94BTTUWdT7GiLaociAasfzXCTIr" />
                                        </div>
                                        <span class="font-bold text-white font-['Outfit'] text-base tracking-wide">Pants</span>
                                    </div>
                                </td>
                                <td class="px-8 py-5 text-on-surface-variant text-sm max-w-md leading-relaxed">
                                    Precision-cut trousers and chinos featuring technical stretch fabrics for ultimate boardroom comfort.
                                </td>
                                <td class="px-8 py-5 text-center">
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md text-[10px] font-bold uppercase tracking-widest bg-primary/10 text-primary border border-primary/20">
                                        <span class="w-1.5 h-1.5 rounded-full bg-primary"></span> Active
                                    </span>
                                </td>
                                <td class="px-8 py-5 text-right">
                                    <div class="flex items-center justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                        <button class="p-2.5 rounded-xl bg-surface-container-low border border-white/5 hover:bg-surface-bright text-on-surface-variant hover:text-primary transition-all">
                                            <span class="material-symbols-outlined text-[18px]">edit</span>
                                        </button>
                                        <button class="p-2.5 rounded-xl bg-surface-container-low border border-white/5 hover:bg-error/20 text-on-surface-variant hover:text-error transition-all">
                                            <span class="material-symbols-outlined text-[18px]">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            <!-- Row: Kurtas -->
                            <tr class="hover:bg-surface-bright/40 transition-colors group">
                                <td class="px-8 py-5">
                                    <div class="flex items-center gap-4">
                                        <div class="w-14 h-14 rounded-xl bg-surface-container overflow-hidden flex-shrink-0 border border-white/5 opacity-70">
                                            <img alt="Kurtas" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 grayscale" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBgdbfHVVcAoRPVseKM6u35uJy7ms-0VP-hesM1EWa_7fAZ1b88VtcItj9487C68ciEUY6ukVM3557Tbb98896mql1oQPwEx4OoqGoHWVzoE3G3Sk-CwokgXt13oF1vlmVQFsKmLgVOjKID1YYC7sh4Z_WljAOSWJJvzJeunbWX-dR7SXHZxSBsokIY-EUoPCsXbLMMc8TwK9QUkClJs3WpO1rjkzoF6Z-KMGM7q2AFuOnXTyt23dzJy1t0eNT1O7aP7YhndZeGfTjg" />
                                        </div>
                                        <span class="font-bold text-on-surface-variant font-['Outfit'] text-base tracking-wide">Kurtas</span>
                                    </div>
                                </td>
                                <td class="px-8 py-5 text-on-surface-variant/70 text-sm max-w-md leading-relaxed">
                                    Heritage silhouettes reimagined with contemporary linen blends and minimalist embroidery.
                                </td>
                                <td class="px-8 py-5 text-center">
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md text-[10px] font-bold uppercase tracking-widest bg-outline-variant/20 text-on-surface-variant border border-outline-variant/30">
                                        <span class="w-1.5 h-1.5 rounded-full bg-on-surface-variant"></span> Inactive
                                    </span>
                                </td>
                                <td class="px-8 py-5 text-right">
                                    <div class="flex items-center justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                        <button class="p-2.5 rounded-xl bg-surface-container-low border border-white/5 hover:bg-surface-bright text-on-surface-variant hover:text-primary transition-all">
                                            <span class="material-symbols-outlined text-[18px]">edit</span>
                                        </button>
                                        <button class="p-2.5 rounded-xl bg-surface-container-low border border-white/5 hover:bg-error/20 text-on-surface-variant hover:text-error transition-all">
                                            <span class="material-symbols-outlined text-[18px]">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                
                <!-- Pagination -->
                <div class="px-8 py-5 bg-surface-container-low/30 border-t border-white/5 flex items-center justify-between">
                    <p class="text-on-surface-variant text-xs font-semibold tracking-wide">
                        Showing <span class="text-white font-bold">1 - 3</span> of <span class="text-white font-bold">24</span> categories
                    </p>
                    <div class="flex items-center gap-1.5">
                        <button class="w-9 h-9 flex items-center justify-center rounded-lg border border-white/5 bg-surface-container text-on-surface-variant hover:text-white transition-all disabled:opacity-30" disabled>
                            <span class="material-symbols-outlined text-sm">chevron_left</span>
                        </button>
                        <div class="flex items-center gap-1">
                            <button class="w-9 h-9 flex items-center justify-center rounded-lg bg-primary-dim text-white font-bold text-xs shadow-lg shadow-primary-dim/20">1</button>
                            <button class="w-9 h-9 flex items-center justify-center rounded-lg border border-transparent hover:border-white/10 hover:bg-surface-container text-on-surface-variant hover:text-white font-bold text-xs transition-all">2</button>
                            <button class="w-9 h-9 flex items-center justify-center rounded-lg border border-transparent hover:border-white/10 hover:bg-surface-container text-on-surface-variant hover:text-white font-bold text-xs transition-all">3</button>
                        </div>
                        <button class="w-9 h-9 flex items-center justify-center rounded-lg border border-white/5 bg-surface-container hover:bg-surface-bright text-on-surface-variant hover:text-white transition-all">
                            <span class="material-symbols-outlined text-sm">chevron_right</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Bento Stats Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
                <div class="bg-surface-container-high/60 backdrop-blur-sm border border-white/5 p-8 rounded-2xl relative overflow-hidden group hover:bg-surface-container-high transition-colors">
                    <div class="absolute -right-4 -bottom-4 opacity-5 group-hover:opacity-10 transition-opacity">
                        <span class="material-symbols-outlined text-[120px]" style="font-variation-settings: 'FILL' 1;">category</span>
                    </div>
                    <p class="text-[11px] uppercase tracking-[0.2em] text-on-surface-variant font-bold mb-3">Total Categories</p>
                    <p class="text-5xl font-black text-white font-['Outfit']">24</p>
                    <div class="mt-5 flex items-center gap-2 text-xs text-primary font-bold bg-primary/10 w-max px-3 py-1.5 rounded-lg border border-primary/20">
                        <span class="material-symbols-outlined text-[14px]">trending_up</span>
                        <span>+2 This Month</span>
                    </div>
                </div>
                
                <div class="bg-surface-container-high/60 backdrop-blur-sm border border-white/5 p-8 rounded-2xl relative overflow-hidden group hover:bg-surface-container-high transition-colors">
                    <div class="absolute -right-4 -bottom-4 opacity-5 group-hover:opacity-10 transition-opacity">
                        <span class="material-symbols-outlined text-[120px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                    </div>
                    <p class="text-[11px] uppercase tracking-[0.2em] text-on-surface-variant font-bold mb-3">Active Status</p>
                    <p class="text-5xl font-black text-white font-['Outfit']">18</p>
                    <div class="mt-5 flex items-center gap-3 text-xs text-on-surface-variant font-semibold">
                        <div class="flex-1 h-1.5 bg-surface-container-lowest rounded-full overflow-hidden">
                            <div class="w-[75%] h-full bg-gradient-to-r from-primary-dim to-primary rounded-full"></div>
                        </div>
                        <span>75%</span>
                    </div>
                </div>
                
                <div class="bg-surface-container-high/60 backdrop-blur-sm border border-white/5 p-8 rounded-2xl relative overflow-hidden group hover:bg-surface-container-high transition-colors">
                    <div class="absolute -right-4 -bottom-4 opacity-5 group-hover:opacity-10 transition-opacity">
                        <span class="material-symbols-outlined text-[120px]" style="font-variation-settings: 'FILL' 1;">visibility</span>
                    </div>
                    <p class="text-[11px] uppercase tracking-[0.2em] text-on-surface-variant font-bold mb-3">Avg. Views/Cat</p>
                    <p class="text-5xl font-black text-white font-['Outfit']">1.2k</p>
                    <div class="mt-5 flex items-center gap-2 text-xs text-tertiary font-bold bg-tertiary/10 w-max px-3 py-1.5 rounded-lg border border-tertiary/20">
                        <span class="material-symbols-outlined text-[14px]">bolt</span>
                        <span>High Engagement</span>
                    </div>
                </div>
            </div>
        </section>
    </main>
</body>
</html>