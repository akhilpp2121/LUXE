<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>LUXE UPDATE YOUR FASHION | Profile</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Syne:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg:        #080c14;
    --surface:   #0e1523;
    --surface-2: #141c2e;
    --surface-3: #1a2338;
    --surface-4: #212c42;
    --border:    rgba(255,255,255,0.07);
    --border-2:  rgba(255,255,255,0.12);
    --primary:   #3a6ff7;
    --primary-glow: rgba(58,111,247,0.25);
    --gold:      #c9a96e;
    --gold-light:#e0c08a;
    --text:      #e8edf8;
    --text-2:    #8892a4;
    --text-3:    #5a6478;
    --nav-h:     72px;
    --side-w:    260px;
    --radius:    12px;
    --radius-lg: 18px;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* ── SCROLLBAR ── */
  ::-webkit-scrollbar { width: 5px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--surface-4); border-radius: 99px; }

  /* ── TOPNAV ── */
  nav.topnav {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: var(--nav-h);
    background: rgba(8,12,20,0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 40px;
    z-index: 100;
  }

  .brand {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text);
  }
  .brand span { color: var(--gold); }

  .nav-links {
    display: flex;
    gap: 36px;
    list-style: none;
  }
  .nav-links a {
    font-family: 'Syne', sans-serif;
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-2);
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--text); }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .nav-icon-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-2);
    display: flex;
    align-items: center;
    transition: color 0.2s;
  }
  .nav-icon-btn:hover { color: var(--text); }
  .nav-icon-btn.active { color: var(--primary); }
  .nav-icon-btn .material-symbols-outlined { font-size: 22px; }

  /* ── SIDEBAR ── */
  aside.sidebar {
    position: fixed;
    top: var(--nav-h);
    left: 0;
    width: var(--side-w);
    height: calc(100vh - var(--nav-h));
    background: var(--surface);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    padding: 32px 0 24px;
    z-index: 50;
    overflow-y: auto;
  }

  .sidebar-header {
    padding: 0 28px 28px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 16px;
  }
  .sidebar-header h3 {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text);
    margin-bottom: 6px;
  }
  .sidebar-tier {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(201,169,110,0.1);
    border: 1px solid rgba(201,169,110,0.25);
    border-radius: 99px;
    padding: 3px 10px;
  }
  .sidebar-tier span {
    font-family: 'Syne', sans-serif;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .tier-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--gold);
    flex-shrink: 0;
  }

  .sidebar-nav { display: flex; flex-direction: column; gap: 2px; padding: 0 12px; }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 16px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--text-2);
    font-size: 0.6875rem;
    font-family: 'Syne', sans-serif;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: all 0.2s;
  }
  .sidebar-link .material-symbols-outlined { font-size: 18px; flex-shrink: 0; }
  .sidebar-link:hover { background: var(--surface-3); color: var(--text); }
  .sidebar-link.active { background: rgba(58,111,247,0.12); color: var(--primary); }

  .sidebar-footer {
    margin-top: auto;
    padding: 20px 28px 0;
    border-top: 1px solid var(--border);
  }
  .sidebar-footer a {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text-3);
    font-size: 0.6875rem;
    font-family: 'Syne', sans-serif;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.2s;
  }
  .sidebar-footer a:hover { color: var(--text-2); }
  .sidebar-footer .material-symbols-outlined { font-size: 18px; }

  /* ── MAIN ── */
  main {
    margin-left: var(--side-w);
    padding: calc(var(--nav-h) + 48px) 52px 80px;
    min-height: 100vh;
  }

  .page-header { margin-bottom: 48px; }
  .page-header h1 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    font-size: 3.5rem;
    color: var(--text);
    letter-spacing: -0.01em;
    line-height: 1.05;
    margin-bottom: 8px;
  }
  .page-header h1 em { font-style: italic; color: var(--gold-light); }
  .page-header p {
    color: var(--text-3);
    font-size: 0.85rem;
    font-weight: 300;
    letter-spacing: 0.02em;
  }

  .profile-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: start;
  }

  /* ── PROFILE CARD ── */
  .profile-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 36px;
  }

  .profile-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 36px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--border);
  }

  .avatar-wrap {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .avatar {
    position: relative;
    width: 72px; height: 72px;
    flex-shrink: 0;
  }
  .avatar img {
    width: 100%; height: 100%;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }
  .avatar-ring {
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: conic-gradient(var(--gold) 0deg 220deg, transparent 220deg 360deg);
    z-index: -1;
  }
  .avatar-badge {
    position: absolute;
    bottom: 1px; right: 1px;
    width: 16px; height: 16px;
    background: #22c55e;
    border: 2px solid var(--surface);
    border-radius: 50%;
  }

  .profile-name h2 {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--text);
    margin-bottom: 4px;
  }
  .profile-name p {
    color: var(--text-3);
    font-size: 0.8rem;
    font-weight: 300;
  }

  .edit-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--primary);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-family: 'Syne', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s;
    flex-shrink: 0;
  }
  .edit-btn:hover { background: #5580f9; box-shadow: 0 0 20px rgba(58,111,247,0.3); }
  .edit-btn .material-symbols-outlined { font-size: 15px; }

  /* ── FORM FIELDS ── */
  .fields-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .field { display: flex; flex-direction: column; gap: 8px; }
  .field label {
    font-family: 'Syne', sans-serif;
    font-size: 0.575rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .field-input {
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 8px 10px; /* reduced padding */
  display: flex;
  align-items: center;
  gap: 8px;
}

  .field-input:focus-within {
    border-color: rgba(58,111,247,0.4);
    background: var(--surface-3);
  }
  .field-input input {
    background: none;
    border: none;
    outline: none;
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    width: 100%;
    flex: 1;
  }
  .field-icon {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-3);
    display: flex;
    align-items: center;
    transition: color 0.2s;
    padding: 0;
  }
  .field-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 6px 10px;
  font-size: 0.6rem;
  border-radius: 6px;
  background: rgba(58,111,247,0.12);
  color: var(--primary);
  border: 1px solid rgba(58,111,247,0.25);
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.2s;
}

.field-btn:hover {
  background: rgba(58,111,247,0.2);
}

  .field-icon:hover { color: var(--text-2); }
  .field-icon .material-symbols-outlined { font-size: 18px; }

  /* ── SIDE PANEL ── */
  .side-panel { display: flex; flex-direction: column; gap: 20px; }

  /* Membership Card */
  .membership-card {
    border-radius: var(--radius-lg);
    padding: 32px;
    position: relative;
    overflow: hidden;
    min-height: 280px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--surface-2);
    border: 1px solid var(--border);
  }
  .membership-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 90% 10%, rgba(58,111,247,0.35) 0%, transparent 60%),
      radial-gradient(ellipse 60% 80% at 10% 100%, rgba(201,169,110,0.15) 0%, transparent 60%);
    pointer-events: none;
  }
  .membership-card::after {
    content: '';
    position: absolute;
    top: -40px; right: -40px;
    width: 200px; height: 200px;
    border-radius: 50%;
    background: rgba(58,111,247,0.08);
    border: 1px solid rgba(58,111,247,0.15);
    pointer-events: none;
  }

  .mc-top { position: relative; z-index: 1; }
  .mc-tier {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 99px;
    padding: 4px 12px;
    margin-bottom: 16px;
  }
  .mc-tier span {
    font-family: 'Syne', sans-serif;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold-light);
  }
  .mc-tier-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--gold);
  }
  .mc-title {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    font-size: 1.9rem;
    color: var(--text);
    line-height: 1.15;
  }
  .mc-title em { font-style: italic; color: var(--gold-light); }

  .mc-bottom { position: relative; z-index: 1; }
  .mc-credits-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 10px;
  }
  .mc-credits-label {
    font-family: 'Syne', sans-serif;
    font-size: 0.575rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
  }
  .mc-credits-value {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--text);
    letter-spacing: -0.02em;
  }
  .mc-credits-value span {
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--text-2);
    margin-left: 4px;
  }
  .progress-track {
    height: 3px;
    background: rgba(255,255,255,0.08);
    border-radius: 99px;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    width: 74%;
    background: linear-gradient(90deg, var(--primary) 0%, var(--gold) 100%);
    border-radius: 99px;
  }
  .progress-labels {
    display: flex;
    justify-content: space-between;
    margin-top: 8px;
  }
  .progress-labels span {
    font-size: 0.6rem;
    color: var(--text-3);
  }

  /* Support Card */
  .support-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
  }
  .support-card h4 {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text);
    margin-bottom: 8px;
  }
  .support-card p {
    color: var(--text-3);
    font-size: 0.8rem;
    font-weight: 300;
    line-height: 1.6;
    margin-bottom: 20px;
  }
  .support-btn {
    width: 100%;
    background: none;
    border: 1px solid var(--border-2);
    border-radius: 8px;
    padding: 12px;
    color: var(--text);
    font-family: 'Syne', sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s;
  }
  .support-btn:hover { background: var(--surface-3); border-color: rgba(58,111,247,0.3); color: var(--primary); }

  /* ── COMMISSIONS SECTION ── */
  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 28px;
    padding-top: 56px;
  }
  .section-header h2 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    font-size: 2.25rem;
    color: var(--text);
    letter-spacing: -0.01em;
  }
  .section-header h2 em { font-style: italic; color: var(--gold-light); }
  .view-all {
    display: flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: var(--text-2);
    font-family: 'Syne', sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: color 0.2s;
  }
  .view-all:hover { color: var(--primary); }
  .view-all .material-symbols-outlined { font-size: 15px; }



/* ── MODAL BACKDROP ── */
.modal {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.65);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: all 0.3s ease;
}

/* ACTIVE STATE */
.modal.show {
  opacity: 1;
  pointer-events: all;
}

/* ── MODAL BOX ── */
.modal-box {
  width: 420px;
  max-width: 90%;
  background: linear-gradient(145deg, #0e1523, #141c2e);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 16px;
  padding: 30px 28px 26px;
  position: relative;
  box-shadow: 0 20px 60px rgba(0,0,0,0.6);
  transform: translateY(30px) scale(0.95);
  transition: all 0.35s cubic-bezier(0.4,0,0.2,1);
}

/* animate in */
.modal.show .modal-box {
  transform: translateY(0) scale(1);
}

/* CLOSE BUTTON */
.modal-close {
  position: absolute;
  top: 14px;
  right: 14px;
  background: none;
  border: none;
  color: var(--text-3);
  font-size: 18px;
  cursor: pointer;
}
.modal-close:hover {
  color: var(--text);
}

/* TITLE */
.modal-box h3 {
  font-family: 'Syne', sans-serif;
  font-size: 1rem;
  margin-bottom: 4px;
}

.modal-sub {
  font-size: 0.75rem;
  color: var(--text-3);
  margin-bottom: 18px;
}

/* INPUT */
.modal-box input {
  width: 100%;
  padding: 12px 14px;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: var(--surface-2);
  color: var(--text);
  font-size: 0.85rem;
  margin-bottom: 10px;
  transition: all 0.2s;
}

.modal-box input:focus {
  border-color: var(--primary);
  background: var(--surface-3);
}

/* ERROR TEXT */
.error-msg {
  color: #ef4444;
  font-size: 0.7rem;
  min-height: 16px;
  margin-bottom: 14px;
}

/* BUTTONS */
.modal-actions {
  display: flex;
  gap: 10px;
}

.btn-primary {
  flex: 1;
  padding: 10px;
  border-radius: 8px;
  border: none;
  background: var(--primary);
  color: #fff;
  font-family: 'Syne', sans-serif;
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  cursor: pointer;
  transition: 0.2s;
}

.btn-primary:hover {
  background: #5b84ff;
  box-shadow: 0 0 20px rgba(58,111,247,0.4);
}

.btn-ghost {
  flex: 1;
  padding: 10px;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: transparent;
  color: var(--text-2);
  font-size: 0.7rem;
  cursor: pointer;
}

.btn-ghost:hover {
  background: var(--surface-3);
  color: var(--text);
}


  /* ── ORDER CARDS ── */
  .orders-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }

  .order-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 22px;
    cursor: pointer;
    transition: all 0.28s cubic-bezier(0.4,0,0.2,1);
    position: relative;
    overflow: hidden;
  }
  .order-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 50% at 50% -10%, rgba(58,111,247,0.08), transparent);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .order-card:hover { border-color: rgba(58,111,247,0.25); transform: translateY(-3px); box-shadow: 0 12px 40px rgba(0,0,0,0.35); }
  .order-card:hover::before { opacity: 1; }

  .order-date {
    font-family: 'Syne', sans-serif;
    font-size: 0.575rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 16px;
    display: block;
  }

  .order-img {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    background: var(--surface-2);
    margin-bottom: 16px;
  }
  .order-img img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.4,0,0.2,1);
  }
  .order-card:hover .order-img img { transform: scale(1.07); }

  .order-name {
    font-family: 'Syne', sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--text);
    margin-bottom: 6px;
  }
  .order-price {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 400;
    font-size: 1.3rem;
    color: var(--gold-light);
    letter-spacing: -0.01em;
  }
  .order-status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 10px;
    padding: 3px 10px;
    border-radius: 99px;
    font-family: 'Syne', sans-serif;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .order-status.shipped { background: rgba(34,197,94,0.1); color: #4ade80; border: 1px solid rgba(34,197,94,0.2); }
  .order-status.processing { background: rgba(251,191,36,0.1); color: #fbbf24; border: 1px solid rgba(251,191,36,0.2); }
  .order-status .status-dot { width: 4px; height: 4px; border-radius: 50%; background: currentColor; }

  /* New Commission CTA */
  .commission-cta {
    background: none;
    border: 1px dashed rgba(255,255,255,0.12);
    border-radius: var(--radius-lg);
    padding: 22px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    cursor: pointer;
    transition: all 0.2s;
    min-height: 280px;
    text-align: center;
  }
  .commission-cta:hover { border-color: rgba(58,111,247,0.35); background: rgba(58,111,247,0.04); }
  .commission-cta .material-symbols-outlined { font-size: 36px; color: var(--text-3); }
  .commission-cta p {
    color: var(--text-3);
    font-size: 0.8rem;
    font-weight: 300;
    line-height: 1.5;
    max-width: 160px;
  }
  .commission-cta:hover .material-symbols-outlined { color: var(--primary); }
  .commission-cta:hover p { color: var(--text-2); }

  /* ── RESPONSIVE ── */
  @media (max-width: 1100px) {
    .profile-grid { grid-template-columns: 1fr; }
    .side-panel { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  }
  @media (max-width: 900px) {
    :root { --side-w: 0px; }
    aside.sidebar { display: none; }
    main { padding: calc(var(--nav-h) + 32px) 24px 60px; }
    .orders-grid { grid-template-columns: 1fr 1fr; }
    .fields-grid { grid-template-columns: 1fr; }
    nav.topnav { padding: 0 20px; }
    .nav-links { display: none; }
    .side-panel { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .orders-grid { grid-template-columns: 1fr; }
    .profile-top { flex-direction: column; align-items: flex-start; gap: 16px; }
    .page-header h1 { font-size: 2.5rem; }
  }

  /* ── ANIMATIONS ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .profile-card, .membership-card, .support-card { animation: fadeUp 0.5s ease both; }
  .membership-card { animation-delay: 0.08s; }
  .support-card { animation-delay: 0.16s; }
  .order-card:nth-child(1) { animation: fadeUp 0.4s 0.2s ease both; }
  .order-card:nth-child(2) { animation: fadeUp 0.4s 0.28s ease both; }
  .commission-cta { animation: fadeUp 0.4s 0.36s ease both; }
</style>
</head>
<body>

<form id="updateForm" method="POST" action="/profile/update">

  
  <input type="hidden" id="typeField" name="type">
  <input type="hidden" id="valueField" name="value">

</form>



   <div id="editModal" class="modal">
