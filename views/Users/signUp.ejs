<title>Luxe | Elevate Your Wardrobe</title>
<style>
  .field-error { border-color: #ef4444 !important; box-shadow: 0 0 0 3px rgba(239,68,68,.1) !important; }
  .field-ok    { border-color: #22c55e !important; }
  .err-msg     { display: none; font-size: 12px; color: #ef4444; margin-top: 4px; padding-left: 4px; }
  .err-msg.show{ display: block; }
  .banner      { display: none; align-items: center; gap: 10px; padding: 12px 16px; border-radius: 10px; font-size: 14px; font-weight: 500; margin-bottom: 1.25rem; }
  .banner.show { display: flex; }
  .banner.success { background: #dcfce7; color: #166534; border: 1px solid #86efac; }
  .banner.error   { background: #fef2f2; color: #991b1b; border: 1px solid #fca5a5; }
  .dark .banner.success { background: #14532d; color: #bbf7d0; border-color: #16a34a; }
  .dark .banner.error   { background: #450a0a; color: #fecaca; border-color: #dc2626; }

  .overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  color: #fff;
}

.hidden {
  display: none;
}

.loader {
  border: 4px solid #f3f3f3;
  border-top: 4px solid #4CAF50;
  border-radius: 50%;
  width: 40px;
  height: 40px;
  animation: spin 1s linear infinite;
  margin-bottom: 10px;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* ---- Animated Logo (Puzzle Assembly) ---- */
.logo-link {
    opacity: 0;
    animation: logoEntrance 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes logoEntrance {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
}

/* Puzzle container */
.diamond-puzzle {
    position: relative;
    display: inline-block;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
}

.diamond-puzzle .piece {
    position: absolute;
    inset: 0;
    font-size: 26px;
    line-height: 26px;
    color: #1152d4;
    font-variation-settings: 'FILL' 1, 'wght' 500, 'GRAD' 0, 'opsz' 24;
    filter: drop-shadow(0 0 6px rgba(17, 82, 212, 0.4));
}

/* Each piece = one quadrant of the glyph */
.piece-1 { clip-path: polygon(0 0, 50% 0, 50% 50%, 0 50%); }
.piece-2 { clip-path: polygon(50% 0, 100% 0, 100% 50%, 50% 50%); }
.piece-3 { clip-path: polygon(0 50%, 50% 50%, 50% 100%, 0 100%); }
.piece-4 { clip-path: polygon(50% 50%, 100% 50%, 100% 100%, 50% 100%); }

/* Ambient puzzle-assemble loop */
.piece-1 { animation: puzzle1 5s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
.piece-2 { animation: puzzle2 5s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
.piece-3 { animation: puzzle3 5s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
.piece-4 { animation: puzzle4 5s cubic-bezier(0.65, 0, 0.35, 1) infinite; }

@keyframes puzzle1 {
    0%, 100% { transform: translate(-8px, -8px) rotate(-25deg); opacity: 0.4; }
    35%, 65% { transform: translate(0, 0) rotate(0deg); opacity: 1; }
}
@keyframes puzzle2 {
    0%, 100% { transform: translate(8px, -8px) rotate(25deg); opacity: 0.4; }
    35%, 65% { transform: translate(0, 0) rotate(0deg); opacity: 1; }
}
@keyframes puzzle3 {
    0%, 100% { transform: translate(-8px, 8px) rotate(25deg); opacity: 0.4; }
    35%, 65% { transform: translate(0, 0) rotate(0deg); opacity: 1; }
}
@keyframes puzzle4 {
    0%, 100% { transform: translate(8px, 8px) rotate(-25deg); opacity: 0.4; }
    35%, 65% { transform: translate(0, 0) rotate(0deg); opacity: 1; }
}

/* Burst-apart then snap-together on hover */
.logo-link:hover .piece {
    animation: none !important;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.3s ease;
}
.logo-link:hover .piece-1 { transform: translate(-6px, -6px) rotate(-15deg); }
.logo-link:hover .piece-2 { transform: translate(6px, -6px) rotate(15deg); }
.logo-link:hover .piece-3 { transform: translate(-6px, 6px) rotate(15deg); }
.logo-link:hover .piece-4 { transform: translate(6px, 6px) rotate(-15deg); }

.logo-link:hover .diamond-puzzle:hover .piece,
.logo-link:active .piece {
    transform: translate(0, 0) rotate(0deg) !important;
    transition-delay: 0.25s !important;
}

/* Text shimmer */
.logo-text {
    background: linear-gradient(
        100deg,
        #f1f5f9 30%,
        #1152d4 45%,
        #6ea0ff 50%,
        #1152d4 55%,
        #f1f5f9 70%
    );
    background-size: 250% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmerSweep 4s ease-in-out infinite;
}

@keyframes shimmerSweep {
    0%   { background-position: 160% 0; }
    50%  { background-position: -60% 0; }
    100% { background-position: -60% 0; }
}

.logo-link:hover .logo-text {
    animation-duration: 1.2s;
}

</style>
