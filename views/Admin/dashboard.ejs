<!DOCTYPE html>
<html class="light" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>AdminPro - Sales Dashboard</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          "colors": {
            "secondary": "#565e74",
            "outline-variant": "#c3c6d7",
            "surface-container-low": "#f2f4f6",
            "surface-variant": "#e0e3e5",
            "primary": "#004ac6",
            "on-surface-variant": "#434655",
            "background": "#f7f9fb",
            "error": "#ba1a1a",
            "on-surface": "#191c1e",
            "surface-container": "#eceef0",
            "outline": "#737686"
          },
          "borderRadius": {
            "DEFAULT": "0.125rem",
            "lg": "0.25rem",
            "xl": "0.5rem",
            "full": "0.75rem"
          },
          "spacing": {
            "xl": "32px",
            "md": "16px",
            "base": "4px",
            "gutter": "24px",
            "xs": "4px",
            "lg": "24px",
            "sidebar-width": "280px",
            "sm": "8px"
          },
          "fontFamily": { "body-lg": ["Inter"] },
          "fontSize": {
            "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600" }],
            "headline-xl": ["30px", { "lineHeight": "38px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
            "body-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
            "body-sm": ["13px", { "lineHeight": "18px", "fontWeight": "400" }],
            "headline-md": ["20px", { "lineHeight": "28px", "fontWeight": "600" }],
            "headline-lg": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
            "label-sm": ["11px", { "lineHeight": "14px", "fontWeight": "500" }]
          }
        },
      },
    }
  </script>
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }

    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    ::-webkit-scrollbar {
      width: 6px;
    }

    ::-webkit-scrollbar-track {
      background: transparent;
    }

    ::-webkit-scrollbar-thumb {
      background: #e2e8f0;
      border-radius: 10px;
    }

    /* Pagination button styles */
    .page-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 32px;
      height: 32px;
      padding: 0 8px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      border: 1px solid #e0e3e5;
      background: #fff;
      color: #737686;
      transition: all 0.15s;
      user-select: none;
    }

    .page-btn:hover:not(:disabled) {
      background: #f2f4f6;
      color: #191c1e;
    }

    .page-btn.active {
      background: #004ac6;
      color: #fff;
      border-color: #004ac6;
    }

    .page-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }
  </style>
</head>

<body class="bg-background text-on-surface">

  <!-- SideNavBar -->
  <aside class="fixed left-0 top-0 h-full w-sidebar-width flex flex-col p-lg bg-[#0c1424] z-50">
    <div class="mb-xl px-4">
      <h1 class="text-headline-lg font-bold text-white">AdminPro</h1>
      <p class="text-label-sm text-[#a3aac4]">Enterprise Suite</p>
    </div>

    <nav class="flex-1 space-y-1">
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-white border-l-4 border-[#90abff] bg-[#1f2b49] font-bold text-sm"
        href="/admin/dashboard">
        <span class="material-symbols-outlined text-lg">dashboard</span>Dashboard
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/order-management">
        <span class="material-symbols-outlined text-lg">shopping_cart</span>Orders
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/products">
        <span class="material-symbols-outlined text-lg">inventory_2</span>Products
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/users">
        <span class="material-symbols-outlined text-lg">group</span>Users
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/analystic">
        <span class="material-symbols-outlined text-lg">monitoring</span>Analytics
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/coupons">
        <span class="material-symbols-outlined text-lg">confirmation_number</span>Coupons
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/category">
        <span class="material-symbols-outlined text-lg">category</span>Categories
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/offer">
        <span class="material-symbols-outlined text-lg">local_offer</span>Offers
      </a>
     
    </nav>

    <div class="mt-auto px-4 py-lg border-t border-[#1f2b49] flex items-center gap-sm">
      <div class="overflow-hidden">
        <p class="text-label-md font-semibold text-white truncate">Organization Logo</p>
        <p class="text-label-sm text-[#a3aac4] truncate">Premium Admin</p>
      </div>
    </div>
  </aside>

  <!-- TopAppBar -->
  <!-- <header
    class="flex justify-between items-center h-16 px-lg ml-sidebar-width w-[calc(100%-280px)] bg-white sticky top-0 z-40 border-b border-surface-variant">
    <div class="flex items-center gap-md flex-1">
      <div class="relative w-full max-w-md">
        <span
          class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">search</span>
        <input
          class="w-full bg-surface-container-low border-none rounded-xl pl-10 py-2 font-body-sm focus:ring-2 focus:ring-primary/20"
          placeholder="Search analytics, products, transactions..." type="text" />
      </div>
    </div>
    <div class="flex items-center gap-lg">
      <button class="font-label-md text-label-md text-on-surface-variant hover:text-primary">Settings</button>
      <button
        class="bg-primary text-white px-md py-sm rounded-xl font-label-md text-label-md hover:opacity-90 transition-opacity">Profile</button>
    </div>
  </header> -->

  <!-- Main Content -->
  <main class="ml-sidebar-width p-lg min-h-[calc(100vh-64px)] overflow-y-auto">

    <section class="flex flex-col md:flex-row md:items-end justify-between gap-md mb-lg">
      <div>
        <h2 class="font-headline-xl text-headline-xl text-on-surface">Sales Dashboard</h2>
        <p class="font-body-md text-body-md text-outline">Real-time performance metrics and revenue tracking.</p>
      </div>
    </section>

    <% const revenueSeries=(chartData && chartData.data) ? chartData.data : { labels: [], values: [] }; const
      fullRevenue=chartData && typeof chartData.fullRevenue==="number" ? chartData.fullRevenue : 0; const
      totalOrders=chartData && typeof chartData.totalOrders==="number" ? chartData.totalOrders : 0; const tabs=[ {
      key: "weekly" , label: "Weekly" }, { key: "monthly" , label: "Monthly" }, { key: "yearly" , label: "Yearly" } ];
      %>

      <!-- Revenue Performance -->
      <div class="bg-white rounded-xl shadow-sm border border-surface-variant overflow-hidden mb-lg">
        <div
          class="p-lg border-b border-surface-container-low flex flex-col md:flex-row justify-between items-start md:items-center gap-md">
          <div>
            <h3 class="font-headline-md text-headline-md text-on-surface">Revenue Performance</h3>
            <div class="flex items-center gap-sm mt-1">
              <span class="font-headline-lg text-headline-lg text-primary">
                ₹<%= fullRevenue.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
              </span>
              <span
                class="text-secondary bg-surface-container-low px-2 py-0.5 rounded-full font-label-sm text-label-sm">
                <%= totalOrders %> units sold
              </span>
            </div>
          </div>
          <div class="flex p-1 bg-surface-container-low rounded-xl">
            <% tabs.forEach(tab=> { %>
              <a href="/admin/dashboard?filter=<%= tab.key %>"
                class="px-md py-1.5 rounded-lg text-label-md font-label-md transition-colors <%= filter === tab.key ? 'bg-white shadow-sm text-primary' : 'text-outline hover:text-on-surface' %>">
                <%= tab.label %>
              </a>
              <% }) %>
          </div>
        </div>

        <div class="p-lg h-[320px] relative">
          <% if (!revenueSeries.labels || revenueSeries.labels.length===0) { %>
            <div class="absolute inset-0 flex items-center justify-center text-outline font-body-sm">
              No revenue data available for this period.
            </div>
            <% } else { %>
              <canvas id="revenueChart"></canvas>
              <% } %>
        </div>
      </div>

      <!-- Insights Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-lg mb-lg">

        <!-- Top Products -->
        <div class="bg-white rounded-xl shadow-sm border border-surface-variant p-lg">
          <div class="flex justify-between items-center mb-xl">
            <h3 class="font-headline-md text-headline-md text-on-surface">Top 10 Products</h3>
          </div>
          <% if (!topProducts || topProducts.length===0) { %>
            <p class="text-body-sm text-outline">No product sales recorded yet.</p>
            <% } else { %>
              <div class="space-y-md">
                <% const maxUnitsSold=topProducts[0].unitsSold || 1; %>
                  <% topProducts.forEach(product=> { %>
                    <div class="space-y-xs">
                      <div class="flex justify-between text-body-sm font-medium">
                        <span>
                          <%= product.name %>
                        </span>
                        <span class="text-primary">₹<%= (product.revenue || 0).toLocaleString('en-IN', {
                            minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                      </div>
                      <div class="h-2 w-full bg-surface-container-low rounded-full overflow-hidden">
                        <div class="h-full bg-primary rounded-full"
                          style="width: <%= Math.min((product.unitsSold / maxUnitsSold) * 100, 100) %>%"></div>
                      </div>
                    </div>
                    <% }) %>
              </div>
              <% } %>
        </div>

        <!-- Category Performance -->
        <div class="bg-white rounded-xl shadow-sm border border-surface-variant p-lg">
          <div class="flex justify-between items-center mb-xl">
            <h3 class="font-headline-md text-headline-md text-on-surface">Top 10 Categories</h3>
          </div>
          <% if (!topCategories || topCategories.length===0) { %>
            <p class="text-body-sm text-outline">No category sales recorded yet.</p>
            <% } else { %>
              <div class="space-y-md">
                <% const maxCategoryUnitsSold=topCategories[0].unitsSold || 1; %>
                  <% topCategories.forEach(cat=> { %>
                    <div class="space-y-xs">
                      <div class="flex justify-between text-body-sm font-medium">
                        <span>
                          <%= cat.name %>
                        </span>
                        <span class="text-primary">₹<%= (cat.revenue || 0).toLocaleString('en-IN', {
                            minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                      </div>
                      <div class="h-2 w-full bg-surface-container-low rounded-full overflow-hidden">
                        <div class="h-full bg-primary rounded-full"
                          style="width: <%= Math.min((cat.unitsSold / maxCategoryUnitsSold) * 100, 100) %>%"></div>
                      </div>
                    </div>
                    <% }) %>
              </div>
              <% } %>
        </div>
      </div>

  <%
    // ─── Net Balance Fix ───────────────────────────────────────────────────────
    // Previously: netBalance = ledger[last].runningBalance
    // Bug: if runningBalance isn't computed server-side, it comes through as 0.
    // Fix: recompute runningBalance client-side from credit/debit on each row,
    //       and derive the header totals + net from the full array, not the last row.
    //
    // Also ensure ledger rows always have a valid runningBalance by computing it
    // here if the server didn't supply one.
    let runningTotal = 0;
    const ledgerWithBalance = (ledger || []).map(entry => {
      runningTotal += (entry.credit || 0) - (entry.debit || 0);
      return { ...entry, runningBalance: entry.runningBalance || runningTotal };
    });

    const ledgerTotals = ledgerWithBalance.reduce((acc, entry) => {
      acc.credit += entry.credit || 0;
      acc.debit  += entry.debit  || 0;
      return acc;
    }, { credit: 0, debit: 0 });

    // Net balance = last row's running balance (or sum of credits minus debits)
    const netBalance = ledgerWithBalance.length > 0
      ? ledgerWithBalance[ledgerWithBalance.length - 1].runningBalance
      : 0;
  %>

        <!-- Ledger Book -->
        <section class="bg-white rounded-xl shadow-sm border border-surface-variant overflow-hidden">
          <div
            class="p-lg border-b border-surface-container-low flex flex-col md:flex-row justify-between items-start md:items-center gap-md">
            <div>
              <h3 class="font-headline-md text-headline-md text-on-surface">Ledger Book</h3>
              <p class="text-body-sm text-outline mt-1">Last 30 days — completed sales (credit) vs returns (debit)</p>
            </div>
            <div class="flex items-center gap-lg">
              <div class="text-right">
                <p class="text-label-sm text-outline uppercase tracking-wider">Total Credit</p>
                <p class="font-headline-md text-emerald-600">+₹<%= ledgerTotals.credit.toLocaleString('en-IN', {
                    minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </p>
              </div>
              <div class="text-right">
                <p class="text-label-sm text-outline uppercase tracking-wider">Total Debit</p>
                <p class="font-headline-md text-error">-₹<%= ledgerTotals.debit.toLocaleString('en-IN', {
                    minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </p>
              </div>
              <div class="text-right border-l border-surface-variant pl-lg">
                <p class="text-label-sm text-outline uppercase tracking-wider">Net Balance</p>
                <p class="font-headline-md text-on-surface">₹<%= netBalance.toLocaleString('en-IN', {
                    minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </p>
              </div>
            </div>
          </div>

          <% if (!ledgerWithBalance || ledgerWithBalance.length===0) { %>
            <div class="p-lg text-body-sm text-outline">No transactions in the last 30 days.</div>
            <% } else { %>
              <!-- Table (rows injected by JS pagination) -->
              <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                  <thead class="bg-surface-bright border-b border-surface-variant sticky top-0">
                    <tr>
                      <th class="px-lg py-md font-label-md text-label-md text-outline uppercase tracking-wider">Date
                      </th>
                      <th
                        class="px-lg py-md font-label-md text-label-md text-outline uppercase tracking-wider text-right">
                        Credit</th>
                      <th
                        class="px-lg py-md font-label-md text-label-md text-outline uppercase tracking-wider text-right">
                        Debit</th>
                      <th
                        class="px-lg py-md font-label-md text-label-md text-outline uppercase tracking-wider text-right">
                        Balance</th>
                    </tr>
                  </thead>
                  <tbody id="ledger-tbody" class="divide-y divide-surface-container-low font-body-sm text-body-sm">
                    <%# rows rendered by renderLedgerPage() JS below %>
                  </tbody>
                </table>
              </div>

              <!-- Pagination controls -->
              <div class="flex items-center justify-between px-lg py-md border-t border-surface-container-low">
                <span id="ledger-range-label" class="text-body-sm text-outline"></span>
                <div id="ledger-pagination" class="flex items-center gap-1"></div>
              </div>
              <% } %>
        </section>

  </main>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    // ── Revenue chart ──────────────────────────────────────────────────────────
    const revenueSeries = JSON.parse('<%- JSON.stringify(revenueSeries).replace(/'/g, "\\'") %>');

    const canvas = document.getElementById('revenueChart');
    if (canvas && revenueSeries.labels && revenueSeries.labels.length > 0) {
      new Chart(canvas.getContext('2d'), {
        type: 'line',
        data: {
          labels: revenueSeries.labels,
          datasets: [{
            label: 'Revenue',
            data: revenueSeries.values,
            borderColor: '#004ac6',
            backgroundColor: 'rgba(0, 74, 198, 0.1)',
            fill: true,
            tension: 0.4,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            y: {
              beginAtZero: true,
              ticks: {
                callback: (value) => '₹' + value.toLocaleString('en-IN')
              }
            }
          }
        }
      });
    }

    // ── Ledger pagination ──────────────────────────────────────────────────────
    const LEDGER_DATA = JSON.parse('<%- JSON.stringify(ledgerWithBalance).replace(/'/g, "\\'") %>');
    const ROWS_PER_PAGE = 10;
    let currentPage = 1;

    function fmtINR(amount) {
      return '₹' + Number(amount).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function totalPages() {
      return Math.max(1, Math.ceil(LEDGER_DATA.length / ROWS_PER_PAGE));
    }

    function renderLedgerPage(page) {
      const tbody = document.getElementById('ledger-tbody');
      if (!tbody) return;

      const start = (page - 1) * ROWS_PER_PAGE;
      const end = Math.min(start + ROWS_PER_PAGE, LEDGER_DATA.length);
      const slice = LEDGER_DATA.slice(start, end);

      tbody.innerHTML = slice.map(entry => `
      <tr class="hover:bg-surface-container-low transition-colors">
        <td class="px-lg py-md font-medium">${entry.date}</td>
        <td class="px-lg py-md text-right font-medium text-emerald-600">
          ${entry.credit > 0 ? '+' + fmtINR(entry.credit) : '—'}
        </td>
        <td class="px-lg py-md text-right font-medium" style="color:#ba1a1a">
          ${entry.debit > 0 ? '-' + fmtINR(entry.debit) : '—'}
        </td>
        <td class="px-lg py-md text-right font-semibold text-on-surface">
          ${fmtINR(entry.runningBalance)}
        </td>
      </tr>
    `).join('');

      // Range label
      const label = document.getElementById('ledger-range-label');
      if (label) {
        label.textContent = `Showing ${start + 1}–${end} of ${LEDGER_DATA.length} entries`;
      }

      renderPagination(page);
    }

    function renderPagination(page) {
      const container = document.getElementById('ledger-pagination');
      if (!container) return;
      const tp = totalPages();

      // Build page numbers to show: always first, last, current ±1, with ellipsis
      const pages = new Set([1, tp, page, page - 1, page + 1].filter(p => p >= 1 && p <= tp));
      const sorted = [...pages].sort((a, b) => a - b);

      let html = `
      <button class="page-btn" id="pg-prev" ${page === 1 ? 'disabled' : ''} onclick="goToPage(${page - 1})">
        <span class="material-symbols-outlined" style="font-size:16px;line-height:1">chevron_left</span>
      </button>`;

      let prev = null;
      for (const p of sorted) {
        if (prev !== null && p - prev > 1) {
          html += `<span class="page-btn" style="cursor:default;border:none;color:#737686">…</span>`;
        }
        html += `<button class="page-btn ${p === page ? 'active' : ''}" onclick="goToPage(${p})">${p}</button>`;
        prev = p;
      }

      html += `
      <button class="page-btn" id="pg-next" ${page === tp ? 'disabled' : ''} onclick="goToPage(${page + 1})">
        <span class="material-symbols-outlined" style="font-size:16px;line-height:1">chevron_right</span>
      </button>`;

      container.innerHTML = html;
    }

    function goToPage(page) {
      const tp = totalPages();
      if (page < 1 || page > tp) return;
      currentPage = page;
      renderLedgerPage(page);
    }

    // Initial render
    if (LEDGER_DATA.length > 0) {
      renderLedgerPage(1);
    }
  </script>
</body>

</html>
