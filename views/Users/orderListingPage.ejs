<!DOCTYPE html>
<html class="dark" lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>My Orders — LUXE</title>
<script src="/js/blockedUserGuard.js"></script>
<link rel="icon" type="image/x-icon" href="/favicon.png">
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<script>
  tailwind.config = {
    darkMode: "class",
    theme: {
      extend: {
        colors: {
          primary: "#1152d4",
          "primary-dark": "#0d3fa8",
          "bg-dark": "#101622",
        },
        fontFamily: {
          display: ["Manrope", "sans-serif"],
          serif: ["Cormorant Garamond", "Georgia", "serif"],
        },
      },
    },
  }
</script>
<style>
  body { font-family: 'Manrope', sans-serif; }
  .msym { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }

  #toast {
    position: fixed; bottom: 2rem; left: 50%;
    transform: translateX(-50%) translateY(120px);
    z-index: 9999;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    pointer-events: none;
  }
  #toast.show { transform: translateX(-50%) translateY(0); }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .fu { animation: fadeUp 0.5s ease forwards; opacity: 0; }
  .d1 { animation-delay: 0.05s; }
  .d2 { animation-delay: 0.12s; }
  .d3 { animation-delay: 0.20s; }
  .d4 { animation-delay: 0.28s; }

  /* ── ORDER CARD ── */
  .order-card {
    background: #0d1322; border: 1px solid #1e293b; border-radius: 12px;
    padding: 20px 22px; position: relative;
    transition: border-color .2s, background .2s, transform .15s;
  }
  .order-card:hover { border-color: #1e3a6e; background: #0f1829; transform: translateY(-2px); }

  .order-thumb-zoom { overflow: hidden; border-radius: 10px; }
  .order-thumb-zoom img { transition: transform 0.5s ease; }
  .order-card:hover .order-thumb-zoom img { transform: scale(1.08); }

  .status-pill {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    padding: 4px 10px; border-radius: 20px;
  }
  .status-delivered  { color: #34d399; background: rgba(52,211,153,.1);  border: 1px solid rgba(52,211,153,.25); }
  .status-cancelled  { color: #f87171; background: rgba(239,68,68,.1);   border: 1px solid rgba(239,68,68,.25); }
  .status-transit    { color: #60a5fa; background: rgba(96,165,250,.1);  border: 1px solid rgba(96,165,250,.25); }
  .status-processing { color: #fbbf24; background: rgba(251,191,36,.1);  border: 1px solid rgba(251,191,36,.25); }

  .view-details-btn {
    display: inline-flex; align-items: center; gap: 6px;
    background: transparent; border: 1px solid #334155; color: #60a5fa;
    font-family: 'Manrope', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    padding: 9px 16px; border-radius: 8px; cursor: pointer; transition: all .2s; white-space: nowrap;
  }
  .view-details-btn:hover { background: #1152d4; color: #fff; border-color: #1152d4; }
  .view-details-btn .material-symbols-outlined { transition: transform .2s; font-size: 16px; }
  .view-details-btn:hover .material-symbols-outlined { transform: translateX(3px); }

  .scroll-thin::-webkit-scrollbar { width: 4px; }
  .scroll-thin::-webkit-scrollbar-track { background: transparent; }
  .scroll-thin::-webkit-scrollbar-thumb { background: #1152d4; border-radius: 2px; }

  .page-btn {
    background: transparent; border: 1px solid #1e293b; color: #94a3b8;
    font-family: 'Manrope', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    padding: 9px 16px; border-radius: 8px; transition: all .2s;
  }
  .page-btn:hover { border-color: #1152d4; color: #60a5fa; }
</style>
  <link rel="stylesheet" href="/css/navigation-consistency.css" />
</head>
<body class="bg-bg-dark text-slate-100 antialiased min-h-screen">

<!-- ══ TOAST ══ -->
<div id="toast">
  <div class="flex items-center gap-3 bg-slate-900 border border-slate-700 text-white px-5 py-3 rounded-2xl shadow-2xl">
    <span id="toast-icon" class="material-symbols-outlined msym text-green-400">check_circle</span>
    <span id="toast-msg" class="text-sm font-semibold"></span>
  </div>
</div>

<div class="flex flex-col min-h-screen">

  <!-- ══ HEADER ══ -->
  <header class="sticky top-0 z-50 border-b border-slate-800 bg-bg-dark/80 backdrop-blur-md px-6 lg:px-20 py-4">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-8">
      <div class="flex items-center gap-12">
        <a href="/" class="flex items-center gap-2 text-primary">
          <span class="material-symbols-outlined msym text-3xl">diamond</span>
          <span class="text-white text-2xl font-extrabold tracking-tight">LUXE</span>
        </a>
        <nav class="hidden md:flex items-center gap-8">
          <a href="/" class="text-slate-400 hover:text-white text-sm font-semibold transition-colors">Home</a>
          <a href="/product-listing" class="text-slate-400 hover:text-white text-sm font-semibold transition-colors">Products</a>
          <a href="/cart" class="text-slate-400 hover:text-white text-sm font-semibold transition-colors">Cart</a>
        </nav>
      </div>
      <div class="flex items-center gap-3">
        <a href="/cart" class="relative p-2 text-slate-400 hover:text-white hover:bg-slate-800 rounded-lg transition-all">
          <span class="material-symbols-outlined msym">shopping_bag</span>
          <% if (cart > 0) { %>
            <span class="absolute -top-1 -right-1 w-5 h-5 bg-primary text-white text-xs font-bold rounded-full flex items-center justify-center">
              <%= cart %>
            </span>
          <% } %>
        </a>
        <a href="/profile" class="p-2 text-primary bg-primary/10 rounded-lg transition-all">
          <span class="material-symbols-outlined msym" style="font-variation-settings:'FILL' 1">person</span>
        </a>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto w-full px-6 lg:px-20 py-10 flex-1">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-slate-500 mb-6 fu d1">
      <a href="/" class="hover:text-primary transition-colors">Home</a>
      <span class="material-symbols-outlined msym text-xs">chevron_right</span>
      <a href="/profile" class="hover:text-primary transition-colors">Account</a>
      <span class="material-symbols-outlined msym text-xs">chevron_right</span>
      <span class="text-slate-200 font-semibold">My Orders</span>
    </nav>

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-3 mb-10 fu d1">
      <div>
        <h1 class="text-2xl md:text-3xl font-extrabold uppercase tracking-tight font-serif mb-1">My Orders</h1>
        <p class="text-sm text-slate-500">A curated history of your acquisitions</p>
      </div>
    </div>

    <% if (!orders || orders.length === 0) { %>
      <!-- ══ EMPTY STATE ══ -->
      <div class="flex flex-col items-center justify-center py-28 gap-5 text-center fu d2 bg-[#0d1322] border border-slate-800 rounded-2xl">
        <span class="material-symbols-outlined msym text-6xl text-slate-600">inbox</span>
        <p class="text-xl font-extrabold font-serif text-white">No orders yet</p>
        <p class="text-xs text-slate-500 uppercase tracking-widest">Your acquisitions will appear here</p>
        <a href="/product-listing">
          <button class="mt-2 inline-flex items-center gap-2 bg-primary hover:bg-primary-dark text-white font-bold px-7 py-3 rounded-xl transition-all shadow-lg shadow-primary/20 active:scale-95 text-xs uppercase tracking-widest">
            Begin Shopping
          </button>
        </a>
      </div>

    <% } else { %>
      <div class="flex flex-col gap-4 fu d2">
        <% orders.forEach(function(o) { %>
          <%
            /* ── resolve first active item for thumbnail ── */
            const cancelledVIds = new Set(
              (o.cancelledAt || []).flatMap(ca =>
                (ca.cancelledProducts || []).map(cp => cp && cp._id ? cp._id.toString() : String(cp))
              )
            );
            const activeItems = (o.orderItems || []).filter(item => {
              const vid = item.variantId && typeof item.variantId === 'object'
                ? item.variantId._id.toString()
                : String(item.variantId);
              return !cancelledVIds.has(vid);
            });
            const firstItem  = activeItems[0] || (o.orderItems || [])[0];
            const firstVariant = firstItem && firstItem.variantId && typeof firstItem.variantId === 'object'
              ? firstItem.variantId : null;
            const firstImages  = firstVariant ? (firstVariant.images || firstVariant.image || []) : [];
            const firstThumb   = firstImages[0] ? '/uploads/' + firstImages[0] : '/images/placeholder.png';

            /* ── status display ── */
            const st = (o.orderStatus || '').toLowerCase();
            const isDelivered  = st === 'completed';
            const isCancelled  = st === 'cancelled';
            const isProcessing = st === 'placed' || st === 'pending';
            const isTransit    = st === 'processing' || st === 'shipped';

            /* ── total items count ── */
            const totalQty = (o.orderItems || []).reduce((s, i) => s + (i.quantity || 1), 0);
          %>

          <div class="order-card flex flex-col md:flex-row gap-5">

            <!-- Thumbnails -->
            <div class="flex -space-x-4 flex-shrink-0">
              <% (o.orderItems || []).slice(0, 2).forEach(function(item, idx) {
                const v   = item.variantId && typeof item.variantId === 'object' ? item.variantId : null;
                const img = v ? (v.images || v.image || [])[0] : null;
                const src = img ? '/uploads/' + img : '/images/placeholder.png';
              %>
                <div class="order-thumb-zoom w-20 h-20 bg-slate-800 border-2 border-[#0d1322] flex-shrink-0" style="z-index:<%= 20 - idx %>;">
                  <img alt="<%= item.productName || 'Product' %>" class="w-full h-full object-cover" src="<%= src %>" onerror="this.src='/images/placeholder.png'"/>
                </div>
              <% }) %>
            </div>

            <div class="flex-grow flex flex-col justify-between gap-4">

              <!-- Top row: meta -->
              <div class="flex flex-wrap justify-between items-start gap-4">

                <div>
                  <span class="text-[10px] uppercase tracking-widest text-slate-500 mb-1 block">Order Reference</span>
                  <h3 class="text-sm font-bold text-white">#<%= o.orderCode %></h3>
                </div>

                <div>
                  <span class="text-[10px] uppercase tracking-widest text-slate-500 mb-1 block">Placed On</span>
                  <p class="text-sm text-slate-300"><%= new Date(o.orderDate).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %></p>
                </div>

                <div>
                  <span class="text-[10px] uppercase tracking-widest text-slate-500 mb-1 block">Status</span>
                  <% if (isDelivered) { %>
                    <span class="status-pill status-delivered">
                      <span class="material-symbols-outlined msym" style="font-size:13px;font-variation-settings:'FILL' 1">check_circle</span>
                      Delivered
                    </span>
                  <% } else if (isCancelled) { %>
                    <span class="status-pill status-cancelled">
                      <span class="material-symbols-outlined msym" style="font-size:13px">cancel</span>
                      Cancelled
                    </span>
                  <% } else if (isTransit) { %>
                    <span class="status-pill status-transit">
                      <span class="material-symbols-outlined msym" style="font-size:13px">local_shipping</span>
                      In Transit
                    </span>
                  <% } else { %>
                    <span class="status-pill status-processing">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                      Processing
                    </span>
                  <% } %>
                </div>

                <div>
                  <span class="text-[10px] uppercase tracking-widest text-slate-500 mb-1 block">Total</span>
                  <p class="text-primary font-extrabold text-sm">₹<%= (o.totalAmount || 0).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></p>
                </div>

              </div>

              <!-- Bottom row: item name + actions -->
              <div class="flex items-center gap-4 pt-4 border-t border-slate-800">

                <div class="min-w-0">
                  <p class="text-xs font-bold uppercase tracking-wide text-white truncate"><%= firstItem ? firstItem.productName : 'N/A' %></p>
                  <p class="text-[11px] text-slate-500 mt-0.5">
                    Qty: <%= totalQty %> item<%= totalQty !== 1 ? 's' : '' %>
                  </p>
                </div>

                <div class="ml-auto">
                  <a href="/order/details/<%= o._id %>">
                    <button class="view-details-btn">
                      View Details
                      <span class="material-symbols-outlined msym">arrow_forward</span>
                    </button>
                  </a>
                </div>

              </div>
            </div>
          </div>

        <% }) %>
      </div>

      <!-- ══ PAGINATION ══ -->
      <% if (pagination && pagination.totalPages > 1) { %>
        <div class="mt-12 flex justify-center items-center gap-4 fu d3">
          <% if (pagination.currentPage > 1) { %>
            <a href="?page=<%= pagination.currentPage - 1 %>" class="page-btn">Prev</a>
          <% } %>
          <span class="text-[11px] font-bold uppercase tracking-widest text-slate-500">
            Page <%= pagination.currentPage %> of <%= pagination.totalPages %>
          </span>
          <% if (pagination.currentPage < pagination.totalPages) { %>
            <a href="?page=<%= pagination.currentPage + 1 %>" class="page-btn">Next</a>
          <% } %>
        </div>
      <% } %>
    <% } %>

  </main>

  <!-- ══ FOOTER ══ -->
  <footer class="bg-slate-900/60 mt-20 px-6 lg:px-20 py-12 border-t border-slate-800">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-600 uppercase tracking-widest">
      <div class="flex items-center gap-2 text-primary">
        <span class="material-symbols-outlined msym">diamond</span>
        <span class="text-white font-extrabold tracking-tight">LUXE</span>
      </div>
      <p>© <%= new Date().getFullYear() %> Luxe Menswear. All Rights Reserved.</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-primary transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-primary transition-colors">Terms of Service</a>
        <a href="#" class="hover:text-primary transition-colors">Contact Us</a>
      </div>
    </div>
  </footer>

</div>

<script>
  /* ── TOAST (matches checkout page) ── */
  let _toastTimer;
  function showToast(msg, icon = 'check_circle', cls = 'text-green-400') {
    document.getElementById('toast-msg').textContent = msg;
    const ic = document.getElementById('toast-icon');
    ic.textContent = icon;
    ic.className   = 'material-symbols-outlined msym ' + cls;
    document.getElementById('toast').classList.add('show');
    clearTimeout(_toastTimer);
    _toastTimer = setTimeout(() => document.getElementById('toast').classList.remove('show'), 2800);
  }
</script>
</body>
</html>
