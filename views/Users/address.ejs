<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>LUXE | Manage Addresses</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Syne:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@300,0..1&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg: #080c14; --sur: #0e1523; --sur2: #141c2e; --sur3: #1a2338; --sur4: #212c42;
    --bord: rgba(255,255,255,0.07); --bord2: rgba(255,255,255,0.13);
    --pri: #3a6ff7; --gold: #c9a96e; --gold2: #e0c08a;
    --txt: #e8edf8; --txt2: #8892a4; --txt3: #5a6478;
    --green: #22c55e; --red: #ef4444;
    --nav-h: 68px; --side-w: 260px; --r: 12px; --rl: 18px;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--txt); min-height: 100vh; overflow-x: hidden; }
  ::-webkit-scrollbar { width: 4px; } ::-webkit-scrollbar-track { background: var(--bg); } ::-webkit-scrollbar-thumb { background: var(--sur4); border-radius: 99px; }

  /* ── NAV ── */
  nav.topnav {
    position: fixed; top: 0; left: 0; right: 0; height: var(--nav-h);
    background: rgba(8,12,20,0.9); backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--bord);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 36px; z-index: 100;
  }
  .brand { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 1rem; letter-spacing: .22em; text-transform: uppercase; }
  .brand span { color: var(--gold); }
  .nav-links { display: flex; gap: 32px; list-style: none; }
  .nav-links a { font-family: 'Syne', sans-serif; font-size: .6rem; letter-spacing: .18em; text-transform: uppercase; color: var(--txt2); text-decoration: none; transition: color .2s; }
  .nav-links a:hover { color: var(--txt); }
  .nav-acts { display: flex; align-items: center; gap: 16px; }
  .nav-btn { background: none; border: none; cursor: pointer; color: var(--txt2); display: flex; align-items: center; transition: color .2s; }
  .nav-btn:hover { color: var(--txt); } .nav-btn.on { color: var(--pri); }
  .nav-btn .ms { font-size: 22px; font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 0, 'wght' 300; }

  /* ── SIDEBAR ── */
  aside.sidebar {
    position: fixed; top: var(--nav-h); left: 0;
    width: var(--side-w); height: calc(100vh - var(--nav-h));
    background: var(--sur); border-right: 1px solid var(--bord);
    display: flex; flex-direction: column; padding: 28px 0 20px; z-index: 50; overflow-y: auto;
  }
  .sidebar-header { padding: 0 24px 24px; border-bottom: 1px solid var(--bord); margin-bottom: 12px; }
  .sidebar-header h3 { font-family: 'Syne', sans-serif; font-weight: 700; font-size: .9rem; margin-bottom: 6px; }
  .sidebar-tier { display: inline-flex; align-items: center; gap: 5px; background: rgba(201,169,110,.1); border: 1px solid rgba(201,169,110,.25); border-radius: 99px; padding: 3px 10px; }
  .sidebar-tier span { font-family: 'Syne', sans-serif; font-size: .5rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--gold); }
  .tier-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--gold); flex-shrink: 0; }
  .sidebar-nav { display: flex; flex-direction: column; gap: 2px; padding: 0 10px; }
  .sidebar-link {
    display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 8px;
    text-decoration: none; color: var(--txt2); font-size: .625rem; font-family: 'Syne', sans-serif;
    font-weight: 600; letter-spacing: .1em; text-transform: uppercase; transition: all .2s;
  }
  .sidebar-link .material-symbols-outlined { font-size: 17px; flex-shrink: 0; font-variation-settings: 'FILL' 0, 'wght' 300; }
  .sidebar-link:hover { background: var(--sur3); color: var(--txt); }
  .sidebar-link.active { background: rgba(58,111,247,.12); color: var(--pri); }
  .sidebar-footer { margin-top: auto; padding: 18px 24px 0; border-top: 1px solid var(--bord); }
  .sidebar-footer a { display: flex; align-items: center; gap: 9px; text-decoration: none; color: var(--txt3); font-size: .625rem; font-family: 'Syne', sans-serif; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; transition: color .2s; }
  .sidebar-footer a:hover { color: var(--txt2); }
  .sidebar-footer .material-symbols-outlined { font-size: 17px; font-variation-settings: 'FILL' 0, 'wght' 300; }

  /* ── MAIN ── */
  main { margin-left: var(--side-w); padding: calc(var(--nav-h) + 44px) 48px 80px; min-height: 100vh; }
  .page-header { margin-bottom: 36px; display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 16px; }
  .page-header-left h1 { font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: 3.2rem; letter-spacing: -.01em; line-height: 1.05; margin-bottom: 6px; }
  .page-header-left h1 em { font-style: italic; color: var(--gold2); }
  .page-header-left p { color: var(--txt3); font-size: .82rem; font-weight: 300; }
  .add-address-btn {
    display: flex; align-items: center; gap: 8px;
    background: var(--pri); color: #fff; border: none; border-radius: 8px;
    padding: 12px 20px; font-family: 'Syne', sans-serif; font-size: .65rem; font-weight: 700;
    letter-spacing: .12em; text-transform: uppercase; cursor: pointer; transition: all .2s;
    flex-shrink: 0;
  }
  .add-address-btn:hover { background: #5b84ff; box-shadow: 0 0 24px rgba(58,111,247,.35); }
  .add-address-btn .material-symbols-outlined { font-size: 17px; font-variation-settings: 'FILL' 0, 'wght' 300; }

  /* ── ADDRESS GRID ── */
  .address-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 20px; }

  .addr-card {
    background: var(--sur); border: 1px solid var(--bord); border-radius: var(--rl);
    overflow: hidden; transition: border-color .25s, transform .25s;
    animation: fu .45s ease both;
  }
  .addr-card:hover { border-color: var(--bord2); transform: translateY(-2px); }
  .addr-card.is-default { border-color: rgba(58,111,247,.35); }
  .addr-card-top { padding: 22px 22px 18px; display: flex; align-items: flex-start; gap: 14px; }
  .addr-icon-wrap { width: 42px; height: 42px; border-radius: 10px; background: rgba(58,111,247,.1); border: 1px solid rgba(58,111,247,.2); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .addr-icon-wrap .material-symbols-outlined { font-size: 20px; color: var(--pri); font-variation-settings: 'FILL' 0, 'wght' 300; }
  .addr-card-info { flex: 1; min-width: 0; }
  .addr-card-name { font-family: 'Syne', sans-serif; font-weight: 700; font-size: .9rem; color: var(--txt); margin-bottom: 2px; }
  .addr-card-phone { font-size: .78rem; color: var(--txt3); margin-bottom: 8px; }
  .addr-card-text { font-size: .82rem; color: var(--txt2); line-height: 1.65; font-weight: 300; }
  .default-badge { display: inline-flex; align-items: center; gap: 4px; background: rgba(58,111,247,.1); border: 1px solid rgba(58,111,247,.2); border-radius: 99px; padding: 3px 9px; font-family: 'Syne', sans-serif; font-size: .47rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--pri); margin-top: 10px; }
  .default-badge .material-symbols-outlined { font-size: 12px; font-variation-settings: 'FILL' 1, 'wght' 300; }

  .addr-card-actions { border-top: 1px solid var(--bord); padding: 14px 22px; display: flex; align-items: center; gap: 8px; background: var(--sur2); }
  .action-btn {
    display: flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 7px;
    font-family: 'Syne', sans-serif; font-size: .58rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    border: none; cursor: pointer; transition: all .2s;
  }
  .action-btn .material-symbols-outlined { font-size: 14px; font-variation-settings: 'FILL' 0, 'wght' 300; }
  .action-btn.edit { background: rgba(58,111,247,.1); color: var(--pri); border: 1px solid rgba(58,111,247,.2); }
  .action-btn.edit:hover { background: rgba(58,111,247,.2); }
  .action-btn.delete { background: rgba(239,68,68,.08); color: #f87171; border: 1px solid rgba(239,68,68,.2); }
  .action-btn.delete:hover { background: rgba(239,68,68,.18); }
  .action-btn.set-default { background: rgba(201,169,110,.08); color: var(--gold); border: 1px solid rgba(201,169,110,.2); margin-left: auto; }
  .action-btn.set-default:hover { background: rgba(201,169,110,.18); }

  /* ── EMPTY STATE ── */
  .empty-state { grid-column: 1/-1; text-align: center; padding: 80px 20px; }
  .empty-icon { width: 70px; height: 70px; border-radius: 50%; background: var(--sur2); border: 1px solid var(--bord); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; }
  .empty-icon .material-symbols-outlined { font-size: 32px; color: var(--txt3); font-variation-settings: 'FILL' 0, 'wght' 300; }
  .empty-state h3 { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 1rem; margin-bottom: 6px; }
  .empty-state p { color: var(--txt3); font-size: .82rem; font-weight: 300; }

  /* ── MODAL ── */
  .modal-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,.65); backdrop-filter: blur(8px);
    z-index: 200; display: flex; align-items: center; justify-content: center; padding: 20px;
    opacity: 0; pointer-events: none; transition: opacity .25s;
  }
  .modal-overlay.open { opacity: 1; pointer-events: all; }
  .modal {
    background: var(--sur); border: 1px solid var(--bord2); border-radius: var(--rl);
    width: 100%; max-width: 540px; max-height: 90vh; overflow-y: auto;
    transform: translateY(24px) scale(.97); transition: transform .3s;
  }
  .modal-overlay.open .modal { transform: translateY(0) scale(1); }
  .modal-header { padding: 26px 28px 20px; border-bottom: 1px solid var(--bord); display: flex; align-items: center; justify-content: space-between; }
  .modal-header h2 { font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 1.6rem; }
  .modal-header h2 em { font-style: italic; color: var(--gold2); }
  .modal-close { background: none; border: none; cursor: pointer; color: var(--txt3); display: flex; align-items: center; padding: 4px; border-radius: 6px; transition: color .2s, background .2s; }
  .modal-close:hover { color: var(--txt); background: var(--sur3); }
  .modal-close .material-symbols-outlined { font-size: 20px; font-variation-settings: 'FILL' 0, 'wght' 300; }
  .modal-body { padding: 26px 28px 28px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
  .form-group { display: flex; flex-direction: column; gap: 7px; margin-bottom: 16px; }
  .form-group:last-child { margin-bottom: 0; }
  .form-label { font-family: 'Syne', sans-serif; font-size: .55rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--txt3); }
  .form-input {
    background: var(--sur2); border: 1px solid var(--bord2); border-radius: 8px;
    padding: 11px 14px; font-family: 'DM Sans', sans-serif; font-size: .875rem; color: var(--txt);
    width: 100%; outline: none; transition: border-color .2s, box-shadow .2s;
  }
  .form-input:focus { border-color: rgba(58,111,247,.5); box-shadow: 0 0 0 3px rgba(58,111,247,.1); }
  .form-input::placeholder { color: var(--txt3); }
  .form-check { display: flex; align-items: center; gap: 10px; padding: 14px 16px; background: var(--sur2); border: 1px solid var(--bord); border-radius: 8px; cursor: pointer; transition: border-color .2s; }
  .form-check:hover { border-color: rgba(58,111,247,.3); }
  .form-check input[type=checkbox] { width: 16px; height: 16px; accent-color: var(--pri); cursor: pointer; }
  .form-check-label { font-size: .82rem; color: var(--txt2); }
  .form-check-label strong { color: var(--txt); font-weight: 500; }
  .modal-footer { display: flex; gap: 10px; justify-content: flex-end; margin-top: 24px; }
  .btn-cancel { background: var(--sur3); color: var(--txt2); border: 1px solid var(--bord2); border-radius: 8px; padding: 11px 20px; font-family: 'Syne', sans-serif; font-size: .65rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; transition: all .2s; }
  .btn-cancel:hover { color: var(--txt); border-color: var(--bord2); }
  .btn-save { background: var(--pri); color: #fff; border: none; border-radius: 8px; padding: 11px 24px; font-family: 'Syne', sans-serif; font-size: .65rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; transition: all .2s; }
  .btn-save:hover { background: #5b84ff; box-shadow: 0 0 24px rgba(58,111,247,.35); }

  /* ── DELETE CONFIRM ── */
  .delete-modal { max-width: 420px; }
  .delete-icon-wrap { width: 56px; height: 56px; border-radius: 50%; background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.25); display: flex; align-items: center; justify-content: center; margin: 0 auto 18px; }
  .delete-icon-wrap .material-symbols-outlined { font-size: 26px; color: #f87171; font-variation-settings: 'FILL' 0, 'wght' 300; }
  .delete-content { text-align: center; }
  .delete-content h3 { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 1rem; margin-bottom: 8px; }
  .delete-content p { color: var(--txt3); font-size: .83rem; font-weight: 300; line-height: 1.6; }
  .btn-delete-confirm { background: var(--red); color: #fff; border: none; border-radius: 8px; padding: 11px 24px; font-family: 'Syne', sans-serif; font-size: .65rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; transition: all .2s; }
  .btn-delete-confirm:hover { background: #f87171; box-shadow: 0 0 20px rgba(239,68,68,.3); }

  /* Toast */
  .toast {
    position: fixed; bottom: 30px; right: 30px; z-index: 300;
    background: var(--sur3); border: 1px solid var(--bord2); border-radius: 10px;
    padding: 14px 20px; display: flex; align-items: center; gap: 10px;
    font-size: .83rem; color: var(--txt); box-shadow: 0 8px 32px rgba(0,0,0,.4);
    transform: translateY(80px); opacity: 0; transition: all .35s cubic-bezier(.34,1.56,.64,1);
    pointer-events: none;
  }
  .toast.show { transform: translateY(0); opacity: 1; }
  .toast .material-symbols-outlined { font-size: 18px; color: var(--green); font-variation-settings: 'FILL' 1, 'wght' 300; }
  .toast.error .material-symbols-outlined { color: #f87171; }

  @keyframes fu { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
  .addr-card:nth-child(2) { animation-delay: .05s; }
  .addr-card:nth-child(3) { animation-delay: .1s; }
  .addr-card:nth-child(4) { animation-delay: .15s; }

  @media (max-width: 900px) { :root { --side-w: 0px; } aside.sidebar { display: none; } main { padding: calc(var(--nav-h) + 28px) 20px 60px; } .nav-links { display: none; } }
  @media (max-width: 600px) { .form-row { grid-template-columns: 1fr; } .page-header { flex-direction: column; align-items: flex-start; } }
</style>
</head>
<body>

<!-- ── NAV ── -->
<nav class="topnav">
  <div class="brand">LUXE <span>ATELIER</span></div>
  <ul class="nav-links">
    <li><a href="#">Showroom</a></li>
    <li><a href="#">Collections</a></li>
    <li><a href="#">Atelier</a></li>
    <li><a href="#">Journal</a></li>
  </ul>
  <div class="nav-acts">
    <button class="nav-btn"><span class="ms material-symbols-outlined">shopping_bag</span></button>
    <button class="nav-btn on"><span class="ms material-symbols-outlined">person</span></button>
  </div>
</nav>

<!-- ── SIDEBAR ── -->
<aside class="sidebar">
  <div class="sidebar-header">
    <h3>User Account</h3>
    <div class="sidebar-tier"><div class="tier-dot"></div><span>Gold Member</span></div>
  </div>
  <nav class="sidebar-nav">
    <a href="/profile" class="sidebar-link">
      <span class="material-symbols-outlined">person</span><span>Profile</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">package_2</span><span>My Orders</span>
    </a>
    <a href="/address" class="sidebar-link active">
      <span class="material-symbols-outlined">distance</span><span>Manage Address</span>
    </a>
    <a href="/changePassword" class="sidebar-link">
      <span class="material-symbols-outlined">lock_reset</span><span>Change Password</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">favorite</span><span>Wishlist</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">share_reviews</span><span>Referral Link</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">account_balance_wallet</span><span>Wallet</span>
    </a>
    <a href="#" class="sidebar-link">
      <span class="material-symbols-outlined">confirmation_number</span><span>Coupons</span>
    </a>
  </nav>
  <div class="sidebar-footer">
    <a href="#"><span class="material-symbols-outlined">logout</span><span>Sign Out</span></a>
  </div>
</aside>

<!-- ── MAIN ── -->
<main>
  <div class="page-header">
    <div class="page-header-left">
      <h1>Manage <em>Addresses</em></h1>
      <p>Add, edit or remove your saved delivery addresses.</p>
    </div>
    <button class="add-address-btn" onclick="openAddModal()">
      <span class="material-symbols-outlined">add_location_alt</span>
      Add New Address
    </button>
  </div>

  <div class="address-grid" id="addressGrid">

    <!-- Address Card 1 — Default -->
    <div class="addr-card is-default" data-id="1">
      <div class="addr-card-top">
        <div class="addr-icon-wrap"><span class="material-symbols-outlined">home</span></div>
        <div class="addr-card-info">
          <div class="addr-card-name">Eleanor Voss</div>
          <div class="addr-card-phone">+91 98765 43210</div>
          <div class="addr-card-text">
            No. 14, MG Road<br/>
            Near Central Park<br/>
            Thrissur, Kerala — 680001<br/>
            India
          </div>
          <div class="default-badge">
            <span class="material-symbols-outlined">check_circle</span>Default
          </div>
        </div>
      </div>
      <div class="addr-card-actions">
        <button class="action-btn edit" onclick="openEditModal(1)">
          <span class="material-symbols-outlined">edit</span>Edit
        </button>
        <button class="action-btn delete" onclick="openDeleteModal(1)">
          <span class="material-symbols-outlined">delete</span>Delete
        </button>
      </div>
    </div>

    <!-- Address Card 2 -->
    <div class="addr-card" data-id="2">
      <div class="addr-card-top">
        <div class="addr-icon-wrap"><span class="material-symbols-outlined">apartment</span></div>
        <div class="addr-card-info">
          <div class="addr-card-name">Eleanor Voss</div>
          <div class="addr-card-phone">+91 91234 56789</div>
          <div class="addr-card-text">
            Flat 6B, Palm Residency<br/>
            Near Lulu Mall<br/>
            Kochi, Kerala — 682021<br/>
            India
          </div>
        </div>
      </div>
      <div class="addr-card-actions">
        <button class="action-btn edit" onclick="openEditModal(2)">
          <span class="material-symbols-outlined">edit</span>Edit
        </button>
        <button class="action-btn delete" onclick="openDeleteModal(2)">
          <span class="material-symbols-outlined">delete</span>Delete
        </button>
        <button class="action-btn set-default" onclick="setDefault(2)">
          <span class="material-symbols-outlined">star</span>Set Default
        </button>
      </div>
    </div>

    <!-- Address Card 3 -->
    <div class="addr-card" data-id="3">
      <div class="addr-card-top">
        <div class="addr-icon-wrap"><span class="material-symbols-outlined">corporate_fare</span></div>
        <div class="addr-card-info">
          <div class="addr-card-name">Voss Interiors Pvt. Ltd.</div>
          <div class="addr-card-phone">+91 80123 45678</div>
          <div class="addr-card-text">
            Shop 12, Brigade Road<br/>
            Opposite Metro Station<br/>
            Bengaluru, Karnataka — 560001<br/>
            India
          </div>
        </div>
      </div>
      <div class="addr-card-actions">
        <button class="action-btn edit" onclick="openEditModal(3)">
          <span class="material-symbols-outlined">edit</span>Edit
        </button>
        <button class="action-btn delete" onclick="openDeleteModal(3)">
          <span class="material-symbols-outlined">delete</span>Delete
        </button>
        <button class="action-btn set-default" onclick="setDefault(3)">
          <span class="material-symbols-outlined">star</span>Set Default
        </button>
      </div>
    </div>

  </div>
</main>

<!-- ── ADD / EDIT MODAL ── -->
<div class="modal-overlay" id="formModal">
  <div class="modal">
    <div class="modal-header">
      <h2 id="modalTitle">Add <em>Address</em></h2>
      <button class="modal-close" onclick="closeModal('formModal')">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>
    <div class="modal-body">
      <div class="form-row">
        <div class="form-group" style="margin-bottom:0">
          <label class="form-label">Full Name</label>
          <input class="form-input" id="f-name" name="fullName" type="text" placeholder="Recipient full name"/>
        </div>
        <div class="form-group" style="margin-bottom:0">
          <label class="form-label">Phone Number</label>
          <input class="form-input" id="f-phone" name="phoneNumber" type="tel" placeholder="+91 98765 43210"/>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group" style="margin-bottom:0">
          <label class="form-label">House / Flat No.</label>
          <input class="form-input" id="f-house" name="houseNumber" type="text" placeholder="e.g. 12A, Flat 3"/>
        </div>
        <div class="form-group" style="margin-bottom:0">
          <label class="form-label">Street Name</label>
          <input class="form-input" id="f-street" name="streetName" type="text" placeholder="Street / Road / Colony"/>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Landmark <span style="color:var(--txt3);font-weight:400;">(optional)</span></label>
        <input class="form-input" id="f-landmark" name="landmark" type="text" placeholder="Near post office, opposite park..."/>
      </div>
      <div class="form-row">
        <div class="form-group" style="margin-bottom:0">
          <label class="form-label">City</label>
          <input class="form-input" id="f-city" name="city" type="text" placeholder="City"/>
        </div>
        <div class="form-group" style="margin-bottom:0">
          <label class="form-label">State</label>
          <input class="form-input" id="f-state" name="state" type="text" placeholder="State"/>
        </div>
      </div>
      <div class="form-row" style="margin-top:16px;">
        <div class="form-group" style="margin-bottom:0">
          <label class="form-label">Pincode</label>
          <input class="form-input" id="f-pincode" name="pincode" type="text" placeholder="6-digit pincode" maxlength="6"/>
        </div>
        <div class="form-group" style="margin-bottom:0">
          <label class="form-label">Country</label>
          <input class="form-input" id="f-country" name="country" type="text" placeholder="Country" value="India"/>
        </div>
      </div>
      <div style="margin-top:16px;">
        <label class="form-check">
          <input type="checkbox" id="f-default" name="isDefault"/>
          <span class="form-check-label"><strong>Set as default address</strong> — used for all deliveries unless changed</span>
        </label>
      </div>
      <div class="modal-footer">
        <button class="btn-cancel" onclick="closeModal('formModal')">Cancel</button>
        <button class="btn-save" onclick="saveAddress()">Save Address</button>
      </div>
    </div>
  </div>
</div>

<!-- ── DELETE CONFIRM MODAL ── -->
<div class="modal-overlay" id="deleteModal">
  <div class="modal delete-modal">
    <div class="modal-body" style="padding: 36px 32px;">
      <div class="delete-content">
        <div class="delete-icon-wrap">
          <span class="material-symbols-outlined">delete_forever</span>
        </div>
        <h3>Remove this address?</h3>
        <p>This action cannot be undone. The address will be permanently removed from your account.</p>
        <div class="modal-footer" style="justify-content:center; margin-top:26px;">
          <button class="btn-cancel" onclick="closeModal('deleteModal')">Cancel</button>
          <button class="btn-delete-confirm" onclick="confirmDelete()">Yes, Remove</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Toast -->
<div class="toast" id="toast">
  <span class="material-symbols-outlined">check_circle</span>
  <span id="toastMsg">Address saved successfully.</span>
</div>

<script>
  let editingId = null, deletingId = null;

  const ALL_FIELDS = ['f-name','f-phone','f-house','f-street','f-landmark','f-city','f-state','f-pincode','f-country'];

  function openAddModal() {
    editingId = null;
    document.getElementById('modalTitle').innerHTML = 'Add <em>Address</em>';
    ALL_FIELDS.forEach(id => document.getElementById(id).value = '');
    document.getElementById('f-country').value = 'India'; // default
    document.getElementById('f-default').checked = false;
    openModal('formModal');
  }

  function openEditModal(id) {
    editingId = id;
    document.getElementById('modalTitle').innerHTML = 'Edit <em>Address</em>';
    // Sample data matching schema fields
    const data = {
      1: { fullName:'Eleanor Voss', phoneNumber:'+91 98765 43210', houseNumber:'No. 14', streetName:'MG Road', landmark:'Near Central Park', city:'Thrissur', state:'Kerala', pincode:'680001', country:'India', isDefault:true },
      2: { fullName:'Eleanor Voss', phoneNumber:'+91 91234 56789', houseNumber:'Flat 6B, Palm Residency', streetName:'Near Lulu Mall', landmark:'', city:'Kochi', state:'Kerala', pincode:'682021', country:'India', isDefault:false },
      3: { fullName:'Voss Interiors Pvt. Ltd.', phoneNumber:'+91 80123 45678', houseNumber:'Shop 12', streetName:'Brigade Road', landmark:'Opposite Metro Station', city:'Bengaluru', state:'Karnataka', pincode:'560001', country:'India', isDefault:false },
    };
    const d = data[id];
    if (d) {
      document.getElementById('f-name').value     = d.fullName;
      document.getElementById('f-phone').value    = d.phoneNumber;
      document.getElementById('f-house').value    = d.houseNumber;
      document.getElementById('f-street').value   = d.streetName;
      document.getElementById('f-landmark').value = d.landmark;
      document.getElementById('f-city').value     = d.city;
      document.getElementById('f-state').value    = d.state;
      document.getElementById('f-pincode').value  = d.pincode;
      document.getElementById('f-country').value  = d.country;
      document.getElementById('f-default').checked = d.isDefault;
    }
    openModal('formModal');
  }

  function openDeleteModal(id) {
    deletingId = id;
    openModal('deleteModal');
  }

  function openModal(id) { document.getElementById(id).classList.add('open'); document.body.style.overflow = 'hidden'; }
  function closeModal(id) { document.getElementById(id).classList.remove('open'); document.body.style.overflow = ''; }

  function saveAddress() {
    // Validate required schema fields
    const required = [
      { id: 'f-name',    label: 'Full Name' },
      { id: 'f-phone',   label: 'Phone Number' },
      { id: 'f-house',   label: 'House / Flat No.' },
      { id: 'f-street',  label: 'Street Name' },
      { id: 'f-city',    label: 'City' },
      { id: 'f-state',   label: 'State' },
      { id: 'f-pincode', label: 'Pincode' },
      { id: 'f-country', label: 'Country' },
    ];
    for (const f of required) {
      const el = document.getElementById(f.id);
      if (!el.value.trim()) {
        el.style.borderColor = 'rgba(239,68,68,.55)';
        el.focus();
        el.addEventListener('input', () => el.style.borderColor = '', { once: true });
        showToast(`${f.label} is required.`, true);
        return;
      }
    }
    const pincode = document.getElementById('f-pincode').value.trim();
    if (!/^\d{6}$/.test(pincode)) {
      const el = document.getElementById('f-pincode');
      el.style.borderColor = 'rgba(239,68,68,.55)';
      el.focus();
      el.addEventListener('input', () => el.style.borderColor = '', { once: true });
      showToast('Pincode must be 6 digits.', true);
      return;
    }
    closeModal('formModal');
    showToast(editingId ? 'Address updated successfully.' : 'New address added successfully.');
  }

  function confirmDelete() {
    const card = document.querySelector(`.addr-card[data-id="${deletingId}"]`);
    if (card) { card.style.transition = 'opacity .3s, transform .3s'; card.style.opacity = '0'; card.style.transform = 'scale(.95)'; setTimeout(() => card.remove(), 300); }
    closeModal('deleteModal');
    showToast('Address removed.');
  }

  function setDefault(id) {
    document.querySelectorAll('.addr-card').forEach(c => {
      c.classList.remove('is-default');
      const badge = c.querySelector('.default-badge');
      if (badge) badge.remove();
      const setBtn = c.querySelector('.action-btn.set-default');
      if (!setBtn && c.dataset.id != id) {
        const actions = c.querySelector('.addr-card-actions');
        const btn = document.createElement('button');
        btn.className = 'action-btn set-default';
        btn.innerHTML = '<span class="material-symbols-outlined">star</span>Set Default';
        btn.onclick = () => setDefault(c.dataset.id);
        actions.appendChild(btn);
      }
    });
    const target = document.querySelector(`.addr-card[data-id="${id}"]`);
    if (target) {
      target.classList.add('is-default');
      const info = target.querySelector('.addr-card-info');
      const badge = document.createElement('div');
      badge.className = 'default-badge';
      badge.innerHTML = '<span class="material-symbols-outlined">check_circle</span>Default';
      info.appendChild(badge);
      const setBtn = target.querySelector('.action-btn.set-default');
      if (setBtn) setBtn.remove();
    }
    showToast('Default address updated.');
  }

  function showToast(msg, isError) {
    const t = document.getElementById('toast');
    const ico = t.querySelector('.material-symbols-outlined');
    document.getElementById('toastMsg').textContent = msg;
    if (isError) { ico.textContent = 'error'; ico.style.color = '#f87171'; }
    else { ico.textContent = 'check_circle'; ico.style.color = 'var(--green)'; }
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 3200);
  }

  // Close modal on overlay click
  document.querySelectorAll('.modal-overlay').forEach(o => o.addEventListener('click', e => { if (e.target === o) closeModal(o.id); }));
</script>
</body>
</html>