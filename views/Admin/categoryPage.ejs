<!DOCTYPE html>
<html class="dark" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>LUXE Admin - Categories</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap"
    rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    rel="stylesheet" />
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "secondary-container": "#313aa1", "on-primary-fixed-variant": "#00266e", "tertiary-dim": "#ef8fe5", "surface-container-highest": "#192540", "on-surface-variant": "#a3aac4", "on-tertiary-fixed-variant": "#711f6f", "outline": "#6d758c", "error-container": "#9f0519", "surface-bright": "#1f2b49", "secondary-fixed": "#cbceff", "primary-dim": "#316bf3", "background": "#060e20", "surface-variant": "#192540", "surface-container-lowest": "#000000", "primary-fixed": "#7b9cff", "surface-container-high": "#141f38", "surface-container": "#0f1930", "on-secondary-fixed-variant": "#3c45ab", "on-secondary-fixed": "#1c248e", "inverse-surface": "#faf8ff", "tertiary": "#ffb4f4", "surface-tint": "#90abff", "secondary-dim": "#8b94ff", "secondary": "#8b94ff", "on-primary-container": "#001e5a", "surface": "#060e20", "primary-fixed-dim": "#658eff", "on-tertiary": "#722070", "on-secondary-container": "#caccff", "on-primary-fixed": "#000000", "error-dim": "#d7383b", "error": "#ff716c", "tertiary-fixed-dim": "#ef8fe5", "on-surface": "#dee5ff", "surface-container-low": "#091328", "on-error-container": "#ffa8a3", "surface-dim": "#060e20", "on-secondary": "#000478", "on-error": "#490006", "outline-variant": "#40485d", "on-primary": "#002873", "primary": "#90abff", "on-tertiary-container": "#661466", "secondary-fixed-dim": "#bbbfff", "primary-container": "#7b9cff", "tertiary-fixed": "#fe9cf4", "on-background": "#dee5ff", "tertiary-container": "#fe9cf4", "on-tertiary-fixed": "#480049", "inverse-primary": "#0053dc", "inverse-on-surface": "#4d556b"
          },
          fontFamily: { "headline": ["Manrope"], "body": ["Inter"], "label": ["Inter"] },
          borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
        },
      },
    }
  </script>
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }

    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    ::-webkit-scrollbar {
      width: 6px;
    }

    ::-webkit-scrollbar-track {
      background: #060e20;
    }

    ::-webkit-scrollbar-thumb {
      background: #1f2b49;
      border-radius: 10px;
    }

    .glass-effect {
      background: rgba(25, 37, 64, 0.7);
      backdrop-filter: blur(20px);
    }

    .luxe-gradient {
      background: linear-gradient(135deg, #316bf3 0%, #90abff 100%);
    }
  </style>
  <link rel="stylesheet" href="/css/navigation-consistency.css" />
</head>

<body class="bg-background text-on-background font-body antialiased min-h-screen">

  <!-- Sidebar -->
  <aside class="h-screen w-64 fixed left-0 top-0 bg-[#091328] dark:bg-slate-950 flex flex-col py-8 px-4 z-50">

    <div class="mb-10 px-4">
      <h1 class="font-['Manrope'] font-extrabold text-xl tracking-tighter text-white">LUXE Admin</h1>
      <p class="text-on-surface-variant text-[10px] uppercase tracking-widest mt-1">Premium Command</p>
    </div>

    <nav class="flex-1 space-y-1">
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/dashboard">
        <span class="material-symbols-outlined text-lg">dashboard</span>Dashboard
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/order-management">
        <span class="material-symbols-outlined text-lg">shopping_cart</span>Orders
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/products">
        <span class="material-symbols-outlined text-lg">inventory_2</span>Products
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/users">
        <span class="material-symbols-outlined text-lg">group</span>Users
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/analystic">
        <span class="material-symbols-outlined text-lg">monitoring</span>Analytics
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/coupons">
        <span class="material-symbols-outlined text-lg">confirmation_number</span>Coupons
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-white border-l-4 border-[#90abff] bg-[#1f2b49] font-bold text-sm"
        href="/admin/category">
        <span class="material-symbols-outlined text-lg">category</span>Categories
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/offer">
        <span class="material-symbols-outlined text-lg">local_offer</span>Offers
      </a>
    </nav>

    <div class="mt-auto px-4 pt-6 border-t border-[#1f2a44]">
      <form action="/admin/logout" method="POST">
        <button type="submit"
          class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-['Inter'] font-bold text-sm tracking-tight">
          <span class="material-symbols-outlined text-lg">logout</span>
          Logout
        </button>
      </form>
    </div>

  </aside>

  <!-- Main Content -->
  <main class="ml-64 min-h-screen relative">

    <!-- Top Nav -->
    <header
      class="fixed top-0 right-0 w-[calc(100%-16rem)] h-16 bg-[#060e20]/70 backdrop-blur-xl shadow-2xl shadow-blue-900/10 flex items-center justify-between px-8 z-40">
      <div class="flex items-center gap-6">
        <h2 class="font-['Manrope'] font-semibold text-lg text-[#90abff]">Categories</h2>
      </div>

      <div class="flex items-center gap-4">
        <button class="p-2 text-on-surface-variant hover:text-white transition-colors">
          <span class="material-symbols-outlined">notifications</span>
        </button>
        <button class="p-2 text-on-surface-variant hover:text-white transition-colors">
          <span class="material-symbols-outlined">settings</span>
        </button>
        <div class="h-8 w-px bg-outline-variant/20 mx-2"></div>
        <div class="w-9 h-9 rounded-full luxe-gradient flex items-center justify-center text-white text-xs font-bold">
          A
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <div class="pt-24 px-8 pb-12">

      <% if (error) { %>
        <script>
          Swal.fire({ toast: true, icon: 'error', title: '<%= error %>', position: 'top-right', showConfirmButton: false, timer: 3000 });
        </script>
      <% } %>

      <section class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
          <h2 class="font-['Manrope'] font-extrabold text-2xl text-white">Categories</h2>
          <p class="text-on-surface-variant text-sm mt-1">Manage product categories, offers and visibility.</p>
        </div>
        <a href="/admin/addCategory"
          class="luxe-gradient text-white px-5 py-2.5 rounded-xl font-bold flex items-center gap-2 hover:scale-[1.02] active:scale-[0.98] transition-all shadow-lg shadow-primary-dim/30 whitespace-nowrap">
          <span class="material-symbols-outlined text-[18px]">add_circle</span>
          <span class="text-sm tracking-wide">Add Category</span>
        </a>
      </section>

      <!-- Filter Bar -->
      <div class="bg-surface-container-high rounded-2xl shadow-2xl p-5 mb-6">
        <form method="GET" action="/admin/category" class="flex flex-wrap items-center gap-3">

          <div class="relative flex-1 min-w-[220px] group">
            <span
              class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-xl transition-colors group-focus-within:text-primary">search</span>
            <input name="search" type="text" value="<%= search %>" placeholder="Search categories..."
              class="w-full bg-surface-container-low/60 border border-outline-variant/20 focus:border-primary/50 focus:ring-4 focus:ring-primary/10 text-sm py-2.5 pl-10 pr-4 text-white placeholder-on-surface-variant rounded-xl transition-all outline-none" />
          </div>

          <select name="status"
            class="bg-surface-container-low border border-outline-variant/20 text-on-surface-variant text-sm py-2.5 px-3 rounded-xl outline-none focus:border-primary/50 transition-all cursor-pointer">
            <option value="" <%- status === "" ? "selected" : "" %>>All Status</option>
            <option value="true" <%- status === "true" ? "selected" : "" %>>Active</option>
            <option value="false" <%- status === "false" ? "selected" : "" %>>Inactive</option>
          </select>

          <select name="sort"
            class="bg-surface-container-low border border-outline-variant/20 text-on-surface-variant text-sm py-2.5 px-3 rounded-xl outline-none focus:border-primary/50 transition-all cursor-pointer">
            <option value="latest" <%- sort === "latest" ? "selected" : "" %>>Latest</option>
            <option value="oldest" <%- sort === "oldest" ? "selected" : "" %>>Oldest</option>
          </select>

          <input type="hidden" name="page" value="1" />

          <button type="submit"
            class="bg-surface-container-low border border-outline-variant/20 hover:bg-surface-bright text-white px-4 py-2.5 rounded-xl font-semibold text-sm transition-all flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px] text-primary">filter_alt</span>
            Apply
          </button>

          <a href="/admin/category"
            class="bg-error/10 hover:bg-error/20 border border-error/30 text-error px-4 py-2.5 rounded-xl font-semibold flex items-center gap-1.5 transition-all">
            <span class="material-symbols-outlined text-[16px]">restart_alt</span>
            <span class="text-sm">Clear</span>
          </a>
        </form>
      </div>

      <!-- Table -->
      <div class="bg-surface-container-high rounded-2xl shadow-2xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-surface-container-low/50">
                <th class="px-8 py-5 text-on-surface-variant font-bold text-[11px] uppercase tracking-[0.15em]">
                  Category Name</th>
                <th class="px-8 py-5 text-on-surface-variant font-bold text-[11px] uppercase tracking-[0.15em]">
                  Description</th>
                <th class="px-8 py-5 text-on-surface-variant font-bold text-[11px] uppercase tracking-[0.15em]">
                  Offer</th>
                <th
                  class="px-8 py-5 text-on-surface-variant font-bold text-[11px] uppercase tracking-[0.15em] text-center">
                  Status</th>
                <th
                  class="px-8 py-5 text-on-surface-variant font-bold text-[11px] uppercase tracking-[0.15em] text-right">
                  Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant/10">

              <% if (data.length === 0) { %>
                <tr>
                  <td colspan="5" class="px-8 py-16 text-center">
                    <div class="flex flex-col items-center gap-3">
                      <span class="material-symbols-outlined text-5xl text-on-surface-variant/30">category</span>
                      <p class="text-on-surface-variant font-semibold">No categories found</p>
                      <% if (search || status) { %>
                        <a href="/admin/category" class="text-primary text-sm hover:underline">Clear filters</a>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% } %>

              <% data.forEach(cat => { %>
                <tr class="hover:bg-surface-bright/40 transition-colors group" id="row-<%= cat._id %>">

                  <!-- Category Name -->
                  <td class="px-8 py-5">
                    <div class="flex items-center gap-4">
                      <div
                        class="w-9 h-9 rounded-lg bg-primary-dim/20 border border-primary/20 flex items-center justify-center text-primary font-bold font-['Manrope'] text-sm flex-shrink-0">
                        <%= cat.categoryName.charAt(0).toUpperCase() %>
                      </div>
                      <span
                        class="font-bold text-white font-['Manrope'] text-base tracking-wide <%= !cat.isActive ? 'opacity-40' : '' %>">
                        <%= cat.categoryName %>
                      </span>
                    </div>
                  </td>

                  <!-- Description -->
                  <td class="px-8 py-5 text-on-surface-variant text-sm max-w-xs">
                    <p class="truncate"><%= cat.description %></p>
                  </td>

                  <!-- Offer Dropdown -->
                  <td class="px-8 py-5">
                    <% if (offers && offers.length > 0) { %>
                      <select onchange="updateCategoryOffer('<%= cat._id %>', this)"
                        class="bg-surface-container-low border border-outline-variant/20 text-on-surface text-xs py-1.5 px-2.5 rounded-xl outline-none focus:border-primary/50 transition-all cursor-pointer w-48">
                        <option value="">No Offer</option>
                        <% offers.forEach(function(offer) { %>
                          <% const isSelected = cat.offer && cat.offer._id.toString() === offer._id.toString();
                             const dispVal = offer.discountType === 'PERCENTAGE'
                               ? `${offer.discountValue}% OFF`
                               : `₹${offer.discountValue} FLAT`; %>
                          <option value="<%= offer._id %>" <%= isSelected ? 'selected' : '' %>>
                            <%= offer.name %> (<%= dispVal %>)
                          </option>
                        <% }) %>
                      </select>
                    <% } else { %>
                      <span class="text-xs text-on-surface-variant italic">No offers available</span>
                    <% } %>
                  </td>

                  <!-- Status Badge -->
                  <td class="px-8 py-5 text-center">
                    <% if (cat.isActive) { %>
                      <span
                        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md text-[10px] font-bold uppercase tracking-widest bg-primary/10 text-primary border border-primary/20">
                        <span class="w-1.5 h-1.5 rounded-full bg-primary inline-block"></span>
                        Active
                      </span>
                    <% } else { %>
                      <span
                        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md text-[10px] font-bold uppercase tracking-widest bg-outline-variant/20 text-on-surface-variant border border-outline-variant/30">
                        <span class="w-1.5 h-1.5 rounded-full bg-on-surface-variant inline-block"></span>
                        Inactive
                      </span>
                    <% } %>
                  </td>

                  <!-- Actions -->
                  <td class="px-8 py-5">
                    <div class="flex items-center justify-end gap-2">
                      <a href="/admin/editCategory/<%= cat._id %>">
                        <button
                          class="p-2.5 rounded-xl bg-surface-container-low border border-outline-variant/20 hover:bg-primary-dim/20 hover:border-primary/30 text-on-surface-variant hover:text-primary transition-all">
                          <span class="material-symbols-outlined text-[18px]">edit</span>
                        </button>
                      </a>
                    </div>
                  </td>

                </tr>
              <% }) %>

            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <div class="px-8 py-5 bg-surface-container-low/30 flex items-center justify-between">
          <p class="text-on-surface-variant text-xs font-semibold tracking-wide">
            Showing
            <span class="text-white font-bold"><%= totalCount === 0 ? 0 : (currentPage - 1) * 4 + 1 %></span>
            –
            <span class="text-white font-bold"><%= Math.min(currentPage * 4, totalCount) %></span>
            of
            <span class="text-white font-bold"><%= totalCount %></span>
            categories
          </p>

          <div class="flex items-center gap-1.5">

            <% if (currentPage > 1) { %>
              <a href="?page=<%= currentPage - 1 %>&status=<%= status %>&search=<%= search %>&sort=<%= sort %>">
                <button
                  class="w-9 h-9 flex items-center justify-center rounded-lg border border-outline-variant/20 bg-surface-container hover:bg-surface-bright text-on-surface-variant hover:text-white transition-all">
                  <span class="material-symbols-outlined text-sm">chevron_left</span>
                </button>
              </a>
            <% } else { %>
              <button disabled
                class="w-9 h-9 flex items-center justify-center rounded-lg border border-outline-variant/20 bg-surface-container text-on-surface-variant opacity-30 cursor-not-allowed">
                <span class="material-symbols-outlined text-sm">chevron_left</span>
              </button>
            <% } %>

            <div class="flex items-center gap-1">
              <% for (let i = 1; i <= totalPage; i++) { %>
                <a href="?page=<%= i %>&status=<%= status %>&search=<%= search %>&sort=<%= sort %>">
                  <button
                    class="w-9 h-9 flex items-center justify-center rounded-lg font-bold text-xs transition-all
                      <%= i === currentPage
                        ? 'luxe-gradient text-white shadow-lg shadow-primary-dim/20'
                        : 'border border-transparent hover:border-outline-variant/20 hover:bg-surface-container text-on-surface-variant hover:text-white' %>">
                    <%= i %>
                  </button>
                </a>
              <% } %>
            </div>

            <% if (currentPage < totalPage) { %>
              <a href="?page=<%= currentPage + 1 %>&status=<%= status %>&search=<%= search %>&sort=<%= sort %>">
                <button
                  class="w-9 h-9 flex items-center justify-center rounded-lg border border-outline-variant/20 bg-surface-container hover:bg-surface-bright text-on-surface-variant hover:text-white transition-all">
                  <span class="material-symbols-outlined text-sm">chevron_right</span>
                </button>
              </a>
            <% } else { %>
              <button disabled
                class="w-9 h-9 flex items-center justify-center rounded-lg border border-outline-variant/20 bg-surface-container text-on-surface-variant opacity-30 cursor-not-allowed">
                <span class="material-symbols-outlined text-sm">chevron_right</span>
              </button>
            <% } %>

          </div>
        </div>
      </div>

    </div>
  </main>

  <script>
    async function updateCategoryOffer(categoryId, selectEl) {
      const offerId = selectEl.value;

      try {
        const res = await fetch("/admin/category-offer-add", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ categoryId, offerId })
        });

        const result = await res.json();
        if (!result.success) {
          Swal.fire({
            toast: true, icon: 'error',
            title: result.message || 'Failed to update category offer',
            position: 'top-right', showConfirmButton: false, timer: 3000
          });
          return;
        }

        Swal.fire({
          toast: true, icon: 'success',
          title: offerId ? 'Offer applied successfully' : 'Offer removed successfully',
          position: 'top-right', showConfirmButton: false, timer: 2000
        });

      } catch (error) {
        console.error(error);
        Swal.fire({
          toast: true, icon: 'error',
          title: 'Server connection error',
          position: 'top-right', showConfirmButton: false, timer: 3000
        });
      }
    }
  </script>
</body>

</html>
