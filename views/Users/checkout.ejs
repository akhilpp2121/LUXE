<body class="font-body-md text-on-background">
<!-- Top Navigation Shell -->
<header class="bg-background/80 backdrop-blur-md text-primary font-headline-md text-headline-md docked full-width top-0 sticky z-50 border-b border-outline-variant/30 flat no shadows flex justify-between items-center px-margin-desktop py-base w-full">
