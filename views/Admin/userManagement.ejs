<!DOCTYPE html>
<html class="dark" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>LUXE User Management</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap"
    rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    rel="stylesheet" />
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "secondary-container": "#313aa1", "on-primary-fixed-variant": "#00266e", "tertiary-dim": "#ef8fe5", "surface-container-highest": "#192540", "on-surface-variant": "#a3aac4", "on-tertiary-fixed-variant": "#711f6f", "outline": "#6d758c", "error-container": "#9f0519", "surface-bright": "#1f2b49", "secondary-fixed": "#cbceff", "primary-dim": "#316bf3", "background": "#060e20", "surface-variant": "#192540", "surface-container-lowest": "#000000", "primary-fixed": "#7b9cff", "surface-container-high": "#141f38", "surface-container": "#0f1930", "on-secondary-fixed-variant": "#3c45ab", "on-secondary-fixed": "#1c248e", "inverse-surface": "#faf8ff", "tertiary": "#ffb4f4", "surface-tint": "#90abff", "secondary-dim": "#8b94ff", "secondary": "#8b94ff", "on-primary-container": "#001e5a", "surface": "#060e20", "primary-fixed-dim": "#658eff", "on-tertiary": "#722070", "on-secondary-container": "#caccff", "on-primary-fixed": "#000000", "error-dim": "#d7383b", "error": "#ff716c", "tertiary-fixed-dim": "#ef8fe5", "on-surface": "#dee5ff", "surface-container-low": "#091328", "on-error-container": "#ffa8a3", "surface-dim": "#060e20", "on-secondary": "#000478", "on-error": "#490006", "outline-variant": "#40485d", "on-primary": "#002873", "primary": "#90abff", "on-tertiary-container": "#661466", "secondary-fixed-dim": "#bbbfff", "primary-container": "#7b9cff", "tertiary-fixed": "#fe9cf4", "on-background": "#dee5ff", "tertiary-container": "#fe9cf4", "on-tertiary-fixed": "#480049", "inverse-primary": "#0053dc", "inverse-on-surface": "#4d556b"
          },
          fontFamily: { "headline": ["Manrope"], "body": ["Inter"], "label": ["Inter"] },
          borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
        },
      },
    }
  </script>
  <style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    ::-webkit-scrollbar {
      width: 6px;
    }

    ::-webkit-scrollbar-track {
      background: #060e20;
    }

    ::-webkit-scrollbar-thumb {
      background: #1f2b49;
      border-radius: 10px;
    }

    .glass-effect {
      background: rgba(25, 37, 64, 0.7);
      backdrop-filter: blur(20px);
    }

    .luxe-gradient {
      background: linear-gradient(135deg, #316bf3 0%, #90abff 100%);
    }

    .search-btn {
      transition: all 0.15s ease;
    }

    .search-btn:active {
      transform: scale(0.93);
    }

    /* ── Toast ── */
    .toast {
      position: fixed;
      bottom: 28px;
      right: 28px;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 20px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 600;
      font-family: 'Inter', sans-serif;
      z-index: 9999;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
      animation: slideUp 0.25s ease;
    }

    @keyframes slideUp {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .toast.success {
      background: rgba(52, 211, 153, 0.1);
      border: 1px solid rgba(52, 211, 153, 0.3);
      color: #34d399;
    }

    .toast.warning {
      background: rgba(251, 191, 36, 0.1);
      border: 1px solid rgba(251, 191, 36, 0.35);
      color: #fbbf24;
    }

    .toast.error {
      background: rgba(248, 113, 113, 0.1);
      border: 1px solid rgba(248, 113, 113, 0.3);
      color: #f87171;
    }

    .toast-icon {
      font-size: 14px;
      font-weight: 700;
      width: 20px;
      height: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      flex-shrink: 0;
      background: rgba(255, 255, 255, 0.06);
    }
  </style>
  <link rel="stylesheet" href="/css/navigation-consistency.css" />
</head>

<body class="bg-background text-on-background font-body antialiased min-h-screen">

  <!-- Sidebar -->
  <aside class="h-screen w-64 fixed left-0 top-0 bg-[#091328] dark:bg-slate-950 flex flex-col py-8 px-4 z-50">

    <div class="mb-10 px-4">
      <h1 class="font-['Manrope'] font-extrabold text-xl tracking-tighter text-white">LUXE Admin</h1>
      <p class="text-on-surface-variant text-[10px] uppercase tracking-widest mt-1">Premium Command</p>
    </div>

    <nav class="flex-1 space-y-1">
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/dashboard">
        <span class="material-symbols-outlined text-lg">dashboard</span>Dashboard
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/order-management">
        <span class="material-symbols-outlined text-lg">shopping_cart</span>Orders
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/products">
        <span class="material-symbols-outlined text-lg">inventory_2</span>Products
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-white border-l-4 border-[#90abff] bg-[#1f2b49] font-bold text-sm"
        href="/admin/users">
        <span class="material-symbols-outlined text-lg">group</span>Users
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/analystic">
        <span class="material-symbols-outlined text-lg">monitoring</span>Analytics
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/coupons">
        <span class="material-symbols-outlined text-lg">confirmation_number</span>Coupons
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/category">
        <span class="material-symbols-outlined text-lg">category</span>Categories
      </a>
      <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-bold text-sm"
        href="/admin/offer">
        <span class="material-symbols-outlined text-lg">local_offer</span>Offers
      </a>
     
    </nav>

    <div class="mt-auto px-4 pt-6 border-t border-[#1f2a44]">
      <form action="/admin/logout" method="POST">
        <button type="submit"
          class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-[#a3aac4] hover:text-white hover:bg-[#141f38] transition-colors font-['Inter'] font-bold text-sm tracking-tight">
          <span class="material-symbols-outlined text-lg">logout</span>
          Logout
        </button>
      </form>
    </div>

  </aside>

  <!-- Main Content -->
  <main class="ml-64 min-h-screen relative">

    <!-- Top Nav -->
    <header
      class="fixed top-0 right-0 w-[calc(100%-16rem)] h-16 bg-[#060e20]/70 backdrop-blur-xl shadow-2xl shadow-blue-900/10 flex items-center justify-between px-8 z-40">
      <div class="flex items-center gap-6">
        <h2 class="font-['Manrope'] font-semibold text-lg text-[#90abff]">Users</h2>

        <form action="/admin/users" method="GET" class="flex items-center gap-0">
          <input type="hidden" name="status" value="<%= status || '' %>" />
          <input type="hidden" name="sort" value="<%= sort || 'latest' %>" />
          <input type="hidden" name="page" value="1" />
          <div class="relative flex items-center">
            <span
              class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-sm pointer-events-none">search</span>
            <input name="search"
              class="w-80 bg-surface-container-lowest border-b-2 border-transparent focus:border-primary py-2 pl-10 pr-3 text-sm text-on-surface transition-all outline-none rounded-l-sm"
              placeholder="Search by name or email..." type="text" value="<%= search || '' %>" />
          </div>
          <button type="submit"
            class="search-btn flex items-center justify-center gap-1.5 h-[38px] px-4 bg-primary/15 border-b-2 border-transparent hover:bg-primary/25 hover:border-primary text-primary font-['Inter'] font-bold text-xs transition-colors rounded-r-sm"
            style="border-left: 1px solid rgba(64,72,93,0.4);">
            <span class="material-symbols-outlined text-sm">travel_explore</span>
            Search
          </button>
        </form>

        <% if (search) { %>
          <a href="/admin/users?status=<%= status || '' %>&sort=<%= sort || 'latest' %>&page=1"
            class="search-btn flex items-center justify-center gap-1.5 h-[38px] px-3 bg-error/10 border border-error/20 hover:bg-error/20 hover:border-error/40 text-error font-['Inter'] font-bold text-xs rounded-sm">
            <span class="material-symbols-outlined text-sm">close</span>
            Reset
          </a>
          <% } %>
      </div>

      <div class="flex items-center gap-4">
        <button class="p-2 text-on-surface-variant hover:text-white transition-colors">
          <span class="material-symbols-outlined">notifications</span>
        </button>
        <button class="p-2 text-on-surface-variant hover:text-white transition-colors">
          <span class="material-symbols-outlined">settings</span>
        </button>
        <div class="h-8 w-px bg-outline-variant/20 mx-2"></div>
        <div class="w-9 h-9 rounded-full luxe-gradient flex items-center justify-center text-white text-xs font-bold">
          A
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <div class="pt-24 px-8 pb-12">

      <% if (error) { %>
        <div
          class="mb-6 px-4 py-3 rounded-lg bg-error/10 border border-error/20 text-error text-sm font-medium flex items-center gap-2">
          <span class="material-symbols-outlined text-base">error</span>
          <%= error %>
        </div>
        <% } %>

          <!-- Stats -->
          <div class="grid grid-cols-4 gap-4 mb-8">
            <div class="bg-surface-container-high rounded-2xl p-5 shadow-xl">
              <p class="text-[10px] uppercase tracking-widest font-bold text-on-surface-variant">Total Users</p>
              <p class="text-2xl font-extrabold text-primary mt-1.5">
                <%= totalUser %>
              </p>
            </div>
            <div class="bg-surface-container-high rounded-2xl p-5 shadow-xl">
              <p class="text-[10px] uppercase tracking-widest font-bold text-on-surface-variant">Current Page</p>
              <p class="text-2xl font-extrabold text-on-surface mt-1.5">
                <%= currentPage %> / <%= totalPage %>
              </p>
            </div>
            <div class="bg-surface-container-high rounded-2xl p-5 shadow-xl">
              <p class="text-[10px] uppercase tracking-widest font-bold text-on-surface-variant">Filter</p>
              <p class="text-base font-extrabold text-on-surface mt-2 capitalize">
                <%= status==='true' ? 'Active' : status==='false' ? 'Blocked' : 'All' %>
              </p>
            </div>
            <div class="bg-surface-container-high rounded-2xl p-5 shadow-xl">
              <p class="text-[10px] uppercase tracking-widest font-bold text-on-surface-variant">Sorted</p>
              <p class="text-base font-extrabold text-on-surface mt-2 capitalize">
                <%= sort==='oldest' ? 'Oldest First' : 'Newest First' %>
              </p>
            </div>
          </div>

          <!-- Filter Controls -->
          <form action="/admin/users" method="GET" class="flex items-center justify-between mb-8 flex-wrap gap-3">
            <input type="hidden" name="search" value="<%= search || '' %>" />
            <input type="hidden" name="page" value="1" />
            <div class="flex items-center gap-3 flex-wrap">
              <div
                class="bg-surface-container-high rounded-lg px-4 py-2 flex items-center gap-3 border border-outline-variant/5">
                <span class="material-symbols-outlined text-on-surface-variant text-sm">filter_alt</span>
                <select name="status" onchange="this.form.submit()"
                  class="text-xs font-bold text-on-surface bg-transparent outline-none cursor-pointer">
                  <option value="" class="bg-surface-container-high" <%=(!status || status==='undefined') ? 'selected' : '' %>>All Status</option>
                  <option value="true" class="bg-surface-container-high" <%=status==='true' ? 'selected' : '' %>>Active</option>
                  <option value="false" class="bg-surface-container-high" <%=status==='false' ? 'selected' : '' %>>Blocked</option>
                </select>
                <span class="material-symbols-outlined text-xs text-on-surface-variant">expand_more</span>
              </div>

              <div
                class="bg-surface-container-high rounded-lg px-4 py-2 flex items-center gap-3 border border-outline-variant/5">
                <span class="material-symbols-outlined text-on-surface-variant text-sm">sort</span>
                <select name="sort" onchange="this.form.submit()"
                  class="text-xs font-bold text-on-surface bg-transparent outline-none cursor-pointer">
                  <option value="latest" class="bg-surface-container-high" <%=sort==='latest' ? 'selected' : '' %>>🕐 Latest</option>
                  <option value="oldest" class="bg-surface-container-high" <%=sort==='oldest' ? 'selected' : '' %>>⏰ Oldest</option>
                </select>
                <span class="material-symbols-outlined text-xs text-on-surface-variant">expand_more</span>
              </div>

              <a href="/admin/users"
                class="search-btn flex items-center justify-center gap-1.5 h-[38px] px-3 bg-surface-container-high border border-outline-variant/10 hover:border-primary/40 text-on-surface-variant hover:text-primary font-['Inter'] font-bold text-xs rounded-sm">
                <span class="material-symbols-outlined text-sm">restart_alt</span>
                Clear
              </a>
            </div>

            <div class="text-on-surface-variant text-xs font-medium">
              Total <span class="text-on-surface font-bold">
                <%= totalUser %>
              </span> users
            </div>
          </form>

          <!-- Users Table -->
          <div class="bg-surface-container-high rounded-2xl overflow-hidden shadow-2xl">
            <table class="w-full border-collapse">
              <thead>
                <tr class="bg-surface-container-low/50">
                  <th
                    class="px-6 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">
                    #</th>
                  <th
                    class="px-6 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">
                    User</th>
                  <th
                    class="px-6 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">
                    Email</th>
                  <th
                    class="px-6 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">
                    Phone</th>
                  <th
                    class="px-6 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">
                    Status</th>
                  <th
                    class="px-6 py-5 text-left text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">
                    Joined</th>
                  <th
                    class="px-6 py-5 text-right text-[10px] uppercase font-bold tracking-[0.2em] text-on-surface-variant">
                    Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-outline-variant/10">

                <% if (data && data.length> 0) { %>
                  <% data.forEach(function(user, i) { %>

                    <tr class="group hover:bg-surface-bright/50 transition-colors">

                      <td class="px-6 py-4 text-on-surface-variant text-xs font-mono">
                        <%= ((currentPage - 1) * 5) + i + 1 %>
                      </td>

                      <!-- User + Avatar -->
                      <td class="px-6 py-4">
                        <div class="flex items-center gap-4">
                          <div
                            class="w-10 h-10 rounded-full overflow-hidden flex-shrink-0 luxe-gradient flex items-center justify-center text-white text-xs font-bold">
                            <% if (user.avatar && user.avatar.trim() !=='' ) { %>
                              <img src="<%= user.avatar %>" alt="<%= user.fullName %>"
                                class="w-10 h-10 object-cover rounded-full"
                                onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                              <span style="display:none;">
                                <%= user.fullName ? user.fullName.charAt(0).toUpperCase() : '?' %>
                              </span>
                              <% } else { %>
                                <span>
                                  <%= user.fullName ? user.fullName.charAt(0).toUpperCase() : '?' %>
                                </span>
                                <% } %>
                          </div>
                          <div>
                            <p class="text-sm font-bold text-white leading-snug">
                              <%= user.fullName || '—' %>
                            </p>
                            <p class="text-[10px] text-on-surface-variant font-mono">
                              <%= user._id %>
                            </p>
                          </div>
                        </div>
                      </td>

                      <!-- Email -->
                      <td class="px-6 py-4 text-on-surface-variant text-xs">
                        <%= user.email %>
                      </td>

                      <!-- Phone -->
                      <td class="px-6 py-4 text-on-surface-variant text-xs">
                        <%= user.phoneNumber || '—' %>
                      </td>

                      <!-- Status -->
                      <td class="px-6 py-4">
                        <% if (user.isActive) { %>
                          <span
                            class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded bg-emerald-500/10 text-emerald-400">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block"></span>
                            Active
                          </span>
                          <% } else { %>
                            <span
                              class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded bg-error/10 text-error">
                              <span class="w-1.5 h-1.5 rounded-full bg-error inline-block"></span>
                              Blocked
                            </span>
                            <% } %>
                      </td>

                      <!-- Joined -->
                      <td class="px-6 py-4 text-on-surface-variant text-xs font-mono">
                        <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—' %>
                      </td>

                      <!-- Action -->
                      <td class="px-6 py-4 text-right">
                        <form action="/admin/users/edit" method="POST" class="flex justify-end">
                          <input type="hidden" name="id" value="<%= user._id %>" />
                          <select name="isActive"
                            class="bg-surface-container-low border border-white/10 text-on-surface text-xs py-1.5 px-2.5 rounded-xl outline-none focus:border-primary/50 transition-all cursor-pointer"
                            data-current="<%= user.isActive ? 'true' : 'false' %>" onchange="openModal(this)">
                            <option value="true" <%=user.isActive ? 'selected' : '' %>>Active</option>
                            <option value="false" <%=!user.isActive ? 'selected' : '' %>>Block</option>
                          </select>
                        </form>
                      </td>

                    </tr>
                    <% }) %>
                      <% } else { %>
                        <tr>
                          <td colspan="7" class="px-8 py-16 text-center">
                            <div class="flex flex-col items-center gap-3">
                              <span class="material-symbols-outlined text-4xl text-on-surface-variant">group</span>
                              <p class="text-sm font-bold text-on-surface-variant">No users found</p>
                              <% if (search) { %>
                                <p class="text-xs text-on-surface-variant/60">No results for "<%= search %>"</p>
                                <a href="/admin/users?status=<%= status || '' %>&sort=<%= sort || 'latest' %>&page=1"
                                  class="mt-2 text-xs font-bold text-primary hover:underline">
                                  Clear search
                                </a>
                                <% } %>
                            </div>
                          </td>
                        </tr>
                        <% } %>

              </tbody>
            </table>

            <!-- Pagination -->
            <% if (totalPage> 1) { %>
              <div class="px-8 py-6 bg-surface-container-low/30 flex items-center justify-between">

                <% if (currentPage> 1) { %>
                  <a
                    href="/admin/users?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(search || '') %>&status=<%= encodeURIComponent(status || '') %>&sort=<%= encodeURIComponent(sort || '') %>">
                    <button
                      class="px-4 py-2 text-xs font-bold text-on-surface-variant hover:text-white transition-colors flex items-center gap-2">
                      <span class="material-symbols-outlined text-sm">chevron_left</span>Previous
                    </button>
                  </a>
                  <% } else { %>
                    <button disabled
                      class="px-4 py-2 text-xs font-bold text-on-surface-variant/30 flex items-center gap-2 cursor-not-allowed">
                      <span class="material-symbols-outlined text-sm">chevron_left</span>Previous
                    </button>
                    <% } %>

                      <div class="flex items-center gap-2">
                        <% for (let p=1; p <=totalPage; p++) { %>
                          <% if (p===1 || p===totalPage || (p>= currentPage - 1 && p <= currentPage + 1)) { %>
                            <a
                              href="/admin/users?page=<%= p %>&search=<%= encodeURIComponent(search || '') %>&status=<%= encodeURIComponent(status || '') %>&sort=<%= encodeURIComponent(sort || '') %>">
                              <button
                                class="w-8 h-8 rounded-lg text-xs font-bold <%= currentPage === p ? 'luxe-gradient text-white' : 'hover:bg-surface-bright text-on-surface-variant' %>">
                                <%= p %>
                              </button>
                            </a>
                            <% } else if (p===currentPage - 2 || p===currentPage + 2) { %>
                              <span class="w-8 h-8 flex items-center justify-center text-xs text-on-surface-variant">…</span>
                              <% } %>
                                <% } %>
                      </div>

                      <% if (currentPage < totalPage) { %>
                        <a
                          href="/admin/users?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(search || '') %>&status=<%= encodeURIComponent(status || '') %>&sort=<%= encodeURIComponent(sort || '') %>">
                          <button
                            class="px-4 py-2 text-xs font-bold text-on-surface-variant hover:text-white transition-colors flex items-center gap-2">
                            Next<span class="material-symbols-outlined text-sm">chevron_right</span>
                          </button>
                        </a>
                        <% } else { %>
                          <button disabled
                            class="px-4 py-2 text-xs font-bold text-on-surface-variant/30 flex items-center gap-2 cursor-not-allowed">
                            Next<span class="material-symbols-outlined text-sm">chevron_right</span>
                          </button>
                          <% } %>

              </div>
              <% } %>

          </div>

    </div>

  </main>

  <!-- Confirmation Modal -->
  <div id="modal"
    class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden items-center justify-center z-[999] p-4">
    <div class="bg-surface-container-high rounded-2xl w-full max-w-xs shadow-2xl p-6 text-center">
      <p id="modal-msg" class="text-sm text-on-surface mb-5 leading-relaxed font-medium"></p>
      <div class="flex gap-3">
        <button onclick="closeModal()"
          class="flex-1 py-2.5 rounded-xl border border-outline-variant/20 text-on-surface-variant text-xs font-bold hover:text-white hover:border-outline-variant/40 transition-colors">
          Cancel
        </button>
        <button id="modal-btn"
          class="flex-1 py-2.5 rounded-xl text-xs font-bold border transition-colors"></button>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <% if (toast) { %>
    <div id="toast" class="toast <%= toast.type %>">
      <span class="toast-icon">
        <% if (toast.type==='success' ) { %>✓
          <% } else if (toast.type==='warning' ) { %>⊘
            <% } else { %>✕
              <% } %>
      </span>
      <span>
        <%= toast.msg %>
      </span>
    </div>
    <% } %>

      <script>
        let _sel = null;

        function openModal(el) {
          _sel = el;
          const isBlock = el.value === 'false';
          document.getElementById('modal-msg').textContent =
            isBlock ? 'Block this user?' : 'Activate this user?';
          const btn = document.getElementById('modal-btn');
          btn.textContent = isBlock ? 'Block' : 'Activate';
          btn.className = 'flex-1 py-2.5 rounded-xl text-xs font-bold border transition-colors ' +
            (isBlock
              ? 'bg-error/10 border-error/40 text-error hover:bg-error/20'
              : 'bg-emerald-500/10 border-emerald-500/40 text-emerald-400 hover:bg-emerald-500/20');
          btn.onclick = () => el.closest('form').submit();
          const modal = document.getElementById('modal');
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }

        function closeModal() {
          const modal = document.getElementById('modal');
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          if (_sel) _sel.value = _sel.dataset.current; // revert dropdown
        }

        document.getElementById('modal').addEventListener('click', function (e) {
          if (e.target === this) closeModal();
        });

        // Toast auto-dismiss
        document.addEventListener('DOMContentLoaded', function () {
          const toast = document.getElementById('toast');
          if (toast) {
            const timer = setTimeout(() => {
              toast.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
              toast.style.opacity = '0';
              toast.style.transform = 'translateY(12px)';
              setTimeout(() => toast.remove(), 400);
            }, 5000);
            toast.addEventListener('click', () => { clearTimeout(timer); toast.remove(); });
          }
        });

        window.addEventListener('pageshow', function (e) {
          if (e.persisted) window.location.reload();
        });
      </script>

</body>

</html>
