        <input type="text" placeholder="Enter coupon code" class="flex-grow bg-surface-container-high border border-outline-variant/30 text-on-surface font-label-sm text-label-sm uppercase tracking-widest px-4 py-3 focus:outline-none focus:border-secondary transition-colors placeholder:text-on-surface-variant/50">
