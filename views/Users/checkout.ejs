    .coupon-card-info { flex: 1; min-width: 0; }
    .coupon-card-code {
      font-size: 13px; font-weight: 700; letter-spacing: .12em;
      color: var(--accent); display: block; margin-bottom: 3px;
      font-family: 'DM Sans', monospace;
    }
    .coupon-card.applied .coupon-card-code { color: var(--success); }
    .coupon-card-desc {
      font-size: 11px; color: var(--text-3); line-height: 1.5;
    }
    .coupon-card-save {
      font-size: 10px; color: var(--success);
      margin-top: 3px; display: block; letter-spacing: .04em;
    }

    .coupon-card-btn {
      background: transparent;
      border: 1px solid var(--border-2);
      color: var(--accent);
      font-family: 'DM Sans', sans-serif;
      font-size: 10px; letter-spacing: .14em; text-transform: uppercase;
