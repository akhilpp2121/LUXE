<div class="flex-1 h-px bg-gradient-to-r from-transparent via-primary to-transparent"></div>
<div class="text-[10px] tracking-[0.5em] text-primary uppercase">Digital Atelier Precision</div>
<div class="flex-1 h-px bg-gradient-to-r from-transparent via-primary to-transparent"></div>
</div>
