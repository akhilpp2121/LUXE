<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
        rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#1152d4",
                        "background-light": "#f6f6f8",
                        "background-dark": "#101622",
                    },
                    fontFamily: {
                        "display": ["Manrope", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
    <style>
        body {
            font-family: 'Manrope', sans-serif;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .search-wrap input {
            width: 300px;
            background: transparent;
            border: 0.5px solid rgba(255, 255, 255, 0.15);
            border-radius: 999px;
            padding: 10px 44px 10px 42px;
            font-size: 13px;
            color: #fff;
            outline: none;
            transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
        }

        .search-wrap input::placeholder {
            color: rgba(255, 255, 255, 0.35);
        }

        .search-wrap input:focus {
            border-color: #1152d4;
            background: rgba(17, 82, 212, 0.08);
            box-shadow: 0 0 0 3px rgba(17, 82, 212, 0.15);
        }

        .search-wrap .ic-search {
            position: absolute;
            left: 14px;
            font-size: 16px;
            color: rgba(255, 255, 255, 0.35);
            pointer-events: none;
            transition: color 0.2s;
        }

        .search-wrap:focus-within .ic-search {
            color: #1152d4;
        }

        .search-wrap button {
            position: absolute;
            right: 8px;
            background: #1152d4;
            border: none;
            border-radius: 999px;
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background 0.2s, transform 0.15s;
            padding: 0;
        }

        .search-wrap button:hover {
            background: #0e44b0;
            transform: scale(1.05);
        }

        @keyframes modalIn {
            from { opacity: 0; transform: scale(0.95) translateY(8px); }
            to   { opacity: 1; transform: scale(1) translateY(0); }
        }
        .animate-modal-in { animation: modalIn 0.2s cubic-bezier(0.16, 1, 0.3, 1); }

        .vm-chip {
            min-width: 44px;
            padding: 0 14px;
            height: 40px;
            border-radius: 8px;
            border: 1.5px solid #e2e8f0;
            font-size: 13px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.15s ease;
            background: white;
            color: #1e293b;
        }
        .dark .vm-chip { border-color: #334155; background: #1e293b; color: #e2e8f0; }
        .vm-chip:hover { border-color: #1152d4; }
        .vm-chip.selected { border-color: #1152d4; background: #1152d4; color: white; }
        .vm-chip.out-of-stock { opacity: 0.35; cursor: not-allowed; text-decoration: line-through; }
        .vm-chip.out-of-stock:hover { border-color: #e2e8f0; }
        .dark .vm-chip.out-of-stock:hover { border-color: #334155; }

        .vm-color-swatch {
            width: 36px; height: 36px;
            border-radius: 50%;
            border: 2px solid transparent;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: all 0.15s ease;
        }
        .vm-color-swatch.selected { border-color: #1152d4; }
        .vm-color-swatch .swatch-inner { width: 28px; height: 28px; border-radius: 50%; border: 1px solid rgba(0,0,0,0.1); }
    </style>
  <link rel="stylesheet" href="/css/navigation-consistency.css" />
</head>

<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 antialiased">

    <!-- Header -->
    <header
        class="sticky top-0 z-50 w-full border-b border-slate-200 dark:border-slate-800 bg-background-light/80 dark:bg-background-dark/80 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
            <div class="flex items-center gap-12">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-3xl">diamond</span>
                    <a href="/homePage"
                        class="text-2xl font-bold tracking-tighter text-slate-900 dark:text-white uppercase hover:text-gray-500 transition">
                        Luxe
                    </a>
                </div>
                <nav class="hidden md:flex items-center gap-8">
                    <a class="text-sm font-medium hover:text-primary transition-colors"
