<p class="">Manhattan, New York 10022</p>
<p class="">United States</p>
<p class="mt-4 opacity-60">+1 (212) 555-0198</p>
</div>
</div>
<!-- Secondary Address Card -->
<div class="p-6 border rounded-none hover:border-secondary/50 transition-all duration-300 group cursor-pointer border-secondary bg-surface-container-high">
<div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity">
<button class="text-on-surface-variant hover:text-secondary">
<span class="material-symbols-outlined" data-icon="edit">edit</span>
</button>
</div>
<p class="font-label-md text-label-md text-primary mb-2 uppercase tracking-widest">Alexander Thorne</p>
<div class="text-on-surface-variant font-body-md space-y-1">
<p class="">15 Bel Air Road</p>
<p class="">Los Angeles, California 90077</p>
<p class="">United States</p>
</div>
</div>
</div>
</section>
<section>
<h2 class="font-headline-md text-headline-md text-on-surface mb-6">Payment Method</h2>
<div class="space-y-4">
<div class="p-6 border-2 border-secondary bg-surface-container-high rounded-none flex justify-between items-center cursor-pointer">
<div class="flex items-center gap-4">
<div class="w-6 h-6 border-2 border-secondary rounded-full flex items-center justify-center p-1">
<div class="w-full h-full bg-secondary rounded-full"></div>
</div>
<div class="flex items-center gap-3">
<span class="material-symbols-outlined text-secondary" data-icon="payments">payments</span>
<div>
<p class="font-label-md text-label-md text-on-surface">Cash on Delivery</p>
<p class="font-label-sm text-label-sm text-on-surface-variant uppercase">Payment upon arrival</p>
</div>
</div>
</div>
<span class="text-secondary font-label-sm text-label-sm uppercase">Active</span>
</div>
<div class="p-6 border border-outline-variant/30 bg-surface-container-low rounded-none flex justify-between items-center opacity-50 cursor-not-allowed">
<div class="flex items-center gap-4">
<div class="w-6 h-6 border border-outline-variant/50 rounded-full"></div>
<div class="flex items-center gap-3">
<span class="material-symbols-outlined" data-icon="credit_card">credit_card</span>
<div>
<p class="font-label-md text-label-md text-on-surface">Credit / Debit Card</p>
<p class="font-label-sm text-label-sm text-on-surface-variant uppercase">Encrypted &amp; Secure</p>
</div>
</div>
</div>
</div>
</div>
</section>
</div>
<!-- Column 2: Order Summary -->
