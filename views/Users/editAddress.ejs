<!-- Main Content Canvas -->
<main class="ml-72 flex-1 p-16">
<div class="max-w-4xl mx-auto">
<header class="mb-12">
<div class="flex items-center gap-2 text-primary text-xs tracking-widest uppercase mb-4">
<span class="material-symbols-outlined text-sm">arrow_back</span>
<span>Back to Addresses</span>
</div>
<h1 class="font-headline text-4xl font-bold tracking-tight text-white">Add New Address</h1>
<p class="text-on-surface-variant mt-2 font-body">Define your shipping destination for a bespoke delivery experience.</p>
</header>
<!-- Form Section -->
<div class="bg-surface-container-low p-10 rounded-xl">
<form class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-10">
<!-- Full Name -->
<div class="col-span-full group">
<label class="block text-[10px] tracking-[0.2em] text-primary uppercase font-semibold mb-3">Full Name</label>
<input class="w-full bg-surface-container-highest border-none rounded-lg p-4 text-on-surface placeholder:text-outline-variant transition-all focus:bg-surface-bright font-body" placeholder="Julianne Moore" type="text"/>
</div>
<!-- House Number & Street -->
<div class="group">
<label class="block text-[10px] tracking-[0.2em] text-primary uppercase font-semibold mb-3">House Number</label>
<input class="w-full bg-surface-container-highest border-none rounded-lg p-4 text-on-surface placeholder:text-outline-variant transition-all focus:bg-surface-bright font-body" placeholder="102/B" type="text"/>
</div>
<div class="group">
<label class="block text-[10px] tracking-[0.2em] text-primary uppercase font-semibold mb-3">Street Name</label>
<input class="w-full bg-surface-container-highest border-none rounded-lg p-4 text-on-surface placeholder:text-outline-variant transition-all focus:bg-surface-bright font-body" placeholder="Fifth Avenue" type="text"/>
</div>
<!-- Landmark -->
<div class="col-span-full group">
<label class="block text-[10px] tracking-[0.2em] text-primary uppercase font-semibold mb-3">Landmark</label>
<input class="w-full bg-surface-container-highest border-none rounded-lg p-4 text-on-surface placeholder:text-outline-variant transition-all focus:bg-surface-bright font-body" placeholder="Near Central Park Tower" type="text"/>
</div>
<!-- City & Pincode -->
<div class="group">
<label class="block text-[10px] tracking-[0.2em] text-primary uppercase font-semibold mb-3">City</label>
<input class="w-full bg-surface-container-highest border-none rounded-lg p-4 text-on-surface placeholder:text-outline-variant transition-all focus:bg-surface-bright font-body" placeholder="New York" type="text"/>
</div>
<div class="group">
<label class="block text-[10px] tracking-[0.2em] text-primary uppercase font-semibold mb-3">Pincode</label>
<input class="w-full bg-surface-container-highest border-none rounded-lg p-4 text-on-surface placeholder:text-outline-variant transition-all focus:bg-surface-bright font-body" placeholder="10001" type="text"/>
</div>
<!-- State & Country -->
<div class="group">
<label class="block text-[10px] tracking-[0.2em] text-primary uppercase font-semibold mb-3">State</label>
<div class="relative">
<select class="w-full appearance-none bg-surface-container-highest border-none rounded-lg p-4 text-on-surface focus:bg-surface-bright font-body cursor-pointer">
<option>New York</option>
<option>California</option>
<option>Texas</option>
</select>
<span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-outline">expand_more</span>
</div>
</div>
<div class="group">
<label class="block text-[10px] tracking-[0.2em] text-primary uppercase font-semibold mb-3">Country</label>
<div class="relative">
<select class="w-full appearance-none bg-surface-container-highest border-none rounded-lg p-4 text-on-surface focus:bg-surface-bright font-body cursor-pointer">
<option>United States</option>
<option>United Kingdom</option>
<option>France</option>
</select>
<span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-outline">expand_more</span>
</div>
</div>
<!-- Submit Section -->
<div class="col-span-full pt-10 flex justify-end items-center border-t border-outline-variant/20 mt-4">

  <button class="bg-primary-container text-on-primary-container px-10 py-4 rounded-lg font-bold text-sm tracking-widest uppercase 
                 hover:opacity-90 hover:shadow-xl transition-all 
                 shadow-lg shadow-primary-container/20 
                 active:scale-[0.98] flex items-center gap-2">

    <span class="material-symbols-outlined text-base">
      check_circle
    </span>

    SAVE ADDRESS
  </button>

</div>

</form>
</div>
